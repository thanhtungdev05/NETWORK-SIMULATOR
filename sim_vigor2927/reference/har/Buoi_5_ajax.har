            "compression": 9141,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/dhtml.min.js?094907\"></script><style type=text/css>\n\tbody{position:relative}\n\t#msgal{position:absolute;top:100px;left:30%;width:420px;height:230px;background:#eee;display:none;}\n\t#messagebody{margin:25px;}\n\t#close {margin:10px 180px}\n\t</style><textarea id=swmgprf1init style=\"display: none;\">\nvar notestatus = 0;\nvar sNamePwd = [['','','','','','','','','','','','','','','','','','','','','','','','','','','','','',''], ['','','','','','','','','','','','','','','','','','','','','','','','','','','','','','']];\nvar prftbl = \t[];\nvar newlist = [];\nvar msg = ['','',''];\n</textarea></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><tr><td colspan=2><b parent=\"{{ 'Switch' | translate }}\" qslink=https://www.draytek.com/support/knowledge-base/5279 sub-title translate>Profile</b><hr><form action=/cgi-bin/cgiswm.cgi method=post name=frm1><div id=msgal><div id=messagebody></div><div id=close> <a href=javascript:close() translate>Close</a></div></div><table align=center border=0 cellpadding=2 cellspacing=0 width=800><tr width=100%><td><b translate>Profile List</b></td></tr><tr><td><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr style=\"background-color: #7A7A7A;\" width=100%><td align=center width=7%><font color=#ffffff translate>Index</font></td><td align=center width=16%><font color=#ffffff translate>Name</font></td><td align=center width=16%><font color=#ffffff translate>Group</font></td><td align=center width=19%><font color=#ffffff translate>IP Address</font></td><td align=center width=19%><font color=#ffffff translate>MAC Address</font></td><td align=center width=10%><font color=#ffffff translate>Model</font></td><td align=center width=13%><font color=#ffffff translate>Password</font></td><td align=center width=10%><font color=#ffffff translate>Process Status</font></td><td align=center class=BTHide width=3%><font color=#ffffff translate>Delete Profile</font></td></tr><script> var appeinitScript=document.createElement('script');appeinitScript.text=document.getElementById(\"swmgprf1init\").value;document.head.appendChild(appeinitScript); var str='';for(i=0;i<prftbl.length;i++){if(prftbl[i][5]!=-1)str+='<tr class=row'+(i+1)%2+'><td align=center><a href=\"javascript:gotoDetailSet('+(i+1)+','+prftbl[i][5]+','+prftbl[i][6]+')\">'+(i+1)+'</a></td>';else str+='<tr class=row'+(i+1)%2+'><td align=center>'+(i+1)+'</td>';str+='<td align=center>'+prftbl[i][0]+'</td>';str+='<td style=\"word-break:break-all\" align=center>'+prftbl[i][1]+'</td>';if(prftbl[i][6]==1&&prftbl[i][5]!=-1&&prftbl[i][4]!='G1241'&&prftbl[i][4]!='P1100'){str+='<td align=center><a target=\"_blank\" href=\"http://'+prftbl[i][2]; if(prftbl[i][4]=='P2261'||prftbl[i][4]=='G2260')str+='/config/login?username='+sNamePwd[0][prftbl[i][7]]+'&password='+sNamePwd[1][prftbl[i][7]]+'\">';else str+='\">';str+='<font color=green>'+prftbl[i][2]+'</font></td>';}else if(prftbl[i][6]==1&&prftbl[i][5]!=-1&&(prftbl[i][4]=='G1241'||prftbl[i][4]=='P1100')){str+='<td align=center><a href=\"javascript:postG1241('+i+',0);\">';str+='<font color=green>'+prftbl[i][2]+'</font></td>';}else if(prftbl[i][6]==1&&prftbl[i][5]==-1){str+='<td align=center><a target=\"_blank\" href=\"http://'+prftbl[i][2];if(prftbl[i][4]=='G1260')str+='/pass?password='+sNamePwd[1][prftbl[i][7]]+'&submit=Login\">';else if(prftbl[i][4]=='G2080')str+='/fake_server.html?textuser='+sNamePwd[0][prftbl[i][7]]+'&textpass='+sNamePwd[1][prftbl[i][7]]+'&Submit=Login\">';else str+='\">';str+='<font color=green>'+prftbl[i][2]+'</font></td>';}else str+='<td align=center><font color=red>X '+prftbl[i][2]+'</font></td>';str+='<td align=center>'+prftbl[i][3]+'</td>';str+='<td align=center>'+prftbl[i][4]+'</td>';if(1){ if(prftbl[i][6]==1)str+=\"<td align=center><input type=button value=\\\"{{ 'Password' | translate }}\\\" class=btnw name=sAccount\"+prftbl[i][7]+\" onclick=acct(\"+prftbl[i][7]+\")></td>\";else str+='<td align=center>&nbsp;</td>';str+='<td align=center translate>'+prftbl[i][8]+'</td>';str+='<td align=center id=del1'+i+' class=\"BTHide\"><a href=\"javascript:DelDevice('+i+');\">X</a></td>';str+='<td align=center style=display:none id=del2'+i+' class=\"BTHide\"><a href=\"javascript:DelDevice('+i+');\">X</td>';}else{str+=\"<td align=center><input type=button value=\\\"{{ 'Password' | translate }}\\\" class=btnw name=sAccount\"+prftbl[i][7]+\" disalbed onclick=acct(\"+prftbl[i][7]+\")></td>\";str+='<td align=center translate>'+prftbl[i][8]+'</td>';str+='<td align=center id=del1'+i+' class=\"BTHide\">X</td>';str+='<td align=center style=display:none id=del2'+i+' class=\"BTHide\"><a href=\"javascript:DelDevice('+i+');\">X</td>';}str+='</tr>';}document.write(str);</script></table></td></tr><tr><td colspan=2>&nbsp;</td><tr class=newlist><td colspan=2><b translate>New Switch List</b></td><tr class=newlist><td colspan=2><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr style=\"background-color: #7A7A7A;\"><td align=center><font color=#ffffff translate>Index</font></td><td align=center><font color=#ffffff translate>Switch Name</font></td><td align=center><font color=#ffffff translate>IP Address</font></td><td align=center><font color=#ffffff translate>MAC Address</font></td><td align=center><font color=#ffffff translate>Model</font><td align=center><font color=#ffffff translate>Firmware Version</font><td align=center width=35%><font color=#ffffff translate>Add Device</font></td></tr><script>var str='';for(i=0;i<newlist.length;i++){str+='<tr class=row'+i%2+'><td align=center>'+(i+1)+'</td>';str+='<td align=center>'+newlist[i][7]+'</td>';if(newlist[i][3]!=1)str+='<td align=center><font color=red>X '+newlist[i][0]+'</font></td>';else{if(newlist[i][2]=='G1241'||newlist[i][2]=='P1100')str+='<td align=center><a href=\"javascript:postG1241('+i+',1);\"><font color=green>'+newlist[i][0]+'</font></a></td>';else if(newlist[i][2]=='P2261'||newlist[i][2]=='G2260')str+='<td align=center><a target=\"_blank\" href=\"http://'+newlist[i][0]+'/config/login?username='+sNamePwd[0][newlist[i][6]]+'&password='+sNamePwd[1][newlist[i][6]]+'\"><font color=green>'+newlist[i][0]+'</font></a></td>';else if(newlist[i][2]=='G1260')str+='<td align=center><a target=\"_blank\" href=\"http://'+newlist[i][0]+'/pass?password='+sNamePwd[1][newlist[i][6]]+'&submit=Login\"><font color=green>'+newlist[i][0]+'</font></a></td>';else if(newlist[i][2]=='G2080')str+='<td align=center><a target=\"_blank\" href=\"http://'+newlist[i][0]+'/fake_server.html?textuser='+sNamePwd[0][newlist[i][6]]+'&textpass='+sNamePwd[1][newlist[i][6]]+'&Submit=Login\"><font color=green>'+newlist[i][0]+'</font></a></td>';else str+='<td align=center><a target=\"_blank\" href=\"http://'+newlist[i][0]+'\"><font color=green>'+newlist[i][0]+'</font></a></td>';}str+='<td align=center>'+newlist[i][1]+'</td>';str+='<td align=center>'+newlist[i][2]+'</td>';str+='<td align=center>'+newlist[i][5]+'</td>';if(newlist[i][4]==1){str+='<td align=center id=add1'+i+'><input onclick=AddDevice('+i+\") type=button name=addnew value=\\\"{{ 'Add New' | translate }}\\\"></td>\";str+='<td align=center style=display:none id=add2'+i+'><img src=\"/images/wait.gif\"></td>';str+='<td align=center style=display:none id=add3'+i+\"><input type=button name=addnew value=\\\"{{ 'Add New' | translate }}\\\"></td></tr>\";}else{notestatus=1;str+='<td align=center id=add1'+i+'><span style=\"color: red;\">'+gettext(\"Note\")+'</span></td>';str+='<td align=center id=add3'+i+' style=display:none><span style=\"color: red;\">'+gettext(\"Note\")+'</span></td></tr>';}}document.write(str);</script></table></td></tr><tr class=addnote style=display:none><td><b translate>Note</b>:<ol><li translate>Switch management supports at most 2 levels of switch hierarchy. Please add the switch that directly connects to router first (1st level), and then the \"add new\" button for 2nd level switch will be available.</li></ol></td></tr></table><br><table align=center><tr><td><input name=fid type=hidden><input name=iPRIdx type=hidden><input name=icfgidx type=hidden><input name=mac type=hidden><input name=color type=hidden><input name=delmac type=hidden></td></tr></table><input name=sFormAuthStr type=hidden value=\"pU2VHFY4WAi1NkA\"></form></td></tr></table><script>var bg=parent;var f=document.frm1;var accidx;var timeidx=0;var delmacre='';angular.element(document).ready(function(){initPage();});function initPage(){if(msg[0]==0&&msg[0]!=''){if(confirm(gettext('Timeout.Please try again.'))){for(i=0;i<newlist;i++){if(newlist[i][4]==msg[2])break;}AddDevice(i);}}else if(msg[0]==2&&msg[0]!=''){alert(gettext('Please update switch firmware.'));}else if(msg[0]==100&&msg[0]!=''){for(j=0;j<newlist.length;j++){bg.hideElmtById(document,\"add1\"+j);bg.showElmtById(document,\"add3\"+j);if(msg[2]==newlist[j][1]){bg.hideElmtById(document,\"add3\"+j);bg.showElmtById(document,\"add2\"+j);}}for(j=0;j<prftbl.length;j++){bg.hideElmtById(document,\"del1\"+j);bg.showElmtById(document,\"del2\"+j);}onloaddata();}if(msg[1]==0&&msg[1]!=''&&msg[0]!=100){if(confirm(gettext('Timeout.Please try again.'))){DelDeviceRe(msg[2]);}}if(msg[1]==2&&msg[1]!=''&&msg[0]!=100){alert(gettext('Level2 switches all deleted !'));}if(newlist.length==0){bg.hideElmtByClass(document,\"tr\",\"newlist\");}if(notestatus!=0){bg.showElmtByClass(document,\"tr\",\"addnote\");}else{bg.hideElmtByClass(document,\"tr\",\"addnote\");}if(webcfg.isBT498&&webcfg.privilege!=15){angular.element(document.querySelectorAll('.BTHide')).attr('style','display:none');}}function onloaddata(){var mac='';$http.post(\"/swmgetstasusmac.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&mac=\"+mac).then(function(data){if(data.data=='Configuration is Processing'){timeidx++;if(timeidx<7)setTimeout(\"onloaddata()\",10000);else{alert(gettext(\"Process fail 6 times,please try again\"));document.location.href=\"/cgi-bin/cgiswm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=5\";}}else{alert(gettext(data.data));document.location.href=\"/cgi-bin/cgiswm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=5\";}});}function AddDevice(i){for(j=0;j<newlist.length;j++){bg.hideElmtById(document,\"add1\"+j);bg.showElmtById(document,\"add3\"+j);}for(j=0;j<prftbl.length;j++){bg.hideElmtById(document,\"del1\"+j);bg.showElmtById(document,\"del2\"+j);}bg.hideElmtById(document,\"add3\"+i);bg.showElmtById(document,\"add2\"+i);f.mac.value=newlist[i][1];setTimeout(\"add()\",1000);}function DelDeviceRe(i){for(j=0;j<newlist.length;j++){bg.hideElmtById(document,\"add1\"+j);bg.showElmtById(document,\"add3\"+j);}for(j=0;j<prftbl.length;j++){bg.hideElmtById(document,\"del1\"+j);bg.showElmtById(document,\"del2\"+j);}f.fid.value=8;f.iPRIdx.value=i;f.delmac.value=delmacre;f.submit();}function DelDevice(i){for(j=0;j<newlist.length;j++){bg.hideElmtById(document,\"add1\"+j);bg.showElmtById(document,\"add3\"+j);}for(j=0;j<prftbl.length;j++){bg.hideElmtById(document,\"del1\"+j);bg.showElmtById(document,\"del2\"+j);}f.fid.value=8;f.iPRIdx.value=prftbl[i][5];f.delmac.value=prftbl[i][3];f.submit();}function add(){f.fid.value=7;f.submit();}function gotoDetailSet(idx,confidx,color){f.fid.value=16;f.iPRIdx.value=idx;f.icfgidx.value=confidx;f.color.value=color;f.submit();}function acct(_idx){accidx=_idx;window.open(\"swmdevacc.htm\",\"ExtDev\",\"toolbars=no,width=480px,height=180px,top=150px,left=\"+(screen.width/2-207)+\"px,status=no,scrollbars=no,resize=yes,menubar=no\");}function onFresh(){setTimeout(\"refres()\",1000);}function refres(){document.location.href=\"/cgi-bin/cgiswm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=5\";}function postG1241(idx,num){if(num==0){var ipaddr=prftbl[idx][2];var password=sNamePwd[1][idx];var username=sNamePwd[0][idx];}else if(num==1){var ipaddr=newlist[idx][0];var password=sNamePwd[1][newlist[idx][6]];var username=sNamePwd[0][newlist[idx][6]];}var ver=new Date().getTime();$http.post(\"///\"+ipaddr+\"/cgi/set.cgi?cmd=home_loginAuth&dummy=\"+ver,{\"_ds\":\"1\",\"username\":username,\"password\":password,\"_de\":\"1\"}).then(function(data1){$http.get(\"///\"+ipaddr+\"/cgi/get.cgi?cmd=home_loginStatus&dummy=\"+ver,function(data2){window.open(\"///\"+ipaddr+\"/home.html?ver=\"+ver);},function(){alert(gettext(\"Login fail,please check your username and password!\"));});},function(){alert(gettext(\"Login fail,please check your username and password!\"));});}function close(){document.getElementById(msgal).style.display=\"none\";}</script></body></html>"
