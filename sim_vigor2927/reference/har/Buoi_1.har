            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><script src=\"/js/vanillatb.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><link href=\"/css/vanillatb.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script><script src=\"/js/dhtml.min.js?094907\"></script><style>\ncaption{text-align:left}\n</style></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=800><tr><td><b parent=\"{{ 'Bandwidth Management' | translate }}\" sub-title translate>Bandwidth Limit</b><hr><form action=/cgi-bin/v2x00.cgi method=POST name=frm1><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><th class=offtab id=tab1 onClick=\"chgTab(this.id);parent.sIPBandwTag=this.id; showOnSltIpBandwList(0);\" translate width=20%>IPv4</th><th class=offtab id=tab2 ng-show=bDrayIpv6 onClick=\"chgTab(this.id);parent.sIPBandwTag=this.id; showOnSltIpBandwList(1);\" translate width=20%>IPv6</th><th class=offtab id=tab3 ng-if=isAppUI onClick=\"chgTab(this.id);parent.sIPBandwTag=this.id; showOnSltIpBandwList(2);\" translate width=20%>APP</th><th class=tabpadding></th></tr></table><div class=pagetext id=page1><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=95%><tr><td colspan=2><input name=sIpBandwEnable onclick=oncheck() type=radio value=1>&nbsp;<b translate>Enable</b>&nbsp;&nbsp; <input name=sIpBandwEnable onclick=oncheck() type=radio value=0>&nbsp;<b translate>Disable</b>&nbsp;&nbsp; <span class=sndSubnet style=display:none><input name=sIpBandwEnableNet type=checkbox value=1>&nbsp;<span id=subTitle translate>Apply to 2nd Subnet</span>&nbsp;&nbsp;</span></td></tr><tr><td colspan=2><br></td></tr><tr><td colspan=2><b translate>Default Limit (Per User)</b></td></tr><tr><td colspan=2><translate>TX Limit</translate>&nbsp;:&nbsp; <input max=30000 name=sIpBandwDefTx ng-model=sIpBandwDefTx style=\"width: 60px;\" type=number>&nbsp; <select name=iDefTx ng-model=iDefTx><option translate value=0>Kbps</option><option translate value=1>Mbps</option></select>&nbsp;&nbsp;&nbsp;&nbsp; <translate>RX Limit</translate>&nbsp;:&nbsp; <input max=30000 name=sIpBandwDefRx ng-model=sIpBandwDefRx style=\"width: 60px;\" type=number>&nbsp; <select name=iDefRx ng-model=iDefRx><option translate value=0>Kbps</option><option translate value=1>Mbps</option></select></td></tr><tr><td><table id=custlsttb0 style=\"border: 1px #000 solid\"><caption><b translate>Limitation List</b> (<translate translate-params-num=\"20\">Max. {{num}} entries</translate>) </caption></table></td></tr><tr><td colspan=2 style=\"white-space: nowrap\"><translate>Add Entry By</translate>&nbsp;:&nbsp; <span ng-show=\"adminauth\"><input checked name=rdLimit onclick=onRDLimit(this.value,0) type=radio value=0><translate>IP Range</translate><input name=rdLimit onclick=onRDLimit(this.value,0) type=radio value=1><translate>IP Object</translate>&nbsp;&nbsp; </span><span class=\"limitip\"><translate>Start IP</translate>&nbsp;:&nbsp;<input maxlength=15 name=sIpBandwFrom style=\"width: 180px\" type=text>&nbsp;&nbsp; <translate>End IP</translate>&nbsp;:&nbsp;<input maxlength=15 name=sIpBandwTo style=\"width: 180px\" type=text></span><span class=\"limitobj\"> <a href=\"javascript: goToIpGroup(0)\" translate>IP Group</a> &nbsp; <select name=sIpGroup size=1><option translate value=0>None</option></select> &nbsp; <translate>or</translate>&nbsp;  <a href=\"javascript: goToIpObject(0)\" translate>IP Object</a> &nbsp; <select name=sIpObject size=1><option translate value=0>None</option></select></span></td></tr><tr><td colspan=2><input checked name=sIpBandwShrd type=radio value=N><translate>Each</translate>&nbsp; <input name=sIpBandwShrd type=radio value=Y><translate>Shared</translate>&nbsp;&nbsp; <translate>TX Limit</t