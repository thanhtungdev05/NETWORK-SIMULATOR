            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><title>Import X509 Trusted CA Certificate</title><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><script> top.printLogo(document,15,gettext('Trusted CA Certificate'));</script><tr><td><hr size=1><br><form enctype=multipart/form-data method=POST name=frm1 onsubmit=\"return waitResponse()\"><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td align=left><b translate>Import X509 Trusted CA Certificate</b></td></tr></table><table align=center border=1 cellPadding=2 cellSpacing=0 width=100%><tr><td><table align=center border=0 cellPadding=2 cellSpacing=0 width=60%><tr><td class=comment> &nbsp;&nbsp;<translate>Select a trusted CA certificate file.</translate></td></tr><tr><td> &nbsp;&nbsp;&nbsp;&nbsp;<input accept=.crt,.pem,.cer class=file name=data required size=30 type=file></td></tr><tr><td class=comment> &nbsp;&nbsp;<translate class=\"fontcolorblue\">Click <font>Import</font> to upload the certification.</translate></td></tr><tr><td align=left> &nbsp;&nbsp;&nbsp;&nbsp; <input class=btnw name=attach type=submit value=\"{{ 'Import' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnCancel onclick=btnCcl() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table></td></tr></table><input name=sFormAuthStr type=hidden value=\"pU2VHFY4WAi1NkA\"></form></td></tr></table><script>top.ACTION_STATUS=-1;top.iActionStatusFlag='0';top.iFwUpgradeState='0';top.act_sta.damage_alert(); function waitResponse(){var formData=new FormData(document.frm1);if(!document.frm1.data.value.match(/\\..*(der|pem|cert|crt|cer)$/g)){alert(gettext(\"Invalid file name!\"));return false;}$http.post(\"/x509CaCfIm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA\",formData,{headers:{'Content-Type':undefined},transformRequest:angular.identity}).then(function(response){mainHandler(parseInt(response.data));});}function mainHandler(iResp){if(iResp==1){document.location='/doc/XCaCfOK.htm';}else{document.location='/doc/Xfail.htm#error_'+iResp;}}function btnCcl(){ var myUrl=\"/cgi-bin/v2x00.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=\"+1220;top.main.location.href=myUrl;}angular.element(document).ready(function(){angular.element(document.querySelectorAll(\".fontcolorblue font\")).attr(\"color\",\"blue\");});</script></body></html>"
