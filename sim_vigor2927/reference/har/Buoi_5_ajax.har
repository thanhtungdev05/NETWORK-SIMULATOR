            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=900><tr><td colspan=2><b ng-if=!qtlink parent=\"{{ 'Diagnostics' | translate }}\" sub-title translate>Route Policy Diagnosis</b><b ng-if=qtlink parent=\"{{ 'Diagnostics' | translate }}\" qslink=\"https://www.draytek.com/router-help-redirect?stk_title=Diagnostics&nd_title=Route Policy Diagnosis\" sub-title translate>Route Policy Diagnosis</b><hr><form action=/cgi-bin/v2x00.cgi method=POST name=frm1><table border=0 cellpadding=0 cellspacing=0 width=100%><tr><td colspan=6><b translate>Test how the packets will be routed</b></td></tr><tr><td><table align=left border=0 cellpadding=2 cellspacing=2 width=100%><tr><td colspan=2></td></tr><tr align=left><td colspan=3><table><tr><td><b translate>Mode</b></td>&nbsp;&nbsp;&nbsp;<td align=left><input name=analzyzebtn onclick=Onselect() type=radio value=0>&nbsp;&nbsp;<translate>Analyze a single packet</translate></td></tr><tr align=left><td></td><td align=left><input name=analzyzebtn onclick=Onselect() type=radio value=1>&nbsp;&nbsp;<translate>Analyze multiple packets by uploading an input file</translate></td></tr></table></td></tr><tr class=showpacket style=display:none><td colspan=2>&nbsp;</td></tr><tr class=showpacket style=display:none><td colspan=2>&nbsp;</td></tr><tr class=showpacket style=display:none><td colspan=2><b translate>Packet Information</b></td></tr><tr class=showpacket style=display:none><td align=left colspan=2><table border=0><tr><td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <translate>Protocol</translate>&nbsp;</td><td><select name=packetsel onChange=onChgpacket() style=width:175px><option translate value=0>ICMP</option><option translate value=1>UDP</option><option translate value=2>TCP</option><option translate value=3>Any</option></select>&nbsp;&nbsp; </td><td></td></tr><tr><td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <translate>Src IP</translate>&nbsp;</td><td><select name=iSrcIP onChange=onChgSrcIP() style=width:175px><option translate value=0>Specify an IP</option><option translate value=1>Any IP</option><option translate translate-params-num=1 value=2>Any IP from LAN {{num}}</option></select>&nbsp;&nbsp;</td><td><input id=spfsrcip name=srcIp size=15 style=display:none type=text></td></tr><tr><td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <translate>Dst IP</translate>&nbsp;&nbsp;&nbsp;&nbsp;</td><td><select name=iDstIP onChange=onChgDstIP() style=width:175px><option translate value=0>Specify an IP</option><option translate value=1>Any IP</option></select>&nbsp;&nbsp;</td><td><input id=spfip name=dstIp size=15 style=display:none type=text value=\"\"></td></tr><tr><td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <translate>Dst Port</translate>&nbsp;</td><td colspan=2><select name=iDstPort onChange=onChgDstP() style=width:175px><option translate value=1>Any Port</option><option translate value=0>Specify a Port</option></select>&nbsp;&nbsp; <input id=spfport name=dstport size=15 style=display:none type=text></td><td></td></tr></table></td></tr><tr class=showpacket style=display:none><td width=50%>&nbsp;</td><td align=left><input name=btnSend onclick=Onsend(1) type=button value=\"{{ 'Analyze' | translate }}\"></td></tr><tr class=showpacket style=display:none><td colspan=2></td></tr><tr id=sendcorrtitle style=display:none><td colspan=2><b translate>Analysis</b></td></tr><tr id=forpacketmode style=display:none><td align=left width=47%><table align=left><tr><td><table align=left><tr align=left><td align=left><table align=left><tr align=left><td align=left valign=middle><br><translate>the packet</translate></td></tr></table></td></tr></table></td><td><table><tr><td><img src=/images/arrow.png></td></tr></table></td><td><table border=0px cellpadding=10px cellspacing=0px width=120px><tr><td><table width=100%><tr><td>LAN&nbsp;</td><td><table><tr><td><img src=/images/vigor.png></td></tr><tr><td align=center>Vigor2927</td></tr></table></td>&nbsp; <script> var str=\"\";var WANidx='';var WANaccmode=JSON.parse(\"[2,2,0,0,0,0]\".replace(/'/g,'\"'));if('2927'!='2710'&&'2927'!='2120'&&'2927'!='2110'){if(WANidx.charAt(0)=='W')str+='<td align=right class=ipcor style=display:none><a class=\"DenyToPage\" href=\"javascript:WanLink3('+WANaccmode[parseInt(WANidx.charAt(3))-1]+','+WANidx.charAt(3)+')\"><font color=#4F94CD>'+WANidx+'</font></a></td>';else if(WANidx.charAt(0)=='L')str+='<td align=right class=ipcor style=display:none><a class=\"DenyToPage\" href=\"javascript:LanLink()\"><font color=#4F94CD>'+WANidx+'</font></a></td>';else str+='<td align=right class=ipcor style=display:none><a class=\"DenyToPage\" href=\"javascript:VPNLink()\"><font color=#4F94CD>'+WANidx+'</font></a></td>';}else{if(WANidx.charAt(0)=='W'){if('2927'!='2120')str+='<td align=right class=ipcor style=display:none><a class=\"DenyToPage\" href=\"javascript:WanLink1()\"><font color=#4F94CD>'+WANidx+'</font></a></td>';else str+='<td align=right class=ipcor style=display:none><a class=\"DenyToPage\" href=\"javascript:WanLink2()\"><font color=#4F94CD>'+WANidx+'</font></a></td>';}else if(WANidx.charAt(0)=='L')str+='<td align=right class=ipcor style=display:none><a class=\"DenyToPage\" href=\"javascript:LanLink();\"><font color=#4F94CD>'+WANidx+'</font></a></td>';else str+='<td align=right class=ipcor style=display:none><a class=\"DenyToPage\" href=\"javascript:VPNLink()\"><font color=#4F94CD>'+WANidx+'</font></a></td>';}str+='<td id=ipfiste style=display:none></td>';document.write(str);</script></tr></table></td></tr></table></td></tr></table></td><td id=corshowarr style=display:none><table><tr><td><img src=/images/arrow.png></td></tr></table></td><td class=filereslut style=display:none><table><tr><td><translate>please see \"Analysis\" below</translate></td></tr></table></td><td class=iperr0 style=display:none><table><tr><td><font color=red><translate>The packet was dropped</translate><br><translate>It did not come from one of router's legitimate subnets</translate></font></td></tr></table></td><td class=iperr1 style=display:none><table><tr><td><font color=red><translate>The packet was dropped</translate><br><translate>The subnet where it came from was not enabled</translate></font></td></tr></table></td><td class=iperr2 style=display:none><table><tr><td><font color=red><translate>The packet was dropped</translate><br><translate>Inter-LAN Routing was not enabled</translate></font></td></tr></table></td><td id=finalstr style=display:none></td></tr><script>var aryFinalstr=JSON.parse(\"[]\".replace(/'/g,'\"'));var WANidx='';var WANaccmode=JSON.parse(\"[2,2,0,0,0,0]\".replace(/'/g,'\"'));var str=\"\";if(top.idxperpage!=10&&top.idxperpage!=20&&top.idxperpage!=30&&top.idxperpage!=40&&top.idxperpage!=50){top.idxperpage=10;}var iIdxPerPage=top.idxperpage,sInterface;angular.element(document).ready(function(){var finalres;if(aryFinalstr.length!=0){if(aryFinalstr[0]==0)finalres=gettext('The packet was dropped because neither \"route\" or \"policy\" was matched');if(aryFinalstr[0]==1){finalres=gettext('The packet was sent via <a1><font>###STR1###</font></a> according to <a2><font>policy ###STR2###</font></a>\"');if('2927'!='2710'&&'2927'!='2120'&&'2927'!='2110'){if(WANidx.charAt(0)=='W')finalres=translateReplace1(finalres,'<a class=\"DenyToPage\"  href=\"javascript:WanLink3('+WANaccmode[parseInt(WANidx.charAt(3))-1]+','+WANidx.charAt(3)+')\">');else if(WANidx.charAt(0)=='L')finalres=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:LanLink()\">');else finalres=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:VPNLink()\">');}else{if(WANidx.charAt(0)=='W'){if('2927'!='2120')str+=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:WanLink1()\">');else str+=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:WanLink2()\">');}else if(WANidx.charAt(0)=='L')str+=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:LanLink()\">');else str+=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:VPNLink()\">');}}else if(aryFinalstr[0]==2){finalres=gettext('The packet was sent via <a1><font>###STR1###</font></a> according to <a2><font>policy ###STR2###</font></a>\"\\'s failover setting');if('2927'!='2710'&&'2927'!='2120'&&'2927'!='2110'){if(WANidx.charAt(0)=='W')finalres=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:WanLink3('+WANaccmode[parseInt(WANidx.charAt(3))-1]+','+WANidx.charAt(3)+')\">');else if(WANidx.charAt(0)=='L')finalres=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:LanLink()\">');else finalres=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:VPNLink()\">');}else{if(WANidx.charAt(0)=='W'){if('2927'!='2120')finalres=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:WanLink1()\">');else finalres=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:WanLink2()\">');}else if(WANidx.charAt(0)=='L')finalres=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:LanLink()\">');else finalres=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:VPNLink()\">');}}else if(aryFinalstr[0]==3){finalres=gettext('The packet was dropped because the send-to interface of the matched policy \"<a1><font>policy ###STR1###</font></a>\" was inactive and there was no failover setting');finalres=finalres.replace(\"<a1>\",'<a class=\"DenyToPage\" href=\"javascript:policyLink('+top.idxperpage+','+parseInt((aryFinalstr[1]-1)/iIdxPerPage+1)+','+aryFinalstr[1]+');\">').replace(\"<font>\",'<font color=#4F94CD>').replace(\"###STR1###\",aryFinalstr[1]);}else if(aryFinalstr[0]==4){finalres=gettext('The packet was dropped because the matched policy \"<a><font>policy ###STR###</font></a>\" failed to failover');finalres=finalres.replace(\"<a>\",'<a class=\"DenyToPage\" href=\"javascript:policyLink('+top.idxperpage+','+parseInt((aryFinalstr[1]-1)/iIdxPerPage+1)+','+aryFinalstr[1]+');\">').replace(\"<font>\",'<font color=#4F94CD>').replace(\"###STR###\",aryFinalstr[1]);}else if(aryFinalstr[0]==5){finalres=gettext('The packet was sent via <a1><font>###STR1###</font></a> according to the ###CHAR### route \"###STR2###/###STR3### ###STR4###\"');if(''==0)sInterface=gettext('Static');else if(WANidx.charAt(0)=='V')sInterface=gettext('VPN');else if(WANidx.charAt(0)=='L')sInterface=gettext('LAN');else sInterface=gettext(\"default\");if('2927'!='2710'&&'2927'!='2120'&&'2927'!='2110'){if(WANidx.charAt(0)=='W')finalres=translateReplace2(finalres,'<a class=\"DenyToPage\" href=\"javascript:WanLink3('+WANaccmode[parseInt(WANidx.charAt(3))-1]+','+WANidx.charAt(3)+')\">');else if(WANidx.charAt(0)=='L')finalres=translateReplace2(finalres,'<a class=\"DenyToPage\" href=\"javascript:LanLink()\">');else finalres=translateReplace2(finalres,'<a class=\"DenyToPage\" href=\"javascript:VPNLink()\">');}else{if(WANidx.charAt(0)=='W'){if('2927'!='2120')finalres=translateReplace2(finalres,'<a class=\"DenyToPage\" href=\"javascript:WanLink1()\">');else finalres=translateReplace2(finalres,'<a class=\"DenyToPage\" href=\"javascript:WanLink1()\">');}else if(WANidx.charAt(0)=='L')finalres=translateReplace2(finalres,'<a class=\"DenyToPage\" href=\"javascript:LanLink()\">');else finalres=translateReplace2(finalres,'<a class=\"DenyToPage\" href=\"javascript:VPNLink()\">');}}else if(aryFinalstr[0]==6){finalres=gettext('The packet was dropped because the interface of the matched route \"###STR1###/###STR2### ###STR3###\"');finalres=finalres.replace(\"###STR1###\",aryFinalstr[1]).replace(\"###STR2###\",aryFinalstr[2]).replace(\"###STR3###\",aryFinalstr[3]);}else finalres=gettext('The packet was dropped because neither \"route\" or \"policy\" was matched');document.getElementById(\"finalstr\").innerHTML=finalres.replace(/LAN/g,gettext(\"LAN\"));}});function translateReplace1(ori_str,rplc_str){return ori_str.replace(\"<a1>\",rplc_str).replace(/<font>/g,\"<font color=#4F94CD>\").replace(\"###STR1###\",aryFinalstr[1]).replace(\"<a2>\",' \"<a class=\"DenyToPage\" href=\"javascript:policyLink('+top.idxperpage+','+parseInt((aryFinalstr[2]-1)/iIdxPerPage+1)+','+aryFinalstr[2]+');\">').replace(\"###STR2###\",aryFinalstr[2]);}function translateReplace2(ori_str,rplc_str){return ori_str.replace(\"<a1>\",rplc_str).replace(\"<font>\",\"<font color=#4F94CD>\").replace(\"###STR1###\",aryFinalstr[1]).replace(\"###CHAR###\",sInterface).replace(\"###STR2###\",aryFinalstr[2]).replace(\"###STR3###\",aryFinalstr[3]).replace(\"###STR4###\",aryFinalstr[4]);}</script><tr class=sendcorr style=display:none><td colspan=6><table width=90%><tr><td align=left valign=top width=45%><table border=0 width=80%><tr><td><b><font color=#4F94CD><translate>Matched Route</translate></font></b></td></tr><tr><td><table border=1 cellpadding=0px cellspacing=0px style=border-collapse:collapse; width=100%><tr height=30><td><font color=#4F94CD>&nbsp;<translate>Matched</translate></font></td><td><font color=#4F94CD>&nbsp;<translate>Priority</translate></font></td></tr><tr height=30><script>var aryRout=JSON.parse(\"[]\".replace(/'/g,'\"'));var bgcolor=\"\";if(aryFinalstr.length>0&&aryRout.length>0){if(aryRout[0]==aryFinalstr[2]&&aryRout[1]==aryFinalstr[3]&&aryRout[2]==aryFinalstr[4]){if(aryFinalstr[0]=='5')bgcolor='style=background-color:#C1FFC1';}}var str=\"\";if(aryRout[0]!='N/A')str+='<td '+bgcolor+'><font color=#4F94CD>&nbsp;'+aryRout[0]+'/'+aryRout[1]+'&nbsp;'+aryRout[2]+'</font></td><td '+bgcolor+'>&nbsp;<font color=#4F94CD>'+aryRout[3]+'</font></td>';else str+='<td '+bgcolor+'><font color=#4F94CD>&nbsp;'+gettext(\"N/A\")+'</font></td><td '+bgcolor+'>&nbsp;<font color=#4F94CD>'+gettext(\"N/A\")+'</font></td>';document.write(str);</script></tr></table></td></tr></table></td><td>&nbsp;</td><td align=left valign=top width=50%><table border=0 width=90%><tr><td><b><font color=#4F94CD><translate>Matched Policy</translate></font></b></td></tr><tr><td><table border=1 cellpadding=0px cellspacing=0px style=border-collapse:collapse; width=100%><tr height=30><td><font color=#4F94CD>&nbsp;<translate>Matched</translate></font></td><td><font color=#4F94CD>&nbsp;<translate>Priority</translate></font></td><td><font color=#4F94CD>&nbsp;<translate>failovered</translate></font></td></tr><script>var aryPolicy=JSON.parse(\"[]\".replace(/'/g,'\"'));if(top.idxperpage!=10&&top.idxperpage!=20&&top.idxperpage!=30&&top.idxperpage!=40&&top.idxperpage!=50){top.idxperpage=10;}var iIdxPerPage=top.idxperpage;var str=\"\";for(var i=0;i<aryPolicy.length;i++){if(aryPolicy[i][0]!='N/A'){if(aryPolicy[i][2]=='')var aryPolicyfailover=gettext(\"No\");else var aryPolicyfailover=gettext(\"Yes\");if(i==0&&('0'==0)||(aryPolicy[i][0]=='0'))str+='<tr style=background-color:#C1FFC1 height=30>';else str+='<tr height=30>';str+='<td>&nbsp;<a class=\"DenyToPage\" href=\"javascript:policyLink('+top.idxperpage+','+parseInt((aryPolicy[i][0]-1)/iIdxPerPage+1)+','+aryPolicy[i][0]+');\"><font color=#4F94CD>'+gettext(\"Route Policy\")+\" \"+aryPolicy[i][0]+'</font></a></td><td align=center><font color=#4F94CD>'+aryPolicy[i][1]+'</font></td><td style=\"empty-cells:show;\" align=center><font color=#4F94CD>'+aryPolicyfailover+'</font></td></tr>';}else{str+='<tr height=30>';str+='<td>&nbsp;<font color=#4F94CD>'+gettext(\"N/A\")+'</font></td><td>&nbsp;<font color=#4F94CD>'+gettext(\"N/A\")+'</font></td><td>&nbsp;<font color=#4F94CD>'+gettext(\"N/A\")+'</font></td></tr>';}}document.write(str)</script></table></td></tr></table></td></tr></table></td></tr></table></td></tr></table><br><table align=center><tr><td><input class=btnw id=frompolicy name=btnClose onclick=onClkBtnClose() style=display:none type=button value=\"{{ 'Close' | translate }}\"><input name=fid t