            "compression": 4502,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/dhtml.min.js?094907\"></script><script src=\"/js/webchange.js?094907\"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'Diagnostics' | translate }}\" sub-title translate>DNS Cache Table</b><hr><form action=/cgi-bin/v2x00.cgi method=post name=frm><table align=center border=0 cellpadding=2 cellspacing=0 width=700><tr><td><b translate>IPv4 DNS Cache Table</b></td><td align=right><font color=red>|&nbsp; <a href=javascript:clearTable() translate>Clear</a>&nbsp;|&nbsp; <a href=javascript:refreshTable() translate>Refresh</a>&nbsp;|</font></td></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 width=700><tr><td><textarea cols=94 name=ipv4dnsTable READONLY rows=16 style=width:100% wrap=off>\n    </textarea></td></tr></table><br><table align=center border=0 cellpadding=2 cellspacing=0 class=IPv6table style=display:none width=700><tr><td><b translate>IPv6 DNS Cache Table</b></td><td align=right><font color=red>|&nbsp; <a href=javascript:clearTable() translate>Clear</a>&nbsp;|&nbsp; <a href=javascript:refreshTable() translate>Refresh</a>&nbsp;|</font></td></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 class=IPv6table style=display:none width=700><tr><td><textarea cols=94 name=ipv6dnsTable READONLY rows=16 style=width:100%; wrap=off>\n</textarea></td></tr></table><br><table><tr id=landns style=display:none><td id=link_note style=font-weight:normal><b translate>Note</b>: <ol><li id=showsysadminfir translate>An entry of which TTL shows \"Static\" is a domain name created in <a>LAN DNS</a>.</li><li id=showsysadminsec translate>An entry of which TTL shows \"Static\" is a domain name created in LAN DNS.</li></ol></td></tr><tr><td><br><input name=sdnsttlchx onclick=onEnableDNSTTl() type=checkbox value=1><span class=\"whenanentry\" translate>When an entry's TTL is larger than <input>s, this entry will be deleted from the table.</span></td></tr></table><br><table align=center><tr><td><input class=btnw onClick=onOK() type=button value=\"{{ 'OK' | translate }}\"><input name=fid type=hidden><input name=webchange type=hidden value=0></td></tr></table><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></td></tr></table><textarea id=dnstblinit style=display:none>\n\tvar arydnstbl = ['||'];\n</textarea><script> var dnstblinitscript=document.createElement(\"script\");dnstblinitscript.text=document.getElementById(\"dnstblinit\").value;document.head.appendChild(dnstblinitscript);top.ACTION_STATUS=-1;top.iActionStatusFlag='-2';top.iFwUpgradeState='0';top.act_sta.damage_alert();var f=document.frm,bg=parent; var aryIpv4Tbl=[];var aryIpv6Tbl=[];var ipv4len=0;for(var i=0;i<arydnstbl.length;i++){if(arydnstbl[i]==\"||\"){ipv4len=i;break;}}aryIpv4Tbl=arydnstbl.slice(0,ipv4len);aryIpv6Tbl=arydnstbl.slice(ipv4len+1,arydnstbl.length);angular.element(document).ready(function(){intiPage();initParameter();initWebChange();});function intiPage(){if(parseInt('0')){bg.showElmtByClass(document,\"table\",\"IPv6table\");showdnsipv6();}if(parseInt('1'))bg.showElmtById(document,\"landns\");showdnsipv4();angular.element(document.querySelector(\".whenanentry input\")).attr({type:\"text\",name:\"sdnsttltx\",size:5,maxlength:15});if(parent.SHOW_SYS_ADMIN){bg.showElmtById(document,\"showsysadminfir\");bg.hideElmtById(document,\"showsysadminsec\");}else{bg.showElmtById(document,\"showsysadminsec\");bg.hideElmtById(document,\"showsysadminfir\");}angular.element(document.querySelector(\"#link_note a\")).attr(\"href\",'/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=2326&iPageIdx=1&iOption=0');angular.element(document.querySelector(\"#link_note a\")).attr(\"class\",\"DenyToPage\");}function initParameter()