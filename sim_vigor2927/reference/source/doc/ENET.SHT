ange=bg.getVleFromElmt(f.clkv6range);if(dhcp_enable==1&&range!=1){var sStartIpv6Addr=bg.getVleFromElmt(f.sStartIpv6Addr,0);var sEndIpv6Addr=bg.getVleFromElmt(f.sEndIpv6Addr,0);if(sStartIpv6Addr==""||!bg.isIPv6(sStartIpv6Addr)){alert(gettext('DHCPv6 Server : Start IPv6 Address is invalid!'));return false;}if(sEndIpv6Addr==""||!bg.isIPv6(sEndIpv6Addr)){alert(gettext('DHCPv6 Server : End IPv6 Address is invalid!'));return false;}}var sPriIpv6Dns=bg.getVleFromElmt(f.sPriIpv6Dns,0);var sSecIpv6Dns=bg.getVleFromElmt(f.sSecIpv6Dns,0);if(!bg.isIPv6(sPriIpv6Dns)){alert(gettext('DHCPv6 Server : DNS Server Primary IPv6 Address is invalid!'));return false;}if(!bg.isIPv6(sSecIpv6Dns)){alert(gettext('DHCPv6 Server : DNS Server Secondary IPv6 Address is invalid!'));return false;}if($scope.showDNSServ&&(sPriIpv6Dns==""||sPriIpv6Dns=="::")&&(sSecIpv6Dns==""||sSecIpv6Dns=="::")){alert(gettext("DHCPv6 Server : Please set at least one DNS Server. You can use google's DNS Server : 2001:4860:4860::8888 and 2001:4860:4860::8844"));return false;}if(0){var iAdvLftime=bg.getVleFromElmt(f.iAdvLftime,0);if(isNaN(iAdvLftime)||iAdvLftime<600||iAdvLftime>9000){alert(gettext('IPv6 advertisement lifetime value : ###MIN### ~ ###MAX### seconds').replace("###MIN###",600).replace("###MAX###",9000));return false;}}}return true;}function isValidIP(ip,mask){var lanip_arr=ip.split(".");var mask_arr=mask.split(".");var subf_arr=[lanip_arr[0]&mask_arr[0],lanip_arr[1]&mask_arr[1],lanip_arr[2]&mask_arr[2],lanip_arr[3]&mask_arr[3]];var subf_num=parseInt(subf_arr[0]*255*255*255+subf_arr[1]*255*255+subf_arr[2]*255+subf_arr[3]);var subt_arr=[subf_arr[0]|(255-mask_arr[0]),subf_arr[1]|(255-mask_arr[1]),subf_arr[2]|(255-mask_arr[2]),subf_arr[3]|(255-mask_arr[3])];var subt_num=parseInt(subt_arr[0]*255*255*255+subt_arr[1]*255*255+subt_arr[2]*255+subt_arr[3]);var lanip_num=lanip_arr[0]*255*255*255+lanip_arr[1]*255*255+lanip_arr[2]*255+parseInt(lanip_arr[3]);if(lanip_num!=subf_num&&lanip_num!=subt_num)return true;return false;}function onClkBtnOk(){var str="";var elmtnum=4;if('0'=='1'||'0'==1)elmtnum=2; var aryelmt=[f.sLanIp.value,f.sLanMask.value,f.old1ndsubip.value,f.old1ndsubmsk.value];var aryvle=['192.168.1.1','255.255.255.0','192.168.0.1','255.255.255.0'];var arycom=[gettext("Current Router's 1st LAN IP")+": ",gettext("Current Router's 1st Subnet Mask")+": ",gettext("Current Router's 2nd LAN IP")+": ",gettext("Current Router's 2nd Subnet Mask")+": "];if(!dataCheck())return false;if(supLoopback!="1"&&!isValidIP(f.sLanIp.value,f.sLanMask.value)){alert(gettext('Invalid IP Address!'));f.sLanIp.focus();return false;}for(var i=0;i<elmtnum;i++){if(aryelmt[i]!=aryvle[i]){str+=arycom[i]+aryvle[i]+" "+gettext('was changed to')+" "+aryelmt[i]+"\n";}}if(str!=""&&!confirm(str+gettext('Do you want to continue to save? The new configuration will take effect after rebooting the router.'))){return;}if(parseInt('0')&&f.enipv6.checked){var range=bg.getVleFromElmt(f.clkv6range);var ip6Ula=bg.getVleFromElmt(f.sltULAprefix);var tmpStartIP=bg.getVleFromElmt(f.sStartIpv6Addr);var tmpEndIP=bg.getVleFromElmt(f.sEndIpv6Addr);if(range==0&&ip6Ula==0&&((tmpStartIP.substr(0,2).toUpperCase()=="FD")||(tmpEndIP.substr(0,2).toUpperCase()=="FD"))){alert(gettext('To apply Unique Local Address(ULA) in DHCPv6 Derver , please enable ULA Prefix in ULA configuration.'));return false;}if(range==0){var sStartIP=bg.transitIpv6(f.sStartIpv6Addr.value);var sEndIP=bg.transitIpv6(f.sEndIpv6Addr.value);var sSiteIP="",sameflag=0;var aryStartIP=new Array();var aryEndIP=new Array();var arySiteIP=new Array();for(idx=0;idx<aryIp6Addr.length;idx++){if(aryIp6Addr[idx][1]=="Site")break;}if(idx<aryIp6Addr.length){sSiteIP=bg.transitIpv6(aryIp6Addr[idx][0]);aryStartIP=sStartIP.split(":");aryEndIP=sEndIP.split(":");arySiteIP=sSiteIP.split(":");if((aryStartIP[0]!=arySiteIP[0])||(aryStartIP[1]!=arySiteIP[1])||(aryStartIP[2]!=arySiteIP[2])||(aryStartIP[3]!=arySiteIP[3])){sameflag=1;}if((aryEndIP[0]!=arySiteIP[0])||(aryEndIP[1]!=arySiteIP[1])||(aryEndIP[2]!=arySiteIP[2])||(aryEndIP[3]!=arySiteIP[3])){sameflag=2;}if(sameflag!=0&&confirm(gettext('The prefix of DHCPv6 IP pool and site-local address does not match.\nDo you want to auto correct?'))){aryStartIP[0]=aryEndIP[0]=arySiteIP[0];aryStartIP[1]=aryEndIP[1]=arySiteIP[1];aryStartIP[2]=aryEndIP[2]=arySiteIP[2];aryStartIP[3]=aryEndIP[3]=arySiteIP[3];for(var i=0;i<8;i++){aryStartIP[i]+=":";aryEndIP[i]+=":";}tmpStartIP=bg.initaddr(aryStartIP);tmpEndIP=bg.initaddr(aryEndIP);}}}f.sStartIpv6Addr.value=tmpStartIP;f.sEndIpv6Addr.value=tmpEndIP;}if((sMLSubnet==1)&&(bg.getVleFromElmt(f.sDHCP[0],0)==4)){bg.setVle2Elmt(f.sDHCP[0],2,0);}if(parseInt('0')&&aryFullBridge[0]==1&&bg.getVleFromElmt(f.sDHCP[0],0)!=0){if(!confirm(gettext('Warning!!This will disable full bridge mode,do you really want to do it?')))return false;else f.FullBridge.value=1;}if(checkWebChange()){f.webchange.value='1';}f.sLanIp2nd.value=f.old1ndsubip.value;f.sLanMask2nd.value=f.old1ndsubmsk.value;f.sAct.value="";f.submit();}function initSelect(){f.sltIpv6Addr.options[0]=new Option(bg.strFormat(gettext("Index"),6)+bg.strFormat(gettext("IPv6 Address")+"/"+gettext("Prefix Length"),45)+bg.strFormat(gettext("Scope"),10));}function parseLanIp6Addr(){if(Ipv6LanInfo!=""){var tmp=Ipv6LanInfo.replace("##LAN1","");var tmp1=tmp.replace("##Unicast Address:## ","");if(tmp1!=""){tmp1=tmp1.replace(/\(|\)/g,"");var ary_lan=tmp1.split("## ");for(var i=0;i<ary_lan.length;i++){var ary_tmp=ary_lan[i].split(" ");aryIp6Addr[i]=new Array();aryIp6Addr[i]=([ary_tmp[0],ary_tmp[1]]);}}}}function showOnSltIp6(){var i;for(i=1;i<f.sltIpv6Addr.options.length;){f.sltIpv6Addr.options[i]=null;}if(aryIp6Addr==null)return;for(i=0;i<aryIp6Addr.length;i++){f.sltIpv6Addr.options[i+1]=new Option(bg.strFormat(i+1,6)+bg.strFormat(aryIp6Addr[i][0],45)+bg.strFormat(aryIp6Addr[i][1],10));}}function onClkIpv6Addr(){var idx=f.sltIpv6Addr.selectedIndex;if((idx!=-1)&&(idx!=0)){f.sltIpv6Addr.selectedIndex=-1;var str=aryIp6Addr[idx-1][0].split("/");if(str[0]==f.sULAAddr.value&&str[1]=="64")return;f.sStaticIPv6Addr.value=str[0];f.sStaticIPv6Prefix.value=str[1];f.sStaticIPv6Scope.value=aryIp6Addr[idx-1][1];}}function onclkUla(){var ip6Ula=bg.getVleFromElmt(f.sltULAprefix);if(ip6Ula==1){f.sULAAddr.disabled=false;}else{f.sULAAddr.disabled=true;}}function onclkv6range(){var range=bg.getVleFromElmt(f.clkv6range);if(range==1){bg.cpntCtrl(false,f,f.sStartIpv6Addr,2);}else{bg.cpntCtrl(true,f,f.sStartIpv6Addr,2);}}function onClkBtnAdd(){var addr=f.sStaticIPv6Addr.value;var prefix=f.sStaticIPv6Prefix.value;if(addr==""||!bg.isIPv6(addr)){alert(gettext('IPv6 Address is invalid!'));f.sStaticIPv6Addr.focus();return false;}for(var i=0;i<aryIp6Addr.length;i++){if(bg.IPv6Compare(addr,aryIp6Addr[i][0].split("/")[0])==0){alert(aryIp6ErrMsg[2]);return false;}}if(isNaN(prefix)||prefix<0||prefix>128){alert(gettext('Prefix length must between ###MIN### and ###MAX###, please re-enter!').replace("###MIN###",0).replace("###MAX###",128));return false;}f.sAct.value="add";f.webchange.value='1';f.submit();}function onClkBtnDel(){ f.sAct.value="del";f.webchange.value='1';f.submit();}function onclkEnIPv6(bchk){if(bchk){bg.cpntCtrl(true,f,f.wanpriinf,22);onclkUla();onclkv6range();}else bg.cpntCtrl(false,f,f.wanpriinf,22);}function onclkDHCPOpt(){document.location="/cgi-bin/V2X00.cgi?sFormAuthStr=TOO7UwhiVtwiiWv&fid=2324";}function onClkLANAlias(){window.open("/cgi-bin/lanalias.cgi?sFormAuthStr=TOO7UwhiVtwiiWv&sAct=show","LANIpAlias","toolbars=no,width=475px,height=425px,top=150px,left="+(screen.width/2-232)+"px,status=no,scrollbars=no,resize=yes,menubar=no");}</script></body></html>