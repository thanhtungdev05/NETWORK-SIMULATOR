            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/tool.min.js?094907\"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'LAN' | translate }}\" sub-title translate>LAN Port Mirror</b><hr><form action=/cgi-bin/v2x00.cgi method=POST name=frm1><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 id=mirtbl width=100%><tr><td colspan=4><translate>Port Mirror</translate>:</td></tr><tr><td colspan=4><input name=iPortMirr ng-disabled=onSubmit onclick=onClkEnable(this) type=radio value=1><translate>Enable</translate><input name=iPortMirr ng-disabled=onSubmit onclick=onClkEnable(this) type=radio value=0><translate>Disable</translate></td></tr><tr ng-show=!SHOW_LAN_PORTMIRO_TXRXSEP><td colspan=4><translate>Mirror port</translate>:</td></tr><tr ng-if=!SHOW_LAN_PORTMIRO_TXRXSEP><td><input name=iMirr ng-disabled=\"!isEnable || onSubmit\" type=radio value=0>P1</td><td><input name=iMirr ng-disabled=\"!isEnable || onSubmit\" type=radio value=1>P2</td><td><input name=iMirr ng-disabled=\"!isEnable || onSubmit\" type=radio value=2>P3</td><td ng-show=!showWAN2><input name=iMirr ng-disabled=\"!isEnable || onSubmit\" type=radio value=3>P4</td></tr><tr ng-if=SHOW_LAN_PORTMIRO_MAXWAN><td colspan=4><input name=iMirr ng-disabled=\"!isEnable || onSubmit\" type=radio value=4><translate>WAN</translate>4</td></tr><tr ng-if=!SHOW_LAN_PORTMIRO_TXRXSEP><td colspan=4><translate>Mirrored port</translate>:</td></tr><tr ng-if=!SHOW_LAN_PORTMIRO_TXRXSEP><td width=10%><input name=iMirred0 ng-disabled=\"!isEnable || onSubmit\" type=checkbox value=1>P1</td><td ng-show=!SHOW_LAN_PORTMIRO_TXRXSEP width=10%><input name=iMirred1 ng-disabled=\"!isEnable || onSubmit\" type=checkbox value=1>P2</td><td ng-show=!SHOW_LAN_PORTMIRO_TXRXSEP width=10%><input name=iMirred2 ng-disabled=\"!isEnable || onSubmit\" type=checkbox value=1>P3</td><td ng-show=!SHOW_LAN_PORTMIRO_TXRXSEP width=10%><input name=iMirred3 ng-disabled=\"!isEnable || onSubmit\" type=checkbox value=1>P4</td><td id=iMirred4 ng-show=\"SHOW_LAN_PORTMIRO_MAXWAN || (!SHOW_LAN_PORTMIRO_TXRXSEP && SHOW_LAN_PORTMIRO_SW)\" width=10%><input name=iMirred4 ng-disabled=\"!isEnable || onSubmit\" type=checkbox value=1><translate>WAN</translate> 1</td><td id=iMirred5 ng-show=\"SHOW_LAN_PORTMIRO_MAXWAN || (!SHOW_LAN_PORTMIRO_TXRXSEP && SHOW_LAN_PORTMIRO_SW)\" width=10%><input name=iMirred5 ng-disabled=\"!isEnable || onSubmit\" type=checkbox value=1><translate>WAN</translate> 2</td><td ng-show=SHOW_LAN_PORTMIRO_MAXWAN width=10%><input name=iMirred6 ng-disabled=\"!isEnable || onSubmit\" type=checkbox value=1><translate>WAN</translate> 3</td></tr><tr><td><table id=trxtbl ng-show=SHOW_LAN_PORTMIRO_TXRXSEP style=\"width: 100%; text-align: center;\"><tbody><tr style=\"background-color: #ddd;\"><th>&nbsp;</th><th ng-repeat=\"info in mirrorInfo\" ng-show=info.display><translate>Port</translate>{{$index+1}}</th><th ng-show=SHOW_LAN_PORTMIRO_SW><translate>WAN</translate>1</th><th ng-show=\"SHOW_LAN_PORTMIRO_SW && showWAN2\"><translate>WAN</translate>2</th></tr><tr ng-init=radioValue=[0,1,2,3,5,6]><td><b translate>Mirror Port</b></td><td ng-repeat=\"info in mirrorInfo\" ng-show=info.display><input name=iMirr ng-disabled=\"!isEnable || onSubmit\" ng-hide=\"!showMirrorPort1 && $index==0\" onclick=clickMirrorPort(this) type=radio value={{radioValue[$index]}}></td><td ng-show=SHOW_LAN_PORTMIRO_SW></td><td ng-show=\"SHOW_LAN_PORTMIRO_SW && showWAN2\"></td></tr><tr style=\"background-color: #ddd;\"><td><b translate>Mirrored Tx Port</b></td><td ng-repeat=\"info in mirrorInfo\" ng-show=info.display><input name={{info.nameTX}} ng-disabled=\"!isEnable || onSubmit || disLinkAggPort[info.label]\" type=checkbox value=1></td><td ng-show=SHOW_LAN_PORTMIRO_SW><input name=iMirredTx4 ng-disabled=\"!isEnable || onSubmit\" type=checkbox value=1></td><td ng-show=\"SHOW_LAN_PORTMIRO_SW && showWAN2\"><input name=iMirredTx5 ng-disabled=\"!isEnable || onSubmit\" type=checkbox value=1></td></tr><tr><td><b translate>Mirrored Rx Port</b></td><td ng-repeat=\"info in mirrorInfo\" ng-show=info.display><input name={{info.nameRX}} ng-disabled=\"!isEnable || onSubmit || disLinkAggPort[info.label]\" type=checkbox value=1></td><td ng-show=SHOW_LAN_PORTMIRO_SW><input name=iMirred4 ng-disabled=\"!isEnable || onSubmit\" type=checkbox value=1></td><td ng-show=\"SHOW_LAN_PORTMIRO_SW && showWAN2\"><input name=iMirred5 ng-disabled=\"!isEnable || onSubmit\" type=checkbox value=1></td></tr></tbody></table></td></tr></table></td></tr></table><b ng-show=note_html translate>Note</b>: <ol><li ng-show=note_html translate>The mirrored WAN1 is a software mirror, it will lead to a substantial decline in performance.</li></ol><table align=center><tr><td><input name=disable_hwaccel type=hidden value=0><input class=btnw name=btnOk ng-disabled=onSubmit onclick=onClkBtnOk() type=button value=\"{{ 'OK' | translate }}\"></td></tr></table><input name=sProfileAct type=hidden><input name=fid type=hidden><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form><textarea id=lanMirrInit style=\"display: none;\">\n\tvar isSupLinkAgg = parseInt(1);\n\tvar linkAggPorts = [];\n\tvar portNum = parseInt(5);\n\tvar aryMirred = [0,0,0,0,0,0];\n\tvar aryMirredMax = [0,0,0];\n\tvar aryMirredTx = [0,0,0,0,0,0];\n\tvar aryMirredTxMax = [0,0,0];\n\tvar is_wan2_to_lan = 0;\n\tvar iwanbelanx = 6;\n\tvar sPresetModel = '2927';\n</textarea><script> top.ACTION_STATUS=-1;top.iActionStatusFlag='1';top.iFwUpgradeState='0';var bg=parent;var f=document.frm1;var iPortMirr=parseInt('0');var iMirr=parseInt('7');var aryMirredElmt=['iMirred0','iMirred1','iMirred2','iMirred3','iMirred7','iMirred8','iMirred4','iMirred5','iMirred6'];var ary