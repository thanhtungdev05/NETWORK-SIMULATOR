            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script><style type=text/css>\n.tooltip {\n  text-decoration:none;\n  position:relative;\n}\n\n.tooltip span {\n  display:none;\n  -moz-border-radius:6px;\n  -webkit-border-radius:6px;\n  border-radius:6px;\n}\n\n.tooltip span img {\n  float:left;\n  margin:0px 8px 8px 0;\n}\n\n.tooltip:hover span {\n  display:block;\n  position:absolute;\n  top:0;\n  left:0;\n  z-index:1000;\n  width:auto;\n  margin-top:-400px;\n  margin-left:32px;\n  overflow:hidden;\n  padding:8px;\n}\n</style></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><textarea id=dialini1init style=display:none>\n\tvar aryProfileInfo = [[\"???\",\"X\",\"-DHCP\",\"0.0.0.0\",0,1,-1,1],[\"???\",\"X\",\"-DHCP\",\"0.0.0.0\",0,1,-1,2],[\"???\",\"X\",\"-DHCP\",\"0.0.0.0\",0,1,-1,3],[\"???\",\"X\",\"-DHCP\",\"0.0.0.0\",0,1,-1,4],[\"???\",\"X\",\"-DHCP\",\"0.0.0.0\",0,1,-1,5],[\"???\",\"X\",\"-DHCP\",\"0.0.0.0\",0,1,-1,6],[\"???\",\"X\",\"-DHCP\",\"0.0.0.0\",0,1,-1,7],[\"???\",\"X\",\"-DHCP\",\"0.0.0.0\",0,1,-1,8],[\"???\",\"X\",\"-DHCP\",\"0.0.0.0\",0,1,-1,9],[\"???\",\"X\",\"-DHCP\",\"0.0.0.0\",0,1,-1,10],[\"???\",\"X\",\"-DHCP\",\"0.0.0.0\",0,1,-1,11],[\"???\",\"X\",\"-DHCP\",\"0.0.0.0\",0,1,-1,12],[\"???\",\"X\",\"-DHCP\",\"0.0.0.0\",0,1,-1,13],[\"???\",\"X\",\"-DHCP\",\"0.0.0.0\",0,1,-1,14],[\"???\",\"X\",\"-DHCP\",\"0.0.0.0\",0,1,-1,15],[\"???\",\"X\",\"-DHCP\",\"0.0.0.0\",0,1,-1,16],[\"???\",\"X\",\"-DHCP\",\"0.0.0.0\",0,1,-1,17],[\"???\",\"X\",\"-DHCP\",\"0.0.0.0\",0,1,-1,18],[\"???\",\"X\",\"-DHCP\",\"0.0.0.0\",0,1,-1,19],[\"???\",\"X\",\"-DHCP\",\"0.0.0.0\",0,1,-1,20],[\"???\",\"X\",\"-DHCP\",\"0.0.0.0\",0,1,-1,21],[\"???\",\"X\",\"-DHCP\",\"0.0.0.0\",0,1,-1,22],[\"???\",\"X\",\"-DHCP\",\"0.0.0.