            "size": 4717,
            "mimeType": "text/html",
            "compression": 3000,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><script src=\"/js/tool.min.js?094907\"></script><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script><script src=\"/js/wireguard.js?094907\"></script><script src=\"/js/qrcode.min.js?094907\"></script></head><body class=ng-cloak><form action=/cgi-bin/v2x00.cgi method=post name=frm><table align=center border=0 cellpadding=0 cellspacing=0 width=950><tr><td></td></tr><tr><td><b parent=\"{{ 'VPN and Remote Access' | translate }}\" sub-title translate>WireGuard</b><hr><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=4 width=95%><tr><td width=30%><translate>Server Private Key</translate></td><td><input id=pri_key maxlength=44 minlength=44 name=prikey oninput=OnInput(this) size=55 spellcheck=false style=font-family:monospace type=text value=\"\">&nbsp; <input name=pri_Gen onclick=onClkGen() style=height:22px;width:140px type=button value=\"{{ 'Generate a Key Pair' | translate }}\"></td></tr><tr><td><translate>Server Public Key</translate></td><td><input disabled id=pub_key maxlength=44 name=publicKey size=55 style=font-family:monospace type=text value=\"\">&nbsp; <input onclick=copyToClipboard() style=height:22px;width:140px type=button value=\"{{ 'Copy to Clipboard' | translate }}\"></td><td></td></tr></tr><tr style=\"display: none;\"><td></td><td><div id=qrcodePK style=\"width:100px; height:100px; margin-bottom: 30px;\"></div></td><td></td></tr></tr><tr><td><translate>WireGuard Interface IP</translate></td><td><input id=sAddrIP maxlength=15 name=sAddrIP type=text value=192.168.1.1></td><td></td></tr><tr><td><translate>Server Listen port</translate></td><td><input id=iListenPort maxlength=5 name=iListenPort size=5 type=text></td><td></tr><tr><td align=center colspan=3><input class=btnw onclick=onClkOK() type=button value=\"{{ 'OK' | translate }}\"></td><tr></table></td></tr></table><input name=webchange type=hidden value=0><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"><input name=fid type=hidden value=2508><input name=sAct type=hidden value=savesrv></form></td></tr></table><div id=qrcode></div><script type=text/javascript> var qrcodePK=new QRCode(document.getElementById(\"qrcodePK\"),{text:document.getElementById(\"pub_key\").value,width:128,height:128,colorDark:\"#000000\",colorLight:\"#ffffff\",correctLevel:QRCode.CorrectLevel.H});</script><script>top.ACTION_STATUS=-1;top.iActionStatusFlag='1';top.iFwUpgradeState='0';top.act_sta.damage_alert();var bg=parent;var f=document.frm;var sPrivatekey='';var sPublickey='';var sWGIp='192.168.1.1';var iWGListenPort='51820'; angular.element(document).ready(function(){initParameter();initWebChange();});function initParameter(){bg.setVle2Elmt(f.pri_key,sPrivatekey,0);bg.setVle2Elmt(f.pub_key,sPublickey,0);if(sWGIp==\"\")sWGIp=\"192.168.1.1\";bg.setVle2Elmt(f.sAddrIP,sWGIp,0);if(iWGListenPort==0)iWGListenPort=51820;bg.setVle2Elmt(f.iListenPort,iWGListenPort,0);if(sPrivatekey==\"\"){qrcodePK.makeCode(\"Key is not the correct length or format.\");}}function onClkGen(element){var keypair=wireguard.generateKeypair();document.getElementById(\"pri_key\").value=keypair.privateKey;document.getElementById(\"pub_key\").value=keypair.publicKey;qrcodePK.clear(); qrcodePK.makeCode(document.getElementById(\"pub_key\").value);}function copyToClipboard(element){var copyText=document.getElementById('pub_key');copyText.disabled=false;copyText.select();copyText.disabled=true;document.execCommand('copy');}function OnInput(event){var sPrikeyvalue=f.prikey.value;if(sPrikeyvalue.length<44){document.getElementById('pub_key').value=gettext(\"Key is not the correct length or format.\");}else{var atob;try{atob=window.atob(sPrikeyvalue);var atobLength=atob.length;var array=new Uint8Array(new ArrayBuffer(atobLength));for(i=0;i<atobLength;i++){array[i]=atob.charCodeAt(i);}var keyToBase64=wireguard.getNewPubkey(array);document.getElementById('pub_key').value=keyToBase64;}catch{document.getElementById('pub_key').value=gettext(\"Key is not the correct length or format.\");}}qrcodePK.clear(); qrcodePK.makeCode(document.getElementById(\"pub_key\").value);}function onClkOK(){var sPrikeyvalue=f.prikey.value;if(sPrikeyvalue.length<44){f.prikey.focus();return false;}if(!bg.isStrIp(f.sAddrIP.value)){alert(gettext(\"Invalid IP Address!\"));f.sAddrIP.focus();return false;}if(!bg.isStrPort(f.iListenPort.value)){alert(gettext(\"Invalid Port!\"));f.iListenPort.focus();return false;}if(checkWebChange()){f.webchange.value='1';}document.getElementById('pub_key').disabled=false;f.submit();}</script></body></html>"
