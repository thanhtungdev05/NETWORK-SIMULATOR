            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><script src=\"/js/webchange.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><style>\n.select{background:Gainsboro;}\ncanvas{background-color:#BEBEBE;}\nth{color:white;font-weight:bold;background-color:grey;}\nspan{white-space : nowrap;}\nbody{position:relative;}\n#net_map{background-color:#BEBEBE;z-index:-1;position: absolute;}\n#out{width:500px;height:460px;position:relative;z-index:0;background-color:#BEBEBE;}\n#centr{width:60px;height:60px;position:absolute;top:190px;left:230px;z-index:0;}\n#rout0{width:40px;height:40px;position:absolute;top:10px;left:240px;z-index:0;}\n#rout1{width:40px;height:40px;position:absolute;top:70px;left:330px;z-index:0;}\n#rout2{width:40px;height:40px;position:absolute;top:150px;left:380px;z-index:0;}\n#rout3{width:40px;height:40px;position:absolute;top:240px;left:330px;z-index:0;}\n#rout4{width:40px;height:40px;position:absolute;top:290px;left:240px;z-index:0;}\n#rout5{width:40px;height:40px;position:absolute;top:240px;left:150px;z-index:0;}\n#rout6{width:40px;height:40px;position:absolute;top:150px;left:90px;z-index:0;}\n#rout7{width:40px;height:40px;position:absolute;top:70px;left:150px;z-index:0;}\n#rout8{width:40px;height:40px;position:absolute;top:70px;left:150px;z-index:0;}\n#rout9{width:40px;height:40px;position:absolute;top:70px;left:150px;z-index:0;}\n#rout10{width:40px;height:40px;position:absolute;top:70px;left:150px;z-index:0;}\n#rout11{width:40px;height:40px;position:absolute;top:70px;left:150px;z-index:0;}\n#rout12{width:40px;height:40px;position:absolute;top:70px;left:150px;z-index:0;}\n#rout13{width:40px;height:40px;position:absolute;top:70px;left:150px;z-index:0;}\n#rout14{width:40px;height:40px;position:absolute;top:70px;left:150px;z-index:0;}\n#rout15{width:40px;height:40px;position:absolute;top:70px;left:150px;z-index:0;}\n\n#contentbox {width:400px;height:150px;position:fixed;left:200px;top:100px;margin:0;z-index:20;display:none;background:#D4D4D4;padding:20px}\n#closewin{position:absolute;right:10px;top:10px;text-decoration:none;color:#999}\nul{width:110px;height:100px;border:0px solid #999;border-bottom:0;margin:0;padding:0;}\nul > li{width:110px;height:22px;list-style:none;padding:0;margin:0;line-height:40px;border-bottom:0px solid #999;text-indent:15px;font-weight:bold;}\nul > li:hover{color:#EEB422}\n.modalset-container{width:100px;height:125px;position:absolute;left:200px;top:100px;margin:0;z-index:3;padding:20px;}\n.modal-container{width:340px;height:200px;position:absolute;left:200px;top:100px;margin:0;z-index:2;padding:20px;\n\tbackground-image:url('/images/380x240.png');background-size: 380px 270px;}\n.modal-background{width:9999px;height:99999px;position:fixed;left:0;top:0;overflow-x:auto;overflow-y:scroll;margin:0;\n\tbackground:#000000;opacity:0.6;z-index:10;}\n.modaladv-container{width:400px;height:200px;position:absolute;left:50%;top:50%;transform:translate(-50%, -50%);margin:0;z-index:20;padding:20px;\n\tbackground-image:url('/images/440x240.png');}\n.wait-container{position:absolute;margin:0;z-index:30;left:50%;top:50%;transform:translate(-50%, -50%);}\n\n.dashboard {\n\tbackground-image: url('/images/dashboard.png');\n\tbackground-repeat: no-repeat;\n}\n.dashboard.x {\n\twidth: 16px;\n\theight: 16px;\n\tbackground-position: -5px -81px;\n    display: inline-block;\n}\n</style></head><body class=ng-cloak><form name=frm1><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'VPN' | translate }}\" sub-title translate>VPN Management</b><hr></td></tr><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=700><tr><td align=right class=red>|&nbsp; <a href=\"javascript: onRefresh()\" translate>Refresh</a>&nbsp;|</td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 height=460px style=background-color:#BEBEBE width=700px><tr><td height=460px width=500px><div id=out><canvas id=\"net_map\" width=\"500px\" height=\"460px\"></canvas><div id=centr><img / alt src=/images/ImageCD_u129.png></div><div id=rout{{i}} ng-init=i=$index ng-mouseleave=closeModal(0) ng-mouseover=openModal(i) ng-repeat=\"rout in routers\" ng-show=rout.show ng-style=cpePosition[i]><img / alt id=image{{i}} ng-click=onClickVpnDialType(i) ng-src={{rout.image}}><span id=\"routname{{i}}\">{{rout.name}}</span></div><div class=modal-container ng-if=showModalInfo ng-style=modalPosition><br><br><table align=center border=1 cellpadding=2 cellspacing=0 width=340><tr><td width=55%><translate>Router Name</translate>:</td><td>{{modalInfo.name}}</td></tr><tr><td><translate>Router Model</translate>:</td><td>{{modalInfo.model}}</td></tr><tr><td><translate>Location</translate>:</td><td>{{modalInfo.location}}</td></tr><tr><td><translate>WAN</translate>&nbsp;<translate>IP</translate>:<span ng-show=\"notPublic\" ng-init=\"notPublic=false\">(<translate>behind NAT</translate>)</span></td><td>{{modalInfo.wanIP}}</td></tr><tr><td><translate>Real Public IP</translate>:</td><td>{{modalInfo.publicIP}}</td></tr><tr><td><translate>LAN</translate>&nbsp;<translate>IP</translate>/<translate>Subnet</translate>:</td><td>{{modalInfo.lanIP}}</td></tr><tr><td><translate>VPN Profile</translate>:</td><td>{{modalInfo.vpnProfile}}</td></tr><tr><td><translate>VPN TYPE</translate>:</td><td>{{modalInfo.vpnType[0]}}<br>{{modalInfo.vpnType[1]}}</td></tr></table></div><div class=modalset-container ng-if=showOptions ng-mouseleave=closeModal(1) ng-style=modalStyle><ul><br><br><li onclick=javascript:onClkVpnSet('IPsec_Tunnel'); translate>IPsec</li><li onclick=javascript:onClkVpnSet('PPTP'); translate>PPTP</li><li ng-if=hasSSL onclick=javascript:onClkVpnSet('SSL_Tunnel'); translate>SSL</li><li onclick=javascript:onClkVpnSet('Advanced'); translate>Advanced</li><input ng-value=cpeIndex style=display:none type=hidden></ul></div></div></td><td valign=top><table align=center border=0 cellpadding=0 cellspacing=10 width=200px><tr><td height=50><img src=/images/ImageCI_u21.png></td><td>&nbsp;</td><td style=\"font-family:Arial, Helvetica, sans-serif;color:white;font-weight:bold;\" translate>Central Site</td></tr><tr><td height=50><img src=/images/ImageCI_u24.png></td><td>&nbsp;</td><td style=\"font-family:Arial, Helvetica, sans-serif;color:green;font-weight:bold;\" translate>Remote Site Online</td></tr><tr><td height=50><img src=/images/ImageCI_u27.png></td><td>&nbsp;</td><td style=\"font-family:Arial, Helvetica, sans-serif;color:red;font-weight:bold;\" translate>Remote Site Offline</td></tr><tr><td height=50><img src=/images/u32_line.png></td><td>&nbsp;</td><td style=\"font-family:Arial, Helvetica, sans-serif;color:green;font-weight:bold;\" translate>IPsec VPN</td></tr><tr><td height=50><img src=/images/u34_line.png></td><td>&nbsp;</td><td style=\"font-family:Arial, Helvetica, sans-serif;color:#5CACEE;font-weight:bold;\" translate>PPTP VPN</td></tr><tr><td height=50><img src=/images/u35_line.png></td><td>&nbsp;</td><td style=\"font-family:Arial, Helvetica, sans-serif;color:purple;font-weight:bold;\" translate>SSL VPN</td></tr><tr><td height=50><img src=/images/u33_line.png></td><td>&nbsp;</td><td style=\"font-family:Arial, Helvetica, sans-serif;color:red;font-weight:bold;\" translate>VPN Disconnected</td></tr></table></td></tr></table><div class=wait-container ng-show=onWaiting><div><img ng-src={{loading}}></div></div><div class=modal-background ng-show=showAdvSet></div><div class=modaladv-container ng-show=showAdvSet><div><p><img class=\"dashboard x\" id=closewin onclick=closeBox() src=data:image/gif;base64,R0lGODlhAQABAIAAAP///wAAACH5BAEAAAAALAAAAAABAAEAAAICRAEAOw==></p><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td width=40%><translate>Dial Type</translate>:</td><td><select convert-to-number id=type ng-model=selectedDialType><option ng-if=hasSSL translate value=2>SSL_Tunnel</option><option translate value=1>IPsec_Tunnel</option><option translate value=0>PPTP</option></select></td></tr><tbody ng-show=\"selectedDialType == 0\"><tr><td><translate>PPP Authentication</translate>:</td><td><select name=auth><option translate value=1>PAP only</option><option translate value=3>PAP or CHAP</option></select></td></tr><tr><td><translate>VJ Compression</translate>:</td><td><select name=vj><option translate value=1>ON</option><option translate value=0>OFF</option></select></td></tr></tbody><tbody ng-show=\"selectedDialType == 1\"><tr><td><translate>IKE Pre-Shared Key</translate>:</td><td><input maxlength=31 name=pskey type=text></td></tr><tr><td><translate>IPsec Security Method</translate>:</td><td><select name=meth><option translate value=0>AH</option><option translate value=4>DES without Authentication</option><option translate value=5>DES with Authentication</option><option translate value=6>3DES without Authentication</option><option translate value=7>3DES with Authentication</option><option translate value=2>AES without Authentication</option><option translate value=3>AES with Authentication</option></select></td></tr><tr><td><translate>IKE Phase1 Mode</translate>:</td><td><select name=mode><option translate value=0>Aggressive</option><option translate value=1>Main</option></select></td></tr></tbody><tbody ng-show=\"selectedDialType == 2\"><tr><td><translate>SSL VPN Port</translate>:</td><td><input maxlength=31 name=sslport type=text></td></tr></tbody><tr><td><translate>More IP</translate>:</td><td><input maxlength=380 name=cvm_more_ip placeholder=\"e.g. 192.168.2.0/24|192.168.3.0/24\" style=width:220px type=text></td></tr><tr><td align=right><input name=create_sa type=checkbox></td><td translate>Create Phase2 SA for each subnet</td></tr><tr><td align=center colspan=2><input class=btnw onClick=btnOK() type=button value=\"{{ 'OK' | translate }}\"></td></tr></table><br></div></div></td></tr><tr><td><br><b translate>Note</b>: <ol><li translate>CVM SSL LAN-to-LAN dial-up might fail with the CPE of old version firmware. Please update the remote CPE to the latest version.</li></ol></td></tr><tr><td>&nbsp;</td></tr><tr><td><b translate>CPE VPN Connection List</b></td></tr><tr><td><div style=\"border:solid 1px;\"><table id=vpnl><tr><th translate width=7%>VPN</th><th translate width=14%>Type</th><th translate width=14%>Remote IP</th><th translate width=14%>Virtual Network</th><th translate width=6%>Tx Pkts</th><th translate width=9%>Tx Rate(bps)</th><th translate width=6%>Rx Pkts</th><th translate width=9%>Rx Rate(bps)</th><th translate width=6%>Up Time</th></tr><tr class=row{{i%2}} ng-init=i=$index ng-repeat=\"item in connList\"><td align=center nowrap><font color={{item.color}} size=1>{{i+1}}<br>{{item.name}}</font></td><td align=center><font color={{item.color}} size=1>{{item.type[0]}}<br>{{item.type[1]}}</font></td><td align=center><font color={{item.color}} size=1>{{item.remote[0]}}<br> via {{item.remote[1]}}</font></td><td align=center><font color={{item.color}} size=1>{{item.virtual}}</font></td><td align=center><font color={{item.color}} size=1>{{item.tx[0]}}</font></td><td align=center><font color={{item.color}} size=1>{{item.tx[1]}}</font></td><td align=center><font color={{item.color}} size=1>{{item.rx[0]}}</font></td><td align=center><font color={{item.color}} size=1>{{item.rx[1]}}</font></td><td align=center><font color={{item.color}} size=1>{{item.time}}</font></td></tr></table></div></td></tr></table></form><textarea id=cvmConninit style=\"display: none;\">\nvar dev_ary=[];\nvar vpn_l2lps_name=[\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???\",\"???