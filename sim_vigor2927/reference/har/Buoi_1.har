]==\"ONLINE GAME\"&&iCountryCode==14)continue;if(idx==0){ if(aryAppQosVal[i][2]=='1')f[\"iQosUsage\"+i].checked=true;}else{ if(aryAppQosVal[i][2]=='0'){f[\"iQosUsage\"+i].checked=true;}}}}function onClrAll(idx){for(var i=0;i<aryAppQosVal.length;i++){if(aryAppQosVal[i][6]==\"ONLINE GAME\"&&iCountryCode==14)continue;if(idx==0){ if(aryAppQosVal[i][2]=='1'){f[\"iQosUsage\"+i].checked=false;}}else{ if(aryAppQosVal[i][2]=='0'){f[\"iQosUsage\"+i].checked=false;}}}}function onApplyToAll(){var iaction;iaction=bg.getVleFromElmt(f.iActAppeTrace,0);for(var i=0;i<aryAppQosVal.length;i++){if(aryAppQosVal[i][6]==\"ONLINE GAME\"&&iCountryCode==14)continue;if(aryAppQosVal[i][2]=='1'){ f[\"iQosAction\"+i].value=iaction;}}}function onChgUntrace(){var iaction;iaction=bg.getVleFromElmt(f.iActAppeUntrace,0);for(var i=0;i<aryAppQosVal.length;i++){if(aryAppQosVal[i][6]==\"ONLINE GAME\"&&iCountryCode==14)continue;if(aryAppQosVal[i][2]=='0'){f[\"iQosAction\"+i].value=iaction;}}}function onClkBtnOk(){f.submit();}function onClkBtnCcl(){document.location.href=\"/cgi-bin/appqos.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&iAct=0\";}</script></body></html>"
