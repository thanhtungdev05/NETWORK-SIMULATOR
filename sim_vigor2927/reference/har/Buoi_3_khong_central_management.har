            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script></head><body class=ng-cloak><form name=form1><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'System Maintenance' | translate }}\" sub-title translate>Time and Date</b><hr><table align=center border=0 cellpadding=2 cellspacing=0 width=700><tr><td><b translate>Time Information</b></td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=700><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=600><tr><td><translate>Current System Time</translate></td><td width=70%><b><input class=systime name=stime size=35 type=text></b>&nbsp;&nbsp; <input class=btn type=button value=\"{{ 'Inquire Time' | translate }}\"></td></tr></table></td></tr></table><br><table align=center border=0 cellpadding=2 cellspacing=0 width=700><tr><td><b translate>Time Setup</b></td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=700><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=600><tr><td colspan=2><input name=rdo1 type=radio value=0><translate>Use Browser Time</translate></td></tr><tr><td colspan=3><input name=rdo1 type=radio value=1><translate>Use Internet Time</translate></td></tr><tr style=display:none><td style=display:none width=15></td><td style=display:none><translate>Time Protocol</translate></td><td style=display:none width=60%><select><option translate value=0>NTP (RFC-1305)</option></select></td></tr><tr><td width=15></td><td ng-if=!hasSecNTP translate>Time Server</td><td ng-if=hasSecNTP translate>Primary Server</td><td><input maxlength=128 name=ntpServer1 style=\"width: 355px;\" type=text></td></tr><tr ng-show=hasSecNTP><td width=15></td><td translate>Secondary Server</td><td><input