option><option value=16>16</option><option value=17>17</option><option value=18>18</option><option value=19>19</option><option value=20>20</option><option value=21>21</option><option value=22>22</option><option value=23>23</option><option value=24>24</option><option value=25>25</option><option value=26>26</option><option value=27>27</option><option value=28>28</option></select></td></tr><tr><td><input name=rdo3 type=radio value=3><translate>Cycle duration</translate>: <select name=iCycleDur size=1><option ng-init=i=$index+1 ng-repeat=\"ii in [].constructor(30) track by $index\" value={{i}}>{{i}}</option></select>&nbsp;<translate>days</translate> (<translate>Cycle will start on the Start Date.</translate>) </td></tr></table></td></tr></table><br><b translate>Note</b>: <ol><li><translate>Comment can not contain characters</translate> ~ ! @ # $ % ^ & ( ) ' \" { } | ; \\ > < </li></ol><br><table align=center width=100%><tr align=center><td><input class=btnw name=btnOK type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <span ng-if=\"!isWizMode\"><input class=btnw name=btnClr type=button value=\"{{ 'Clear' | translate }}\">&nbsp;&nbsp;</span><input class=btnw name=btnCcl type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table><br><input name=sFormAuthStr type=hidden value=\"TOO7UwhiVtwiiWv\"></form></td></tr></table><script src=\"/js/variable.js?10886\"></script><script>tp.ACTION_STATUS=-1;tp.iActionStatusFlag=iActionStatusFlag;tp.iFwUpgradeState=iFwUpgradeState;tp.act_sta.damage_alert();var f=document.form1;var i,j; angular.element(document).ready(function(){initPage();initParameter();initWebChange();showTime();for(var d=0;d<document.forms.length;d++){addhandlers(document.forms[d]);for(var e=0;e<document.forms[d].elements.length;e++)addhandlers(document.forms[d].elements[e]);}setInterval(\"showTime()\",1000);if(iSchWiz>0&&schdWizSubmit)setTimeout(\"self.close()\",500);});function showTime(){ var sysTime=new Date(sysYear,sysMonth,sysDay,sysHour,sysMin,sysSec);var curTime=new Date();var timeDiff=sysTime.getTime()-curTime.getTime()+3;var aryW=new Array(gettext(\"Sun\"),gettext(\"Mon\"),gettext(\"Tue\"),gettext(\"Wed\"),gettext(\"Thu\"),gettext(\"Fri\"),gettext(\"Sat\"));var aryM=new Array(gettext(\"Jan\"),gettext(\"Feb\"),gettext(\"Mar\"),gettext(\"Apr\"),gettext(\"May\"),gettext(\"Jun\"),gettext(\"Jul\"),gettext(\"Aug\"),gettext(\"Sep\"),gettext(\"Oct\"),gettext(\"Nov\"),gettext(\"Dec\"));var date=new Date();date.setTime(date.getTime()+timeDiff);f.stime.value=date.getFullYear()+\" \"+aryM[date.getMonth()]+\" \"+date.getDate()+\" \"+aryW[date.getDay()]+\" \"+date.getHours()+\" : \"+date.getMinutes()+\" : \"+date.getSeconds();} function initPage(){$scope.isWizMode=iSchWiz>0;$scope.newSchedule=bNewSchedule&&bg.SHOW_SYS_ADMIN;$scope.$apply();if(bg.CTL_APP_SCH_IDX1&&iSchIdx==1){for(var i=0;i<f.elements.length;i++){f[i].disabled=true;}f.btnCcl.disabled=false;}} function initParameter(){var aryVle=new Array();aryVle=[f.schedEn,schEnable,0,f.txtComment,txtComment,0,f.stYY,schSt_y,0,f.stMonth,schSt_m,0,f.stDD,schSt_d,0,f.stHH,schSt_hr,0,f.stMM,schSt_min,0,f.durHH,schDn_hr,0,f.durMM,schDn_min,0,f.sAction,schAction,0,f.iIdle,schIdle,0,f.rdo3[0],schHOften,0,f.iSun,schWdays&0x40,0,f.iMon,schWdays&0x20,0,f.iTue,schWdays&0x10,0,f.iWed,schWdays&0x08,0,f.iThu,schWdays&0x4,0,f.iFri,schWdays&0x2,0,f.iSat,schWdays&0x1,0,f.iMonthly,iSchMonthly,0,f.iCycleDur,iSchCycle,0];for(i=0;i<aryVle.length;i++){bg.setVle2Elmt(aryVle[i],aryVle[++i],aryVle[++i]);}bg.cpntCtrl(f.schedEn,f,f.txtComment,25);bg.cpntCtrl(false,f,f.endHH,2);if(f.schedEn.checked)bg.cpntCtrl(f.rdo3[1],f,f.iSun,7);if(0==bg.getVleFromElmt(f.sAction,0)||1==bg.getVleFromElmt(f.sAction,0)||0==bg.getVleFromElmt(f.schedEn,0)){bg.cpntCtrl(false,f,f.iIdle,1);}else if(0!=bg.getVleFromElmt(f.schedEn,0)){bg.cpntCtrl(true,f,f.iIdle,1);}onCalculateTime();} function goSystem(){document.location.href=\"/cgi-bin/v2x00.cgi?sFormAuthStr=\"+tp.authStr+\"&fid=6\";}function onCalculateTime(){var stHH=bg.getVleFromElmt(f.stHH,0);var stMM=bg.getVleFromElmt(f.stMM,0);var durHH=bg.getVleFromElmt(f.durHH,0);var durMM=bg.getVleFromElmt(f.durMM,0);var endMM,endHH,add=0;endMM=parseInt(durMM)+parseInt(stMM);if(endMM>=60){endMM=endMM-60;add=1;}if(endMM<10)endMM='0'+endMM;endHH=parseInt(stHH)+parseInt(durHH)+parseInt(add);if(endHH>=24){endHH=endHH-24;bg.showElmtById(document,\"overnignt\");}else bg.hideElmtById(document,\"overnignt\");if(endHH<10)endHH='0'+endHH;bg.setVle2Elmt(f.endMM,endMM,0);bg.setVle2Elmt(f.endHH,endHH,0);}function getDaysInOneMonth(year,month){month=parseInt(month,10);var d=new Date(year,month,0);return d.getDate();}function submitParameter(){var stYY=bg.getVleFromElmt(f.stYY);var stMonth=bg.getVleFromElmt(f.stMonth);var stDD=bg.getVleFromElmt(f.stDD);if(stDD>getDaysInOneMonth(stYY,stMonth)){alert(gettext(\"Start Date is invalid !!!\"));return false;}var str_cmt=bg.getVleFromElmt(f.txtComment);if(str_cmt.length>31){alert(gettext(\"Invalid input, comment length should be less than ###MAX### characters.\").replace(\"###MAX###\",32));return false;}var arySmtVle=new Array(); var arySmtNme=new Array(); var webchange=0;var myUrl=\"/cgi-bin/V2X00.cgi?sFormAuthStr=\"+tp.authStr+\"&fid=\"+bg.V2X00_FID_SCHEDULE2+\"&iSchWiz=\"+iSchWiz;i=0;arySmtVle=[iSchIdx,bg.getVleFromElmt(f.schedEn,0),bg.getVleFromElmt(f.stYY),bg.getVleFromElmt(f.stMonth),bg.getVleFromElmt(f.stDD),bg.getVleFromElmt(f.stHH),bg.getVleFromElmt(f.stMM),bg.getVleFromElmt(f.durHH),bg.getVleFromElmt(f.durMM),bg.getVleFromElmt(f.sAction),bg.getVleFromElmt(f.iIdle),bg.getVleFromElmt(f.rdo3[0]),((bg.getVleFromElmt(f.iSun)<<6)+(bg.getVleFromElmt(f.iMon)<<5)+(bg.getVleFromElmt(f.iTue)<<4)+(bg.getVleFromElmt(f.iWed)<<3)+(bg.getVleFromElmt(f.iThu)<<2)+(bg.getVleFromElmt(f.iFri)<<1)+(bg.getVleFromElmt(f.iSat)<<0)),bg.getVleFromElmt(f.iMonthly),bg.getVleFromElmt(f.iCycleDur)];arySmtNme=[bg.HTML_SCH_INDEX,bg.HTML_SCH_ENABLE,bg.HTML_SCH_ST_Y,bg.HTML_SCH_ST_M,bg.HTML_SCH_ST_D,bg.HTML_SCH_ST_HR,bg.HTML_SCH_ST_