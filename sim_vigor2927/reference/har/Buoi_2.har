            "mimeType": "text/html",
            "compression": 7736,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><script src=\"/cgi-bin/certificatedata.cgi?sFormAuthStr=JdvKVyYlhh7GhS9\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'VPN and Remote Access' | translate }}\" sub-title translate>IPsec General Setup</b><hr><form action=/cgi-bin/v2x00.cgi method=post name=frm1><input name=webchange type=hidden value=0><input name=fid type=hidden value=30><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"><table align=center border=0 cellpadding=2 cellspacing=0 width=700><tr><td><b translate>VPN IKE/IPsec General Setup</b></td></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 width=700><tr><td align=left> (<translate>Dial-in settings for Remote Dial-In users and LAN-to-LAN VPN Client with Dynamic IP.</translate>)</td></tr></table><table align=center border=1 cellpadding=10 cellspacing=0 width=700><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=95%><tr><td colspan=2><b translate>IKE Authentication Method</b></td></tr><tr><td colspan=2><hr size=1></td></tr><tr ng-if=bMULTI_CERT><td translate width=40%>Certificate</td><td width=60%><select name=sltDinX509 size=1><option translate value=0>None</option></select></td></tr><tr ng-if=bMULTI_CERT><td translate>Preferred Local ID</td><td><select name=rdSecMethod size=1><option translate value=0>Alternative Subject Name</option><option translate value=1>Subject Name</option></select></td></tr><tr ng-if=bMULTI_CERT><td colspan=2><br></td></tr><tr><td translate>General Pre-Shared Key</td><td width=60%><input class=pskey maxlength=63 name=txtDinPSKey placeholder=\"{{ 'Max: ###LEN### characters' | translate }}\" size=50 type=password></td></tr><tr><td translate>Confirm General Pre-Shared Key</td><td width=60%><input class=pskey maxlength=63 name=txtDinPSKey1 placeholder=\"{{ 'Max: ###LEN### characters' | translate }}\" size=50 type=password></td></tr><tr><td colspan=2><br></td></tr><tr ng-show=\"ixauthSupt && !VNvpnsecur\"><td translate>XAuth User Pre-Shared Key</td><td width=60%><input class=pskey maxlength=63 name=txtXAuthPsk placeholder=\"{{ 'Max: ###LEN### characters' | translate }}\" size=50 type=password></td></tr><tr ng-show=\"ixauthSupt && !VNvpnsecur\"><td translate>Confirm XAuth User Pre-Shared Key</td><td width=60%><input class=pskey maxlength=63 name=txtXAuthPsk1 placeholder=\"{{ 'Max: ###LEN### characters' | translate }}\" size=50 type=password></td></tr><tr><td colspan=2><br></td></tr><tr><td><b translate>IPsec Security Method</b></td></tr><tr><td colspan=2><hr size=1></td></tr><tr><td valign=middle><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td ng-show=!VNvpnsecur><input name=rdosecmode type=radio value=0><translate>Basic</translate></td><td ng-show=!VNvpnsecur><input name=rdosecmode type=radio value=1><translate>Medium</translate></td><td><input name=rdosecmode type=radio value=2><translate>High</translate></td></tr></table></td><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><translate>Encryption</translate>: <span id=\"encrypt\" translate>AES/3DES/DES</span></td></tr><tr><td><translate>HMAC</translate>: <span id=\"hmac\"><script> var str=gettext(\"SHA256/SHA1\");if(!parseInt('1'))str+=\"/\"+gettext(\"MD5\");document.write(str);</script></span></td></tr><tr><td><translate>DH Group</translate>: <span id=\"dhgroup\">G21/G20/G19/G14/G5/G2/G1</span></td></tr><tr ng-show=!VNvpnsecur><td>AH: <input name=chkDinAH type=checkbox value=1><translate>Enable</translate></td></tr></table></td></tr><tr><td><br></td></tr><tr><td colspan=2><b translate>VPN TCP maximum segment size (MSS)</b></td></tr><tr><td colspan=2><hr size=1></td></tr><tr><