            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><meta content=\"60; URL=/cgi-bin/cgiapm.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=0&sFormAuthStr=JdvKVyYlhh7GhS9\" http-equiv=Refresh><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/b64.min.js?094907\"></script><script src=\"/js/chart.min.js?094907\"></script><script> angular.extend({browser:{msie:/msie/.test(navigator.userAgent.toLowerCase())}});</script><style type=text/css>\nimg {\n\tcursor:pointer;\n}\n#apml {\n\tmargin:0px 0px 0px 0px;\n\tlist-style:none;\n\toverflow:auto;\n\tborder:solid 0px;\n\tpadding-bottom:20px;\n\twidth:400px;\n\theight:275px;\n}\n#apml dd {\n\tdisplay:inline-block;\n\t*display:inline;\n\tzoom:1;\n\twidth:95px;\n\tmargin:1px 1px 1px 1px;\n\tpadding:1px;\n\tvertical-align:top;\n}\n.apmlitem {\n\tdisplay:block;\n\twidth:95px;\n\ttext-align:center;\n\tfont-size: 10px;\n}\ntextarea {\n\tfont-size: 11px;\n\tborder: 0;\n}\n\n\n#status,#log,#traffic,#conn {width:403px;float:left;border:1px solid #999;margin:10px 0}\n#log,#conn {margin-left:10px;}\n#note1  {width:420px;float:left;border:0px;margin:0 0}\n#note2  {width:400px;float:left;border:0px;margin:0 0}\n#html5\t{width:800px;float:left;border:0px;margin:0 0}\n.titl {height:24px;line-height:24px;background:#9D9D9D;color:#fff;text-indent:10px}\n.titl a {color:#fff;text-decoration:none}\n.cnt {height:300px;}\n.chart-container {height:300px;position:relative;}\n.chart {width: 403px;height: 300px;position: absolute;}\n.legend-container {z-index: 9;display:inline-block;right: 25px; top: 20px;background:rgba(255,255,255,0.6);border: 1px solid #ccc;position: absolute;font-size: .75em;}\ntextarea{ box-sizing:border-box; width:400px; height:295px; }\n</style></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=840><tr><td><b parent=\"{{ 'AP' | translate }}\" sub-title transla