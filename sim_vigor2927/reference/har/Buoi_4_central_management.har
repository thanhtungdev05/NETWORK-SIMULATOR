            "mimeType": "text/html",
            "compression": 33399,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script><style>\n \t#vpninfo{width:540px;height:200px;position:absolute;left:300px;top:500px;margin:0;z-index:2;display:none;padding:20px;\n\tbackground-color:rgba(0,0,0,0.7);}\n\t#cfmtbl td{color:#ffffff};\n </style><script> var informurl='/cgi-bin/v2x00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=1302';function updateInformTime_callback(data){if(data){var statusarr=data.data.split('|');if(statusarr[1]=='401'){ statusarr[0]=\" [HTTP 401 UNAUTHORIZED] \"+statusarr[0];}else if(statusarr[1]=='404'){ statusarr[0]=\" [No response] \"+statusarr[0];}document.getElementById(\"inform\").innerHTML=statusarr[0]+'&nbsp;<img style=\"vertical-align: bottom;height: 16px\"  src=\"'+(statusarr[1]==1?'/images/led-up.gif':'/images/led-down.gif')+'\">'+(statusarr[1]=='404'?'<br>'+gettext('Please check your Internet Connection or ACS URL setting!'):'');if(acsSecEnable){if(statusarr[2]==\"0\"){document.getElementById(\"acsServerTarget\").innerHTML=gettext(\"Connected to Primary.\");}else{document.getElementById(\"acsServerTarget\").innerHTML=gettext(\"Connected to Secondary.\");}}}cpe_enable&&angular.element(document.querySelectorAll(\".always_enable\")).prop(\"disabled\",false);}function updateInformTime(){$http.get(informurl,{params:{send:'0',tt:(new Date).getTime()}}).then(updateInformTime_callback);}function inform_click_callback(isPageLoad){angular.element(document.querySelectorAll(\".always_enable\")).prop(\"disabled\",true);document.getElementById(\"inform\").innerHTML=gettext(\"Waiting for ACS response...\");if(isPageLoad){setTimeout(function(){$http.get(informurl,{params:{eventCode:f[\"eventCode\"].value,send:'1',tt:(new Date).getTime()}}).then(function(response){setTimeout(updateInformTime,1000);});},3000);}else $http.get(informurl,{params:{eventCode:f[\"eventCode\"].value,send:'1',tt:(new Date).getTime()}}).then(function(response){setTimeout(updateInformTime,1000);});}</script></head><body class=ng-cloak><form action=/cgi-bin/v2x00.cgi method=post name=frm1><input name=fid type=hidden value=1301><input name=webchange type=hidden value=0><table align=center border=0 cellpadding=0 cellspacing=0 width=750><tr><td colspan=2><b parent=\"{{ 'System Maintenance' | translate }}\" qslink=\"https://www.draytek.com/router-help-redirect?stk_title=System Maintenance&nd_title=TR-069 Setting&tb_title=ACS and CPE Settings\" sub-title translate>TR-069</b><hr><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td class=ontab id=tab11 width=27%><b translate>ACS and CPE Settings</b></td><td class=offtab id=tab12 onClick=gotohealth() style=display:none width=27%><b translate>Reporting Configuration</b></td><td class=offtab id=tab13 onClick=gotoexport() width=27%><b translate>Export Parameters</b></td><td id=tab14></td></tr></table><table align=center border=1 cellpadding=8 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=4 cellspacing=0 style=margin-bottom:5px width=100%><tr><td colspan=2><label><input name=cpe_enable ng-model=cpe_enable onclick=acs_web_enable() type=checkbox value=1>&nbsp;<b translate>Enable TR-069</b></label></td></tr><tr ng-show=zlib><td colspan=2><label id=\"gzip_label\" title=\"{{ 'Make sure your ACS server version is 3.4.0 or later' | translate }}\"><input name=cpe_gzip ng-checked=cpe_gzip type=checkbox value=1>&nbsp;<b translate>Enable HTTP compression</b></label></td></tr></table><table align=center border=0 cellpadding=4 cellspacing=0 id=acsserverarea width=100%><tr ng-if=!isAcsSecEnable ng-show=isChtmodShow><td><b translate>ACS Server On</b></td><td><select name=iTR069_PVC onchange=chgTr069PVC(0)><option translate value=0>Internet</option><option translate value=100>PVC/VLAN</option></select>&nbsp; <select name=selaliasip></select></td></tr><tr class=chkDisplay ng-if=!isAcsSecEnable ng-show=chkTr069En><td colspan=2><label><input name=enTr069 type=checkbox>&nbsp;<translate class=\"link_note\">Enable TR069 Server on <a>System Maintenance &gt;&gt; Management</a> &gt;&gt; Internet Access Control</translate></label></td></tr><tr id=failover style=display:none><td colspan=2><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td conspan=3><label><input name=iFailoverEn onclick=FailoverEnable() type=checkbox value=1>&nbsp;<translate>Enable Failover</translate></td></tr><tr><td style=text-indent:24px;width:30%><translate>Primary Interface</translate>:</td><td width=20%><label><input name=iPriIntf type=radio value=0>&nbsp;<translate>WAN</translate></label></td><td><select name=iPriWANProf></select></td><tr><td></td><td><label><input name=iPriIntf type=radio value=1>&nbsp;<translate>VPN</translate></label></td><td><select name=iPriVPNProf></select></td></tr><tr><td style=text-indent:24px><translate>Failover to</translate>:</td><td width=20%><label><input name=iSecIntf type=radio value=0>&nbsp;<translate>WAN</translate></label></td><td><select name=iSecWANProf></select></td><tr><td></td><td><label><input name=iSecIntf type=radio value=1>&nbsp;<translate>VPN</translate></label></td><td><select name=iSecVPNProf></select></td></tr></table></td></tr><tr ng-if=!isAcsSecEnable><td colspan=2 style=\"border-bottom: 1px solid\"><b translate>ACS Server</b></td></tr><tr ng-if=isAcsSecEnable><td colspan=2 style=\"border-bottom: 1px solid\"><b translate>Primary ACS Server</b></td></tr><tr ng-if=isAcsSecEnable ng-show=isChtmodShow><td><b translate>ACS Server On</b></td><td><select name=iTR069_PVC onchange=chgTr069PVC(1)><option translate value=0>Internet</option><option translate value=100>PVC/VLAN</option></select>&nbsp; <select name=selaliasip></select></td></tr><tr class=chkDisplay ng-if=isAcsSecEnable ng-show=chkTr069En><td colspan=2><label><input name=enTr069 onclick=clkTr069en(this.checked) type=checkbox>&nbsp;<translate class=\"link_note\">Enable TR069 Server on <a>System Maintenance &gt;&gt; Management</a> &gt;&gt; Internet Access Control</translate></label></td></tr><tr><td translate width=30%>URL</td><td><input name=acs_url onblur=onBlurURL(this) size=42 type=text value=\"\">&nbsp;<input name=acsUrlBtnPri onclick=onClkDefault(this) type=button value=\"{{ 'Wizard' | translate }}\"></td></tr><tr id=2133voda style=display:none><td></td><td><label><input name=urlEn type=checkbox value=1>&nbsp;<translate>Acquire URL from DHCP option 43</translate></label></td></tr><tr><td translate>Username</td><td><input maxlength=31 name=acs_username placeholder=\"{{ 'Max: ###LEN### characters' | translate }}\" size=20 type=text value=\"\"></td></tr><tr><td translate>Password</td><td><input maxlength=31 name=acs_password placeholder=\"{{ 'Max: ###LEN### characters' | translate }}\" size=20 type=password value=\"\"></td></tr><tr ng-if=!isAcsSecEnable><td>&nbsp;</td><td><input class=always_enable name=test_inform onclick=inform_click_callback() type=button value=\"{{ 'Test With Inform' | translate }}\"> &nbsp; <translate>Event Code</translate>&nbsp;<select name=eventCode><option translate value=2>PERIODIC</option><option translate value=6>CONNECTION REQUEST</option><option translate value=0>BOOTSTRAP</option><option translate value=4>VALUE CHANGE</option><option translate value=9>M Reboot</option><option translate value=7>TRANSFER COMPLETE</option><option translate value=1>BOOT</option><option translate value=3>SCHEDULED</option><option translate value=5>KICKED</option><option translate value=8>DIAGNOSTICS COMPLETE</option><option translate value=14>HEARTBEAT</option></select></td></tr><tr ng-if=!isAcsSecEnable><td translate>Last Inform Response Time</td><td id=inform>&nbsp;<img ng-show=\"cpe_enable && '' != ''\" ng-src=\"{{![401,404].includes(0) ? '/images/led-up.gif' : '/images/led-down.gif'}}\" style=\"vertical-align: bottom;height: 16px\"></td></tr><tr ng-if=isAcsSecEnable ng-show=isPrimaryStunShow><td><b translate>STUN Settings</b></td><td><label><input name=stun_enable onclick=stun_check() type=checkbox value=1>&nbsp;<translate>Enable</translate></label></td></tr><tr ng-if=isAcsSecEnable><td translate>Server Address</td><td><input maxlength=255 name=stun_server_addr ng-disabled=!isPrimaryStunEnable size=40 type=text value=\"\"></td></tr><tr ng-if=isAcsSecEnable><td translate>Server STUN Port</td><td><input maxlength=5 name=stun_server_port ng-disabled=!isPrimaryStunEnable size=6 type=text value=\"3478\"></td></tr><tr ng-if=isAcsSecEnable><td translate>Minimum Keep Alive Period</td><td><input name=stun_min_period ng-disabled=!isPrimaryStunEnable size=10 type=text value=\"60\">&nbsp;<translate>second(s)</translate></td></tr><tr ng-if=isAcsSecEnable><td translate>Maximum Keep Alive Period</td><td><input name=stun_max_period ng-disabled=!isPrimaryStunEnable size=10 type=text value=\"-1\">&nbsp;<translate>second(s)</translate></td></tr><tr ng-if=isAcsSecEnable><td colspan=2><br></td></tr><tr ng-if=isAcsSecEnable><td colspan=2 style=\"border-bottom: 1px solid\"><b translate>Secondary ACS Server</b></td></tr><tr ng-if=isAcsSecEnable><td translate>Mode</td><td><select disabled name=acs2_failbackMode><option translate value=0>Last Time Connected</option><option translate value=1>Primary First</option></select></td></tr><tr ng-if=isAcsSecEnable ng-show=isChtmodShow><td><b translate>ACS Server On</b></td><td><select name=iTR069_PVC2 onchange=chgTr069PVC(2)><option translate value=0>Internet</option><option translate value=100>PVC/VLAN</option></select>&nbsp; <select name=selaliasip2></select></td></tr><tr class=chkDisplay ng-if=isAcsSecEnable ng-show=chkTr069En_sec><td colspan=2><label><input name=enTr069_sec onclick=clkTr069en(this.checked) type=checkbox>&nbsp;<translate>Enable TR069 Server on <a>System Maintenance &gt;&gt; Management &gt;&gt; Internet Access Control</a></translate></label></td></tr><tr ng-if=isAcsSecEnable><td translate>URL</td><td><input disabled name=acs2_url onblur=onBlurURL(this) size=42 type=text value=\"\">&nbsp;<input disabled name=acsUrlBtnSec onclick=onClkDefault(this) type=button value=\"{{ 'Wizard' | translate }}\"></td></tr><tr ng-if=isAcsSecEnable><td translate>Username</td><td><input disabled maxlength=\"255\" name=acs2_username placeholder=\"{{ 'Max: ###LEN### characters' | translate }}\" size=20 type=text value=\"\"></td></tr><tr ng-if=isAcsSecEnable><td translate>Password</td><td><input disabled maxlength=\"255\" name=acs2_password placeholder=\"{{ 'Max ###LEN### characters' | translate }}\" size=20 type=password value=\"\"></td></tr><tr id=stun2 ng-if=isAcsSecEnable><td><b translate>STUN Settings</b></td><td><label><input name=stun_enable2 onclick=stun_check() type=checkbox value=1>&nbsp;<translate>Enable</translate></label></td></tr><tr ng-if=isAcsSecEnable><td translate>Server Address</td><td><input maxlength=255 name=stun_server_addr2 ng-disabled=!isSecondaryStunEnable size=40 type=text value=\"\"></td></tr><tr ng-if=isAcsSecEnable><td translate>Server STUN Port</td><td><input maxlength=5 name=stun_server_port2 ng-disabled=!isSecondaryStunEnable size=6 type=text value=\"0\"></td></tr><tr ng-if=isAcsSecEnable><td translate>Minimum Keep Alive Period</td><td><input name=stun_min_period2 ng-disabled=!isSecondaryStunEnable size=10 type=text value=\"0\">&nbsp;<translate>second(s)</translate></td></tr><tr ng-if=isAcsSecEnable><td translate>Maximum Keep Alive Period</td><td><input name=stun_max_period2 ng-disabled=!isSecondaryStunEnable size=10 type=text value=\"0\">&nbsp;<translate>second(s)</translate></td></tr><tr ng-if=isAcsSecEnable><td colspan=2><br></td></tr><tr ng-if=isAcsSecEnable><td colspan=2 style=\"border-bottom: 1px solid\"><b translate>Status</b></td></tr><tr align=center ng-if=isAcsSecEnable><td colspan=2><br><span id=\"acsServerTarget\" padding-right=\"5px\"></span><translate>Last Inform Response Time</translate>: <span id=\"inform\">&nbsp;<img ng-show=\"cpe_enable && '' != ''\" ng-src=\"{{![401,404].includes(0) ? '/images/led-up.gif' : '/images/led-down.gif'}}\" style=\"vertical-align: bottom;height: 16px\"></span></td></tr><tr align=center ng-if=isAcsSecEnable><td colspan=2><input class=always_enable name=test_inform onclick=inform_click_callback() type=button value=\"{{ 'Test With Inform' | translate }}\">&nbsp;<translate>Event Code</translate><select name=eventCode><option translate value=2>PERIODIC</option><option translate value=6>CONNECTION REQUEST</option><option translate value=0>BOOTSTRAP</option><option translate value=4>VALUE CHANGE</option><option translate value=9>M Reboot</option><option translate value=7>TRANSFER COMPLETE</option><option translate value=1>BOOT</option><option translate value=3>SCHEDULED</option><option translate value=5>KICKED</option><option translate value=8>DIAGNOSTICS COMPLETE</option></select></td></tr><tr><td colspan=2><br></td></tr><tr ng-if=!isAcsSecEnable><td colspan=2 style=\"border-bottom: 1px solid\"><b translate>CPE Client</b></td></tr><tr ng-if=!isAcsSecEnable><td translate>Protocol</td><td><label><input name=cpe_https_enable onclick=cpe_urlClick(0) type=radio value=0>&nbsp;<translate>HTTP</translate></label> &nbsp;&nbsp;&nbsp;<label><input name=cpe_https_enable onclick=cpe_urlClick(1) type=radio value=1>&nbsp;<translate>HTTPS</translate></label></td></tr><tr ng-if=\"!isAcsSecEnable && !ipv6_off\"><td translate>Use</td><td><label><input name=cpe_ipv4or6 ng-model=cpe_ipv4or6 type=radio value=0>&nbsp;<translate>IPv4</translate></label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<label><input name=cpe_ipv4or6 ng-model=cpe_ipv4or6 type=radio value=1>&nbsp;<translate>IPv6</translate>&nbsp;&nbsp;(<translate>if possible</translate>)</label></td></tr><tr ng-if=!isAcsSecEnable><td translate>URL</td><td><input disabled maxlength=255 name=cpe_url size=56 type=text value=\"\"></td></tr><tr ng-if=!isAcsSecEnable><td translate>Port</td><td><input maxlength=5 name=cpe_port size=10 type=text value=\"8069\"></td></tr><tr ng-if=!isAcsSecEnable><td translate>Username</td><td><input disabled maxlength=255 name=cpe_username size=32 type=text value=\"vigor\"></td></tr><tr ng-if=!isAcsSecEnable><td translate>Password</td><td><input disabled maxlength=255 name=cpe_password size=32 type=password value=\"********\"></td></tr><tr class=tr069note ng-if=!isAcsSecEnable style=display:none><td colspan=2><table><tr><td valign=top width=6%><b translate>Note</b>: <ol><li class=link_note translate>Please enable TR-069 server to allow access from Internet on <a>System Maintenance &gt;&gt; Management</a> page.</li></ol></td></tr></table></td></tr></table></td></tr></table><br ng-if=isAcsSecEnable><table align=center border=0 cellpadding=2 cellspacing=0 ng-if=isAcsSecEnable width=100%><tr><td colspan=2><b translate>CPE Client</b></td></tr></table><table align=center cellpadding=4 cellspacing=0 ng-if=isAcsSecEnable style=\"border: 2px solid black\" width=100%><tr><td translate>Protocol</td><td><label><input name=cpe_https_enable onclick=cpe_urlClick(0) type=radio value=0>&nbsp;<translate>HTTP</translate></label> &nbsp;&nbsp;&nbsp;<label><input name=cpe_https_enable onclick=cpe_urlClick(1) type=radio value=1>&nbsp;<translate>HTTPS</translate></label></td></tr><tr ng-if=!ipv6_off><td translate>Use</td><td><label><input name=cpe_ipv4or6 ng-model=cpe_ipv4or6 type=radio value=0>&nbsp;<translate>IPv4</translate></label>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<label><input name=cpe_ipv4or6 ng-model=cpe_ipv4or6 type=radio value=1>&nbsp;<translate>IPv6</translate>&nbsp;&nbsp;(<translate>if possible</translate>)</label></td></tr><tr><td translate>URL</td><td><input disabled maxlength=255 name=cpe_url size=56 type=text value=\"\"></td></tr><tr><td translate>Port</td><td><input maxlength=5 name=cpe_port ng-disabled=!isTR069On size=10 type=text value=\"8069\"></td></tr><tr><td translate>Username</td><td><input maxlength=255 name=cpe_username ng-disabled=!isTR069On size=32 type=text value=\"vigor\"></td></tr><tr><td translate>Password</td><td><input maxlength=255 name=cpe_password ng-disabled=!isTR069On size=32 type=password value=\"********\"></td></tr><tr class=tr069note style=display:none><td colspan=2><table><tr><td valign=top width=6%><b translate>Note</b>: <ol><li class=link_note translate>Please enable TR-069 server to allow access from Internet on <a>System Maintenance &gt;&gt; Management</a> page.</li></ol></td></tr></table></td></tr></table><table align=center border=0 cellpadding=4 cellspacing=0 width=100%><tr id=https_note><td><b translate>Note</b>:<ol><li translate>Https mode only works when Vigor ACS SI is 1.1.6 and above version.</li></td></tr></table><br><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>Periodic Inform Settings</b></td></tr></table><table align=center border=1 cellpadding=8 cellspacing=0 width=100%><tr><td><label><input name=periodic_enable onclick=inform_check() type=checkbox value=1>&nbsp;<translate>Enable</translate></label><table align=center border=0 cellpadding=4 cellspacing=0 width=100%><tr><td width=30%>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<translate>Time Interval</translate></td><td><input maxlength=9 name=periodic_interval size=10 type=text value=\"900\">&nbsp;<translate>second(s)</translate></td></tr><tr style=display:none><td colspan=2 translate>Schedule Time</td></tr><tr style=display:none><td translate>Date (yyyy-mm-dd)</td><td><select name=year></select>&nbsp;<b>-</b><select name=month></select>&nbsp;<b>-</b><select name=day></select></td></tr><tr style=display:none><td translate>Time (hh:mm:ss)</td><td><select name=hour></select>&nbsp;<b>:</b><select name=minute></select>&nbsp;<b>:</b><select name=second></select></td></tr></table></td></tr></table><br ng-if=!isAcsSecEnable><table align=center border=0 cellpadding=2 cellspacing=0 ng-if=!isAcsSecEnable ng-show=isPrimaryStunShow width=100%><tr><td><b translate>STUN Settings</b></td></tr></table><table align=center border=1 cellpadding=8 cellspacing=0 id=stunarea ng-if=!isAcsSecEnable ng-show=isPrimaryStunShow width=100%><tr><td><label><input name=stun_enable onclick=stun_check() type=checkbox value=1>&nbsp;<translate>Enable</translate></label><table align=center border=0 cellpadding=4 cellspacing=0 width=100%><tr><td width=30%>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<translate>Server Address</translate></td><td><input maxlength=255 name=stun_server_addr ng-disabled=!isPrimaryStunEnable size=40 type=text value=\"\"></td></tr><tr><td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<translate>Server STUN Port</translate></td><td><input maxlength=5 name=stun_server_port ng-disabled=!isPrimaryStunEnable size=6 type=text value=\"3478\"></td></tr><tr><td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<translate>Minimum Keep Alive Period</translate></td><td><input name=stun_min_period ng-disabled=!isPrimaryStunEnable size=10 type=text value=\"60\">&nbsp;<translate>second(s)</translate></td></tr><tr><td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<translate>Maximum Keep Alive Period</translate></td><td><input name=stun_max_period ng-disabled=!isPrimaryStunEnable size=10 type=text value=\"-1\">&nbsp;<translate>second(s)</translate></td></tr></table></td></tr></table><div id=vpninfo style=\"position: absolute\"><br><br><table align=center border=0 cellpadding=2 cellspacing=0 id=cfmtbl width=560><tr><td translate>Please note that the Vigor router will send the WAN or Internet IP address of the router, and the LAN clients' information (such as IP and MAC addresses) to the VigorACS server.</td></tr><tr><td translate>Please contact your service provider if you have any question.</td></tr><tr><td align=center><br><input class=btnw name=cfmOk onClick=onClkCfmOk() type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <input class=btnw name=cfmCcl onClick=onClkCfmCcl() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table></div><br><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b id=apply_to_ap_title translate>Apply Settings to APs</b></td></tr></table><table align=center border=1 cellpadding=8 cellspacing=0 width=100%><tr><td><label><input name=apply_ap_enable onclick=apply_ap_check() type=checkbox value=1>&nbsp;<translate>Enable</translate></label><table align=center border=0 cellpadding=4 cellspacing=0 width=100%><tr><td id=apply_to_ap_password_showtext width=30%>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<translate>AP Password</translate></td><td><input maxlength=31 name=apply_ap_password ng-disabled=!isAPsEnabled size=20 type=password value=\"\"></td></tr><tr><td colspan=2><label><input id=apply_ap_stun_en name=apply_ap_stun_en ng-disabled=!isAPsEnabled onclick=apply_ap_stun_check() type=checkbox value=1><span id=\"apply_to_ap_stun_showtext\">&nbsp;<translate>Specify STUN Settings for APs</translate></span></label></td></tr><tr ng-show=apstun><td colspan=2><label><input name=ap_stun_enable ng-disabled=!isAPsEnabled onclick=ap_stun_check() type=checkbox value=1>&nbsp;<translate>Enable</translate></label><table align=center border=0 cellpadding=4 cellspacing=0 width=100%><tr><td width=30%>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<translate>Server Address</translate></td><td><input maxlength=255 name=ap_stun_server_addr ng-disabled=\"!isAPsEnabled || !isAPsStunEnabled\" size=40 type=text value=\"\"></td></tr><tr><td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<translate>Server Port</translate></td><td><input maxlength=5 name=ap_stun_server_port ng-disabled=\"!isAPsEnabled || !isAPsStunEnabled\" size=6 type=text value=\"3478\"></td></tr><tr><td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<translate>Minimum Keep Alive Period</translate></td><td><input name=ap_stun_min_period ng-disabled=\"!isAPsEnabled || !isAPsStunEnabled\" size=10 type=text value=\"60\">&nbsp;<translate>second(s)</translate></td></tr><tr><td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<translate>Maximum Keep Alive Period</translate></td><td><input name=ap_stun_max_period ng-disabled=\"!isAPsEnabled || !isAPsStunEnabled\" size=10 type=text value=\"-1\">&nbsp;<transla