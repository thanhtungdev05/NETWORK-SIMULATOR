e' | translate }}\"></td></tr></table></td></tr><tr><td height=15>&nbsp;</td></tr><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></table></form><form action=\"/cgi-bin/usbwebget.cgi?sFormAuthStr=JdvKVyYlhh7GhS9\" method=post name=frm_rename><table border=0 cellpadding=0 cellspacing=0 class=c2 id=dialogue2 name=dialogue2 style=\"display:none; position:absolute; left:428px; top:304px\"><input name=idx type=hidden><input name=DIR type=hidden value><input name=FILE type=hidden value><input name=DFILE type=hidden value><input name=OP type=hidden value><tr><td><table align=center border=0 cellpadding=0 cellspacing=0 height=15 width=95%><tr><td align=right valign=bottom><img class=hand onclick=r_cl() src=/images/r_c.gif></td></tr></table></td></tr><tr><td align=center><table border=0 cellpadding=2 cellspacing=5 height=50 width=90%><tr valign=bottom><td valign=middle><input class=input1 name=rename_new onKeyDown=\"if(event.keyCode==13) r_ok();\" size=20 type=text></td><td align=center valign=middle><input class=the_button name=rename_ok onclick=r_ok() type=button value=\"{{ 'Rename' | translate }}\"></td></tr></table></td></tr><tr><td height=15>&nbsp;</td></tr><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></table></form><form action=\"/cgi-bin/usbwebget.cgi?sFormAuthStr=JdvKVyYlhh7GhS9\" charset=\"ISO-8859-1\" method=post name=frm_list><table border=0 cellpadding=0 cellspacing=0 id=contentwin valign=top width=100%><input name=DIR type=hidden value><input name=FILE type=hidden value><input name=OP type=hidden value><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"><tr height=18 id=line0 ondblclick=up() onmouseover=tr_click(0) valign=top><td class=clickbright id=td00 width=10></td><td class=clickbright id=td01 valign=middle width=20><img height=13 src=/images/nfolder.gif width=15></td><td class=clickbright id=td02 width=50%><font class=hand> <a onclick=up()>. .</a></font></td><td class=clickbright id=td06 width=150></td><td align=center class=clickbright id=td03 width=80></td><td align=center class=clickbright id=td04 width=80></td><td class=clickbright id=td05></td></tr><script>var str=\"\"; function get_filesize(Byte_size){var size0=Byte_size/1024;if(size0<1)return 1;var size1=Math.floor(size0);var str_size1=size1.toString();var len=str_size1.length;if(len<=3)return str_size1;var ss=\"\",s0=\"\";for(var i=0;i<len;i++){if(i!=0&&i/3==Math.floor(i/3)){ss=\",\"+ss;}s0=str_size1.charAt(len-i-1);ss=s0+ss;}return(ss);}function cutfile(_name){var tmp;if(_name.length>45){tmp=_name.substring(0,45)+\"...\";return tmp;}else{return _name;}}if((!iDiskStatus||!iDiskWrite)||sPath=='/'){hideElmtById(document,\"line0\");}if(iDiskStatus==1&&iDiskWrite==1){for(var i=0;i<sArpTbl.length;i++){ if(sArpTbl[i][1]==0){str=\"<tr onmouseover='tr_click(\"+(i+1)+\")' height=18 ondblclick='go_to_folder(\"+i+\")'>\";str+=\"<td id=td\"+(i+1)+\"0 width=10 class=grey_line>&nbsp;</td>\";str+=\"<td id=td\"+(i+1)+\"1 width=20 class=grey_line><img src='/images/nfolder.gif'></td>\";str+=\"<td id=td\"+(i+1)+\"2 width=50% class=grey_line><font class=hand><a onclick='go_to_folder(\"+i+\")' title='\"+sArpTbl[i][0].replace(/\\s/g,\"\\u00a0\")+\"'>\"+cutfile(sArpTbl[i][0].replace(/\\s/g,\"\\u00a0\"))+\"</a></font></td>\";str+=\"<td id=td\"+(i+1)+\"6 width=150 class=grey_line>&nbsp;</td>\";str+=\"<td id=td\"+(i+1)+\"3 align=center width=80 class='white_line BTHide'><img src=\\\"/images/clear1.gif\\\" onclick=\\\"deletefolder(\"+i+\")\\\" class=itemimg1 onmouseover=\\\"this.className='itemimg2';\\\" onmouseout=\\\"this.className='itemimg1';\\\"></td>\";str+=\"<td id=td\"+(i+1)+\"4 align=center width=80 class='white_line BTHide'><img src=\\\"/images/rename.gif\\\" onclick=\\\"rename(\"+i+\")\\\" class=itemimg1 onmouseover=\\\"this.className='itemimg2';\\\" onmouseout=\\\"this.className='itemimg1';\\\"></td>\";str+=\"<td id=td\"+(i+1)+\"5 class='white_line BTHide'>&nbsp;</td></tr>\";document.write(str);}}for(var i=0;i<sArpTbl.length;i++){ if(sArpTbl[i][1]!=0){str=\"<tr onmouseover='tr_click(\"+(i+1)+\")' height=18 ondblclick='go_to_file(\"+i+\")'>\";str+=\"<td id=td\"+(i+1)+\"0 width=10 class=grey_line>&nbsp;</td>\";str+=\"<td id=td\"+(i+1)+\"1 width=20 class=grey_line><img src='/images/nunknown.gif'></td>\";str+=\"<td id=td\"+(i+1)+\"2 width=50% class=grey_line><font class=hand><a onclick='go_to_file(\"+i+\")' title='\"+sArpTbl[i][0].replace(/\\s/g,\"\\u00a0\")+\"'>\"+cutfile(sArpTbl[i][0].replace(/\\s/g,\"\\u00a0\"))+\"</a></font></td>\";str+=\"<td id=td\"+(i+1)+\"6 width=150 class=grey_line align=right>\"+get_filesize(sArpTbl[i][2])+\" KB</td>\";str+=\"<td id=td\"+(i+1)+\"3 align=center width=80 class='white_line BTHide'><img src=\\\"/images/clear1.gif\\\" onclick=\\\"deleteItem(\"+i+\")\\\" class=itemimg1 onmouseover=\\\"this.className='itemimg2';\\\" onmouseout=\\\"this.className='itemimg1';\\\"></td>\";str+=\"<td id=td\"+(i+1)+\"4 align=center width=80 class='white_line BTHide'><img src=\\\"/images/rename.gif\\\" onclick=\\\"rename(\"+i+\")\\\" class=itemimg1 onmouseover=\\\"this.className='itemimg2';\\\" onmouseout=\\\"this.className='itemimg1';\\\"></td>\";str+=\"<td id=td\"+(i+1)+\"5 class='white_line BTHide'>&nbsp;</td></tr>\";document.write(str);}}}</script></table></form></td></tr></table><br><table border=1 cellpadding=0 cellspacing=0 class=usbfileInfo height=120 id=upload_table valign=top width=100%><tr><td height=22><table cellpadding=2 cellspacing=0 class=left_title height=22 width=100%><tr><td align=center valign=middle width=20><img height=14 src=/images/upload.gif width=13></td><td class=heading translate>Upload File</td></tr></table></td></tr><tr valign=top><td bgcolor=#F4F6FC><form action=\"/cgi-bin/usbwebset.cgi?sFormAuthStr=JdvKVyYlhh7GhS9\" enctype=multipart/form-data method=post name=frm_uploadfile><table border=0 cellpadding=0 cellspacing=4 margin=0 width=100%><tr height=5><td></td></tr><tr><td class=left_content><translate>Select a file</translate>:</td></tr><tr><td><input name=uploadfile type=file></td></tr><tr><td><input class=the_button name=upload onclick=usbweb_upload() type=button value=\"{{ 'Upload' | translate }}\"></td></tr><tr height=10><td></td></tr></table><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></td></tr></table></form></td></tr><tr><td><b translate>Note</b>: <ol><li translate>File Explorer cannot be used, if USB disk is disconnected.</li><li translate>Only folders with up to 1 level of nested folders can be deleted.</li></ol></td></tr></table><script>top.ACTION_STATUS=-1;top.iActionStatusFlag='1';top.iFwUpgradeState='0';var isNav=(navigator.appName.indexOf(\"Netscape\")!=-1);var isIE=(navigator.appName.indexOf(\"Microsoft\")!=-1);var isOpr=(navigator.appName.indexOf(\"Opera\")!=-1);var MAX_FILE_NAME_LEN=170;var do_remove_folder='0'; var usb_do_remove_file='0'; var refresh;angular.element(document).ready(function(){initPage();});function initPage(){if(top.ifolderDelStart==1){if(usb_do_remove_file=='0'){ if(do_remove_folder=='1'){document.getElementById(\"deletemsg\").innerHTML=gettext(\"Delete OK.\");showElmtById(document,\"dialoResult\");}else{document.getElementById(\"deletemsg\").innerHTML=gettext(\"Can't delete folders that contain multilevel folders.\");showElmtById(document,\"dialoResult\");}}else{showElmtById(document,\"dialoProgress\");if(top.ifolderDelStop!=1){refresh=setTimeout(\"getRemoveStatus()\",1000);}}top.ifolderDelStart=0;}else if(top.ifolderDelStop==1){document.getElementById(\"deletemsg\").innerHTML=gettext(\"Delete operation has been cancelled by administrator.\");showElmtById(document,\"dialoResult\");top.ifolderDelStop=0;}else if(top.ifolderStaRefreshEnd==1){hideElmtById(document,\"dialoProgress\");if(do_remove_folder==1){document.getElementById(\"deletemsg\").innerHTML=gettext(\"Delete OK.\");showElmtById(document,\"dialoResult\");}else{document.getElementById(\"deletemsg\").innerHTML=gettext(\"Can't delete folders that contain multilevel folders.\");showElmtById(document,\"dialoResult\");}top.ifolderStaRefreshEnd=0;}if(iDiskStatus==0){document.getElementById(\"disStatus\").innerHTML=\"<font color=\\\"red\\\">\"+gettext(\"No Disk Connected\")+\"</font>\";document.getElementById(\"usbfileInfo\").style.display=\"none\";hideElmtByClass(document,\"table\",\"usbfileInfo\");hideElmtByClass(document,\"br\",\"usbfileInfo\");}else{document.getElementById(\"disStatus\").innerHTML=\"<font color=\\\"green\\\">\"+gettext(\"Disk Connected\")+\"</font>\";document.getElementById(\"usbfileInfo\").style.display=\"\";showElmtByClass(document,\"table\",\"usbfileInfo\");showElmtByClass(document,\"br\",\"usbfileInfo\");}if(webcfg.isBT498&&webcfg.privilege!=15){angular.element(document.querySelectorAll('.BTHide')).attr('style','display:none');}}function tr_click(idx){var line_id,td_id1,td_id2,td_id3,td_id4,td_id5,td_id6,td_id7;for(i=0;i<sArpTbl.length+1;i++){td_id1=getElmtById(document,\"td\"+i+\"0\");if(td_id1!=null)td_id1.className='grey_line';td_id2=getElmtById(document,\"td\"+i+\"1\");if(td_id2!=null)td_id2.className='grey_line';td_id3=getElmtById(document,\"td\"+i+\"2\");if(td_id3!=null)td_id3.className='grey_line';td_id4=getElmtById(document,\"td\"+i+\"3\");if(td_id4!=null)td_id4.className='white_line';td_id5=getElmtById(document,\"td\"+i+\"4\");if(td_id5!=null)td_id5.className='white_line';td_id6=getElmtById(document,\"td\"+i+\"5\");if(td_id6!=null)td_id6.className='white_line';td_id7=getElmtById(document,\"td\"+i+\"6\");if(td_id7!=null)td_id7.className='grey_line';}td_id1=getElmtById(document,\"td\"+idx+\"0\");td_id1.className='clickbright';td_id2=getElmtById(document,\"td\"+idx+\"1\");td_id2.className='clickbright';td_id3=getElmtById(document,\"td\"+idx+\"2\");td_id3.className='clickbright';td_id4=getElmtById(document,\"td\"+idx+\"3\");td_id4.className='clickbright';td_id5=getElmtById(document,\"td\"+idx+\"4\");td_id5.className='clickbright';td_id6=getElmtById(document,\"td\"+idx+\"5\");td_id6.className='clickbright';td_id7=getElmtById(document,\"td\"+idx+\"6\");td_id7.className='clickbright';}function go_to_folder(i){var strUrl=\"\";var tmp_path,folder_name;tmp_path=charReplace(sPath);folder_name=charReplace(sArpTbl[i][0]);document.frm_list.DIR.value=tmp_path+folder_name+\"/\";document.frm_list.submit();} function checkName(str){for(var loop_index=0;loop_index<str.length;loop_index++){if(str.charAt(loop_index)=='\\\\'||str.charAt(loop_index)=='/'||str.charAt(loop_index)==':'||str.charAt(loop_index)=='*'||str.charAt(loop_index)=='?'||str.charAt(loop_index)=='\\\"'||str.charAt(loop_index)=='<'||str.charAt(loop_index)=='>'||str.charAt(loop_index)=='|'||str.charAt(loop_index)=='#'||str.charAt(loop_index)=='&'||str.charAt(loop_index)=='%'||str.charAt(loop_index)=='+'){alert(gettext(\"The following characters are not allowed\")+\": \\\\ / : * ? \\\" < > | # % & +\");return false;}} return true;}function deleteItem(i){if(true==confirm(gettext(\"Are you sure you want to delete it?\"))){var strDelUrl=\"\";var tmp_path,del_name;tmp_path=charReplace(sPath);del_name=charReplace(sArpTbl[i][0]);if(sArpTbl[i][1]==0){document.frm_list.OP.value=4;}else if(sArpTbl[i][1]==1){document.frm_list.OP.value=2;}document.frm_list.DIR.value=tmp_path;document.frm_list.FILE.value=del_name;document.frm_list.submit();}else{return;}}function deletefolder(i){if(true==confirm(gettext(\"Are you sure you want to delete it?\"))){var strDelUrl=\"\";var tmp_path,del_name;tmp_path=charReplace(sPath);del_name=charReplace(sArpTbl[i][0]);if(sArpTbl[i][1]==0){document.frm_list.OP.value=4;}else if(sArpTbl[i][1]==1){document.frm_list.OP.value=2;}document.frm_list.DIR.value=tmp_path;document.frm_list.FILE.value=del_name;top.ifolderDelStart=1;document.frm_list.submit();}else{return;}}function getRemoveStatus(){$http.get(\"/folderdelstop.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&random=\"+Math.random()).then(function(response){var val=response.data.split(\",\");if(val.length==2){if(val[0]==0){ top.ifolderStaRefreshEnd=1;document.location=\"usbweb.htm\";clearTimeout(ref