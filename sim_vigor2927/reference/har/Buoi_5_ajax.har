55.252 / 30</option><option  value=255.255.255.248>255.255.255.248 / 29</option><option  value=255.255.255.240>255.255.255.240 / 28</option><option  value=255.255.255.224>255.255.255.224 / 27</option><option  value=255.255.255.192>255.255.255.192 / 26</option><option  value=255.255.255.128>255.255.255.128 / 25</option><option  value=255.255.255.0>255.255.255.0 / 24</option><option  value=255.255.254.0>255.255.254.0 / 23</option><option  value=255.255.252.0>255.255.252.0 / 22</option></select></td></tr></table></td><td valign=top width=55%><table border=0 cellpadding=2 cellspacing=0 width=100%><tr><td colspan=2><b translate>Management Port Setup</b><br></td></tr><tr><td colspan=2><input Checked name=ConfigPort type=radio value=UserDefine>&nbsp;<translate>User Define Ports</translate>&nbsp;<input name=ConfigPort type=radio value=Default>&nbsp;<translate>Default Ports</translate></td></tr><tr id=telnetporttr><td translate width=48%>Telnet Port</td><td width=52%><input maxlength=5 name=TelnetPort size=5 value=\"23\"> (<translate>Default</translate>: 23)</td></tr><tr><td translate>HTTP Port</td><td><input maxlength=5 name=HttpPort size=5 value=\"80\"> (<translate>Default</translate>: 80)</td></tr><tr class=https style=display:none><td translate>HTTPS Port</td><td><INPUT MAXLENGTH=5 NAME=HttpsPort SIZE=5 VALUE=\"443\"> (<translate>Default</translate>: 443)</td></tr><tr id=ftpporttr><td translate>FTP Port</td><td><input maxlength=5 name=txtFtpPort size=5 value=\"21\"> (<translate>Default</translate>: 21)</td></tr><tr ng-hide=bgt2ndAdmin><td translate>TR069 Port</td><td><input maxlength=5 name=txtTr069Port size=5 value=\"8069\"> (<translate>Default</translate>: 8069)</td></tr><tr class=ssh style=display:none><td translate>SSH Port</td><td><input maxlength=5 name=txtSshPort size=5 value=\"22\"> (<translate>Default</translate>: 22)</td></tr><tr class=mptcp style=display:none><td translate>MPTCP Port</td><td><input maxlength=5 name=txtMPTCPPort size=5 value=\"5201\"> (<translate>Default</translate>: 5201)</td></tr><tr class=webportalnote style=display:none><td colspan=2><b translate>Note</b>: <ol><li translate>Ports 8001 and 8043 are used for Hotspot Web Portal.</li></ol></td></tr><tr class=showPtKnock style=display:none><td colspan=2><hr size=1></td></tr><tr class=showPtKnock style=display:none><td colspan=2><b translate>Port Knocking for Local Service</b><br></td></tr><tr class=showPtKnock style=display:none><td colspan=2><input  name=iPtKEn onclick=enPtKnock() type=checkbox value=1><translate>Enable port knocking protection</translate></td></tr><tr class=sPtKnock style=display:none><td colspan=2>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=iPtKFtp type=checkbox value=1><translate>FTP Server</translate></td></tr><tr class=sPtKnock style=display:none><td colspan=2>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=iPtKHttp type=checkbox value=1><translate>HTTP Server</translate></td></tr><tr class=sPtKnock style=display:none><td colspan=2>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=iPtKHttps type=checkbox value=1><translate>HTTPS Server</translate></td></tr><tr class=sPtKnock style=display:none><td colspan=2>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=iPtKTelnet type=checkbox value=1><translate>Telnet Server</translate></td></tr><tr class=sPtKnock style=display:none><td colspan=2>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=iPtKSsh type=checkbox value=1><translate>SSH Server</translate></td></tr><tr class=sPtKnock style=display:none><td colspan=2>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=iPtKSnmp type=checkbox value=1><translate>SNMP Server</translate></td></tr><tr class=sPtKnock style=display:none><td translate>1st Knock Port</td><td><input max=65535 maxlength=5 min=3501 name=sKnockPort size=5 type=number value=\"3888\">&nbsp; <div class=popup><img border=0 src=/images/faqmark1.png style=\"width: 60%\"><span class=\"popuptext\" id=\"blockPopup\">&nbsp;Suppose TOTP token is \"456 789\", <br>&nbsp;&nbsp;&nbsp;then knock on the following ports in sequence <br>&nbsp;&nbsp;&nbsp;(from WAN) to unlock Port Redirect function. <br>&nbsp;1. 1st Knock Port <br>&nbsp;2. port 1456 (1000 + TOTP front 3 digits) <br>&nbsp;3. port 2789 (2000 + TOTP last 3 digits) </span></div></td></tr><tr class=sPtKnock style=display:none><td translate>TOTP Key</td><td><input maxlength=32 name=sKnockTotp readonly size=21 type=text value=\"IZJGWSKJOJZFMVSRKFEEO33OKBHUMRLM\"></td></tr><tr class=sPtKnock style=display:none><td>&nbsp;</td><td><input id=btnTOTPRegenerate name=btnTOTPRegenerate onclick=RegenerateSecret_totp() type=button value=\"{{ 'Regenerate' | translate }}\"></td></tr><tr class=sPtKnock style=display:none><td>&nbsp;</td><td><div id=qrcodeTOTP></div></td></tr><tr class=sPtKnock style=display:none><td translate>Validation Code</td><td><input max=999999 min=1 name=verify_totp onkeydown=onTOTPVerifyEnter() type=number>&nbsp; <input onclick=onTOTPVerify() type=button value=\"{{ 'Verify' | translate }}\"><span id=\"verify_totp_info\"></span></td></tr><tr class=snmp style=display:none><td colspan=2><hr size=1></td></tr><tr class=snmp style=display:none><td colspan=2><b>&nbsp;<translate>SNMP Setup</translate></b></td></tr><tr class=snmp style=display:none><td colspan=2><input  name=sSNMP onclick=enSnmp() type=checkbox value=On> &nbsp;<translate>Enable SNMP Agent</translate></td></tr><tr class=snmp style=display:none><td>&nbsp;&nbsp;<translate>Get Community</translate></td><td><input maxlength=23 name=sSNMPGet size=16 value=\"public\"></td></tr><tr class=snmp style=display:none><td>&nbsp;&nbsp;<translate>Set Community</translate></td><td><input maxlength=23 name=sSNMPSet size=16 value=\"private\"></td></tr><tr class=snmp style=display:none><td>&nbsp;&nbsp;<translate>Manager Host IP</translate></td><td><input maxlength=15 name=sSNMPMIP size=16 value=\"\"></td></tr><tr class=snmp style=display:none><td>&nbsp;&nbsp;<translate>Trap Community</translate></td><td><input maxlength=23 name=sSNMPTrap size=16 value=\"public\"></td></tr><tr class=snmp style=display:none><td>&nbsp;&n