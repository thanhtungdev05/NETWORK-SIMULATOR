            "text": "<script type=\"text/javascript\">\n$(document).ready(function(){\ninitial_sceneTip();\ninitial_CollapsibleBar();\ninitial_addInstLink();\ninitial_CheckBox();\ninitial_QueryAccessDeviceLink();\ninitial_TimeCtl();\n$(\".HeadDIV\").each(function(){\nvar Head = $(this);\nvar HeadID = Head.attr(\"id\");\nvar template = $(\"#template_\"+HeadID,Head);\nvar formOBJ = $(\"form\",Head);\nif ( ! formOBJ.attr(\"onsubmit\") )\n{\nformOBJ.attr(\"onsubmit\", \"return false;\");\n}\nvar stopFormAutoSubmitStr = \"<input type='text' id='_stopFormAutoSubmit'\"\n+\" value='' class='PostIgnore'\"\n+\" style='display:none;'>\";\nformOBJ.prepend(stopFormAutoSubmitStr);\ninitial_button(\"Apply\", Head);\ninitial_button(\"Cancel\", Head);\ninitial_button(\"Delete\", Head);\ninitialCtrlAllLink(Head);\ninitial_special_password(Head);\nvar collapsibleInstObj = $(\".collapsibleInst\",template);\ncollapsibleInstObj.unbind(\"click\");\ncollapsibleInstObj.click(function(event){\nvar collapsibleInst = $(this);\nvar template = collapsibleInst.parents(\"[id^='template_']\");\nvar ChangeArea = $(\".ChangeArea\",template);\nif ( ChangeArea.is(\":hidden\") )\n{\nChangeArea.show();\ncollapsibleInst.addClass(\"instNameExp\");\ngroupBtnChange(ChangeArea);\nChangeArea.attr(\"aria-live\",\"polite\");\n}\nelse\n{\nChangeArea.hide();\ncollapsibleInst.removeClass(\"instNameExp\");\nChangeArea.attr(\"aria-live\",\"off\");\n$(\".Btn_cancel\",ChangeArea).click();\n}\n});\ncollapsibleInstObj.attr(\"tabindex\", 0);\nkeyBoardClick(collapsibleInstObj);\nvar filteredImages = $(\"img\").filter(function() {\nreturn $(this).attr('src') === '../img/sleeping.png' || $(this).attr('src') === '../img/awaking.png';\n});\nfilteredImages.attr(\"tabindex\", 0);\nkeyBoardClick(filteredImages);\n$(\".utf8Compatible\", template).each(function(){\nvar thisObj = $(this);\nvar dTip = thisObj.text();\nvar dTipArr = dTip.split(\"\");\nvar firstNum = \"\";\nvar secNum = \"\";\nvar firstNumStart = \"\";\nvar firstNumEnd = \"\";\nvar secNumStart = \"\";\nvar secNumEnd = \"\";\nvar Nums = 0;\nvar newTip = \"\";\ndTipArr = $.grep(dTipArr, function(n,i){\nreturn n != \" \";\n});\ndTip = dTipArr.join(\"\");\nfor(var i=0; i<dTipArr.length; i++)\n{\nif (Nums > 2)\n{\nthisObj.remove();\nbreak;\n}\nif (isNaN(dTipArr[i]) == false)\n{\nif (firstNumStart == \"\")\n{\nfirstNumStart = i;\nfirstNumEnd = parseInt(i)+1;\nNums += 1;\n}\nelse\n{\nif (secNumStart == \"\")\n{\nif (firstNumEnd == i)\n{\nfirstNumEnd = parseInt(i)+1;\n}\nelse\n{\nsecNumStart = i;\nsecNumEnd = parseInt(i)+1;\nNums += 1;\n}\n}\nelse\n{\nif (secNumEnd == i)\n{\nsecNumEnd = parseInt(i)+1;\n}\nelse\n{\nNums = 3;\n}\n}\n}\n}\n}\nif (firstNumStart != \"\" && secNumStart != \"\")\n{\nfirstNum = dTip.slice(firstNumStart, firstNumEnd);\nsecNum = dTip.slice(secNumStart, secNumEnd);\nnewTip = dTip.slice(0, firstNumStart)+\" \";\nif (parseInt(secNum) < 3)\n{\nvar prevObjId = thisObj.prev().attr(\"id\");\nalert(\"Element[id='\"+prevObjId+\"']'s length range [\"+ firstNum+\",\"+secNum+\"] will be invalid after utf-8 transforming!\");\n}\nelse\n{\nfirstNum = Math.ceil(parseInt(firstNum) / 3);\nsecNum = Math.floor(parseInt(secNum) / 3);\nif (firstNum < secNum)\n{\nfirstNum=reformString(firstNum.toString(), 3);\nsecNum=reformString(secNum.toString(), 3);\nnewTip += firstNum + \" ~ \" + secNum;;\n}\nelse if (firstNum == secNum)\n{\nsecNum=reformString(secNum.toString(), 3);\nnewTip += secNum;\n}\nelse\n{\nvar prevObjId = thisObj.prev().attr(\"id\");\nalert(\"Element[id='\"+prevObjId+\"']'s length range [\"+firstNum+\",\"+secNum+\"] is invalid after utf-8 transforming!\");\n}\n}\n}\nelse\n{\nthisObj.remove();\n}\nif (newTip != \"\")\n{\nthisObj.text(newTip);\n}\n});\ntemplate.on(\"focus.dTip\",\"input[type='text'],input[type='password']\", function(){\nvar thisObj = $(this);\nif (thisObj.attr(\"readonly\")) {\nreturn;\n}\nvar msg = \"\";\nvar firstTag = thisObj.next(\"span\")\nif(firstTag.length != 0 ){\nmsg = firstTag.not(\".__CheckPwdStrength\").text();\n}else{\nmsg = thisObj.nextAll(\"span\").not(\".__CheckPwdStrength\").text();\n}\nif (msg != \"\")\n{\nvar pos = thisObj.offset();\nvar objWidth = thisObj.width();\nvar dhtml = \"<div id='dynamicTip'><div id='dTip_l'></div>\"\n+ \"<div id='dTip_m'>\"\n+ msg\n+ \"</div><div id='dTip_r'></div></div>\";\nvar dtObj = $(dhtml).css({top:(pos.top-33)+'px',left:(pos.left+objWidth+8)+'px'});\ndtObj.appendTo('body').fadeIn(400);\nthisObj.bind(\"blur.dTip\",function(){\ndtObj.remove();\n});\n}\nvar fObj = $(\":focus\");\nvar tObj = $(\"#dynamicTip\");\nif ( (tObj.length > 0) && (fObj.attr(\"id\") != thisObj.attr(\"id\")) )\n{\ntObj.remove();\n}\n});\n$(\"input.ip,input.mac\", template).each(function(){\nvar InputOBJ = $(this);\nvar listType = \"\";\nif(InputOBJ.hasClass('ip')) {\nlistType = 'ip'\n}else{\nlistType = 'mac'\n}\nvar inputLabel = InputOBJ.closest('.row').find('label').first().text();\nvar suffix = InputOBJ.attr('id').match(/\\d+/) ? InputOBJ.attr('id').match(/\\d+/)[0] : \"\";\nvar ariaLabel = inputLabel + \" \" + listType + suffix;\nInputOBJ.attr(\"aria-label\", ariaLabel);\nInputOBJ.unbind(\"keydown\");\nInputOBJ.unbind(\"keyup\");\nInputOBJ.keydown(function(event){\nautoJumpBack(this,this.value,event);\n});\nInputOBJ.keyup(function(event){\nFocusAutoJump(this,this.value,event);\n});\n});\n$(\".instSwitch input\",template).each(function(){\nvar InputOBJ = $(this);\nif (InputOBJ.attr(\"type\") == \"radio\")\n{\nInputOBJ.unbind(\"change\");\nInputOBJ.change(function(event){\nvar template = $(this).parents(\"[id^='template_']\");\nvar ChangeArea = $(\".ChangeArea\",template);\nvar _InstIDName = \"_InstID\";\nvar _InstIDValue = template.find(\"[id^='_InstID']\").val();\nvar luquidObjUl = $(\"._LuQUID_CONFIG_OBJID\", Head);\nvar objId = $(\"li\", luquidObjUl).eq(0).text();\nif ( _InstIDValue == undefined )\n{\nvar instId = objId + \"\\\\._OBJ_InstID\";\n_InstIDValue = $(\"[id^='\"+ instId +\"']\",template).val();\n_InstIDName = objId + \"._OBJ_InstID\";\n}\nif ( ChangeArea.is(\":hidden\")\n&& _InstIDValue != \"-1\" )\n{\nvar ServerAddr = template.parents(\".HeadDIV\").find(\"address span\").text();\nvar instSwitchName = colonStripping(InputOBJ.attr(\"name\"));\nvar instSwitchValue = InputOBJ.val();\nvar PostData = \"IF_ACTION=Apply\"+\"&\"\n+ instSwitchName+\"=\"+instSwitchValue+\"&\"\n+ _InstIDName+\"=\" + _InstIDValue;\nvar actionType = \"InstSwitch\";\nvar PostSuccHandler = \"fillDataByInstSwitchResult\";\ndataPost(actionType, PostSuccHandler, ServerAddr, template, PostData);\n}\n});\n}\n});\ntemplate.unbind(\"fillDataByInstSwitchResult\");\ntemplate.bind(\"fillDataByInstSwitchResult\", function(event,xml, template){\nif ( template.hasError(xml) == 0 )\n{\nreturn;\n}\n$(\".ChangeArea\",template).showIt(true);\n$(\".collapsibleInst\",template).addClass(\"instNameExp\");\n});\ntemplate.unbind(\"fillDataByDeleteResult\");\ntemplate.bind(\"fillDataByDeleteResult\", function(event,xml, template){\nif ( template.hasError(xml) == 0 )\n{\ntemplate.remove();\n}\nelse\n{\n$(\".ChangeArea\",template).showIt(true);\n}\n});\ninitialStatusArea(Head);\ninitialConfigArea(Head);\n});\n$(\"[id^='AreaHideAttr']\").each(function(){\nvar HideAttr = $(this);\nvar HeadID = $(this).next().next().attr(\"id\") || $(this).next().attr(\"id\");\nvar template = $(\"#template_\"+HeadID);\nif (HideAttr.html() == 1){\ntemplate.find(\"*\").attr(\"disabled\",true).attr(\"hideattr\",true);\n$(\"[class^='Button']\", template).addClass(\"disableBtn\");\n$(\"[class^='longBtn']\", template).addClass(\"disableBtn\");\n$(\"[class^='instDelete Btn_delete']\").remove();\n$(\"[class^='addInstBar AddContentContainer']\").remove();\n$(\"[id^='Btn_cancel_'],[id^='Btn_apply_']\", template).unbind();\n$(\"[class^='Button Btn_refresh']\").removeClass(\"disableBtn\").attr(\"disabled\",false);\n}\n});\n});\n</script>\n\n<div id=\"_MenuInfo\" style=\"display:none;\">\n<div id=\"_NextPageInfo\">&#108;&#111;&#103;&#77;&#103;&#114;</div>\n<div id=\"_NowSupIdInfo\">&#109;&#103;&#114;&#65;&#110;&#100;&#68;&#105;&#97;&#103;</div>\n<div id=\"_NowMidIdInfo\">&#108;&#111;&#103;&#77;&#103;&#114;</div>\n<div id=\"_NowThdIdInfo\"></div>\n<div id=\"_Menu3Location\">&#48;</div>\n</div>\n\n<div id=\"commLeft\" role=\"complementary\">\n<div id=\"class2Menu\" class=\"class2Menu\" role=\"navigation\">\n<ul id=\"class2MenuItem\" class=\"\">\n</ul>\n</div>\n</div>\n<div id=\"commRight\">\n<input id='_totalTabWidth' type='hidden' value=''>\n<div id=\"class3Menu\">\n<div id=\"scrollLeftBtn\" class=\"scrollLeftBtn\"><p ></p></div>\n<div id=\"class3MenuMainContent\">\n<ul></ul>\n</div>\n<div id=\"scrollRightBtn\" class=\"scrollRightBtn\"><p></p></div>\n</div>\n<div class=\"tabContent\">\n<div id=\"pageIntroduce\" class=\"pageIntroduce\">\n<span tabindex=\"0\" role=\"text\">Page Information</span>\n</div>\n\n<p class=\"pIntroContent\" tabindex=\"0\" role=\"text\">&#84;&#104;&#105;&#115;&#32;&#112;&#97;&#103;&#101;&#32;&#112;&#114;&#111;&#118;&#105;&#100;&#101;&#115;&#32;&#116;&#104;&#101;&#32;&#102;&#117;&#110;&#99;&#116;&#105;&#111;&#110;&#32;&#111;&#102;&#32;&#108;&#111;&#103;&#32;&#112;&#97;&#114;&#97;&#109;&#101;&#116;&#101;&#114;&#40;&#115;&#41;&#32;&#99;&#111;&#110;&#102;&#105;&#103;&#117;&#114;&#97;&#116;&#105;&#111;&#110;&#46;</p>\n\n<div id=\"childPage\">\n<div class=\"instCfgArea\">\n<script type=\"text/javascript\">\n(function(){\nfunction initial_CutomButton(template)\n{\n$(\".Btn_refresh\", template).each(function(){\n$(this).unbind(\"click\");\n$(this).bind(\"click\", function(){\nvar template = $(this).parents(\"[id^='template_']\");\nvar Head = template.parents(\".HeadDIV\");\nvar ServerAddr = $(\"address span\", Head).text();\nvar PostData = \"IF_ACTION=Refresh\";\nvar PostSuccHandler = \"fillDataByCustomActionResult\";\ndataPost(\"Refresh\", PostSuccHandler, ServerAddr, template, PostData);\n});\n});\n$(\".Btn_save\", template).each(function(){\n$(this).unbind(\"click\");\n$(this).bind(\"click\", function(){\nvar HeadID = \"LogManagerConf\";\nvar Head = $(\"#\"+HeadID);\nvar loadAllowAddr = \"/?_type=menuData&_tag=updownload_prevent_ctl.lua\";\nvar postData = \"&sessToken=\" +document.getElementById(\"TOKEN_DOWNLOAD\").value;\ndataPost(\"updownload\", \"g_downLoadAllowHandle\", loadAllowAddr, template, postData);\n});\n});\n}\nfunction initial_template(templateID)\n{\nvar template = $(\"#\"+templateID);\ntemplate.bind(\"g_downLoadAllowHandle\", function(event,xml, template){\nvar HeadID = \"LogManagerConf\";\nvar Head = $(\"#\"+HeadID);\nif (Head.hasError(xml) == 0)\n{\nvar fileURL = \"/?_type=menuData&_tag=do_download_syslog.lua\";\ndocument.getElementById(\"fDownload\").action = fileURL;\ndocument.fDownload.submit();\n}\nelse\n{\nshowWaitTip(false);\n}\n});\ntemplate.bind(\"fillDataByApplyResult\", function(event, xml, template){\nif (template.hasError(xml) == 0)\n{\nsuccHintShow(template);\nvar OBJID = [\"OBJ_LOG_ID\"];\ntemplate.fillDataByOBJID(xml ,OBJID, template,0);\n}\n});\ntemplate.bind(\"fillDataByCancelResult\", function(event, xml, template){\nvar OBJID = [\"OBJ_LOG_ID\"];\nActionByCancelResult(xml, template, OBJID);\ntemplate.trigger(\"fillDataByCustom\",[0, template]);\n});\ntemplate.bind(\"fillDataByCustomActionResult\",function(event, xml, template){\nif (template.hasError(xml) == 0)\n{\nvar templateID = template.attr(\"id\");\nvar OBJID = [\"OBJ_LOG_ID\"];\ntemplate.fillDataByOBJID(xml ,OBJID, template, 0);\n}\n});\n$(\"#LogEnable\").click(function(){\nvar LogEnableRadio = $(\"input[name=LogEnable]:checked\").val();\nif(1==LogEnableRadio)\n{\n$(\"#div_LogLevel\").showIt(true);\n$(\"#LogLevel\").removeClass(\"PostIgnore\");\n}\nelse\n{\n$(\"#div_LogLevel\").showIt(false);\n$(\"#LogLevel\").addClass(\"PostIgnore\");\n}\n});\ntemplate.bind(\"fillDataByCustom\", function(event, suffix, ContainerOBJ){\nvar CustomizeParams = {\n\"ContainerOBJ\":ContainerOBJ\n};\n$(\"#LogEnable\").click();\n});\n}\n$(document).ready(function(){\nvar HeadID = \"LogManagerConf\";\nvar Head = $(\"#\"+HeadID);\nvar templateID = \"template_\"+HeadID;\ninitial_template(templateID);\ninitial_CutomButton($(\"#\"+templateID));\nHead.succfunction = function(xml){\nif (Head.hasError(xml) == 0)\n{\nvar OBJID = [\"OBJ_LOG_ID\"];\nvar template = $(\"#\"+templateID);\nHead.fillDataByOBJID(xml, OBJID, template, 0);\ntemplate.trigger(\"fillDataByCustom\",[0, template]);\n}\n};\nif ( $(\".collapBarWithDataTrans\",Head).length > 0 )\n{\ninitial_collapBarWithDataTrans(Head);\n}\n});\n})();\n</script>\n\n<div id=\"LogManagerConf\" class=\"HeadDIV\">\n<address style=\"display:none\">\n<span class=\"form-action\">/?_type=menuData&_tag=log_syslogmgr2_lua.lua</span>\n</address>\n<div class=\"externErrorHint\" style=\"display:none;\">\n<span class=\"caption1\"></span>\n</div>\n<h1 class=\"collapBarWithDataTrans\" id=\"LogManagerConfBar\">Device Log Management</h1>\n<div id=\"LogManagerConf_container\">\n<input id=\"DataHasBeenGot\" type=\"hidden\" value=\"0\">\n<div id=\"template_LogManagerConf\" class=\"formTblWrap\">\n<div id=\"errorHint\" class=\"errorHint\" style=\"display:none;\">\n<span class=\"caption1\"></span>\n</div>\n<div class=\"succHint\" style=\"display:none;\">\n<span class=\"caption1\">Your data have been stored!</span>\n</div>\n<form class=\"form_content formTbl\">\n<input type=\"hidden\" id=\"_BASICCONIG\" value=\"Y\">\n<div class=\"row\">\n<label class=\"cfgLabel w130\" for=\"LogEnable\">Save Log</label>\n<div class=\"right\" id=\"LogEnable\">\n<input type=\"radio\" value=\"1\" name=\"LogEnable\" id=\"LogEnable1\"><label for=\"LogEnable1\">On</label>&nbsp;&nbsp;\n<input type=\"radio\" value=\"0\" name=\"LogEnable\" id=\"LogEnable0\"><label for=\"LogEnable0\">Off</label>\n</div>\n</div>\n<div class=\"row\" id=\"div_LogLevel\" style=\"display:none;\">\n<label class=\"cfgLabel w130\" for=\"LogLevel\">Log Level</label>\n<div class=\"right\">\n<select name=\"LogLevel\" id=\"LogLevel\" class=\"selectNorm\">\n<option value=\"0\" title='Emergency'>Emergency</option>\n<option value=\"1\" title='Alert'>Alert</option>\n<option value=\"2\" title='Critical'>Critical</option>\n<option value=\"3\" title='Error'>Error</option>\n<option value=\"4\" title='Warning'>Warning</option>\n<option value=\"5\" title='Notice'>Notice</option>\n<option value=\"6\" title='Informational'>Informational</option>\n<option value=\"7\" title='Debug'>Debug</option>\n</select>\n</div>\n</div>\n<div class=\"buttongroup\">\n<input type=\"button\" class=\"Button Btn_cancel\" id=\"Btn_cancel_LogManagerConf\" name=\"Btn_cancel_LogManagerConf\" value=\"Cancel\" />\n<input type=\"button\" class=\"Button Btn_apply\" id=\"Btn_apply_LogManagerConf\" name=\"Btn_apply_LogManagerConf\" value=\"Apply\" />\n</div>\n</form>\n<form name=\"fDownload\" id=\"fDownload\" class=\"formTbl\" method=\"POST\" enctype=\"multipart/form-data\" onsubmit=\"return false;\">\n<input type=\"hidden\" name=\"downloadlog\" id=\"downloadlog\" value=\"\">\n<div class=\"row\">\n<label class=\"cfgLabel w130\">Log Output</label>\n</div>\n<div class=\"textareaRow\">\n<textarea id=\"logStr\" value=\"\"></textarea>\n</div>\n<div class=\"buttongroup\">\n<input type=\"button\" class=\"Button longBtn Btn_save\" id=\"Btn_save_LogManagerConf\" name=\"Btn_save_LogManagerConf\" value=\"Download Log\" />\n<input type=\"button\" class=\"Button Btn_refresh\" id=\"Btn_refresh_LogManagerConf\" name=\"Btn_refresh_LogManagerConf\" value=\"Refresh\" />\n</div>\n<input type=\"hidden\" id=\"TOKEN_DOWNLOAD\" name=\"TOKEN_DOWNLOAD\" value=\"&#55;&#117;&#118;&#49;&#118;&#110;&#82;&#81;&#112;&#84;&#113;&#117;&#121;&#86;&#100;&#115;&#107;&#116;&#55;&#119;&#118;&#119;&#97;&#86;\"/>\n</form>\n</div>\n</div>\n</div>\n<script type=\"text/javascript\">\nfunction Customize_IP(paramsOBJ)\n{\nvar ContainerOBJ = paramsOBJ[\"ContainerOBJ\"];\nvar IPOBJ = $(\"[id^='SysLogServer']\",ContainerOBJ);\nif (IPOBJ.val() == \"0.0.0.0\")\n{\nIPOBJ.val(\"\")\n}\n}\nfunction initial_template(templateID)\n{\nvar template = $(\"#\"+templateID);\nvar instForm = template.find(\"form\");\ninstForm.validate({\n\"rules\": {\n\"SysLogServer\": {\n\"rangelength\":[1,256]\n},\n\"SysLogPort\": {\n\"required\": true,\n\"integer\": true,\n\"rangelength\":[1,65535]\n}\n}\n});\ntemplate.bind(\"fillDataByApplyResult\", function(event, xml, template){\nif (template.hasError(xml) == 0)\n{\nsuccHintShow(template);\nvar OBJID = [\"OBJ_SYSLOG_ID\"];\ntemplate.fillDataByOBJID(xml ,OBJID, template,0);\n}\n});\ntemplate.bind(\"fillDataByCancelResult\", function(event, xml, template){\nvar OBJID = [\"OBJ_SYSLOG_ID\"];\nActionByCancelResult(xml, template, OBJID);\ntemplate.trigger(\"fillDataByCustom\",[0, template]);\n});\ntemplate.bind(\"fillDataByCustomActionResult\",function(event, xml, template){\nif (template.hasError(xml) == 0)\n{\nvar templateID = template.attr(\"id\");\nvar OBJID = [\"OBJ_SYSLOG_ID\"];\ntemplate.fillDataByOBJID(xml ,OBJID, template, 0);\n}\n});\ntemplate.bind(\"fillDataByCustom\", function(event, suffix, ContainerOBJ){\nvar CustomizeParams = {\n\"ContainerOBJ\":ContainerOBJ\n};\nCustomize_IP(CustomizeParams);\n});\n}\n$(document).ready(function(){\nvar HeadID = \"SysLogManagerConf\";\nvar Head = $(\"#\"+HeadID);\nvar templateID = \"template_\"+HeadID;\nvar ServerAddr = $(\"address span\", Head).text();\ninitial_template(templateID);\nHead.succfunction = function(xml){\nif (Head.hasError(xml) == 0)\n{\nvar OBJID = [\"OBJ_SYSLOG_ID\"];\nvar template = $(\"#\"+templateID);\nHead.fillDataByOBJID(xml, OBJID, template, 0);\ntemplate.trigger(\"fillDataByCustom\",[0, template]);\n}\n};\nif ( $(\".collapBarWithDataTrans\",Head).length <= 0 )\n{\nHead.dataTransfer(ServerAddr, \"GET\", Head.succfunction);\n}\nelse\n{\ninitial_collapBarWithDataTrans(Head);\n}\n});\n</script>\n\n<div id=\"SysLogManagerConf\" class=\"HeadDIV\">\n<address style=\"display:none\">\n<span class=\"form-action\">/?_type=menuData&_tag=LogManag_Syslog_lua.lua</span>\n</address>\n<div class=\"externErrorHint\" style=\"display:none;\">\n<span class=\"caption1\"></span>\n</div>\n<h1 class=\"collapBarWithDataTrans\" id=\"SysLogManagerConfBar\">System Log Management</h1>\n<div id=\"SysLogManagerConf_container\">\n<input id=\"DataHasBeenGot\" type=\"hidden\" value=\"0\">\n<div id=\"template_SysLogManagerConf\" class=\"formTblWrap\">\n<div id=\"errorHint\" class=\"errorHint\" style=\"display:none;\">\n<span class=\"caption1\"></span>\n</div>\n<div class=\"succHint\" style=\"display:none;\">\n<span class=\"caption1\">Your data have been stored!</span>\n</div>\n<form class=\"form_content formTbl\">\n<div class=\"row\">\n<label class=\"cfgLabel w130\" for=\"SysLogEnable\">Enable</label>\n<div class=\"right\" id=\"SysLogEnable\">\n<input type=\"radio\" value=\"1\" name=\"SysLogEnable\" id=\"SYSLogEnable1\"><label for=\"SYSLogEnable1\">On</label>&nbsp;&nbsp;\n<input type=\"radio\" value=\"0\" name=\"SysLogEnable\" id=\"SYSLogEnable0\"><label for=\"SYSLogEnable0\">Off</label>\n</div>\n</div>\n<div class=\"row\" id=\"div_SysLogTarget\" style=\"\">\n<label class=\"cfgLabel w130\" for=\"SysLogTarget\">Target</label>\n<div class=\"right\">\n<select name=\"SysLogTarget\" id=\"SysLogTarget\" class=\"selectNorm\">\n<option value=\"0\" title='Local'>Local</option>\n<option value=\"1\" title='Remote'>Remote</option>\n</select>\n</div>\n</div>\n<div class=\"row\" id=\"div_SysLogTimeout\" style=\"\">\n<label class=\"cfgLabel w130\" for=\"SysLogTimeout\">Timeout</label>\n<div class=\"right\">\n<input class=\"inputNorm\" name=\"SysLogTimeout\" type=\"text\" id=\"SysLogTimeout\" value=\"\"/>\n</div>\n</div>\n<div class=\"row\" id=\"div_SysLogServer\" style=\"\">\n<label class=\"cfgLabel w130\" for=\"SysLogServer\">Server</label>\n<div class=\"right\">\n<input class=\"inputNorm\" name=\"SysLogServer\" type=\"text\" id=\"SysLogServer\" value=\"\"/>\n<span class=\"dTip\" style=\"display: none;\">Length: 1 ~ 256</span>\n</div>\n</div>\n<div class=\"row\" id=\"div_SysLogPort\" style=\"\">\n<label class=\"cfgLabel w130\" for=\"SysLogPort\">Port