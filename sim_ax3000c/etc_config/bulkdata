# bulkdata uci configuration

config profile
	option id '0'
	option enable '0'
	option reporting_interval '300'
	option time_reference '2019-04-25T12:00:00Z'
	option protocol 'HTTP'
	option http_url 'https://bdc.acme.com/somedirectory'
	option http_username 'username'
	option http_password 'password'
	option http_method 'POST'
	option http_compression 'Disabled'
	option http_dateheader '1'
	option http_retryenable '1'
	#option http_ssl_cert ''
	#option http_ssl_cacert ''
	#option http_ssl_verify 'enabled'
	option minimum_wait_interval '5'
	option interval_multiplier '2000'
	option nb_of_retained_failed '0'
	option encoding_type 'CSV'
	option report_format 'ParameterPerColumn'
	option report_timestamp 'Unix-Epoch'
	option csv_fieldseparator ','
	option csv_rowseparator '&#13;&#10;'
	option csv_escapechar '&quot;'

config parameter 
	option id '0'
	option name ''
	option reference ''

config URIparameter 
	option id '0'
	option name ''
	option reference ''

config local 'local'
	option bulkdata_enable '1'
	option periodic_statistics_enable '1'

#Log levels: Critical=0, Warning=1, Notice=2, Info=3, Debug=4
	option log_level '3'
	option ubus_socket '/var/run/ubus.sock'


