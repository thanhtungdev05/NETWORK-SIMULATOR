            "compression": 2577,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'USB Application' | translate }}\" sub-title translate>USB User Management</b><hr><form action=/cgi-bin/ftpmng.cgi method=post name=frm1><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td align=right class=red>|&nbsp; <a class=DenyLink href=# onClick=javascript:settodefault() translate>Set to Factory Default</a>&nbsp;|</td></tr></table><table border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 class=table-striped width=100%><thead><tr align=center><th translate width=10%>Index</th><th translate width=5%>Enable</th><th translate width=15%>Username</th><th translate width=20%>Home Folder</th><th translate width=25%>File Access Rule</th><th translate width=25%>Directory Access Rule</th></tr></thead><tbody><tr align=center ng-init=i=$index ng-repeat=\"item in aryUsbUser\"><td> <a href=# ng-click=gotoDetailSet(i+1)>{{i+1}}.</a></td><td><input name=Active{{i}} ng-change=onclkStat(i) ng-model=item[4] type=checkbox value=1></td><td nowrap>{{item[0]}}</td><td nowrap>{{item[1]}}</td><td>{{item[2]}}</td><td>{{item[3]}}</td></tr></tbody></table></td></tr></table><input name=sProfileAct type=hidden><input name=iProfileIdx type=hidden><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></td></tr></table><table align=center width=100%><tr align=center><td><input class=btnw name=btnOk onclick=onClkBtnOk() type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnCcl onclick=onClkBtnCcl() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table><textarea id=ftpuser1init ng-hide=true>\n\tvar aryUsbUser = [[\"\",\"\",false,0,0,0,0,0,0],[\"\",\"\",false,0,0,0,0,0,0],[\"\",\"\",false,0,0,0,0,0,0],[\"\",\"\",false,0,0,0,0,0,0],[\"\",\"\",false,0,0,0,0,0,0],[\"\",\"\",false,0,0,0,0,0,0],[\"\",\"\",false,0,0,0,0,0,0],[\"\",\"\",false,0,0,0,0,0,0],[\"\",\"\",false,0,0,0,0,0,0],[\"\",\"\",false,0,0,0,0,0,0],[\"\",\"\",false,0,0,0,0,0,0],[\"\",\"\",false,0,0,0,0,0,0],[\"\",\"\",false,0,0,0,0,0,0],[\"\",\"\",false,0,0,0,0,0,0],[\"\",\"\",false,0,0,0,0,0,0],[\"\",\"\",false,0,0,0,0,0,0]];\n\tconst iActionStatusFlag = '1',\n\tiFwUpgradeState = '0';\n</textarea><script> var ftpuser1initscript=document.createElement(\"script\");ftpuser1initscript.text=document.getElementById(\"ftpuser1init\").value;document.head.appendChild(ftpuser1initscript);top.ACTION_STATUS=-1;top.iActionStatusFlag=iActionStatusFlag;top.iFwUpgradeState=iFwUpgradeState;top.act_sta.damage_alert();var bg=parent;var f=document.frm1;angular.element(document).ready(function(){initParameter();});function initParameter(){let A,B;$scope.aryUsbUser=[];for(var i=0;i<15;i++){A=\"\";B=\"\";if(aryUsbUser[i][3]==1){A=gettext(\"Read\");}if(aryUsbUser[i][4]==1){if(A.length!=0)A+=\",\"+gettext(\"Write\");else A+=gettext(\"Write\");}if(aryUsbUser[i][5]==1){if(A.length!=0){A+=\",\"+gettext(\"Delete\");}else{A+=gettext(\"Delete\");}}if(aryUsbUser[i][6]==1){B=gettext(\"List\");}if(aryUsbUser[i][7]==1){if(B.length!=0){B+=\",\"+gettext(\"Create\");}else{B+=gettext(\"Create\");}}if(aryUsbUser[i][8]==1){if(B.length!=0){B+=\",\"+gettext(\"Remove\");}else{B+=gettext(\"Remove\");}}$scope.aryUsbUser.push([aryUsbUser[i][0],aryUsbUser[i][1].substring(0,16),A,B,aryUsbUser[i][2]]);}$scope.gotoDetailSet=gotoDetailSet;$scope.onclkStat=onclkStat;$scope.$apply();}function settodefault(){if(true==confirm(gettext(\"Do you want to clear all profiles?\"))){f.sProfileAct.value=\"settodefault\";f.submit();}}function gotoDetailSet(idx){f.sProfileAct.value=\"showitem\";f.iProfileIdx.value=idx;f.submit();}function onClkBtnOk(){f.sProfileAct.value=\"savepage\";f.submit();}function onClkBtnCcl(){f.sProfileAct.value=\"showpage\";f.submit();}function onclkStat(idx){if(aryUsbUser[idx][0]==\"\"){alert(gettext(\"The username could not be empty, please re-enter.\"));$scope.aryUsbUser[idx][4]=false;return;}}</script></body></html>"
