ementById(\"apply_to_ap_swm_note\").style.display=\"\";}}); if(acsSecEnable){f.acs2_failbackMode.value='0';if(\"0\"==\"0\"){document.getElementById(\"acsServerTarget\").innerHTML=gettext(\"Connected to Primary.\");}else{document.getElementById(\"acsServerTarget\").innerHTML=gettext(\"Connected to Secondary.\");} for(var i=2;i<f.iTR069_PVC.children.length;i++){f.iTR069_PVC2[f.iTR069_PVC2.length]=new Option(f.iTR069_PVC.children[i].innerHTML,f.iTR069_PVC.children[i].value);}}angular.element(document.querySelectorAll(\".link_note a\")).attr(\"href\",'/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=2041');angular.element(document.querySelector(\"#link_extnote a\")).attr(\"href\",\"/cgi-bin/v2x00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=2103\");angular.element(document.querySelector(\".chkDisplay translate a\")).attr(\"href\",'/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=2041');angular.forEach(angular.element(document.querySelectorAll(\"input[placeholder]\")),function(self){self.placeholder=self.placeholder.replace(\"###LEN###\",self.maxLength);});}function initParameter(){f.cpe_enable.checked=cpe_enable;$scope.cpe_enable=cpe_enable;var cpe_https_enable=parseInt(\"0\");bg.setVle2Elmt(f.cpe_https_enable[0],cpe_https_enable,0);f.periodic_enable.checked=parseInt('1');document.getElementById(\"https_note\").style.display=\"none\";acs_web_enable();if(cpe_enable){if(location.search.includes('inform=1'))inform_click_callback(1);inform_check();} bg.setVle2Elmt(f.iTR069_PVC,tr069_wanif,0);if(acsSecEnable){f.iTR069_PVC2.value=tr069_wanif_secondary;f.enTr069_sec.checked=(bg.enTr069_sec==undefined)?true:bg.enTr069_sec;}bg.setVle2Elmt(f.urlEn,iurlEn,0);chgTr069PVC(0);f.enTr069.checked=(bg.enTr069==undefined)?true:bg.enTr069;bg.setVle2Elmt(f.selaliasip,iAliasip,0);if($scope.isAcsSecEnable){f.selaliasip2.value=iAliasip_secondary;}var d,t; for(i=0;i<50;i++){f.year.options[i]=new Option(i+2000,i+2000);}for(i=0;i<12;i++){d=(i+1);if(d<10){d=\"0\"+d;}f.month.options[i]=new Option(d,d