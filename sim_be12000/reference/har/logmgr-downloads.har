OBJ.find(\"[id^='InMulticast']\");\nvar InErrorOBJ = ContainerOBJ.find(\"[id^='InError']\");\nvar InDiscardOBJ = ContainerOBJ.find(\"[id^='InDiscard']\");\nvar index = parseInt(suffix) + 1;\nvar AliasName = \"LAN\" + index;\nvar Status = getParaValueInXML(getXml, \"OBJ_PON_PORT_BASIC_STATUS_ID\", suffix, \"Status\");\nvar Speed = getParaValueInXML(getXml, \"OBJ_PON_PORT_BASIC_STATUS_ID\", suffix, \"Speed\");\nvar Duplex = getParaValueInXML(getXml, \"OBJ_PON_PORT_BASIC_STATUS_ID\", suffix, \"Duplex\");\nvar InBytes =getParaValueInXML(getXml, \"OBJ_PON_PORT_BASIC_STATUS_ID\", suffix, \"InBytes\");\nvar InPkts = getParaValueInXML(getXml, \"OBJ_PON_PORT_BASIC_STATUS_ID\", suffix, \"InPkts\");\nvar InUnicast = getParaValueInXML(getXml, \"OBJ_PON_PORT_BASIC_STATUS_ID\", suffix, \"InUnicast\");\nvar InMulticast = getParaValueInXML(getXml, \"OBJ_PON_PORT_BASIC_STATUS_ID\", suffix, \"InMulticast\");\nvar InError = getParaValueInXML(getXml, \"OBJ_PON_PORT_BASIC_STATUS_ID\", suffix, \"InError\");\nvar InDiscard = getParaValueInXML(getXml, \"OBJ_PON_PORT_BASIC_STATUS_ID\", suffix, \"InDiscard\");\nvar OutBytes = getParaValueInXML(getXml, \"OBJ_PON_PORT_BASIC_STATUS_ID\", suffix, \"OutBytes\");\nvar OutPkts = getParaValueInXML(getXml, \"OBJ_PON_PORT_BASIC_STATUS_ID\", suffix, \"OutPkts\");\nvar OutUnicast = getParaValueInXML(getXml, \"OBJ_PON_PORT_BASIC_STATUS_ID\", suffix, \"OutUnicast\");\nvar OutMulticast = getParaValueInXML(getXml, \"OBJ_PON_PORT_BASIC_STATUS_ID\", suffix, \"OutMulticast\");\nvar OutError = getParaValueInXML(getXml, \"OBJ_PON_PORT_BASIC_STATUS_ID\", suffix, \"OutError\");\nvar OutDiscard = getParaValueInXML(getXml, \"OBJ_PON_PORT_BASIC_STATUS_ID\", suffix, \"OutDiscard\");\nvar LanStatus;\nvar InOutBytes;\nvar InOutPkts;\nvar InOutUnicast;\nvar InOutMulticast;\nvar InOutError;\nvar InOutDiscard;\nif(Status == 0)\n{\nLanStatus = \"Up/\";\nif((curv == \"156\")&&(Speed == \"1000\" || Speed == \"10000\")){\nSpeed = parseInt(Speed)/1000 + \"Gbps/\";\n}\nelse{\nSpeed = Speed==\"Auto\"?\"AUTO/\":Speed+\"Mbps/\";\n}\nLanStatus += Speed;\nswitch(Duplex)\n{\ncase \"Auto\":\nLanStatus += \"Auto\";\nbreak;\ncase \"Half\":\nLanStatus += \"Half Duplex\";\nbreak;\ncase \"Full\":\nLanStatus += \"Full Duplex\";\nbreak;\n}\n}\nelse if (Status == 1)\n{\nLanStatus = \"NoLink\";\n}\nelse if (Status == 2)\n{\nLanStatus = \"Error\";\n}\nelse if (Status == 3)\n{\nLanStatus = \"Disabled\";\n}\nInOutBytes = InBytes + \"/\" + OutBytes;\nInOutPkts = InPkts + \"/\" + OutPkts;\nInOutUnicast = InUnicast + \"/\" + OutUnicast;\nInOutMulticast = InMulticast + \"/\" + OutMulticast;\nInOutError = InError + \"/\" + OutError;\nInOutDiscard = InDiscard + \"/\" + OutDiscard;\nAliasNameOBJ.text(AliasName);\nAliasNameOBJ.attr(\"title\", AliasName);\nif (curv==156)\n{\n$(\"[id^='AliasName:4']\").text(\"10G-LAN\");\n$(\"[id^='AliasName:4']\").attr('title','10G-LAN');\n}\nif (curv==176)\n{\n$(\"[id^='AliasName:4']\").text(\"10G LAN\");\n$(\"[id^='AliasName:4']\").attr('title','10G LAN');\n$(\"[id^='AliasName:5']\").text(\"10G WAN\");\n$(\"[id^='AliasName:5']\").attr('title','10G WAN');\n}\nStatusOBJ.text(LanStatus);\nStatusOBJ.attr(\"title\", LanStatus);\nInBytesOBJ.text(InOutBytes);\nInBytesOBJ.attr(\"title\", InOutBytes);\nInPktsOBJ.text(InOutPkts);\nInPktsOBJ.attr(\"title\", InOutPkts);\nInUnicastOBJ.text(InOutUnicast);\nInUnicastOBJ.attr(\"title\", InOutUnicast);\nInMulticastOBJ.text(InOutMulticast);\nInMulticastOBJ.attr(\"title\", InOutMulticast);\nInErrorOBJ.text(InOutError);\nInErrorOBJ.attr(\"title\", InOutError);\nInDiscardOBJ.text(InOutDiscard);\nInDiscardOBJ.attr(\"title\", InOutDiscard);\n};\nHead.succfunction = function(xml){\ngetXml = xml;\nvar cmapiErrorContainer = $(\".errorHint\",Head);\nif (cmapiErrorContainer.hasError(xml) == 0);\n{\nHead.chanegeDataByCustom(xml);\nvar OBJ = $(xml).find(\"OBJ_PON_PORT_BASIC_STATUS_ID\");\nvar RuleNum = $(\"Instance\", OBJ).length;\nvar OBJID = [\n\"OBJ_PON_PORT_BASIC_STATUS_ID\"\n];\nif(curv == \"65\")\nRuleNum = 1;\nHead.createPageDataByClone(RuleNum, OBJID, xml,\nHead.fillDataByCustom);\nif(curv == \"31\" || curv == \"2024\")\n{\n$(\"#template_lan_info_3\").hide();\n}\nvar data = {};\ndata.xml = xml;\n$.callModifier(\"StatusLanInfo/hiddenlaninfo\",data);\n}\n};\nif ( $(\".collapBarWithDataTrans\",Head).length <= 0 )\n{\nHead.dataTransfer(ServerAddr, \"GET\", Head.succfunction);\n}\nelse\n{\ninitial_collapBarWithDataTrans(Head);\n}\n});\n})();\n</script>\n\n<div id=\"lan_info\" class=\"HeadDIV\">\n<address style=\"display:none\">\n<span class=\"form-action\">/?_type=menuData&_tag=status_lan_info_lua.lua</span>\n</address>\n<div class=\"externErrorHint\" style=\"display:none;\">\n<span class=\"caption1\"></span>\n</div>\n<h1 class=\"collapBarWithDataTrans\" id=\"lan_infoBar\">LAN Information</h1>\n<div id=\"lan_info_container\">\n<div class=\"noDataHint\" style=\"display:none;\">\n<span>There are no data now. </span>\n</div>\n<input type=\"hidden\" id=\"DataHasBeenGot\" value=\"0\">\n<div class=\"form_content\">\n<div id=\"template_lan_info\" class=\"colorTbl\" style=\"display:none;\">\n<table class=\"verticalTable\">\n<tr id=\"\" class=\"colorTblRow emFont titleRow\">\n<th class=\"w330 emFont\" title=\"Ethernet Port\">Ethernet Port</th>\n<td class=\"w250\" id=\"AliasName\" title=\"\"></td>\n</tr>\n<tr id=\"\" class=\"colorTblRow\">\n<th class=\"w330 emFont\" title=\"Status\">Status</th>\n<td class=\"w250\" id=\"Status\" title=\"\"></td>\n</tr>\n<tr id=\"\" class=\"colorTblRow\">\n<th class=\"w330 emFont\" title=\"Bytes Received/Sent\">Bytes Received/Sent</th>\n<td class=\"w250\" id=\"InBytes\" title=\"\"></td>\n</tr>\n<tr id=\"\" class=\"colorTblRow\">\n<th class=\"w330 emFont\" title=\"Packets Received/Sent\">Packets Received/Sent</th>\n<td class=\"w250\" id=\"InPkts\" title=\"\"></td>\n</tr>\n<tr id=\"\" class=\"colorTblRow\">\n<th class=\"w330 emFont\" title=\"Unicast Packets Received/Sent\">Unicast Packets Received/Sent</th>\n<td class=\"w250\" id=\"InUnicast\" title=\"\"></td>\n</tr>\n<tr id=\"\" class=\"colorTblRow\">\n<th class=\"w330 emFont\" title=\"Multicast Packets Received/Sent\">Multicast Packets Received/Sent</th>\n<td class=\"w250\" id=\"InMulticast\" title=\"\"></td>\n</tr>\n<tr id=\"\" class=\"colorTblRow\">\n<th class=\"w330 emFont\" title=\"Error Packets Received/Sent\">Error Packets Received/Sent</th>\n<td class=\"w250\" id=\"InError\" title=\"\"></td>\n</tr>\n<tr id=\"\" class=\"colorTblRow\">\n<th class=\"w330 emFont\" title=\"Discard Packets Received/Sent\">Discard Packets Received/Sent</th>\n<td class=\"w250\" id=\"InDiscard\" title=\"\"></td>\n</tr>\n</table>\n</div>\n<div class=\"buttongroup\">\n<input type=\"button\" class=\"Button Btn_refresh\" id=\"Btn_refresh_lan_info\" name=\"Btn_refresh_lan_info\" value=Refresh />\n</div>\n</div>\n</div>\n</div>\n<script type=\"text/javascript\">\n(function () {\n\nvar ssidEncryJson = {};\nssidEncryJson = JSON.parse('[\"No Security:\",\"WPA2-PSK-AES:\",\"WPA/WPA2-PSK-AES:\",\"WPA3-SAE:\",\"WPA2-PSK-AES/WPA3-SAE-AES:\"]');\nvar EncryptionParameter = {\n\"No Security\": {\n\"BeaconType\": \"None\"\n},\n\"WEP-OpenSystem\": {\n\"BeaconType\":\"Basic\",\n\"WEPAuthMode\":\"None\"\n},\n\"WEP-ShareKey\": {\n\"BeaconType\": \"Basic\",\n\"WEPAuthMode\":\"SharedAuthentication\"\n},\n\"WPA-PSK-TKIP\": {\n\"BeaconType\":\"WPA\",\n\"WPAAuthMode\":\"PSKAuthentication\",\n\"WPAEncryptType\":\"TKIPEncryption\"\n},\n\"WPA-PSK-AES\": {\n\"BeaconType\":\"WPA\",\n\"WPAAuthMode\":\"PSKAuthentication\",\n\"WPAEncryptType\":\"AESEncryption\"\n},\n\"WPA-PSK-TKIP/AES\": {\n\"BeaconType\":\"WPA\",\n\"WPAAuthMode\":\"PSKAuthentication\",\n\"WPAEncryptType\":\"TKIPandAESEncryption\"\n},\n\"WPA2-PSK-AES\": {\n\"BeaconType\":\"11i\",\n\"11iAuthMode\":\"PSKAuthentication\",\n\"11iEncryptType\":\"AESEncryption\"\n},\n\"WPA2-PSK-TKIP\": {\n\"BeaconType\":\"11i\",\n\"11iAuthMode\":\"PSKAuthentication\",\n\"11iEncryptType\":\"TKIPEncryption\"\n},\n\"WPA2-PSK-TKIP/AES\": {\n\"BeaconType\":\"11i\",\n\"11iAuthMode\":\"PSKAuthentication\",\n\"11iEncryptType\":\"TKIPandAESEncryption\"\n},\n\"WPA/WPA2-PSK-TKIP\": {\n\"BeaconType\":\"WPAand11i\",\n\"WPAAuthMode\":\"PSKAuthentication\",\n\"11iAuthMode\":\"PSKAuthentication\",\n\"WPAEncryptType\":\"TKIPEncryption\",\n\"11iEncryptType\":\"TKIPEncryption\"\n},\n\"WPA/WPA2-PSK-AES\": {\n\"BeaconType\":\"WPAand11i\",\n\"WPAAuthMode\":\"PSKAuthentication\",\n\"11iAuthMode\":\"PSKAuthentication\",\n\"WPAEncryptType\":\"AESEncryption\",\n\"11iEncryptType\":\"AESEncryption\"\n},\n\"WPA/WPA2-PSK-TKIP/AES\": {\n\"BeaconType\":\"WPAand11i\",\n\"WPAAuthMode\":\"PSKAuthentication\",\n\"11iAuthMode\":\"PSKAuthentication\",\n\"WPAEncryptType\":\"TKIPandAESEncryption\",\n\"11iEncryptType\":\"TKIPandAESEncryption\"\n},\n\"WPA2-EAP-AES\": {\n\"BeaconType\": \"11i\",\n\"11iAuthMode\": \"EAPAuthentication\",\n\"11iEncryptType\": \"AESEncryption\"\n},\n\"WPA/WPA2-EAP-TKIP/AES\": {\n\"BeaconType\": \"WPAand11i\",\n\"WPAAuthMode\": \"EAPAuthentication\",\n\"11iAuthMode\": \"EAPAuthentication\",\n\"WPAEncryptType\": \"TKIPandAESEncryption\",\n\"11iEncryptType\": \"TKIPandAESEncryption\"\n},\n\"WPA/WPA2-EAP-AES\": {\n\"BeaconType\": \"WPAand11i\",\n\"WPAAuthMode\": \"EAPAuthentication\",\n\"11iAuthMode\": \"EAPAuthentication\",\n\"WPAEncryptType\": \"AESEncryption\",\n\"11iEncryptType\": \"AESEncryption\"\n},\n\"WPA3-OWE\": {\n\"BeaconType\":\"WPA3\",\n\"WPA3AuthMode\":\"OWEAuthentication\",\n\"WPA3EncryptType\":\"AESEncryption\"\n},\n\"WPA3-SAE\": {\n\"BeaconType\":\"WPA3\",\n\"WPA3AuthMode\":\"SAEAuthentication\",\n\"WPA3EncryptType\":\"AESEncryption\"\n},\n\"WPA/WPA2/WPA3-PSK/SAE\": {\n\"BeaconType\":\"WPAand11iandWPA3\",\n\"WPAAuthMode\":\"PSKAuthentication\",\n\"11iAuthMode\":\"PSKAuthentication\",\n\"WPA3AuthMode\":\"SAEAuthentication\",\n\"WPAEncryptType\":\"TKIPandAESEncryption\",\n\"11iEncryptType\":\"TKIPandAESEncryption\",\n\"WPA3EncryptType\":\"AESEncryption\"\n},\n\"WPA2/WPA3-SAE\": {\n\"BeaconType\":\"11iandWPA3\",\n\"11iAuthMode\":