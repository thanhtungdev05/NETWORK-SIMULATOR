            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><script> var tp=top;if(tp.printLogo==null){tp=parent.opener.top;}</script><tr><td><b parent=\"{{ 'System Maintenance' | translate }}\" sub-title translate>Login Page Greeting</b><hr><form action=/cgi-bin/v2X00.cgi method=post name=frm><table align=center border=0 cellpadding=2 cellspacing=0 width=700px><tr><td><b translate>Login Page Greeting</b></td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=700><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=600><tbody ng-show=bUserLoginLogo><br><tr><td width=20%><translate>Login Page Logo</translate>:&nbsp;</td><td><select convert-to-number name=iLoginLogo ng-model=iLoginLogo><option translate value=0>Default</option><option translate value=1>Blank</option><option translate value=2>Upload a file</option></select></td><td></td></tr><div style=\"margin-top: -5px;position:relative;\"><tr><td></td><td colspan=2><input accept=.png,.jpg name=fileUpload ng-disabled=\"iLoginLogo != 2\" type=file> (<translate>Max 524 × 352 pixel</translate>)&nbsp; <input name=btnUpload ng-disabled=\"iLoginLogo != 2\" onclick=uploadPic() type=button value=\"{{ 'Upload' | translate }}\"></td></tr></div></tbody><tr><td colspan=3><label><input name=iURLEnable ng-model=iURLEnable type=checkbox value=1>&nbsp;<translate>Enable Greeting</translate></label></td></tr><tr><td translate>Login Page Title</td><td colspan=2><input maxlength=31 name=sDesc ng-model=sCustLoginDesc placeholder=\"{{ 'Max: ###LEN### characters' | translate }}\" size=31 type=text value></td></tr><tr><td colspan=2 nowrap><translate>Welcome Message and Bulletin</translate>&nbsp;(<translate translate-params-num=\"511\">Max {{num}} characters</translate>)</td><td align=right class=red> <a href=javascript:preview() translate>Preview</a>&nbsp;|&nbsp; <input class=btnw4 onclick=onClkDefMess() type=button value=\"{{ 'Default Message' | translate }}\"></td></tr><tr><td colspan=3><textarea cols=64 name=sURL onkeydown=textCounter() onkeyup=textCounter() rows=10 style=\"width: 600px;\"><h1><b><font color=red>Welcome Message</font></b></h1><p>This welcome message is displayed in the Login page of the router. Replace this text with your own message. </p><ol><li>The welcome message can be written in HTML so lists such as this one can be created </li><li>Other markup tags such as p, font or img can be used</li></ol></textarea></td></tr><tr><td colspan=3><translate>Examples of Welcome Message and Bulletin</translate>:<br> &lt;h1>&lt;b>&lt;font color=red><translate>Welcome Message</translate>&lt;/font>&lt;/b>&lt;/h1><br> &lt;p><translate>Message</translate>&lt;/p><br><br></td></tr></table></td></tr></table><br><table align=center border=0 cellpadding=2 cellspacing=0 width=700><tr><td><b translate>Login Page Router Summary</b></td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=700><tr><td><br><table align=center border=0 cellpadding=2 cellspacing=0 width=88%><tr><td><label><input name=iSumEnable ng-model=iSumEnable type=checkbox value=1><translate>Enable</translate></label></td></tr><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=95%><tr ng-init=i=$index ng-repeat=\"item in [].constructor(wannum) track by $index\"><td ng-if=\"i+1 == iLTEIndexNum && bQLTE\"><label><input name=iWan{{i}}Enable ng-disabled=!iSumEnable ng-model=aryWanEnable[i] type=checkbox value=1>&nbsp; LTE</label></td><td ng-if=\"!(i+1 == iLTEIndexNum && bQLTE || bWAN2Dsiable && 1==i || (['7','8'].includes(aryBwType[i])) && iWireless11AXExists)\" ng-switch=aryBwType[i]><label><input name=iWan{{i}}Enable ng-disabled=!iSumEnable ng-model=aryWanEnable[i] type=checkbox value=1>&nbsp; <span translate>WAN</span>{{i+1}}</label> (<span ng-switch-when=\"0\" translate>Ethernet</span><span ng-switch-when=\"1\" translate>ADSL</span><span ng-switch-when=\"2\" translate>Fiber</span><span ng-switch-when=\"3\" translate>USB</span><span ng-switch-when=\"4\" translate>Ethernet</span><span ng-switch-when=\"5\" translate>ADSL</span><span ng-switch-when=\"6\" translate>VDSL2</span><span ng-switch-when=\"7\" translate>Wireless 2.4G</span><span ng-switch-when=\"8\" translate>Wireless 5G</span><span ng-switch-when=\"9\" translate>G.fast</span>) </td></tr><tr><td><label><input name=iVpnEnable ng-disabled=!iSumEnable ng-model=iVpnEnable type=checkbox value=1>&nbsp;&nbsp;<span translate>VPN</span></label></td></tr></table></td></tr></table><br></td></tr></table><br><table align=center><tr><td><input class=btnw name=ok onclick=onClkBtnOk() type=button value=\"{{ 'OK' | translate }}\"></td><td><input class=btnw name=Cancel onclick=location.reload() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table><input name=fid type=hidden value=2187><input name=iAct type=hidden><input name=webchange type=hidden value=0><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></td></tr></table><textarea id=loginsetinit style=display:none>\n\tvar sCustLoginDesc = \"Router Login\";\n\tvar iCustomLoginFlag = '0';\n\tvar iLoginLogo = '0';\n\tvar aryBwType = [\"0\", \"0\", \"7\",\n        \"8\", \"3\", \"3\",\n        \"4\", \"4\", \"4\",\n        \"825503028\" ];\n\tvar wannum = 6;\n\tconst iWireless11AXExists = '0' == 1;\n</textarea><script>tp.ACTION_STATUS=-1;tp.iActionStatusFlag='0';tp.iFwUpgradeState='0';tp.act_sta.damage_alert();var bg=tp;var f=document.frm;var loginsetinitscript=document.createElement(\"script\");loginsetinitscript.text=document.getElementById(\"loginsetinit\").value;document.head.appendChild(loginsetinitscript);var loginset_preview=0;const maxFileSize=524*352;angular.element(document).ready(function(){initParameter();f.fileUpload.addEventListener('change',function(event){const target=event.target;if(target.files&&target.files[0]){if(target.files[0].size>maxFileSize){target.value='';alert(gettext('Upload fail.Image size over ###MAX### KB.').replace('###MAX###',Math.floor(maxFileSize/1024)));}}});angular.forEach(document.querySelectorAll(\"input[placeholder]\"),function(self){self.placeholder=self.placeholder.replace(\"###LEN###\",self.maxLength);});initWebChange();});function initParameter(){const CUST_LOGIN_ENABLE=(1<<3);const CUST_LOGIN_ROUTER_INFO_EN=(1<<4);const CUST_LOGIN_ROUTER_INFO_WAN1=(1<<5);const CUST_LOGIN_ROUTER_INFO_WAN2=(1<<6);const CUST_LOGIN_ROUTER_INFO_WAN3=(1<<7);const CUST_LOGIN_ROUTER_INFO_WAN4=(1<<8);const CUST_LOGIN_ROUTER_INFO_WAN5=(1<<9);const CUST_LOGIN_ROUTER_INFO_WAN6=(1<<10);const CUST_LOGIN_ROUTER_INFO_VPN=(1<<11);const aryCustInfoFlag=[CUST_LOGIN_ROUTER_INFO_WAN1,CUST_LOGIN_ROUTER_INFO_WAN2,CUST_LOGIN_ROUTER_INFO_WAN3,CUST_LOGIN_ROUTER_INFO_WAN4,CUST_LOGIN_ROUTER_INFO_WAN5,CUST_LOGIN_ROUTER_INFO_WAN6];$scope.iLoginLogo=iLoginLogo;$scope.iURLEnable=(iCustomLoginFlag&CUST_LOGIN_ENABLE)==CUST_LOGIN_ENABLE;$scope.iSumEnable=(iCustomLoginFlag&CUST_LOGIN_ROUTER_INFO_EN)==CUST_LOGIN_ROUTER_INFO_EN;$scope.aryWanEnable=[];for(var i=0;i<wannum;i++)$scope.aryWanEnable[i]=(iCustomLoginFlag&aryCustInfoFlag[i])==aryCustInfoFlag[i];$scope.bQLTE=parseInt('0');$scope.iLTEIndexNum='3';$scope.bWAN2Dsiable=parseInt('0');$scope.iVpnEnable=(iCustomLoginFlag&CUST_LOGIN_ROUTER_INFO_VPN)==CUST_LOGIN_ROUTER_INFO_VPN;$scope.sCustLoginDesc=sCustLoginDesc;$scope.aryBwType=aryBwType;$scope.wannum=wannum;$scope.iWireless11AXExists=iWireless11AXExists;$scope.bUserLoginLogo=parseInt('1');$scope.$apply();}function onClkBtnOk(){var eventMatch;if((eventMatch=f.sDesc.value.match(/<.*(script|iframe).*>/i))||(eventMatch=f.sURL.value.match(/<.*(script|iframe).*>/i))||(eventMatch=f.sURL.value.match(/ (on\\w*)=/i))){alert(gettext('To avoid security risks, \"###STR###\" cannot be embedded in the message!').replace(\"###STR###\",eventMatch[1]));f.sURL.focus();return;}if(checkWebChange()){f.webchange.value='1';} f.submit();}function uploadPic(){var filepath=f.fileUpload.value;if(filepath==\"\"){alert(gettext('Please choose an image!'));return false;}var idx=filepath.lastIndexOf(\".\");var file_format=filepath.substr(idx+1).toLowerCase();if(idx==-1||(file_format!=\"jpg\"&&file_format!=\"jpeg\"&&file_format!=\"png\")){alert(gettext('Please use an image in JPG/PNG format!'));return false;}parent.logopicHandler.document.location='/doc/usergensetHlr.htm';f.enctype=\"multipart/form-data\";f.action=\"/login_logo.cgi?sFormAuthStr=JdvKVyYlhh7GhS9\";f.submit();}function textCounter(){if(f.sURL.value.length>511)f.sURL.value=f.sURL.value.substring(0,511);}function onClkDefMess(){var defMsg=\"<h1><b><font color=red>Welcome Message</font></b></h1><p>This welcome message is displayed in the Login page of the router. Replace this text with your own message. </p><ol><li>The welcome message can be written in HTML so lists such as this one can be created </li><li>Other markup tags such as p, font or img can be used</li></ol>\";f.sURL.value=defMsg;}function preview(){loginset_preview=1;window.open(\"/weblogin.htm\",\"userlogin\",\"toolbars=no,width=800px,height=600px,top=150px,left=\"+(screen.width/2-232)+\"px,status=no,scrollbars=yes,resize=yes,menubar=no\");}</script></body></html>"
