            "compression": 1160,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/dhtml.min.js?094907\"></script></head><body class=ng-cloak><textarea id=swmgrp1init style=\"display: none;\">\n\tvar grptbl = \t[['0','Default'],['1',''],['2',''],['3',''],['4',''],['5',''],['6',''],['7',''],['8',''],['9','']];\n</textarea><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><tr><td><b parent=\"{{ 'Switch' | translate }}\" sub-title translate>Group</b><hr><form action=/cgi-bin/cgiswm.cgi method=post name=frm1><table align=center border=0 cellpadding=2 cellspacing=0 width=800><tr><td><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr style=\"background-color: #CFCFCF;\" width=100%><td align=center width=10%><b translate>Index</b></td><td align=center width=25%><b translate>Group Name</b></td><td align=center width=65%><b translate>Member Switch</b></td></tr><script> var appeinitScript=document.createElement('script');appeinitScript.text=document.getElementById(\"swmgrp1init\").value;document.head.appendChild(appeinitScript);var showstatus=''; var str='';for(i=0;i<grptbl.length;i++){str+='<tr class=row'+(i+1)%2+'><td align=center><a href=\"javascript:gotoDetailSet('+i+')\">'+(i+1)+'</a></td>';str+='<td align=center>'+grptbl[i][1]+'</td><td style=\"word-break:break-all\" width=\"65%\">';for(j=0;j<(grptbl[i].length-2);j++){if((j+4)!=grptbl[i].length){if(grptbl[i][j+3]==1)str+=' <font color=green>'+grptbl[i][j+2]+'</font>,';}else{if(grptbl[i][j+3]==1)str+='<font color=green>'+grptbl[i][j+2]+'</font>';}j++;}str+='</td></tr>';}document.write(str);if(showstatus==0){}else if(showstatus==1){alert(gettext('Processing password, please try again.'));}</script></table></td></tr></table><br><table align=center><tr><td><input name=fid type=hidden><input name=iPRIdx type=hidden></td></tr></table><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></td></tr></table><script>var bg=parent;var f=document.frm1;function gotoDetailSet(idx){f.fid.value=3;f.iPRIdx.value=idx;f.submit();}</script></body></html>"
