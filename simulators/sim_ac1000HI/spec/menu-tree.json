   },
   {
    "tag": "input",
    "type": "button",
    "name": "btnsubmit",
    "value": "Login",
    "onclick": "submitform()"
   }
  ],
  "ham_js": [
   "delCookie",
   "doLoad",
   "submitform",
   "gotoLOID"
  ],
  "logic_submitform": "Chỉ kiểm tra username khác rỗng (nếu rỗng thì alert 'Account can not be blank' và return false), KHÔNG mã hoá mật khẩu — xác nhận bằng cách liệt kê toàn bộ định danh trong thân hàm: không có btoa/md5/sha/encode/encrypt/escape/base64/hex. Mật khẩu gửi đi dạng chuỗi thường qua query string của form GET.",
  "tai_nguyen": [
   "/style.css",
   "/login.png"
  ],
  "logout": {
   "the_a": "Logout",
   "href": "/cgi-bin/logout.cgi",
   "onclick": "doLogout()"
  }
 },
