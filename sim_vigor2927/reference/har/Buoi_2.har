            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css></head><body class=ng-cloak><textarea id=kwobjinit style=display:none>\n\tvar aryKwObjName = [[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"],[\"\",\"\"]];\n</textarea><table align=center border=0 cellpadding=0 cellspacing=0 width=700><script> var wizRule=parseInt(\"0\");if(wizRule==100){var bg=opener.parent;var tp=opener.top;if(location.hash==\"#close\")self.close();}else{var bg=parent;var tp=top;}</script><tr><td><b parent=\"{{ 'Objects Setting' | translate }}\" sub-title></b><b ng-if=wizRule><translate>Keyword Object Wizard</translate>&nbsp;(1/1)</b><b ng-if=!wizRule translate>Keyword Object</b><hr><form action=/cgi-bin/kwobj.cgi method=POST name=frm1><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>Keyword Object Profiles</b>:</td><td align=right class=red>|&nbsp; <a class=DenyLink href=javascript:ruOK() translate>Set to Factory Default</a>&nbsp;|</td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 width=100%><tr align=center><td ng-if=isWiz></td><td width=10%><b translate>Index</b></td><td width=40%><b translate>Name</b></td><td ng-if=isWiz></td><td width=10%><b translate>Index</b></td><td width=40%><b translate>Name</b></td></tr><script> var kwobjinitScript=document.createElement(\"script\");kwobjinitScript.text=document.getElementById(\"kwobjinit\").value;document.head.appendChild(kwobjinitScript);var PRF_NUM=parseInt('200'); var PRF_PER_PG=32;var MAX_PG_NUM=Math.ceil(PRF_NUM/PRF_PER_PG); var pagenum=parseInt(\"1\");var idxstart=(pagenum-1)*PRF_PER_PG;var idxperpage=PRF_PER_PG;var tmp=PRF_NUM%PRF_PER_PG;var str=\"\";if(pagenum==MAX_PG_NUM&&tmp!=0){idxperpage=tmp;}var col_offset=idxperpage/2;for(var i=0;i<col_offset;i++){idx1=idxstart+i+1;idx2=idxstart+i+1+col_offset;str+=\"<tr align=center class=row\"+i%2+\">\";if(wizRule==100){str+=\"<td><input type=radio name=selwiz></td>\";str+=\"<td>\"+idx1+\"</td>\";}else{str+=\"<td><a href='javascript:gotoDetailSet(\"+idx1+\")'>\"+idx1+\".</a></td>\";}str+=\"<td title='\"+aryKwObjName[i][1]+\"'>&nbsp;\"+aryKwObjName[i][0]+\"</td>\";if(idx2>=191&&idx2<=200&&webcfg.adminauth||idx2<191){if(wizRule==100){str+=\"<td><input type=radio name=selwiz></td>\";str+=\"<td>\"+idx2+\"</td>\";}else{str+=\"<td><a href='javascript:gotoDetailSet(\"+idx2+\")'>\"+idx2+\".</a></td>\";}str+=\"<td title='\"+aryKwObjName[i+col_offset][1]+\"'>&nbsp;\"+aryKwObjName[i+col_offset][0]+\"</td>\";}str+=\"</tr>\";}document.write(str);</script></table></td></tr></table><script>str=\"\";if(MAX_PG_NUM>1){str+=\"<table align=center width=100% border=0 cellspacing=0>\";str+=\"<tr><td class=red><<&nbsp;\";for(i=1;i<=MAX_PG_NUM;i++){if(i>1)str+=\"&nbsp;|&nbsp;\";str+=\"<a href='javascript:gotoPage(\"+i+\")'>\"+((i-1)*PRF_PER_PG+1);if(i<MAX_PG_NUM)str+=\"-\"+(PRF_PER_PG*i)+\"</a>\";else str+=\"-\"+PRF_NUM+\"</a>\";}str+=\"&nbsp;>></td><td align=right class=red>\";if(pagenum>1)str+=\"<<&nbsp;<a href='javascript:gotoPage(\"+(pagenum-1)+\")'>\"+gettext(\"Back\")+\"</a>\";if((pagenum>1)&&(MAX_PG_NUM>2)&&(pagenum<MAX_PG_NUM))str+=\"&nbsp;|&nbsp;\";if(pagenum<MAX_PG_NUM)str+=\"<a href='javascript:gotoPage(\"+(pagenum+1)+\")'>\"+gettext(\"Next\")+\"</a>&nbsp;>>\";str+=\"</td></tr></table>\";document.write(str);}</script><br><table align=center border=0 cellspacing=0 ng-show=isWiz width=100%><tr><td align=center><input class=btnw name=btnOK onclick=btnok() type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp;&nbsp;&nbsp; <input class=btnw name=btnCln onclick=btncln() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table> <a href=\"/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=2075\" translate>Objects Backup/Restore</a><input name=sKwObjAct type=hidden><input name=iPageIdx type=hidden><input name=iProfileIdx type=hidden><input name=webchange type=hidden value=0><input name=iWizRule type=hidden value=0><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></td></tr></table><script>top.ACTION_STATUS=-1;top.iActionStatusFlag='0';top.iFwUpgradeState='0';tp.act_sta.damage_alert();var f=document.frm1;angular.element(document).ready(function(){if(wizRule==100)$scope.wizRule=1;else $scope.wizRule=0;$scope.$apply();initParameter();});function initParameter(){$scope.isWiz=false;if(wizRule==100){f.iWizRule.value=100;$scope.isWiz=true;}$scope.$apply();}function ruOK(){if(true==confirm(gettext('All Keyword Objects will be removed from your selected lists.\\nDo you want to do this?'))){f.sKwObjAct.value=\"settodefault\";f.webchange.value='1';f.submit();}}function gotoPage(idx){f.sKwObjAct.value=\"showpage\";f.iPageIdx.value=idx;f.submit();}function gotoDetailSet(idx){f.sKwObjAct.value=\"showitem\";f.iProfileIdx.value=idx;f.submit();}function btnok(){var itemNum=0;var itemIdx=idxstart+1;var selectIdx=-1;for(var i=0;i<f.selwiz.length;i++){if(f.selwiz[i].checked==true){itemNum=i;break;}}var t=true;for(var j=0;j<itemNum;j++){itemIdx=t?itemIdx+16:itemIdx-15;t=!t;}if(opener.parent.sMngStatusTag==\"tab1\"){selectIdx=opener.opennewidx;}else if(opener.parent.sMngStatusTag==\"tab2\"){selectIdx=opener.opennewidxv6;}if(itemIdx>=209)itemIdx-=12;if(!opener.selectKeyWdObj(itemIdx,selectIdx)){alert(gettext('Please select an Keyword Object profile which Name is not empty!'));}else{setTimeout(\"self.close()\",10);}}function btncln(){self.close();}</script></body></html>"
