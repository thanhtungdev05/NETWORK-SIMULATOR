ator password on External Device, please click the <b>Account</b> button to retype new username and password. Otherwise, the router will be unable to monitor the External Device device properly. Click the <b>Clear</b> button to Clear the off-line information and account information.</td></tr><tr><td>&nbsp;</td></tr><tr><td><b translate>Note</b>: <ol><li translate>Only one router in a network is permitted to have External Device Auto Discovery enabled.</li></ol></td></tr></table><br><table align=center><tr><td><input class=btnw name=btnOk onclick=clkOk() type=button value=\"{{ 'OK' | translate }}\"></td></tr></table><input name=fid type=hidden value=2222><input name=webchange type=hidden value=0><input name=sFormAuthStr type=hidden value=\"pU2VHFY4WAi1NkA\"></form></td></tr></table><script>top.ACTION_STATUS=-1;top.iActionStatusFlag='1';top.iFwUpgradeState='0';top.act_sta.damage_alert();var bg=parent;var f=document.frm1;var sIP,idx;var sNamePwd=JSON.parse(\"[['','','','','','','','','','','','','','','','','','','','','','','','','','','','','',''], ['','','','','','','','','','','','','','','','','','','','','','','','','','','','','','']]\".replace(/'/g,'\"'));var isCtrlextdev='1';initPage();initWebChange();var intnum=self.setInterval(\"onRefresh()\",10000);function initPage(){var model='Vigor2927';var slave_model=['2710e','2710ne','2750','2110','2130','700','800','1240','120','200'];if((model.search(/2710e/i)!=-1)||(model.search(/2710ne/i)!=-1)||(model.search(/2750/i)!=-1)||(model.search(/2110/i)!=-1)||(model.search(/2130/i)!=-1)||(model.search(/ap700/i)!=-1)||(model.search(/ap800/i)!=-1)||(model.search(/g1240/i)!=-1)||(model.search(/120/i)!=-1)||(model.search(/fly200/i)!=-1)){bg.hideElmtByClass(document,\"table\",\"auto_dect\");}if(isCtrlextdev=='0'){bg.showElmtByClass(document,\"tr\",\"secRouter\");}else{bg.hideElmtByClass(document,\"tr\",\"secRouter\");}}function encode(instr){var keyStr=\"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=\";var o