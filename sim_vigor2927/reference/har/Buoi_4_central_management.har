trolinit\").value;document.head.appendChild(acontrolinitScript);var bg=parent;var lannumber=parseInt('8');var sFormAuthStr='JdvKVyYlhh7GhS9';var opennewidx=-1;var opennewidxv6=-1;if(parseInt('0'))len=1;else len=arrLanCtrl.length;var INDEX=0,NAME=1,IPSTART=2,ENDMASK=3,ADDRTYPE=4;</script></tr><tr><td colspan=2><b parent=\"{{ 'System Maintenance' | translate }}\" qslink=\"https://www.draytek.com/router-help-redirect?stk_title=System Maintenance&nd_title=Management\" sub-title translate>Management</b><hr><table align=center border=0 cellpadding=2 cellspacing=0 width=840><tr><td class=offtab id=tab1 onClick=dhtml.cycleTab(this.id);parent.sMngStatusTag=this.id; width=33%><b><span ng-if=\"bDrayIpv6\">IPv4</span>&nbsp;<translate>Management Setup</translate></b></td><td class=offtab id=tab2 onClick=dhtml.cycleTab(this.id);parent.sMngStatusTag=this.id; style=display:none width=33%><b translate>IPv6 Management Setup</b></td><td class=offtab id=tab3 onClick=dhtml.cycleTab(this.id);parent.sMngStatusTag=this.id; style=display:none width=33%><b translate>LAN Access Setup</b></td></tr></table><div class=pagetext id=page1 style=\"width: 840px\"><table border=1 cellpadding=2 cellspacing=0 width=100%><tr><td colspan=2><translate>Router Name</translate> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; <input maxlength=39 name=sRouterName size=49 type=text value=\"DrayTek\"></td></tr><tr><td valign=top width=45%><table border=0 cellpadding=2 cellspacing=0 width=100%><tr class=autologout style=display:none><td align=left colspan=3><input  name=sDeflogoff type=checkbox value=On><translate>Default:Disable Auto-Logout</translate></td></tr><tr class=sValidatedCode style=display:none><td colspan=3><input  name=sValidatedCode type=checkbox value=On><translate>Enable Validation Code in Internet/LAN Access</translate></td></tr></table><table border=0 cellpadding=2 cellspacing=0 id=accesstbl width=100%><tr><td colspan=3><hr size=1></td></tr><tr><td colspan=3><b translate>Internet Access Control</b></td></tr><tr ng-hide=bgt2ndAdmin><td colspan=3><input  name=sRMC onClick=onCheckRMC() type=checkbox value=On><translate>Allow management from the Internet</translate></td></tr><tr ng-show=\"'1' == '1'\"><td colspan=2 style=padding-left:5px><b translate>Apply to Interface</b></td><tr><td style=padding-left:5px><div class=multiselect ng-show=\"'1' == '1'\" onblur=showCheckboxes(event) onclick=showCheckboxes(event) tabindex=0><div class=selectBox><select><option translate>Selected Interfaces</option></select><div class=overSelect></div></div><div id=checkboxes><label ng-repeat=\"accwan in accwans\"><input name={{accwan.name}} ng-checked=accwan.checked type=checkbox value=On>&nbsp;{{accwan.wan}} </label></div></div></td></tr></tr><tr ng-hide=\"bgt2ndAdmin || bRuVPN\"><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=sRMCFtp type=checkbox value=On><translate>FTP Server</translate></td></tr><tr ng-hide=bgt2ndAdmin><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=sRMCHttp type=checkbox value=On><translate>HTTP Server</translate>&nbsp;<input name=iRMCHsfrc onclick=cklRMCHttp() type=checkbox value=1><translate>Enforce HTTPS Access</translate></td></tr><tr class=https style=display:none><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input  checked name=sRMCHttps onclick=cklRMCHttps() type=checkbox value=On><translate>HTTPS Server</translate>&nbsp;<span ng-if=\"iBudgetThuis\">(<translate>Access List from the internet is required</translate>)</span></td></tr><tr ng-hide=bgt2ndAdmin><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=sRMCTelnet type=checkbox value=On><translate>Telnet Server</translate></td></tr><tr class=tr069 style=display:none><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=sRMCTr069 type=checkbox value=On><translate>TR069 Server</translate></td></tr><tr ng-hide=bgt2ndAdmin><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=sRMCSsh type=checkbox value=On><translate>SSH Server</translate></td></tr><tr class=Checksnmp style=display:none><td colspan=3>&n