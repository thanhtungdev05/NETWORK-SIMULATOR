            "compression": 15441,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><title>Configuration Restore</title><meta / charset=UTF-8><script src=\"/js/webchange.js?094907\"></script><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td valign=top><b parent=\"{{ 'System Maintenance' | translate }}\" sub-title translate>Configuration Backup</b><hr><form action=\"/cfgrest.cgi?sFormAuthStr=JdvKVyYlhh7GhS9\" enctype=multipart/form-data id=frm1 method=POST name=frm1 target=cfgSender><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td align=left><b translate>Configuration Backup / Restoration</b></td></tr></table><table align=center border=1 cellPadding=0 cellSpacing=0 width=700><tr><td valign=top><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr class=style1 style=display:none><td><b translate>Restore</b></td></tr><tr class=style2 style=display:none><td><b translate>Restoration/Backup</b></td></tr></table><table align=center border=0 cellPadding=2 cellSpacing=0 class=style1 style=display:none width=630><tr><td>&nbsp;&nbsp;<translate>Restore settings from a configuration file.</translate></td></tr><tr><td> &nbsp;&nbsp;<input checked form=frm1 name=restorefile onclick=chkrestype(0) type=radio value=0>&nbsp;<input class=file form=frm1 name=sdata size=30 type=file></td></tr><tr class=usbhide><td> &nbsp;&nbsp;<input form=frm1 name=restorefile onclick=chkrestype(1) type=radio value=1>&nbsp;<translate>USB Storage</translate>&nbsp;<input form=frm1 maxlength=160 name=sUSBfile size=40 type=text> &nbsp;<img form=frm1 onclick=usbfile() onmouseover=this.className='hand'; src=/images/new_folder.gif></td></tr><tr class=v4withID style=display:none><td><table border=0 cellpadding=2 cellspacing=0 width=100%><tr><td width=6%>&nbsp;&nbsp;<input form=frm1 name=chk_respwd ng-model=chkpwd type=checkbox value=1></td><td><translate>This file is encrypted with password</translate>:&nbsp;<input form=frm1 maxlength=23 name=sResPwd ng-disabled=!chkpwd size=20 type=password></td></tr><tr><td>&nbsp;&nbsp;<input form=frm1 name=chk_restore type=checkbox value=1></td><td translate>Restore configuration except the login password.</td></tr><tr><td>&nbsp;</td><td><b translate>Note</b>: <ol><li translate>This will work only if the selected configuration file was created from this device.</li></ol></td></tr></table></td></tr><tr class=nov4 style=display:none><td> &nbsp;&nbsp;<translate>Click Restore to upload the file.</translate></td></tr><tr><td align=left> &nbsp;&nbsp;<input class=btnw3 form=frm1 name=attach onclick=waitResponse(0) type=submit value=\"{{ 'Restore' | translate }}\"></td></tr></table><table align=center border=0 cellPadding=2 cellSpacing=0 class=style2 style=display:none width=630><tr align=left><td translate>Please use Firmware Upgrade Utility to backup or restore the router and voip module configuration simultaneously.</td></tr></table><input form=frm1 name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form><hr size=1><table align=center border=0 cellpadding=0 cellspacing=0 width=100%><tr class=style1 style=display:none><td><b translate>Backup</b></td></tr></table><form id=frmbak method=post name=frmbak><table align=center border=0 cellpadding=2 cellspacing=0 width=630><tr class=style1 style=display:none><td>&nbsp;&nbsp;<translate>Back up the current settings into a configuration file.</translate></td></tr><tr class=style2 style=display:none><td>&nbsp;&nbsp;<translate>Click Backup to just download the 3510PBX current running configuration as a file,not include the voip module.</translate></td></tr><tr class=encode_v4 style=display:none><td>&nbsp;&nbsp;<input form=frmbak name=chk_encryptcfg onclick=clkencrypt() type=checkbox value=1>&nbsp;<translate>Protect with password</translate></td></tr><tr class=encode_v4_pwd style=display:none><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<translate>Password</translate></td><td><input form=frmbak maxlength=23 name=sEncryptPwd placeholder=\"{{ 'Max: ###LEN### characters' | translate }}\" size=24 type=password></td></tr><tr><td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<translate>Confirm Password</translate></td><td><input form=frmbak maxlength=23 name=sEncryptCnfrmPwd placeholder=\"{{ 'Max: ###LEN### characters' | translate }}\" size=24 type=password></td></tr><tr><td colspan=2>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<b translate>Note</b>:<ol><li id=onlyword translate>Only ###VAL1### and ###VAL2### are allowed.</li></ol></td></tr></table></td></tr><tr><td> &nbsp;&nbsp;<input class=btnw3 form=frmbak onclick=onBackup() type=button value=\"{{ 'Backup' | translate }}\"></td></tr><tr><td id=link_note><b translate>Note</b>: <ol><li translate>The router's certificates are not part of the configuration file. Please use <a>Certificate Management &gt;&gt; Certificate Backup</a> for backup.</li></ol></td></tr></table></form><script> if(parseInt('1'))document.write(\"<hr size=1>\");</script><form action=/cgi-bin/v2x00.cgi id=frm2 method=post name=frm2><table align=center border=0 cellpadding=0 cellspacing=0 class=hideforusb width=100%><tr><td><b translate>Auto Backup to USB storage</b></td></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 class=hideforusb width=630><tr><td>&nbsp;&nbsp;<input form=frm2 name=enAutoBackup type=checkbox value=1>&nbsp;<translate>Enable</translate></td></tr><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=90%><tr><td><translate>Backup folder</translate>&nbsp;<input form=frm2 maxlength=160 name=sFolder type=text value=\"\"> &nbsp;<img form=frm2 onclick=newfolder() onmouseover=this.className='hand'; src=/images/new_folder.gif></td></tr><tr><td><input checked form=frm2 name=rdAutoBackup type=radio value=0>&nbsp;<translate>Periodic backup</translate></td></tr><tr><td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<translate>Cycle duration</translate>: <select form=frm2 name=sltAutoBackupDay onchange=sltday(this.value)><script>var str=\"\";for(var i=0;i<61;i++)str+=\"<option value='\"+i+\"'>\"+i+\"</option>\";document.write(str);</script></select>&nbsp;<translate>days and</translate><select form=frm2 name=sltAutoBackupHour><script>str=\"\";for(var i=0;i<24;i++)str+=\"<option value='\"+i+\"' \"+(i==1?\"selected\":\"\")+\">\"+i+\"</option>\";document.write(str);</script></select>&nbsp;<translate>hours</translate></td></tr><tr><td><input form=frm2 name=rdAutoBackup type=radio value=1>&nbsp;<translate>Backup after change configuration</translate></td></tr><tr align=center><td><input class=btnw form=frm2 onclick=onClkBtnOk() type=button value=\"{{ 'OK' | translate }}\"></td></tr></table></td></tr></table></td></tr></table><input form=frm2 name=iAct type=hidden value=1><input form=frm2 name=fid type=hidden value=2016><input form=frm2 name=webchange type=hidden value=0><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><script>var sModelInfo='Vigor2926 3.9.1.4, Vigor2925 3.9.3'; var aryModelInfo=new Array();function modelInfoParse(){if(sModelInfo!=\"\"){aryModelInfo=sModelInfo.split(', ');}for(var i=0;i<aryModelInfo.length;i++){aryModelInfo[i]=aryModelInfo[i].split(' ');}}modelInfoParse();</script><b translate>Note</b>: <ol><li class=aryModelInfolength style=display:none translate>When loading a configuration file from a model in the Supported Model List please note that features and functionality can vary between models so please manually verify the settings after the restoration.</li><li ng-show=bBackup2Usb translate>Auto backup to USB: if settings do not change, configuration doesn't backup.</li><li ng-show=bBackup2Usb translate>Auto backup to USB: if configuration backup multiple times in one hour, the old file will be overwritten with the same filename.</li></ol></td></tr></table><br><table border=0 cellpadding=2 cellspacing=0 class=modelinfo style=display:none width=100%><tr><td align=left><b translate>Supported Model List</b></td></tr></table><table border=1 cellpadding=2 cellspacing=0 class=modelinfo style=display:none width=100%><tr><td translate width=20%>Model</td><td translate>Firmware Version</td><script>var sPresetModel='2927';if(sPresetModel==\"2860\"||sPresetModel==\"2120\"||sPresetModel==\"2912\")document.write(\"<td width=60%>\"+gettext(\"Note\")+\"</td>\");</script></tr><script>var iRet='1';var str=\"\",modelstr=\"\",cnt=0;var arycnvrtnote=[gettext('Due to different LAN ports between Vigor2820 and Vigor2860, the function \"LAN&gt;&gt;VLAN\" will be disabled after restarting Vigor2860.The configuration of WAN2 in Vigor2820 will not be converted and applied to WAN2 in Vigor2860 if the physical mode in Vigor2820 is not Ethernet.'),gettext('Due to different LAN ports between Vigor2830 and Vigor2860, the function \"LAN&gt;&gt;VLAN\" will be disabled after restarting Vigor2860.'),gettext('Due to different LAN ports between Vigor2850 and Vigor2860, the function \"LAN&gt;&gt;VLAN\" will be disabled after restarting Vigor2860.'),gettext('The configuration of TR069 will not be converted and applied to Vigor2120.'),gettext('Due to design differences on Firewall and CSM between Vigor2910 and Vigor2912, related settings for CSM and IM/P2P of Vigor2910 will not be converted and applied to Vigor2912. The configuration of WAN2 in Vigor2910 will not be converted and applied to WAN2 in Vigor2912 if the physical mode in Vigor2910 is not Ethernet.')];var uk2850note=gettext('The configuration of WAN4 in Vigor2850 will not be converted and applied to WAN4 in Vigor2860 since the physical modes are different.');var countrycode=parseInt('71');if(aryModelInfo.length>0)showInfo();function showInfo(){modelstr=aryModelInfo[0][0];str=\"<tr><td>\"+modelstr+\"</td><td>&nbsp;\";for(var i=0;i<aryModelInfo.length;){if(modelstr==aryModelInfo[i][0]){str+=