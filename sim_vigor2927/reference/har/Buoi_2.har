bsp;</td>\";}if(aryPtRedirect[i][2]<=1){if(aryPtRedirect[i][4]==0)str+=\"<td>&nbsp;</td>\";else str+=\"<td>&nbsp;\"+aryPtRedirect[i][4]+\"</td>\";str+=\"<td>&nbsp;\"+gettext(aryPtRedirect[i][7])+\"</td><td>&nbsp;\"+aryPtRedirect[i][1]+\"</td>\";}else{port_form=parseInt(aryPtRedirect[i][4]);ip_form=parseInt(aryPtRedirect[i][1].split(\".\")[3]);range=parseInt(aryPtRedirect[i][2]);ip_to=ip_form+range-1;port_to=port_form+range-1;str+=\"<td>&nbsp;\"+aryPtRedirect[i][4]+\" - \"+port_to+\"</td>\";str+=\"<td>&nbsp;\"+gettext(aryPtRedirect[i][7])+\"</td><td>&nbsp;\"+aryPtRedirect[i][1]+\" - \"+ip_to+\"</td>\";}str+=\"<td><input type=checkbox value=1 name=selClr\"+i+\"></td>\";str+=\"</tr>\";}document.write(str);</script></table></td></tr></table><br><table align=center border=0 cellspacing=0 width=700><tr><td align=center><input class=btnw name=btnOk onclick=submitParameter() type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnCcl onclick=onClkCnl() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table><br><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"><input name=fid type=hidden><input name=iPageIdx type=hidden><input name=webchange type=hidden value=0></form><table border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><form><table width=100%><tr><td><translate>Backup settings</translate>: </td></tr><tr><td><input class=btnw id=cfgBackupBtn onclick=onBackup() type=button value=\"{{ 'Backup' | translate }}\"></td></tr></table><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></td><td><form action=\"/port_redirection.cgi?sFormAuthStr=JdvKVyYlhh7GhS9\" enctype=multipart/form-data method=post name=CfgRestoration><table width=100%><tr><td><translate>Upload From File</translate>: <input maxlength=256 name=filename size=30 type=file></td></tr><tr><td><input class=btnw3 id=cfgRestoreBtn onclick=\"return restoreCheck()\" type=submit value=\"{{ 'Restore' | translate }}\"></td></tr></table><input name=s