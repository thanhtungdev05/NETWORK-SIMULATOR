            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/dhtml.min.js?094907\"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'Objects Setting' | translate }}\" sub-title translate>SMS/Mail Service Object</b><hr><form action=/cgi-bin/sms.cgi method=post name=frm1><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><th class=ontab id=tab1 onClick=gotoPage(0) translate width=20%>SMS Provider</th><th class=offtab id=tab2 onClick=gotoPage(1) translate width=20%>Mail Server</th><td class=tabpadding>&nbsp;</td><td align=right class=red>|&nbsp; <a class=DenyLink href=# onClick=javascript:settodefault() translate>Set to Factory Default</a>&nbsp;|</td></tr></table><table border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 class=table-striped width=100%><thead><tr align=center><th translate width=10%>Index</th><th translate width=20%>Profile Name</th><th translate width=20%>SMS Provider</th></tr></thead><tbody><tr align=center ng-init=\"i=$index; provider=sms[0] != '' ? sms_serv_arr[sms[1]] : ''\" ng-repeat=\"sms in arySMS track by $index\"><td> <a href=# ng-click=gotoDetailSet(i+1)>{{i+1}}.</a></td><td ng-if=\"i > 7\"><translate>Custom</translate> {{i - 7}}</td><td ng-if=\"i <= 7\">{{sms[0]}}</td><td ng-if=\"i < 8\"><span ng-if=\"sms[1] == 254\"><translate>Local SMS Service</translate> ({{sLTEmodulename}})</span><span ng-if=\"sms[1] == 253\"><translate>Vigor Router SMS Gateway</translate> ({{sLTEmodulename}})</span><span ng-if=\"sms[1] != 253 && sms[1] != 254\">{{provider}}</span></td><td ng-if=\"i >= 8\">{{sms[1]}}</td></tr></tbody></table></td></tr></table><br> <a href=\"/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=2075\" 