            "size": 21295,
            "mimeType": "text/html",
            "compression": 15481,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700px><tr><td><b parent=\"{{ 'Diagnostics' | translate }}\" sub-title></b><b ng-if=iLanSecMon translate>LAN Security Monitor</b><b ng-if=!iLanSecMon translate>Data Flow Monitor</b><hr><form action=/cgi-bin/v2x00.cgi method=post name=frm1><table align=center border=0 cellpadding=2 cellspacing=0 width=700><tr><td colspan=3><input name=sDataFlowEnable onclick=onDataFlowEnable() type=checkbox value=1>&nbsp;<b><script> if('(nil)'!='(nil)')document.write(gettext(\"LAN Security Monitor\"));else document.write(gettext(\"Enable Data Flow Monitor\"));</script></b></td></tr><tr><td align=right><translate>Refresh Seconds</translate>:&nbsp;<select name=sltTime onChange=onChgTime() size=1><option value=10000>10</option><option value=15000>15</option><option value=30000>30</option><option value=1800000>1800</option></select>&nbsp; <translate>Page</translate>:&nbsp;<select name=sltPage onChange=onChgPage()></select></td><td align=right class=red> |&nbsp; <a href=\"javascript: onRefresh()\" translate>Refresh</a>&nbsp;|</td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><div id=divData></div></td></tr></table><div><b translate>Note</b>: <ol><li translate>Click \"Block\" to prevent specified PC from surfing Internet for 5 minutes.</li><li translate>The IP blocked by the router will be shown in red, and the session column will display the remaining time that the specified IP will be blocked.</li><li ng-if=\"bHWProto && iHwAccIpNode\" translate>When Date Flow Monitor is enabled, Hardware Acceleration will not work.</li><li translate>(Kbps): shared bandwidth<br>+ : residual bandwidth used<br>Current/Peak are average.</li><li>1 <translate>Kbps</translate>=1,000 <translate>bps</translate></li></ol></div><br><input name=fid type=hidden value=307><input name=sCgiOption type=hidden value=0><input name=sBandwEnable type=hidden value=0><input name=sSessnEnable type=hidden value=0><input name=sBlockIpOpt type=hidden><input name=sBlockIpAddr type=hidden><input name=sChartIpAddr type=hidden><input name=sQosIpAddr type=hidden><input name=iQosCls type=hidden><input name=webchange type=hidden value=0><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></td></tr></table><textarea id=digdataminit style=display:none>\nvar aryBWANEnable = [1,1,0,0,1,1];\nconst bHWProto = parseInt('1'),\n\tiHwAccIpNode = '1' == 0;\nvar iLanSecMon = '(nil)' != '(nil)';\n</textarea><script>top.ACTION_STATUS=-1;top.iActionStatusFlag='-2';top.iFwUpgradeState='0';top.act_sta.damage_alert();var digdataminitscript=document.createElement(\"script\");digdataminitscript.text=document.getElementById(\"digdataminit\").value;document.head.appendChild(digdataminitscript);var bg=parent;var f=document.frm1;var sIpBandwDefTx='32770';var sIpSsnDefault='100';var iIpSsnBlkTm='##%% timer must input num!##Current session timer setting is 300'; var WAN_NUM=parseInt(\"6\");var iFixWanNum=parseInt(\"4\");var iUSBNum=parseInt(\"2\");var iSecUsbNum=parseInt(\"1\");var DualDslEnable=parseInt(\"0\");var bDualDSL=parseInt('0');var extra_vdsl_idx=iFixWanNum+iUSBNum;var idx_2nd_usb=iFixWanNum+iUSBNum-iSecUsbNum;var NUM_PER_PAGE=15;var iFlgIpBaEnable=false;var iFlgIpSeEnable=false;var iFlgAvCntEnable;var aryIpBa=new Array();var aryIpSe=new Array();var aryQosIpCls=new Array();var aryAvCnt=new Array();var aryData=new Array();var sPresetModel='2927';if(((sPresetModel=='2132')&&!parseInt('0')))var WAN_NUM=1;if(('(nil)'&0x00000001)==1){var aryIdArr=[\"arr0\",\"arr1\",\"arr2\",\"arr3\",\"arr4\",\"arr5\"];}else{var aryIdArr=[\"arr0\",\"arr1\",\"arr2\",\"arr3\"];}var sIpBa='####  IP bandwidth limit is not enable##';var sIpSe='####  IP session limit is not enable##';var iAppQosShow='####  APP QoS Status:##';var sAvaiCnt='##% Command missing, Valid commands are:##csm           ddns          dos           exit          internet      ip            ##ipf           log           ldap          tacacsplus    mngt          msubnet       ##object        port          portmaptime   ppa           hwaccswap     prn           ##qos           hwqos         quit          show          smb           srv           ##switch        sys           testmail      fs            upnp          usb           ##vigbrg        fullbrg       vlan          vpn           wan           hsportal      ##radius        local_8021x   wol           user          appqos        nand          ##apm           sfp           ethoam        ha            swm           fw_backupmode ##cert          service       dmn           ##';var sShowSe='##% Maximum Session Number: 60000##% Maximum Session Usage: 0##% Current Session Usage: 0##% Current Session Used(include waiting for free): 0##% WAN1 Current Session Usage: 0##% WAN2 Current Session Usage: 0##% WAN3 Current Session Usage: 0##% WAN4 Current Session Usage: 0##% WAN5 Current Session Usage: 0##% WAN6 Current Session Usage: 0##';var strWanInfo=\"\";var iTotalSeCurr;var iTotalSePeak;var bNewWLWAN=parseInt('1');var bWless=parseInt('0');var bDualWless5G=parseInt('0');var sLTEmodulename='LTE';if(!bNewWLWAN){var wan3mode=(parseInt('0')?gettext(sLTEmodulename):gettext(\"WAN\")+\"3\");var wan5mode=gettext(\"WAN\")+\"5\";}else if(bNewWLWAN){var wan5mode=(parseInt('0')?gettext(sLTEmodulename):gettext(\"WAN\")+\"5\");var wan3mode=gettext(\"WAN\")+\"3\";}var aryWanInfo=[[gettext(\"WAN\")+\"1\",'---','0','0','0','0','0','0',\"---\",'135172'],[gettext(\"WAN\")+\"2\",'---','0','0','0','0','0','0',\"---\",'135172'],[wan3mode,'---','0','0','0','0','0','0',\"---\",'134352900'],[gettext(\"WAN\")+\"4\",'---','0','0','0','0','0','0',\"---\",'134352900'],[wan5mode,'---','0','0','0','0','0','0',\"---\",'135168'],[gettext(\"WAN\")+\"6\",'---','0','0','0','0','0','0',\"---\",'135168'],[gettext(\"Total\"),\"\",0,0,0,0,0,0,\"\",0]];var isDataFlowMonOn='0';var sIpBandwFlag='8192'; angular.element(document).ready(function(){$scope.iLanSecMon=iLanSecMon;$scope.$apply();initParameter();initWebChange();});function initParameter(){$scope.bHWProto=bHWProto;$scope.iHwAccIpNode=iHwAccIpNode;$scope.$apply();bg.setVle2Elmt(f.sltTime,bg.iDigDatRefTime,0);if(('(nil)'&0x00000001)==1){iFlgAvCntEnable=parseAvCnt();}iIpSsnBlkTm=iIpSsnBlkTm.split(\"Current session timer setting is \")[1];if(isDataFlowMonOn==\"1\"){bg.setVle2Elmt(f.sDataFlowEnable,'1',0);iFlgIpBaEnable=parseIpBa();iFlgIpSeEnable=parseIpSe();}else if(isDataFlowMonOn==\"0\"){bg.setVle2Elmt(f.sDataFlowEnable,'0',0);}else{throw new RangeError(\"isDataFlowMonOn is 0 or 1\");}parseShowSe();parseQosIpCls();if(iFlgIpBaEnable&&iFlgIpSeEnable){initAryData();}initSltPage(); onChgOder(bg.iDigDatSortKey);onChgTime();}function parseIpBa(){var idx,i,j,aryTemp,strTmp; if(sIpBa.search(/not enable/)!=-1||sIpBa.search(/Valid subcommands/)!=-1){ return false;}aryTemp=sIpBa.replace(/ |\\(|\\)/g,\"\").match(/\\d+.\\d+.\\d+.\\d+[\\w-]*:TX\\d+(\\/\\d+){0,1}RX\\d+(\\/\\d+){0,1}(\\w+|---|)/g);angular.forEach(aryTemp,function(item,i){aryIpBa[i]=new Array();let reg;if((sIpBandwFlag>>0)&0x01)reg=/(\\d+.\\d+.\\d+.\\d+[\\w-]*):TX(\\d+\\/\\d+)RX(\\d+\\/\\d+)(\\w+|---|)/;else reg=/(\\d+.\\d+.\\d+.\\d+[\\w-]*):TX(\\d+)RX(\\d+)(\\w+|---|)/;strTmp=item.match(reg);if(strTmp){strTmp.shift();aryIpBa[i]=[strTmp[0],strTmp[1],strTmp[2],strTmp[3]==\"shared\"];}});return true;}function parseIpSe(){var idx,i,j,aryTemp,strTmp; if(sIpSe.search(/not enable/)!=-1||sIpSe.search(/Valid subcommands/)!=-1){ return false;}sIpSe=sIpSe.replace(/####  IP session usage status:##/,\"\");sIpSe=sIpSe.replace(/#{1,}/g,\"#\");sIpSe=sIpSe.replace(/\\s{1,}/g,\" \");sIpSe=sIpSe.replace(/\\(/g,\"\");sIpSe=sIpSe.replace(/\\)/g,\"\");aryTemp=sIpSe.split(\"#\");for(i=1,j=0;i<aryTemp.length;i++,j++){ strTmp=aryTemp[i].split(\": \");if(strTmp[1]){aryIpSe[j]=new Array();aryIpSe[j]=([strTmp[0],strTmp[1]]);}}return true;}function parseQosIpCls(){var idx,i,j,aryTemp,strTmp;if(iAppQosShow=='####  APP QoS Status:##')return false;iAppQosShow=iAppQosShow.replace(/####  APP QoS Status:##/,\"\");iAppQosShow=iAppQosShow.replace(/#{1,}/g,\"#\");iAppQosShow=iAppQosShow.replace(/\\s{1,}/g,\" \");iAppQosShow=iAppQosShow.replace(/QoS/g,\"\");iAppQosShow=iAppQosShow.replace(/\\(/g,\"\");iAppQosShow=iAppQosShow.replace(/\\)/g,\"\");aryTemp=iAppQosShow.split(\"#\");for(i=1,j=0;i<aryTemp.length;i++,j++){strTmp=aryTemp[i].split(\": \");if(strTmp[1]>=0){aryQosIpCls[j]=new Array();aryQosIpCls[j]=([strTmp[0],strTmp[1]]);}}return true;}function parseShowSe(){var single_wan=0;sShowSe=sShowSe.replace(/##%\\sMaximum\\sSession\\sNumber:\\s/,\"\");sShowSe=sShowSe.replace(/%\\sMaximum\\sSession\\sUsage:\\s/,\"\");sShowSe=sShowSe.replace(/%\\sCurrent\\sSession\\sUsage:\\s/,\"\");sShowSe=sShowSe.replace(/%\\sWAN1\\sCurrent\\sSession\\sUsage:\\s/,\"\");sShowSe=sShowSe.replace(/%\\sWAN2\\sCurrent\\sSession\\sUsage:\\s/,\"\");sShowSe=sShowSe.replace(/%\\sWAN3\\sCurrent\\sSession\\sUsage:\\s/,\"\");sShowSe=sShowSe.replace(/%\\sWAN4\\sCurrent\\sSession\\sUsage:\\s/,\"\");sShowSe=sShowSe.replace(/%\\sWAN5\\sCurrent\\sSession\\sUsage:\\s/,\"\");sShowSe=sShowSe.replace(/%\\sWAN6\\sCurrent\\sSession\\sUsage:\\s/,\"\");sShowSe=sShowSe.split(\"##\");iTotalSeCurr=sShowSe[2];iTotalSePeak=sShowSe[1];aryWanInfo[WAN_NUM]=[gettext(\"Total\"),\"\",0,0,0,0,0,0,\"\",0];aryWanInfo[WAN_NUM][8]=iTotalSeCurr+\" / \"+iTotalSePeak;if((parseInt('0')&&WAN_NUM==2)||(sPresetModel=='2760')){ aryWanInfo[WAN_NUM][0]=gettext(\"WAN\");single_wan=1;}var str=\"\";str+=\"<tr align=center><td></td>\";str+=\"<td></td>\";str+=\"<td><b>\"+gettext(\"Current\")+\" / \"+gettext(\"Peak\")+\" / \"+gettext(\"Speed\")+\"</b></td>\";str+=\"<td><b>\"+gettext(\"Current\")+\" / \"+gettext(\"Peak\")+\" / \"+gettext(\"Speed\")+\"</b></td>\";str+=\"<td><b>\"+gettext(\"Current\")+\" / \"+gettext(\"Peak\")+\"</b></td></tr>\";for(var i=0;i<=WAN_NUM&&i<aryWanInfo.length;i++){if(top.notSupportWAN.indexOf(i)!=-1)continue;if(!aryBWANEnable[i])continue;if((bDualDSL&&extra_vdsl_idx==i&&DualDslEnable!=\"1\")||(iUSBNum==2&&iSecUsbNum==0&&idx_2nd_usb==(i+1)&&!parseInt('0')))continue;if((i==1||i==3)&&((sPresetModel=='2132'&&parseInt('0'))||sPresetModel=='2133'||sPresetModel=='2135')&&(i!=WAN_NUM))continue;if(bNewWLWAN&&(i==2||i==3)&&!bWless&&!bDualWless5G)continue;else if(bNewWLWAN&&i==3&&!bDualWless5G)continue;if(i!=WAN_NUM)aryWanInfo[i][8]=sShowSe[i+4]; if((i<WAN_NUM)&&(aryWanInfo[i][9]>>17)&0x01){aryWanInfo[i][4]=gettext(\"Auto\");aryWanInfo[i][7]=gettext(\"Auto\");}else{ aryWanInfo[i][4]=bg.ratebwithUnit(aryWanInfo[i][4]*1000);aryWanInfo[i][7]=bg.ratebwithUnit(aryWanInfo[i][7]*1000);}if(i<WAN_NUM){ aryWanInfo[i][2]=bg.rateB2b(aryWanInfo[i][2]);aryWanInfo[i][3]=bg.rateB2b(aryWanInfo[i][3]);aryWanInfo[i][5]=bg.rateB2b(aryWanInfo[i][5]);aryWanInfo[i][6]=bg.rateB2b(aryWanInfo[i][6]);}if(single_wan==0||i==WAN_NUM){ str+='<tr align=center class=\"row'+(single_wan==0?0:i%2)+'\">';str+=\"<td><b>\"+aryWanInfo[i][0]+\"</b></td>\";str+=\"<td>\"+aryWanInfo[i][1]+\"</td>\";str+=\"<td>\"+aryWanInfo[i][2];str+=\" / \"+aryWanInfo[i][3];str+=\" / \"+aryWanInfo[i][4]+\"</td>\";str+=\"<td>\"+aryWanInfo[i][5];str+=\" / \"+aryWanInfo[i][6];str+=\" / \"+aryWanInfo[i][7]+\"</td>\";str+=\"<td>\"+aryWanInfo[i][8]+\"</td>\";str+=\"<td></td><td></td></tr>\";}for(var j=2;j<8;j++){if(aryWanInfo[i][j]==gettext(\"Auto\")){aryWanInfo[WAN_NUM][j]=gettext(\"Auto\");}else{aryWanInfo[WAN_NUM][j]+=parseInt(aryWanInfo[i][j]);}}}strWanInfo=str;}function parseAvCnt(){var idx,i,j,aryTemp,strTmp;idx=sAvaiCnt.search(/not enable/);if(idx!=-1){ return false;}sAvaiCnt=sAvaiCnt.replace(/##----------------> attack_monitor_status/,\"\");sAvaiCnt=sAvaiCnt.replace(/#{1,}/g,\"#\");sAvaiCnt=sAvaiCnt.replace(/\\s{1,}/g,\" \");sAvaiCnt=sAvaiCnt.replace(/\\(/g,\"\");sAvaiCnt=sAvaiCnt.replace(/\\)/g,\"\");aryTemp=sAvaiCnt.split(\"#\");for(i=1,j=0;i<aryTemp.length;i++,j++){ strTmp=aryTemp[i].split(\": AI\");if(strTmp[1]){strTmp[1]=strTmp[1].split(\" AV\");aryAvCnt[j]=new Array();aryAvCnt[j]=([strTmp[0],strTmp[1][0],strTmp[1][1]]);}}return true;}function initAryData(){var i,j,k;var flag=0;var aryTmp=new Array();for(i=0,k=0;i<aryIpBa.length;i++){flag=0;for(j=0;j<aryIpSe.length;j++){if(aryIpBa[i][0]==aryIpSe[j][0]){flag=1;aryData[k]=([aryIpBa[i][0],aryIpBa[i][1],aryIpBa[i][2],aryIpSe[j][1],aryIpBa[i][3]]);k++;break;}}if(flag==0){aryData[k]=([aryIpBa[i][0],aryIpBa[i][1],aryIpBa[i][2],\"---\",aryIpBa[i][3]]);k++;}}for(i=0;i<aryIpSe.length;i++){flag=0;for(j=0;j<aryIpBa.length;j++){if(aryIpSe[i][0]==aryIpBa[j][0]){flag=1;break;}}if(flag==0){aryData[k]=([aryIpSe[i][0],\"---\",\"---\",aryIpSe[i][1]]);k++;}}if(('(nil)'&0x00000001)==1){aryTmp=aryData;for(i=0,k=0;i<aryTmp.length;i++){flag=0;for(j=0;j<aryAvCnt.length;j++){if(aryTmp[i][0]==aryAvCnt[j][0]){flag=1;aryData[k]=([aryTmp[i][0],aryTmp[i][1],aryTmp[i][2],aryTmp[i][3],aryAvCnt[j][1],aryAvCnt[j][2]]);k++;break;}}if(flag==0){aryData[k]=([aryTmp[i][0],aryTmp[i][1],aryTmp[i][2],aryTmp[i][3],\"---\",\"---\"]);k++;}}for(i=0;i<aryAvCnt.length;i++){flag=0;for(j=0;j<aryTmp.length;j++){if(aryAvCnt[i][0]==aryTmp[j][0]){flag=1;break;}}if(flag==0){aryData[k]=([aryAvCnt[i][0],\"---\",\"---\",\"---\",aryAvCnt[i][1],aryAvCnt[i][2]]);k++;}}}QosClsDataMer();}function QosClsDataMer(){var i,j,k;var flag=0;var aryTmp=new Array();if(('(nil)'&0x00000001)==1){aryTmp=aryData;for(i=0,k=0;i<aryTmp.length;i++){flag=0;for(j=0;j<aryQosIpCls.length;j++){if(aryTmp[i][0]==aryQosIpCls[j][0]){flag=1;aryData[k]=([aryTmp[i][0],aryTmp[i][1],aryTmp[i][2],aryTmp[i][3],aryTmp[i][4],aryTmp[i][5],aryQosIpCls[j][1]]);k++;break;}}if(flag==0){aryData[k]=([aryTmp[i][0],aryTmp[i][1],aryTmp[i][2],aryTmp[i][3],aryTmp[i][4],aryTmp[i][5],0]);k++;}}for(i=0;i<aryQosIpCls.length;i++){flag=0;for(j=0;j<aryTmp.length;j++){if(aryQosIpCls[i][0]==aryTmp[j][0]){flag=1;break;}}if(flag==0){aryData[k]=([aryQosIpCls[i][0],\"---\",\"---\",\"---\",\"---\",\"---\",aryQosIpCls[i][1]]);k++;}}}else{aryTmp=aryData;for(i=0,k=0;i<aryTmp.length;i++){flag=0;for(j=0;j<aryQosIpCls.length;j++){if(aryTmp[i][0]==aryQosIpCls[j][0]){flag=1;aryData[k]=([aryTmp[i][0],aryTmp[i][1],aryTmp[i][2],aryTmp[i][3],aryQosIpCls[j][1],aryTmp[i][4]]);k++;break;}}if(flag==0){aryData[k]=([aryTmp[i][0],aryTmp[i][1],aryTmp[i][2],aryTmp[i][3],0,aryTmp[i][4]]);k++;}}for(i=0;i<aryQosIpCls.length;i++){flag=0;for(j=0;j<aryTmp.length;j++){if(aryQosIpCls[i][0]==aryTmp[j][0]){flag=1;break;}}if(flag==0){aryData[k]=([aryQosIpCls[i][0],\"---\",\"---\",\"---\",aryQosIpCls[i][1]]);k++;}}}}function initSltPage(){var per=NUM_PER_PAGE;var tmp=aryData.length/per;var maxpage=Math.floor(tmp);if((maxpage!=tmp)||(maxpage==0)){maxpage=maxpage+1;}for(i=0;i<f.sltPage.options.length;){f.sltPage.options[i]=null;}for(i=0;i<maxpage;i++){ii=i+1;f.sltPage.options[i]=new Option(ii,ii);}bg.setVle2Elmt(f.sltPage,bg.iDigDatPageNum,0);}function showData(_pagenum){var j;var pagenum=_pagenum;var per=NUM_PER_PAGE;var startidx=per*(pagenum-1);var endidx=per*pagenum;var str=onClear();for(var i=startidx;i<endidx;i++){if(i<aryData.length){if(('(nil)'&0x00000001)==1){if(aryData[i][3].search(/blocked/)==1||aryData[i][3].search(/A_blocked/)==1||aryData[i][4].search(/Blocked/)==0||aryData[i][5].search(/Blocked/)==0){str+=\"<tr align=center class=redrow\"+i%2+\">\";}else{str+=\"<tr align=center class=row\"+i%2+\">\";}}else{if(aryData[i][3].search(/blocked/)==1||aryData[i][3].search(/A_blocked/)==1){str+=\"<tr align=center class=redrow\"+i%2+\">\";}else{str+=\"<tr align=center class=row\"+i%2+\">\";}}str+=\"<td>\"+(i+1)+\"</td>\";if(bg.SHOW_DIG_DATAMIP)str+=\"<td align=left><a href=\\\"javascript: ShowChart('\"+aryData[i][0]+\"')\\\">\"+aryData[i][0]+\"</a></td>\";else str+=\"<td>\"+aryData[i][0]+\"</td>\";if(aryData[i][1]!='---'){str+=\"<td>\"+bg.formatIpBa(aryData[i][1