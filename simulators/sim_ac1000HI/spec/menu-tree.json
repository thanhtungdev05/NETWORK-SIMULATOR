  "cay_frame": {
   "frameset_ngoai": {
    "rows": "159,*",
    "framespacing": "0",
    "frameborder": "0"
   },
   "frame_header": {
    "name": "header",
    "src": "/cgi-bin/status.asp",
    "ghi_chu": "thanh trên: logo + 6 tab + nút Logout"
   },
   "frameset_giua": {
    "cols": "*,956,*,0",
    "framespacing": "0",
    "frameborder": "0"
   },
   "frame_blank_trai": {
    "name": "blank",
    "src": "/cgi-bin/blank.asp"
   },
   "frameset_trong": {
    "cols": "266.5,*",
    "framespacing": "0",
    "frameborder": "0"
   },
   "frame_nav": {
    "name": "nav",
    "src": "/cgi-bin/navigation-status.asp",
    "ghi_chu": "menu dọc bên trái, ĐỔI FILE theo tab đang chọn"
   },
   "frame_main": {
    "name": "main",
    "src": "/cgi-bin/status_deviceinfo.asp",
    "ghi_chu": "vùng nội dung chính"
   },
   "frame_blank_phai": {
    "name": "blank",
    "src": "/cgi-bin/blank.asp"
   },
   "frame_refresh": {
    "name": "refreshfrm",
    "src": "/cgi-bin/refresh.asp",
    "ghi_chu": "frame ẩn (cột rộng 0) dùng để làm tươi dữ liệu"
   }
  },
  "ghi_chu_quan_trong": "Bề rộng vùng nội dung CỐ ĐỊNH 956px (cols=\"*,956,*,0\"), hai bên là frame blank co giãn. Menu trái cố định 266.5px. Đây là bố cục cứng, KHÔNG responsive — trên điện thoại thiết bị thật hiển thị y hệt máy tính, chỉ bị thu nhỏ/cuộn ngang."
 },
 "dang_nhap": {
  "trang": "/cgi-bin/login.asp",
  "form": {
   "name": "configform",
   "method": "get",
   "action": "/cgi-bin/login.asp"
  },
  "truong": [
