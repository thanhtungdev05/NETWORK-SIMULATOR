            "mimeType": "text/html",
            "compression": 3054,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/dhtml.min.js?094907\"></script><script src=\"/js/webchange.js?094907\"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=780><tr><td><b parent=\"{{ 'System Maintenance' | translate }}\" sub-title translate>Dashboard Control</b><hr><form action=/cgi-bin/v2x00.cgi method=post name=form1><table align=center border=1 cellspacing=0 width=780><tr><td><br><table align=center border=0 cellpadding=2 cellspacing=0 width=94%><tr><td><input name=FrontPanelEn type=checkbox value=1><translate>Front Panel</translate></td></tr><tr><td><input name=SysInfoEn type=checkbox value=1><translate>System Information</translate></td></tr><tr><td><input name=LanInfoEn type=checkbox value=1><translate>IPv4 LAN Information</translate></td></tr><tr ng-show=adminauth><td><input name=Ipv4InterEn type=checkbox value=1><translate>IPv4 Internet Access</translate></td></tr><tr ng-show=adminauth><td><input name=Ipv6InterEn type=checkbox value=1><translate>IPv6 Internet Access</translate></td></tr><tr><td><input name=IfEn type=checkbox value=1><translate>Interface</translate></td></tr><tr><td><input name=SecurityEn type=checkbox value=1><translate>Security</translate></td></tr><tr class=voipstatus><td><input name=VoIPEn type=checkbox value=1><translate>VoIP</translate></td></tr><tr><td><input name=SysResourceEn type=checkbox value=1><translate>System Resource</translate></td></tr><tr class=ltestatus><td><input name=LteStatusEn type=checkbox value=1>LTE Status</td></tr><tr><td><input name=QuickAccEn type=checkbox value=1><translate>Quick Access</translate></td></tr></table><br></td></tr></table><br><table align=center width=100%><tr align=center><td><input class=btnw name=btnOk type=submit value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnCcl onclick=onClkBtnCcl() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table><input name=iAct type=hidden value=1><input name=fid type=hidden value=2074><input name=webchange type=hidden value=0><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form><script> top.ACTION_STATUS=-1;top.iActionStatusFlag='1';top.iFwUpgradeState='0';top.act_sta.damage_alert();var f=document.form1;var bg=parent;var sysdashtxt='##  Front Panel enabled##  System Information enabled##  IPv4 LAN Information enabled##  IPv4 Internet Access enabled##  IPv6 Internet Access enabled##  Interface enabled##  Security enabled##  System Resource enabled##  LTE Status enabled##  Quick Access enabled##  VoIP enabled'; angular.element(document).ready(function(){initParameter();initWebChange();});function initParameter(){$scope.adminauth=webcfg.adminauth;$scope.$apply();var arySysdash=sysdashtxt.split(\"##\");var pos,iEn,sName,len,i;var aryDashCtl=new Array();for(i=0;i<arySysdash.length;i++){len=arySysdash[i].length;if(len<12)continue;pos=arySysdash[i].lastIndexOf(\" \");sName=arySysdash[i].substr(0,pos).replace(/(^\\s*)|(\\s*$)/g,\"\");iEn=arySysdash[i].substr(pos+1,len-pos-1);aryDashCtl.push([sName,iEn==\"enabled\"?1:0]);}for(i=0;i<aryDashCtl.length;i++){switch(aryDashCtl[i][0]){case\"Front Panel\": bg.setVle2Elmt(f.FrontPanelEn,1,0);break;case\"System Information\": bg.setVle2Elmt(f.SysInfoEn,1,0);break;case\"IPv4 LAN Information\":bg.setVle2Elmt(f.LanInfoEn,aryDashCtl[i][1],0);break;case\"IPv4 Internet Access\":bg.setVle2Elmt(f.Ipv4InterEn,aryDashCtl[i][1],0);break;case\"IPv6 Internet Access\":bg.setVle2Elmt(f.Ipv6InterEn,aryDashCtl[i][1],0);break;case\"Interface\":bg.setVle2Elmt(f.IfEn,aryDashCtl[i][1],0);break;case\"Security\":bg.setVle2Elmt(f.SecurityEn,aryDashCtl[i][1],0);break;case\"VoIP\":bg.setVle2Elmt(f.VoIPEn,aryDashCtl[i][1],0);break;case\"System Resource\":bg.setVle2Elmt(f.SysResourceEn,aryDashCtl[i][1],0);break;case\"LTE Status\":bg.setVle2Elmt(f.LteStatusEn,aryDashCtl[i][1],0);break;case\"5G-NR Status\":bg.setVle2Elmt(f.LteStatusEn,aryDashCtl[i][1],0);break;case\"Quick Access\":bg.setVle2Elmt(f.QuickAccEn,aryDashCtl[i][1],0);break;}}bg.cpntCtrl(false,f,f.FrontPanelEn,2);if(!parseInt('0'))bg.hideElmtByClass(document,\"tr\",\"ltestatus\");if((parseInt('0'))&&bg.SHOW_VOIP&&!((parseInt('1'))&&('1'=='1'))){bg.showElmtByClass(document,\"tr\",\"voipstatus\");}else{bg.hideElmtByClass(document,\"tr\",\"voipstatus\");}}function onClkBtnCcl(){document.location=\"/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=2074\";}</script></body></html>"
