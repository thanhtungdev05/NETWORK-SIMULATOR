            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script><style>\n\t\t.text-indent {\n\t\t\ttext-indent: 20px;\n\t\t}\n\t</style></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700px><script> var sPresetModel='2927';</script><tr><td><b translate>Hardware Acceleration</b><hr><form action=/cgi-bin/ipnat.cgi method=post name=frm1><table align=center cellpadding=2 cellspacing=0 id=okretry width=700px><tbody><tr class=genmodel><td width=10%><b><translate>Mode</translate>:&nbsp;</b></td><td><select id=iHwSetFlag name=iHwSetFlag onchange=onChangeType()><option translate value=0>Disabled</option><option translate value=1>Auto</option><option ng-selected=\"isNATChecked && isEnableAcc\" ng-show=isSupPPASpecificHost translate value=2>Manual</option></select></td></tr></tbody><tbody ng-show=isSupGRX500><tr><td width=10%><b><translate>Acceleration</translate>:&nbsp;</b></td><td><select id=iHwAccSwitch name=iHwAccSwitch onchange=onChgMode()><option translate value=0>Disable</option><option translate value=1>Enable</option></select></td></tr><tr id=opmode ng-show=isSupBridgeMode><td width=20%><b><translate>Operation Mode</translate>:&nbsp;</b></td><td><select id=iOpMode name=iOpMode ng-disabled=!isEnableAcc onchange=onChgOpMode()><option translate value=0>Router</option><option translate value=1>Bridge</option></select></td></tr><tr><td colspan=2></td></tr><tr ng-show=isRouterMode><td colspan=2><input name=enNAT ng-disabled=!isEnableAcc ng-model=isNATChecked type=checkbox value=1>&nbsp;<translate>NAT</translate></td></tr><tr ng-show=isRouterMode><td><span style=\"margin-right: 35px\"></span><translate>Protocol</translate>:</td><td><span><input name=iNATTcp ng-disabled=\"!isEnableAcc || !isNATChecked\" ng-model=isNATTcpChecked type=checkbox value=1>&nbsp;<translate>TCP</translate></span><span><input name=iNATUdp ng-disabled=\"!isEnableAcc || !isNATChecked\" ng-model=isNATUdpChecked type=checkbox value=1>&nbsp;<translate>UDP</translate></span></td></tr><tr ng-show=\"isRouterMode && isSupWirelessAcc\"><td><span style=\"margin-right: 35px\"></span><translate>Option</translate>:</td><td><span><input name=iNATWlan ng-disabled=\"!isEnableAcc || !isNATChecked\" type=checkbox value=1>&nbsp;<translate>Wireless LAN Client</translate></span></td></tr><tr ng-show=\"isRouterMode && isSup5GWANAcc\"><td><span style=\"margin-right: 35px\"></span></td><td><span><input name=iNAT5GWAN ng-disabled=\"!isEnableAcc || !isNATChecked\" type=checkbox value=1>&nbsp;<translate>5G WAN</translate></span></td></tr><tr><td colspan=2></td></tr><tr ng-show=\"isRouterMode && isSupIPSecAcc\"><td colspan=2><input name=enRouterIPsec ng-disabled=!isEnableAcc ng-model=isIPsecChecked type=checkbox value=1>&nbsp;<translate>IPsec</translate></td></tr><tr ng-show=\"isRouterMode && isSupIPSecAcc\"><td><span style=\"margin-right: 35px\"></span><translate>Protocol</translate>:</td><td><span><input name=iIPsecTcp ng-disabled=\"!isEnableAcc || !isIPsecChecked\" type=checkbox value=1>&nbsp;<translate>TCP</translate></span><span><input name=iIPsecUdp ng-disabled=\"!isEnableAcc || !isIPsecChecked\" type=checkbox value=1>&nbsp;<translate>UDP</translate></span></td></tr></tbody><tr ng-show=\"isSupPPASpecificHost && TypeEr\"><td><translate>Protocol</translate>:</td><td><label><input name=iTcp ng-model=isNATTcpChecked type=checkbox value=1>&nbsp;<translate>TCP</translate></label><label><input name=iUdp ng-model=isNATUdpChecked type=checkbox value=1>&nbsp;<translate>UDP</translate></label></td></tr><tr ng-show=isSupHwExpList><td colspan=2><input name=expList ng-disabled=!isEnableAcc ng-model=isExpListChecked type=checkbox value=1>&nbsp;<translate>Exception List</translate></td></tr><tr ng-show=isSupHwExpList><td colspan=2><div style=\"margin-left: 35px; border: 2px solid black; width: calc(100% - 35px); height: 400px;\"><table style=\"width: calc(100% - 70px); height: calc(100% - 20px); margin: 35px; margin-top: 10px; margin-bottom: 10px;\"><tr><td style=\"width: 200px;\"><translate translate-params-num=\"128\">Max. {{num}} entries</translate></td><td style=\"text-align: right;\"><font color=red>|&nbsp;</font> <a href=# onclick=expRefresh() translate>Refresh</a><font color=red>&nbsp;|</font></td></tr><tr><td colspan=2><div style=\"overflow-y: scroll; display: block; width: 100%; height: 200px; border: 1px solid black;\"><table style=\"width: 100%; line-height: auto; border-collapse: collapse;\"><thead><tr><th translate>Index</th><th translate>MAC Address</th><th translate>NAT</th><th ng-if=\"showWirelessAccExp && isSupWirelessAcc && isRouterMode\" translate>WLAN Bridge</th><th ng-if=\"showWirelessAccExp && isSupBridgeMode && !isRouterMode\" translate>Bridge</th><th ng-if=showIpsecAccExp translate>IPsec</th><th translate>Description</th></tr></thead><tbody><tr ng-repeat=\"raw in excepList\" onclick=expListClick(this) style=\"text-align: center; cursor: default;\"><td>{{$index + 1}}</td><td>{{raw.MAC}}</td><td>{{raw.NAT}}</td><td ng-if=\"showWirelessAccExp && isSupWirelessAcc\">{{raw.Bridge}}</td><td ng-if=showIpsecAccExp>{{raw.IPsec}}</td><td>{{raw.Des}}</td></tr></tbody></table></div></td></tr><tr><td style=\"padding-left: 35px;\"><translate>MAC Address</translate> :</td><td><input class=macTexts maxlength=2 ng-disabled=\"!isEnableAcc || !isExpListChecked\" onkeyup=\"this.value = this.value.toUpperCase();\" style=\"width: 20px;\" type=text>&nbsp;<b>:</b>&nbsp; <input class=macTexts maxlength=2 ng-disabled=\"!isEnableAcc || !isExpListChecked\" onkeyup=\"this.value = this.value.toUpperCase();\" style=\"width: 20px;\" type=text>&nbsp;<b>:</b>&nbsp; <input class=macTexts maxlength=2 ng-disabled=\"!isEnableAcc || !isExpListChecked\" onkeyup=\"this.value = this.value.toUpperCase();\" style=\"width: 20px;\" type=text>&nbsp;<b>:</b>&nbsp; <input class=macTexts maxlength=2 ng-disabled=\"!isEnableAcc || !isExpListChecked\" onkeyup=\"this.value = this.value.toUpperCase();\" style=\"width: 20px;\" type=text>&nbsp;<b>:</b>&nbsp; <input class=macTexts maxlength=2 ng-disabled=\"!isEnableAcc || !isExpListChecked\" onkeyup=\"this.value = this.value.toUpperCase();\" style=\"width: 20px;\" type=text>&nbsp;<b>:</b>&nbsp; <input class=macTexts maxlength=2 ng-disabled=\"!isEnableAcc || !isExpListChecked\" onkeyup=\"this.value = this.value.toUpperCase();\" style=\"width: 20px;\" type=text>&nbsp;&nbsp; <input ng-disabled=\"!isEnableAcc || !isExpListChecked\" onclick=openExpARPTbl() type=button value=\"{{'ARP Table' | translate}}\"></td></tr><tr><td style=\"padding-left: 35px;\"><translate>Exception Type</translate> :</td><td><span><input checked name=expTypeNat ng-disabled=\"!isEnableAcc || !isExpListChecked || isExpTypeNatAutoCheck\" type=checkbox><translate>NAT</translate></span> &nbsp; <span ng-if=\"showWirelessAccExp\"><input checked name=expTypeBridge ng-disabled=\"!isEnableAcc || !isExpListChecked\" ng-if=\"(isSupWirelessAcc && isRouterMode) || (isSupBridgeMode && !isRouterMode)\" type=checkbox><label ng-if=\"isSupWirelessAcc && isRouterMode\" translate>WLAN Bridge</label><label ng-if=\"isSupBridgeMode && !isRouterMode\" translate>Bridge</label></span> &nbsp; <span ng-if=\"showIpsecAccExp\"><input checked name=expTypeIPsec ng-disabled=\"!isEnableAcc || !isExpListChecked\" type=checkbox><translate>IPsec</translate></span></td></tr><tr><td style=\"padding-left: 35px;\"><translate>Description</translate> :</td><td><input maxlength={{expDescrMaxLen}} name=expDes ng-disabled=\"!isEnableAcc || !isExpListChecked\" placeholder=\"{{'MAX' | translate}} {{expDescrMaxLen}} {{'characters' | translate}}\" type=text></td></tr><tr align=center><td colspan=2><input ng-disabled=\"!isEnableAcc || !isExpListChecked\" onclick=expAdd() style=\"width: 75px;\" type=button value=\"{{'Add' | translate}}\"> &nbsp; <input ng-disabled=\"!isEnableAcc || !isExpListChecked\" onclick=expDelete() style=\"width: 75px;\" type=button value=\"{{'Delete' | translate}}\"> &nbsp; <input ng-disabled=\"!isEnableAcc || !isExpListChecked\" onclick=expEdit() style=\"width: 75px;\" type=button value=\"{{'Edit' | translate}}\"></td></tr></table></div></td></tr><tr id=ppahost0 ng-show=TypeEr><td><translate>Option</translate>:</td><td><label><input name=iTraffic onclick=onClkType(1) type=radio value=1>&nbsp; <span ng-if=\"!isSupGRX500\" translate>Accelerate heaviest traffic sessions</span><span ng-if=\"isSupGRX500\" translate>Auto (Accelerate heaviest traffic sessions)</span></label></td></tr><tr class=qos id=ppahost1 style=display:none><td></td><td><label><input name=iQos onclick=onClkType(2) type=radio value=1>&nbsp;<span id=\"aplycrqoslink\" translate>Apply the <a>Class Rule</a> in Quality of Service</span></label></td></tr><tr id=ppahost2 ng-show=TypeEr><td></td><td><label><input name=iSpecific onclick=onClkType(3) type=radio value=1>&nbsp;<translate>Specific Hosts</translate>: </label></td></tr><tr id=ppahost3 ng-show=TypeEr><td></td><td><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 style=\"text-align: center;\" width=100%><thead><tr><th translate>Index</th><th translate>Enable</th><th><translate>Dest Port</translate><br><translate>Start</translate></th><th><translate>Dest Port</translate><br><translate>End</translate></th><th translate>Private IP</th><th></th></tr></thead><tbody><tr class=row{{$index%2}} ng-repeat=\"hostList in aryPpaSpec\"><td>{{$index+1}}</td><td><input name=iHwHostEn{{$index}} ng-disabled=!iSpecific ng-model=hostList.enable type=checkbox value=1></td><td><input maxlength=5 name=iHwHostStarP{{$index}} ng-disabled=\"!hostList.enable || !iSpecific\" ng-value=hostList.destPortStart size=5 type=text></td><td><input maxlength=5 name=iHwHostEndP{{$index}} ng-disabled=\"!hostList.enable || !iSpecific\" ng-value=hostList.destPortEnd size=5 type=text></td><td><input maxlength=15 name=sHwHostPriIP{{$index}} ng-disabled=\"!(iSpecific && hostList.enable)\" ng-value=hostList.hostIP size=15 type=text></td><td><input name=sHwHostChsePc{{$index}} ng-disabled=\"!(iSpecific && hostList.enable)\" onclick=onClkChse(this) type=button value=\"{{ 'Choose PC' | translate}}\"></td></tr></tbody></table></td></tr></table></td></tr></table><div id=spcmodel style=display:none><p><b translate>WAN Information</b>: </p><table align=center border=1 cellpadding=2 cellspacing=0 style=\"margin-right: 0;text-align: center;\" width=90%><thead><tr><td align=center width=30%>&nbsp;</td><td align=center translate width=20%>Status</td><td align=center width=25%><translate>TX</translate></td><td align=center width=25%><translate>RX</translate></td></tr></thead><tbody ng-show=!Wan1IsXdsl><tr><td align=left class=text-indent><translate>WAN</translate>1-{{aryStrWanMode[aryWanPhyMode[0]] | translate}} </td><td align=center>{{aryVlewan1 ? 'Enable' : 'Disabled' | translate}}</td><td align=center>{{aryVlewan1 ? 'V' : '--'}}</td><td align=center>{{aryVlewan1 ? 'V' : '--'}}</td></tr><tr class=clswan2 id=gtablewan2><td align=left class=text-indent><translate>WAN</translate>2-{{aryStrWanMode[aryWanPhyMode[1]] | translate}} </td><td align=center>{{aryVlewan2 ? 'Enable' : 'Disabled' | translate}}</td><td align=center>{{sArpTbl22 == 2 || aryVlewan2 == 1 ? 'V' : '--'}}</td><td align=center>{{sArpTbl22 == 1 || aryVlewan2 == 1 ? 'V' : '--'}}</td></tr></tbody><tbody class=btable ng-show=Wan1IsXdsl><tr><td align=left class=text-indent>{{ 'WAN' | translate}}1-{{ aryWanPhyMode[0] == 1 ? 'ADSL' : 'VDSL' | translate}}</td><td align=center translate>Enable</td><td align=center> {{aryWanPhyMode[0] == 1 ? '--' : 'V'}}</td><td align=center> {{aryWanPhyMode[0] == 1 ? '--' : 'V'}}</td></tr><tr class=clswan2 id=btablewan2><td align=left class=text-indent> {{ 'WAN' | translate}}2-{{ 'Ethernet' | translate}} </td>