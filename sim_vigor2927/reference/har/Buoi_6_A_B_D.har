            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><script src=\"/cgi-bin/certificatedata.cgi?sFormAuthStr=pU2VHFY4WAi1NkA\"></script><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><style>\n.strict_length{\n\ttext-overflow: ellipsis;\n\twhite-space: nowrap;\n\toverflow: hidden;\n\tmax-width: 80px;\n}\n.status-ok,.status-ex30,.status-expired,.status-not {\n\tbackground: #25b997;\n\tdisplay: inline-block;\n\twidth: 11px;\n\theight: 11px;\n\tborder-radius: 11px;\n\tmargin-right: 8px;\n}\n.status-ex30 {\n\tbackground: #e7b309;\n}\n.status-expired {\n\tbackground: #d8253a;\n}\n.status-not {\n\tbackground: #aaaaaa;\n}\n.table-striped>tbody>tr>td {\n\twhite-space: nowrap;\n}\n</style></head><body class=ng-cloak style=\"font-family: verdana, Arial, Helvetica;font-size: 10pt; margin: 0px auto;\"><div style=\"width: 780px;margin: 3px auto;\"><b parent=\"{{ 'Certificate Management' | translate }}\" sub-title translate>Trusted CA Certificate</b><hr><form name=frm1><b translate>X509 Trusted CA Certificate Configuration</b><table cellPadding=2 cellSpacing=2 class=table-striped id=caCert><thead><tr><th align=center width=15%><nobr>&nbsp;<b translate>Name</b></nobr></th><th align=center width=40%><nobr>&nbsp;<b translate>Subject</b></nobr></th><th align=center width=15%><nobr>&nbsp;<b translate>Status</b></nobr></th><th align=center width=30%><nobr>&nbsp;<b translate>Modify</b></nobr></th></tr></thead><tbody></tbody><tbody data-new-cert=true><tr><td colspan=4><input name=X509Import onclick=X509import() type=button value=\"{{'IMPORT' | translate }}\"></td></tr></tbody></table><br><div data-new-cert=true><b translate>Storage for Certificate</b><div class=progress><span translate>Storage Usage</span>: <div class=progress-bar><div style=\"background-color: #4682B4;height: inherit;\"></div></div><span class=\"progress-text\">77%</span></div></div><br><b translate>Note</b>: <ol><li id=notetable translate>Ensure Time Zone is correctly set up in \"System Maintenance &gt;&gt; <a>Time and Date</a>\" before you try to generate a RootCA!!</li><li translate>Certificate files will be deleted when downgrading router firmware from version 4.4.0 to an older version.</li><li ng-show=\"'1' == 1\" translate>Local Certificate and Trusted CA Certificate share a storage space.</li></ol><table align=center><tr><td><input data-new-cert name=X509Import onclick=X509import() type=button value=\"{{'IMPORT' | translate }}\">&nbsp; <input name=X509Refresh onclick=X509refresh() type=button value=\" {{'REFRESH' | translate }} \"></td></tr></table><input name=sFormAuthStr type=hidden value=\"pU2VHFY4WAi1NkA\"></form></div><script src=\"/js/variable.js?6018\"></script><script> top.ACTION_STATUS=-1;top.iActionStatusFlag='0';top.iFwUpgradeState='0';top.act_sta.damage_alert();var f=document.frm1;var bg=parent;var fid=\"\";var winX509view,winX509Import,winX509Export;var cacf_uid=[parseInt('0'),parseInt('0'),parseInt('0')];var ucTLS_PXY='(nil)';var rootcaNum=aryajaxrootca.length;var rootCA=\"\";var iNewCert=parseInt('1');angular.element(document).ready(function(){top.certTitle=\"Trusted CA\";for(var i=0;i<rootcaNum;i++){rootCA+=\"<tr class=x509rootca>\";rootCA+=\"<td width=15% align=center>\"+aryajaxrootca[i][0]+\"</td>\";rootCA+=\"<td width=40% title=\\\"\"+aryajaxrootca[i][1]+\"\\\" class='bignormal overflow-content'>\"+(aryajaxrootca[i][1]?aryajaxrootca[i][1]:aryajaxrootca[i][2])+\"</td><td width=15% class='overflow-content'>\"; if(aryajaxrootca[i][2]=='Not Valid Yet'){rootCA+='<div class=status-not></div><font color=\"#aaaaaa\">'+gettext(aryajaxrootca[i][2])+'</font></td>';}else if(aryajaxrootca[i][2]=='Expired'){rootCA+='<div class=status-expired></div><font color=\"#d8253a\">'+gettext(aryajaxrootca[i][2])+'</font></td>';}else if(aryajaxrootca[i][2]=='Expire within 30 days'){rootCA+='<div class=status-ex30></div><font color=\"#e7b309\">'+gettext(ary