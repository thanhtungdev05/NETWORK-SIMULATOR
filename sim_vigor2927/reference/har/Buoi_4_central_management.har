AN(){var aryslt=[\"iPriWANProf\",\"iSecWANProf\"];for(i=0;i<2;i++){idx=bg.getIdxbyName(f,aryslt[i]);for(var wani=0,cnt=0;wani<iBwanNumber;wani++){if(top.notSupportWAN.indexOf(wani)!=-1)continue;if((bDualDSL&&extra_vdsl_idx==wani&&DualDslEnable!=\"1\")||(iUSBNum==2&&iSecUsbNum==0&&idx_2nd_usb==(wani+1)))continue;if(bNewWLWAN&&(wani==2||wani==3)&&!bWless&&!bDualWless5G)continue;else if(bNewWLWAN&&wani==3&&!bDualWless5G)continue;if(!bg.SHOW_DIG_WAN2&&(wani==1))continue;if(((wani==2&&!parseInt('1'))||(wani==4&&parseInt('1')))&&(parseInt('0')))f[idx].options[cnt]=new Option(gettext(sLTEmodulename),wani);else f[idx].options[cnt]=new Option(gettext('WAN')+(wani+1),wani);cnt++;}}}function initVPN(){var aryslt=[\"iPriVPNProf\",\"iSecVPNProf\"];for(i=0;i<2;i++){idx=bg.getIdxbyName(f,aryslt[i]);for(j=0,cnt=0;j<aryL2LPro.length;j++){f[idx].options[cnt]=new Option(gettext('VPN ')+(aryL2LPro[j][1]+1)+\".\"+aryL2LPro[j][0],aryL2LPro[j][1]);cnt++;}}}function init_time(){ var periodicInformTime='1970-01-01T00:00:00';var year,month,day,hour,minute,second;var date=periodicInformTime.split(\"T\")[0];var time=periodicInformTime.split(\"T\")[1];if(date!=\"\"){year=date.split(\"-\")[0];month=date.split(\"-\")[1];day=date.split(\"-\")[2];if(parseInt(year)<2000)year=\"2000\";f.year.value=year;if(parseInt(month)==0)month=\"01\";f.month.value=month;if(parseInt(day)==0)day=\"01\";f.day.value=day;}if(time!=\"\"){hour=time.split(\":\")[0];minute=time.split(\":\")[1];second=time.split(\":\")[2];f.hour.value=hour;f.minute.value=minute;f.second.value=second;}}function inform_check(){if(!bg.WUI_SYS_TR069_ENABLE)return;f.periodic_interval.disabled=!f.periodic_enable.checked;}if(parseInt('1')){function apply_ap_check(){if(!bg.WUI_SYS_TR069_ENABLE)return;$scope.isAPsEnabled=f.apply_ap_enable.checked;$scope.$apply();if(f.apply_ap_enable.checked&&!f.apply_ap_stun_en.checked)f.apply_ap_stun_en.click();}function ap_stun_check(){$scope.isAPsStunEnabled=f.ap_stun_enable.checked;$scope.$apply();}function appl