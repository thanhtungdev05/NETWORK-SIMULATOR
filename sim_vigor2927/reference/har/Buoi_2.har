            "compression": 10004,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/dhtml.min.js?094907\"></script></head><textarea id=raccctlinit style=display:none>\nvar pptpwan = [1,1,1,1,1,1];\nvar ipsecwan = [2,2,2,2,2,2];\nvar l2tpwan = [4,4,4,4,4,4];\nvar openvpnwan = [16,16,16,16,16,16];\nvar wireguardwan =  [32,32,32,32,32,32];\n</textarea><body class=ng-cloak onload=initParameter()><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'VPN and Remote Access' | translate }}\" sub-title translate>Remote Access Control</b><hr><form name=frm1><table border=0 cellspacing=2 width=700><tr><td align=left class=offtab id=tab1 onClick=dhtml.cycleTab(this.id);parent.sVPNAccCtlTag=this.id; width=35%><b translate>Remote Access Control Setup</b></td><td align=left class=offtab id=tab2 onClick=dhtml.cycleTab(this.id);parent.sVPNAccCtlTag=this.id; width=35%><b translate>Bind to WAN</b></td></tr></table><div id=page1><table border=1 cellspacing=0 width=700><tr><td><table align=center border=0 cellpadding=2 cellspacing=0><tr><td><label><input name=chxPPTP type=checkbox>&nbsp;<translate>Enable PPTP VPN Service</translate></label><td></tr><tr class=sL2lIpsec style=display:none><td><label><input name=chxIPSec type=checkbox>&nbsp;<translate>Enable IPsec VPN Service</translate></label></td></tr><tr class=sL2lIpsec style=display:none><td><label><input name=chxL2TP type=checkbox>&nbsp;<translate>Enable L2TP VPN Service</translate></label></td></tr><script> if(parseInt('1')){document.write('<tr><td><label><input type=checkbox name=chxSSTP>&nbsp;'+gettext(\"Enable SSL VPN Service\")+'</label></td></tr>');}</script><tr class=isdn style=display:none><td><label><input DISABLED name=chxISDN type=checkbox>&nbsp; <script>var iUsb56kModem='0';if(iUsb56kModem==1)document.write(gettext(\"Enable USB Modem Dial-In\"));else document.write(gettext(\"Enable ISDN Dial-In\"));</script></label></td></tr><tr ng-if=bOpenVPN><td><label><input name=chxOpenVPN type=checkbox>&nbsp;<translate>Enable OpenVPN Service</translate></label></td></tr><tr ng-if=bOpenVPN><tr ng-if=bWireGuard><td><label><input name=chxWireGuardVPN type=checkbox>&nbsp;<translate>Enable WireGuard VPN Service</translate></label></td></tr><tr ng-if=bWireGuard></table></td></tr></table><b translate>Note</b>: <ol><li id=link_note translate>To allow VPN pass-through to a separate VPN server on the LAN, disable the services listed above that use the same protocol and ensure that NAT <a1>Open Ports</a1> or <a2>Port Redirection</a2> is well-configured.</li><li id=link_note translate>Disable unused VPN services, enable <a3>Brute Force Protection</a3>, and <a4>block unknown IP access</a4> to the used VPN services to reduce Cyberattacks.</li></ol><br><table width=100%><tr align=center><td><input class=btnw name=btnOK onClick=submitPara() type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnClr onClick=onbtnClr() type=button value=\"{{ 'Clear' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnCcl onClick=onbtnCcl() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table><br></td></tr></table></div><div id=page2 style=display:none><table align=center border=1 cellspacing=0 width=700><tr><td><table align=center border=0 cellpadding=2 cellspacing=0><tr><td align=right translate>PPTP VPN Service</td><td colspan=2><span id=\"vpnPPTPWan\"></span></td></tr><tr><td align=right translate>IPsec VPN Service</td><td colspan=2><span id=\"vpnIPsecWan\"></span></td></tr><tr><td align=right translate>L2TP VPN Service</td><td colspan=2><span id=\"vpnL2TPWan\"></span></td></tr><tr><td align=right translate>SSL VPN Service</td><td colspan=2><span id=\"vpnSSLWan\"></span></td></tr><tr><td align=right translate>OpenVPN Service</td><td colspan=2><span id=\"vpnOpenVPNWan\"></span></td></t