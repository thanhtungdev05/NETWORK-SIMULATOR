config wifi-device 'wl2g'
	option type 'mac80211'
	option path 'platform/soc/c000000.wifi'
	option band '2g'
	option channel 'auto'
	option htmode 'HE40'
	option country 'VN'
	option disabled '0'

config wifi-iface 'wl2g_ap'
	option device 'wl2g'
	option network 'lan'
	option mode 'ap'
	option ssid 'FPT_AX3000CV2'
	option encryption 'psk2'
	option key 'fpt@12345'
	option disabled '0'

config wifi-device 'wl5g'
	option type 'mac80211'
	option path 'platform/soc/c000000.wifi+1'
	option band '5g'
	option channel 'auto'
	option htmode 'HE80'
	option country 'VN'
	option disabled '0'

config wifi-iface 'wl5g_ap'
	option device 'wl5g'
	option network 'lan'
	option mode 'ap'
	option ssid 'FPT_AX3000CV2_5G'
	option encryption 'psk2'
	option key 'fpt@12345'
	option disabled '0'
