Index</translate>&nbsp;1</b></td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=700><tr><td><table border=0 cellpadding=2 cellspacing=0 width=700><tr><td colspan=5><input name=schedEn type=checkbox value=1><translate>Enable Schedule Setup</translate></td></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 width=600><tr><td translate width=40%>Comment</td><td width=60%><input id=txtComment maxlength=31 name=txtComment></td></tr><tr><td width=40%><translate>Start Date</translate> (yyyy-mm-dd)</td><td width=60%><select class=s4 name=stYY><option ng-init=y=$index ng-repeat=\"yy in [].constructor(50) track by $index\" value={{2000+y}}>{{2000+y}}</option></select><b>-</b><select class=s2 name=stMonth><option ng-init=m=$index+1 ng-repeat=\"mm in [].constructor(12) track by $index\" value={{m}}>{{m}}</option></select><b>-</b><select class=s2 name=stDD><option ng-init=d=$index+1 ng-repeat=\"dd in [].constructor(31) track by $index\" value={{d}}>{{d}}</option></select><b></td></tr><tr><td><translate>Start Time</translate> (hh:mm)</td><td><select class=s2 name=stHH><option ng-init=h=$index ng-repeat=\"hh in [].constructor(24) track by $index\" value={{h}}>{{h}}</option></select><b> : </b><select class=s2 name=stMM><option ng-init=m=$index ng-repeat=\"mm in [].constructor(60) track by $index\" value={{m}}>{{m}}</option></select></td></tr><tr><td><translate>Duration Time</translate> (hh:mm)</td><td><select class=s2 name=durHH><option ng-init=h=$index ng-repeat=\"hh in [].constructor(24) track by $index\" value={{h}}>{{h}}</option></select><b> : </b><select class=s2 name=durMM><option ng-init=m=$index ng-repeat=\"mm in [].constructor(60) track by $index\" value={{m}}>{{m}}</option></select></td></tr><tr ng-show=newSchedule><td><translate>End Time</translate> (hh:mm)</td><td><input disabled name=endHH size=2 type=text><b> : </b><input disabled name=endMM size=2 type=text><span id=overnignt style=\"display:none\">&nbsp;(<translate>over