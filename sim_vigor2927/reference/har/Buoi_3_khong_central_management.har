            "compression": 30935,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=900><tr><td colspan=2><b ng-if=!qtlink parent=\"{{ 'Diagnostics' | translate }}\" sub-title translate>Route Policy Diagnosis</b><b ng-if=qtlink parent=\"{{ 'Diagnostics' | translate }}\" qslink=\"https://www.draytek.com/router-help-redirect?stk_title=Diagnostics&nd_title=Route Policy Diagnosis\" sub-title translate>Route Policy Diagnosis</b><hr><form action=/cgi-bin/v2x00.cgi method=POST name=frm1><table border=0 cellpadding=0 cellspacing=0 width=100%><tr><td colspan=6><b translate>Test how the packets will be routed</b></td></tr><tr><td><table align=left border=0 cellpadding=2 cellspacing=2 width=100%><tr><td colspan=2></td></tr><tr align=left><td colspan=3><table><tr><td><b translate>Mode</b></td>&nbsp;&nbsp;&nbsp;<td align=left><input name=analzyzebtn onclick=Onselect() type=radio value=0>&nbsp;&nbsp;<translate>Analyze a single packet</translate></td></tr><tr align=left><td></td><td align=left><input name=analzyzebtn onclick=Onselect() type=radio value=1>&nbsp;&nbsp;<translate>Analyze multiple packets by uploading an input file</translate></td></tr></table></td></tr><tr class=showpacket style=display:none><td colspan=2>&nbsp;</td></tr><tr class=showpacket style=display:none><td colspan=2>&nbsp;</td></tr><tr class=showpacket style=display:none><td colspan=2><b translate>Packet Information</b></td></tr><tr class=showpacket style=display:none><td align=left colspan=2><table border=0><tr><td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <translate>Protocol</translate>&nbsp;</td><td><select name=packetsel onChange=onChgpacket() style=width:175px><option translate value=0>ICMP</option><option translate value=1>UDP</option><option translate v