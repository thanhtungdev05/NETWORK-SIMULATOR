            "mimeType": "text/html",
            "compression": 2779,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=900><tr><td colspan=2><b parent=\"{{ 'Applications' | translate }}\" qslink=\"https://www.draytek.com/router-help-redirect?stk_title=Applications&nd_title=LAN DNS / DNS Forwarding\" sub-title></b><b ng-if=DnsForward translate>LAN DNS / DNS Forwarding</b><b ng-if=!DnsForward translate>LAN DNS</b><hr><form name=frm1><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>LAN DNS Resolution</b><b ng-if=DnsForward> / </b><b ng-if=DnsForward translate>Conditional DNS Forwarding</b></td><td align=right class=red>|&nbsp; <a class=DenyLink href=javascript:ruOK() translate>Set to Factory Default</a>&nbsp;|</td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 class=table-striped width=100%><thead><tr><th translate width=8%>Index</th><th translate width=8%>Enable</th><th translate width=20%>Profile</th><th translate>Domain Name</th><th ng-if=DnsForward translate width=20%>Type</th><th ng-if=DnsForward translate width=20%>DNS Server</th></tr></thead><tbody><tr align=center ng-init=i=$index ng-repeat=\"item in aryDnsInfo\"><td> <a href=# ng-click=gotoDetailSet(item.idx)>{{item.idx+1}}.</a></td><td><input name=landnsEn{{i}} ng-model=item.enable type=checkbox value=1></td><td>{{item.prof}}</td><td>{{item.dmn}}</td><td ng-if=DnsForward>{{item.type}}</td><td ng-if=DnsForward>{{item.serv}}</td></tr></tbody></table></td></tr></table><div class=red><span>&lt;&lt;</span><span ng-repeat=\"ii in [].constructor(MAX_PAGE) track by $index\" ng-init=\"i=$index+1;idxperpage=10\"><span> <a href=# ng-click=gotoPage(i)>{{((i-1)*idxperpage+1) + \"-\" + (idxperpage*i)}}</a>&nbsp;</span><span ng-if=\"i < MAX_PAGE\">|</span></span><span>&gt;&gt;</span></div><br><table align=center><tr><td><input name=fid type=hidden value=2326><input name=iSavePage type=hidden value=0><input name=iToPageIdx type=hidden value=\"1\"><input name=iPageIdx type=hidden value=\"1\"><input name=iOption type=hidden><input class=btnw name=btnOk onClick=onClkBtnOk() type=button value=\"{{ 'OK' | translate }}\"><input name=webchange type=hidden value=0></td></tr></table><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></td></tr></table><textarea id=landnsinit ng-hide=true>\n\tvar aryDnsInfo = [[false,\"\",\"\",0,\" \"],[false,\"\",\"\",0,\" \"],[false,\"\",\"\",0,\" \"],[false,\"\",\"\",0,\" \"],[false,\"\",\"\",0,\" \"],[false,\"\",\"\",0,\" \"],[false,\"\",\"\",0,\" \"],[false,\"\",\"\",0,\" \"],[false,\"\",\"\",0,\" \"],[false,\"\",\"\",0,\" \"]];\n\tvar DnsForward = parseInt('1');\n\tvar maxidx = parseInt(\"120\");\n\tvar pagenum = parseInt(\"1\");\n\tconst iActionStatusFlag = '1',\n\t\tiFwUpgradeState = '0';\n</textarea><script> var landnsinitscript=document.createElement(\"script\");landnsinitscript.text=document.getElementById(\"landnsinit\").value;document.head.appendChild(landnsinitscript);top.ACTION_STATUS=-1;top.iActionStatusFlag=iActionStatusFlag;top.iFwUpgradeState=iFwUpgradeState;top.act_sta.damage_alert();var f=document.frm1;var bg=parent;angular.element(document).ready(function(){initParameter();initWebChange();});function initParameter(){let dmn;const idxperpage=10;$scope.aryDnsInfo=[];angular.forEach(aryDnsInfo,function(item,i){dmn=item[2].length>20?item[2].substr(0,20)+\"...\":item[2];$scope.aryDnsInfo.push({'idx':(pagenum-1)*idxperpage+i,'enable':item[0],'prof':item[1],'dmn':dmn,'type':dmn?item[3]==1?gettext(\"DNS Forwarding\"):gettext(\"LAN DNS\"):\"-\",'serv':item[3]==1?item[4]:\"\"});});$scope.MAX_PAGE=maxidx/idxperpage;$scope.DnsForward=DnsForward;$scope.gotoDetailSet=gotoDetailSet;$scope.gotoPage=gotoPage;$scope.$apply();}function ruOK(){if(confirm(gettext(\"Do you want to clear all profiles?\"))){document.location=\"/cgi-bin/v2x00.cgi?sFormAuthStr=\"+top.authStr+\"&fid=2326&iPageIdx=1&iOption=1\";}}function onClkBtnOk(){if(checkWebChange()){f.webchange.value='1';}f.fid.value=2326;f.iOption.value=2;f.method=\"post\";f.action=\"/cgi-bin/v2x00.cgi\";f.submit();}function gotoDetailSet(idx){document.location=\"/cgi-bin/v2X00.cgi?sFormAuthStr=\"+top.authStr+\"&fid=2327&iProfileIdx=\"+idx+\"&iOption=0\";}function gotoPage(_idx){var idx=_idx;f.fid.value=2326;f.iOption.value=0; f.iPageIdx.value=_idx;f.method=\"post\";f.action=\"/cgi-bin/v2x00.cgi\";f.submit();}</script></body></html>"
