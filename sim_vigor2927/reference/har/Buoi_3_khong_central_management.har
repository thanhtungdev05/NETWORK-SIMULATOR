            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><script src=\"/js/base32.min.js?094907\"></script><script src=\"/js/qrcode.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/dhtml.min.js?094907\"></script><script src=\"/js/webchange.js?094907\"></script><style>\n.multiselect {\n\twidth: 130px;\n}\n\n.selectBox {\n\tposition: relative;\n}\n\n.selectBox select {\n\twidth: 100%;\n}\n\n.overSelect {\n\tposition: absolute;\n\tleft: 0;\n\tright: 0;\n\ttop: 0;\n\tbottom: 0;\n}\n\n#checkboxes {\n\tdisplay: none;\n\tborder: 1px #494949 solid;\n\tposition: absolute;\n\tbackground-color: white;\n\twidth: inherit;\n}\n\n#checkboxes label {\n\tdisplay: block;\n}\n\n#checkboxes label:hover {\n\tbackground-color: #1e90ff;\n}\n\ninput[readonly] {\n\tbackground-color: #f3f3f3; /* Light grey background */\n\tcolor: #666; /* Dark grey text */\n}\n</style><style type=text/css>\n/* Popup container - can be anything you want */\n.popup {\n\tposition: relative;\n\tdisplay: inline-block;\n\tcursor: pointer;\n\tuser-select: none;\n}\n\n/* The actual popup */\n.popup .popuptext {\n\tvisibility: hidden;\n\twidth: 300px;\n\tbackground-color: #555;\n\tcolor: #fff;\n\ttext-align: left;\n\tborder-radius: 6px;\n\tpadding: 8px 0;\n\tposition: absolute;\n\tz-index: 1;\n\tbottom: 125%;\n\tleft: 35%;\n\tmargin-left: -80px;\n}\n\n/* Toggle this class - hide and show the popup */\n.popup .show {\n\tvisibility: visible;\n}\n\n#qrcodeTOTP {\n\twidth:100px;\n\theight:152px;\n\tbackground-color: #fff;\n}\n</style></head><body class=ng-cloak><textarea id=acontrolinit style=display:none>\nvar objectData = {\"IPv4\":{\"objMaxNum\":192,\"obj\":[[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],[],