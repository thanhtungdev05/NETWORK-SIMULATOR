            "compression": 9181,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'Applications' | translate }}\" sub-title translate>Local 802.1X General Setup</b><hr><form action=/cgi-bin/v2x00.cgi method=post name=frm1><table align=center border=1 cellspacing=0 width=750><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=700><tr><td><input name=chEnable onClick=onChxAct() type=checkbox><translate>Enable</translate><hr></td></tr><tr><td style=text-indent:10px;><input name=iTTLSPAP type=checkbox value=1><translate>EAP_TTLS/PAP</translate>&nbsp;&nbsp;&nbsp; <input name=iTTLSMSCHAP type=checkbox value=1><translate>EAP_TTLS/MSCHAP</translate>&nbsp;&nbsp;&nbsp; <input name=iTTLSCHAPv2 type=checkbox value=1><translate>EAP_TTLS/MSCHAPv2</translate></td></tr><tr><td style=text-indent:10px;><input name=iPEAPCHAPv2 type=checkbox value=1><translate>EAP_PEAP/MSCHAPv2</translate></td></tr><tr><td valign=top>&nbsp;</td></tr><tr ng-if=\"iXCer4LoSrv == 1\"><td><b translate>Certificate</b><hr></td></tr><tr ng-if=\"iXCer4LoSrv == 1\"><td style=text-indent:10px;><select name=servercert size=1><option ng-repeat=\"x in LoCf8021x\" ng-selected=x[2]==1 value={{x[1]}}>{{x[0]}}</option></select></td></tr><tr ng-if=\"iXCer4LoSrv == 1\"><td valign=top>&nbsp;</td></tr><tr><td><b translate>User Profile</b></td></tr><tr><td valign=top><table border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table><tr><td colspan=3><input name=selall onclick=SelectAll() type=button value=\"{{ 'Select All' | translate }}\">&nbsp; &nbsp;&nbsp; &nbsp;<input name=clall onclick=ClearAll() type=button value=\"{{ 'Clear All' | translate }}\"></td></tr><tr><td><b translate>Available List</b></td><td>&nbsp;</td><td><b translate>Authentication List</b></td></tr><tr><td align=center><select name=availist size=10 style=width:290px;height:150px></select></td><td align=center><input class=btnw1 name=add onclick=moveAdd() type=button value=&#155;&#155;><br><br><input class=btnw1 name=remove onclick=moveRemove() type=button value=&#139;&#139;></td><td align=center><select name=authlist size=10 style=width:290px;height:150px></select></td></tr></table></td></tr></table><br></td></tr><tr><td class=link_note><input name=sync type=checkbox value=1><translate>Sync <a>User Profile</a> Setting to Internal Radius</translate></td></tr></table><br></td></tr></table><br><table align=center border=0 class=local8021x width=750><tr><td colspan=2><b translate>Note</b>: <ol><li class=link_note translate>Only the user profiles which is enabled in <a>User Management >> User Profile</a> will be listed here.</li><li><script> var bWired802=parseInt('1');if(parseInt('0')||bWired802){var str=\"\";if(parseInt('0')){if(parseInt('0'))str+=\"<a href='/cgi-bin/v2x00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=2022'>\"+gettext(\"Wireless LAN(2.4G)\")+\"</a>,<a href='/cgi-bin/dualwl.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=2'>\"+gettext(\"Wireless LAN(5G)\")+\"</a>\";else str+=\"<a href='/cgi-bin/v2x00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=2022'>\"+gettext(\"Wireless LAN\")+\"</a>\";if(bWired802)str+=\" \"+gettext(\"and\")+\" <a href='/cgi-bin/v2x00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=2888'>\"+gettext(\"Wired 802.1X\")+\"</a>\";}else if(bWired802)str+=\"<a href='/cgi-bin/v2x00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=2888'>\"+gettext(\"Wired 802.1X\")+\"</a>\";str+=' <span class=\"link_note\">'+gettext(\"used the same <a>User Profile</a> as its identity and password.\")+\"</span></td></tr>\";document.write(str);}</script></li></ol></td></tr></table><br><table align=center width=100%><tr align=center><td><input name=fid type=hidden value=2216><input name=iAct type=hidden><input name=iEnable type=hid