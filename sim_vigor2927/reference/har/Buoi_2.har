          "content": {
            "size": 24465,
            "mimeType": "text/html",
            "compression": 17786,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/dhtml.min.js?094907\"></script><style>\n\t.flex-between {\n\t\tdisplay: flex;\n\t\tjustify-content: space-between;\n\t\twidth: 75%;\n\t\theight: 21px;\n\t\talign-items: center;\n\t\tpadding:2px 0;\n\t}\n</style></head><body class=ng-cloak><textarea id=openvpninit style=\"display: none;\">\n\tvar aryWanInfo = [[1,\"red\",\"---\"],[2,\"red\",\"---\"],[3,\"red\",\"---\"],[4,\"red\",\"---\"],[5,\"red\",\"---\"],[6,\"red\",\"---\"]];\n\tvar bWan2IsDisable = parseInt('0');\n\tvar aryCrtIdx = [0,0];\n\tvar aryGenerateCA = ['None',0,'None',0,'None',0,'None',0];\n\tvar aryMail = [\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\"];\n\tvar aryWANaliasIP = [[[0,'---']],[[0,'---']],[],[],[],[]];\n\tvar iCipher = '1';\n\tvar iHmac = '1';\n\tvar sLTEmodulename = 'LTE';\n</textarea><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td colspan=2><b parent=\"{{ 'VPN and Remote Access' | translate }}\" qslink=\"https://www.draytek.com/router-help-redirect?stk_title=VPN and Remote Access&nd_title=OpenVPN\" sub-title translate>OpenVPN</b><hr><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td class=offtab id=tab1 onClick=dhtml.cycleTab(this.id);parent.sOpenVPNTag=this.id; width=26%><b translate>OpenVPN Server Setup</b></td><td class=offtab id=tab2 onClick=dhtml.cycleTab(this.id);parent.sOpenVPNTag=this.id; width=20%><b translate>Client Config</b></td><td class=offtab id=tab3 onClick=dhtml.cycleTab(this.id);parent.sOpenVPNTag=this.id; width=20%><b translate>Import Certificate</b></td><td class=tabpadding></td></tr></table><div id=page1 style=\"display:none;text-align: left\"><form action=/cgi-bin/v2x00.cgi method=post name=frm1><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=90%><tr><td colspan=2><br></td></tr><tr><td colspan=2><b translate>General Setup</b><br><hr size=1></td></tr><tr><td translate width=30%>UDP</td><td><input name=iUdpEn type=checkbox value=1>&nbsp;<translate>Enable</translate></td></tr><tr><td translate width=30%>UDP Port</td><td><input name=iPort type=text value=\"1194\"></td></tr><tr><td translate>TCP</td><td><input name=iTcpEn type=checkbox value=1>&nbsp;<translate>Enable</translate></td></tr><tr><td translate width=30%>TCP Port</td><td><input name=iTcpPort type=text value=\"1194\"></td></tr><tr><td translate>Cipher Algorithm</td><td><select convert-to-number name=cipher ng-model=sltCipher><option translate value=0>AES128-CBC</option><option translate value=1>AES256-CBC</option><option translate value=3>AES128-GCM</option><option translate value=4>AES192-GCM</option><option translate value=5>AES256-GCM</option><option ng-show=!isVN translate value=2>NONE</option></select></td></tr><tr><td ng-hide=\"sltCipher >= 3 && sltCipher <= 5\" translate>HMAC Algorithm</td><td><select convert-to-number name=hmac ng-hide=\"sltCipher >= 3 && sltCipher <= 5\" ng-model=sltHmac><option ng-show=!isVN translate value=0>SHA1</option><option translate value=1>SHA256</option><option translate value=3>SHA512</option><option ng-selected=\"sltCipher >= 3 && sltCipher <= 5\" ng-show=!isVN translate value=2>NONE</option></select></td></tr><tr><td translate>Certificate Authentication</td><td><input name=iRlyWin type=checkbox value=1></td></tr><tr><td colspan=2><br></td></tr><tr class=l2lca style=display:none><td colspan=2><b translate>Certificates Setup</b><br><hr size=1></td></tr><tr class=l2lca style=display:none><td translate valign=top>Certificate Source</td><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><input name=rdoCrtSrc onclick=clkCrtSrc() type=radio value=1><translate>Router generated certificates</translate></td></tr><tr><td><input name=rdoCrtSrc onclick=clkCrtSrc() type=radio value=0><translate>Uploading certificates to Router</translate></td></tr><tr class=generateCA style=display:none><td><input name=btnGenerate onclick=onClkGenerate() type=button value=\"{{ 'Generate' | translate }}\">&nbsp;<span id=generalSta></span></td></tr></table></td></tr><tr class=l2lca style=display:none><td colspan=2><br></td></tr><tr class=generateCA style=display:none><td translate valign=top>Generated certificates</td><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td width=30%><translate>Root Certificate</translate>:</td><td id=rootCA></td></tr><tr><td><translate>Server Certificate</translate>:</td><td id=serverCA></td></tr><tr><td><translate>Client Certificate</translate>:</td><td id=clientCA></td></tr><tr><td><translate>Trust Certificate</translate>:</td><td id=trustCA></td></tr><tr><td colspan=2><input name=btnDeleteAll onclick=onDeleteAll() type=button value=\"{{ 'Delete all certificates' | translate }}\"></td></tr></table></td></tr><tr class=UploadCA style=display:none><td></td><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td width=40%> <a href=# onclick=gotolct('/cgi-bin/V2X00.cgi?fid=1220') translate>Trust CA</a></td><td><select name=sltTrustCA size=1 style=width:120px><option translate value=0>default</option><script> var aryCrtNum=JSON.parse(\"[0,0]\".replace(/'/g,'\"'));var caIdx=0;var str=\"\";for(var i=0;i<aryCrtNum[0];i++){caIdx=i+1;str+=\"<option value=\"+caIdx+\">\"+gettext(\"Trusted CA\")+\"-\"+caIdx+\"</option>\";}document.write(str);</script></select></td></tr><tr><td> <a href=# onclick=gotolct('/cgi-bin/V2X00.cgi?fid=1210') translate>Server Certificate</a></td><td><select name=sltSrvCrt size=1 style=width:120px><option translate value=0>none</option><script>var aryLocCAname=JSON.parse(\"['---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---']\".replace(/'/g,'\"'));var str=\"\";for(var i=0;i<aryCrtNum[1];i++){caIdx=i+2;str+=\"<option value=\"+caIdx+\">\"+aryLocCAname[i]+\"</option>\";}document.write(str);</script></select></td></tr></table></td></tr><tr><td colspan=2><br></td></tr></table></td></tr></table><table><tr valign=top><td><b translate>Note</b>: <ol><li translate>OpenVPN on Vigor Router only support <b>TUN</b> device interface currently. So please setup corresponding configurations on the client side.</li></ol></td></tr></table><br><table align=center><tr><td><input class=btnw name=btnOk onclick=onClkBtnOk() type=button value=\"{{ 'OK' | translate }}\"></td></tr></table><input name=fid type=hidden value=2411><input name=reboot type=hidden value=0><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></div><div id=page2 style=\"display:none;text-align: left;\"><form method=post name=frmexport><table border=1 cellpadding=2 cellspacing=0 style=\"width: 100%;\"><tr><td><table style=\"padding:2% 5%;line-height: 24px;width: 100%;\"><tr style=\"vertical-align: baseline;\"><td style=\"width: 37%;\" translate>Remote Server</td><td><div class=flex-between><label for=\"\"><input name=rdoAction type=radio value=0><span translate>IP</span></label> &nbsp;<select name=sltRmtWAN onchange=onselwan(this) size=1 style=width:80px;></select>&nbsp;&nbsp;&nbsp; <select name=sltRmtSrv size=1 style=width:155px;></select></div><div class=flex-between><label for=\"\"><input name=rdoAction type=radio value=1><span translate>Domain</span></label><input maxlength=64 name=sDomain style=width:155px; type=text></div><div class=flex-between id=vpn-matcher style=\"display: none;\"><label for=\"\"><input name=rdoAction type=radio value=2><span translate>VPN Matcher</span></label></div></td></tr><tr><td translate>Transport Protocol</td><td><select name=sltProtocol onchange=changeProtocol() size=1 style=width:155px;><option translate value=tcp>TCP</option><option selected translate value=udp>UDP</option></select></td></tr><tr><td translate>Auto Dial-Out</td><td><input checked name=iAutoDial type=radio value=1>&nbsp;<translate>Enable</translate>&nbsp;&nbsp; <input name=iAutoDial type=radio value=0>&nbsp;<translate>Disable</translate></td></tr><tr><td translate>Set VPN as Default Gateway</td><td><input name=iVPNGW type=radio value=1>&nbsp;<translate>Enable</translate>&nbsp;&nbsp; <input checked name=iVPNGW type=radio value=0>&nbsp;<translate>Disable</translate></td></tr><tr><td translate>Cache password for auto reconnect</td><td><input checked name=iCcPwAtrcnt type=radio value=1>&nbsp;<translate>Enable</translate>&nbsp;&nbsp; <input name=iCcPwAtrcnt type=radio value=0>&nbsp;<translate>Disable</translate></td></tr><tr class=udp><td translate>UDP Ping</td><td><input name=iUDPPing type=text value=10>&nbsp;<translate>Seconds(s)</translate></td></tr><tr class=udp><td translate>UDP Ping exit</td><td><input name=iUDPPingExit type=text value=60>&nbsp;<translate>Seconds(s)</translate></td></tr><tr><td translate>File Name</td><td><input maxlength=20 name=sFilename style=width:155px; type=text>.ovpn</td></tr><tr class=oldui style=display:none><td colspan=2><hr size=1></td></tr><tr style=display:none><td translate>CA cert</td><td><input maxlength=20 name=sCAcrt style=width:155px; type=text>.crt</td></tr><tr class=client_area style=display:none><td translate>Client cert</td><td><input maxlength=20 name=sClientcrt style=width:155px; type=text>.crt</td></tr><tr class=client_area style=display:none><td translate>Client key</td><td><input maxlength=20 name=sClientkey style=width:155px; type=text>.key</td></tr><tr><td> <a href=# onclick=gotolct('/cgi-bin/sms.cgi?sProfileAct=mailshowpage') translate>Mail Profile</a>&nbsp;&nbsp;<select name=iMailProf style=width:138px></select></td><td><div><b translate>Mail Address</b>&nbsp;<input maxlength=64 name=sMailTo size=20 type=text>&nbsp;&nbsp; <input class=btn1 id=s