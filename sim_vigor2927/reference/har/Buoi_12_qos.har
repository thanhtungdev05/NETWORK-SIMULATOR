          "cookies": [],
          "content": {
            "size": 4641,
            "mimeType": "text/html",
            "compression": 2763,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700px><tr class=bandwidth><td class=title><b parent=\"{{ 'Bandwidth Management' | translate }} >> {{ 'Quality of Service' | translate }}\" sub-title translate></b><b><span><script> var bg=parent;var iProfileIdx=parseInt(\"1\");var sPresetModel=\"2927\";var sLTEmodulename='LTE';if(bg.SHOW_BDW_QOS_WAN2&&iProfileIdx==2&&(sPresetModel==\"2710\"||sPresetModel==\"2110\"))document.write(gettext(\"Backup WAN\")+\" \");else if((('1'==3&&!parseInt('1'))||('1'==5&&parseInt('1')))&&(parseInt('0')))document.write(gettext(sLTEmodulename)+\" \");else document.write(gettext(\"WAN\")+'1');</script></span></b></td></tr><tr><td><hr><form action=/cgi-bin/qos.cgi method=post name=frm1><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><input ) name=UdpBWCtrlEnb type=checkbox value=1>&nbsp;<translate>Enable UDP Bandwidth Control</translate></td></tr><tr><td> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<translate>Limited bandwidth Ratio</translate>&nbsp; <input name=UdpBWLimit onblur=UDPcheckRate() onkeypress=setTimeout('UDPrateLimit()',100) size=3 type=text value=\"25\"> &nbsp;% </td></tr><tr><td><input name=TcpAckPrEnb type=checkbox value=1>&nbsp;<translate>Outbound TCP ACK Prioritize</translate></td><td align=right></td><tr></table></td></tr></table><span ng-show=\"bHWProto && isHwAccelQosEnable && ('2927' == '2915' || '2927' == '2927') && ('1' == 1 || '1' == 2)\"><b translate>Note</b>: <ol><li translate>The above options will not work when Hardware Acceleration enabled.</li></ol></span><table align=center border=0 width=100%><tr align=center><td><input class=btnw name=btnOk onclick=onClkBtnOk() type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnCcl onclick=onClkBtnCcl() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table><br><input name=fid type=hidden><input name=webchange type=hidden value=0><input name=iProfileIdx type=hidden value=\"1\"><input name=sFormAuthStr type=hidden value=\"TOO7UwhiVtwiiWv\"></form><script>var bg=parent;var f=document.frm1;var QoSWanFlag=parseInt(\"8\");var ENABLE_QOS=(1<<0);var ENABLE_QOS_IN=(1<<1);var ENABLE_QOS_OUT=(1<<2);var ENABLE_QOS_BOTH=(1<<3);var ENABLE_QOS_UDP_BWCTRL=(1<<4);var ENABLE_QOS_TCPACK_PRIORITIZE=(1<<5);var iFixWanNum=parseInt(\"4\");var iUSBNum=parseInt(\"2\");var DualDslEnable=parseInt(\"0\");var bDualDSL=parseInt('0');var extra_vdsl_idx=iFixWanNum+iUSBNum;var aryTxtRate=[f.BwRate0,f.BwRate1,f.BwRate2];var QoSFlag=parseInt(\"3\");var aryClsRate=JSON.parse('[25,25,25]');var sBw0WanPhyMode=\"Ethernet\"; var aryPhyMode=[\"0\",\"0\",\"5\",\"6\",\"4\",\"4\"]; var aryWanUnit=[1,1];var aryWanBW=[\"100000\",\"100000\"];var aryQosFlag=['8','8','2','2','8','8'];if(sBw0WanPhyMode==\"Ethernet\"){aryPhyMode[0]=0;}else{aryPhyMode[0]=1;}angular.element(document).ready(function(){$scope.bHWProto=parseInt('1');$scope.isHwAccelQosEnable=parseInt('1');$scope.$apply();});initParameter();initWebChange();function initParameter(){onQoSDrctSlt();bg.setVle2Elmt(f.UdpBWCtrlEnb,QoSWanFlag&ENABLE_QOS_UDP_BWCTRL);bg.setVle2Elmt(f.TcpAckPrEnb,QoSWanFlag&ENABLE_QOS_TCPACK_PRIORITIZE);UDPcheckRate();}function UDPcheckRate(){var ratio=parseInt(f.UdpBWLimit.value);if(isNaN(ratio)){ratio=1;f.UdpBWLimit.value=1;}if(ratio>100){alert(gettext('The UDP Limited bandwidth Ratio can not exceed 100%'));}else if(ratio<1&&f.UdpBWCtrlEnb.checked){alert(gettext('The UDP Limited bandwidth Ratio can not set 0%'));}else{bg.setVle2Elmt(f.UdpBWLimit,ratio);}}function UDPrateLimit(){var arySch=[f.UdpBWLimit];var iSch,sSch;sSch=arySch[0].value;iSch=parseInt(sSch);if(iSch>100||iSch<1||isNaN(iSch)){arySch[0].value=sSch.substr(0,sSch.length-1);}else{arySch[0].value=iSch;}}function onClkBtnOk(){if(f.UdpBWLimit.value<1&&f.UdpBWCtrlEnb.checked){alert(gettext('The UDP Limited bandwidth Ratio can not set 0%'));return false;}if(checkWebChange()){f.webchange.value='1';}f.fid.value=2;f.submit();}function onQoSDrctSlt(){var idx=parseInt(\"1\");var enable=aryQosFlag[idx-1]&ENABLE_QOS;var drct1=aryQosFlag[idx-1]&ENABLE_QOS_OUT;var drct2=aryQosFlag[idx-1]&ENABLE_QOS_BOTH;if(enable==1&&(drct1!=0||drct2!=0)){f.TcpAckPrEnb.disabled=false;}else{f.TcpAckPrEnb.disabled=true;}}function onClkBtnCcl(){document.location=\"/cgi-bin/qos.cgi?sFormAuthStr=TOO7UwhiVtwiiWv&fid=0\";}</script></body></html>"
