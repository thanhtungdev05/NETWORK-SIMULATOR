
config system
	option hostname 'OpenWrt'
	option ttylogin '0'
	option log_file '/var/log/messages'
	option log_size '2048'
	option urandom_seed '0'
	option zonename 'Asia/Ho Chi Minh'
	option timezone 'ICT-7'
	option conloglevel '4'
	option log_remote '0'
	option wizard '1'
	option portal '0'

config timeserver 'ntp'
	option enabled '1'
        option enable_server '0'
	list server '0.openwrt.pool.ntp.org'
	list server '1.openwrt.pool.ntp.org'

config rngd
        option enabled '1'
        option device '/dev/hwrng'
