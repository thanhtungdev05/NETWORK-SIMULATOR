            "size": 42513,
            "mimeType": "text/html",
            "compression": 33527,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script><script src=/js/QoS.JS></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=850><tr><td><b ng-if=isBwTitle parent=\"{{ ('Bandwidth Management' | translate) }}\" sub-title translate>Quality of Service</b><b ng-if=!isBwTitle parent=\"{{ ('Applications' | translate) }}\" sub-title translate>Quality of Service</b><hr><form action=/cgi-bin/qos.cgi method=post name=frm1><div ng-if=scopeisHwAccelQosEnable style=\"margin-bottom: 15px;\"><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>Hardware QoS General Setup</b></td><td align=right class=red>|&nbsp; <a class=DenyLink href=javascript:ruOK() translate>Set to Factory Default</a>&nbsp;|</td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 width=100%><tr align=center><td translate>Index</td><td translate>Enable</td><td translate>Direction</td><td translate>Egress Bandwidth</td><td><translate>Class</translate> 1</td><td><translate>Class</translate> 2</td><td><translate>Class</translate> 3</td><td translate>Others</td><td translate>Status</td></tr><tr align=center ng-class-even=\"'row1' \" ng-class-odd=\"'row0' \" ng-repeat=\"info in hwAccQoSInfo.aryInfo\"><td ng-if=\"info.type === 'wan'\"><translate>WAN</translate>{{$index+1}}</td><td ng-if=\"info.type === 'lan'\"><translate>Port</translate>{{$index+1 - hwAccQoSInfo.wanNumber}}</td><td><input id=hwQoSChk_{{$index}} name=\"hwQoSEnb{{generate_HwAccQoS_suffix(info.type, $index)}}\" ng-click=enable_hwqos_handler() ng-disabled=!hwAccQoSInfo.hwAccEnable ng-model=info.enable type=checkbox value=1></td><td ng-if=\"info.type === 'wan'\" translate>Egress (Upload)</td><td ng-if=\"info.type === 'lan'\" translate>Egress (Download)</td><td><input max=999999 min=0 name=\"HwQoSBW{{generate_HwAccQoS_suffix(info.type, $index)}}\" ng-change=\"info.bandwidth = aryHwAccQoSDisplayObj[$index].bandwidth * (aryHwAccQoSDisplayObj[$index].unit == '0' ? 1 : 1000)\" ng-disabled=\"!hwAccQoSInfo.hwAccEnable || !info.enable\" ng-model=aryHwAccQoSDisplayObj[$index].bandwidth size=6 step=0.001 type=number><select name=\"HwQoSBWUnit{{generate_HwAccQoS_suffix(info.type, $index)}}\" ng-change=\"info.bandwidth = aryHwAccQoSDisplayObj[$index].bandwidth * (aryHwAccQoSDisplayObj[$index].unit == '0' ? 1 : 1000)\" ng-disabled=\"!hwAccQoSInfo.hwAccEnable || !info.enable\" ng-model=aryHwAccQoSDisplayObj[$index].unit style=height:22px;><option value=0>{{ 'Kbps' | translate }}</option><option value=1>{{ 'Mbps' | translate }}</option></select><input name=\"HwQoSBWKbps{{generate_HwAccQoS_suffix(info.type, $index)}}\" ng-disabled=\"!hwAccQoSInfo.hwAccEnable || !info.enable\" ng-hide=true ng-model=info.bandwidth type=number></td><td><input max=97 min=0 name=\"HwQoSBwRate0{{generate_HwAccQoS_suffix(info.type, $index)}}\" ng-blur=checkRate(0,$index) ng-change=\"info.bwRate[3] = 100-info.bwRate[0]-info.bwRate[1]-info.bwRate[2]\" ng-disabled=\"!hwAccQoSInfo.hwAccEnable || !info.enable\" ng-keyup=rateLimit($index) ng-model=info.bwRate[0] required size=2 type=number>% </td><td><input max=97 min=0 name=\"HwQoSBwRate1{{generate_HwAccQoS_suffix(info.type, $index)}}\" ng-blur=checkRate(1,$index) ng-change=\"info.bwRate[3] = 100-info.bwRate[0]-info.bwRate[1]-info.bwRate[2]\" ng-disabled=\"!hwAccQoSInfo.hwAccEnable || !info.enable\" ng-keyup=rateLimit($index) ng-model=info.bwRate[1] required size=2 type=number>% </td><td><input max=97 min=0 name=\"HwQoSBwRate2{{generate_HwAccQoS_suffix(info.type, $index)}}\" ng-blur=checkRate(2,$index) ng-change=\"info.bwRate[3] = 100-info.bwRate[0]-info.bwRate[1]-info.bwRate[2]\" ng-disabled=\"!hwAccQoSInfo.hwAccEnable || !info.enable\" ng-keyup=rateLimit($index) ng-model=info.bwRate[2] required size=2 type=number>% </td><td><input disabled max=100 min=0 name=\"HwQoSBwRate3{{generate_HwAccQoS_suffix(info.type, $index)}}\" ng-blur=checkRate(3,$index) ng-model=info.bwRate[3] ng-value=\"info.bwRate[3] = 100-info.bwRate[0]-info.bwRate[1]-info.bwRate[2]\" size=2 type=number>% </td><td> <a href=\"/cgi-bin/qos.cgi?sFormAuthStr=TOO7UwhiVtwiiWv&fid=8&iProfileIdx={{count_HwAccQoS_lanwan_index(info.type, $index)+1}}&hwqos={{info.type}}\" ng-click=status_link_click_handler(info.type) translate>Status</a></td></tr></table></td></tr></table><b translate>Note</b>: <ol><li ng-if=adminauth> <a href=\"/cgi-bin/ipnat.cgi?sFormAuthStr=TOO7UwhiVtwiiWv&fid=20&iAct=0\" translate>Please enable hardware acceleration so Hardware QoS will work.</a></li><li translate>Hardware QoS has higher priority than Software QoS.</li></ol></div><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>Software QoS General Setup</b></td><td align=right class=red ng-if=!scopeisHwAccelQosEnable>|&nbsp; <a class=DenyLink href=javascript:ruOK() translate>Set to Factory Default</a>&nbsp;|</td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 width=100%><tr align=center><td translate width=20>Index</td><td translate width=20>Enable</td><td translate width=80>Direction</td><td colspan=2 translate width=340>Ingress / Egress Bandwidth</td><td width=70><translate>Class</translate> 1</td><td width=70><translate>Class</translate> 2</td><td width=70><translate>Class</translate> 3</td><td translate width=70>Others</td><td translate width=50>Status</td><td></td></tr><script> var bg=parent;var MaxRule=MaxRule_cls1=MaxRule_cls2=MaxRule_cls3=MaxRule_cls5=0;var aryBgclr=[\"row0\",\"row1\"];var iUSBWAN=parseInt(\"1\");var WAN_NUM=parseInt(\"6\"); var iFixWanNum=parseInt(\"4\");var iUSBNum=parseInt(\"2\");var iSecUsbNum=parseInt(\"1\");var DualDslEnable=parseInt(\"0\");var bDualDSL=parseInt('0');var extra_vdsl_idx=iFixWanNum+iUSBNum;var idx_2nd_usb=iFixWanNum+iUSBNum-iSecUsbNum;var ENABLE_QOS=(1<<0);var ENABLE_QOS_IN=(1<<1);var ENABLE_QOS_OUT=(1<<2);var ENABLE_QOS_BOTH=(1<<3);var ENABLE_QOS_UDP_BWCTRL=(1<<4);var sPresetModel='2927';var bNewWLWAN=parseInt('1');var bWless=parseInt('0');var bDualWless5G=parseInt('0');var dslbonding=\"(nil)\";var sLTEmodulename='LTE';var aryQosFlag=['8','8','2','2','8','8'];var aryInSpeed=['100000','100000','0','0','100000','100000'];var aryOutSpeed=['100000','100000','0','0','100000','100000'];var aryDSLRate=['(nil)','(nil)'];var aryDSL1Rate=['(nil)','(nil)'];var aryDSLRate2=['(nil)','(nil)'];var aryClsRate0=['25','25','0','0','25','25'];var aryClsRate1=['25','25','0','0','25','25'];var aryClsRate2=['25','25','0','0','25','25'];var aryUdpBWLimit=['25','25','25','25','25','25'];var sBw0WanPhyMode=\"Ethernet\"; var aryPhyMode=[\"0\",\"0\",\"5\",\"6\",\"4\",\"4\"]; if(sBw0WanPhyMode==\"Ethernet\"||sBw0WanPhyMode==\"USB\"){aryPhyMode[0]=0;}else{aryPhyMode[0]=1;}var i,j,str=\"\";var iWan1IsXdsl='0';var sBw0BBandColor='red';for(i=0;i<WAN_NUM;i++){if(top.notSupportWAN.indexOf(i)!=-1)continue;if((bDualDSL&&extra_vdsl_idx==i&&DualDslEnable!=\"1\")||(iUSBNum==2&&iSecUsbNum==0&&idx_2nd_usb==(i+1)))continue;if(bNewWLWAN&&(i==2||i==3)&&!bWless&&!bDualWless5G)continue;else if(bNewWLWAN&&i==3&&!bDualWless5G)continue; str+=\"<tr align=center class='row\"+i%2+\"' id=wan\"+(i+1)+\" style=display:none>\";if((((i+1)==3&&!parseInt('1'))||((i+1)==5&&parseInt('1')))&&(parseInt('0')))str+=\"<td><a href='javascript: gotoQosGenSet(\"+(i+1)+\")'>\"+(!bg.SHOW_BDW_QOS_WAN2&&i==1?gettext(\"Backup WAN\"):gettext(sLTEmodulename))+\"</td>\";else str+=\"<td><a href='javascript: gotoQosGenSet(\"+(i+1)+\")'>\"+(!bg.SHOW_BDW_QOS_WAN2&&i==1?gettext(\"Backup WAN\"):gettext(\"WAN\")+(i+1))+\"</td>\"; str+=\"<td><input type=checkbox name=QoSEnb\"+i+\" value=1 onclick=chkQoS(\"+i+\")></td>\"; str+=\"<td><select name=QoSDrctSlt\"+i+\">\";str+=\"<option value=0>{{ 'Ingress' | translate }}</option>\";str+=\"<option value=1>{{ 'Egress' | translate }}</option>\";str+=\"<option value=2>{{ 'BOTH' | translate }}</option>\";str+=\"</select></td>\";if(i==0&&(aryPhyMode[i]==1||aryPhyMode[i]==3)){if(dslbonding==\"1\"){var urate=parseInt(aryDSLRate2[0])+parseInt(aryDSLRate[0]);var drate=parseInt(aryDSLRate2[1])+parseInt(aryDSLRate[1]);if(urate==0&&drate==0){ str+=\"<td>\"+\"--\"+gettext(\"Kbps\")+\"/</td><td>\"+\"--\"+gettext(\"Kbps\")+\"</td>\";}else{str+=\"<td>\"+bg.adv_format(urate/1000,2)+gettext(\"Kbps\")+\"/</td><td>\"+bg.adv_format(drate/1000,2)+gettext(\"Kbps\")+\"</td>\";}}else{if(aryDSLRate[0]==0&&aryDSLRate[1]==0){ str+=\"<td>\"+\"--\"+gettext(\"Kbps\")+\"/</td><td>\"+\"--\"+gettext(\"Kbps\")+\"</td>\";}else{str+=\"<td>\"+bg.adv_format(aryDSLRate[0]/1000,2)+gettext(\"Kbps\")+\"/</td><td>\"+bg.adv_format(aryDSLRate[1]/1000,2)+gettext(\"Kbps\")+\"</td>\";}}}else if(bDualDSL&&extra_vdsl_idx==i&&DualDslEnable==\"1\"){if(aryDSL1Rate[0]==0&&aryDSL1Rate[1]==0){ str+=\"<td>\"+\"--\"+gettext(\"Kbps\")+\"/</td><td>\"+\"--\"+gettext(\"Kbps\")+\"</td>\";}else{str+=\"<td>\"+bg.adv_format(aryDSL1Rate[0]/1000,2)+gettext(\"Kbps\")+\"/</td><td>\"+bg.adv_format(aryDSL1Rate[1]/1000,2)+gettext(\"Kbps\")+\"</td>\";}}else{str+=\"<td><input type=text size=6 name=WanInBW\"+i+\">\";str+=\"<select name=WanInBWUnit\"+i+\" style=height:22px;>\";str+=\"<option value=0>{{ 'Kbps' | translate }}</option>\";str+=\"<option value=1>{{ 'Mbps' | translate }}</option></select>\"+\"<b>/</b>\"+\"</td>\";str+=\"<td><input type=text size=6 name=WanOutBW\"+i+\">\";str+=\"<select name=WanOutBWUnit\"+i+\" style=height:22px;>\";str+=\"<option value=0>{{ 'Kbps' | translate }}</option>\";str+=\"<option value=1>{{ 'Mbps' | translate }}</option></select></td>\";} str+=\"<td><input type=text size=2 name=BwRate0\"+i+\" onblur=checkRate(0,\"+i+\") onkeypress=setTimeout('rateLimit(\"+i+\")',100)>\"+\"%\"+\"</td>\";str+=\"<td><input type=text size=2 name=BwRate1\"+i+\" onblur=checkRate(1,\"+i+\") onkeypress=setTimeout('rateLimit(\"+i+\")',100)>\"+\"%\"+\"</td>\";str+=\"<td><input type=text size=2 name=BwRate2\"+i+\" onblur=checkRate(2,\"+i+\") onkeypress=setTimeout('rateLimit(\"+i+\")',100)>\"+\"%\"+\"</td>\";str+=\"<td><input type=text size=2 name=BwRate3\"+i+\" disabled>\"+\"%\"+\"</td>\"; str+=\"<td><a href='/cgi-bin/qos.cgi?sFormAuthStr=TOO7UwhiVtwiiWv&fid=8&iProfileIdx=\"+(i+1)+\"'>\"+gettext(\"Status\")+\"</a></td>\"; str+=\"</tr>\";}document.write(str);</script></table></td></tr></table><b translate>Note</b>: <ol><li translate>QoS may not work properly if the bandwidth entered is not correct.Before enable QoS, you may run speed test (from e.g.,http://speedtest.net) or contact your ISP for the accurate bandwidth.</li><li ng-show=\"bHWProto && isHwAccelQosEnable && bGRX500\" translate>When Hardware Acceleration enabled, the QoS performance will increase. However, the reserved bandwidth of each class will be fixed, and could not release for others even when not fully used.</li></ol><br><table align=center border=0 cellpadding=0 cellspacing=0 width=100%><tr><td><b translate>Class Rule</b></td></tr><tr><td><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 id=class_rule_table width=100%><tr align=center><th translate width=80>Index</th><th translate width=80>Enable</th><th translate width=100>QoS Class</th><th translate width=150>Local Address</th><th translate width=150>Remote Address</th><th translate width=100>DSCP</th><th translate width=120>Service Type</th></tr><script>var MAX_CLSRULE_NUM=20;var allIPv6Vle=JSON.parse(\"[]\".replace(/'/g,'\"'));var aryFlag=JSON.parse(\"[]\".replace(/'/g,'\"'));var aryRuleSrcIPv6S=new Array();var aryRuleSrcIPv6E=new Array();var aryRuleSrcIPv6M=new Array();var aryRuleDstIPv6S=new Array();var aryRuleDstIPv6E=new Array();var aryRuleDstIPv6M=new Array();for(var m=0;m<MAX_CLSRULE_NUM;m++){aryRuleSrcIPv6S[m]=allIPv6Vle[m][0];aryRuleSrcIPv6E[m]=allIPv6Vle[m][1];aryRuleSrcIPv6M[m]=allIPv6Vle[m][2];aryRuleDstIPv6S[m]=allIPv6Vle[m][3];aryRuleDstIPv6E[m]=allIPv6Vle[m][4];aryRuleDstIPv6M[m]=allIPv6Vle[m][5];}function ipgoItemNameHandler(tables,itemIdxAry,orderSet){var tmpStr=\"\";var splitSign=\", \";var sctIdx; sctIdx=tranIPGOItemIdx2SctIdx(tables[0],itemIdxAry[orderSet[0]]);tmpStr+=(sctIdx==0)?\"\":(tables[0][sctIdx-1][1]+splitSign);sctIdx=tranIPGOItemIdx2SctIdx(tables[0],itemIdxAry[orderSet[1]]);tmpStr+=(sctIdx==0)?\"\":(tables[0][sctIdx-1][1]+splitSign); sctIdx=tranIPGOItemIdx2SctIdx(tables[1],itemIdxAry[orderSet[2]]);tmpStr+=(sctIdx==0)?\"\":(tables[1][sctIdx-1][1]+splitSign);sctIdx=tranIPGOItemIdx2SctIdx(tables[1],itemIdxAry[orderSet[3]]);tmpStr+=(sctIdx==0)?\"\":(tables[1][sctIdx-1][1]+splitSign);tmpStr=tmpStr.substring(0,tmpStr.lastIndexOf(splitSign));return tmpStr;}function clsrule_rsip(rflag,ips,ipe,ipm,itemIdxAry){tmp=gettext(\"Any\");if(rflag&QOS_RULE_SRC_ANY)tmp=gettext(\"Any\");if(rflag&QOS_RULE_SRC_SGL)tmp=ips;if(rflag&QOS_RULE_SRC_RNG)tmp=ips+\" ~ \"+ipe;if(rflag&QOS_RULE_SRC_MSK)tmp=ips+\"<br>(\"+gettext(\"mask\")+\":\"+ipm+\")\";if((rflag&QOS_RULE_SRC_IPGO)&&(itemIdxAry.length!=0)){var splitSign=\", \";var sctIdx;if((rflag&QOS_RULE_IPV6)==0){ tmp=ipgoItemNameHandler([availIPGrpTable,availIPObjTable],itemIdxAry,[2,3,0,1]);}else{ tmp=ipgoItemNameHandler([availIPv6GrpTable,availIPv6ObjTable],itemIdxAry,[2,3,0,1]);}}return tmp;}function clsrule_rdip(rflag,ips,ipe,ipm,itemIdxAry){tmp=gettext(\"Any\");if(rflag&QOS_RULE_DST_ANY)tmp=gettext(\"Any\");if(rflag&QOS_RULE_DST_SGL)tmp=ips;if(rflag&QOS_RULE_DST_RNG)tmp=ips+\" ~ \"+ipe;if(rflag&QOS_RULE_DST_MSK)tmp=ips+\"<br>(\"+gettext(\"mask\")+\":\"+ipm+\")\";if(rflag&QOS_RULE_DST_IPGO&&(itemIdxAry.length!=0)){var splitSign=\", \";var sctIdx;if((rflag&QOS_RULE_IPV6)==0){ tmp=ipgoItemNameHandler([availIPGrpTable,availIPObjTable],itemIdxAry,[6,7,4,5]);}else{ tmp=ipgoItemNameHandler([availIPv6GrpTable,availIPv6ObjTable],itemIdxAry,[6,7,4,5]);}}return tmp;}function clsrule_tr(clsidx,rflag,rsip_s,rsip_e,rsip_m,rdip_s,rdip_e,rdip_m,dscpopt,stype,ruleItemIdxAry){var str=\"<tr align=center class='\"+aryBgclr[MaxRule%2]+\" class\"+clsidx+\"'\"+\">\"; str+=\"<td><a href=# onclick=onEdtRule(\"+clsidx+\",\"+MaxRule+\")>\"+MaxRule+\"</a></td><td>&nbsp;\";str+=\"<input type=checkbox \"+((rflag&QOS_RULE_ENABLE)?\"checked\":\"\")+\" name='FW_status\"+(MaxRule-1)+\"' value='1'> \"; if(clsidx==5)str+=\"</td><td>\"+gettext(\"Priority Class\")+\"</td>\";else str+=\"</td><td>\"+gettext(\"Class\")+clsidx+\"</td>\";str+=\"<td >&nbsp;\"+clsrule_rsip(rflag,rsip_s,rsip_e,rsip_m,ruleItemIdxAry)+\"</td>\";str+=\"<td>&nbsp;\"+clsrule_rdip(rflag,rdip_s,rdip_e,rdip_m,ruleItemIdxAry);str+='</td><td class=\"dscp'+clsidx+'\">&nbsp;'+gettext(dscpopt)+\"</td>\";str+=\"<td>&nbsp;\"+((rflag&QOS_RULE_IPV6)?gettext(\"IPv6\")+\" \":\"\")+gettext(bg.htmlEntityDecode(SrvTypeName(stype-1,rflag,arySerType),document))+\"</td></tr>\";return str;}</script><tr align=center class=row0 id=tradd><td colspan=7><input class=btnw3 onclick=onClkBtnAdd() type=button value=\"{{ 'Add' | translate }}\"></td></tr></table></td></tr></table></td></tr></table><b translate>Note</b>: <ol><li ng-show=THE_PACKET translate>The packets that don't match any class rules above will be classified into 'Others'.</li><li id=link_note ng-show=GO_TO translate>Go to <a>User Defined Service Type</a> to edit/delete user-defined service type profiles.</li><li ng-show=HARDWARE_ACC translate>Hardware Acceleration will not work on wired WAN interfaces with QoS enabled.</li><li ng-show=INBOUND_QOS translate>Inbound Qos will not work when Hardware Acceleration enabled.</li></ol><br><table align=center border=1 cellpadding=0 cellspacing=0 style=display:none; width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 width=100%><tr align=center><th translate width=80>Index</th><th translate width=400>Name</th><th translate width=100>Rule</th><th translate width=120>Service Type</th></tr><tr align=center class=row0><td><translate>Class</translate> 1</td><td>&nbsp;</td><td> <a href=\"javascript: gotoQosClsRule(1)\" translate>Edit</a></td><td rowspan=3> <a href=\"javascript: gotoSvcTypEdit()\" translate>Edit</a></td></tr><tr align=center class=row1><td><translate>Class</translate> 2</td><td>&nbsp;</td><td> <a href=\"javascript: gotoQosClsRule(2)\" translate>Edit</a></td></tr><tr align=center class=row0><td><translate>Class</translate> 3</td><td>&nbsp;</td><td> <a href=\"javascript: gotoQosClsRule(3)\" translate>Edit</a></td></tr></table></td></tr></table><br><table align=center border=0 cellpadding=0 cellspacing=0 id=qosvoip style=display:none width=100%><tr><td><b translate>VoIP Prioritization</b></td></tr><tr><td><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 width=100%><tr><td width=90%><input name=enableQosVoIPPort onclick=chkQoSVoIPPort() type=checkbox value=1>&nbsp;<b translate>Enable the First Priority for VoIP SIP/RTP</b>:</td><td align=left rowspan=2><img id=qosvoipstatus onclick=onClkQosVoipStaus() src=#></td></tr><tr id=sipudpport><td> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<translate>SIP UDP Port</translate>:<input name=QosVoIPPort size=4 type=text value=\"5060\">(<translate>Default</translate>:5060) </td></tr></table></td></tr></table></td></tr></table><br><table align=center border=0 cellpadding=0 cellspacing=0 width=100%><tr><td><b translate>Tag Outbound Traffic</b></td></tr><tr><td><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 width=100%><tbody ng-repeat=\"i in [].constructor(3) track by $index\"><tr><td align=center width=20%><translate>Class</translate>&nbsp;{{$index+1}}</td><td><input name=sTag{{$index}}En type=checkbox value=1>&nbsp;&nbsp; <translate>Add DSCP or Precedence Value</translate>&nbsp;&nbsp; <select name=sDscp{{$index}}Idx><option translate value=0>Default</option><option value=1>{{ 'IP precedence' | translate }} 1</option><option value=2>{{ 'IP precedence' | translate }} 2</option><option value=3>{{ 'IP precedence' | translate }} 3</option><option value=4>{{ 'IP precedence' | translate }} 4</option><option value=5>{{ 'IP precedence' | translate }} 5</option><option value=6>{{ 'IP precedence' | translate }} 6</option><option value=7>{{ 'IP precedence' | translate }} 7</option><option value=8>{{ 'AF Class' | translate }}1 ({{ 'Low Drop' | translate }})</option><option value=9>{{ 'AF Class' | translate }}1 ({{ 'Medium Drop' | translate }})</option><option value=10>{{ 'AF Class' | translate }}1 ({{ 'High Drop' | translate }})</option><option value=11>{{ 'AF Class' | translate }}2 ({{ 'Low Drop' | translate }})</option><option value=12>{{ 'AF Class' | translate }}2 ({{ 'Medium Drop' | translate }})</option><option value=13>{{ 'AF Class' | translate }}2 ({{ 'High Drop' | translate }})</option><option value=14>{{ 'AF Class' | translate }}3 ({{ 'Low Drop' | translate }})</option><option value=15>{{ 'AF Class' | translate }}3 ({{ 'Medium Drop' | translate }})</option><option value=16>{{ 'AF Class' | translate }}3 ({{ 'High Drop' | translate }})</option><option value=17>{{ 'AF Class' | translate }}4 ({{ 'Low Drop' | translate }})</option><option value=18>{{ 'AF Class' | translate }}4 ({{ 'Medium Drop' | translate }})</option><option value=19>{{ 'AF Class' | translate }}4 ({{ 'High Drop' | translate }})</option><option value=20>{{ 'EF Class' | translate }}</option></select></td></tr></tbody></table></td></tr></table></td></tr></table><input name=fid type=hidden><input name=act type=hidden><input name=iQosRuleSetIdx type=hidden><input name=iQosCls1Rule type=hidden><input name=iQosCls2Rule type=hidden><input name=iQosCls3Rule type=hidden><input name=iQosCls5Rule type=hidden><input name=iQoslastCls type=hidden value=0><input nam