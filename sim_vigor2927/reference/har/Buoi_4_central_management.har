            "compression": 3079,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><meta content=\"60; URL=/cgi-bin/cgiapm.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=7&sFormAuthStr=JdvKVyYlhh7GhS9\" http-equiv=Refresh><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/chart.min.js?094907\"></script><script> angular.extend({browser:{msie:/msie/.test(navigator.userAgent.toLowerCase())}});</script><style>\n.chart-container {width:700px;height:160px;position:relative;}\n.chart {width: 100%;height: 100%;position: absolute;}\n.legend-container {z-index: 9;display:inline-block;right: 95px;top: 30px;background:rgba(255,255,255,0.6);border: 1px solid #ccc;position: absolute;font-size: .75em;}\n</style></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'AP' | translate }}\" sub-title translate>Total Traffic</b><hr><form name=frm1><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td align=right class=red>|&nbsp;  <a href=javascript:Refresh() translate>Refresh</a>&nbsp;|</td></tr></table><div class=chart-container><div class=chart><canvas id=\"chart\"></canvas></div><div align=center class=legend-container id=trafficLegend></div></div><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form><b translate>Note</b>: <ol><li id=html5 translate>Only browser supporting <a>HTML5</a> can display Total Traffic correctly.</li></ol></td></tr></table><textarea id=apmtrffinit style=display:none>\n\tvar aryAPMTraffic_org =  [];\n</textarea><script>var f=document.frm1;var bg=parent; var apmtrffinitScript=document.createElement(\"script\");apmtrffinitScript.text=document.getElementById(\"apmtrffinit\").value;document.head.appendChild(apmtrffinitScript);var aryAPMTraffic=new Array();var aryData=new Array(4);var aryDevName=new Array();var barData=new Object();const trafficLegendPlugin={id:'htmlLegend',beforeUpdate(chart,args,options){const container=document.getElementById(options.containerID); while(container.firstChild)container.firstChild.remove(); const items=chart.options.plugins.legend.labels.generateLabels(chart);items.forEach(item=>{ const boxSpan=document.createElement('td');boxSpan.style.height='8px';boxSpan.style.width='10px';boxSpan.style.background=item.fillStyle;boxSpan.style.display='inline-block';boxSpan.style.margin='0 4px'; const textContainer=document.createElement('td');textContainer.style.color=item.fontColor;textContainer.style.margin='1px';textContainer.style.padding='1px 0 0';textContainer.style.whiteSpace='nowrap';textContainer.style.textAlign='left';const text=document.createTextNode(item.text);textContainer.appendChild(text);const tr=document.createElement('tr');tr.align='center';tr.style.marginLeft='1px';tr.appendChild(boxSpan);tr.appendChild(textContainer);container.appendChild(tr);});},afterDatasetsDraw(chart,args,options){const{ctx,chartArea:{left,top,width,height}}=chart;ctx.save();ctx.strokeStyle='rgba(0, 0, 0, 0.3)';ctx.lineWidth='2';ctx.strokeRect(left,top,width,height);ctx.restore();},};angular.element(document).ready(function(){parseTrafficData();constructChart();angular.element(document.querySelector(\"#html5 a\")).attr(\"href\",'///en.wikipedia.org/wiki/HTML5');});function parseTrafficData(){var i,j;for(i=0,j=0;i<aryAPMTraffic_org.length;i++){if(aryAPMTraffic_org[i][6]==\"AP800\")continue;aryAPMTraffic[j++]=aryAPMTraffic_org[i];}for(var m=0;m<aryData.length;m++){aryData[m]=new Array();for(var i=0;i<aryAPMTraffic.length;i++){aryDevName[i]=[aryAPMTraffic[i][0],aryAPMTraffic[i][1].substring(0,20)]; aryData[m][i]=aryAPMTraffic[i][m+2];}}}function getMaxStatNum(aryData){return Math.max(...[].concat([].concat(...aryData)));}function getMinStatNum(aryData){return Math.min(...[].concat([].concat(...aryData)));}function constructChart(){var legendLabels=[gettext(\"LAN\")+\" A Tx(MB)\",gettext(\"LAN\")+\" A Rx(MB)\",gettex