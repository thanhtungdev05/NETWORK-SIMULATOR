e align=center width=100%><tr align=center><td><input class=btnw name=btnOK onClick=submitPara() type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnCcl onClick=onbtnCcl() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table><input name=fid type=hidden value=1><input name=iAct type=hidden value=1><input name=iUserMgtProIdx type=hidden><input name=iPageIdx type=hidden value=\"1\"><input name=iprofileNum type=hidden><input name=sSearchKey type=hidden value=\"\"><input name=webchange type=hidden value=0><script>var str=\"\";for(var i=0;i<aryProfName.length;i++){var j=aryProfName[i][1];str+=\"<input type=hidden name=istateidx\"+i+\" value=\"+j+\">\";}document.write(str);</script><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></td></tr></table><script>top.ACTION_STATUS=-1;top.iActionStatusFlag='1';top.iFwUpgradeState='0';top.act_sta.damage_alert();var bg=parent;var f=document.frm1;angular.element(document).ready(function(){$scope.sPresetModel=sPresetModel;$scope.modelis3200=\"2927\"=='3200';$scope.$apply();initParameter();initWebChange();});function initParameter(){f.iprofileNum.value=aryProfName.length;for(var i=0;i<aryProfName.length;i++){if(aryProfName[i][1]=='0'||aryProfName[i][1]=='1')f[\"istate\"+aryProfName[i][1]].disabled=true;else if((parseInt('0'))&&(aryProfName[i][1]=='2'||aryProfName[i][1]=='3'))f[\"istate\"+aryProfName[i][1]].disabled=true;if(aryProfName[i][2]=='1')f[\"istate\"+i].checked=true;else f[\"istate\"+i].checked=false;}}function ruOK(){if(confirm(gettext('All User Groups will be removed from your selected lists.\\nDo you want to clear all profiles?'))){f.webchange.value='1';f.iAct.value=3;f.iPageIdx.value=1;f.submit();}}function gotoDetailSet(idx){f.iAct.value=1;f.iUserMgtProIdx.value=idx;f.submit();}function gotoPage(idx){f.iAct.value=0;f.iPageIdx.value=idx;f.SearchMsg.value=f.sSearchKey.value;f.submit();}function submitPara(){for(var i=0;i<aryProfName.length;i++)f[\"istate\"+i].disabled=false;if(checkWebChange()){f.webchange.value='1';}f.iAct.value=6;f.SearchMsg.value=f.sSearchKey.value;f.submit();}function onbtnCcl(){f.SearchMsg.value=f.sSearchKey.value;f.iAct.value=0;f.submit();}function onSearch(){f.iPageIdx.value=1;f.iAct.value=7;f.submit();}function onSelAll(){for(var i=0;i<aryProfName.length;i++){if(aryProfName[i][0]!=\"\")f[\"istate\"+i].checked=true;}}function onClrAll(){for(var i=0;i<aryProfName.length;i++){if(aryProfName[i][0]!=\"admin\"&&aryProfName[i][0]!=\"Dial-In User\")f[\"istate\"+i].checked=false;}}function onclkStat(_idx){var idx=_idx;if(aryProfName[idx][0]==\"\"){alert(gettext('User Profile cannot be empty. The corresponding profile cannot be enabled.'));f[\"istate\"+idx].checked=false;}}</script></body></html>"
