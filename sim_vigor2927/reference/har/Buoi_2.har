            "mimeType": "text/html",
            "compression": 17787,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/dhtml.min.js?094907\"></script><style>\n\t.flex-between {\n\t\tdisplay: flex;\n\t\tjustify-content: space-between;\n\t\twidth: 75%;\n\t\theight: 21px;\n\t\talign-items: center;\n\t\tpadding:2px 0;\n\t}\n</style></head><body class=ng-cloak><textarea id=openvpninit style=\"display: none;\">\n\tvar aryWanInfo = [[1,\"red\",\"---\"],[2,\"red\",\"---\"],[3,\"red\",\"---\"],[4,\"red\",\"---\"],[5,\"red\",\"---\"],[6,\"red\",\"---\"]];\n\tvar bWan2IsDisable = parseInt('0');\n\tvar aryCrtIdx = [0,0];\n\tvar aryGenerateCA = ['None',0,'None',0,'None',0,'None',0];\n\tvar aryMail = [\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\"];\n\tvar aryWANaliasIP = [[[0,'---']],[[0,'---']],[],[],[],[]];\n\tvar iCipher = '1';\n\tvar iHmac = '1';\n\tvar sLTEmodulename = 'LTE';\n</textarea><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td colspan=2><b parent=\"{{ 'VPN and Remote Access' | translate }}\" qslink=\"https://www.draytek.com/router-help-redirect?stk_title=VPN and Remote Access&nd_title=OpenVPN\" sub-title translate>OpenVPN</b><hr><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td class=offtab id=tab1 onClick=dhtml.cycleTab(this.id);parent.sOpenVPNTag=this.id; width=26%><b translate>OpenVPN Server Setup</b></td><td class=offtab id=tab2 onClick=dhtml.cycleTab(this.id);parent.sOpenVPNTag=this.id; width=20%><b translate>Client Config</b></td><td class=offtab id=tab3 onClick=dhtml.cycleTab(this.id);parent.sOpenVPNTag=this.id; width=20%><b translate>Import Certificate</b></td><td class=tabpadding></td></tr></table><div id=page1 style=\"display:none;text-align: left\"><form action=/cgi-bin/v2x00.cgi method=post name=frm1><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=90%><tr><td colspan=2><br></td></tr><tr><td colspan=2><b translate>General Setup</b><br><hr size=1></td></tr><tr><td translate width=30%>UDP</td><td><input name=iUdpEn type=checkbox value=1>&nbsp;<translate>Enable</translate></td></tr><tr><td translate width=30%>UDP Port</td><td><input name=iPort type=text value=\"1194\"></td></tr><tr><td translate>TCP</td><td><input name=iTcpEn type=checkbox value=1>&nbsp;<translate>Enable</translate></td></tr><tr><td translate width=30%>TCP Port</td><td><input name=iTcpPort type=text value=\"1194\"></td></tr><tr><td translate>Cipher Algorithm</td><td><select convert-to-number name=cipher ng-model=sltCipher><option translate value=0>AES128-CBC</option><option translate value=1>AES256-CBC</option><option translate value=3>AES128-GCM</option><option translate value=4>AES192-GCM</option><option translate value=5>AES256-GCM</option><option ng-show=!isVN translate value=2>NONE</option></select></td></tr><tr><td ng-hide=\"sltCipher >= 3 && sltCipher <= 5\" translate>HMAC Algorithm</td><td><select convert-to-number name=hmac ng-hide=\"sltCipher >= 3 && sltCipher <= 5\" ng-model=sltHmac><option ng-show=!isVN translate value=0>SHA1</option><option translate value=1>SHA256</option><option translate value=3>SHA512</option><option ng-selected=\"sltCipher >= 3 && sltCipher <= 5\" ng-show=!isVN translate value=2>NONE</option></select></td></tr><tr><td translate>Certificate Authentication</td><td><input name=iRlyWin type=checkbox value=1></td></tr><tr><td colspan=2><br></td></tr><tr class=l2lca style=display:none><td colspan=2><b translate>Certificates Setup</b><br><hr size=1></td></tr><tr class=l2lca style=display:none><td translate valign=top>Certificate Source</td><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><input name=rdoCrtSrc onclick=clkCrtSrc() type=radio value=1><translate>Router generated certificates</translate></td></tr><tr><td><input name=rdoCrtSrc onclick=clkCrtSrc() type=radio value=0><translate>Uploading certificates to Router</translate></td></tr><tr class=generateCA style=display:none><td><input name=btnGenerate onclick=onClkGenerate() type=button value=\"{{ 'Generate' | translate }}\">&nbsp;<span id=generalSta></span></td></tr></table></td></tr><tr class=l2lca style=display:none><td colspan=2><br></td></tr><tr class=generateCA style=display:none><td translate valign=top>Generated certificates</td><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td width=30%><translate>Root Certificate</translate>:</td><td id=rootCA></td></tr><tr><td><translate>Server Certificate</translate>:</td><td id=serverCA></td></tr><tr><td><translate>Client Certificate</translate>:</td><td id=clientCA></td></tr><tr><td><translate>Trust Certificate</translate>:</td><td id=trustCA></td></tr><tr><td colspan=2><input name=btnDeleteAll onclick=onDeleteAll() type=button value=\"{{ 'Delete all certificates' | translate }}\"></td></tr></table></td></tr><tr class=UploadCA style=display:none><td></td><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td width=40%> <a href=# onclick=gotolct('/cgi-bin/V2X00.cgi?fid=1220') translate>Trust CA</a></td><td><select name=sltTrustCA size=1 style=width:120px><option translate value=0>default</option><script> var aryCrtNum=JSON.parse(\"[0,0]\".replace(/'/g,'\"'));var caIdx=0;var str=\"\";for(var i=0;i<aryCrtNum[0];i++){caIdx=i+1;str+=\"<option value=\"+caIdx+\">\"+gettext(\"Trusted CA\")+\"-\"+caIdx+\"</option>\";}document.write(str);</script></select></td></tr><tr><td> <a href=# onclick=gotolct('/cgi-bin/V2X00.cgi?fid=1210') translate>Server Certificate</a></td><td><select name=sltSrvCrt size=1 style=width:120px><option translate value=0>none</option><script>var aryLocCAname=JSON.parse(\"['---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---','---']\".replace(/'/g,'\"'));var str=\"\";for(var i=0;i<aryCrtNum[1];i++){caIdx=i+2;str+=\"<option value=\"+caIdx+\">\"+aryLocCAname[i]+\"</option>\";}document.write(str);</script></select></td></tr></table></td></tr><tr><td colspan=2><br></td></tr></table></td></tr></table><table><tr valign=top><td><b translate>Note</b>: <ol><li translate>OpenVPN on Vigor Router only support <b>TUN</b> device interface currently. So please setup corresponding configurations on the client side.</li></ol></td></tr></table><br><table align=center><tr><td><input class=btnw name=btnOk onclick=onClkBtnOk() type=button value=\"{{ 'OK' | translate }}\"></td></tr></table><input name=fid type=hidden value=2411><input name=reboot type=hidden value=0><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></div><div id=page2 style=\"display:none;text-align: left;\"><form method=post name=frmexport><table border=1 cellpadding=2 cellspacing=0 style=\"width: 100%;\"><tr><td><table style=\"padding:2% 5%;line-height: 24px;width: 100%;\"><tr style=\"vertical-align: baseline;\"><td style=\"width: 37%;\" translate>Remote Server</td><td><div class=flex-between><label for=\"\"><input name=rdoAction type=radio value=0><span translate>IP</span></label> &nbsp;<select name=sltRmtWAN onchange=onselwan(this) size=1 style=width:80px;></select>&nbsp;&nbsp;&nbsp; <select name=sltRmtSrv size=1 style=width:155px;></select></div><div class=flex-between><label for=\"\"><input name=rdoAction type=radio value=1><span translate>Domain</span></label><input maxlength=64 name=sDomain style=width:155px; type=text></div><div class=flex-between id=vpn-matcher style=\"display: none;\"><label for=\"\"><input name=rdoAction type=radio value=2><span translate>VPN Matcher</span></label></div></td></tr><tr><td translate>Transport Protocol</td><td><select name=sltProtocol onchange=changeProtocol() size=1 style=width:155px;><option translate value=tcp>TCP</option><option selected translate value=udp>UDP</option></select></td></tr><tr><td translate>Auto Dial-Out</td><td><input checked name=iAutoDial type=radio value=1>&nbsp;<translate>Enable</translate>&nbsp;&nbsp; <input name=iAutoDial type=radio value=0>&nbsp;<translate>Disable</translate></td></tr><tr><td translate>Set VPN as Default Gateway</td><td><input name=iVPNGW type=radio value=1>&nbsp;<translate>Enable</translate>&nbsp;&nbsp; <input checked name=iVPNGW type=radio value=0>&nbsp;<translate>Disable</translate></td></tr><tr><td translate>Cache password for auto reconnect</td><td><input checked name=iCcPwAtrcnt type=radio value=1>&nbsp;<translate>Enable</translate>&nbsp;&nbsp; <input name=iCcPwAtrcnt type=radio value=0>&nbsp;<translate>Disable</translate></td></tr><tr class=udp><td translate>UDP Ping</td><td><input name=iUDPPing type=text value=10>&nbsp;<translate>Seconds(s)</translate></td></tr><tr class=udp><td translate>UDP Ping exit</td><td><input name=iUDPPingExit type=text value=60>&nbsp;<translate>Seconds(s)</translate></td></tr><tr><td translate>File Name</td><td><input maxlength=20 name=sFilename style=width:155px; type=text>.ovpn</td></tr><tr class=oldui style=display:none><td colspan=2><hr size=1></td></tr><tr style=display:none><td translate>CA cert</td><td><input maxlength=20 name=sCAcrt style=width:155px; type=text>.crt</td></tr><tr class=client_area style=display:none><td translate>Client cert</td><td><input maxlength=20 name=sClientcrt style=width:155px; type=text>.crt</td></tr><tr class=client_area style=display:none><td translate>Client key</td><td><input maxlength=20 name=sClientkey style=width:155px; type=text>.key</td></tr><tr><td> <a href=# onclick=gotolct('/cgi-bin/sms.cgi?sProfileAct=mailshowpage') translate>Mail Profile</a>&nbsp;&nbsp;<select name=iMailProf style=width:138px></select></td><td><div><b translate>Mail Address</b>&nbsp;<input maxlength=64 name=sMailTo size=20 type=text>&nbsp;&nbsp; <input class=btn1 id=sMail onclick=onExport(this) type=button value=\"{{ 'Send Email' | translate }}\"></div></td></tr><tr><td><input name=cipher2 type=hidden value=aes-256-cbc><input name=hmac2 type=hidden value=sha256><input name=sRmtSrv type=hidden value></td></tr></table></td></tr></table><table width=100%><tr><td><b translate>Note</b>: <ol><li translate>Please make sure the Client cert and the Client key are located in the same folder with .ovpn file.</li><li translate>Please make sure that WAN can be used as OpenVPN server.</li><li translate>Cache password for auto reconnect.</li><li translate>Enabled:Cache password in virtual memory for re-authentication to keep VPN always connected.</li><li translate>Disabled:Type password manually when re-authentication needed. VPN may disconnect during re-authentication.</li></ol></td></tr><tr><td align=center><input class=btnw3 onclick=onExport(this) type=button value=\"{{ 'Export' | translate }}\"></td></tr></table></form></div><div id=page3 style=\"display: none\"><form action=\"/ovpnCfgImp.cgi?sFormAuthStr=JdvKVyYlhh7GhS9\" enctype=multipart/form-data method=POST name=frmImp target=OpenVPNSender><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=90%><tr><td colspan=2><br></td></tr><tr><td colspan=2><b translate>Import OpenVPN config file</b></td></tr><tr><td>&nbsp; &nbsp;</td><td><b translate>Note</b>: <ol><li translate>TLS-auth key won't be deleted even you load the .rst firmware.</li><li translate>Please clear the LAN-to-LAN Profile if you want to delete the TLS-auth key.</li></ol></td></tr><tr><td>&nbsp; &nbsp;</td><td translate>Select a OpenVPN config file.</td></tr><tr><td>&nbsp; &nbsp;</td><td><input class=file id=opcfg_file name=opcfg_file size=60 type=file></td></tr><tr><td>&nbsp; &nbsp;</td><td id=link_clkiptouplcert translate>Click <font>Import</font> to upload the certificate.</td></tr><tr><td>&nbsp; &nbsp;</td><td><input class=btnw name=attach onclick=\"return waitResponse()\" type=submit value=\"{{ 'Import' | translate }}\"> &nbsp; <input class=btnw name=btnCancel onclick=btnCcl() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr><tr><td colspan=2><hr size=1><br><b translate>Import X509 Local / Trusted CA Certificate</b></td></tr><tr><td>&nbsp; &nbsp;</td><td><b translate>Note</b>: <ol><li id=link_note translate>Please setup the \"System Maintenance &gt;&gt; <a>Time and Date</a>\" correctly before signing the local/trusted CA certificate.</li><li translate>The Time Zone MUST be setup correctly!!</li></ol></td></tr><tr><td>&nbsp; &nbsp;</td><td><input onclick=x509import() type=button value=\"{{ 'Import Local Certificate' | translate }}\"> &nbsp; <input onclick=X509importCA() type=button value=\"{{ 'Import Trusted CA Certificate' | translate }}\"></td></tr></table><br></td></tr></table></td></tr></table><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></div></td></tr></table><script src=\"/js/variable.js?35352\"></script><script>top.ACTION_STATUS=-1;top.iActionStatusFlag='1';top.iFwUpgradeState='0';top.act_sta.damage_alert();var ckports=[PORTS_PRED];for(var i in PORTS_OPTS){ckports.push(PORTS_OPTS[i]);}function ruOK(){if(true==confirm(gettext('Do you want to clear this account?'))){window.location.href=\"/cgi-bin/dialin.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&sAct=profileclear&iPageIdx=1&iProfileIdx=0&iSSLIdx=0\";}}var bg=top;var f=document.frm1;var f2=document.frmexport;var f3=document.frmImp;var appeinitScript=document.createElement('script');appeinitScript.text=document.getElementById(\"openvpninit\").value;document.head.appendChild(appeinitScript);var g_aryTmp1=new Array();var g_aryTmp2=new Array();var refresh;var g_nCnt=0;var infoHTML=\"\";var isVN=('1'=='1');if(parseInt('1'))document.getElementById(\"vpn-matcher\").style.display=\"block\";function changeProtocol(){angular.forEach(document.querySelectorAll(\".udp\"),function(ele){ele.style.display=(f2.sltProtocol.value===\"udp\")?\"\":\"none\";ele.querySelector(\"input\").disabled=(f2.sltProtocol.value!==\"udp\");})}angular.element(document).ready(function(){initPage();initParameter();changeProtocol();});function initParameter(){const arycipher=[\"aes-128-cbc\",\"aes-256-cbc\",\"none\",\"aes-128-gcm\",\"aes-192-gcm\",\"aes-256-gcm\"],aryhmac=[\"sha1\",\"sha256\",\"none\",\"sha512\"];if(!parseInt('1'))bg.hideElmtById(document,\"tab3\");bg.setVle2Elmt(f.iPort,'1194',0);bg.setVle2Elmt(f.iRlyWin,'1',0);bg.setVle2Elmt(f.iTcpPort,'1194',0);bg.setVle2Elmt(f.iTcpEn,'1',0);bg.setVle2Elmt(f.iUdpEn,'1',0);if(iCipher<arycipher.length){ bg.setVle2Elmt(f2.cipher2,arycipher[iCipher],0);}if(iHmac<aryhmac.length){ bg.setVle2Elmt(f2.hmac2,aryhmac[iHmac],0);}bg.setVle2Elmt(f.sltTrustCA,aryCrtIdx[0],0);bg.setVle2Elmt(f.sltSrvCrt,aryCrtIdx[1],0);bg.setVle2Elmt(f2.rdoAction[0],0,0);bg.setVle2Elmt(f.rdoCrtSrc[0],'0',0);if(aryGenerateCA.length==8){g_aryTmp1=new Array();g_aryTmp2=new Array();for(var i=0;i<8;i+=2){g_aryTmp1.push(aryGenerateCA[i]);g_aryTmp2.push(aryGenerateCA[i+1]);}initGenerateCrt(g_aryTmp1,g_aryTmp2);}clkCrtSrc();if('0'!='1'){bg.showElmtByClass(document,\"tr\",\"oldui\");}for(i=0;i<aryMail.length;i++){ if(aryMail[i]==''){f2.iMailProf.options[i]=new Option((i+1)+\" - ???\",i);}else{f2.iMailProf.options[i]=new Option((i+1)+\" - \"+aryMail[i],i);}} angular.forEach(document.querySelectorAll(\".client_area\"),function(ele){ele.style.display=(f.rdoCrtSrc.value==\"0\"&&f.iRlyWin.checked)?\"table-row\":gettext(\"none\");ele.querySelector(\"input\").disabled=!f.iRlyWin.checked;});}function initGenerateCrt(_aryCrt,_aryCrtIdx){if(_aryCrtIdx[0]==0){document.getElementById(\"rootCA\").innerHTML=gettext(\"None\");}else{document.getElementById(\"rootCA\").innerHTML='<a href=\"javascript:showDetail(333,'+(_aryCrtIdx[0]-1)+')\">'+_aryCrt[0]+'</a>';}if(_aryCrtIdx[1]==0){document.getElementById(\"serverCA\").innerHTML=gettext(\"None\");}else{document.getElementById(\"serverCA\").innerHTML='<a href=\"javascript:showDetail(331,'+(_aryCrtIdx[1]-1)+')\">'+_aryCrt[1]+'</a>';}if(_aryCrtIdx[2]==0){document.getElementById(\"clientCA\").innerHTML=gettext(\"None\");}else{document.getElementById(\"clientCA\").innerHTML='<a href=\"javascript:showDetail(331,'+(_aryCrtIdx[2]-1)+')\">'+_aryCrt[2]+'</a>';}if(_aryCrtIdx[3]==0){document.getElementById(\"trustCA\").innerHTML=gettext(\"None\");}else{document.getElementById(\"trustCA\").innerHTML='<a href=\"javascript:showDetail(334,'+(_aryCrtIdx[3]-1)+')\">'+gettext(\"Trusted CA\")+\"-\"+_aryCrt[3]+'</a>';}}function initPage(){$scope.isVN=isVN;$scope.sltCipher=iCipher;$scope.sltHmac=iHmac;$scope.$apply();dhtml.cycleTab((parent.sOpenVPNTag==undefined)?\"tab1\":parent.sOpenVPNTag);bg.showElmtByClass(document,\"tr\",\"l2lca\");f2.sltRmtWAN.options.length=0;for(var i=0;i<aryWanInfo.length;i++){if(top.notSupportWAN.indexOf(i)!=-1)continue;if(i==1&&bWan2IsDisable)continue;if(aryWanInfo[i][1]==\"green\"&&bg.isStrIp(aryWanInfo[i][2])){if((aryWanInfo[i][0]=='3')&&(parseInt('0')))f2.sltRmtWAN.options[f2.sltRmtWAN.options.length]=new Option(gettext(sLTEmodulename),aryWanInfo[i][0]);else f2.sltRmtWAN.options[f2.sltRmtWAN.options.length]=new Option(gettext(\"WAN\")+aryWanInfo[i][0],aryWanInfo[i][0]);}}if(f2.sltRmtWAN.value!=''&&parseInt(f2.sltRmtWAN.value)!=0){onselwan(parseInt(f2.sltRmtWAN.value));}angular.element(document.querySelector(\"#link_clkiptouplcert font\")).attr(\"color\",\"blue\");angular.element(document.querySelector(\"#link_note a\")).attr(\"href\",'/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=6');}function onClkBtnOk(){var portnum;if((OpenVPNFlag&0x01)!=1){ if(f.iUdpEn.checked==true){portnum=f.iPort.value;if(!chkport(ckports,[portnum,portnum],\"UDP\",1,\"f.iPort\"+\".select()\"))return false;}if(f.iTcpEn.checked==true){portnum=f.iTcpPort.value;if(!chkport(ckports,[portnum,portnum],\"TCP\",1,\"f.iTcpPort\"+\".select()\"))return false;}}if((bg.getVleFromElmt(f.iPort,0)!='1194')||($scope.sltCipher!=iCipher)||($scope.sltHmac!=iHmac)||(bg.getVleFromElmt(f.iRlyWin,0)!='1')||(bg.getVleFromElmt(f.iTcpPort,0)!='1194')||(bg.getVleFromElmt(f.iTcpEn,0)!='1')||(bg.getVleFromElmt(f.iUdpEn,0)!='1')||(bg.getVleFromElmt(f.sltTrustCA,0)!=aryCrtIdx[0])||(bg.getVleFromElmt(f.sltSrvCrt,0)!=aryCrtIdx[1])){f.reboot.value=1;}f.submit();}function clkCrtSrc(){var itype=bg.getVleFromElmt(f.rdoCrtSrc[0],0);if(itype==0){bg.showElmtByClass(document,\"tr\",\"UploadCA\");bg.hideElmtByClass(document,\"tr\",\"generateCA\");}else if(itype==1){bg.showElmtByClass(document,\"tr\",\"generateCA\");bg.hideElmtByClass(document,\"tr\",\"UploadCA\");}}function showDetail(_fid,_certidx){winX509view=window.open(\"/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=\"+_fid+\"&certidx=\"+_certidx,\"X509CfView\",\"scrollbars,width=800,height=500px,top=150px,left=\"+(screen.width/2-400)+\"px\");}function onRefreshStatus(){clearTimeout(refresh);var strSta=\"\";$http.get(\"/CAgenerateStaus.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&random=\"+Math.random()).then(function(response){var val=response.data.split(\"||\");if(val[0]=='1'){document.getElementById(\"generalSta\").innerHTML=gettext('Success');var aryTmp=val[1].split(\",\");if(aryTmp.length==8){g_aryTmp1=new Array();g_aryTmp2=new Array();for(var i=0;i<8;i+=2){g_aryTmp1.push(aryTmp[i]);g_aryTmp2.push(aryTmp[i+1]);}initGenerateCrt(g_aryTmp1,g_aryTmp2);}f.btnGenerate.disabled=false;}else{switch(val[0]){case'0':strSta=gettext('Processing ...');break;case'-1':strSta=gettext('Error: No space to generate local certificate');break;case'-2':strSta=gettext('Error: No space to generate trust CA');break;case'-3':strSta=gettext('Error: No space to generate Root CA');break;case'-4':strSta=gettext('Error: Failed to generate RootCA');break;case'-5':strSta=gettext('Error: Failed to generate client certificate');break;case'-6':strSta=gettext('Error: Failed to sign client certificate');break;case'-7':strSta=gettext('Error: Failed to generate server certificate');break;case'-8':strSta=gettext('Error: Failed to sign server certificate');break;case'-9':strSta=gettext('Error: Failed to generate trustCA certificate');break;}document.getElementById(\"generalSta\").innerHTML=strSta;if(g_nCnt<12){ g_nCnt+=1;refresh=setTimeout(\"onRefreshStatus()\",10000);}else{clearTimeout(refresh);if(val[0]=='0'){document.getElementById(\"generalSta\").innerHTML=gettext('Error: Generate certificate timeout');}f.btnGenerate.disabled=false;}}}).catch(function(){document.getElementById(\"generalSta\").innerHTML=gettext('Error: Fail to refresh status');});}function onClkGenerate(){ var invalidflag=0;for(var i=0;i<g_aryTmp2.length;i++){if(g_aryTmp2[i]!=0){invalidflag=1;break;}}if(invalidflag==1){alert(gettext('Generated certificate exists !'));return false;}g_nCnt=0;alert(gettext('The process may take up to 30 seconds.'));document.getElementById(\"generalSta\").innerHTML=gettext('Processing ...');$http.get(\"/generateCA.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&random=\"+Math.random()).then(function(response){g_nCnt+=1;f.btnGenerate.disabled=true; onRefreshStatus();}).catch(function(response){document.getElementById(\"generalSta\").innerHTML=gettext('Error: Fail to link');});}function onDeleteAll(){$http.get(\"/generateCADel.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&random=\"+Math.random()).then(function(response){var aryTmp=response.data.split(\",\");if(aryTmp.length==8){g_aryTmp1=new Array();g_aryTmp2=new Array();for(var i=0;i<8;i+=2){g_aryTmp1.push(aryTmp[i]);g_aryTmp2.push(aryTmp[i+1]);}initGenerateCrt(g_aryTmp1,g_aryTmp2);}});} function serializeData(data){var obj={};if(data.submit)data=new FormData(data);data.forEach(function(value,key){obj[key]=value;});data=obj; if(!angular.isObject(data)){return((data==null)?\"\":data.toString());}var buffer=[]; for(var name in data){if(!data.hasOwnProperty(name)){continue;}var value=data[name];buffer.push(encodeURIComponent(name)+\"=\"+encodeURIComponent((value==null)?\"\":value));} var source=buffer.join(\"&\").replace(/%20/g,\"+\");return(source);}function onExport(self){var remip=bg.getVleFromElmt(f2.sltRmtSrv,0);var remdomain=bg.getVleFromElmt(f2.sDomain,0);var filename=bg.getVleFromElmt(f2.sFilename,0);var iUDPPingExit=bg.getVleFromElmt(f2.iUDPPingExit,0);var iUDPPing=bg.getVleFromElmt(f2.iUDPPing,0);if(f2.sltRmtSrv.length==0){return false;}if(filename==\"\"){alert(gettext('File name can not be null.'));return false;}if(filename.match(/[^a-zA-Z0-9\\_]/)){alert(gettext('File name can only contain ###ID###.').replace(\"###ID###\",'a-z, A-Z, 0-9 and _'));return false;}if(!bg.isStrNum(iUDPPing)||parseInt(iUDPPing)<0){alert(gettext('UDP Ping is invalid'));return false;}if(!bg.isStrNum(iUDPPingExit)||parseInt(iUDPPingExit)<0){alert(gettext('UDP Ping is invalid'));return false;}if(bg.getVleFromElmt(f2.rdoAction[0],0)==1){ if(!bg.isStrDomainName(remdomain)){alert(gettext('Domain is invalid.'));return false;}f2.sRmtSrv.value=remdomain;}else{f2.sRmtSrv.value=remip;}if(self.id==\"sMail\"){var sMailTo=bg.getVleFromElmt(f2.sMailTo,0);if(sMailTo==\"\"){alert(gettext(\"Mail address can not be null.\"));return false;}$http.post('/Send_OVPN_Mail.cgi?sFormAuthStr=JdvKVyYlhh7GhS9',serializeData(f2)).then(function(response){alert(gettext(\"Mail has been sent.\"));});}else{f2.action='/'+filename+'.ovpn?sFormAuthStr=JdvKVyYlhh7GhS9';f2.submit();}}function gotolct(url){top.main.location.href=url+'&sFormAuthStr=JdvKVyYlhh7GhS9';}function btnCcl(){ f3.opcfg_file.value='';}function waitResponse(){if(f3.opcfg_file.value!=\"\"){setTimeout(\"parent.OpenVPNHandler.document.location='/doc/openvpnHlr.htm'\",1000);}}function mainHandler(iResp){switch(iResp){case 1:document.location='/doc/openvpnOK.HTM';break;default:document.location='/doc/openvpnFail.htm';}}function x509import(){if('(nil)'==\"1\"){winX509Import=window.open(\"/doc/XLoCaImport.htm\",\"XLoCfMn\",\"toolbars=no,scrollbars=no, width=600,height=250px,top=150px,left=\"+(screen.width/2-230)+\"px,status=no,menubar=no\");if(winX509Import){winX509Import.focus();}}else{var myUrl=\"/doc/XLoCfMn.htm\";document.locatio