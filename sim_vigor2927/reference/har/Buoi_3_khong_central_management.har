            "compression": 4470,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/dhtml.min.js?094907\"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'Diagnostics' | translate }}\" sub-title translate>Routing Table</b><hr><form method=post name=frm><table align=center border=0 cellpadding=2 cellspacing=0 width=700><tr><td><b translate>IPv4 Routing Table</b></td><td align=right><font color=red>|&nbsp; <a href=\"/cgi-bin/iprt.cgi?sFormAuthStr=JdvKVyYlhh7GhS9\"><translate>Refresh</translate></a>&nbsp;|</font></td></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 width=700><tr><td><textarea cols=84 id=RoutingTable name=RoutingTable READONLY rows=16 style=width:100%>\n-----------------------------------------------------------------------------------\nC~       192.168.1.0/ 255.255.255.0    directly connected    LAN1\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n    </textarea></td></tr><tr><td><translate>Status</translate><br> C:&nbsp;<translate>Connected</translate>&nbsp;&nbsp;&nbsp;&nbsp;S: <translate>Static</translate>&nbsp;&nbsp;&nbsp;&nbsp;R: <translate>RIP</translate>&nbsp;&nbsp;&nbsp;&nbsp;*: <translate>default</translate>&nbsp;&nbsp;&nbsp;&nbsp;~: <translate>private</translate> &nbsp;&nbsp;&nbsp;&nbsp;<span ng-if=\"FlagBGP\">B: <transalte>BGP</transalte></span>&nbsp;&nbsp;&nbsp;&nbsp;<span ng-if=\"FlagOSPF\">O: <translate>OSPF</translate></span></td></tr></table><table class=PVCWAN style=display:none><tr><td id=link_note style=font-weight:normal><script> var bg=parent;var str=\"\";var IF_WAN1=3;var PVC_BWAN_NUM=3;var iBwanNumber=parseInt('6');if(bg.SHOW_LAN_STATICROUTE) str+=gettext(\"WAN###VAL1###, WAN###VAL2###, WAN###VAL3### are router-borne WANs.\");var aryNote=[str];document.write(parent.writeNote(aryNote));</script></td></tr></table><br><table align=center border=0 cellpadding=2 cellspacing=0 class=IPv6table style=display:none width=700><tr><td><b translate>IPv6 Routing Table</b></td><td align=right><input name=showdetail onclick=onClkShowdt() type=checkbox value=1>&nbsp;<translate>Show Detail</translate>&nbsp;<font color=red>|&nbsp; <a href=\"/cgi-bin/iprt.cgi?sFormAuthStr=JdvKVyYlhh7GhS9\"><translate>Refresh</translate></a>&nbsp;|</font></td></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 class=IPv6table style=display:none width=700><tr><td><textarea cols=84 name=Ip6RoutingTable READONLY rows=16 style=width:100%; wrap=off>\n</textarea></td></tr><tr><td translate>Flags</td></tr><tr><td>U: <translate>Route UP</translate>&nbsp;&nbsp;&nbsp;&nbsp;F: <translate>Default Route</translate>&nbsp;&nbsp;&nbsp;&nbsp;G: <translate>Use Next Hop</translate>&nbsp;&nbsp;&nbsp;&nbsp;S: <translate>Static Route</translate>&nbsp;&nbsp;&nbsp;&nbsp;<span id=iRIPng>R: <translate>RIPng</translate></span></td></tr></table><br><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></td></tr></table><script>top.ACTION_STATUS=-1;top.iActionStatusFlag='0';top.iFwUpgradeState='0';top.act_sta.damage_alert();var f=document.frm,bg=parent;var Ipv6RouteNeigh='##% Command missing, Valid commands are:##csm           ddns          dos           exit          internet      ip            ##ipf           log           ldap          tacacsplus    mngt          msubnet       ##object        port          portmaptime   ppa           hwaccswap     prn           ##qos           hwqos         quit          show          smb           srv           ##switch        sys           testmail      fs            upnp          usb           ##vigbrg        fullbrg       vlan          vpn           wan           hsportal      ##radius        local_8021x   wol           user          appqos        nand          ##apm           sfp           ethoam        ha            swm           fw_backupmode ##cert          service       dmn           ##';var aryIp6RouteNeigh=new Array();var iActSubnum=parseInt('8');var iSubnetNum=parseInt('16');function intiPage(){if(parseInt('0')){bg.showElmtByClass(document,\"table\",\"IPv6table\");showLanIp6RouteNeigh();}if('1'==0){bg.hideElmtById(document,\"iRIPng\");}document.getElementById(\"RoutingTable\").innerHTML=bg.strFormat(gettext(\"Status\"),9)+bg.strFormat(gettext(\"Destination\"),30)+bg.strFormat(gettext(\"Gateway\"),22)+gettext(\"Interface\")+\"\\n\"+document.getElementById(\"RoutingTable\").innerHTML;var notemsg=document.querySelector(\"#link_note translate\");if(bg.SHOW_LAN_STATICROUTE)notemsg.innerHTML=notemsg.innerHTML.replace(\"###VAL1###\",((IF_WAN1+iBwanNumber)-2)).replace(\"###VAL2###\",((IF_WAN1+iBwanNumber+PVC_BWAN_NUM-2)-2)).replace(\"###VAL3###\",((IF_WAN1+iBwanNumber+PVC_BWAN_NUM-1)-2));} function initParameter(){}angular.element(document).ready(function(){intiPage();initParameter();$scope.FlagBGP=parseInt('1');$scope.FlagOSPF=('(nil)'=='1');$scope.$apply();});function showLanIp6RouteNeigh(){var showdetail=bg.getVleFromElmt(f.showdetail);var str=Ipv6RouteNeigh.replace(/[\\s]+/g,\"@\");var aa=str.split(\"##@\");var hideflag=0;aryIp6RouteNeigh=new Array();for(var i=1,j=0;i<aa.length;i++){tmp1=aa[i].split(\"@\");if(showdetail==1)aryIp6RouteNeigh[j++]=([tmp1[0],tmp1[1],tmp1[2],tmp1[3],tmp1[4]]);else{tmp2=tmp1[0].split(\"/\");if((tmp2[1]<128)||(tmp1[3].indexOf(\"S\")!=-1))aryIp6RouteNeigh[j++]=([tmp1[0],tmp1[1],tmp1[2],tmp1[3],tmp1[4]]);}}var content=bg.strFormat(gettext('Destination'),45)+bg.strFormat(gettext('Interface'),10)+bg.strFormat(gettext('Flags'),10)+bg.strFormat(gettext('Metric'),10)+bg.strFormat(gettext('Next Hop'),45)+\"\\n\";for(var i=0;i<100;i++)content+=\"-\";content+=\"\\n\";for(i=0;i<aryIp6RouteNeigh.length;i++){for(var j=(iActSubnum+1);j<=iSubnetNum;j++){if(aryIp6RouteNeigh[i][1]==\"LAN\"+j){hideflag=1;break;}}if(hideflag==0&&aryIp6RouteNeigh[i]!=\"\")content+=bg.strFormat(aryIp6RouteNeigh[i][0],45)+bg.strFormat(aryIp6RouteNeigh[i][1],10)+bg.strFormat(aryIp6RouteNeigh[i][3],10)+bg.strFormat(aryIp6RouteNeigh[i][2],10)+bg.strFormat(aryIp6RouteNeigh[i][4],45)+\"\\n\";}f.Ip6RoutingTable.value=content;}function onClkShowdt(){showLanIp6RouteNeigh();}</script></body></html>"
