 'threeMenu');\nvar $menuLink = $('<a>')\n.attr('id', item.id)\n.attr('role', \"link\")\n.attr('tabindex', \"0\")\n.text(item.name)\n.appendTo($menuItem);\nif (item.children) {\n$menuItem.addClass('has-children');\n$menuLink.attr(\"aria-expanded\",\"false\");\nvar submenuClass = level === 2 ? 'lastmenu' : 'submenu'\nvar $submenu = $('<div>').addClass(submenuClass);\ncreatMenu(item.children, $submenu, level + 1);\n$submenu.appendTo($menuItem);\n$menuLink.on('click', function(e) {\ne.preventDefault();\n$menuItem.toggleClass('active');\nvar isExpanded = $(this).attr('aria-expanded') == 'true';\n$(this).attr('aria-expanded', !isExpanded);\n});\n}\n$menuItem.appendTo($menuList);\n});\nparentElement.append($menuList);\n}\nfunction threeMenuClick() {\n$(\".threeMenu\").click(function(e) {\ne.stopPropagation();\nvar linkUrl = $(this).find('a').attr(\"id\") + \"&Menu3Location=0\";\nopenLink(linkUrl);\n$(\"#page_container\").show();\n$(\"#menu-container\").hide();\n});\n}\nfunction secondMenuClick() {\n$(\".secondMenu\").click(function(e) {\ne.stopPropagation();\nif($(this).hasClass(\"has-children\")) {\nif($(this).hasClass(\"active\")) {\n$('.lastmenu', $(this)).show();\nthreeMenuClick($('.lastmenu', $(this)));\n}else{\n$('.lastmenu', $(this)).hide();\n}\n}else{\nvar linkUrl = $(this).find('a').attr(\"id\") + \"&Menu3Location=0\"\nopenLink(linkUrl);\n$(\"#page_container\").show();\n$(\"#menu-container\").hide();\n}\n});\n}\nfunction firstMenuClick() {\n$(\".firstMenu\").click(function(e) {\ne.stopPropagation();\nif($(this).hasClass(\"has-children\")) {\nif($(this).hasClass(\"active\")) {\n$('.submenu', $(this)).show();\n}else{\n$('.submenu', $(this)).hide();\n}\nsecondMenuClick($('.submenu', $(this)));\n}else{\nvar linkUrl = $(this).find('a').attr(\"id\") + \"&Menu3Location=0\"\nopenLink(linkUrl);\n$(\"#page_container\").show();\n$(\"#menu-container\").hide();\n}\n})\n}\n$(\".more-menu-icon\").on(\"click\", function () {\n$(\"#menu-container\").show();\n$(\"#page_container\").hide();\n$(\"#menu-results\").empty();\nvar menuTreeJSON = [{\"id\":\"homePage\",\"name\":\"Home\",\"extData\":\"Show the important information.\",\"area\":[{\"area\":\"home_t.lp\"}]},{\"id\":\"mmTopology\",\"name\":\"Topology\",\"area\":[{\"area\":\"topo_t.lp\"}]},{\"id\":\"internet\",\"name\":\"Internet\",\"children\":[{\"id\":\"internetStatus\",\"name\":\"Status\",\"children\":[{\"id\":\"ponopticalinfo\",\"name\":\"PON Inform\",\"pageHelp\":\"Display the optical module\",\"extData\":\"Show PON state and other information. \",\"area\":[{\"area\":\"poninfo_status_t.lp\"}]},{\"id\":\"ethWanStatus\",\"name\":\"WAN\",\"pageHelp\":\"This page shows the status of WAN. \",\"extData\":\"This page displays basic information of WAN connection. \",\"area\":[{\"area\":\"wan_eth_status_t.lp\"}]},{\"id\":\"Wan3gStatus\",\"name\":\"3G/4G\",\"pageHelp\":\"This page shows the status of 3G/4G. \",\"extData\":\"need to add.\",\"area\":[{\"area\":\"wwan_mobile_status_t.lp\"},{\"area\":\"wan_3g_status_t.lp\"}]},{\"id\":\"tunnel4in6Status\",\"name\":\"DSLite\",\"pageHelp\":\"This page shows the status of DSLite connection. \",\"extData\":\"Tunnel configuration information, including how to configure relevant parameters of Tunnel Connection, and WAN Connection Name is the name of underlying WAN Connection associated with the Tunnel, and the range of Interface IPv4 address is between 192.0.0.2 and 192.0.0.6. \",\"area\":[{\"area\":\"tunnel_4in6_status_t.lp\"}]},{\"id\":\"l2tpStatus\",\"name\":\"L2TP\",\"pageHelp\":\"This page shows the status of L2TP connection. \",\"extData\":\"need to add.\",\"area\":[{\"area\":\"l2tp_status_t.lp\"}]},{\"id\":\"conntracks\",\"name\":\"NAT entries/conntracks\",\"pageHelp\":\"Entries / conntracks shows the maximum number of NAT connection traces and the number of used connection traces\",\"extData\":\"need to add.\",\"area\":[{\"area\":\"firewall_conntrack_t.lp\"}]}]},{\"id\":\"internetConfig\",\"name\":\"WAN\",\"children\":[{\"id\":\"ethWanConfig\",\"name\":\"WAN\",\"pageHelp\":\"This page provides the function of WAN connection parameter(s) configuration. \",\"extData\":\"Ethernet broadband settings: 1. IPv4 correlative: Connection Mode, including Routing and Bridge. Routing, including PPPoE(please select it to get IP address dynamically if your ISP uses PPPoE)/ DHCP(get IP address dynamically from your ISP)/ Static(set static IP address), etc. Bridge mode is transparent bridge(communication between different networks like in the same physical LAN). Some other basic options: VLAN, etc. 2. IPv6 correlative: Manual mode, manually specify GUA, Gateway, DNS and Prefix . Auto mode, automatically  get GUA, Gateway, DNS and Prefix according to RA. Prefix delegation for GUA: use the prefix delegation to get prefix split out prefix configuration address. \",\"area\":[{\"area\":\"wan_eth_config_t.lp\"}]},{\"id\":\"Wan3gConfig\",\"name\":\"3G/4G\",\"pageHelp\":\"This page provides the function of 3G/4G connection parameter(s) configuration. \",\"extData\":\"need to add.\",\"area\":[{\"area\":\"wwan_pin_t.lp\"},{\"area\":\"wan_3gLTE_config_t.lp\"},{\"area\":\"wwan_backup_t.lp\"}]},{\"id\":\"tunnel4in6Config\",\"name\":\"DSLite\",\"pageHelp\":\"This page provides the function of DSLite connection parameter(s) configuration. \",\"extData\":\"Tunnel configuration information, including how to configure relevant parameters of Tunnel Connection, and WAN Connection Name is the name of underlying WAN Connection associated with the Tunnel, and the range of Interface IPv4 address is between 192.0.0.2 and 192.0.0.6. \",\"area\":[{\"area\":\"tunnel_4in6_config_t.lp\"}]},{\"id\":\"l2tpConfig\",\"name\":\"L2TP\",\"pageHelp\":\"This page provides the function of L2TP connection parameter(s) configuration. \",\"extData\":\"need to add.\",\"area\":[{\"area\":\"l2tp_config_t.lp\"}]}]},{\"id\":\"security\",\"name\":\"Security\",\"children\":[{\"id\":\"firewall\",\"name\":\"Firewall\",\"pageHelp\":\"This page provides the function of firewall parameter(s) configuration. \",\"extData\":\"This page allows the user to set the level of the firewall(IPv4) and protection against attacks. After setting, this page displays the level of the firewall and the new state of protection against attacks. \",\"area\":[{\"area\":\"firewall_config_t.lp\"},{\"area\":\"firewall_dos_t.lp\"}]},{\"id\":\"filterCriteria\",\"name\":\"Filter Criteria\",\"pageHelp\":\"This page provides the function of filter criteria parameter(s) configuration. \",\"extData\":\"{Filter Switch And Mode Configuration:}This page configures the MAC filter and URl filter modes and switches. {{MAC Filter:}MAC Address Filter: The MAC Address Filter settings can set the relevance parameters of the MAC filter function. The user interface will display the set MAC Filter rules after setting completed. {{URL Filter:}URL Filter: The URL Filter settings can set rule to filter HTTP packets or accept HTTP packets. The page will display the new URL Filter rules after setting completed. {{IP Filter - IPv4:}This page allows the user to set the rule to filter the packet. After setting, this page displays the rule. {{IP Filter - IPv6:}This page allows the user to set the rule to filter the packet. After setting, this page displays the rule. \",\"area\":[{\"area\":\"firewall_filterglobal_t.lp\"},{\"area\":\"firewall_ipfilter_t.lp\"},{\"area\":\"firewall_macfilterv3_t.lp\"},{\"area\":\"firewall_urlfilter_m.lua\"}]},{\"id\":\"localServiceCtrl\",\"name\":\"Local Service Control\",\"pageHelp\":\"This page provides the function of local service control parameter(s) configuration. \",\"extData\":\"{Service Control - IPv4/IPv6:}This page allows the user to set the Service Control. After setting, this page displays the new state of Service Control. {{Remote Service Port Control - IPv4:}Modify the remote access ports: Modify remote access ports of local services, this ports are only valid for remote access, internal access is not affected. \",\"area\":[{\"area\":\"firewall_ipv4service_t.lp\"},{\"area\":\"firewall_ipv6service_t.lp\"},{\"area\":\"firewall_portservice_t.lp\"}]},{\"id\":\"alg\",\"name\":\"ALG\",\"pageHelp\":\"This page provides the function of ALG parameter(s) configuration. \",\"extData\":\"This page allows the user to set ALG switch. After setting, this page displays the new state of ALG switch. \",\"area\":[{\"area\":\"firewall_alg_t.lp\"}]},{\"id\":\"dmz\",\"name\":\"DMZ\",\"pageHelp\":\"This page provides the function of DMZ parameter(s) configuration. \",\"extData\":\"This page allows to set DMZ Host and displays the information of DMZ Host. \",\"area\":[{\"area\":\"firewall_dmz_t.lp\"}]},{\"id\":\"portForwarding\",\"name\":\"Port Forwarding\",\"pageHelp\":\"This page provides the function of port forwarding parameter(s) configuration. \",\"extData\":\"Users can use the application name to set a virtual server. if you enable virtual server configuration, you can use  Wide Area Network to access the virtual host. \",\"area\":[{\"area\":\"firewall_portforwarding_t.lp\"}]},{\"id\":\"portTrigger\",\"name\":\"Port Trigger\",\"pageHelp\":\"This page provides the function of port trigger parameter(s) configuration. \",\"extData\":\"This page allows the user to set the parameters of port trigger rule. After setting, this page displays the rule. \",\"area\":[{\"area\":\"firewall_porttrigger_m.lua\"}]}]},{\"id\":\"parentCtrl\",\"name\":\"Parental Controls\",\"pageHelp\":\"This page provides the function of parental controls parameter(s) configuration. \",\"extData\":\"The page include Time Policy for restricting users' network using, and the administrator can add and delete the user information. \",\"area\":[{\"area\":\"firewall_parentctrl_t.lp\"}]},{\"id\":\"ddns\",\"name\":\"DDNS\",\"pageHelp\":\"This page provides the function of DDNS parameter(s) configuration. \",\"extData\":\"This page allows to enable or disable the function of DDNS. After settings are completed, it shows the new DDNS status. \",\"area\":[{\"area\":\"ddns_t.lp\"},{\"area\":\"fpt_ddns_status_model.lua\"}]},{\"id\":\"sntp\",\"name\":\"SNTP\",\"pageHelp\":\"This page provides the function of SNTP parameter(s) configuration. \",\"extData\":\"This page can display the current time,it can also set the time zone and the time server address. \",\"area\":[{\"area\":\"sntp_t.lp\"}]},{\"id\":\"portBinding\",\"name\":\"Port Binding\",\"pageHelp\":\"This page provides the function of port binding parameter(s) configuration. \",\"extData\":\"The management of LAN Port and WAN Connection. \",\"area\":[{\"area\":\"portbinding_t.lp\"}]},{\"id\":\"rip\",\"name\":\"Dynamic Routing\",\"pageHelp\":\"This page provides the function of dynamic routing parameter(s) configuration. \",\"extData\":\"{RIP:}Dynamic routing, enable RIP, RIPv1 and RIPv2 protocol can be supported, including RIPv2 authentication. {{RIPng:}Dynamic routing, enable RIPng protocol. \",\"area\":[{\"area\":\"route_rip_t.lp\"},{\"area\":\"route_ripng_m.lua\"}]},{\"id\":\"multicast\",\"name\":\"Multicast\",\"children\":[{\"id\":\"multicastmode\",\"name\":\"Multicast Mode\",\"pageHelp\":\"Enable MultiCast snooping, proxy mode and configure some other parameters. \",\"extData\":\"Enable MultiCast snooping, proxy mode and configure some other parameters. \",\"area\":[{\"area\":\"multicast_mode_t.lp\"}]},{\"id\":\"igmp\",\"name\":\"IGMP\",\"pageHelp\":\"This page provides the function of IGMP parameter(s) configuration. \",\"extData\":\"Choose the WAN Connection of bridge or route type for IGMP packet. \",\"area\":[{\"area\":\"multicast_igmpwan_t.lp\"}]},{\"id\":\"mld\",\"name\":\"MLD\",\"pageHelp\":\"This page provides the function of MLD parameter(s) configuration. \",\"extData\":\"Choose the WAN Connection of bridge or route type for MLD packet. \",\"area\":[{\"area\":\"multicast_mldwan_t.lp\"}]},{\"id\":\"multicastbasic\",\"name\":\"Basic\",\"pageHelp\":\"Set the Aging Time and Leave Mode for MultiCast Module.\",\"extData\":\"Set the Aging Time and Leave Mode for MultiCast Module. \",\"area\":[{\"area\":\"multicast_basic_t.lp\"}]},{\"id\":\"IgmpWLANCONF\",\"name\":\" Multicast on Wi-Fi \",\"pageHelp\":\" This page provides the function of Multicast on Wi-Fi parameter(s) configuration. \",\"area\":[{\"area\":\"multicast_model.lua\"}]}]},{\"id\":\"portlocate\",\"name\":\"Port Locating\",\"pageHelp\":\"This page provides the function of port locating parameter(s) configuration. \",\"extData\":\"Configure Port Locating function. \",\"area\":[{\"area\":\"Internet_PortLocate_t.lp\"}]},{\"id\":\"ponInfo\",\"name\":\"PON Information\",\"children\":[{\"id\":\"ponLoid\",\"name\":\"LOID\",\"pageHelp\":\"This page provides the function of LOID parameter(s) configuration. \",\"area\":[{\"area\":\"poninfo_loid_t.lp\"}]},{\"id\":\"ponSn\",\"name\":\"SN\",\"pageHelp\":\"This page provides the function of SN parameter(s) configuration. \",\"area\":[{\"area\":\"poninfo_sn_t.lp\"}]}]}]},{\"id\":\"localnet\",\"name\":\"Local Network\",\"children\":[{\"id\":\"localNetStatus\",\"name\":\"Status\",\"pageHelp\":\"This page shows the status of LAN. \",\"extData\":\"{LAN Information:}Display the Ethernet port information, including port name, link status, packets/bytes received, packets/bytes sent, etc.{{WLAN Status:}Display WLAN information, including radio status, channel, SSID name, packets received, packets sent, security, etc.{{WLAN Client Status:}Display WLAN Client Status information. {{LAN Client Status:}Display the LAN Client Status information. {{USB Storage Status:}Display information of USB devices connected. \",\"area\":[{\"area\":\"status_lan_info_t.lp\"},{\"area\":\"wlan_wlanstatus_t.lp\"},{\"area\":\"wlan_client_stat_t.lp\"},{\"area\":\"accessdev_landevs_t.lp\"},{\"area\":\"usb_usbdevs_t.lp\"}]},{\"id\":\"wlanConfig\",\"name\":\"WLAN\",\"children\":[{\"id\":\"wlanBasic\",\"name\":\"WLAN Basic\",\"pageHelp\":\"This page provides the function of WLAN basic parameter(s) configuration. \",\"extData\":\"{WLAN On/Off Configuration & WLAN Global Configuration:}Configure WLAN basic parameters, such as radio, channel, wireless mode, etc. {{WLAN SSID Configuration:}SSID name, hiding SSID, Enable, SSID priority, etc. SSID security setting, supported methods: None, WEP, WPA, WPA2, WPA/WPA2, etc. \",\"area\":[{\"area\":\"wlan_wlanbasiconoff_t.lp\"},{\"area\":\"wlan_wlanbasicadconf_t.lp\"},{\"area\":\"wlan_wlansssidconf_t.lp\"}]},{\"id\":\"wlanAdvanced\",\"name\":\"WLAN Advanced\",\"pageHelp\":\"This page provides the function of WLAN advanced parameter(s) configuration. \",\"extData\":\"{Access Control-Mode Configuration/Rule Configuration:}Configure ACL policy and MAC. \",\"area\":[{\"area\":\"wlan_macfilteraclpolicy_t.lp\"},{\"area\":\"wlan_macfilterrule_t.lp\"}]},{\"id\":\"wps\",\"name\":\"WPS\",\"pageHelp\":\"This page provides the function of WPS parameter(s) configuration. \",\"extData\":\"Set WPS method, PBC or PIN. If PIN method is selected, it will show AP'PIN or allow to input Enrolee'PIN. \",\"area\":[{\"area\":\"wlan_wps_t.lp\"}]},{\"id\":\"wlanStaScanAP\",\"name\":\"Surrounding WiFi\",\"pageHelp\":\"This page shows surrounding WiFi info of ONU\",\"extData\":\"need to add.\",\"area\":[{\"area\":\"wlan_sta_scanap2g_t.lp\"},{\"area\":\"wlan_sta_scanap5g_t.lp\"}]},{\"id\":\"wifibandsteer\",\"name\":\"WLAN Band Steering\",\"pageHelp\":\"This page provides the function of WLAN Band Steering parameter(s) configuration.\",\"extData\":\"This page provides the function of WLAN Band Steering parameter(s) configuration.\",\"area\":[{\"area\":\"wlan_BandSteering_t.lp\"}]},{\"id\":\"WLANMLO\",\"name\":\"MLO\",\"pageHelp\":\"This page provides the function of MLO parameter(s) configuration. \",\"extData\":\"This page provides the function of MLO parameter(s) configuration. \",\"area\":[{\"area\":\"wlan_mlo_model.lua\"}]},{\"id\":\"smNetSphereMAP\",\"name\":\"Mesh Wi-Fi\",\"pageHelp\":\"This page provides the function of Mesh Wi-Fi parameter(s) configuration.\",\"area\":[{\"area\":\"Localnet_NetSphere_Mode_t.lp\"}]}]},{\"id\":\"lanConfig\",\"name\":\"LAN\",\"children\":[{\"id\":\"lanMgrIpv4\",\"name\":\"IPv4\",\"pageHelp\":\"This page provides the function of LAN (IPv4) parameter(s) configuration. \",\"extData\":\"{Allocated Address (DHCP)/DHCP Server:}1.Supporting the management of the Home Gateway's IP address. 2.Dynamic Address management, including Dynamic Address distribution, and parameters distributed to equipment, such as lease time, address range, DNS, etc. {{DHCP Conditional Serving Pool:}Supporting dynamic address allocation according to LAN port, after the enable is set to true, it becomes effective. {{DHCP Binding:}Static address management: based on the dynamic address, it provides the configuration on binding relationship of MAC address and IP address (legal IP address), and reserves the configuration IP function. {{Port Control:}Configure the DHCP serivce of each port. \",\"area\":[{\"area\":\"Localnet_LanMgrIpv4_t.lp\"},{\"area\":\"Localnet_LanMgrIpv4_DHCPPortService_t.lp\"},{\"area\":\"Localnet_LanDevDHCPSource_t.lp\"}]},{\"id\":\"lanMgrIpv6\",\"name\":\"IPv6\",\"pageHelp\":\"This page provides the function of LAN (IPv6) parameter(s) configuration. \",\"extData\":\"{Allocated Address (DHCPv6)/LAN Address Management/Static Prefix/DHCPv6 Server:}1.Supporting the management of the Home Gateway's IPv6 address and it's prefix length. 2.IPv6 Dynamic Address management: IP Address: configure the IPv6 address and prefix length of the gateway. Enable DHCP Service: enable/disable DHCPv6 service function. DNS Refresh Time: configure  the DNS refresh time distributed to client. Distributed Address List: DUID: DUID of client, identifies one client uniquely. IP Address, IPv6 address distributed to client. Residual Rent Time: the residual rent time of IPv6 address distributed to client. {{RA Service:}Router Advertisement(RA) is called stateless address autoconfiguration, it can periodically send many information include MTU, prefix, DNS and hop limit. The period in random is between mintime and maxtime. Managed address configuration(M) flag, when set, hosts use the DHCPv6 protocol for address auto configuration. Other stateful configuration(O) flag, When set, hosts use the DHCPv6 protocol for auto configuration of other (non-address) information. {{Port Control}DHCPv6 or RA service will be enabled on the port when DHCPv6 or RA is checked. \",\"area\":[{\"area\":\"dhcp6s_hostinfo_t.lp\"},{\"area\":\"addr6_lanaddr_t.lp\"},{\"area\":\"prefix_staticprefix_t.lp\"},{\"area\":\"dhcp6s_dhcpserver_t.lp\"},{\"area\":\"ra_raservice_t.lp\"},{\"area\":\"prefix_prefixpool_t.lp\"},{\"area\":\"radhcp6s_portctrl_t.lp\"}]}]},{\"id\":\"route\",\"name\":\"Routing\",\"children\":[{\"id\":\"routeIpv4\",\"name\":\"IPv4\",\"pageHelp\":\"This page provides the function of routing (IPv4) parameter(s) configuration. \",\"extData\":\"{Routing Table:}Route Information View, such as Network Address, Subnet Mask, Gateway, Interface Information. {{Static Routing:}Static Routing Configuration:select a WAN connection as the Route Interface, then configure destination IP, Mask, Gateway. {{Policy Routing:}Policy Forwarding Configuration: according to the IP, MAC, Port, Protocol, DSCP, TOS, specify the Route Interface, and forward packets. \",\"area\":[{\"area\":\"route_routedefault_t.lp\"},{\"area\":\"route_routetableipv4_t.lp\"},{\"area\":\"route_routestaticipv4_t.lp\"}]},{\"id\":\"routeIpv6\",\"name\":\"IPv6\",\"pageHelp\":\"This page provides the function of routing (IPv6) parameter(s) configuration. \",\"extData\":\"{Routing Table:}Route Information View, such as Network Address, Subnet Mask, Gateway, Interface Information. {{Static Routing:}Static Routing Configuration:select a WAN connection as the Route Interface, then configure destination IP, Mask, Gateway. {{Policy Routing:}Policy Forwarding Configuration: according to the IP, MAC, Port, Protocol, DSCP, TOS, specify the Route Interface, and forward packets. \",\"area\":[{\"area\":\"route_routedefaultipv6_t.lp\"},{\"area\":\"route_routetableipv6_t.lp\"},{\"area\":\"route_routestaticipv6_t.lp\"}]}]},{\"id\":\"ftp\",\"name\":\"FTP\",\"pageHelp\":\"This page provides the function of FTP parameter(s) configuration. \",\"extData\":\"This page allows to enable or disable FTP server function, and it can also set the parameters just like FTP server security,username and password. \",\"area\":[{\"area\":\"Localnet_ftp_t.lp\"}]},{\"id\":\"upnp\",\"name\":\"UPnP\",\"pageHelp\":\"This page provides the function of UPnP parameter(s) configuration. \",\"extData\":\"This page allows to enable or disable UPnP function, and also allows configuring other settings. \",\"area\":[{\"area\":\"upnp_upnp_t.lp\"},{\"area\":\"upnp_portmap_t.lp\"}]},{\"id\":\"bpdu\",\"name\":\"BPDU\",\"pageHelp\":\"This page provides the function of BPDU parameter(s) configuration. \",\"extData\":\"This page provides the function of BPDU parameter(s) configuration. \",\"area\":[{\"area\":\"bpdu_t.lp\"}]},{\"id\":\"dms\",\"name\":\"DMS/DLNA\",\"pageHelp\":\"This page provides the function of DMS parameter(s) configuration. \",\"extData\":\"Custom DMS. DMS(Digital Media Server) can discover media content on the USB storage device, and share this on the network. \",\"area\":[{\"area\":\"dms_dms_t.lp\"}]},{\"id\":\"samba\",\"name\":\"Samba Service\",\"pageHelp\":\"This page provides the function of samba parameter(s) configuration. \",\"extData\":\"need to add.\",\"area\":[{\"area\":\"Localnet_Samba_t.lp\"}]},{\"id\":\"dns\",\"name\":\"DNS\",\"pageHelp\":\"This page provides the function of DNS parameter(s) configuration. \",\"extData\":\"{Domain Name:}Domain Name is represent a small network in LAN side with a name space, it can be configured on interface of LAN side. {{Host Name:}Host Name is mapped with a IP Address, they can be configured by user to resolve DNS request. {{DNS:}DNS Server is a database include hostname and IP Address, it can be configured to help DNS request in LAN side. \",\"area\":[{\"area\":\"dns_localdns_t.lp\"},{\"area\":\"dns_hostname_t.lp\"},{\"area\":\"dns_dnsserver_t.lp\"}]},{\"id\":\"usbfunccfg\",\"name\":\"USB\",\"pageHelp\":\"This page provides the function of USB parameter(s) configuration. \",\"extData\":\"need to add.\",\"area\":[{\"area\":\"usb_usbfunccfg_t.lp\"}]}]},{\"id\":\"voip\",\"name\":\"VoIP\",\"children\":[{\"id\":\"voipStatus\",\"name\":\"Status\",\"pageHelp\":\"This page shows the status of VoIP. \",\"extData\":\"{VoIP Status:}Display the current server status of VoIP users. {{Call Log:}Show information of history call. \",\"area\":[{\"area\":\"Voip_lineStatus_t.lp\"},{\"area\":\"Voip_phoneStatus_t.lp\"}]},{\"id\":\"voipBasic\",\"name\":\"Basic\",\"pageHelp\":\"This page provides the function of VoIP basic parameter(s) configuration. \",\"extData\":\"Configure the SIP Accounts.\",\"area\":[{\"area\":\"voip_voipbasic_t.lp\"}]},{\"id\":\"voipServices\",\"name\":\"VoIP Services\",\"pageHelp\":\"Configure VoIP services.\",\"extData\":\"Configure VoIP services.\",\"area\":[{\"area\":\"voip_services_t.lp\"}]},{\"id\":\"sipIf\",\"name\":\"Network Interface\",\"pageHelp\":\"This page provides the function of VoIP interface parameter(s) configuration. \",\"extData\":\"Setup the network interface used by VoIP. \",\"area\":[{\"area\":\"Voip_SipIf_t.lp\"}]},{\"id\":\"sipAdvanced\",\"name\":\"Advanced\",\"pageHelp\":\"This page provides the function of VoIP advanced parameter(s) configuration. \",\"extData\":\"{Echo Cancellation:}VoIP Function Configure: 1.DTMF transfer Configure--RFC2833 or transparency. 2.Jitter Buffer--Can be set to Adaptive Mode or Fixed Mode, and set the jitter length respectively. After set, new status will show up. {{Echo Cancellation:}Echo Cancellation--can be set to Enable or Disable. \",\"area\":[{\"area\":\"voip_sipadvanced_t.lp\"},{\"area\":\"voip_voiceproc_t.lp\"}]},{\"id\":\"sip\",\"name\":\"SIP Protocol\",\"pageHelp\":\"This page provides the function of SIP protocol parameter(s) configuration. \",\"extData\":\"need to add.\",\"area\":[{\"area\":\"voip_voipsip_t.lp\"}]},{\"id\":\"sipDigitmap\",\"name\":\"Digital Map\",\"pageHelp\":\"Configure Digital Map, in which  \\\"X\\\" represents a number from 0 to 9 and \\\".\\\" represents many.\",\"extData\":\"Configure Digital Map, in which  \\\"X\\\" represents a number from 0 to 9 and \\\".\\\" represents many.\",\"area\":[{\"area\":\"voip_sipdigitmap_t.lp\"}]},{\"id\":\"sipMedia\",\"name\":\"Media\",\"pageHelp\":\"This page provides the function of media parameter(s) configuration. \",\"extData\":\"Set codecs which could be supported on VoIP line and their priorities. \",\"area\":[{\"area\":\"voip_sipmedia_t.lp\"}]},{\"id\":\"sipslc\",\"name\":\"SLIC configuration\",\"pageHelp\":\"Configure ringing voltage, loop current and open circuit voltage information.\",\"extData\":\"Configuration will take effect only after the device is rebooted!\",\"area\":[{\"area\":\"voip_sipslc_t.lp\"}]},{\"id\":\"sipCallerID\",\"name\":\"Caller ID\",\"pageHelp\":\"This page provides the function of VoIP caller id parameter(s) configuration.\",\"extData\":\"This page provides the function of VoIP caller id parameter(s) configuration.\",\"area\":[{\"area\":\"voip_cid_sip_t.lp\"}]},{\"id\":\"fax\",\"name\":\"FAX\",\"pageHelp\":\"This page provides the function of FAX parameter(s) configuration. \",\"extData\":\"Enable or disable the FAX transport in T.38 Mode. \",\"area\":[{\"area\":\"voip_fax_t.lp\"}]},{\"id\":\"voipqos\",\"name\":\"QoS\",\"pageHelp\":\"This page provides VoIP QoS configuration features. \",\"extData\":\"{QOS of Signal/QOS of Media:}Config DSCP and 802.1p for signal and media respectively. \",\"area\":[{\"area\":\"Voip_Voip_QoS_t.lp\"},{\"area\":\"Voip_Voip_QoSMedia_t.lp\"}]}]},{\"id\":\"mgrAndDiag\",\"name\":\"Management & Diagnosis\",\"children\":[{\"id\":\"statusMgr\",\"name\":\"Status\",\"pageHelp\":\"This page shows the basic information of device. \",\"extData\":\"Display primary information of this device: model name, serial number, soft version, boot version, etc. \",\"area\":[{\"area\":\"devmgr_statusmgr_t.lp\"}]},{\"id\":\"devMgr\",\"name\":\"System Management\",\"children\":[{\"id\":\"rebootAndReset\",\"name\":\"Device Management\",\"pageHelp\":\"This page provides the function of device management. \",\"extData\":\"{Reboot Management/Factory Reset Management:}Reboot or restore default if needed. \",\"area\":[{\"area\":\"devmgr_restartmgr_t.lp\"},{\"area\":\"devmgr_ScheReboot_t.lp\"},{\"area\":\"db_resetmgr_t.lp\"}]},{\"id\":\"firmwareUpgr\",\"name\":\"Software Upgrade\",\"pageHelp\":\"This page provides the function of software upgrade. \",\"extData\":\"Upgrade software version by the operation. \",\"area\":[{\"area\":\"upgrade_firmware_t.lp\"}]},{\"id\":\"usrCfgMgr\",\"name\":\"User Configuration Management\",\"pageHelp\":\"This page provides the function of user configuration backup and restore. \",\"extData\":\"{Backup User Configuration/Restore User Configuration:}Export User Configuration: export user configuration file from device. Import User Configuration: import specified user configuration file to device. \",\"area\":[{\"area\":\"db_usrcfg_download_t.lp\"},{\"area\":\"db_usrcfg_upload_t.lp\"}]}]},{\"id\":\"accountMgr\",\"name\":\"Account Management\",\"pageHelp\":\"This page provides the function of web account parameter(s) configuration. \",\"extData\":\"{Admin Account Management:}Maintaining the WEB user's accounts information of the device. {{Idle Timeout:}Login timeout configuration. \",\"area\":[{\"area\":\"devauth_accountmgr_t.lp\"},{\"area\":\"web_login_timeout_t.lp\"}]},{\"id\":\"logMgr\",\"name\":\"Log Management\",\"pageHelp\":\"This page provides the function of log parameter(s) configuration.\",\"extData\":\"{System Log Management:}set the log enable, the log level, the remote log server. Log Search: based on different log level you chose, device displays the corresponding log. Log Download: you can download the log files from the device. Clear Log: delete the current log. {{Security Log Management:}Security log configuration management. \",\"area\":[{\"area\":\"log_syslogmgr2_t.lp\"},{\"area\":\"LogManag_Syslog_t.lp\"},{\"area\":\"log_seclogmgr_t.lp\"},{\"area\":\"log_wifilogmgr_t.lp\"}]},{\"id\":\"diagnosis\",\"name\":\"Diagnosis\",\"children\":[{\"id\":\"networkDiag\",\"name\":\"Network Diagnosis\",\"pageHelp\":\"This page provides the function of network diagnosis parameter(s) configuration. \",\"extData\":\"{PING Diagnosis:}This pages is used for diagnosing the network's connectivity from this device to the specified IP address or host name. {{Trace Route Diagnosis:}This pages is used for diagnosing the network status from this device to the specified IP address or host name by traceroute test. {Simulation:}Setting basic configuration for Simulation.. \",\"area\":[{\"area\":\"networkdiag_diagmgr_t.lp\"}]},{\"id\":\"mirror\",\"name\":\"Mirror Configuration\",\"pageHelp\":\"This page provides the function of mirror parameter(s) configuration. \",\"area\":[{\"area\":\"mirror_mirrormgr_t.lp\"}]},{\"id\":\"loopbackDetect\",\"name\":\"Loopback Detection\",\"pageHelp\":\"This page provides the function of loopback detection parameter(s) configuration. \",\"extData\":\"{Basic Configuration:}This page is used to configure the loopback global configuration. Port Closing Time is the port's shut down time when loopback detected;Loopback Recovery Time is used to determine if loopback disappears.If the period of this time has not received detection packets, namely, that the loop disappears. {{Switch Control:}This page is used to configure the loopback enable configuration. Loopback Enable is used to control whether to detecting loopback;Alarm Enable is used to control whether to report alarm when detected loopback;Portdislooped Enable is used to control whether to shut down the port when detected loopback. {{VLAN:}This page is used to configure the VLAN for detection packets, distinguish between the ports. \",\"area\":[{\"area\":\"loopback_basic_t.lp\"},{\"area\":\"loopback_enable_t.lp\"},{\"area\":\"loopback_vlan_t.lp\"}]},{\"id\":\"arpTable\",\"name\":\"ARP Table\",\"pageHelp\":\"This page shows the status of ARP table.\",\"extData\":\"ARP Information View. \",\"area\":[{\"area\":\"arp_arptable_t.lp\"}]},{\"id\":\"macTable\",\"name\":\"MAC Table\",\"pageHelp\":\"This page shows the status of MAC table.\",\"extData\":\"MAC Information View. \",\"area\":[{\"area\":\"macinfo_mactable_t.lp\"}]}]},{\"id\":\"IPv6SwitchMgr\",\"name\":\"IPv6 Switch\",\"pageHelp\":\"This page provides the function of IPv6 switch parameter(s) configuration. \",\"extData\":\"This page provides the function of IPv6 switch parameter(s) configuration. \",\"area\":[{\"area\":\"ipv6_enable_t.lp\"}]},{\"id\":\"Ethconfig\",\"name\":\"Uplink Mode Switch\",\"pageHelp\":\"This page provides the function of uplink mode switch.\",\"extData\":\"This page provides the function of uplink mode switch.\",\"area\":[{\"area\":\"devmgr_uplink_mode_t.lp\"}]},{\"id\":\"Energy\",\"name\":\"Energy Conservation\",\"children\":[{\"id\":\"EnergyMode\",\"name\":\"Energy Mode\",\"pageHelp\":\"This page provides energy-saving settings.\",\"area\":[{\"area\":\"energy_config_t.lp\"}]}]}]}];\nvar showMenuContent = \"\";\nvar level = 1;\ncreatMenu(menuTreeJSON, $(\"#menu-results\"), level);\n$(\"#menu-close\").focus();\ngetFocusToClick(\"[tabindex='0']\", $(\"#menu-container\"));\n$('.submenu, .lastmenu').hide();\nfirstMenuClick();\n});\n$(\"#menu-close\").click(function() {\n$(\"#page_container\").show();\n$(\"#menu-container\").hide();\n});\n});\nwindow.onresize = function()\n{\nif ($(\"#tipLayer\").css(\"display\") != \"none\")\n{\nreposition_box(\"tipLayer\");\nconsoleLog(\"window reseze!\");\n}\n}\n</script>\n</body>\n</html>\n"
