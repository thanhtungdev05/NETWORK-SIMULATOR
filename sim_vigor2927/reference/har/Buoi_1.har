            "text": "<!DOCTYPE html><html ng-app=\"myApp\" ng-controller=\"TranslateCtrl\"><head><script src=\"/js/gettext.min.js?094907\"></script><meta charset=\"UTF-8\"><link rel=\"stylesheet\" type=\"text/css\" href=\"/style.min.css?094907\"><script src=\"/js/dhtml.min.js?094907\"></script><script src=\"/js/webchange.js?094907\"></script></head><body class=\"ng-cloak\"><table align=\"center\" width=\"700\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><tr><td><b sub-title parent=\"{{ 'Firewall' | translate }}\" translate>General Setup</b><hr><form name=\"frm1\" method=\"post\" action=\"/cgi-bin/ipfbas.cgi\"><table align=\"center\" width=\"700\" border=\"1\" cellspacing=\"0\"><tr><td><table align=\"center\" width=\"700\" border=\"0\" cellspacing=\"0\" cellpadding=\"2\"><tr><td><br><br><table align=\"center\" width=\"95%\" cellspacing=\"0\" cellpadding=\"2\" border=\"0\"><tr><td width=\"20%\" id=\"tab1\" class=\"ontab\" onclick=\"onclktab(1)\"><b translate>General Setup</b></td><td width=\"20%\" id=\"tab2\" class=\"offtab\" onclick=\"onclktab(2)\"><b translate>Default Rule</b></td><td class=\"tabpadding\">&nbsp;</td></tr></table><div id=\"page1\" style=\"display:none\"><table align=\"center\" width=\"95%\" border=\"1\" cellspacing=\"0\"><tr><td><br><br><table align=\"center\" width=\"90%\" cellspacing=\"0\" cellpadding=\"2\" border=\"0\"><tr class=\"callfilter\"><td width=\"25%\"><b translate>Call Filter</b></td><td width=\"25%\"><input type=\"radio\" name=\"IPFCall\" value=\"Enable\" ><translate>Enable</translate></td><td width=\"50%\"><translate>Start Filter Set</translate>&nbsp;<select name=\"IPFCallSet\" size=\"1\"><option  value=\"0\">{{ 'Set' | translate }}#1</option><option selected value=\"1\">{{ 'Set' | translate }}#2</option><option  value=\"2\">{{ 'Set' | translate }}#3</option><option  value=\"3\">{{ 'Set' | translate }}#4</option><option  value=\"4\">{{ 'Set' | translate }}#5</option><option  value=\"5\">{{ 'Set' | translate }}#6</option><option  value=\"6\">{{ 'Set' | translate }}#7</option><option  value=\"7\">{{ 'Set' | translate }}#8</option><option  value=\"8\">{{ 'Set' | translate }}#9</option><option  value=\"9\">{{ 'Set' | translate }}#10</option><option  value=\"10\">{{ 'Set' | translate }}#11</option><option  value=\"11\">{{ 'Set' | translate }}#12</option></select></td></tr><tr class=\"callfilter\"><td></td><td><input type=\"radio\" name=\"IPFCall\" value=\"Disable\" checked><translate>Disable</translate></td><td></td></tr><tr><td width=\"25%\"><b translate>Data Filter</b></td><td width=\"25%\"><input type=\"radio\" name=\"IPFData\" value=\"Enable\" checked><translate>Enable</translate></td><td width=\"50%\"><translate>Start Filter Set</translate>&nbsp;<select name=\"IPFDataSet\" size=\"1\"><option selected value=\"0\">{{ 'Set' | translate }}#1</option><option  value=\"1\">{{ 'Set' | translate }}#2</option><option  value=\"2\">{{ 'Set' | translate }}#3</option><option  value=\"3\">{{ 'Set' | translate }}#4</option><option  value=\"4\">{{ 'Set' | translate }}#5</option><option  value=\"5\">{{ 'Set' | translate }}#6</option><option  value=\"6\">{{ 'Set' | translate }}#7</option><option  value=\"7\">{{ 'Set' | translate }}#8</option><option  value=\"8\">{{ 'Set' | translate }}#9</option><option  value=\"9\">{{ 'Set' | translate }}#10</option><option  value=\"10\">{{ 'Set' | translate }}#11</option><option  value=\"11\">{{ 'Set' | translate }}#12</option></select></td></tr><tr><td></td><td><input type=\"radio\" name=\"IPFData\" value=\"Disable\" ><translate>Disable</translate></td><td></td></tr><tr><td colspan=\"3\"><hr size=\"1\"></td></tr><tr class=\"vpn\" style=\"display:none\"><td colspan=\"3\"><input type=\"checkbox\" name=\"ipfVpnFrag\"><translate>Apply IP filter to VPN incoming packets</translate></td></tr><tr><td colspan=\"3\"><table><tr><td valign=\"top\" align=\"left\"><input type=\"checkbox\" name=\"ipfUdpFrag\"></td><td translate>Allow pass inbound fragmented large packets (required for cer