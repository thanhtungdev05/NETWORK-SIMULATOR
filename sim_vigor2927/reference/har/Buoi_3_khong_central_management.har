==100){ if($scope.arySchCmmt.length){if(myWindow!=null)myWindow.close();myWindow=window.open(\"/cgi-bin/func.cgi?sFormAuthStr=\"+top.authStr+\"&fid=8\",\"schedulelist\",\"toolbars=no,width=810px,height=800px,top=150px,left=\"+(screen.width/2-232)+\"px,status=no,scrollbars=yes,resize=yes,menubar=no\");}else{alert(gettext(\"There\\'s no schedule profile set, you can select [Create New] to set a profile.\"));return false;}}else if(f[\"sche\"+schIdx].value==101){ let nullProfidx=$scope.arySchCmmt.indexOf('');if(nullProfidx!=-1){if(myWindow!=null)myWindow.close();myWindow=window.open(\"/cgi-bin/v2x00.cgi?sFormAuthStr=\"+top.authStr+\"&fid=3&iSchWiz=1&b0=\"+(nullProfidx+1),\"creatnew\",\"toolbars=no,width=810px,height=800px,top=150px,left=\"+(screen.width/2-232)+\"px,status=no,scrollbars=yes,resize=yes,menubar=no\");}else{alert(gettext(\"All schedule profiles have been set!\"));return false;}}};$scope.$apply();angular.element(document.querySelector(\"#link_note a\")).attr(\"href\",\"/cgi-bin/cgilte.cgi?sFormAuthStr=\"+top.authStr+\"&fid=9\");}function settodefault(){if(true==confirm(gettext(\"Do you want to clear all profiles?\"))){f.sProfileAct.value=\"servsettodefault\";f.submit();}}function isValidSms(sText){var reEmail=/^[+|-]?[0-9]{1,}$/;return reEmail.test(sText);}function onClkBtnOk(){for(var i=0;i<MAX_PROFILE;i++){if(f[\"rep\"+i].value!=\"\"&&!isValidSms(f[\"rep\"+i].value)){alert(gettext(\"Invalid Recipient Number!\"));return;}if(f[\"sche\"+i+\"_0\"].value>15||f[\"sche\"+i+\"_1\"].value>15){alert(gettext(\"The maximum Index in Schedule Setup is ###MAX###\").replace(\"###MAX###\",15));return;}}angular.forEach(document.querySelectorAll(\":disabled\"),function(ele){ele.disabled=false;});if(checkWebChange()){f.webchange.value='1';}f.sProfileAct.value=\"servsaveitem\";f.submit();}function onRefreshSchedule(nSch,iSchIdx,iComment){arySchCmmt[iSchIdx-1]=iComment; onSelSchedule(iSchIdx);}function onSelSchedule(iSchIdx){var arytmp=schElementIdx.split('_');$scope.profileInfo[arytmp[0]]['schedule'+(parseInt(arytmp[1])+1)]=iSchIdx;$scope.$apply();}function onClkBtnCcl(){f.sProfileAct.value=\"servshowpage\";f.submit();}function gotoPage(_idx){if(_idx==0)f.sProfileAct.value=\"servshowpage\";else f.sProfileAct.value=\"mailservshowpage\";f.submit();}</script></body></html>"
