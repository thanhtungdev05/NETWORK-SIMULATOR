            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/dhtml.min.js?094907\"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><script> var bg=parent;</script></tr><tr><td colspan=2><b parent=\"{{ 'USB Application' | translate }}\" qslink=\"https://www.draytek.com/router-help-redirect?stk_title=USB Application&nd_title=SMB Client Support List\" sub-title translate>SMB Client Support List</b><hr><form name=frm1><table align=center border=0 cellpadding=2 cellspacing=0 width=700><tr><td translate>The following compatibility test lists suggested SMB clients supported by Vigor router.</td></tr></table><br><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=1 cellpadding=2 cellspacing=0 width=700><tr><td align=center width=40%><b translate>Platform</b></td><td align=center width=40%><b translate>Application</b></td><td align=center width=20%><b translate>Status</b></td></tr><script>var Platform=\"\";var arrlteInfo=JSON.parse(\"[['Microsoft&reg; Windows&reg; XP','Built in','I'],['Microsoft&reg; Windows Vista<sup>TM</sup>','Built in','Y'],['Microsoft&reg; Windows&reg; 7','Built in','Y'],['Microsoft&reg; Windows&reg; 8','Built in','M'],['Microsoft&reg; Windows&reg; 10','Built in','Y'],['OS X&reg; 10.7.5','Built in','Y'],['OS X&reg; 10.10','Built in','Y'],['Ubuntu 14.04','Built in','Y'],['Android<sup>TM</sup>','AndSMB','Y'],['Android<sup>TM</sup>','ES File Explorer','Y'],['Android<sup>TM</sup>','File Expert','Y'],['Android<sup>TM</sup>','File Manager','Y'],['Android<sup>TM</sup>','Solid Explorer','Y'],['Android<sup>TM</sup>','SharesFinder','Y'],['iOS','eXPlayer','Y'],['iOS','nPlayer','Y']]\".replace(/'/g,'\"'));var str=\"\";for(var i=0;i<arrlteInfo.length;i++){Platform=arrlteInfo[i