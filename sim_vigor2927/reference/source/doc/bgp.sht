<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src="/js/gettext.min.js?094907"></script><meta / charset=UTF-8><link href="/style.min.css?094907" rel=stylesheet type=text/css><script src="/js/dhtml.min.js?094907"></script><script src="/js/webchange.js?094907"></script><script src="/js/tool.min.js?094907"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=750><tr><td colspan=2><b parent="{{ 'Routing' | translate }}" qslink=https://www.draytek.com/support/search-kb/?search=BGP sub-title translate>BGP</b><hr><form action=/cgi-bin/v2x00.cgi method=post name=frm1><table align=center border=0 cellpadding=2 cellspacing=0 width=750><tr><th class=offtab id=tab1 onClick=dhtml.cycleTab(this.id);parent.sBgpStatusTag=this.id;hidefresh(); translate width=33%>Basic Settings</th><th class=offtab id=tab2 onClick=dhtml.cycleTab(this.id);parent.sBgpStatusTag=this.id;hidefresh(); translate width=33%>Static Network</th><td align=right class=red ng-if=showbasic>| <a href="/cgi-bin/v2x00.cgi?sFormAuthStr=TOO7UwhiVtwiiWv&fid=4060" translate>Refresh</a>&nbsp;|&nbsp; <a href="/cgi-bin/iprt.cgi?sFormAuthStr=TOO7UwhiVtwiiWv" translate>View Routing Table</a>&nbsp;|</td><td align=right class=red ng-if=shownet>|&nbsp; <a href="/cgi-bin/iprt.cgi?sFormAuthStr=TOO7UwhiVtwiiWv" translate>View Routing Table</a>&nbsp;|</td></tr></table><div class=pagetext id=page1><table border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=95%><tr><td colspan=2><b translate>Local</b></td></tr><tr><td colspan=2><input name=bgpchk ng-checked=bgpchk type=checkbox value=1>&nbsp;<translate>Enable BGP</translate></td></tr><tr ng-if=iOSPF><td colspan=2><input name=ospfchk ng-checked=ospfchk type=checkbox value=1>&nbsp;<translate>Redistribute OSPF routes into BGP</translate></td></tr><tr><td translate width=20%>Local AS Number</td><td><input maxlength=10 name=localasnum ng-model=localasnum size=20 type=text>&nbsp;&nbsp;&nbsp;&nbsp;(1~4294967295)</td></tr><tr><td translate>Hold Time</td><td><input maxlength=5 name=holdtime ng-model=holdtime size=15 type=text>&nbsp;&nbsp;&nbsp;&nbsp;(10~65535 <translate>Sec</translate>)</td></tr><tr><td translate>Connect Retry Time</td><td><input maxlength=3 name=retrytime ng-model=retrytime size=15 type=text>&nbsp;&nbsp;&nbsp;&nbsp;(3~255 <translate>Sec</translate>)</td></tr><tr><td translate>Router ID</td><td><input maxlength=16 name=routeid ng-model=routeid type=text>&nbsp;&nbsp;&nbsp;&nbsp;(e.g. 1.2.3.4)</td></tr><tr><td colspan=2><br></td></tr><tr><td colspan=2><b translate>Neighbor</b></td></tr><tr><td colspan=2><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 class=table-striped width=100%><thead><tr><th translate>Index</th><th translate>Enable</th><th translate>AS Number</th><th translate>Profile Name</th><th translate>IP Address</th><th ng-if=MD5Support translate>MD5 Auth</th><th translate>Status</th></tr></thead><tbody><tr ng-init="i = $index" ng-repeat="neb in aryNebor"><td align=center> <a href="/cgi-bin/v2x00.cgi?sFormAuthStr=TOO7UwhiVtwiiWv&fid=4061&iProfileIdx={{i}}">{{i+1}}</a></td><td align=center><input name=nebidx{{i}} ng-checked=neb.checked type=checkbox value=1></td><td align=center>{{neb.asNum}}</td><td align=center>{{neb.profile}}</td><td align=center>{{neb.ip}}</td><td align=center ng-if=MD5Support>{{neb.auth}}</td><td align=center>{{neb.status}}</td></tr></tbody></table></td></tr></table></td></tr><tr><td></td></tr></table></td></tr></table><table border=0 cellpadding=0 cellspacing=0 width=100%><tr><td><br></td></tr><tr><td align=center colspan=2><input class=btnw name=ok1 onclick=onClkOk() type=button value="{{ 'OK' | translate }}"></td></tr></table></div><div class=pagetext id=page2><table border=0 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=1 cellpadding=2 cellspacing=0 width=