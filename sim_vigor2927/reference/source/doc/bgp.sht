</textarea><script> top.ACTION_STATUS=-1;top.iActionStatusFlag='1';top.iFwUpgradeState='0';top.act_sta.damage_alert();var f=document.frm1;var bg=parent;var bgpInitScript=document.createElement("script");bgpInitScript.text=document.getElementById("bgpInit").value;document.head.appendChild(bgpInitScript);angular.element(document).ready(function(){$scope.bgpsc=aryBGP[5];$scope.$apply();initParameter();initPage();initWebChange();});function hidefresh(){if(parent.sBgpStatusTag=="tab2"){$scope.shownet=1;$scope.showbasic=0;}else{$scope.showbasic=1;$scope.shownet=0;}$scope.$apply();}function initPage(){dhtml.cycleTab((parent.sBgpStatusTag=="tab2")?'tab2':'tab1');hidefresh();angular.forEach(aryStaticNetwork,function(item,i){let obj=f['ipaddrmsk'+i];selectMaskOption(obj,8,32,1);selectMaskOption(obj,0,0,1);bg.setVle2Elmt(obj,item[1],0);});}function initParameter(){$scope.bgpchk=aryBGP[0]==1;if(iOSPF)$scope.ospfchk=ospf_route;if(aryBGP[1]>0)$scope.localasnum=aryBGP[1];if(aryBGP[2]>9)$scope.holdtime=aryBGP[2];if(aryBGP[3]>2)$scope.retrytime=aryBGP[3];$scope.routeid=aryBGP[4];$scope.iOSPF=iOSPF;$scope.aryStaticNetwork=aryStaticNetwork;$scope.MD5Support=MD5Support;$scope.aryNebor=[];angular.forEach(aryNebor,function(item,i){$scope.aryNebor.push({'checked':(aryNebor[i][0]==1),'asNum':(aryNebor[i][1]!=0)?aryNebor[i][1]:'','profile':aryNebor[i][2],'ip':aryNebor[i][3],'status':aryNebor[i][4]}); if(MD5Support)$scope.aryNebor[i]['auth']=(aryNebor[i][1]!=0)?aryNebor[i][5]:'';});}function onClkDel(){if(checkWebChange()){f.webchange.value='1';}f.fid.value=4063;f.submit();}function onClkOk(){var re=/[^0-9]/;if(f.localasnum.value>4294967295||f.localasnum.value<1||f.localasnum.value.match(re)){alert(gettext("Local AS Number is illegal!"));return;}if(f.holdtime.value>65535||f.holdtime.value<10||f.holdtime.value.match(re)){alert(gettext("Hold Time is illegal!"));return;}if(f.retrytime.value>255||f.retrytime.value<3||f.retrytime.value.match(re)){alert(gettext("Connect Retry Time is illegal!"));return;}for(i=0;i<aryStaticNetwork.length;i++){var ipaddr=f["ipaddr"+i].value;var ipaddrmsk=f["ipaddrmsk"+i].value;var epingip=f["epingip"+i].value;if(ipaddr!="0.0.0.0"&&ipaddr!=""&&!bg.isStrIp(ipaddr)){alert(gettext("IP Address is illegal!"));return;}if(!bg.checkMask(ipaddrmsk)&&ipaddrmsk!=""){alert(gettext("Subnet Mask is illegal!"));return;}if(epingip!="0.0.0.0"&&epingip!=""&&!bg.isStrIp(epingip)){alert(gettext("Ping IP is illegal!"));return;}}if(checkWebChange()){f.webchange.value='1';}f.fid.value=4062;f.submit();}</script></body></html>