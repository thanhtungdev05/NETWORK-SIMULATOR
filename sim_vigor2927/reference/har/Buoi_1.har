S Class' | translate }} 1 ({{ 'High' | translate }})</option><option value=3>{{ 'QoS Class' | translate }} 2 ({{ 'Medium' | translate }})</option><option value=4>{{ 'QoS Class' | translate }} 3 ({{ 'Low' | translate }})</option><option value=5>{{ 'QoS Other' | translate }} ({{ 'Lowest' | translate }})</option></select>&nbsp; <input name=ApplyToAll onClick=onApplyToAll() type=button value=\"{{ 'Apply' | translate }}\"></td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=90%><tr><td><table align=center class=table-striped id=traceable width=100%></table><br></td></tr></table></div><div class=pagetext id=page2><table align=center border=0 cellpadding=2 cellspacing=0 width=90%><tr><td><input class=btnw3 name=SelAll onClick=onSelAll(1) type=button value=\"{{ 'Select All' | translate }}\"><input class=btnw3 name=ClrAll onClick=onClrAll(1) type=button value=\"{{ 'Clear All' | translate }}\"></td><td align=right><translate>Action</translate>:&nbsp;<select name=iActAppeUntrace onchange=onChgUntrace()><option value=2>{{ 'QoS Class' | translate }} 1 ({{ 'High' | translate }})</option><option value=3>{{ 'QoS Class' | translate }} 2 ({{ 'Medium' | translate }})</option><option value=4>{{ 'QoS Class' | translate }} 3 ({{ 'Low' | translate }})</option><option value=5>{{ 'QoS Other' | translate }} ({{ 'Lowest' | translate }})</option></select></td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=90%><tr><td><table align=center width=100%><script> var aryTypeStart=new Array();var aryAppType=new Array();var strStart=aryAppQosVal[0][6];var i=0,j=0,rcnt=0;var str=\"\";aryTypeStart.push(0);aryAppType.push(strStart);for(var i=0;i<aryAppQosVal.length;i++){if(aryAppQosVal[i][6]==strStart||aryAppQosVal[i][2]=='1')continue;else{strStart=aryAppQosVal[i][6];aryTypeStart.push(i);aryAppType.push(strStart);}}for(i=0,j=0;i<aryAppQosVal.length&&j<=aryTypeStart.length;i++){if(aryAppQosVal[i][2]=='1'||(aryAppQosVal[i][6]==\"ONLINE GAME\"&&iCountryCode==14)) continue;if(i==aryTypeStart[j]){j++;rcnt=0;str+=\"<tr><td colspan=3>&nbsp</td></tr>\";str+=\"<tr><td width=20% align=center>{{ 'Enable' | translate }}</td><td width=50% align=center translate>\"+aryAppQosVal[i][6]+\"</td>\";str+=\"<td width=30% align=left>{{ 'Version' | translate }}</td></tr>\";}str+=\"<tr class=row\"+parseInt(rcnt++%2)+\">\";str+=\"<td align=center><input type=checkbox name=iQosUsage\"+i+\" value=1>\";str+=\"<select style=display:none name=iQosAction\"+i+\">\";str+=\"<option value=2>{{ 'QoS Class' | translate }} 1 ({{ 'High' | translate }})</option>\";str+=\"<option value=3>{{ 'QoS Class' | translate }} 2 ({{ 'Medium' | translate }})</option>\";str+=\"<option value=4>{{ 'QoS Class' | translate }} 3 ({{ 'Low' | translate }})</option>\";str+=\"<option value=5>{{ 'QoS Other' | translate }} ({{ 'Lowest' | translate }})</option></select></td>\";str+=\"<td align=left>\"+aryAppQosVal[i][4]+\"</td><td align=left>\"+aryAppQosVal[i][5]+\"</td></tr>\";}document.write(str);</script></table><br></td></tr></table></div><br><div><b translate>Note</b>: <ol><li translate>Please remember to adjust Inbound/Outbound bandwidth of your network in \"Quality of Service\".<br>This will help QoS to work more efficient.</li><li ng-show=\"'1' != '0'\" translate>When Hardware Acceleration enabled, APP QoS will not work for the inbound direction.</li></ol></div></td></tr></table><br><table align=center border=0><tr><td><input class=btnw name=btnOk onclick=onClkBtnOk() type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnCcl onclick=onClkBtnCcl() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table><input name=iAct type=hidden value=1><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></td></tr></table><script>var bg=parent;var f=document.frm1;var traceableHTML=\"\";var tmpTitle;var iCountryCode='71';angular.element(document).ready(function(){initPage();initParameter();});function initPage(){if(bg.sStatu