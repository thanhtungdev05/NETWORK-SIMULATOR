            "compression": 11012,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'Central Management' | translate }}\" sub-title translate>AP Maintenance</b><hr><form id=form1 method=post name=frm1><table align=center border=1 cellpadding=2 cellspacing=0 class=webshow width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=90%><tr><td><b translate>Select Action</b></td></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 width=90%><tr><td width=30%><translate>Action Type</translate>:</td><td width=70%><select form=form1 name=sltActTyp onchange=onChgSltActTyp()><option translate value=0>Config Backup</option><option translate value=1>Config Restore</option><option translate value=2>Firmware Upgrade</option><option translate value=3>Remote Reboot</option><option translate value=4>Factory Reset</option></select></td></tr></table><input form=form1 name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form><form enctype=multipart/form-data id=formup method=post name=frmup><table align=center border=0 cellpadding=2 cellspacing=0 width=90%><tr><td width=30%><translate>File/Path</translate>:</td><td><input class=file form=formup name=data size=30 type=file></td></tr></table><input form=formup name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form><form id=form2 method=post name=frm2><br><table align=center border=0 cellpadding=2 cellspacing=0 width=90%><tr><td><b translate>Select Device</b></td></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 width=90%><tr><td translate>Existing Device</td><td>&nbsp;</td><td translate>Selected Device</td></tr><tr><td><select form=form2 id=Exist_Dev multiple=multiple name=Exist_Dev ondblclick=\"dblClick(this.form.Exist_Dev, this.form.Selected_Dev, 1)\" size=10 style=width:260px;height:150px></select></td><td align=center><input class=btnw3 form=form2 name=add onclick=\"move( this.form.Exist_Dev, this.form.Selected_Dev, 1);\" type=button value=&#155;&#155;><br><br><input class=btnw3 form=form2 name=remove onclick=\"move( this.form.Selected_Dev, this.form.Exist_Dev, 0);\" type=button value=&#139;&#139;><br><br><input class=btnw3 form=form2 name=addAll onclick=\"moveAll( this.form.Exist_Dev, this.form.Selected_Dev, 1);\" type=button value=\"&#155;&#155;{{ 'All' | translate }}\"><br><br><input class=btnw3 form=form2 name=removeAll onclick=\"moveAll( this.form.Selected_Dev, this.form.Exist_Dev, 0);\" type=button value=\"&#139;&#139;{{ 'All' | translate }}\"></td><td align=center><select form=form2 id=Selected_Dev multiple=multiple name=Selected_Dev ondblclick=\"dblClick(this.form.Selected_Dev, this.form.Exist_Dev, 0)\" size=10 style=width:260px;height:150px></select></td></tr></table></td></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 class=webshow width=100%><div class=shownote style=display:none><b translate>Note</b>: <ol><li class=cfg_restore style=display:none translate>Selected Access Points will reboot after configuration is restored.</li><li class=fm_upgrade style=display:none translate>Selected Access Points will reboot after firmware is upgraded.</li><li class=fm_upgrade style=display:none translate>Check the latest Firmware Upgrade <a>Result</a>.</li></ol></div></table><br><table align=center class=webshow><tr><td><input class=btnw form=form2 name=btnOk onclick=onClkBtnOk() type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <input class=btnw form=form2 name=btnCcl onclick=onClkBtnCcl() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table><input form=form2 name=Selected_Idx type=hidden value=0><input form=form2 name=realtime type=hidden value><input form=form2 name=fid type=hidden value=2130><input form=form2 name=sAct type=hidden value=backup><input form=form2 name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form><form form=formload id=fwloading name=fwloading style=display:none><table align=center border=0 cellpadding=2 cellspacing=0 class=firmwareup width=100%><tr><td><b translate>AP Firmware Upgrade</b></td></tr></table><table align=center border=0 cellPadding=2 cellSpacing=0 class=firmwareup width=100%><tr><td align=center class=red translate>Firmware Upgrade is in progress... It must NOT be interrupted!</td></tr><tr><td align=center><img src=/images/wait.gif></td></tr></table><input form=formload name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form><form id=cfgrestore name=cfgrestore style=display:none><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>AP Configuration Restore</b></td></tr></table><table align=center border=0 cellPadding=2 cellSpacing=0 width=100%><tr><td align=center class=red translate>Configuration Restore is in progress... It must NOT be interrupted!</td></tr><tr><td align=center><img src=/images/wait.gif></td></tr></table><input form=cfgrestore name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></td></tr></table><script> top.ACTION_STATUS=-1;top.iActionStatusFlag='0';top.iFwUpgradeState='0';top.act_sta.damage_alert();var bg=parent;var f=document.frm1;var f2=document.frm2;var fup=document.frmup;var MAX_APM_CLIENT=parseInt('20');var apDevName=JSON.parse(\"['','','','','','','','','','','','','','','','','','','','']\".replace(/'/g,'\"'));var apModelName=JSON.parse(\"['','','','','','','','','','','','','','','','','','','','']\".replace(/'/g,'\"'));var sFwNameLeading=\"\";var sDrayOS5APModel='AP1062C/AP962C/AP805/AP905/AP916R/AP1070C';angular.element(document).ready(function(){init_Para();});function init_Para(){bg.setVle2Elmt(f.sltActTyp,bg.isltActTyp,0);initSltDev();onChgSltActTyp();angular.element(document.querySelector(\".fm_upgrade a\")).attr(\"href\",\"/doc/apfwup.htm\");}function onChgSltActTyp(){var sltActTyp=bg.getVleFromElmt(f.sltActTyp,0);bg.isltActTyp=sltActTyp;if(sltActTyp==0){bg.cpntCtrl(false,fup,fup.data,1);bg.hideElmtByClass(document,\"div\",\"shownote\");bg.hideElmtByClass(document,\"li\",\"cfg_restore\");bg.hideElmtByClass(document,\"li\",\"fm_upgrade\");}else if(sltActTyp==1){bg.cpntCtrl(true,fup,fup.data,1);bg.showElmtByClass(document,\"div\",\"shownote\");bg.showElmtByClass(document,\"li\",\"cfg_restore\");bg.hideElmtByClass(document,\"li\",\"fm_upgrade\");}else if(sltActTyp==2){bg.cpntCtrl(true,fup,fup.data,1);bg.showElmtByClass(document,\"div\",\"shownote\");bg.hideElmtByClass(document,\"li\",\"cfg_restore\");bg.showElmtByClass(document,\"li\",\"fm_upgrade\");}else if(sltActTyp==3){bg.cpntCtrl(false,fup,fup.data,1);bg.hideElmtByClass(document,\"div\",\"shownote\");bg.hideElmtByClass(document,\"li\",\"cfg_restore\");bg.hideElmtByClass(document,\"li\",\"fm_upgrade\");}else if(sltActTyp==4){bg.cpntCtrl(false,fup,fup.data,1);bg.hideElmtByClass(document,\"div\",\"shownote\");bg.hideElmtByClass(document,\"li\",\"cfg_restore\");bg.hideElmtByClass(document,\"li\",\"fm_upgrade\");}bg.cpntCtrl(sltActTyp!=0?true:false,f2,f2.addAll,2);if(sltActTyp==0){document.getElementById(\"Exist_Dev\").multiple=\"\";}else{document.getElementById(\"Exist_Dev\").multiple=\"multiple\";}}function initSltDev(){var i,op;for(i=0;i<f2.Exist_Dev.options.length;i++){f2.Exist_Dev.options[i]=null;}for(i=0;i<f2.Selected_Dev.options.length;i++){f2.Selected_Dev.options[i]=null;}for(var i=0;i<MAX_APM_CLIENT;i++){if(apDevName[i]!=\"\"){op=f2.Exist_Dev.options.length;f2.Exist_Dev.options[op]=new Option((i+1)+'-'+apDevName[i],i);}}}function onClkBackup(){var now=new Date(); now=now.toISOString().slice(0,10).replace(/-/g,'');f2.realtime.value=now;f2.Selected_Idx.value=f2.Selected_Dev.options[0].value; var myUrl='/'+sFwNameLeading+\"_\"+now+'.apcfg?'+now+'&'+f2.Selected_Idx.value+\"&sFormAuthStr=JdvKVyYlhh7GhS9\";$http.get(myUrl).then(function(response){ var blob=new Blo