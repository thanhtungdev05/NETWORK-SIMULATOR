            "compression": 5222,
            "text": "BODY {font-family:Arial, Helvetica, Verdana; font-size:10pt; background-color:#ffffff;} A {font-weight:bold; color: #000000;} b {font-weight:bold; color: #000000;} b.red {color:red; font-weight:bold} table {font-size: 10pt;} TD.title {font-family:Arial, Helvetica, sans-serif; font-weight:bold;} TD.arial {font-weight:bold} TD.number {font-family:sans-serif, Arial, Helvetica; font-size:9pt;} INPUT.ip {width:26px;border-width: 2px;} INPUT.hex {box-sizing:content-box;width:19px;border-width: 2px;padding:1px !important;} TH {color:#000000; font-weight:bold} TR.red td {color:red} TR.green td\t{color:green} TD {word-break: keep-all;} TD.black {color:black} TD.red {color:red} TD.blue {color:blue} TD.green {color:green} INPUT.btnw1 {width:1cm} INPUT.btnw {width:2cm} INPUT.btnw3 {width:3cm} INPUT.btnw4 {width:4cm} .row0 {background-color:#f0f0f0} .row1 {background-color:#FFFFFF} .redrow0 td\t{background-color:#f0f0f0; color:red} .redrow1 td\t{background-color:#FFFFFF; color:red} .redrow0 a\t{background-color:#f0f0f0; color:red} .redrow1 a\t{background-color:#FFFFFF; color:red} div.red {color: red} caption {text-align: left} input.progressbar {font-family:Arial; font-weight:bolder; color:#00FF00; background-color:black; padding:0px; border-style:none} input.percent {border:0px; background-color:transparent; color:red;} input.transpt {border:0px; background-color:transparent;} input.txtw1 {width:190px} select.txtw1 {width:190px} select.txtw2 {width:230px; font-family:'Courier New'} .offtab { font-family : Arial, Helvetica, sans-serif; font-size: 14px; background-color : #e5e5e5; border-right: solid 2px #ffffff; text-align: center; cursor:pointer; font-weight: bold; } table.class1 { background-color: #FFFFFF; border: solid 2px #C6C6C6; } .pagetext { visibility: hidden; display: none; position: relative; top: 0; border: solid 0px #000000; width:100%; } .ontab { font-family : Arial, Helvetica, sans-serif; font-size: 14px; background-color: #C6C6C6; border-righ