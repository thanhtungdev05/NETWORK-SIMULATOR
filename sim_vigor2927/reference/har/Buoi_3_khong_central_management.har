            "mimeType": "text/html",
            "compression": 6974,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/dhtml.min.js?094907\"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'Diagnostics' | translate }}\" sub-title translate>DHCP Table</b><hr><form action=/cgi-bin/dhcp.cgi method=post name=frm><table align=center border=0 cellpadding=2 cellspacing=0 width=700><tr><td><b translate>IPv4 Address Assignment Table</b></td></tr></table><br><table align=center border=0 cellpadding=2 cellspacing=0 width=700><tr><td><translate>Show</translate> : <select name=iLAN onChange=onChgLANSelect()><option selected translate value=255>ALL LANs</option><script> var iLANNumber='8';var DMZSuppot=parseInt('1');for(var ilan=0;ilan<iLANNumber;ilan++){document.write(\"<option value=\"+parseInt(ilan+1)+\">{{ 'LAN' | translate }}\"+(ilan+1)+\"</option>\");}if(DMZSuppot)document.write(\"<option value=100>{{ 'DMZ Subnet' | translate }}</option>\");if(webcfg.adminauth)document.write(\"<option value=101>{{ 'IP Routed Subnet' | translate }}</option>\");</script></select></td></tr><tr><td class=offtab id=tab1 onClick=dhtml.cycleTab(this.id);parent.sDHCPAdvTag=this.id; width=30%><b translate>Dynamic IP Assignment Table</b></td><td class=offtab id=tab2 onClick=dhtml.cycleTab(this.id);parent.sDHCPAdvTag=this.id; width=30%><b translate>Static IP Assignment Table</b></td><td align=right class=tabpadding width=60%><input name=showCmt onclick=onClkShowCmt() type=checkbox value=1>&nbsp;<translate>Show Comment</translate>&nbsp; <font color=red>|&nbsp; <a href=javascript:gotoPage(0) translate>Refresh</a>&nbsp;|</font></td></tr></table><div class=pagetext id=page1><table align=center border=0 cellpadding=2 cellspacing=0 width=700><tr><td align=left><textarea cols=84 name=Ip4DhcpTable READONLY rows=16 style=width:700px;height:300; wrap=off></textarea></td></tr></table></div><div class=pagetext id=page2><table align=center border=0 cellpadding=2 cellspacing=0 width=700><tr><td align=left><textarea cols=84 name=OtherIPTable READONLY rows=16 style=width:700px;height:300; wrap=off></textarea></td></tr></table></div><script>var max_page=parseInt(\"1\");var page=parseInt(\"1\");var str=\"\";if(max_page>1){str+=\"<table align=center width=100% border=0 cellspacing=0>\";str+=\"<tr><td class=red><<&nbsp;\";for(var i=1;i<=max_page;i++){if(i>1)str+=\"&nbsp;|&nbsp;\";if(i>16){str+=\"...\";max_page=16;break;}if(i==page)str+=i;else str+=\"<a href='javascript:gotoPage(\"+i+\")'>\"+i+\"</a>\";}str+=\"&nbsp;>></td><td align=right class=red>\";if(page>1)str+=\"<<&nbsp;<a href='javascript:gotoPage(\"+(page-1)+\")'>\"+gettext(\"Back\")+\"</a>\";if((page>1)&&(max_page>2)&&(page<max_page))str+=\"&nbsp;|&nbsp;\";if(page<max_page)str+=\"<a href='javascript:gotoPage(\"+(page+1)+\")'>\"+gettext(\"Next\")+\"</a>&nbsp;>>\";str+=\"</td></tr></table>\";document.write(str);}</script><br><table align=center border=0 cellpadding=2 cellspacing=0 class=IPv6table style=display:none width=700><tr><td><b translate>IPv6 Address Assignment Table</b></td><td align=right><font color=red>|&nbsp; <a href=javascript:gotoPage(0) translate>Refresh</a>&nbsp;|</font></td></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 class=IPv6table style=display:none width=700><tr><td><textarea cols=84 name=Ip6DhcpTable READONLY rows=16 style=width:700px; wrap=off>\n</textarea></td></tr></table><br><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"><input , name=iPageIdx type=hidden value=1></form></td></tr></table><script> top.ACTION_STATUS=-1;top.iActionStatusFlag='0';top.iFwUpgradeState='0';top.act_sta.damage_alert();var f=document.frm,bg=parent;var Ipv6Dhcp='##% Command missing, Valid commands are:##csm           ddns          dos           exit          internet      ip            ##ipf           log           ldap          tacacsplus    mngt          msubnet       ##object        port          portmaptime   ppa           hwaccswap     prn           ##qos           hwqos         quit          show          smb           srv           ##switch        sys           testmail      fs            upnp          usb           ##vigbrg        fullbrg       vlan          vpn           wan           hsportal      ##radius        local_8021x   wol           user          appqos        nand          ##apm           sfp           ethoam        ha            swm           fw_backupmode ##cert          service       dmn           ##';var aryIp6Dhcp=new Array();var Ipv4Dhcp=['Index\tIP Address     \tMAC Address      \tLeased Time   \tHOST ID                 \tComment     ','--------------------------------------------------------------------------------','[LAN1       : DHCP Server On    IP Pool: 192.168.1.10 ~ 192.168.1.209]','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','',''];var otherIpAssign=['Index\tIP Address     \tMAC Address      \tType          \tComment','--------------------------------------------------------------------------------','[LAN1       : 192.168.1.1/255.255.255.0]','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','','',''];angular.element(document).ready(function(){intiPage();});function intiPage(){var subnet=parseInt(\"255\");if(parent.sDHCPAdvTag==\"tab2\")dhtml.cycleTab(\"tab2\");else dhtml.cycleTab(\"tab1\");bg.setVle2Elmt(f.iLAN,subnet,0);if(bg.iDHCPLANCmt)bg.setVle2Elmt(f.showCmt,bg.iDHCPLANCmt,0);var show=bg.getVleFromElmt(f.showCmt,0);showLanIp4Dhcp(subnet,show);if(parseInt('0')&&'0'!=1&&'0'!=1){if(subnet!=101){ bg.showElmtByClass(document,\"table\",\"IPv6table\");showLanIp6Dhcp(subnet);}}}function showLanIp6Dhcp(subnet){aryTitle=Ipv6Dhcp.slice(Ipv6Dhcp.slice(4).indexOf(\"##% \")+8,Ipv6Dhcp.indexOf(\"####\")).split(\"   \");angular.forEach(aryTitle,function(i,j){i=i.trim();Ipv6Dhcp=Ipv6Dhcp.replace(i,gettext(i));});var str=Ipv6Dhcp.replace(\"####\",\"\");var aa=str.split(\"##% \");var content=\"\";var name=\"\";if(subnet==255)name=\"\";else if(subnet==100)name=gettext(\"DMZ\");else if(webcfg.adminauth&&subnet==101)name=gettext(\"IP Routed\");else name=gettext(\"LAN\")+\" \"+subnet;if(aa.length>=3){content+=aa[2]+\"\\n\";content+=\"--------------------------------------------------------------------------------------------------------------------------------\\n\";}for(i=3;i<aa.length;i++){if(aa[i]==\"\")continue;if(aa[i].search(name)==0)content+=aa[i]+\"\\n\";}f.Ip6DhcpTable.value=content;}function onClkShowCmt(){var subnet=bg.getVleFromElmt(f.iLAN,0);var show=bg.getVleFromElmt(f.showCmt,0);bg.iDHCPLANCmt=show;showLanIp4Dhcp(subnet,show);}function gotoPage(page){var cur_page=parseInt(\"1\");if((page>=1)&&(page<=16)){bg.setVle2Elmt(f.iPageIdx,page,0);}else if((cur_page>1)&&(page==100)){ bg.setVle2Elmt(f.iPageIdx,(cur_page-1),0);}else if((cur_page<16)&&(page==101)){ bg.setVle2Elmt(f.iPageIdx,(cur_page+1),0);}else{ bg.setVle2Elmt(f.iPageIdx,cur_page,0);}f.submit();}function onChgLANSelect(){var subnet=bg.getVleFromElmt(f.iLAN,0);bg.iDHCPLANSub=subnet;gotoPage(1);}function showLanIp4Dhcp(subnet,show){var i;var content=\"\";for(i=0;i<Ipv4Dhcp.length;i++){if(Ipv4Dhcp[i]==\"\")continue;var arrLine=Ipv4Dhcp[i].split(\"\\t\");if(arrLine.length==6){angular.forEach(arrLine,function(k,j){var title=k.trim();arrLine[j]=k.replace(title,gettext(title));});if(show==1)content+=arrLine[0]+\"\\t\"+arrLine[1]+\"\\t\"+arrLine[2]+\"\\t\"+arrLine[3]+\"\\t\"+arrLine[5]+\"\\n\";else content+=arrLine[0]+\"\\t\"+arrLine[1]+\"\\t\"+arrLine[2]+\"\\t\"+arrLine[3]+\"\\t\"+arrLine[4]+\"\\n\";}else{if(webcfg.adminauth&&Ipv4Dhcp[i].includes(\"IP Routed\"))content+=Ipv4Dhcp[i]+\"\\n\";}}f.Ip4DhcpTable.value=content;content=\"\";for(i=0;i<otherIpAssign.length;i++){if(otherIpAssign[i]==\"\")continue;var arrLine=otherIpAssign[i].split(\"\\t\");if(arrLine.length==5){angular.forEach(arrLine,function(k,j){var title=k.trim();arrLine[j]=k.replace(title,gettext(title));});if(show==1)content+=arrLine[0]+\"\\t\"+arrLine[1]+\"\\t\"+arrLine[2]+\"\\t\"+arrLine[3]+\"\\t\"+arrLine[4]+\"\\n\";else content+=arrLine[0]+\"\\t\"+arrLine[1]+\"\\t\"+arrLine[2]+\"\\t\"+arrLine[3]+\"\\t\\n\";}else{if(webcfg.adminauth&&otherIpAssign[i].includes(\"IP Routed\"))content+=otherIpAssign[i]+\"\\n\";}}f.OtherIPTable.value=content;}</script></body></html>"
