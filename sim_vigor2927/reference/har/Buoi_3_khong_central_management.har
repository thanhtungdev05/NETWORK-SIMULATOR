rr\"][0].click();}else{f[\"iPortMirr\"][1].click();}if(hasWan2Interface&&iWan2En!=\"\"){ if(iWan2En!=\"1\"||iMirr!=3){ if(f[\"iMirr\"][iMirr]&&$scope.isEnable){f[\"iMirr\"][iMirr].click();}else{f[\"iMirr\"].value=iMirr;}}else if(iWan2En==\"1\"){ if(f[\"iMirr\"][iMirr]&&$scope.isEnable){f[\"iMirr\"][0].click();}else{f[\"iMirr\"].value=0;}}}else{var iMirrIdx=transMirrToMirrIdx(iMirr);if(f[\"iMirr\"][iMirrIdx]&&$scope.isEnable){f[\"iMirr\"][iMirrIdx].click();}else{f[\"iMirr\"].value=iMirrIdx;}}if(isSupLinkAgg===1){var supLinkAggTxPorts=[f.iMirredTx1,f.iMirredTx2,f.iMirredTx3,f.iMirredTx7]; var supLinkAggRxPorts=[f.iMirred1,f.iMirred2,f.iMirred3,f.iMirred7]; setLinkAggPortStat();for(var i=0;i<supLinkAggTxPorts.length;i++){supLinkAggTxPorts[i].addEventListener(\"click\",setLinkAggPortStat);supLinkAggRxPorts[i].addEventListener(\"click\",setLinkAggPortStat);}}}function setLinkAggPortStat(){if(f.iPortMirr.value!=1){return false;}var ports=linkAggPorts;var iMirrValue=transMirrToMirrIdx(parseInt(f.iMirr.value));var controlPort,lockPort;for(var i=0;i<ports.length;i++){if(ports[i].lagPort==(iMirrValue+1)||ports[i].lagAggrPort==(iMirrValue+1)){var offset=iMirrValue-parseInt(f.iMirr[0].value);f.iMirr[offset]&&(f.iMirr[offset].checked=false);}controlPort=parseInt(ports[i].lagPort);lockPort=parseInt(ports[i].lagAggrPort);if(controlPort>lockPort){ controlPort=controlPort^lockPort;lockPort=controlPort^lockPort;controlPort=controlPort^lockPort;}disableMirrPort(controlPort);disableMirrPort(lockPort);var controlPortIdx=transTxRxPortToIdx(controlPort);var lockPortIdx=transTxRxPortToIdx(lockPort);if(controlPortIdx!=-1&&lockPortIdx!=-1){$scope.disLinkAggPort[\"port\"+lockPort]=true;if(f[\"iMirredTx\"+lockPortIdx]&&f[\"iMirredTx\"+controlPortIdx]){f[\"iMirredTx\"+lockPortIdx].checked=f[\"iMirredTx\"+controlPortIdx].checked;}if(f[\"iMirred\"+lockPortIdx]&&f[\"iMirred\"+controlPortIdx]){f[\"iMirred\"+lockPortIdx].checked=f[\"iMirred\"+controlPortIdx].checked;}$scope.$apply();}}return true;}function disableMirrPort(portNumber){var valueTmp;for(var i=0;i<f.iMirr.length;i++){valueTmp=parseInt(f.iMirr[i].value);if(valueTmp<=3&&(valueTmp+1)==portNumber){f.iMirr[i]&&(f.iMirr[i].disabled=true);}else if(valueTmp>3&&valueTmp==portNumber){f.iMirr[i]&&(f.iMirr[i].disabled=true);}}} function transMirrToMirrIdx(iMirr){var iMirrValue=parseInt(iMirr);return iMirrValue<4?iMirrValue:iMirrValue-1;} function transTxRxPortToIdx(portNumber){switch(portNumber){case 2:return 1;case 3:return 2;case 4:return 3;case 5:return 7;}return-1;}function onClkBtnOk(){if(bg.SHOW_LAN_PORTMIRO_SW&&parseInt('1')&&'4198'!='0'&&(((!f[\"iMirredTx4\"].disabled&&f[\"iMirredTx4\"].checked)||(!f[\"iMirred4\"].disabled&&bg.SHOW_LAN_PORTMIRO_TXRXSEP&&f[\"iMirred4\"].checked))||((!f[\"iMirredTx5\"].disabled&&f[\"iMirredTx5\"].checked)||(!f[\"iMirred5\"].disabled&&f[\"iMirred5\"].checked)))){if(confirm(gettext(\"Hardware accelerated WAN packets will not be mirrored.\\nDo you wish to disable the hardware acceleration function?\"))){f[\"disable_hwaccel\"].value=1;}}if(f.iPortMirr.value==1){var lowerBound=$scope.showMirrorPort1?0:1;var upperBound=portNum-1;if(transMirrToMirrIdx(f.iMirr.value)<lowerBound||transMirrToMirrIdx(f.iMirr.value)>upperBound||f.iMirr.value==\"\"){alert(gettext('Please select a mirror port!'));return false;}if(aryMirredTxElmt.length!=aryMirredElmt.length){throw new Error(\"aryMirredTxElmt.length != aryMirredElmt.length\");}var chk=0;for(var i=0;i<aryMirredTxElmt.length;i++){if((f[aryMirredTxElmt[i]]&&f[aryMirredTxElmt[i]].checked)||(f[aryMirredElmt[i]]&&f[aryMirredElmt[i]].checked)){chk=1;break;}}if(chk==0){alert(gettext('Please select at least one mirrored TX/RX port!'));return false;}}var tmp=bg.getVleFromElmt(f.iPortMirr[0],0);if(tmp!=iPortMirr)f.sProfileAct.value=1;for(var i=0;i<Object.keys($scope.disLinkAggPort).length;i++){Object.values($scope.disLinkAggPort)[i]=false;}$scope.$apply(); f.fid.value=2114;var data=serializeData(f);$http.post(\"/cgi-bin/v2x00.cgi\",data,{timeout:10000}).then(function(response){$scope.onSubmit=false;document.body.style.cursor=f.btnOk.style.cursor=\"default\";angular.element(document).ready(function(){f[\"iMirr\"][f[\"iMirr\"].value]&&f[\"iMirr\"][f[\"iMirr\"].value].click();});}).catch(function(){$scope.onSubmit=false;});document.body.style.cursor=f.btnOk.style.cursor=\"wait\";$scope.onSubmit=true;$scope.$apply();}function onClkEnable(e){$scope.isEnable=(e.value==1);if(bg.SHOW_LAN_PORTMIRO_MAXWAN&&'0'==0&&bg.getVleFromElmt(f.iPortMirr[0],0)==1){alert(gettext(\"WAN4 will not be available, and it will be mirror port!!\"));}$scope.$apply();if(isSupLinkAgg===1){setLinkAggPortStat();}f[\"iMirr\"][f[\"iMirr\"].value]&&f[\"iMirr\"][f[\"iMirr\"].value].click();}</script></body></html>"
