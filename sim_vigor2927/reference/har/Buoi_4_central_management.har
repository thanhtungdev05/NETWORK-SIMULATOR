            "size": 4968,
            "mimeType": "text/html",
            "compression": 3138,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'System Maintenance' | translate }}\" sub-title translate>Firmware Backup</b><hr><form action=/cgi-bin/v2x00.cgi method=POST name=frm1><table align=center border=0 cellpadding=0 cellspacing=0 width=600><tr><td style=text-indent:20><b translate>Automatic Firmware Recovery</b></td></tr><tr><td style=text-indent:20><hr size=1></td></tr><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=90%><tr><td width=5%><input name=fwrecen type=checkbox value=1></td><td translate>Enable automatic firmware recovery</td></tr><tr><td width=5%></td><td translate>If the router unexpectedly reboots three times in a row then the backup firmware will be restored to the unit on the third reboot.</td></tr></table></td></tr></table><br><table align=center border=0 cellpadding=0 cellspacing=0 width=600><tr><td style=text-indent:20><b translate>Backup Setting</b></td></tr><tr><td style=text-indent:20><hr size=1></td></tr><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=90%><tr><td><input name=iSetMode onclick=OnClkMode() type=radio value=0><translate>Backup after reboot</translate></td></tr><tr><td><input name=iSetMode onclick=OnClkMode() type=radio value=1><span class=\"link_bkupsysutday\" translate translate-params-max=\"7\">Backup after system uptime of <input> day <input> hour (max. {{max}} days)</span></td></tr><tr><td><input name=iSetMode onclick=OnClkMode() type=radio value=2><translate>Backup manually</translate></td></tr></table></td></tr></table><br><table align=center border=0 cellpadding=0 cellspacing=0 width=600><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=90%><tr><td><translate>Backup Firmware</translate>: <span id=fwbkver></td></tr><tr><td><translate>Last backup</translate>:<span id=lsttm></span></td></tr></table></td></tr></table><br><table align=center><tr align=center><td><input class=btnw name=btnOk onClick=onClkBtnOk(); type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnCcl onClick=onClkBtnCcl(); type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table><input name=fid type=hidden value=3100><input name=iAct type=hidden value=1><input name=webchange type=hidden value=0><input name=ifwHours type=hidden value=0><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></td></tr></table><script> top.ACTION_STATUS=-1;top.iActionStatusFlag='0';top.iFwUpgradeState='0';top.act_sta.damage_alert();var bg=parent;var f=document.frm1;var aryBakSetting=JSON.parse(\"[1,24,0,'2000/01/02 00:01:53','4.4.5.7',0]\".replace(/'/g,'\"'));var iTmpdays=0,iTmphours=0,q;angular.element(document).ready(function(){initParameter();initWebChange();});function initParameter(){iTmpdays=Math.floor(aryBakSetting[1]/24);iTmphours=aryBakSetting[1]%24;f.iSetMode[aryBakSetting[0]].checked=true;$scope.baktdisen=f.iSetMode.value==1?false:true;$scope.$apply();q=angular.element(document.querySelectorAll(\".link_bkupsysutday input\"));setAttributes(q[0],{\"type\":\"text\",\"size\":2,\"maxlength\":1,\"name\":\"irunDay\",\"value\":iTmpdays,\"ng-disabled\":\"baktdisen\"});setAttributes(q[1],{\"type\":\"text\",\"size\":2,\"maxlength\":2,\"name\":\"irunHour\",\"value\":iTmphours,\"ng-disabled\":\"baktdisen\"});compile(q[0]);compile(q[1]);document.getElementById(\"lsttm\").innerHTML=aryBakSetting[3];document.getElementById(\"fwbkver\").innerHTML=aryBakSetting[4];OnClkMode();f.fwrecen.checked=aryBakSetting[5];}function onClkBtnOk(){var fwhours=aryBakSetting[1];var iSetMode=f.iSetMode.value; if(iSetMode==1){var irunDay=f.irunDay.value;var irunHour=f.irunHour.value;if(irunDay==\"\"||isNaN(irunDay)||(irunDay<0)||irunHour==\"\"||isNaN(irunHour)||(irunHour<0)){alert(gettext(\"Value of day or hour is invalid!\"));return false;}fwhours=parseInt(irunDay)*24+parseInt(irunHour);if(fwhours==0){alert(gettext(\"Backup time should be more than 0 hour.\"));return false;}if(fwhours>168){alert(gettext(\"Backup time should not more than 168 hours(7 days).\"));return false;}}else if(iSetMode==2){if(aryBakSetting[2]==0){alert(gettext(\"This firmware revision already exists!\"));}}f.ifwHours.value=fwhours;bg.cpntCtrl(true,f,f.irunDay,2);if(checkWebChange()){f.webchange.value='1';}f.submit();}function onClkBtnCcl(){document.location=\"/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=3100\";}function OnClkMode(){$scope.baktdisen=f.iSetMode.value==1?false:true;$scope.$apply();}function setAttributes(el,attrs){for(var key in attrs){el.setAttribute(key,attrs[key]);}}function compile(element){var el=angular.element(element);$scope=el.scope();$injector=el.injector();$injector.invoke(function($compile){$compile(el)($scope)});}</script></body></html>"
