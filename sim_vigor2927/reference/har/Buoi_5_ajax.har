            "mimeType": "text/html",
            "compression": 12528,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/dhtml.min.js?094907\"></script><style type=text/css>\n\tbody{position:relative}\n\t#msgal{position:absolute;top:100px;left:30%;width:420px;height:230px;background:#eee;display:none;}\n\t#messagebody{margin:25px;}\n\t#close {margin:10px 180px}\n\t</style><textarea id=swmstatusinit style=\"display: none;\">\n\tvar aryGroup = [];\n\tvar newlist = [];\n\tvar sNamePwd = [['','','','','','','','','','','','','','','','','','','','','','','','','','','','','',''], ['','','','','','','','','','','','','','','','','','','','','','','','','','','','','','']];\n</textarea><script> var notestatus=0;var appeinitScript=document.createElement('script');appeinitScript.text=document.getElementById(\"swmstatusinit\").value;document.head.appendChild(appeinitScript); var aryGrName=new Array();var aryGrNameNum=new Array();for(var i=0,j=0;i<aryGroup.length;i++){if(i==0){aryGrName[j]=aryGroup[i][0];j++;}else{for(k=0;k<j;k++){if(aryGroup[i][0]==aryGrName[k])break;else if(k!=(j-1))continue;else{aryGrName[j]=aryGroup[i][0];j++;}}}}for(var i=0;i<aryGrName.length;i++){var k=0;for(var j=0;j<aryGroup.length;j++){if((aryGrName[i]==aryGroup[j][0])&&(aryGroup.length!=(j+1))){k++;}else if((aryGrName[i]==aryGroup[j][0])&&(aryGroup.length==(j+1))){k++;aryGrNameNum[i]=k;}else if((aryGroup.length==(j+1))){aryGrNameNum[i]=k;}}}</script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=800><tr><td><b parent=\"{{ 'Switch' | translate }}\" sub-title translate>Status</b><hr><form action=/cgi-bin/cgiswm.cgi method=post name=frm1><div id=msgal><div id=messagebody></div><div id=close> <a href=javascript:close() translate>Close</a></div></div><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td class=ontab id=tab1 onClick=gotoStatus() width=20%><b translate>Switch Status</b></td><td class=offtab id=tab2 onClick=gotoHier() width=20%><b translate>Switch Hierarchy</b></td><td class=offtab id=tab3 onClick=gotoDtl() width=20%><b translate>Detailed Info</b></td><td class=offtab id=tab4 onClick=gototr069set() width=20%><b translate>TR069 Setting</b></td><td align=right class=red>| <a href=\"/cgi-bin/cgiswm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=22\" translate>Refresh</a>|</td></tr></table><hr><table align=center border=0 cellpadding=2 cellspacing=0 id=extoff style=display:none width=100%><tr><td align=center id=link_exD translate><a>External Devices</a> is not enabled,click enable to start using Switch Management.</td></tr><tr><td></td></tr><tr><td></td></tr><tr><td align=center><input class=btnw name=btnOk onclick=clkOk() type=button value=\"{{ 'Enable' | translate }}\">&nbsp;&nbsp;<input class=btnw name=btnCa onclick=clkCl() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr><tr><td></td></tr><tr><td></td></tr><tr><td></td></tr><tr><td></td></tr><tr><td></td></tr><tr><td></td></tr><tr><td></td></tr><tr><td></td></tr><tr><td><b translate>Note</b>: <ol><li id=link_note translate>Please click Add New on <a>Central Management &gt;&gt; Switch &gt;&gt; Profile</a> to display a switch on Switch Hierarchy</li></ol></td></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 id=exton width=100%><tr><td><table align=center border=0 cellpadding=0 cellspacing=2 width=100%><tr><td align=right colspan=2><translate>View Group</translate>: <select name=selgrp onchange=selgrpf() size=1 style=width:120px><option translate value=0>All</option><script> for(i=0;i<aryGrName.length;i++){if(aryGrName[i]!='')document.write(\"<option value=\"+aryGrName[i]+\">\"+aryGrName[i]+\"</option>\")}</script></select></td></tr><tr><td><b translate>Status</b></td><td align=right style=display:none><translate>View VLAN</translate>: <select size=1 style=width:120px><option translate value=0>All</option></select></td></tr><tr><td colspan=2><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr style=\"background-color: #7A7A7A;\"><td align=center><font color=#ffffff translate>Group</font></td><td align=center><font color=#ffffff translate>Switch Name</font></td><td align=center><font color=#ffffff translate>IP Address</font></td><td align=center><font color=#ffffff translate>Model</font></td><td align=center><font color=#ffffff translate>System Uptime</font></td><td align=center><font color=#ffffff translate>Port in Use</font></td><td align=center><font color=#ffffff translate>Clients</font></td><td align=center><font color=#ffffff translate>Firmware Version</font></td><td align=center><font color=#ffffff translate>Last Process Status</font></td></tr><script> var str='';for(var i=0;i<aryGrName.length;i++){var k=0;for(var j=0;j<aryGroup.length;j++){if(aryGroup[j][0]==aryGrName[i]){if(k==0){if(aryGroup[j][7]!=-1)str+='<tr class=row'+(i+1)%2+' id='+aryGrName[i]+k+'><td align=center style=\"border-bottom:0px solid;\"><a href=\"/cgi-bin/cgiswm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=3&iPRIdx='+aryGroup[j][9]+'\">'+aryGrName[i]+'</a></td><td align=center><a href=\"/cgi-bin/cgiswm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=6&iPRIdx='+(parseInt(aryGroup[j][10]))+'&icfgidx='+aryGroup[j][7]+'&color='+aryGroup[j][8]+'\">'+aryGroup[j][1]+'</a></td>';else str+='<tr class=row'+(i+1)%2+' id='+aryGrName[i]+k+'><td align=center style=\"border-bottom:0px solid;\">'+aryGrName[i]+'</td><td align=center>'+aryGroup[j][1]+'</td>';}else if(aryGrNameNum[i]==(k+1)){if(aryGroup[j][7]!=-1)str+='<tr class=row'+(i+1)%2+' id='+aryGrName[i]+k+'><td style=\"border-top:0px solid;\">&nbsp;</td><td align=center><a href=\"/cgi-bin/cgiswm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=6&iPRIdx='+(parseInt(aryGroup[j][10]))+'&icfgidx='+aryGroup[j][7]+'&color='+aryGroup[j][8]+'\">'+aryGroup[j][1]+'</a></td>';else str+='<tr class=row'+(i+1)%2+' id='+aryGrName[i]+k+'><td style=\"border-top:0px solid;\">&nbsp;</td><td align=center>'+aryGroup[j][1]+'</td>';}else{if(aryGroup[j][7]!=-1)str+='<tr class=row'+(i+1)%2+' id='+aryGrName[i]+k+'><td style=\"border-top:0px solid;border-bottom:0px solid;\">&nbsp;</td><td align=center><a href=\"/cgi-bin/cgiswm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=6&iPRIdx='+(parseInt(aryGroup[j][10]))+'&icfgidx='+aryGroup[j][7]+'&color='+aryGroup[j][8]+'\">'+aryGroup[j][1]+'</a></td>';else str+='<tr class=row'+(i+1)%2+' id='+aryGrName[i]+k+'><td style=\"border-top:0px solid;border-bottom:0px solid;\">&nbsp;</td><td align=center>'+aryGroup[j][1]+'</td>';}if(aryGroup[j][8]!=1)str+='<td align=center><font color=red>X '+aryGroup[j][2]+'</font></td>';else{if(aryGroup[j][3]=='G1241'||aryGroup[j][3]=='P1100')str+='<td align=center><a href=\"javascript:postG1241('+j+',0);\"><font color=green>'+aryGroup[j][2]+'</font></a></td>';else if(aryGroup[j][3]=='P2261'||aryGroup[j][3]=='G2260')str+='<td align=center><a target=\"_blank\" href=\"http://'+aryGroup[j][2]+'/config/login?username='+sNamePwd[0][aryGroup[j][12]]+'&password='+sNamePwd[1][aryGroup[j][12]]+'\"><font color=green>'+aryGroup[j][2]+'</font></a></td>';else if(aryGroup[j][3]=='G1260')str+='<td align=center><a target=\"_blank\" href=\"http://'+aryGroup[j][2]+'/pass?password='+sNamePwd[1][aryGroup[j][12]]+'&submit=Login\"><font color=green>'+aryGroup[j][2]+'</font></a></td>';else if(aryGroup[j][3]=='G2080')str+='<td align=center><a target=\"_blank\" href=\"http://'+aryGroup[j][2]+'/fake_server.html?textuser='+sNamePwd[0][aryGroup[j][12]]+'&textpass='+sNamePwd[1][aryGroup[j][12]]+'&Submit=Login\"><font color=green>'+aryGroup[j][2]+'</font></a></td>';else str+='<td align=center><a target=\"_blank\" href=\"http://'+aryGroup[j][2]+'\"><font color=green>'+aryGroup[j][2]+'</font></a></td>';}str+='<td align=center>'+aryGroup[j][3]+'</td>';str+='<td align=center>'+aryGroup[j][4]+'</td>';str+='<td align=center>'+aryGroup[j][5]+'</td><td align=center>'+aryGroup[j][6]+'</td>';str+='<td align=center>'+aryGroup[j][11]+'</td>';str+='<td align=center translate>'+aryGroup[j][13]+'</td>';str+='</tr>';k++;}}}document.write(str);</script></table></td></tr><tr><td colspan=2>&nbsp;</td><tr class=newlist><td colspan=2><b translate>New Switch List</b></td><tr class=newlist><td colspan=2><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr style=\"background-color: #7A7A7A;\"><td align=center><font color=#ffffff translate>Index</font></td><td align=center><font color=#ffffff translate>Switch Name</font></td><td align=center><font color=#ffffff translate>IP Address</font></td><td align=center><font color=#ffffff translate>MAC Address</font></td><td align=center><font color=#ffffff translate>Model</font></td><td align=center><font color=#ffffff translate>Firmware Version</font></td><td align=center><font color=#ffffff translate>Add Device</font></td></tr><script>var str='';for(i=0;i<newlist.length;i++){str+='<tr class=row'+i%2+'><td align=center>'+(i+1)+'</td>';str+='<td align=center>'+newlist[i][4]+'</td>';if(newlist[i][3]!=1)str+='<td align=center><font color=red>X '+newlist[i][0]+'</font></td>';else{if(newlist[i][2]=='G1241'||newlist[i][2]=='P1100')str+='<td align=center><a href=\"javascript:postG1241('+i+',1);\"><font color=green>'+newlist[i][0]+'</font></a></td>';else if(newlist[i][2]=='P2261'||newlist[i][2]=='G2260')str+='<td align=center><a target=\"_blank\" href=\"http://'+newlist[i][0]+'/config/login?username='+sNamePwd[0][newlist[i][6]]+'&password='+sNamePwd[1][newlist[i][6]]+'\"><font color=green>'+newlist[i][0]+'</font></a></td>';else if(newlist[i][2]=='G1260')str+='<td align=center><a target=\"_blank\" href=\"http://'+newlist[i][0]+'/pass?password='+sNamePwd[1][newlist[i][6]]+'&submit=Login\"><font color=green>'+newlist[i][0]+'</font></a></td>';else if(newlist[i][2]=='G2080')str+='<td align=center><a target=\"_blank\" href=\"http://'+newlist[i][0]+'/fake_server.html?textuser='+sNamePwd[0][newlist[i][6]]+'&textpass='+sNamePwd[1][newlist[i][6]]+'&Submit=Login\"><font color=green>'+newlist[i][0]+'</font></a></td>';else str+='<td align=center><a target=\"_blank\" href=\"http://'+newlist[i][0]+'\"><font color=green>'+newlist[i][0]+'</font></a></td>';}str+='<td align=center>'+newlist[i][1]+'</td>';str+='<td align=center>'+newlist[i][2]+'</td>';str+='<td align=center>'+newlist[i][5]+'</td>';if(newlist[i][7]==1){str+='<td align=center id=add1'+i+'><input onclick=AddDevice('+i+') type=button name=addnew value=\"'+\"{{ 'Add New' | translate }}\"+'\"></td>';str+='<td align=center style=display:none id=add2'+i+'><img src=\"/images/wait.gif\"></td>';str+='<td align=center style=display:none id=add3'+i+'><input type=button name=addnew value=\"'+\"{{ 'Add New' | translate }}\"+'\"></td></tr>';}else{notestatus=1;str+='<td align=center id=add1'+i+'><span style=\"color: red;\">'+gettext(\"Note\")+'</span></font></td>';str+='<td align=center id=add3'+i+' style=display:none><span style=\"color: red;\">'+gettext(\"Note\")+'</span></td></tr>';}}document.write(str);</script></table></td></tr></table><br></td></tr><tr><td><table align=center border=0 cellpadding=0 cellspacing=0 width=100%><tr><td valign=top><b translate>Note</b>:</td></tr><tr><td><ol><li> <a href=# onclick=showSupModelList() translate>Supported VigorSwitch model and firmware version</a></li><li class=kfc1 style=display:none translate>Please make sure that you've logged out from P1092/G1080 for SWM to manage them.</li><li class=kfc1 style=display:none translate>Please connect to port 1 of P1092/G1080 for SWM manage them.</li><li id=addnote style=display:none translate>Switch management supports at most 2 levels of switch hierarchy. Please add the switch that directly connects to router first (1st level), and then the \"add new\" button for 2nd level switch will be available.</li><li translate>The Switch Management function may not work correctly when the network has other brands switch. Please use VigorSwitch in the supported list only to ensure the function works.</li></ol></td></tr></table></td></tr><tr><td><input name=mac type=hidden><input name=fid type=hidden></td></tr></table><br><input name=sFormAuthStr type=hidden value=\"pU2VHFY4WAi1NkA\"></form></td></tr></table><script>top.ACTION_STATUS=-1;top.iActionStatusFlag='1';top.iFwUpgradeState='0';top.act_sta.damage_alert();var bg=parent;var f=document.frm1;var msg=['',''];angular.element(document).ready(function(){initPage();});var timeidx=0;function initPage(){if(!parseInt('0')){ bg.showElmtByClass(document,\"td\",\"kfc1\");}else bg.showElmtById(document,\"hidekfc\");if(!parseInt('1'))bg.hideElmtById(document,\"tab3\");if(!parseInt('1'))bg.hideElmtById(document,\"tab4\");if(msg[0]==0&&msg[0]!=''){if(confirm(gettext('Timeout.Please try again.'))){for(i=0;i<newlist.length;i++){if(newlist[i][1]==msg[1])break;}AddDevice(i);}}else if(msg[0]==2&&msg[0]!=''){alert(gettext('Please update switch firmware.'));}else if(msg[0]==100&&msg[0]!=''){for(j=0;j<newlist.length;j++){bg.hideElmtById(document,\"add1\"+j);bg.showElmtById(document,\"add3\"+j);if(msg[1]==newlist[j][1]){bg.hideElmtById(document,\"add3\"+j);bg.showElmtById(document,\"add2\"+j);}}onloaddata();}if(newlist.length==0){bg.hideElmtByClass(document,\"tr\",\"newlist\");}if(''==' checked'&&''==' checked'){bg.hideElmtById(document,\"extoff\");bg.showElmtById(document,\"exton\");}else{bg.hideElmtById(document,\"exton\");bg.showElmtById(document,\"extoff\");}if(notestatus!=0){bg.showElmtById(document,\"addnote\");}else{bg.hideElmtById(document,\"addnote\");}angular.element(document.querySelector(\"#link_note a\")).attr(\"href\",\"/cgi-bin/cgiswm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=5\");angular.element(document.querySelector(\"#link_exD a\")).attr(\"href\",\"/cgi-bin/V2x00.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=2103\");}function onloaddata(){var mac='';$http.post(\"/swmgetstasusmac.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&mac=\"+mac).then(function onSuccess(response){if(response.data=='Configuration is Processing'){timeidx++;if(timeidx<7)setTimeout(\"onloaddata()\",10000);else{alert(gettext(\"Process fail 6 times,please try again\"));document.location.href=\"/cgi-bin/cgiswm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=0\";}}else{alert(gettext(response.data));document.location.href=\"/cgi-bin/cgiswm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=0\";}});}function clkOk(){document.location.href=\"/cgi-bin/v2x00.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=2433&sExtDevDis=On&webchange=1\";}function clkCl(){document.location.href=\"/cgi-bin/cgiswm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=0\";}function gotoStatus(){document.location.href=\"/cgi-bin/cgiswm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=0\";}function AddDevice(i){for(j=0;j<newlist.length;j++){bg.hideElmtById(document,\"add1\"+j);bg.showElmtById(document,\"add3\"+j);}bg.hideElmtById(document,\"add3\"+i);bg.showElmtById(document,\"add2\"+i);f.mac.value=newlist[i][1];setTimeout(\"add()\",1000);}function add(){f.fid.value=24;f.submit();}function gotoHier(){document.location.href=\"/cgi-bin/cgiswm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=1\";}function gotoDtl(){document.location.href=\"/cgi-bin/cgiswm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=25\";}function gototr069set(){document.location.href=\"/cgi-bin/cgiswm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=45\";}function selgrpf(){if(f.selgrp.value==0){for(i=0;i<aryGrName.length;i++){for(j=0;j<aryGrNameNum[i];j++)bg.showElmtById(document,aryGrName[i]+j);}}else{for(i=0;i<aryGrName.length;i++){if(f.selgrp.value==aryGrName[i]){for(j=0;j<aryGrNameNum[i];j++)bg.showElmtById(document,aryGrName[i]+j);}else{for(j=0;j<aryGrNameNum[i];j++)bg.hideElmtById(document,aryGrName[i]+j);}}}}function postG1241(idx,num){if(num==0){var ipaddr=aryGroup[idx][2];var password=sNamePwd[1][aryGroup[idx][12]];var username=sNamePwd[0][aryGroup[idx][12]];}else if(num==1){var ipaddr=newlist[idx][0];var password=sNamePwd[1][newlist[idx][6]];var username=sNamePwd[0][newlist[idx][6]];}var ver=new Date().getTime(); $http.post(\"http://\"+ipaddr+\"/cgi/set.cgi?cmd=home_loginAuth&dummy=\"+ver,{\"_ds\":\"1\",\"username\":username,\"password\":password,\"_de\":\"1\"}).then(function(data1){if(data1.status==200){$http.get(\"http://\"+ipaddr+\"/cgi/get.cgi?cmd=home_loginStatus&dummy=\"+ver).then(function(data2){if(data2.status==200){window.open(\"http://\"+ipaddr+\"/home.html?ver=\"+ver);}else{alert(gettext(\"Login fail,please check your username and password!\"));}});}else{alert(gettext(\"Login fail,please check your username and password!\"));}});}function close(){ document.getElementById(\"msgal\").style.display=\"none\";}function showSupModelList(){ window.open(\"./swmlist.htm?opid=1\",\"Supported VigorSwitch model and firmware version\",\"toolbars=no,width=500px,height=800px,top=150px,left=\"+(screen.width/2-232)+\"px,status=no,scrollbars=yes,resize=yes,menubar=no\");}</script></body></html>"
