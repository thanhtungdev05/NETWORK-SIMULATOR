me=OP type=hidden value><tr><td width=10></td><td width=50><img onclick=go_url() onmouseover=this.className='hand'; src=/images/reload.gif></td><td width=50><img onclick=up() onmouseover=this.className='hand'; src=/images/up.gif></td><td width=50><img onclick=newfolder() onmouseover=this.className='hand'; src=/images/new_folder.gif></td><td class=standline width=500>&nbsp;<translate>Current Path</translate>:&nbsp;<script>document.write(sPath.replace(/\\s/g,\"\\u00a0\"));</script></td><td></td></tr><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></table></form><table align=center border=1 cellpadding=2 cellspacing=0 class=usbfileInfo width=100%><tr><td><table align=center border=0 cellpadding=0 cellspacing=0 width=100%><tr height=20><td valign=top><table cellpadding=0 cellspacing=0 class=main_menu height=20 width=100%><tr valign=middle><td width=10><td><td width=20><td><td align=center class=standline translate width=50%>Name</td><td align=right class=standline width=150><translate>Size</translate>&nbsp;</td><td align=center class=\"standline BTHide\" translate width=80>Delete</td><td align=center class=\"standline BTHide\" translate width=80>Rename</td><td class=\"standline BTHide\"></td></tr></table></td></tr></table><form action=\"/cgi-bin/usbwebget.cgi?sFormAuthStr=JdvKVyYlhh7GhS9\" method=POST name=frm_prog><table border=0 cellpadding=0 cellspacing=0 class=c4 id=dialoProgress name=dialoProgress style=\"display:none; position:absolute; left:421px; top:236px\"><tr><td><table align=center border=0 cellpadding=0 cellspacing=0 height=15 width=95%><tr><td align=right valign=bottom><img class=hand onclick=clkstop() src=/images/r_c.gif></td></tr></table></td></tr><tr><td align=center><table border=0 cellpadding=2 cellspacing=2 height=140 width=90%><tr><td align=center translate>Deleting the subfolders and files.</td></tr><tr><td align=center><img src=/images/wait.gif></td></tr><tr><td align=center><input class=btnw name=btnStop onclick=clkstop() type=butt