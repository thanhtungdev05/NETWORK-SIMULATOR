            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script><script></script></head><body class=ng-cloak><textarea id=ipnatpinit style=display:none>\n\tvar aryPtRedirect = [[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"],[\"\",\"\",0,0,0,-2,0,\"Any\"]];\n</textarea><table align=center border=0 cellpadding=0 cellspacing=0 width=800><tr><td><b parent=\"{{ 'NAT' | translate }}\" sub-title translate>Port Redirection</b><hr><form action=/cgi-bin/ipnat.cgi method=post name=frm1><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td align=right class=red>|&nbsp; <a class=DenyLink href=javascript:ruOK() translate>Set to Factory Default</a>&nbsp;|&nbsp; <a class=DenyLink href=javascript:clrSlt() translate>Clear selected</a>&nbsp;|</td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 width=100%><tr align=center><th translate width=7%>Index</th><th translate width=7%>Enable</th><th translate width=16%>Service Name</th><th translate width=12%>WAN Interface</th><th translate width=10%>Protocol</th><th translate width=14%>Public Port</th><th translate width=19%>Source IP</th><th translate width=19%>Private IP</th><th translate width=10%>Select</th></tr><script> var ipnatpinitScript=document.createElement('script');ipnatpinitScript.text=document.getElementById(\"ipnatpinit\").value;document.head.appendChild(ipnatpinitScript);var alias_num=parseInt(\"32\");var maxidx=parseInt(\"40\");var sLTEmodulename='LTE';var str=\"\";var i;for(i=0;i<aryPtRedirect.length;i++){ if(aryPtRedirect[i][1]==\"0.0.0.0\")aryPtRedirect[i][1]=\"\";str+=\"<tr align=center class=row\"+i%2+\">\";str+=\"<td><a href='javascript:gotoDetailSet(\"+(i+1)+\")'>\"+(i+1)+\".</a></td>\";if(aryPtRedirect[i][3]==0){str+=\"<td><input type=checkbox value=1 name=enPtRedirec\"+i+\"></td>\";}else{str+=\"<td><input type=checkbox value=1 name=enPtRedirec\"+i+\" checked></td>\";}str+=\"<td>&nbsp;\"+aryPtRedirect[i][0]+\"</td>\";if(aryPtRedirect[i][5]==-2)str+=\"<td>&nbsp;\"+gettext(\"ALL\")+\"</td>\";else if(aryPtRedirect[i][5]==-3)str+=\"<td>&nbsp;\"+gettext(\"VPN\")+\"</td>\";else{wan_slt_idx=Math.ceil((parseInt(aryPtRedirect[i][5])+2)/alias_num);if(((wan_slt_idx==3&&!parseInt('1'))||(wan_slt_idx==5&&parseInt('1')))&&(parseInt('0')))str+=\"<td>&nbsp;\"+gettext(sLTEmodulename)+\"</td>\";else str+=\"<td>&nbsp;\"+gettext(\"WAN\")+wan_slt_idx+\"</td>\";}if(aryPtRedirect[i][6]==6){str+=\"<td>&nbsp;\"+gettext(\"TCP\")+\"</td>\";}else if(aryPtRedirect[i][6]==17){str+=\"<td>&nbsp;\"+gettext(\"UDP\")+\"</td>\";}else{str+=\"<td>&nbsp;</td>\";}if(aryPtRedirect[i][2]<=1){if(aryPtRedirect[i][4]==0)str+=\"<td>&nbsp;</td>\";else str+=\"<td>&nbsp;\"+aryPtRedirect[i][4]+\"</td>\";str+=\"<td>&nbsp;\"+gettext(aryPtRedirect[i][7])+\"</td><td>&nbsp;\"+aryPtRedirect[i][1]+\"</td>\";}else{port_form=parseInt(aryPtRedirect[i][4]);ip_form=parseInt(aryPtRedirect[i][1].split(\".\")[3]);range=parseInt(aryPtRedirect[i][2]);ip_to=ip_form+range-1;port_to=port_form+range-1;str+=\"<td>&nbsp;\"+aryPtRedirect[i][4]+\" - \"+port_to+\"</td>\";str+=\"<td>&nbsp;\"+gettext(aryPtRedirect[i][7])+\"</td><td>&nbsp;\"+aryPtRedirect[i][1]+\" - \"+ip_to+\"</td>\";}str+=\"<td><input type=checkbox value=1 name=selClr\"+i+\"></td>\";str+=\"</tr>\";}document.write(str);</script></table></td></tr></table><br><table align=center border=0 cellspacing=0 width=700><tr><td align=center><input class=btnw name=btnOk onclick=submitParameter() type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnCcl onclick=onClkCnl() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table><br><input name=sFormAuthStr type=hidden value=\"pU2VHFY4WAi1NkA\"><input name=fid type=hidden><input name=iPageIdx type=hidden><input name=webchange type=hidden value=0></form><table border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><form><table width=100%><tr><td><translate>Backup settings</translate>: </td></tr><tr><td><input class=btnw id=cfgBackupBtn onclick=onBackup() type=button value=\"{{ 'Backup' | translate }}\"></td></tr></table><input name=sFormAuthStr type=hidden value=\"pU2VHFY4WAi1NkA\"></form></td><td><form action=\"/port_redirection.cgi?sFormAuthStr=pU2VHFY4WAi1NkA\" enctype=multipart/form-data method=post name=CfgRestoration><table width=100%><tr><td><translate>Upload From File</translate>: <input maxlength=256 name=filename size=30 type=file></td></tr><tr><td><input class=btnw3 id=cfgRestoreBtn onclick=\"return restoreCheck()\" type=submit value=\"{{ 'Restore' | translate }}\"></td></tr></table><input name=sFormAuthStr type=hidden value=\"pU2VHFY4WAi1NkA\"></form></td></tr></table></td></tr><tr><td><b translate>Note</b>: <ol><li id=link_note translate>The port number values set in this page might be invalid due to the same values configured for Management Port Setup in <a>System Maintenance &gt;&gt; Management</a>, <a>Open VPN</a>, and <a>SSL VPN</a>.</li></ol></td></tr></table><script>top.ACTION_STATUS=-1;top.iActionStatusFlag='0';top.iFwUpgradeState='0';top.act_sta.damage_alert();var f=document.frm1;var bg=parent;angular.element(document).ready(function(){initPage();});function initPage(){initWebChange();var linknote=document.querySelectorAll(\"#link_note a\");if(parent.SHOW_SYS_ADMIN){if(parseInt('1')){if(parseInt('1')){angular.element(linknote[0]).attr(\"href\",\"/cgi-bin/V2X00.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=2041'>\");angular.element(linknote[1]).attr(\"href\",\"/cgi-bin/V2X00.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=2410&sAct=showpage'>\");angular.element(linknote[2]).attr(\"href\",\"/cgi-bin/V2X00.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=4005'>\");}else if(parseInt('1')){angular.element(linknote[0]).attr(\"href\",\"/cgi-bin/V2X00.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=2041'>\");angular.element(linknote[1]).attr(\"href\",\"/cgi-bin/V2X00.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=2410&sAct=showpage'>\");}}else if(parseInt('1')){if(parseInt('1')&&parent.SHOW_SYS_ADMIN){angular.element(linknote[0]).attr(\"href\",\"/cgi-bin/V2X00.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=2041'>\");angular.element(linknote[2]).attr(\"href\",\"/cgi-bin/V2X00.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=4005'>\");}else if(parseInt('1')){angular.element(linknote[0]).attr(\"href\",\"/cgi-bin/V2X00.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=2041'>\");}}}else{if(parseInt('1')&&parent.SHOW_SYS_ADMIN){if(parseInt('1')){angular.element(linknote[1]).attr(\"href\",\"/cgi-bin/V2X00.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=2410&sAct=showpage'>\");angular.element(linknote[2]).attr(\"href\",\"/cgi-bin/V2X00.cgi?sFormAuthStr=pU2VHFY