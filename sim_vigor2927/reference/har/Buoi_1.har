            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><script> if(opener!=null)self.close();</script><tr><td><b parent=\"{{ 'User Management' | translate }}\" sub-title></b><b ng-if=modelis3200 translate>User Profile(Reserved)</b><b ng-if=!modelis3200 translate>User Profile</b><hr><form action=/cgi-bin/fwuser.cgi method=post name=frm1 onkeydown=\"if(event.keyCode==13){return false;}\"><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>User Profile Table</b>&nbsp;</td><td align=right class=red>|&nbsp; <a class=DenyLink href=javascript:ruOK() translate>Set to Factory Default</a>&nbsp;|</td></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><input class=btnw3 name=SelAll onClick=onSelAll() type=button value=\"{{ 'Select All' | translate }}\"><input class=btnw3 name=ClrAll onClick=onClrAll() type=button value=\"{{ 'Clear All' | translate }}\"></td><td align=right><input maxlength=23 name=SearchMsg type=text><input class=btnw name=ok_btn onClick=onSearch() type=button value=\"{{ 'Search' | translate }}\"></td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 width=100%><tr align=center><td width=10%><b translate>Profile</b></td><td width=10%><b translate>Enable</b></td><td width=30%><b translate>Name</b></td><td width=10%><b translate>Profile</b></td><td width=10%><b translate>Enable</b></td><td width=30%><b translate>Name</b></td></tr><script>var maxidx=parseInt(\"200\");var aryProfName=JSON.parse(\"[['admin','0','1'],['Dial-In User','1','1'],['','2','0'],['','3','0'],['','4','0'],['','5',