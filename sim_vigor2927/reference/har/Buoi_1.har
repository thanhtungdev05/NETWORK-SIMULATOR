            "size": 21552,
            "mimeType": "text/html",
            "compression": 16327,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><script src=\"/js/dhtml.min.js?094907\"></script><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><style>\n  .suboptions {\n    padding-left: 20px;\n  }\n</style></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'Firewall' | translate }}\" sub-title translate>Defense Setup</b><hr><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td class=offtab id=tab1 onClick=dhtml.cycleTab(this.id) width=30%><b translate>DoS Defense</b></td><td class=offtab id=tab2 ng-show=adminauth onClick=dhtml.cycleTab(this.id) width=30%><b translate>Spoofing Defense</b></td><td class=offtab id=tab3 ng-show=\"bEncKeyAlg && b_bfp\" onClick=dhtml.cycleTab(this.id) width=30%><b translate>Brute Force Protection</b></td><td class=tabpadding>&nbsp;</td></tr></table><br><div id=page1 style=display:none><form name=frm1><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>DoS defense</b></td></tr></table><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td colspan=3><input name=chxDos type=checkbox><translate>Enable DoS Defense</translate> &nbsp;&nbsp;<input class=btnw3 name=chxSltAll type=button value=\"{{ 'Select All' | translate }}\">&nbsp;<input class=BTnotGrayed name=btnWBlist type=button value=\"{{ 'White/Black List Option' | translate }}\"></td><td align=right width=30%><translate>Log</translate>: <select name=sltLog><option translate value=1>Enable</option><option translate value=0>Disable</option></select></td></tr><tr class=row0><td width=2%>&nbsp;</td><td width=49%><input name=chxSynFld type=checkbox><translate>Enable SYN flood defense</translate></td><td width=19%><translate>Threshold</translate></td><td width=30%><input maxlength=5 name=txtSynFld size=5 type=text> &nbsp;<translate>packets</translate> / <translate>sec</translate>&nbsp;</td></tr><tr class=row0><td width=2%>&nbsp;</td><td width=49%>&nbsp;</td><td translate width=19%>Timeout</td><td width=30%><input maxlength=5 name=txtSynTO size=5 type=text> &nbsp;<translate>sec</translate>&nbsp;</td></tr><tr class=row1><td width=2%>&nbsp;</td><td width=49%><input name=chxUdpFld type=checkbox><translate>Enable UDP flood defense</translate></td><td translate width=19%>Threshold </td><td width=30%><input maxlength=5 name=txtUdpFld size=5 type=text> &nbsp;<translate>packets</translate> / <translate>sec</translate>&nbsp;</td></tr><tr class=row1><td width=2%>&nbsp;</td><td width=49%>&nbsp;</td><td translate width=19%>Timeout</td><td width=30%><input maxlength=5 name=txtUdpTO size=5 type=text> &nbsp;<translate>sec</translate></td></tr><tr class=row0><td width=2%>&nbsp;</td><td width=49%><input name=chxIcmpFld type=checkbox><translate>Enable ICMP flood defense</translate></td><td translate width=19%>Threshold</td><td width=30%><input maxlength=5 name=txtIcmpFld size=5 type=text> &nbsp;<translate>packets</translate> / <translate>sec</translate>&nbsp;</td></tr><tr class=row0><td width=2%>&nbsp;</td><td width=49%>&nbsp;</td><td translate width=19%>Timeout</td><td width=30%><input maxlength=5 name=txtIcmpTO size=5 type=text> &nbsp;<translate>sec</translate></td></tr><tr class=row1><td width=2%>&nbsp;</td><td width=49%><input name=chxPS type=checkbox><translate>Enable Port Scan detection</translate></td><td translate width=19%>Threshold</td><td width=30%><input maxlength=5 name=txtPS size=5 type=text> &nbsp;<translate>packets</translate> / <translate>sec</translate>&nbsp;</td></tr><tr><td width=2%>&nbsp;</td><td width=49%><input name=chxBlkIp type=checkbox><translate>Block IP options</translate></td><td colspan=2><input name=chxBlkTcp type=checkbox value=checkbox><translate>Block TCP flag scan</translate></td></tr><tr><td width=2%>&nbsp;</td><td width=49%><input name=chxBlkLnd type=checkbox><translate>Block Land</translate></td><td colspan=2><input name=chxBlkTDrp type=checkbox><translate>Block Tear Drop</translate></td></tr><tr><td width=2%>&nbsp;</td><td width=49%><input name=chxBlkSmf type=checkbox><translate>Block Smurf</translate></td><td colspan=2><input name=chxBlkPing type=checkbox><translate>Block Ping of Death</translate></td></tr><tr><td width=2%>&nbsp;</td><td width=49%><input name=chxBlkTR type=checkbox><translate>Block trace route</translate></td><td colspan=2><input name=chxBlkIcmpFrag type=checkbox><translate>Block ICMP fragment</translate></td></tr><tr><td width=2%>&nbsp;</td><td width=49%><input name=chxBlkSynFrag type=checkbox><translate>Block SYN fragment</translate>&nbsp;</td><td colspan=2><input name=chxBlkUnProt type=checkbox><translate>Block Unassigned Numbers</translate></td></tr><tr><td width=2%>&nbsp;</td><td width=49%><input name=chxBlkFraggle type=checkbox><translate>Block Fraggle Attack</translate>&nbsp;</td><td colspan=2></td></tr></table><br><table align=center border=0><tr><td><textarea cols=70 disabled name=txtComment rows=3></textarea></td></tr></table></td></tr></table><br><table align=center border=0 width=100%><tr align=center><td><input class=btnw name=btnOk type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <input class=btnw3 name=btnClr type=button value=\"{{ 'Clear All' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnCcl type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table><table border=0 width=100%><tr><td colspan=2><b translate>Note</b>: <ol><li translate>Enabling the UDP Flood Defense option may affect UDP services, like NAT-T VPN, DNS, and VoIP service.</li><translate>When you have UDP servers running, please increase the UDP threshold according to the Internet speed, or add the server IP into the White List.</translate>&nbsp; <translate>The suggested threshold value are as follows</translate>:<br> 20M &nbsp;&nbsp;<translate>Bandwidth</translate>: 2,000 &nbsp;&nbsp;(<translate>packets</translate>/<translate>sec</translate>)<br> 60M &nbsp;&nbsp;<translate>Bandwidth</translate>: 5,000 &nbsp;&nbsp;(<translate>packets</translate>/<translate>sec</translate>)<br> 100M <translate>Bandwidth</translate>: 8,000 &nbsp;&nbsp;(<translate>packets</translate>/<translate>sec</translate>)<br> 300M <translate>Bandwidth</translate>: 25,000 (<translate>packets</translate>/<translate>sec</translate>) <li translate>Packets that have been accelerated by Hardware Acceleration will not be checked by the DoS Defense function.</li></ol></td></tr></table><br><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></div><div id=page2 style=display:none><form action=/cgi-bin/v2x00.cgi method=POST name=arpdefense><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>ARP Spoofing Defense</b></td><td align=right width=30%><translate>Log</translate>: <select name=sltLog><option translate value=1>Enable</option><option translate value=0>Disable</option></select></td></tr></table><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><input name=BlockArp1 type=checkbox value=1><translate>Block ARP replies with inconsistent source MAC addresses.</translate></td></tr><tr><td><input name=BlockArp2 type=checkbox value=1><translate>Block ARP replies with inconsistent destination MAC addresses.</translate></td></tr><tr><td><input name=DeclineVRRP type=checkbox value=1><translate>Decline VRRP MAC into ARP table.</translate></td></tr></table></td></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>IP Spoofing Defense</b></td></tr></table><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><input name=BlockIp1 type=checkbox value=1><translate>Block IP packet from WAN with inconsistent source IP addresses.</translate></td></tr><tr><td><input name=BlockIp2 type=checkbox value=1><translate>Block IP packet from LAN with inconsistent source IP addresses.</translate></td></tr></table></td></tr></table><table align=center border=0 width=100%><tr align=center><td><input class=btnw name=btnARPOk type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnARPCcl type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table><br><input name=fid type=hidden value=2033><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></div><div id=page3 style=display:none><form action=/cgi-bin/v2x00.cgi method=POST name=bfprotect><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>Brute Force Protection</b></td></tr></table><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td colspan=2><input name=iBrEn ng-model=brEnChecked type=checkbox value=1><translate>Enable brute force login protection</translate></td></tr><tr><td class=suboptions colspan=2><input name=iBrFtp ng-disabled=!brEnChecked type=checkbox value=1><translate>FTP Server</translate></td></tr><tr><td class=suboptions colspan=2><input name=iBrHttp ng-disabled=!brEnChecked type=checkbox value=1><translate>HTTP Server</translate></td></tr><tr><td class=suboptions colspan=2><input name=iBrHttps ng-disabled=!brEnChecked type=checkbox value=1><translate>HTTPS Server</translate></td></tr><tr><td class=suboptions colspan=2><input name=iBrTelnet ng-disabled=!brEnChecked type=checkbox value=1><translate>Telnet Server</translate></td></tr><tr><td class=suboptions colspan=2><input name=iBrTr069 ng-disabled=!brEnChecked type=checkbox value=1><translate>TR069 Server</translate></td></tr><tr><td class=suboptions colspan=2><input name=iBrSsh ng-disabled=!brEnChecked type=checkbox value=1><translate>SSH Server</translate></td></tr><tr><td class=suboptions colspan=2><input name=iBrVPN ng-disabled=!brEnChecked type=checkbox value=1><translate>VPN Server</translate></td></tr><tr><td class=suboptions translate>Maximum login failures</td><td><input maxlength=3 name=iLoginFailures size=5 value=0>&nbsp;<translate>times</translate></td></tr><tr><td class=suboptions translate>Penalty period</td><td><input maxlength=8 name=iPenaltyPeriod size=5 value=0>&nbsp;<translate>seconds</translate></td></tr><tr><td colspan=2> <a href=\"/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=193\" translate>Blocked IP List</a></td></tr></table></td></tr></table><table align=center border=0 width=100%><tr align=center><td><input class=btnw name=btnBFPOk type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnBFPCcl type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table><br><input name=fid type=hidden value=2076><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></div></td></tr></table><textarea id=dosinit style=display:none>\n  var arrBfpSrv = [1,1,1,1,1,1,1,1,5,300];\n  var b_bfp = 1;\n  var bEncKeyAlg = 1;\n</textarea><script src=\"/js/variable.js?34767\"></script><script> top.ACTION_STATUS=-1;top.iActionStatusFlag='4';top.iFwUpgradeState='0';top.act_sta.damage_alert();var dosinitScript=document.createElement(\"script\");dosinitScript.text=document.getElementById(\"dosinit\").value;document.head.appendChild(dosinitScript);var f=document.frm1;var f3=document.bfprotect;var bg=parent;var sysFlag2='269754496';var iHwAccSwitch='1';var Accept_Illegal_ARP=(1<<17);var Accept_Illegal_dst_ARP=(1<<18);var Block_Illegal_IP_from_WAN=(1<<19);var Block_Illegal_IP_from_LAN=(1<<20);var ENABLE_VRRP_ARP=(1<<17);var Dos_Defense_Log=(1<<23);var Spoofing_Defense_Log=(1<<24);var threshold_limit=20;var timeout_limit=5;var isclear=0;var dos;angular.element(document).ready(function(){dos=[[f.chxDos,bg.Enable_DoS_Defense,gettext(\"Enable DoS defense function to prevent the attacks from hacker or crackers.\")],[f.sltLog,Dos_Defense_Log,gettext(\"\")],[f.chxSynFld,bg.Enable_SYN_Flood,gettext(\"Defend SYN flood attack to make the server resource available for legitimate users.\")],[f.chxUdpFld,bg.Enable_UDP_Flood,gettext(\"Defend UDP flood attack to make the server resource available for legitimate users.\")],[f.chxIcmpFld,bg.Enable_ICMP_Flood,gettext(\"Defend ICMP flood attack to make the server resource available for legitimate users.\")],[f.chxPS,bg.Enable_PortScan,gettext(\"Detect PortScan attack to avoid the security hole exploring outside.\")],[f.chxBlkIp,bg.Block_IP_Option,gettext(\"Block IP packets with options to avoid the security hole exploring outside.(IPv4 only)\")],[f.chxBlkTcp,bg.Block_TCP_flag,gettext(\"Block TCP packets with irregular flags to avoid the security hole exploring outside.\")],[f.chxBlkLnd,bg.Block_Land,gettext(\"Defend Land attack to make the server alive.\")],[f.chxBlkTDrp,bg.Block_TearDrop,gettext(\"Defend Tear Drop attack to make the server alive.(IPv4 only)\")],[f.chxBlkSmf,bg.Block_Smurf,gettext(\"Defend Smurf attack to make the server alive.\")],[f.chxBlkPing,bg.Block_PingDeath,gettext(\"Block oversized and irregular packets sizes to prevent the system halt.\")],[f.chxBlkTR,bg.Block_TraceRT,gettext(\"Block trace route to avoid the security hole exploring outside.\")],[f.chxBlkIcmpFrag,bg.Block_ICMP_Frag,gettext(\"Block any ICMP frame with the More Fragments flag set.\")],[f.chxBlkSynFrag,bg.Block_SYN_Frag,gettext(\"Block any TCP SYN frame with the More Fragments flag set.\")],[f.chxBlkUnProt,bg.Block_Unassigned_NUM,gettext(\"Block any IP packets with unassigned or reserved protocol numbers.\")],[f.chxBlkFraggle,bg.Block_Fraggle,gettext(\"Block fraggle attack by blocking broadcast UDP packets.(IPv4 only)\")]];initPage();initParameter();});var aryInitValue=new Array();function initPage(){if(parent.sDefenseTag==\"tab3\"){dhtml.cycleTab(\"tab3\");parent.sDefenseTag=\"ta