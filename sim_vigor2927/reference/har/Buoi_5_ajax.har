            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'Central Management' | translate }}\" sub-title translate>AP Maintenance</b><hr><form id=form1 method=post name=frm1><table align=center border=1 cellpadding=2 cellspacing=0 class=webshow width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=90%><tr><td><b translate>Select Action</b></td></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 width=90%><tr><td width=30%><translate>Action Type</translate>:</td><td width=70%><select form=form1 name=sltActTyp onchange=onChgSltActTyp()><option translate value=0>Config Backup</option><option translate value=1>Config Restore</option><option translate value=2>Firmware Upgrade</option><option translate value=3>Remote Reboot</option><option translate value=4>Factory Reset</option></select></td></tr></table><input form=form1 name=sFormAuthStr type=hidden value=\"pU2VHFY4WAi1NkA\"></form><form enctype=multipart/form-data id=formup method=post name=frmup><table align=center border=0 cellpadding=2 cellspacing=0 width=90%><tr><td width=30%><translate>File/Path</translate>:</td><td><input class=file form=formup name=data size=30 type=file></td></tr></table><input form=formup name=sFormAuthStr type=hidden value=\"pU2VHFY4WAi1NkA\"></form><form id=form2 method=post name=frm2><br><table align=center border=0 cellpadding=2 cellspacing=0 width=90%><tr><td><b translate>Select Device</b></td></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 width=90%><tr><td translate>Existing Device</td><td>&nbsp;</td><td translate>Selected Device</td></tr><tr><td><select form=form2 id=Exist_Dev multiple=multiple name=Exist_Dev ondblclick=\"dblClick(this.form.Exist_Dev, this.form.Selected_Dev, 1)\" size=10 style=width:260px;height:150px></select></td><td align=center><input class=btnw3 form=form2 name=add onclick=\"move( this.form.Exist_Dev, this.form.Selected_Dev, 1);\" type=button value=&#155;&#155;><br><br><input class=btnw3 form=form2 name=remove onclick=\"move( this.form.Selected_Dev, this.form.Exist_Dev, 0);\" type=button value=&#139;&#139;><br><br><input class=btnw3 form=form2 name=addAll onclick=\"moveAll( this.form.Exist_Dev, this.form.Selected_Dev, 1);\" type=button value=\"&#155;&#155;{{ 'All' | translate }}\"><br><br><input class=btnw3 form=form2 name=removeAll onclick=\"moveAll( this.form.Selected_Dev, this.form.Exist_Dev, 0);\" type=button value=\"&#139;&#139;{{ 'All' | translate }}\"></td><td align=center><select form=form2 id=Selected_Dev multiple=multiple name=Selected_Dev ondblclick=\"dblClick(this.form.Selected_Dev, this.form.Exist_Dev, 0)\" size=10 style=width:260px;height:150px></select></td></tr></table></td></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 class=webshow width=100%><div class=shownote style=display:none><b translate>Note</b>: <ol><li class=cfg_restore style=display:none translate>Selected Access Points will reboot after configuration is restored.</li><li class=fm_upgrade style=display:none translate>Selected Access Points will reboot after firmware is upgraded.</li><li class=fm_upgrade style=display:none translate>Check the latest Firmware Upgrade <a>Result</a>.</li></ol></div></table><br><table align=center class=webshow><tr><td><input class=btnw form=form2 name=btnOk onclick=onClkBtnOk() type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <input class=btnw form=form2 name=btnCcl onclick=onClkBtnCcl() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table><input form=form2 name=Selected_Idx type=hidden value=0><input form=form2 name=realtime type=hidden value><input form=form2 name=fid type=hidden value=2130><input form=form2 name=sAct type=hidden value=backup><input form=form2 name=sFormAuthStr type=hidden value=\"pU2VHFY4WAi1NkA\"></form><form form=formload id=fwloading name=fwloading style=display:none><table align=center border=0 cellpadding=2 cellspacing=0 class=firmwareup width=100%><tr><td><b translate>AP Firmware Upgrade</b></td></tr></table><table align=center border=0 cellPadding=2 cellSpacing=0 class=firmwareup width=100%><tr><td align=center class=red translate>Firmware Upgrade is in progress... It must NOT be interrupted!</td></tr><tr><td align=center><img src=/images/wait.gif></td></tr></table><input form=formload name=sFormAuthStr type=hidden value=\"pU2VHFY4WAi1NkA\"></form><form id=cfgrestore name=cfgrestore style=display:none><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>AP Configuration Restore</b></td></tr></table><table align=center border=0 cellPadding=2 cellSpacing=0 width=100%><tr><td align=center class=red translate>Configuration Restore is in progress... It must NOT be interrupted!</td></tr><tr><td align=center><img src=/images/wait.gif></td></tr></table><input form=cfgrestore name=sFormAuthStr type=hidden value=\"pU2VHFY4WAi1NkA\"></form></td></tr></table><script> top.ACTION_STATUS=-1;top.iActionStatusFlag='0';top.iFwUpgradeState='0';top.act_sta.damage_alert();var bg=parent;var f=document.frm1;var f2=document.frm2;var fup=document.frmup;var MAX_APM_CLIENT=parseInt('20');var apDevName=JSON.parse(\"['','','','','','','','','','','','','','','','','','','','']\".replace(/'/g,'\"'));var apModelName=JSON.parse(\"['','','','','','','','','','','','','','','','','','','','']\".replace(/'/g,'\"'));var sFwNameLeading=\"\";var sDrayOS5APModel='AP1062C/AP962C/AP805/AP905/AP916R/AP1070C';angular.element(document).ready(function(){init_Para();});function init_Para(){bg.setVle2Elmt(f.sltActTyp,bg.isltActTyp,0);initSltDev();onChgSltActTyp();angular.element(document.querySelector(\".fm_upgrade a\")).attr(\"href\",\"/doc/apfwup.htm\");}function onChgSltActTyp(){var sltActTyp=bg.getVleFromElmt(f.sltActTyp,0);bg.isltActTyp=sltActTyp;if(sltActTyp==0){bg.cpntCtrl(false,fup,fup.data,1);bg.hideElmtByClass(document,\"div\",\"shownote\");bg.hideElmtByClass(document,\"li\",\"cfg_restore\");bg.hideElmtByClass(document,\"li\",\"fm_upgrade\");}else if(sltActTyp==1){bg.cpntCtrl(true,fup,fup.data,1);bg.showElmtByClass(document,\"div\",\"shownote\");bg.showElmtByClass(document,\"li\",\"cfg_restore\");bg.hideElmtByClass(document,\"li\",\"fm_upgrade\");}else if(sltActTyp==2){bg.cpntCtrl(true,fup,fup.data,1);bg.showElmtByClass(document,\"div\",\"shownote\");bg.hideElmtByClass(document,\"li\",\"cfg_restore\");bg.showElmtByClass(document,\"li\",\"fm_upgrade\");}else if(sltActTyp==3){bg.cpntCtrl(false,fup,fup.data,1);bg.hideElmtByClass(document,\"div\",\"shownote\");bg.hideElmtByClass(document,\"li\",\"cfg_restore\");bg.hideElmtByClass(document,\"li\",\"fm_upgrade\");}else if(sltActTyp==4){bg.cpntCtrl(false,fup,fup.data,1);bg.hideElmtByClass(document,\"div\",\"shownote\");bg.hideElmtByClass(document,\"li\",\"cfg_restore\");bg.hideElmtByClass(document,\"li\",\"fm_upgrade\");}bg.cpntCtrl(sltActTyp!=0?true:false,f2,f2.addAll,2);if(sltActTyp==0){document.getElementById(\"Exist_Dev\").multiple=\"\";}else{document.getElementById(\"Exist_Dev\").multiple=\"multiple\";}}function initSltDev(){var i,op;for(i=0;i<f2.Exist_Dev.options.length;i++){f2.Exist_Dev.options[i]=null;}for(i=0;i<f2.Selected_Dev.options.length;i++){f2.Selected_Dev.options[i]=null;}for(var i=0;i<MAX_APM_CLIENT;i++){if(apDevName[i]!=\"\"){op=f2.Exist_Dev.options.length;f2.Exist_Dev.options[op]=new Option((i+1)+'-'+apDevName[i],i);}}}function onClkBackup(){var now=new Date(); now=now.toISOString().slice(0,10).replace(/-/g,'');f2.realtime.value=now;f2.Selected_Idx.value=f2.Selected_Dev.options[0].value; var myUrl='/'+sFwNameLeading+\"_\"+now+'.apcfg?'+now+'&'+f2.Selected_Idx.value+\"&sFormAuthStr=pU2VHFY4WAi1NkA\";$http.get(myUrl).then(function(response){ var blob=new Blob([response.data],{type:\"application/octet-stream\"});var savefile=URL.createObjectURL(blob);var filedoc=document.createElement(\"a\");filedoc.href=savefile;filedoc.download=sFwNameLeading+\"_\"+now+'.cfg';filedoc.click();URL.revokeObjectURL(savefile);}).catch(function(response){alert(gettext(\"Please check that the AP is online and try again\"));});}function CheckOpTypecfg(){var tmp,tmp1,tmp2;var data=fup.data.value;if(data==\"\"){alert(gettext(\"File name is invalid, please check!\"));return false;}data=data.replace(/\\s+$/,\"\");tmp=sFwNameLeading+\"\\\\w*\\\\.cfg$\";tmp1=\"ap1000\"+\"\\\\w*\\\\.cfg$\";tmp2=\"ap920\"+\"\\\\w*\\\\.cfg$\";reg=new RegExp(tmp,\"i\");result=data.search(reg);reg1=new RegExp(tmp1,\"i\");result1=data.search(reg1);reg2=new RegExp(tmp2,\"i\");result2=data.search(reg2);if((result>0)||(result1>0)||(result2>0))return true;else{alert(gettext(\"File name is invalid, please check!\"));return false;}}function CheckOpTypeFw(slt){var tmp,tmp1,tmp2;var data=fup.data.value;if(data==\"\"){alert(gettext(\"File name is invalid, please check!\"));return false;}data=data.replace(/\\s+$/,\"\");var patt1=/[a-zA-Z]*\\d*/g;sFwNameLeading=apModelName[slt].match(patt1)[0];tmp=sFwNameLeading+\"\\\\w*\\\\.all$\";tmp1=sFwNameLeading+\"\\\\w*\\\\.sfw$\";reg=new RegExp(tmp,\"i\");result=data.search(reg);reg1=new RegExp(tmp1,\"i\");result1=data.search(reg1);if((result>0)||(result1>0))return true;else{alert(gettext(\"File name is invalid, please check!\"));return false;}}function CheckSelectedModelType(slt,op_type){var patt1=/[a-zA-Z]*\\d*/g;for(var i=1;i<slt.length;i++){sFwNameLeading=slt[0].match(patt1)[0];reg=new RegExp(sFwNameLeading,\"i\");result=slt[i].search(reg);if((result<0)){alertMsg(op_type);return false;}}return true;}function onclkRestore(){var args=0,devnum,url=\"\";if(!CheckOpTypecfg())return false;bg.showElmtById(document,\"cfgrestore\");bg.hideElmtById(document,\"fwloading\");bg.hideElmtByClass(document,\"table\",\"webshow\");devnum=f2.Selected_Dev.options.length;url=\"/APWebConfigRestore.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&num=\"+devnum;for(var i=0;i<devnum;i++)url+=\"&v\"+(i+1)+\"=\"+f2.Selected_Dev.options[i].value;fup.action=url;fup.submit();}function onclkFmupgrade(slt){var args=0,devnum,url=\"\";if(!CheckOpTypeFw(slt))return false;bg.showElmtById(document,\"fwloading\");bg.hideElmtById(document,\"cfgrestore\");bg.hideElmtByClass(document,\"table\",\"webshow\");devnum=f2.Selected_Dev.options.length;url=\"/APWebFwUpgrade.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&num=\"+devnum;for(var i=0;i<devnum;i++)url+=\"&v\"+(i+1)+\"=\"+f2.Selected_Dev.options[i].value;fup.action=url;fup.submit();}function onclkRemoteReboot(){var args=0,devnum,url=\"\";if(confirm(gettext(\"Remote Reboot!\"))){devnum=f2.Selected_Dev.options.length;url=\"/APWebRemoteReboot.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&num=\"+devnum;for(var i=0;i<devnum;i++)url+=\"&v\"+(i+1)+\"=\"+f2.Selected_Dev.options[i].value;fup.action=url;fup.submit();}}function onclkFactoryReset(){var args=0,devnum,url=\"\";if(confirm(gettext(\"Factory Reset!\"))){devnum=f2.Selected_Dev.options.length;url=\"/APWebFactoryReset.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&num=\"+devnum;for(var i=0;i<devnum;i++)url+=\"&v\"+(i+1)+\"=\"+f2.Selected_Dev.options[i].value;fup.action=url;fup.submit();}}function move(srcBox,destBox,type){var sltActTyp=bg.getVleFromElmt(f.sltActTyp,0);var flag=0;var aryExistModel=new Array();var i=srcBox.selectedIndex,k=0;if(sltActTyp==0&&destBox.options.length>=1&&type==1){alert(gettext(\"The maximum number of selected device is ###MAX###.\").replace(\"###MAX###\",1));return;}if(type==1){for(var j=0;j<srcBox.options.length;j++){if(srcBox.options[j].selected)aryExistModel[k++]=apModelName[srcBox.options[j].value];}if(!CheckSelectedModelType(aryExistModel,sltActTyp))return false;}while(i>=0){if(srcBox.options[i].value!=\"\"){var no=new Option(srcBox.options[i].text,srcBox.options[i].value,false,false);destBox.options[destBox.options.length]=no;srcBox.options[i]=null;}i=srcBox.selectedIndex;}}function moveAll(srcBox,destBox,type){var sltActTyp=bg.getVleFromElmt(f.sltActTyp,0);var flag=0;var aryExistModel=new Array();for(var i=0;i<srcBox.options.length;i++)aryExistModel[i]=apModelName[srcBox.options[i].value];if(type==1&&sltActTyp<3){if(!CheckSelectedModelType(aryExistModel,sltActTyp))return false;}for(var i=0;i<srcBox.length;i++){var no=new Option(srcBox.options[i].text,srcBox.options[i].value,false,false);destBox.options[destBox.options.length]=no;}srcBox.length=0;}function alertMsg(_type){if(_type==1) alert(gettext(\"Selected devices must be the same model/series to restore the config.\"));else if(_type==2) alert(gettext(\"Selected devices must be the same model/series to upgrade the firmware.\"));}function dblClick(srcBox,destBox,type){var sltActTyp=bg.getVleFromElmt(f.sltActTyp,0);if(sltActTyp==0&&type==1&&(f2.Selected_Dev.options.length==1)){alert(gettext(\"The maximum number of selected device is ###MAX###.\").replace(\"###MAX###\",1));return false;}var no=new Option(srcBox.options[srcBox.selectedIndex].text,srcBox.options[srcBox.selectedIndex].value,false,false);destBox.options[destBox.options.length]=no;srcBox.options[srcBox.selectedIndex]=null;}function isDrayOS5(model){var aryModel=sDrayOS5APModel.split(\"/\");for(var i=0;i<aryModel.length;i++){if(model==aryModel[i])return true;}return false;}function onClkBtnOk(){var txttmp,flag=0,Selected_Dev;bg.sltActTyp=bg.getVleFromElmt(f.sltActTyp,0);if(f2.Selected_Dev.options.length<=0){alert(gettext(\"There is no device to apply to.\"));return false;}Selected_Dev=f2.Selected_Dev.options[0].value;var aryTmpName=new Array();for(var i=0;i<f2.Selected_Dev.options.length;i++){aryTmpName[i]=apModelName[f2.Selected_Dev.options[i].value];if(aryTmpName[i]==\"AP800\"){alert(gettext(\"AP Maintenance does not support AP800.\"));return false;}else if(isDrayOS5(aryTmpName[i])){if(bg.sltActTyp==0){alert(gettext(\"Config Backup does not support \")+sDrayOS5APModel+\".\");return false;}else if(bg.sltActTyp==1){alert(gettext(\"Config Restore does not support \")+sDrayOS5APModel+\".\");return false;}else if(bg.sltActTyp==2){alert(gettext(\"Firmware Upgrade does not support \")+sDrayOS5APModel+\".\");return false;}}}if(bg.sltActTyp<3&&!CheckSelectedModelType(aryTmpName,bg.sltActTyp)){return false;}sFwNameLeading=apModelName[Selected_Dev];if(bg.sltActTyp==0){ if(f2.Selected_Dev.options.length==1)onClkBackup();else{alert(gettext(\"The maximum number of selected device is ###MAX###.\").replace(\"###MAX###\",1));return false;}}else if(bg.sltActTyp==1){ onclkRestore();}else if(bg.sltActTyp==2){ onclkFmupgrade(Selected_Dev);}else if(bg.sltActTyp==3){ onclkRemoteReboot();}else{ onclkFactoryReset();}}function onClkBtnCcl(){document.location=\"/cgi-bin/cgiapm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=3&sFormAuthStr=pU2VHFY4WAi1NkA\";}</script></body></html>"
