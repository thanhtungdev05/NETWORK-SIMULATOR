            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><meta content=\"30; URL=/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=2015\" http-equiv=Refresh><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 class=tblbg width=700><tr><td width=15>&nbsp;</td><td><table align=center border=0 cellpadding=0 cellspacing=0 width=100%><tr><td valign=top><b parent=\"{{ 'System Maintenance' | translate }}\" sub-title translate>System Status</b><hr><table align=center border=0 cellpadding=0 cellspacing=0 width=100%><tr><td align=left valign=top width=50%><table align=left border=0 cellpadding=0 cellspacing=0 width=100%><tr><td class=arial translate width=50%>Model Name</td><td class=arial width=50%>&nbsp;:&nbsp;Vigor2927</td></tr><tr><td class=arial translate>Firmware Version</td><td class=arial>&nbsp;:&nbsp;4.4.5.7</td></tr><tr><td class=arial translate>Build Date/Time</td><td class=arial>&nbsp;:&nbsp;Oct 23 2024 09:49:07</td></tr><tr ng-if=bAV><td class=arial translate>Signature Version</td><td class=arial>&nbsp;:&nbsp;<font color=red>(nil)</font></td></tr><tr ng-if=bAV><td class=arial translate>Signature Build Date</td><td class=arial>&nbsp;:&nbsp;<font color=red>(nil)</font></td></tr></table></td><td align=left valign=top width=50%><table align=left border=0 cellpadding=0 cellspacing=0 ng-if=sysInfo width=100%><tr><th translate>System</th></tr><tr><td><table align=center border=0 cellpadding=0 cellspacing=0 width=90%><tr><td translate width=50%>CPU Usage</td><td width=50%>&nbsp;:&nbsp;</td></tr><tr><td translate>Total Memory</td><td>&nbsp;: <script> var Memory='';Memory=Memory.replace(/\\)/,\"\");Memory=Memory.split(\"/\")[1];document.write(Memory);</script></td></tr><tr><td translate>Memory Usage</td><td>&nbsp;: <script>var usage='';usage=usage.split(\"(\")[0];document.write(usage);</script></td></tr></table></td></tr></table></td></tr></table><br><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><th translate>LAN</th></tr><tr><td><table align=center border=0 cellpadding=0 cellspacing=0 width=98%><tr><td>&nbsp;</td><td translate>MAC Address</td><td><span ng-if=\"first\">1st&nbsp;</span><translate>IP Address</translate></td><td><span ng-if=\"first\">1st&nbsp;</span><translate>Subnet Mask</translate></td><td translate>DHCP Server</td><td translate>DNS</td></tr><tr ng-if=item.showLan ng-repeat=\"item in lanInfo\"><td>{{item.name}}</td><td>{{item.mac}}</td><td>{{item.ip}}</td><td>{{item.mask}}</td><td>{{item.dhcp}}</td><td>{{item.prim}}</td></tr></table></td></tr></table><br><table align=center border=1 cellpadding=0 cellspacing=0 ng-if=!bWless width=100%><tr><th ng-if=bDualWless5G translate>Wireless LAN</th><th ng-if=!bDualWless5G translate>Wireless LAN(2.4GHz)</th></tr><tr><td><table align=center border=0 cellpadding=0 cellspacing=0 width=90%><tr><td translate width=30%>MAC Address</td><td translate width=30%>Frequency Domain</td><td translate width=30%>Firmware Version</td><td translate width=10%>SSID</td></tr><tr><td>{{sWlessMac}}</td><td>{{domainCodes}}</td><td></td><td nowrap>DrayTek-884338</td></tr></table></td></tr></table><span ng-if=\"bWless\"><br></span><table align=center border=1 cellpadding=0 cellspacing=0 ng-if=!bDualWless5G width=100%><tr><th translate>Wireless LAN(5GHz)</th></tr><tr><td><table align=center border=0 cellpadding=0 cellspacing=0 width=90%><tr><td translate width=30%>MAC Address</td><td translate width=30%>Frequency Domain</td><td translate width=30%>Firmware Version</td><td translate width=10%>SSID</td></tr><tr><td>{{sWlessDualMacAddr}}</td><td>{{domainCodes}}</td><td></td><td nowrap>DrayTek5G-884338</td></tr></table></td></tr></table><span ng-if=\"bDualWless5G\"><br></span><table align=center border=1 cellpadding=0 cellspacing=0 ng-show=adminauth width=100%><tr><th translate>WAN</th></tr><tr><td><table align=center border=0 cellpadding=0 cellspacing=0 class=table-striped width=100%><thead><tr><td>&nbsp;</td><td translate>Link Status</td><td translate>MAC Address</td><td translate>Connection</td><td translate>IP Address</td><td translate>Default Gateway</td></tr></thead><tbody><tr ng-repeat=\"item in wanInfo track by $index\" ng-style=\"{'color': item.color}\"><td align=center>{{item.name}}</td><td>{{item.status}}</td><td>{{item.mac}}</td><td>{{item.connMode}}</td><td>{{item.bandIp}}</td><td>{{item.gateIp}}</td></tr></tbody></table></td></tr></table><br ng-show=adminauth><table align=center border=1 cellpadding=0 cellspacing=0 ng-if=ipv6Info.hasIpv6 width=100%><tr><th translate>IPv6</th></tr><tr><td><table align=center border=0 cellpadding=0 cellspacing=0 class=table-striped width=98%><thead><tr><td>&nbsp;</td><td translate>Address</td><td translate>Scope</td><td translate>Internet Access Mode</td></tr></thead><tbody><tr ng-repeat=\"item in ipv6Info track by $index\" ng-style=\"{'color': item.color}\"><td>{{item.name}}</td><td>{{item.addr}}</td><td>{{item.scope}}</td><td>{{item.accMode}}</td></tr></tbody></table></td></tr></table><br><table align=center border=1 cellpadding=0 cellspacing=0 ng-if=voipInfo.hasVoip width=100%><tr><th translate>VoIP</th></tr><tr><td><table align=center border=0 cellpadding=0 cellspacing=0 width=98%><tr><td translate>Port</td><td translate>Profile</td><td translate>Reg.</td><td translate>In/Out</td></tr><tr ng-if=item.showPhone ng-repeat=\"item in voipInfo\"><td>{{item.port}}</td><td>{{item.account}}</td><td>{{item.status}}</td><td>{{item.call}}</td></tr></table></td></tr></table><div ng-if=\"!(SHOW_SYS_ADMIN && (sWuiLevelNum == 2 || sWuiLevelNum == 3))\"></div><div ng-if=\"SHOW_SYS_ADMIN && (sWuiLevelNum == 2 || sWuiLevelNum == 3)\"><br><hr><span id=\"usermodemsg\"><translate ng-if=\"SHOW_SYS_ADMIN && sWuiLevelNum == 2 && iUserMode1On\"><b>User Mode</b> is <font>ON</font> now.</translate><translate ng-if=\"SHOW_SYS_ADMIN && sWuiLevelNum == 2 && !iUserMode1On\"><b>User Mode</b> is <font>OFF</font> now.</translate><translate ng-if=\"SHOW_SYS_ADMIN && sWuiLevelNum == 3 && iUserMode2On\"><b>User Mode 2</b> is <font>ON</font> now.</translate><translate ng-if=\"SHOW_SYS_ADMIN && sWuiLevelNum == 3 && !iUserMode2On\"><b>User Mode 2</b> is <font>OFF</font> now.</translate></span></div></td></tr></table></td></tr></table><textarea id=statusinit style=\"display: none;\">\nvar sActPriDns = '8.8.8.8';\nvar DmzSubnetList = ['DMZ PORT', '192.168.254.1', '255.255.255.0', 1,'0.0.0.0'];\nvar IPRoutedList = ['IP Routed Subnet', '192.168.0.1', '255.255.255.0', 1, sActPriDns];\nif(webcfg.adminauth)\n\tvar arySubnetListTmp = [['LAN2','192.168.2.1','255.255.255.0',1,'0.0.0.0'],['LAN3','192.168.3.1','255.255.255.0',1,'0.0.0.0'],['LAN4','192.168.4.1','255.255.255.0',1,'0.0.0.0'],['LAN5','192.168.5.1','255.255.255.0',1,'0.0.0.0'],['LAN6','192.168.6.1','255.255.255.0',1,'0.0.0.0'],['LAN7','192.168.7.1','255.255.255.0',1,'0.0.0.0'],['LAN8','192.168.8.1','255.255.255.0',1,'0.0.0.0'],['LAN9','192.168.9.1','255.255.255.0',1,'0.0.0.0'],['LAN10','192.168.10.1','255.255.255.0',1,'0.0.0.0'],['LAN11','192.168.11.1','255.255.255.0',1,'0.0.0.0'],['LAN12','192.168.12.1','255.255.255.0',1,'0.0.0.0'],['LAN13','192.168.13.1','255.255.255.0',1,'0.0.0.0'],['LAN14','192.168.14.1','255.255.255.0',1,'0.0.0.0'],['LAN15','192.168.15.1','255.255.255.0',1,'0.0.0.0'],['LAN16','192.168.16.1','255.255.255.0',1,'0.0.0.0'], DmzSubnetList, IPRoutedList];\nelse\n\tvar arySubnetListTmp = [['LAN2','192.168.2.1','255.255.255.0',1,'0.0.0.0'],['LAN3','192.168.3.1','255.255.255.0',1,'0.0.0.0'],['LAN4','192.168.4.1','255.255.255.0',1,'0.0.0.0'],['LAN5','192.168.5.1','255.255.255.0',1,'0.0.0.0'],['LAN6','192.168.6.1','255.255.255.0',1,'0.0.0.0'],['LAN7','192.168.7.1','255.255.255.0',1,'0.0.0.0'],['LAN8','192.168.8.1','255.255.255.0',1,'0.0.0.0'],['LAN9','192.168.9.1','255.255.255.0',1,'0.0.0.0'],['LAN10','192.168.10.1','255.255.255.0',1,'0.0.0.0'],['LAN11','192.168.11.1','255.255.255.0',1,'0.0.0.0'],['LAN12','192.168.12.1','255.255.255.0',1,'0.0.0.0'],['LAN13','192.168.13.1','255.255.255.0',1,'0.0.0.0'],['LAN14','192.168.14.1','255.255.255.0',1,'0.0.0.0'],['LAN15','192.168.15.1','255.255.255.0',1,'0.0.0.0'],['LAN16','192.168.16.1','255.255.255.0',1,'0.0.0.0'], DmzSubnetList];\nvar aryWanName = [\"\",\"\",\"\",\"\",\"\",\"\"];\nvar v6conn_type = ['0','0','0','0','0','0'];//1:PPP 2:TSPC\nvar v6color_val = ['0','0','0','0','0','0'];//1: green 0:red\nvar sWlessMac = '62-c5-f5-f8-64-55'.toUpperCase();\nvar sWlessDualMacAddr = '62-c5-f5-f8-64-55'.toUpperCase();\nvar iBw1WanEnable = parseInt(\"1\");\nvar bVoIP = parseInt('0');\nvar iPhoneEpType2 = '4';\nvar iPhoneEpType3 = '(nil)';\nvar bIsdn = !parseInt('0');\nvar bDECT = !parseInt('0');\nvar sWuiLevelNum = '2';\nvar iDHCPType = parseInt(\"1\");\nvar sDHCPPri = '';\n\nvar bNewWLWAN = parseInt('1');\nvar bWless = !parseInt('0');\nvar bDrayIpv6 = parseInt('0');\nvar bDualWless5G = !parseInt('0');\nvar sMLSubnet = 1;\nvar iActSubnum = parseInt(\"8\");\nvar iSubnetNum = parseInt(\"16\");\nvar iDmzPrest = parseInt(\"1\");\nvar IntUK_2760End = '0';\nvar wannum = parseInt(\"6\");  //BWAN_NUM\nvar iFixWanNum = parseInt(\"4\");\nvar iUSBNum = parseInt(\"2\");\nvar iSecUsbNum = parseInt(\"1\");\nvar DualDslEnable = parseInt(\"0\") != 1;\nvar bDualDSL = parseInt('0');\nvar sLTEmodulename = 'LTE';\nvar extra_vdsl_idx = iFixWanNum + iUSBNum;\nvar idx_2nd_usb = iFixWanNum + iUSBNum - iSecUsbNum;\nvar sPresetModel = '2927';\nvar aryWanColor = [\t'red',\n\t\t\t\t\t'red',\n\t\t\t\t\t'red',\n\t\t\t\t\t'red',\n\t\t\t\t\t'red',\n\t\t\t\t\t'red'];\n\nvar aryWanMode = [\t'DHCP Client',\n\t\t\t\t\t'DHCP Client',\n\t\t\t\t\t'---',\n\t\t\t\t\t'---',\n\t\t\t\t\t'---',\n\t\t\t\t\t'---'];\n\nvar aryWanMac = [\n['14', '49', 'BC', '88', '43', '39'],\n['14', '49', 'BC', '88', '43', '3A'],\n['14', '49', 'BC', '88', '43', '3B'],\n['14', '49', 'BC', '88', '43', '3C'],\n['14', '49', 'BC', '88', '43', '3D'],\n['14', '49', 'BC', '88', '43', '3E']];\n\nvar aryWanBandIp = ['---',\n\t\t\t\t\t'---',\n\t\t\t\t\t'---',\n\t\t\t\t\t'---',\n\t\t\t\t\t'---',\n\t\t\t\t\t'---'];\n\nvar aryWanGWIp = [\t'---',\n\t\t\t\t\t'---',\n\t\t\t\t\t'---',\n\t\t\t\t\t'---',\n\t\t\t\t\t'---',\n\t\t\t\t\t'---'];\nvar bWAN2DISABLE = !parseInt('1');\nvar iLTEIndexNum = '3';\nvar bQLTE = parseInt('0');\nvar multiip6 = '1';\nvar Ipv6LanInfo = '##% Command missing, Valid commands are:##csm           ddns          dos           exit          internet      ip            ##ipf           log           ldap          tacacsplus    mngt          msubnet       ##object        port          portmaptime   ppa           hwaccswap     prn           ##qos           hwqos         quit          show          smb           srv           ##switch        sys           testmail      fs            upnp          usb           ##vigbrg        fullbrg       vlan          vpn           wan           hsportal      ##radius        local_8021x   wol           user          appqos        nand          ##apm           sfp           ethoam        ha            swm           fw_backupmode ##cert          service       dmn           ##';\nif(multiip6 == 0){\nvar aryIPv6WAN = ['##% Command missing, Valid commands are:##csm           ddns          dos           exit          internet      ip            ##ipf           log           ldap          tacacsplus    mngt          msubnet       ##object        port          portmaptime   ppa           hwaccswap     prn           ##qos           hwqos         quit          show          smb           srv           ##switch        sys           testmail      fs            upnp          usb           ##vigbrg        fullbrg       vlan          vpn           wan           hsportal      ##radius        local_8021x   wol           user          appqos        nand          ##apm           sfp           ethoam        ha            swm           fw_backupmode ##cert          service       dmn           ##'.replace(\"##WAN1\", \"\"), '##% Command missing, Valid commands are:##csm           ddns          dos           exit          internet      ip            ##ipf           log           ldap          tacacsplus    mngt          msubnet       ##object        port          portmaptime   ppa           hwaccswap     prn           ##qos           hwqos         quit          show          smb           srv           ##switch        sys           testmail      fs            upnp          usb           ##vigbrg        fullbrg       vlan          vpn           wan           hsportal      ##radius        local_8021x   wol           user          appqos        nand          ##apm           sfp           ethoam        ha            swm           fw_backupmode ##cert          service       dmn           ##'.replace(\"##WAN2\", \"\"),\n\t\t\t\t\t'##% Command missing, Valid commands are:##csm           ddns          dos           exit          internet      ip            ##ipf           log           ldap          tacacsplus    mngt          msubnet       ##object        port          portmaptime   ppa           hwaccswap     prn           ##qos           hwqos         quit          show          smb           srv           ##switch        sys           testmail      fs            upnp          usb           ##vigbrg        fullbrg       vlan          vpn           wan           hsportal      ##radius        local_8021x   wol           user          appqos        nand          ##apm           sfp           ethoam        ha            swm           fw_backupmode ##cert          service       dmn           ##'.replace(\"##IF#5\", \"\"), '##% Command missing, Valid commands are:##csm           ddns          dos           exit          internet      ip            ##ipf           log           ldap          tacacsplus    mngt          msubnet       ##object        port          portmaptime   ppa           hwaccswap     prn           ##qos           hwqos         quit          show          smb           srv           ##switch        sys           testmail      fs            upnp          usb           ##vigbrg        fullbrg       vlan          vpn           wan           hsportal      ##radius        local_8021x   wol           user          appqos        nand          ##apm           sfp           ethoam        ha            swm           fw_backupmode ##cert          service       dmn           ##'.replace(\"##IF#6\", \"\"),\n\t\t\t\t\t'##% Command missing, Valid commands are:##csm           ddns          dos           exit          internet      ip            ##ipf           log           ldap          tacacsplus    mngt          msubnet       ##object        port          portmaptime   ppa           hwaccswap     prn           ##qos           hwqos         quit          show          smb           srv           ##switch        sys           testmail      fs            upnp          usb           ##vigbrg        fullbrg       vlan          vpn           wan           hsportal      ##radius        local_8021x   wol           user          appqos        nand          ##apm           sfp           ethoam        ha            swm           fw_backupmode ##cert          service       dmn           ##'.replace(\"##IF#7\", \"\"), '##% Command missing, Valid commands are:##csm           ddns          dos           exit          internet      ip            ##ipf           log           ldap          tacacsplus    mngt          msubnet       ##object        port          portmaptime   ppa           hwaccswap     prn           ##qos           hwqos         quit          show          smb           srv           ##switch        sys           testmail      fs            upnp          usb           ##vigbrg        fullbrg       vlan          vpn           wan           hsportal      ##radius        local_8021x   wol           user          appqos        nand          ##apm           sfp           ethoam        ha            swm           fw_backupmode ##cert          service       dmn           ##'];\n}else{\nvar aryIPv6WAN = ['##% Command missing, Valid commands are:##csm           ddns          dos           exit          internet      ip            ##ipf           log           ldap          tacacsplus    mngt          msubnet       ##object        port          portmaptime   ppa           hwaccswap     prn           ##qos           hwqos         quit          show          smb           srv           ##switch        sys           testmail      fs            upnp          usb           ##vigbrg        fullbrg       vlan          vpn           wan           hsportal      ##radius        local_8021x   wol           user          appqos        nand          ##apm           sfp           ethoam        ha            swm           fw_backupmode ##cert          service       dmn           ##'.replace(\"##WAN1\", \"\"), '##% Command missing, Valid commands are:##csm           ddns          dos           exit          internet      ip            ##ipf           log           ldap          tacacsplus    mngt          msubnet       ##object        port          portmaptime   ppa           hwaccswap     prn           ##qos           hwqos         quit          show          smb           srv           ##switch        sys           testmail      fs            upnp          usb           ##vigbrg        fullbrg       vlan          vpn           wan           hsportal      ##radius        local_8021x   wol           user          appqos        nand          ##apm           sfp           ethoam        ha            swm           fw_backupmode ##cert          service       dmn           ##'.replace(\"##WAN2\", \"\"),\n\t\t\t\t\t'##% Command missing, Valid commands are:##csm           ddns          dos           exit          internet      ip            ##ipf           log           ldap          tacacsplus    mngt          msubnet       ##object        port          portmaptime   ppa           hwaccswap     