          "content": {
            "size": 17509,
            "mimeType": "text/html",
            "compression": 13574,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/tool.min.js?094907\"></script><script src=\"/js/dhtml.min.js?094907\"></script></head><body class=ng-cloak><textarea id=ftpstatinit style=\"display: none;\">\n\tvar aryPrintQue = [['(null)','','idle'],['(null)','','idle'],['(null)','','idle'],['(null)','','idle']];\n\tvar aryTemperInfo = ['0','',''];\n</textarea><table align=center border=0 cellpadding=0 cellspacing=0 width=700><script> var ftpstatinitScript=document.createElement('script');ftpstatinitScript.text=document.getElementById(\"ftpstatinit\").value;document.head.appendChild(ftpstatinitScript);var bUsbDevStat=parseInt('1');</script><tr><td><b parent=\"{{ 'USB Application' | translate }}\" sub-title></b><b ng-if=bUsbDevStat translate>USB Device Status</b><b ng-if=!bUsbDevStat translate>USB Disk Status</b><hr><form action=/cgi-bin/ftp.cgi method=post name=frm1><table align=center border=0 cellpadding=2 cellspacing=0 id=usbdev style=display:none width=700><tr><td class=offtab id=tab1 onClick=dhtml.cycleTab(this.id);parent.sUsbDevStatTag=this.id; width=15%><b translate>Disk</b></td><td class=offtab id=tab2 onClick=dhtml.cycleTab(this.id);parent.sUsbDevStatTag=this.id; width=15%><b translate>Modem</b></td><td class=offtab id=tab3 onClick=dhtml.cycleTab(this.id);parent.sUsbDevStatTag=this.id; width=15%><b translate>Printer</b></td><td class=offtab id=tab4 onClick=dhtml.cycleTab(this.id);parent.sUsbDevStatTag=this.id; width=15%><b translate>Sensor</b></td><td align=right class=red>|&nbsp; <a href=# onClick=javascript:OnRefresh() translate>Refresh</a>&nbsp;|</td></tr></table><div id=page2 style=display:none><table align=center border=0 cellpadding=2 cellspacing=0 id=modem1 style=display:none width=100%><tr><td colspan=2 width=60%><script>var iSecUsbNum=parseInt(\"1\");if(iSecUsbNum&&!parseInt('0'))document.write(gettext(\"Modem\")+\" 1\");else document.write(gettext(\"Modem\"));</script><translate>Connection Status</translate>:&nbsp;<span class=modemconn style=display:none><font color=green translate>Connected</font></span><span class=modemdisconn style=display:none translate>No Modem Connected</span></td></tr><tr class=modemconn style=display:none><td><b><translate>Information</translate> : </b></td></tr><tr class=modemconn style=display:none><td><table align=center border=1 cellpadding=2 cellspacing=0 width=80%><script>var aryInfoTitle=[gettext(\"Manufacturer\")+\":\",gettext(\"Model\")+\":\",gettext(\"Revision\")+\":\",gettext(\"Serial Number\")+\":\",gettext(\"IMSI\")+\":\",gettext(\"Signal Strength\")+\":\",gettext(\"Hardware\")+\":\",gettext(\"SIM PIN\")+\":\",gettext(\"Link Speed\")+\":\"];var aryInfostr='|||||||||||||||0%|||||||||0||||||||||||||||||0%|||||||||0';var aryInfo=aryInfostr.split(\"|||\");for(var i=0;i<aryInfo.length;i++){if(aryInfo[i]==\"\"||aryInfo[i]=='<NULL>'){aryInfo[i]=gettext('N/A');}}var str=\"\";for(var i=0;i<aryInfoTitle.length;i++){str+=\"<tr class=info_\"+i+\"><td width=40%>\"+aryInfoTitle[i]+\"</td><td>&nbsp;\"+aryInfo[i]+\"</td></tr>\";}document.write(str);</script></table></td></tr><script>var iHsdpaModemExist='0';var iHsdpa2ModemExist='0';var iWimaxOn='1';var iWimax2On='1';var iWimaxExist='0';var iWimax2Exist='0';str=\"\";if(parent.SHOW_SYS_ADMIN||!parseInt('0')){if(iHsdpaModemExist=='1'){str+=\"<tr><td><table align=center width=100% border=0 cellspacing=0 cellpadding=2><tr><td>\"+gettext(\"Setup\")+\" : \";str+=\"<a href='javascript:btn3GUSBModem(1)'><img border=0 align=middle src='/images/mdm1.gif' alt='\"+gettext(\"3G/4G Modem(PPP)\")+\"'></a>\";str+=\"</td></tr></table></td></tr>\";}else if(iWimaxOn=='1'&&iWimaxExist=='1'){str+=\"<tr><td><table align=center width=100% border=0 cellspacing=0 cellpadding=2><tr><td>\"+gettext(\"Setup\")+\" : \";str+=\"<a href='javascript:btnUSBWimax(1)'><img border=0 align=middle src='/images/wimax.gif' alt='\"+gettext(\"3G/4G Modem(DHCP)\")+\"'></a>\";str+=\"</td></tr></table></td></tr>\";}}document.write(str);</script></table><table align=center border=0 cellpadding=2 cellspacing=0 id=usb2modem style=display:none width=100%><tr><script>document.write('<td colspan=2 width=60%>'+((parseInt('0'))?gettext(\"Modem\")+\" \"+gettext(\"Connection Status\")+\":\":gettext(\"Modem\")+\" 2 \"+gettext(\"Connection Status\")+\":\")+'&nbsp;');</script><span class=modem2conn style=display:none><font color=green translate>Connected</font></span><span class=modem2disconn style=display:none translate>No Modem Connected</span></td></tr><tr class=modem2conn style=display:none><td><b><translate>Information</translate> : </b></td></tr><tr class=modem2conn style=display:none><td><table align=center border=1 cellpadding=2 cellspacing=0 width=80%><script>var aryInfoTitle=[gettext(\"Manufacturer\")+\":\",gettext(\"Model\")+\":\",gettext(\"Revision\")+\":\",gettext(\"Serial Number\")+\":\",gettext(\"IMSI\")+\":\",gettext(\"Signal Strength\")+\":\",gettext(\"Hardware\")+\":\",gettext(\"SIM PIN\")+\":\",gettext(\"Link Speed\")+\":\"];var aryInfostr='|||||||||||||||0%|||||||||0||||||||||||||||||0%|||||||||0';var aryInfo=aryInfostr.split(\"|||\");for(var i=0;i<aryInfo.length;i++){if(aryInfo[i]==\"\"||aryInfo[i]=='<NULL>'){aryInfo[i]=gettext('N/A');}}var str=\"\";for(var i=0;i<aryInfoTitle.length;i++){str+=\"<tr><td width=40%>\"+aryInfoTitle[i]+\"</td><td>&nbsp;\"+aryInfo[i+9]+\"</td></tr>\";}document.write(str);</script></table></td></tr><script>str=\"\";if(iHsdpa2ModemExist=='1'){str+=\"<tr><td><table align=center width=100% border=0 cellspacing=0 cellpadding=2><tr><td>\"+gettext(\"Setup\")+\" : \";str+=\"<a href='javascript:btn3GUSBModem(2)'><img border=0 align=middle src='/images/mdm1.gif' alt='\"+gettext(\"3G/4G Modem(PPP)\")+\"'></a>\";str+=\"</td></tr></table></td></tr>\";}else if(iWimax2On=='1'&&iWimax2Exist=='1'){str+=\"<tr><td><table align=center width=100% border=0 cellspacing=0 cellpadding=2><tr><td>\"+gettext(\"Setup\")+\" : \";str+=\"<a href='javascript:btnUSBWimax(2)'><img border=0 align=middle src='/images/wimax.gif' alt='\"+gettext(\"3G/4G Modem(DHCP)\")+\"'></a>\";str+=\"</td></tr></table></td></tr>\";}document.write(str);</script></table></div><div id=page1 style=display:none><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>USB Mass Storage Device Status</b></td></tr></table><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 width=100%><tr><td colspan=2 width=60%><translate>Connection Status</translate>:&nbsp; <span class=green style=display:none><font color=green translate>Disk Connected</font></span><span class=red style=display:none><font color=red translate>No Disk Connected</font></span></td><td align=right><input name=btndisConUSB onclick=disConDisk() type=button value=\"{{ 'Disconnect USB Disk' | translate }}\"></td></tr><tr class=wrpt style=display:none><td colspan=3><translate>Write Protect Status</translate>:&nbsp; <span class=wp style=display:none><font color=red translate>Yes</font></span><span class=nowp style=display:none><font color=green translate>No</font></span></td><tr><td colspan=3><translate>Disk Capacity</translate>:&nbsp;0&nbsp;MB</td></tr><tr><td colspan=3 width=100%><translate>Free Capacity</translate>:&nbsp;0&nbsp;MB &nbsp;&nbsp; <a href=# onClick=javascript:getfreedisc() translate>Refresh</a> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<span class=wait style=display:none><translate>Please Wait</translate>...&nbsp;&nbsp;<img src=/images/wait.gif></span></td></tr><tr><td colspan=3><br></td></tr><tr><td colspan=2 width=40%><b translate>USB Disk Users Connected</b></td><script>var str=\"\";if(parseInt('1'))str+='<td>&nbsp;</td>';else str+='<td class=red align=right>|&nbsp;<a href=# onClick=javascript:OnRefresh()>'+gettext('Refresh')+'</a>&nbsp;|</td>';document.write(str