            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'Certificate Management' | translate }}\" sub-title translate>Local Services List</b><hr><form action=/cgi-bin/v2x00.cgi method=post name=frm1><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td style=width:20% translate>Default Certificate</td><td><select name=defCert><option ng-selected=\"defcertSelected == 0\" translate value=0>self-signed</option><option ng-if=\"!$first && !$last\" ng-repeat=\"x in LoCfInfo\" ng-selected=\"{{x[1]}} == defcertSelected\" value={{x[1]}}>{{x[0]}}</option></select></td></tr></table><br><table align=center border=1 cellPadding=2 cellSpacing=0 width=100%><tr><td><table cellPadding=2 cellSpacing=2 class=table-striped style=text-align:center width=100%><thead><tr><th align=center style=width:30%><b translate>Certificate Name</b></th><th align=center><b translate>Local Services</b></th></tr></thead><tbody ng-init=outerIndex=$index ng-repeat=\"r in uid2Serv\" style=text-align:center><tr ng-repeat=\"x in r\"><td class=cerfield{{outerIndex}} ng-if=$first>{{LoCfInfo[outerIndex][0]}}</td><td ng-if=\"x == 4 || x == 5\"> <a href=\"/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=2410&sAct=showpage\">{{LoServ[x]}}</a></td><td ng-if=\"x == 7\"> <a href=\"/cgi-bin/cgiapp.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=0\" ng-click=setRadiusTag()>{{LoServ[x]}}</a></td><td ng-if=\"x == 8\"> <a href=\"/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=2216&iAct=0\">{{LoServ[x]}}</a></td><td ng-if=\"x == -1\">&nbsp;</td><td ng-if=\"x == 12\"> <a href=\"/cgi-bin/V2X00.cgi?fid=2037&sFormAuthStr=JdvKVyYlhh7GhS9\">{{LoServ[x]}}</td><td ng-if=\"x != 4 && x != 5 && x != 7 && x != 8 && x!=-1 && x!=12\">{{LoServ[x]}}</td></tr></tbody></table></td></tr></table><table align=center width=100%><br><tr><td align=center><input class=btnw name=btnOK ng-click=onbtnClk() type=button value=\"{{ 'OK' | translate }}\"></td></tr></table><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"><input name=fid type=hidden value=1226><input name=iAct type=hidden value=1></form></td></tr></table><textarea id=xlosrvinit style=display:none>\n    var LoCfInfo = [[\"Default Certificate\",65535],[\"None\",0]];\n    var LoCfUid = [65535,65535,65535,65535,0,0,65535,0,65535,65535,65535,65535,0];\n</textarea><script> top.ACTION_STATUS=-1;top.iActionStatusFlag='1';top.iFwUpgradeState='0';var f=document.frm1;var bg=parent;var defcertSelected='0';var uid2Serv=new Array();var xlosrvinitScript=document.createElement(\"script\");xlosrvinitScript.text=document.getElementById(\"xlosrvinit\").value;document.head.appendChild(xlosrvinitScript);angular.element(document).ready(function(){var LoServ=[gettext('Router Management')+\" -- \"+gettext('Web Access from LAN or WAN'),gettext('Router Management')+\" -- \"+gettext('SSH'),'','','','','','','','','',''];if(parseInt('1')){LoServ[2]=gettext('VPN and Remote Access')+\" >> \"+gettext('LAN to LAN')+\" -- \"+gettext('SSL VPN');LoServ[3]=gettext('VPN and Remote Access')+\" >> \"+gettext('Remote Dial-in User')+\" -- \"+gettext('SSL VPN');}if(0&&'1'=='1'){LoServ[4]=gettext('VPN and Remote Access')+\" >> \"+gettext('LAN to LAN')+\" -- \"+gettext('OpenVPN');}if(parseInt('1')){LoServ[5]=gettext('VPN and Remote Access')+\" >> \"+gettext('OpenVPN')+\" -- \"+gettext('OpenVPN');}if('1'=='1'){LoServ[6]=gettext('Hotspot Web Portal');}if(parseInt('1')){LoServ[7]=gettext('Applications')+\" >> \"+gettext('Internal RADIUS');}if(parseInt('1')){LoServ[8]=gettext('Applications')+\" >> \"+gettext('Local 802.1X General Setup');}if('1'=='1'){LoServ[9]=gettext('Applications')+\" >> \"+gettext('High Availability');}if(parseInt('1')){LoServ[10]=gettext('CSM')+\" >> \"+gettex