            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/dhtml.min.js?094907\"></script></head><body class=ng-cloak><textarea id=swmmaintinit style=display:none>\nvar switchrebootOK = [];\nvar switchrebootfail = [];\nvar switchresetOK = [];\nvar switchresetfail = [];\nvar switchDevName = [];\n</textarea><table align=center border=0 cellpadding=0 cellspacing=0 width=870><tr><td><b parent=\"{{ 'Switch' | translate }}\" sub-title translate>Maintenance</b><hr><form action=/cgi-bin/cgiswm.cgi id=form1 method=post name=frm1><table align=center border=1 cellpadding=2 cellspacing=0 class=webshow style=display:none width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>Select Action</b></td></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td width=30%><translate>Action Type</translate>:</td><td width=70%><select form=form1 name=sltActTyp onchange=onChgSltActTyp()><option translate value=0>Config Backup</option><option translate value=1>Config Restore</option><option translate value=3>Remote Reboot</option><option translate value=4>Factory Reset</option></select></td></tr></table><input form=form1 name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form><form enctype=multipart/form-data id=form2 method=post name=frmup><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td width=30%><translate>File/Path</translate>:</td><td><input class=file form=form2 name=data size=30 type=file></td></tr></table><input form=form2 name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form><form id=form3 method=post name=frm2><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td translate width=30%>Selected Device</td><td><select form=form3 name=Selected_Dev onchange=