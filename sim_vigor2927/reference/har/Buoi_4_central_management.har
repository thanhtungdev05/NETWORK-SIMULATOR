            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><meta / charset=UTF-8><script src=\"/js/gettext.min.js?094907\"></script><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/b64.min.js?094907\"></script><style type=text/css>\ntr.backcolor {\n\tbackground-color:#9D9D9D;\n}\ntd.header {\n\tcolor:white;\n\tFONT-WEIGHT: bold;\n\ttext-align:center;\n}\n</style></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=800><tr><td><b parent=\"{{ 'AP' | translate }}\" sub-title translate>WLAN Profile</b><hr><form action=/cgi-bin/v2x00.cgi method=post name=frm1><table align=center border=0 cellpadding=0 cellspacing=0 width=100%><tr><td align=right class=red>|&nbsp;  <a class=DenyLink href=javascript:WLDefault() translate>Set to Factory Default</a>&nbsp;|</td></tr></table><textarea id=apwlprofinit style=display:none>\n\tvar aryAPDevice = [];\n\tvar aryWLANDevice = [[\"Default\",[\"DrayTek\",\"DrayTek-LAN-B\",\"\",\"\"],[9217,13827,12288,12288],0,0,4,\"\",0,64,64,2,2],[\"\",[\"DrayTek\",\"\",\"\",\"\"],[12289,12288,12288,12288],0,0,0,\"\",0,64,64,2,2],[\"\",[\"DrayTek\",\"\",\"\",\"\"],[12289,12288,12288,12288],0,0,0,\"\",0,64,64,2,2],[\"\",[\"DrayTek\",\"\",\"\",\"\"],[12289,12288,12288,12288],0,0,0,\"\",0,64,64,2,2],[\"\",[\"DrayTek\",\"\",\"\",\"\"],[12289,12288,12288,12288],0,0,0,\"\",0,64,64,2,2]];\n\tvar aryWLANConfig = [[\"admin\",\"admin\",[\"00000000\",\"00000000\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"DrayTek\",\"\",\"\",\"\"],[\"00000000\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],\"\",[\"\",\"\",\"\",\"\"]],[\"\",\"\",[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"DrayTek\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],\"\\u0001\",[\"\",\"\",\"\",\"\"]],[\"\",\"\",[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"DrayTek\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],\"\\u0001\",[\"\",\"\",\"\",\"\"]],[\"\",\"\",[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"DrayTek\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],\"\\u0001\",[\"\",\"\",\"\",\"\"]],[\"\",\"\",[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"DrayTek\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],[\"\",\"\",\"\",\"\"],\"\\u0001\",[\"\",\"\",\"\",\"\"]]];\n</textarea><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 width=100%><tr class=backcolor><td class=header translate>Profile</td><td class=header translate>Name</td><td class=header translate>Main SSID</td><td class=header translate>Security</td><td class=header translate>Multi-SSID</td><td class=header translate>WLAN ACL</td><td class=header translate>Rate Ctrl</td><td class=header translate>Clone</td><td class=\"header BTHide\" translate>To AP</td><td class=\"header BTHide\" id=local_wlan style=display:none translate>To Local</td><td class=\"header BTHide\">&nbsp;</td></tr><tr ng-repeat=\"prof in aryWLANDevice\"><td align=center> <a href=# ng-click=gotoDetailSet($index)>{{$index + 1}}</a></td><td align=center ng-if=\"prof[0] == ''\">---</td><td align=center ng-if=\"prof[0] == ''\">---</td><td align=center ng-if=\"prof[0] == ''\">---</td><td align=center ng-if=\"prof[0] == ''\">---</td><td align=center ng-if=\"prof[0] == ''\">---</td><td align=center ng-if=\"prof[0] == ''\">---</td><td align=center ng-if=\"prof[0] == ''\">---</td><td align=center class=BTHide ng-if=\"prof[0] == ''\">---</td><td align=center class=BTHide ng-if=\"prof[0] == '' && wlan_present == 1\">---</td><td align=center class=BTHide ng-if=\"prof[0] == ''\">-</td><td align=center ng-if=\"prof[0] != ''\">{{prof[0]}}</td><td align=center ng-if=\"prof[0] != ''\">{{prof[1][0]}}</td><td align=center ng-if=\"prof[0] != ''\">{{aryFormExt[$index][0]}}</td><td align=center id=wl_ssid{{$index}} ng-if=\"prof[0] != ''\"></td><td align=center ng-if=\"prof[0] != ''\">{{aryFormExt[$index][1]}}</td><td align=left ng-if=\"prof[0] != '' && aryFormExt[$index][2]\" valign=center>&uArr; {{prof[3]}} <translate>Kbps</translate><br>&dArr; {{prof[4]}} <translate>Kbps</translate></td><td align=center ng-if=\"prof[0] != '' && !aryFormExt[$index][2]\" translate>None</td><td align=center ng-if=\"prof[0] != ''\"> <a href=# ng-click=onClkBtnClone($index)><i class=\"sharepart apclone\"></i></a></td><td align=center class=BTHide ng-if=\"prof[0] != ''\"> <a href=# ng-click=onClkBtnApply($index)><i class=\"sharepart toAP\"></i></a></td><td align=center class=BTHide ng-if=\"prof[0] != '' && wlan_present == 1\"> <a href=# ng-click=onClkBtnApplyLoc($index)><i class=\"sharepart tolocal\"></i></a></td><td class=BTHide ng-if=\"prof[0] != ''\" title=Clear> <a href=# ng-click=WLClear($index) ng-if=\"$index != 0\"><font color=red>x</font></a></td></tr></table></td></tr></table><br><input name=fid type=hidden value=2130><input name=sAct type=hidden value=status><input name=act type=hidden value=1><input name=delidx type=hidden><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form><table border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>Note</b>: <ol><li translate>When connecting with DrayOS5 AP(Mesh Node), only required configurations will be synced, such as SSID, Radius Server, VLAN and MAC Filtering.</li></ol></td></tr></table></td></tr></table><script> top.ACTION_STATUS=-1;top.iActionStatusFlag='0';top.iFwUpgradeState='0';top.act_sta.damage_alert();var apwlprofinitScript=document.createElement(\"script\");apwlprofinitScript.text=document.getElementById(\"apwlprofinit\").value;document.head.appendChild(apwlprofinitScript); var aryWLANProfile=new Array();for(var i=0;i<aryWLANDevice.length;i++){aryWLANProfile.push(aryWLANDevice[i][0]);}var WLAN_SSID_Enable=0x01;var WLAN_SSID_Subnet=0x02;var WLAN_SSID_HideSSID=0x04;var WLAN_SSID_IsolateLAN=0x08;var WLAN_SSID_IsolateMem=0x10;var WLAN_SSID_RateEnable=0x20;var WLAN_SSID_ACL=0xc0;var WLAN_SSID_SecurityMode=0xF00;var WLAN_SSID_WPAAlg=0x3000;var WLAN_SSID_WPAAuth=0x4000;var wlan_present=0;if(parseInt('0'))wlan_present=1;var bg=parent;var f=document.frm1;var aryAPDeviceName=new Array();var aryFormExt=new Array();var apply_idx=0;angular.element(document).ready(function(){var aryACL=[gettext(\"None\"),gettext(\"White List\"),gettext(\"Black List\")];var arySecurityMode=[[0,gettext(\"Disable\")],[1,gettext(\"WEP Personal\")],[2,gettext(\"WPA Personal\")],\"\",[4,gettext(\"WPA2 Personal\")],[5,gettext(\"OWE\")],[6,gettext(\"WPA2/WPA Personal\")],[7,gettext(\"WPA3/WPA2 Personal\")],[8,gettext(\"WPA3 Personal\")],[9,gettext(\"WEP Personal\")],[10,gettext(\"WPA Enterprise\")],[11,gettext(\"WPA3/WPA2 Enterprise\")],[12,gettext(\"WPA2 Enterprise\")],[13,gettext(\"WPA3 Enterprise\")],[14,gettext(\"WPA2/WPA Enterprise\")]];for(i=0;i<aryWLANDevice.length;i++){aryFormExt[i]=new Array();aryFormExt[i][0]=arySecurityMode[(aryWLANDevice[i][2][0]&WLAN_SSID_SecurityMode)>>8][1];aryFormExt[i][1]=aryACL[(aryWLANDevice[i][2][0]&WLAN_SSID_ACL)>>6];aryFormExt[i][2]=((aryWLANDevice[i][2][0]&WLAN_SSID_RateEnable)==WLAN_SSID_RateEnable);}$scope.aryWLANDevice=aryWLANDevice;$scope.wlan_