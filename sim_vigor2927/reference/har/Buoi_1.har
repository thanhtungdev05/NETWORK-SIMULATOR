colspan=2><input name=chkBandwAuto type=checkbox value=1><translate>Allow user to use more bandwidth than the assigned limit when there are bandwidth available.</translate></td></tr><tr><td colspan=2><br></td></tr><tr><td colspan=2><b translate>Smart Bandwidth Limit</b></td></tr><tr><td colspan=2><input name=iSmartEnable type=checkbox value=1><translate id=\"maxsession\">Apply the below limit to users not in Limitation List and user more than <input> sessions</translate></td></tr><tr><td colspan=2>&nbsp;&nbsp;&nbsp;&nbsp;<translate>TX Limit</translate>&nbsp;:&nbsp;<input maxlength=7 name=iSmartTx size=5 type=text>&nbsp; <select name=iSmartProfTx><option translate value=0>Kbps</option><option translate value=1>Mbps</option></select>&nbsp; <translate>RX Limit</translate>&nbsp;:&nbsp;<input maxlength=7 name=iSmartRx size=5 type=text>&nbsp; <select name=iSmartProfRx><option translate value=0>Kbps</option><option translate value=1>Mbps</option></select>&nbsp; </td></tr></table></td></tr></table></div><br><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=95%><tr><td colspan=2><b translate>Time Schedule</b></td></tr><tr><td colspan=2> <a href=\"/cgi-bin/v2x00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=2056\" translate>Schedule Profile</a>&nbsp;:&nbsp; <select class=slct name=nSch1 onchange=chgSch(1) size=1><option translate value=0>None</option><option translate value=100>Schedule List</option><option translate value=101>[Create New]</option><option ng-if=sch.length ng-init=j=$index+1 ng-repeat=\"sch in arySchCmmt track by $index\" value={{j}}>{{j+\"-\"+sch}}</option></select>,&nbsp; <select class=slct name=nSch2 onchange=chgSch(2) size=1><option translate value=0>None</option><option translate value=100>Schedule List</option><option translate value=101>[Create New]</option><option ng-if=sch.length ng-init=j=$index+1 ng-repeat=\"sch in arySchCmmt track by $index\" value={{j}}>{{j+\"-\"+sch}}