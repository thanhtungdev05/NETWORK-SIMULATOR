trolinit\").value;document.head.appendChild(acontrolinitScript);var bg=parent;var lannumber=parseInt('8');var sFormAuthStr='pU2VHFY4WAi1NkA';var opennewidx=-1;var opennewidxv6=-1;if(parseInt('0'))len=1;else len=arrLanCtrl.length;var INDEX=0,NAME=1,IPSTART=2,ENDMASK=3,ADDRTYPE=4;</script></tr><tr><td colspan=2><b parent=\"{{ 'System Maintenance' | translate }}\" qslink=\"https://www.draytek.com/router-help-redirect?stk_title=System Maintenance&nd_title=Management\" sub-title translate>Management</b><hr><table align=center border=0 cellpadding=2 cellspacing=0 width=840><tr><td class=offtab id=tab1 onClick=dhtml.cycleTab(this.id);parent.sMngStatusTag=this.id; width=33%><b><span ng-if=\"bDrayIpv6\">IPv4</span>&nbsp;<translate>Management Setup</translate></b></td><td class=offtab id=tab2 onClick=dhtml.cycleTab(this.id);parent.sMngStatusTag=this.id; style=display:none width=33%><b translate>IPv6 Management Setup</b></td><td class=offtab id=tab3 onClick=dhtml.cycleTab(this.id);parent.sMngStatusTag=this.id; style=display:none width=33%><b translate>LAN Access Setup</b></td></tr></table><div class=pagetext id=page1 style=\"width: 840px\"><table border=1 cellpadding=2 cellspacing=0 width=100%><tr><td colspan=2><translate>Router Name</translate> &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; <input maxlength=39 name=sRouterName size=49 type=text value=\"DrayTek\"></td></tr><tr><td valign=top width=45%><table border=0 cellpadding=2 cellspacing=0 width=100%><tr class=autologout style=display:none><td align=left colspan=3><input  name=sDeflogoff type=checkbox value=On><translate>Default:Disable Auto-Logout</translate></td></tr><tr class=sValidatedCode style=display:none><td colspan=3><input  name=sValidatedCode type=checkbox value=On><translate>Enable Validation Code in Internet/LAN Access</translate></td></tr></table><table border=0 cellpadding=2 cellspacing=0 id=accesstbl width=100%><tr><td colspan=3><hr size=1></td></tr><tr><td colspan=3><b translate>Internet Access Control</b></td></tr><tr ng-hide=bgt2ndAdmin><td colspan=3><input  name=sRMC onClick=onCheckRMC() type=checkbox value=On><translate>Allow management from the Internet</translate></td></tr><tr ng-show=\"'1' == '1'\"><td colspan=2 style=padding-left:5px><b translate>Apply to Interface</b></td><tr><td style=padding-left:5px><div class=multiselect ng-show=\"'1' == '1'\" onblur=showCheckboxes(event) onclick=showCheckboxes(event) tabindex=0><div class=selectBox><select><option translate>Selected Interfaces</option></select><div class=overSelect></div></div><div id=checkboxes><label ng-repeat=\"accwan in accwans\"><input name={{accwan.name}} ng-checked=accwan.checked type=checkbox value=On>&nbsp;{{accwan.wan}} </label></div></div></td></tr></tr><tr ng-hide=\"bgt2ndAdmin || bRuVPN\"><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=sRMCFtp type=checkbox value=On><translate>FTP Server</translate></td></tr><tr ng-hide=bgt2ndAdmin><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=sRMCHttp type=checkbox value=On><translate>HTTP Server</translate>&nbsp;<input name=iRMCHsfrc onclick=cklRMCHttp() type=checkbox value=1><translate>Enforce HTTPS Access</translate></td></tr><tr class=https style=display:none><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input  checked name=sRMCHttps onclick=cklRMCHttps() type=checkbox value=On><translate>HTTPS Server</translate>&nbsp;<span ng-if=\"iBudgetThuis\">(<translate>Access List from the internet is required</translate>)</span></td></tr><tr ng-hide=bgt2ndAdmin><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=sRMCTelnet type=checkbox value=On><translate>Telnet Server</translate></td></tr><tr class=tr069 style=display:none><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=sRMCTr069 type=checkbox value=On><translate>TR069 Server</translate></td></tr><tr ng-hide=bgt2ndAdmin><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=sRMCSsh type=checkbox value=On><translate>SSH Server</translate></td></tr><tr class=Checksnmp style=display:none><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=sRMCSnmp type=checkbox value=On><translate>SNMP Server</translate></td></tr><tr><td colspan=3><input  checked name=sWPing type=checkbox value=On><translate>Disable PING from the Internet</translate></td></tr><tr class=sExtDevDis style=display:none><td colspan=3><input  name=sExtDevDis type=checkbox value=On><translate>External Device Auto Discovery</translate></td></tr><tbody ng-show=\"'1' == '1'\"><tr><td><hr size=1></td></tr><tr><td><b translate>Loopback Interface</b></td></tr><tr><td><span ng-click=\"enablelpbkitfc = !enablelpbkitfc\" style=\"cursor: default\"><input name=eablpbkitfc ng-checked=enablelpbkitfc type=checkbox value=On><translate>Enable Loopback Interface</translate></span>&emsp; <select name=bkitfcslct ng-disabled=!enablelpbkitfc><option ng-repeat=\"suplan in suplans\" ng-selected=suplan.selected ng-value=suplan.value>{{suplan.text}}</option></select></td></tr><tr><td><b translate>Note</b>: <ol><li translate>Management from WAN only available using Loopback IP, the WAN IP will not respond.</li><li translate>Source IP used for TR069,NTP,RADIUS/TACACS+,SYSLOG,SNMP.</li></ol></td></tr></tbody></table><table border=0 cellpadding=2 cellspacing=0 class=mngtfrmlan style=display:none width=100%><tr><td colspan=3><hr size=1></td></tr><tr><td colspan=3><b translate>LAN Access Control</b></td></tr><tr><td colspan=3><input name=sMngtfrmLanEn onClick=onclkfrmlan() type=checkbox value=1><translate>Allow management from LAN</translate></td></tr><tr><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input name=iMngtlanftp type=checkbox value=1><translate>FTP Server</translate></td></tr><tr><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input name=iMngtlanHttp type=checkbox value=1><translate>HTTP Server</translate>&nbsp;<input name=iMngtHsfrc onclick=cklMngtHttp() type=checkbox value=1><translate>Enforce HTTPS Access</translate></td></tr><tr><td class=https colspan=3 style=display:none>&nbsp;&nbsp;&nbsp;&nbsp;<input name=iMngtlanHttps onclick=cklMngtHttps() type=checkbox value=1><translate>HTTPS Server</translate></td></tr><tr><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input name=iMngtlanTelnet type=checkbox value=1><translate>Telnet Server</translate></td></tr><tr><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input name=iMngtlanTr069 type=checkbox value=1><translate>TR069 Server</translate></td></tr><tr><td class=ssh colspan=3 style=display:none>&nbsp;&nbsp;&nbsp;&nbsp;<input name=iMngtlanSsh type=checkbox value=1><translate>SSH Server</translate></td></tr><tr><td colspan=3><b>&nbsp;&nbsp;&nbsp;&nbsp;<translate>Apply To Subnet</translate></b></td></tr><script> var str=\"\";var num=1;if(len>0){str+=\"<tr>\";str+=\"<td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;\";for(var i=0;i<lannumber;i++){if(i==0)str+=\"<input type=checkbox name=iMngtlan\"+i+\" value=1><span style='color:red;font-weight:bold;'>\"+gettext(\"LAN\")+(i+1)+\"</span>\";else str+=\"<input type=checkbox name=iMngtlan\"+i+\" value=1>\"+gettext(\"LAN\")+(i+1);if(num%5==0){str+=\"</td></tr><tr>\";str+=\"<td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;\";}num++;}str+=\"</td></tr>\";}if(arrMngtLanSrv.length>0){str+=\"<tr>\";str+=\"<td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;\";str+=\"<span id=lanDMZ style=display:none><input type=checkbox name=iMngtlanDMZ value=1>\"+gettext(\"DMZ\")+\"</span>\";str+=\"<span id=iMngtlanSub><input type=checkbox name=iMngtlanSub value=1>\"+gettext(\"IP Routed Subnet\")+\"</span></td></tr>\";}document.write(str);</script></table><hr class=ecoprj0 size=1><div class=ecoprj0><b translate>Access List from the Internet</b></div><table border=0 cellpadding=2 cellspacing=0 id=accesslist width=100%><tr class=ecoprj1><td translate>List</td><td translate>Type</td><td translate>Index</td><td translate>Description</td></tr><tr class=ecoprj1 ng-repeat=\"acclist in arrAccessIPfrObj\"><td>{{$index+1}}</td><td><select name=v4acListType{{$index+1}} ng-model=acclist[1]><option translate value=0>IP Object</option><option ng-if=supHostname translate value=1>Hostname</option><option ng-if=objectData.IPv4.grp translate value=2>IP Group</option></select></td><td><select id=v4mySelect{{$index+1}} name=index{{$index+1}} ng-if=acclist[1]==0 ng-model=acclist[0] onchange=onMouseover(this) style=width:100px><option translate value=0>None</option><option translate value=-1>IP Object List</option><option translate value=-2>[Create New]</option><option ng-if=option.length ng-repeat=\"option in objectData.IPv4.obj\" ng-selected=\"acclist[0] == option[0]\" value={{option[0]}}>{{option[0]}}-{{option[1]}}</option></select><select id=v4mySelect{{$index+1}} name=index{{$index+1}} ng-if=acclist[1]==1 ng-model=acclist[0] onchange=onMouseover(this) style=width:100px><option translate value=0>None</option><option translate value=-1>Keyword Object List</option><option translate value=-2>[Create New]</option><option ng-if=option.length ng-repeat=\"option in objectData.host\" ng-selected=\"acclist[0] == option[0]\" value={{option[0]}}>{{option[0]}}-{{option[1]}}</option></select><select id=v4mySelect{{$index+1}} name=index{{$index+1}} ng-if=acclist[1]==2 ng-model=acclist[0] onchange=onMouseover(this) style=width:100px><option translate value=0>None</option><option translate value=-2>[Create New]</option><option ng-if=option.length ng-repeat=\"option in objectData.IPv4.grp\" ng-selected=\"acclist[0] == option[0]\" value={{option[0]}}>{{option[0]}}-{{option[1]}}</option></select></td><td><input disabled name=index{{$index+1}}ip style=width:210px type=text></td></tr><tr class=ecoprj0><td colspan=3><input  name=iAccLst2Ping onClick=onCheckDPI() type=checkbox value=1>&nbsp;<translate>Apply Access List to PING</translate></td></tr><tr ng-show=supHostname><td colspan=4><b translate>Note</b>: <ol><li translate>Access list type: Hostname, single IP address supported for corresponding domain name.</li></ol></td></tr><tr align=center class=ecoprj><td translate>List</td><td translate>IP</td><td translate>Subnet Mask</td></tr><tr class=list1 style=display:none><td> 1</td><td><input maxlength=15 name=AControlIp1 size=15 value=\"\"></td><td align=center><select name=AControlMask1><option selected value>----</option><option  value=255.255.255.255> 255.255.255.255 / 32</option><option  value=255.255.255.254>255.255.255.254 / 31</option><option  value=255.255.255.252>255.255.255.252 / 30</option><option  value=255.255.255.248>255.255.255.248 / 29</option><option  value=255.255.255.240>255.255.255.240 / 28</option><option  value=255.255.255.224>255.255.255.224 / 27</option><option  value=255.255.255.192>255.255.255.192 / 26</option><option  value=255.255.255.128>255.255.255.128 / 25</option><option  value=255.255.255.0>255.255.255.0 / 24</option><option  value=255.255.254.0>255.255.254.0 / 23</option><option  value=255.255.252.0>255.255.252.0 / 22</option></select></td></tr><tr class=list2 style=display:none><td> 2</td><td><input maxlength=15 name=AControlIp2 size=15 value=\"\"></td><td align=center><select name=AControlMask2><option selected value>----</option><option  value=255.255.255.255> 255.255.255.255 / 32</option><option  value=255.255.255.254>255.255.255.254 / 31</option><option  value=255.255.255.252>255.255.255.252 / 30</option><option  value=255.255.255.248>255.255.255.248 / 29</option><option  value=255.255.255.240>255.255.255.240 / 28</option><option  value=255.255.255.224>255.255.255.224 / 27</option><option  value=255.255.255.192>255.255.255.192 / 26</option><option  value=255.255.255.128>255.255.255.128 / 25</option><option  value=255.255.255.0>255.255.255.0 / 24</option><option  value=255.255.254.0>255.255.254.0 / 23</option><option  value=255.255.252.0>255.255.252.0 / 22</option></select></td></tr><tr class=list3><td> 3</td><td><input maxlength=15 name=AControlIp3 size=15 value=\"\"></td><td align=center><select name=AControlMask3><option selected value>----</option><option  value=255.255.255.255> 255.255.255.255 / 32</option><option  value=255.255.255.254>255.255.255.254 / 31</option><option  value=255.255.255.252>255.255.255.252 / 30</option><option  value=255.255.255.248>255.255.255.248 / 29</option><option  value=255.255.255.240>255.255.255.240 / 28</option><option  value=255.255.255.224>255.255.255.224 / 27</option><option  value=255.255.255.192>255.255.255.192 / 26</option><option  value=255.255.255.128>255.255.255.128 / 25</option><option  value=255.255.255.0>255.255.255.0 / 24</option><option  value=255.255.254.0>255.255.254.0 / 23</option><option  value=255.255.252.0>255.255.252.0 / 22</option></select></td></tr></table></td><td valign=top width=55%><table border=0 cellpadding=2 cellspacing=0 width=100%><tr><td colspan=2><b translate>Management Port Setup</b><br></td></tr><tr><td colspan=2><input Checked name=ConfigPort type=radio value=UserDefine>&nbsp;<translate>User Define Ports</translate>&nbsp;<input name=ConfigPort type=radio value=Default>&nbsp;<translate>Default Ports</translate></td></tr><tr id=telnetporttr><td translate width=48%>Telnet Port</td><td width=52%><input maxlength=5 name=TelnetPort size=5 value=\"23\"> (<translate>Default</translate>: 23)</td></tr><tr><td translate>HTTP Port</td><td><input maxlength=5 name=HttpPort size=5 value=\"80\"> (<translate>Default</translate>: 80)</td></tr><tr class=https style=display:none><td translate>HTTPS Port</td><td><INPUT MAXLENGTH=5 NAME=HttpsPort SIZE=5 VALUE=\"443\"> (<translate>Default</translate>: 443)</td></tr><tr id=ftpporttr><td translate>FTP Port</td><td><input maxlength=5 name=txtFtpPort size=5 value=\"21\"> (<translate>Default</translate>: 21)</td></tr><tr ng-hide=bgt2ndAdmin><td translate>TR069 Port</td><td><input maxlength=5 name=txtTr069Port size=5 value=\"8069\"> (<translate>Default</translate>: 8069)</td></tr><tr class=ssh style=display:none><td translate>SSH Port</td><td><input maxlength=5 name=txtSshPort size=5 value=\"22\"> (<translate>Default</translate>: 22)</td></tr><tr class=mptcp style=display:none><td translate>MPTCP Port</td><td><input maxlength=5 name=txtMPTCPPort size=5 value=\"5201\"> (<translate>Default</translate>: 5201)</td></tr><tr class=webportalnote style=display:none><td colspan=2><b translate>Note</b>: <ol><li translate>Ports 8001 and 8043 are used for Hotspot Web Portal.</li></ol></td></tr><tr class=showPtKnock style=display:none><td colspan=2><hr size=1></td></tr><tr class=showPtKnock style=display:none><td colspan=2><b translate>Port Knocking for Local Service</b><br></td></tr><tr class=showPtKnock style=display:none><td colspan=2><input  name=iPtKEn onclick=enPtKnock() type=checkbox value=1><translate>Enable port knocking protection</translate></td></tr><tr class=sPtKnock style=display:none><td colspan=2>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=iPtKFtp type=checkbox value=1><translate>FTP Server</translate></td></tr><tr class=sPtKnock style=display:none><td colspan=2>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=iPtKHttp type=checkbox value=1><translate>HTTP Server</translate></td></tr><tr class=sPtKnock style=display:none><td colspan=2>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=iPtKHttps type=checkbox value=1><translate>HTTPS Server</translate></td></tr><tr class=sPtKnock style=display:none><td colspan=2>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=iPtKTelnet type=checkbox value=1><translate>Telnet Server</translate></td></tr><tr class=sPtKnock style=display:none><td colspan=2>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=iPtKSsh type=checkbox value=1><translate>SSH Server</translate></td></tr><tr class=sPtKnock style=display:none><td colspan=2>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=iPtKSnmp type=checkbox value=1><translate>SNMP Server</translate></td></tr><tr class=sPtKnock style=display:none><td translate>1st Knock Port</td><td><input max=65535 maxlength=5 min=3501 name=sKnockPort size=5 type=number value=\"3888\">&nbsp; <div class=popup><img border=0 src=/images/faqmark1.png style=\"width: 60%\"><span class=\"popuptext\" id=\"blockPopup\">&nbsp;Suppose TOTP token is \"456 789\", <br>&nbsp;&nbsp;&nbsp;then knock on the following ports in sequence <br>&nbsp;&nbsp;&nbsp;(from WAN) to unlock Port Redirect function. <br>&nbsp;1. 1st Knock Port <br>&nbsp;2. port 1456 (1000 + TOTP front 3 digits) <br>&nbsp;3. port 2789 (2000 + TOTP last 3 digits) </span></div></td></tr><tr class=sPtKnock style=display:none><td translate>TOTP Key</td><td><input maxlength=32 name=sKnockTotp readonly size=21 type=text value=\"GM4TQ23KI5CW22KLIR2WQLKBGBQTG3JY\"></td></tr><tr class=sPtKnock style=display:none><td>&nbsp;</td><td><input id=btnTOTPRegenerate name=btnTOTPRegenerate onclick=RegenerateSecret_totp() type=button value=\"{{ 'Regenerate' | translate }}\"></td></tr><tr class=sPtKnock style=display:none><td>&nbsp;</td><td><div id=qrcodeTOTP></div></td></tr><tr class=sPtKnock style=display:none><td translate>Validation Code</td><td><input max=999999 min=1 name=verify_totp onkeydown=onTOTPVerifyEnter() type=number>&nbsp; <input onclick=onTOTPVerify() type=button value=\"{{ 'Verify' | translate }}\"><span id=\"verify_totp_info\"></span></td></tr><tr class=snmp style=display:none><td colspan=2><hr size=1></td></tr><tr class=snmp style=display:none><td colspan=2><b>&nbsp;<translate>SNMP Setup</translate></b></td></tr><tr class=snmp style=display:none><td colspan=2><input  name=sSNMP onclick=enSnmp() type=checkbox value=On> &nbsp;<translate>Enable SNMP Agent</translate></td></tr><tr class=snmp style=display:none><td>&nbsp;&nbsp;<translate>Get Community</translate></td><td><input maxlength=23 name=sSNMPGet size=16 value=\"public\"></td></tr><tr class=snmp style=display:none><td>&nbsp;&nbsp;<translate>Set Community</translate></td><td><input maxlength=23 name=sSNMPSet size=16 value=\"private\"></td></tr><tr class=snmp style=display:none><td>&nbsp;&nbsp;<translate>Manager Host IP</translate></td><td><input maxlength=15 name=sSNMPMIP size=16 value=\"\"></td></tr><tr class=snmp style=display:none><td>&nbsp;&nbsp;<translate>Trap Community</translate></td><td><input maxlength=23 name=sSNMPTrap size=16 value=\"public\"></td></tr><tr class=snmp style=display:none><td>&nbsp;&n