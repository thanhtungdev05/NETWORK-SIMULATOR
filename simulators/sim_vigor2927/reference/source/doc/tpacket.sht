<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src="/js/gettext.min.js?094907"></script><meta / charset=UTF-8><link href="/style.min.css?094907" rel=stylesheet type=text/css></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent="{{ 'Diagnostics' | translate }}" sub-title translate>Dial-out Triggering</b><hr><table align=center border=0 cellpadding=2 cellspacing=0 width=700><tr><td><b translate>Dial-out Triggered Packet Header</b></td><td align=right class=red>|&nbsp; <a href="/cgi-bin/diglan.cgi?sFormAuthStr=JdvKVyYlhh7GhS9" translate>Refresh</a>&nbsp;|</td></tr></table><table align=center border=1 cellspacing=0 width=700><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=480><tr><td><b translate>HEX Format</b>:</td></tr><tr><td height=60 valign=middle><p>00 00 00 00 00 00-00 00 00 00 00 00-00 00 <br><p>00 00 00 00 00 00 00 00-00 00 00 00 00 00 00 00 <br>00 00 00 00 00 00 00 00-00 00 00 00 00 00 00 00 <br>00 00 00 00 00 00 00 00-00 00 00 00 00 00 00 00 <br>00 00 00 00 00 00 00 00-00 00 00 00 00 00 00 00 <br>00 00 00 00 00 00 00 00-00 00 00 00 00 00 00 00 <br></td></tr><tr><td colspan=2><hr size=1></td></tr><tr><td><b translate>Decoded Format</b>:</td></tr><tr><td height=60 valign=middle>0.0.0.0 -> 0.0.0.0<br>    Pr 0  len 0 (0)<br></td></tr></table></td></tr></table><br></td></tr></table><script> top.ACTION_STATUS=-1;top.iActionStatusFlag='-2';top.iFwUpgradeState='0';top.act_sta.damage_alert();</script></body></html>