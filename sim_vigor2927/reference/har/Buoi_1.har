dx-1][3];}}function onClkBtnAdd(bIPv6){var len=aryIpSsn.length;var ip_from=f.sIpSessionFrom.value;var ip_to=f.sIpSessionTo.value;var se_li=parseInt(f.sIpSessionNum.value);var p2p_li=parseInt(f.sP2PSessionLimit.value);if(bIPv6){if(!bg.isIPv6(ip_from)||!bg.isIPv6(ip_to)){alert(gettext(\"Invalid Start IP or End IP!\"));return;}len=aryIpSsn_v6.length;ip_from=f.sIpSessionFrom_v6.value;ip_to=f.sIpSessionTo_v6.value;se_li=parseInt(f.sIpSessionNum_v6.value);p2p_li=parseInt(f.sP2PSessionLimit_v6.value);}if(len>=isessLmt){alert(gettext(\"Setting full! Already set ###MAX### IP range!\").replace(\"###MAX###\",isessLmt));return false;}if(bIPv6){var sStartIP=bg.transitIpv6(ip_from);var sEndIP=bg.transitIpv6(ip_to);var aryStartIP=new Array();var aryEndIP=new Array();aryStartIP=sStartIP.split(\":\");aryEndIP=sEndIP.split(\":\");var ip1str=arytostr(aryStartIP);var ip2str=arytostr(aryEndIP);if(ip1str>ip2str){ip_from=f.sIpSessionTo.value;ip_to=f.sIpSessionFrom.value;}}else{if(bg.inet_addr(ip_from)>bg.inet_addr(ip_to)){ip_from=f.sIpSessionTo.value;ip_to=f.sIpSessionFrom.value;}}if(!checkInput(-1,ip_from,ip_to,se_li,p2p_li,bIPv6)){return false;}if(bIPv6)aryIpSsn_v6[len]=([ip_from,ip_to,se_li,p2p_li]);else aryIpSsn[len]=([ip_from,ip_to,se_li,p2p_li]);clrTempInput(bIPv6);showOnSltIpSsnList(bIPv6);}function onClkBtnEdt(bIPv6){var idx=bIPv6?curSlct1:curSlct0;var ip_from=f.sIpSessionFrom.value;var ip_to=f.sIpSessionTo.value;var se_li=parseInt(f.sIpSessionNum.value);var p2p_li=parseInt(f.sP2PSessionLimit.value);var aryobj=aryIpSsn;if(bIPv6){ip_from=f.sIpSessionFrom_v6.value;ip_to=f.sIpSessionTo_v6.value;se_li=parseInt(f.sIpSessionNum_v6.value);p2p_li=parseInt(f.sP2PSessionLimit_v6.value);aryobj=aryIpSsn_v6;}if(idx<1){return false;}if(bg.inet_addr(ip_from)>bg.inet_addr(ip_to)){if(bIPv6){ip_from=f.sIpSessionTo_v6.value;ip_to=f.sIpSessionFrom_v6.value;}else{ip_from=f.sIpSessionTo.value;ip_to=f.sIpSessionFrom.value;}}if((aryobj[idx-1][0]==ip_from)&&(aryobj[idx-1][1]==ip_to)&&(aryobj[idx-1][2]==se