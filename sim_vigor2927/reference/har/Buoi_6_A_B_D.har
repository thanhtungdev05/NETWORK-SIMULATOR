TUS=-1;top.iActionStatusFlag=iActionStatusFlag;top.iFwUpgradeState=iFwUpgradeState;top.act_sta.damage_alert();var f=document.frm1;var f2=document.frmbak;const DIALIN_DISABLE_PPTP=(0x01<<5), DIALIN_DISABLE_L2TP=(0x01<<6), DIALIN_DISABLE_SSTP=(0x01<<1), DIALIN_DISABLE_OPENVPN=0x01; angular.element(document).ready(function(){$scope.bHelpNote=bHelpNote;$scope.iSSLIdx=iSSLIdx;$scope.$apply();initpage();initParameter();initWebChange();});function ruOK(){if(confirm(gettext(\"Do you want to clear all profiles?\"))){if(bOpenVPN){var CloudVPNList=window.localStorage.getItem(\"CloudVPNList\");if(CloudVPNList)clearProfileIdxtolist(JSON.parse(CloudVPNList));}f.sAct.value=\"settodefault\";f.submit();}}function clearProfileIdxtolist(list){for(i=0;i<list.length;i++){if(list[i][3].toUpperCase()==\"PC\")list[i][5]=-1;}var data=JSON.stringify(list);window.localStorage.setItem(\"CloudVPNList\",data);}function onbtnCcl(){var Maxprofile=iMaxProfilesNum;if(Maxprofile>32){f.sAct.value=\"view\";f.iPageIdx.value=iPageIdx;f.searchmsgr.value=f.sSearchKey.value;f.submit();}else{document.location.href=\"/cgi-bin/dialin.cgi?sFormAuthStr=\"+top.authStr+\"&sAct=showpage&iPageIdx=1&iProfileIdx=0&iSSLIdx=0\";}}function onclkStat(_idx){var i,elmtname,idx,flag=0;var warn_msg;if(bSSLVPN&&bOpenVPN)warn_msg=gettext(\"If PPTP, L2TP, SSL VPN or OpenVPN is enabled, password cannot be null, otherwise, the corresponding profile cannot be enabled.\");else if(bSSLVPN)warn_msg=gettext(\"If PPTP, L2TP or SSL VPN is enabled, password cannot be null, otherwise, the corresponding profile cannot be enabled.\");else if(bOpenVPN)warn_msg=gettext(\"If PPTP, L2TP or OpenVPN is enabled, password cannot be null, otherwise, the corresponding profile cannot be enabled.\");else warn_msg=gettext(\"If PPTP or L2TP is enabled, password cannot be null, otherwise, the corresponding profile cannot be enabled.\");i=_idx;elmtname=\"chxstat\"+i;idx=bg.getIdxbyName(f,elmtname);if(bg.getVleFromElmt(f[idx],0)==1){if((DInType[i]&DIALIN_DIS