            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><style type=text/css>\n#cvml {\n\tmargin:0px 20px 0px 20px;\n\tlist-style:none;\n\toverflow:hidden;\n\tborder:solid 1px;\n\tpadding-bottom:20px;\n}\n#cvml dd {\n\tdisplay:inline-block;\n\t*display:inline;\n\tzoom:1;\n\twidth:125px;\n\tmargin:3px 3px 3px 20px;\n\tpadding:3px;\n\tvertical-align:top;\n}\n.cvmlitem {\n\tdisplay:block;\n\twidth:125px;\n\ttext-align:center;\n}\n.select {\n\tbackground:Gainsboro;\n}\nth {\n\tcolor:white;\n\tfont-weight:bold;\n\tbackground-color:grey;\n}\n.offtab {\n\tfont-family : Arial, Helvetica, sans-serif;\n\tfont-size: 14px;\n    background-color : #e5e5e5;\n\tborder-right: solid 2px #ffffff;\n\ttext-align: center;\n\tcursor:pointer;\n\tfont-weight: normal;\n}\n.ontab {\n\tfont-family : Arial, Helvetica, sans-serif;\n\tfont-size: 14px;\n\tbackground-color: #C6C6C6;\n\tborder-right: solid 2px #ffffff;\n\ttext-align: center;\n\tcursor:pointer;\n\tfont-weight: bold;\n\tcolor: #FFFFFF;\n}\n</style></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'VPN' | translate }} >> {{ 'CPE Management' | translate }}\" sub-title translate>Managed Devices List</b><hr></td></tr><tr><td><table align=center border=0 cellpadding=0 cellspacing=0 width=100%><tr><td class=ontab id=tab1 onClick=onChgAccMod(1)><b translate>Managed Devices List</b></td><td class=offtab id=tab2 onClick=onChgAccMod(2)><b translate>CPE Maintenance</b></td><td class=offtab id=tab3 onClick=onChgAccMod(3)><b translate>Google Map</b></td><td width=30%></td><td> <a href=\"javascript: onRefresh()\" translate>Refresh</a><td></tr></table><table border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><div style=\"margin:5px 0px 0px 20px\"><b translate>Managed Devices List</b></div><dl id=cvml style=\"margin:5px 20px;\"><dd id={{r[5]}} ng-if=\"r[3] >= 0\" ng-repeat=\"r in dev_ary\" onclick=clkdev(this) ondblclick=dblClk(this)><img class=cvmlitem ng-src={{r[1]}}><span class=\"cvmlitem\">{{r[0]}}</span><span class=\"cvmlitem\">{{r[2]}}</span><span class=\"cvmlitem\"><i class={{r[4]}}></i></span></dd></dl><div align=center id=device_handle ng-show=\"cvm_cnt > 0\" style=\"margin:5px 0px;\"><input class=btnw onClick=EdtDev() type=button value=\"{{ 'Edit' | translate }}\"> &nbsp;&nbsp; <input class=btnw onClick=DltDev() type=button value=\"{{ 'Delete' | translate }}\"></div><br><div style=\"margin:5px 0px 0px 20px\"><b translate>Unmanaged Devices List</b></div><div style=\"border:solid 1px; margin:5px 20px\"><table id=cpel style=\"width: 100%; height: 30px\"><tr><th>&nbsp;</th><th translate width=15%>IP Address</th><th translate width=15%>Mac Address</th><th translate width=15%>Device Model</th><th translate width=25%>Description Name</th><th translate width=25%>Location</th></tr><tbody ng-if=\"r[3] < 0 && r[2] != '0.0.0.0' && r[0] != '' && r[1] != ''\" ng-repeat=\"r in dev_ary\"><tr><td><input id={{r[5]}} name=en{{$index}} ng-model=$parent.txt[$index] type=checkbox></td><td>{{r[2]}}</td><td>{{r[0]}}</td><td>{{r[1]}}</td><td><input disabled id=dscpname{{$index}} maxlength=31 name=dscpname{{$index}} ng-disabled=!$parent.txt[$index] type=text></td><td><input disabled id=location{{$index}} maxlength=255 name=location{{$index}} ng-disabled=!$parent.txt[$index] type=text></td></tr></tbody></table></div><div align=center style=\"margin:5px 0px;\"><input class=btnw onClick=AddDev() type=button value=\"{{ 'Add' | translate }}\"></div></td></tr></table></td></tr></table><textarea id=cvmlistinit style=display:none>\n\tvar dev_ary=[];\n</textarea><script> top.ACTION_STATUS=-1;top.iActionStatusFlag='0';top.iFwUpgradeState='0';top.act_sta.damage_alert();var bg=parent;var cvmlistinitScript=document.createElement(\"script\");cvmlistinitScript.text=document.getElementById(\"cvmlistinit\").value;document.head.appendChild(cvmlistinitScript);var cvm_cnt=0;var iMaxCVMNum='8';function parserURL(url){var reg=/(.*?):\\/\\/(?:([^:@]+)(?::([^@]*))?@)?([^:@\\/]+)(?::(\\d+))?(?:(\\/.*?)(?:\\?(.*?))?(?:#(.*?))?)$/;var info=reg.exec(url);if(info==null||info.length<9){info=new Array(9);info=[\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\"];}return info;}function onChgAccMod(page){if(page==1){window.location.href='/cgi-bin/cvm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&type=cpe';}else if(page==2){window.location.href='/cgi-bin/cvm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&type=mtn';}else if(page==3){window.location.href='/cgi-bin/cvm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&type=map';}}function onRefresh(){document.location='/cgi-bin/cvm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&type=cpe';}function AddDev(){if(cvm_cnt.length==iMaxCVMNum){alert(gettext('Note: CVM can only support ###MAX### CPE devices totally.\\nPlease remove one CPE from the managed device list before you trying to add a new one.').replace('###MAX###',iMaxCVMNum));return;}var post=''; for(i=0,j=0;i<$scope.txt.length;i++){if($scope.txt[i]==true){post+='&id'+j+'='+$scope.dev_ary[i][5]+'&name'+j+'='+document.getElementById(\"dscpname\"+i).value+'&loc'+j+'='+document.getElementById(\"location\"+i).value;j++;}}if(post!='')window.location.href='/cgi-bin/cvm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&type=cpe&act=add&webchange=1'+post;else return;}function EdtDev(){ if(document.querySelectorAll(\"#cvml > dd.select\").length!=1)return;window.open('/cgi-bin/cvm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&type=detail&act=edit&id='+bg.cvmSelDev,\"ShowCPE\",\"toolbars=no,width=675px,height=500px,top=150px,left=\"+(screen.width-675)/2+\"px,status=no,scrollbars=no,resize=yes,menubar=no\");}function DltDev(){ if(document.querySelectorAll(\"#cvml > dd.select\").length!=1)return;if(confirm(gettext(\"Please note that the TR069, VPN and CPE profile of this CPE device will be disabled automatically.\\nAnd it will take a few minutes for processing.\\nAre you sure to delete this CPE device?\")))window.location.href='/cgi-bin/cvm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&type=cpe&act=del&id='+bg.cvmSelDev;}function getDevImg(model){if(model.search(\"2110\")>=0)return\"/IMAGES/dev/2110.jpg\";else if(model.search(\"2130\")>=0)return\"/IMAGES/dev/2130.jpg\";else if(model.search(\"2700\")>=0)return\"/IMAGES/dev/2700.jpg\";else if(model.search(\"2820\")>=0)return\"/IMAGES/dev/2820.jpg\";else if(model.search(\"2830\")>=0)return\"/IMAGES/dev/2830.jpg\";else if(model.search(\"2850\")>=0)return\"/IMAGES/dev/2850.jpg\";else if(model.search(\"2910\")>=0)return\"/IMAGES/dev/2910.jpg\";else if(model.search(\"2912Fn\")>=0)return\"/IMAGES/dev/2912Fn.jpg\";else if(model.search(\"2912n\")>=0)return\"/IMAGES/dev/2912n.jpg\";else if(model.search(\"2912F\")>=0)return\"/IMAGES/dev/2912F.jpg\";else if(model.search(\"2912\")>=0)return\"/IMAGES/dev/2912.jpg\";else if(model.search(\"2920\")>=0)return\"/IMAGES/dev/2920.jpg\";else if(model.search(\"2925\")>=0)return\"/IMAGES/dev/2925.jpg\";else if(model.search(\"2950\")>=0)return\"/IMAGES/dev/2950.jpg\";else if(model.search(\"3200\")>=0)return\"/IMAGES/dev/3200.jpg\";else if(model.search(\"3510\")>=0)return\"/IMAGES/dev/pbx3510.jpg\";else if(model.search(\"3900\")>=0)return\"/IMAGES/dev/3900.jpg\";else if(model.search(\"5300\")>=0)return\"/IMAGES/dev/5300.jpg\";else if(model.search(\"5500\")>=0||model.search(\"5510\")>=0)return\"/IMAGES/dev/5500.jpg\";else if(model.search(\"2960\")>=0)return\"/IMAGES/dev/2960.jpg\";else if(model.search(\"2120\")>=0)return\"/IMAGES/dev/2120.jpg\";else if(model.search(\"2922\")>=0)return\"/IMAGES/dev/2922.jpg\";else if(model.search(\"BX2000-180\")>=0)return\"/IMAGES/dev/BX2000-180.jpg\";else if(model.search(\"2952\")>=0)return\"/IMAGES/dev/2952.jpg\";else if(model.search(\"2620\")>=0)return\"/IMAGES/dev/2620Ln.jpg\";else if(model.search(\"2765\")>=0)return\"/IMAGES/dev/2765Vac.jpg\";else if(model.search(\"2925\")>=0)return\"/IMAGES/dev/2925Vac.jpg\";else if(model.search(\"2915\")>=0)return\"/IMAGES/dev/2915ac.jpg\";else if(model.search(\"2862\")>=0)return\"/IMAGES/dev/2862Vac.jpg\";else if(model.search(\"2926Fn\")>=0)return\"/IMAGES/dev/2926Fn.jpg\";else if(model.search(\"2926Vac\")>=0)return\"/IMAGES/dev/2926Vac.jpg\";else if(model.search(\"3220\")>=0)return\"/IMAGES/dev/3220n.jpg\";else return\"/IMAGES/dev/default.jpg\";}function getDevDsc(dev,descript){var res;if(dev==\"\")res=dev;else res=descript;if(res.length>10){res=res.substring(0,10);res+=\"...\";}return res;}function getDevMac(dev){var len=dev.length;var mac=\"\";if(len<12)return mac;for(i=12;i>2;i-=2)mac+=dev.substr(len-i,2)+\":\";mac+=dev.substr(len-i,2);return mac;}function getDevIP(url){var info=parserURL(url);if(info[4]==\"\")return\"0.0.0.0\";else return info[4];}function getDevStatus(stat){if(stat==\"0\")return\"sharepart extdevoffline\";else return\"sharepart extdevonline\";}function clkdev(e){ var x=document.querySelectorAll('dd');for(i=0;i<x.length;i++){x[i].className='';}e.className='select';bg.cvmSelDev=e.id;}function dblClk(e){window.open('/cgi-bin/cvm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&type=detail&act=info&id='+e.id,\"ShowCPE\",\"toolbars=no,width=675px,height=500px,top=150px,left=\"+(screen.width-675)/2+\"px,status=no,scrollbars=no,resize=yes,menubar=no\");}angular.element(document).ready(function(){$scope.txt=[];$scope.dev_ary=[];for(var i=0;i<dev_ary.length;i++){if(dev_ary[i][3]<0){$scope.dev_ary[i]=[getDevMac(dev_ary[i][0]),dev_ary[i][1],getDevIP(dev_ary[i][2]),dev_ary[i][3],\"\",dev_ary[i][0]];}else{ $scope.dev_ary[i]=[getDevDsc(dev_ary[i][0],dev_ary[i][4]),getDevImg(dev_ary[i][1]),getDevIP(dev_ary[i][2]),dev_ary[i][3],getDevStatus(dev_ary[i][3]),dev_ary[i][0]];cvm_cnt++;}}$scope.cvm_cnt=cvm_cnt;$scope.$apply();var x=document.querySelectorAll('#cpel > tbody');for(i=1;i<x.length;i++){if(i%2==1){x[i].className='row0';}else{x[i].className='row1';}}if(cvm_cnt==0){cvml.style=\"border:0\";}});</script></body></html>"
