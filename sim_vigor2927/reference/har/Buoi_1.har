            "mimeType": "text/html",
            "compression": 7441,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/dhtml.min.js?094907\"></script><script src=\"/js/webchange.js?094907\"></script><script src=\"/js/tool.min.js?094907\"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=750><tr><td colspan=2><b parent=\"{{ 'Routing' | translate }}\" qslink=https://www.draytek.com/support/search-kb/?search=BGP sub-title translate>BGP</b><hr><form action=/cgi-bin/v2x00.cgi method=post name=frm1><table align=center border=0 cellpadding=2 cellspacing=0 width=750><tr><th class=offtab id=tab1 onClick=dhtml.cycleTab(this.id);parent.sBgpStatusTag=this.id;hidefresh(); translate width=33%>Basic Settings</th><th class=offtab id=tab2 onClick=dhtml.cycleTab(this.id);parent.sBgpStatusTag=this.id;hidefresh(); translate width=33%>Static Network</th><td align=right class=red ng-if=showbasic>| <a href=\"/cgi-bin/v2x00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=4060\" translate>Refresh</a>&nbsp;|&nbsp; <a href=\"/cgi-bin/iprt.cgi?sFormAuthStr=JdvKVyYlhh7GhS9\" translate>View Routing Table</a>&nbsp;|</td><td align=right class=red ng-if=shownet>|&nbsp; <a href=\"/cgi-bin/iprt.cgi?sFormAuthStr=JdvKVyYlhh7GhS9\" translate>View Routing Table</a>&nbsp;|</td></tr></table><div class=pagetext id=page1><table border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=95%><tr><td colspan=2><b translate>Local</b></td></tr><tr><td colspan=2><input name=bgpchk ng-checked=bgpchk type=checkbox value=1>&nbsp;<translate>Enable BGP</translate></td></tr><tr ng-if=iOSPF><td colspan=2><input name=ospfchk ng-checked=ospfchk type=checkbox value=1>&nbsp;<translate>Redistribute OSPF routes into BGP</translate></td></tr><tr><td translate width=20%>Local AS Number</td><td><input maxlen