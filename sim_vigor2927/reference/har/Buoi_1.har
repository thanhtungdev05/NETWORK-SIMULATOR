lick=onClkBtnEdt(1) type=button value=\"{{ 'Edit' | translate }}\">&nbsp;&nbsp; <input name=btnRmv_v6 onClick=onClkBtnRmv(1) type=button value=\"{{ 'Delete' | translate }}\"></td></tr><tr><td colspan=2><br></td></tr></table></td></tr></table></div><div id=page3 ng-show=isAppUI style=\"display: none;\"><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=95%><tr><td colspan=2><input name=sIpBandwEnable_app ng-model=sIpBandwEnable_app type=radio value=1>&nbsp;<b translate>Enable</b>&nbsp;&nbsp; <input name=sIpBandwEnable_app ng-model=sIpBandwEnable_app type=radio value=0>&nbsp;<b translate>Disable</b></td></tr><tr><td colspan=2><br></td></tr><tr><td colspan=2><b translate>Default Limit (Per APP)</b></td></tr><tr><td colspan=2><translate>TX Limit</translate>&nbsp;:&nbsp; <input max=30000 name=sIpBandwDefTx_app ng-model=sIpBandwDefTx_app style=\"width: 60px;\" type=number>&nbsp; <select name=iDefTx_app ng-model=iDefTx_app><option translate value=0>Kbps</option><option translate value=1>Mbps</option></select>&nbsp;&nbsp;&nbsp;&nbsp; <translate>RX Limit</translate>&nbsp;:&nbsp; <input max=30000 name=sIpBandwDefRx_app ng-model=sIpBandwDefRx_app style=\"width: 60px;\" type=number>&nbsp; <select name=iDefRx_app ng-model=iDefRx_app><option translate value=0>Kbps</option><option translate value=1>Mbps</option></select></td></tr><tr><td><table id=custlsttb2 style=\"border: 1px #000 solid\"><caption><b translate>Limitation List</b> (<translate translate-params-num=\"20\">Max. {{num}} entries</translate>) </caption></table></td></tr><tr><td colspan=2><translate>Add Entry By</translate>&nbsp;:&nbsp; <select name=app_list><option disabled style=font-weight:bold; value=-1>{{'Available apps' | translate}}:</option><option ng-if=\"name[1]!='FTP' && name[1]!='YouTube' && name[1].indexOf('Google')==-1\" ng-repeat=\"name in aryAppName\" value={{name[0]}}>{{name[1]}}</option></select></td></tr><tr><td co