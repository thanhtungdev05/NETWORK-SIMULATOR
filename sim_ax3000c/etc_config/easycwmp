	option url 'http://acs2.fpt.net/cpe/'
	option username 'YWNzdHI2OQ=='
	option password 'YWNzdHI2OQ=='
	option ssl_verify 'enabled'
	option heart_interval '45'
	option periodic_enable '1'
	option periodic_interval '86400'
