            "compression": 2139,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td colspan=2 valign=top><b parent=\"{{ 'Applications' | translate }}\" qslink=https://www.draytek.com/router-help-redirect?stk_title=Applications&nd_title=Bonjour sub-title translate>Bonjour</b><hr><form action=/cgi-bin/V2X00.cgi method=post name=form1><table align=center border=0 cellpadding=2 cellspacing=0 width=700><tr><td><b translate>Bonjour Setup</b></td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=700><tr><td><table align=center border=0 cellpadding=0 cellspacing=0 width=600><tr><td><input name=iEnabbj onclick=chkenable() type=checkbox value=1>&nbsp;&nbsp;<translate>Enable Bonjour Service</translate></td></tr><tr><td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<input name=iEnhttp type=checkbox value=1>&nbsp;&nbsp;<translate>HTTP Server</translate></td></tr><tr><td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<input name=iEntel type=checkbox value=1>&nbsp;&nbsp;<translate>Telnet Server</translate></td></tr><tr class=sBonjourFtp style=display:none><td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<input name=iEnftp type=checkbox value=1>&nbsp;&nbsp;<translate>FTP Server</translate></td></tr><tr class=sBonjourSsh style=display:none><td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<input name=iEnssh type=checkbox value=1>&nbsp;&nbsp;<translate>SSH Server</translate></td></tr><tr><td>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;<input name=iEnlpr type=checkbox value=1>&nbsp;&nbsp;<translate>LPR Printer Server</translate></td></tr></table></td></tr></table><br><table align=center width=100%><tr align=center><td><input class=btnw onclick=onClkBtnOk() type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <input class=btnw onclick=onClkBtnCcl() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table><br><input name=fid type=hidden><input name=webchange type=hidden value=0><input name=sFormAuthStr type=hidden value=\"TOO7UwhiVtwiiWv\"></form></td></tr></table><script src=\"/js/variable.js?37088\"></script><script> top.ACTION_STATUS=-1;top.iActionStatusFlag='0';top.iFwUpgradeState='0';top.act_sta.damage_alert();var f=document.form1;var bg=parent;var bonjour=JSON.parse('[0,0,0,0,0,0]');angular.element(document).ready(function(){initParameter();initWebChange();});function initParameter(){bg.setVle2Elmt(f.iEnabbj,bonjour[0]);bg.setVle2Elmt(f.iEnhttp,bonjour[1]);bg.setVle2Elmt(f.iEntel,bonjour[2]);bg.setVle2Elmt(f.iEnftp,bonjour[3]);bg.setVle2Elmt(f.iEnssh,bonjour[4]);bg.setVle2Elmt(f.iEnlpr,bonjour[5]);chkenable();if(!parseInt('0')){bg.showElmtByClass(document,\"tr\",\"sBonjourFtp\");bg.showElmtByClass(document,\"tr\",\"sBonjourSsh\");}}function chkenable(){bg.cpntCtrl(f.iEnabbj,f,f.iEnhttp,5);}function onClkBtnOk(){if(checkWebChange()){f.webchange.value='1';}bg.cpntCtrl(true,f,f.iEnhttp,5);f.fid.value=2218;f.submit();}function onClkBtnCcl(){document.location=\"/cgi-bin/V2X00.cgi?sFormAuthStr=TOO7UwhiVtwiiWv&fid=2217\";}</script></body></html>"
