 || !iSpecific\" ng-value=hostList.destPortEnd size=5 type=text></td><td><input maxlength=15 name=sHwHostPriIP{{$index}} ng-disabled=\"!(iSpecific && hostList.enable)\" ng-value=hostList.hostIP size=15 type=text></td><td><input name=sHwHostChsePc{{$index}} ng-disabled=\"!(iSpecific && hostList.enable)\" onclick=onClkChse(this) type=button value=\"{{ 'Choose PC' | translate}}\"></td></tr></tbody></table></td></tr></table></td></tr></table><div id=spcmodel style=display:none><p><b translate>WAN Information</b>: </p><table align=center border=1 cellpadding=2 cellspacing=0 style=\"margin-right: 0;text-align: center;\" width=90%><thead><tr><td align=center width=30%>&nbsp;</td><td align=center translate width=20%>Status</td><td align=center width=25%><translate>TX</translate></td><td align=center width=25%><translate>RX</translate></td></tr></thead><tbody ng-show=!Wan1IsXdsl><tr><td align=left class=text-indent><translate>WAN</translate>1-{{aryStrWanMode[aryWanPhyMode[0]] | translate}} </td><td align=center>{{aryVlewan1 ? 'Enable' : 'Disabled' | translate}}</td><td align=center>{{aryVlewan1 ? 'V' : '--'}}</td><td align=center>{{aryVlewan1 ? 'V' : '--'}}</td></tr><tr class=clswan2 id=gtablewan2><td align=left class=text-indent><translate>WAN</translate>2-{{aryStrWanMode[aryWanPhyMode[1]] | translate}} </td><td align=center>{{aryVlewan2 ? 'Enable' : 'Disabled' | translate}}</td><td align=center>{{sArpTbl22 == 2 || aryVlewan2 == 1 ? 'V' : '--'}}</td><td align=center>{{sArpTbl22 == 1 || aryVlewan2 == 1 ? 'V' : '--'}}</td></tr></tbody><tbody class=btable ng-show=Wan1IsXdsl><tr><td align=left class=text-indent>{{ 'WAN' | translate}}1-{{ aryWanPhyMode[0] == 1 ? 'ADSL' : 'VDSL' | translate}}</td><td align=center translate>Enable</td><td align=center> {{aryWanPhyMode[0] == 1 ? '--' : 'V'}}</td><td align=center> {{aryWanPhyMode[0] == 1 ? '--' : 'V'}}</td></tr><tr class=clswan2 id=btablewan2><td align=left class=text-indent> {{ 'WAN' | translate}}2-{{ 'Ethernet' | translate}} </td>