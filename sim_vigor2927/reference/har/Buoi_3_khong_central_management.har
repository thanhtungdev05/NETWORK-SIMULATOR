            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script><style>\n\t.schPrfSct{\n\t\twidth: 110px;\n\t\ttext-overflow: ellipsis;\n\t}\n</style></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'System Maintenance' | translate }}\" sub-title translate>Reboot System</b><hr><form action=/cgi-bin/reboot.cgi method=POST name=frm1><table align=center border=0 cellpadding=2 cellspacing=0 width=750px><tr><td><b translate>Reboot System</b></td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=750><tr><td><table align=center border=0 cellpadding=8 cellspacing=0 width=380><tr><td width=100%><br><b translate>Do you want to reboot your router ?</b><br><br><input checked name=sReboot type=radio value=Current>&nbsp;<translate>Using current configuration</translate><br><span class=admin><input name=sReboot type=radio value=Default>&nbsp;<translate>Using factory default configuration</translate></span><br><br></td></tr></table></td></tr></table><br><table align=center><tr><td><input class=btnw2 name=btnReboot onclick=onClkReboot() type=button value=\"{{ 'Reboot Now' | translate }}\"></td></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 class=scdul style=display:none width=750px><tr><td><b translate>Auto Reboot Time Schedule</b></td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 class=scdul style=display:none width=750><tr><td><table align=center border=0 cellpadding=6 cellspacing=0 width=90%><br><tr><td> <a href=\"/cgi-bin/v2x00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=2056\" translate>Schedule Profile</a>&nbsp;:&nbsp; <select class=schPrfSct name=nSch1 onchange=chgSch(1) size=1><option translate value=0>None</option><option translate value=100>Schedule List</option><option translate value=101>[Create New]</option><option ng-if=sch.length ng-init=j=$index+1 ng-repeat=\"sch in arySchCmmt track by $index\" value={{j}}>{{j+\"-\"+sch}}</option></select>,&nbsp; <select class=schPrfSct name=nSch2 onchange=chgSch(2) size=1><option translate value=0>None</option><option translate value=100>Schedule List</option><option translate value=101>[Create New]</option><option ng-if=sch.length ng-init=j=$index+1 ng-repeat=\"sch in arySchCmmt track by $index\" value={{j}}>{{j+\"-\"+sch}}</option></select>,&nbsp; <select class=schPrfSct name=nSch3 onchange=chgSch(3) size=1><option translate value=0>None</option><option translate value=100>Schedule List</option><option translate value=101>[Create New]</option><option ng-if=sch.length ng-init=j=$index+1 ng-repeat=\"sch in arySchCmmt track by $index\" value={{j}}>{{j+\"-\"+sch}}</option></select>,&nbsp; <select class=schPrfSct name=nSch4 onchange=chgSch(4) size=1><option translate value=0>None</option><option translate value=100>Schedule List</option><option translate value=101>[Create New]</option><option ng-if=sch.length ng-init=j=$index+1 ng-repeat=\"sch in arySchCmmt track by $index\" value={{j}}>{{j+\"-\"+sch}}</option></select></td></tr><tr><td><b translate>Note</b>:<ol><li translate>Please set Duration Time as default value 0:0, otherwise, the reboot function won't work.</li></ol></td></tr></table></td></tr></table><br class=scdul style=display:none><table align=center class=scdul style=display:none width=25%><tr align=center><td><input class=btnw name=btnOk onClick=onClkBtnOk(); type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp;</td><td><input class=btnw name=btnCcl onClick=onClkBtnCcl(); type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table><input name=fid type=hidden value=0><input name=webchange type=hidden value=0><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></td></tr></table><textarea id=rebootsysinit style=display:none>\n\tvar aryTimeSch = ['0', '0', '0', '0'];\n\tvar arySchCmmt = [\"\",\"\",\"\",\n\t\t\t\t\t   \"\",\"\",\"\",\n\t\t\t\t\t   \"\",\"\",\"\",\n\t\t\t\t\t   \"\",\"\",\"\",\n\t\t\t\t\t   \"\",\"\",\"\"];\n\tconst iActionStatusFlag = '0',\n\t\tiFwUpgradeState = '0',\n\t\tIntUK_130End = '0' == '1',\n\t\tIntUK_drmoEnd = '0' == 1,\n\t\tbSloTel = parseInt('0');\n</textarea><script> var rebootsysinitScript=document.createElement(\"script\");rebootsysinitScript.text=document.getElementById(\"rebootsysinit\").value;document.head.appendChild(rebootsysinitScript);top.ACTION_STATUS=-1;top.iActionStatusFlag=iActionStatusFlag;top.iFwUpgradeState=iFwUpgradeState;top.act_sta.damage_alert();var bg=parent;var f=document.frm1;var schElementIdx=0; var myWindow=null;angular.element(document).ready(function(){initParameter();initPage();initWebChange();});function initParameter(){$scope.arySchCmmt=arySchCmmt;$scope.$apply();if(bg.SHOW_APP_SCHEDULE&&!IntUK_130End&&!IntUK_drmoEnd){bg.showElmtByClass(document,\"table\",\"scdul\");bg.showElmtByClass(document,\"br\",\"scdul\");}if(aryTimeSch[0]!='0')bg.setVle2Elmt(f.nSch1,aryTimeSch[0]);if(aryTimeSch[1]!='0')bg.setVle2Elmt(f.nSch2,aryTimeSch[1]);if(aryTimeSch[2]!='0')bg.setVle2Elmt(f.nSch3,aryTimeSch[2]);if(aryTimeSch[3]!='0')bg.setVle2Elmt(f.nSch4,aryTimeSch[3]);}function chgSch(_nsch){var idx=_nsch,i=0;var nullProfidx=0,cmtsetProfidx=0;var val=f[\"nSch\"+idx].value;for(i=0;i<arySchCmmt.length;i++){if(arySchCmmt[i]==\"\"){break;}}nullProfidx=i+1;for(i=0;i<arySchCmmt.length;i++){if(arySchCmmt[i]!=\"\"){cmtsetProfidx++;break;}}if(val==100){ schElementIdx=idx;if(cmtsetProfidx>0){if(myWindow!=null){myWindow.close();}myWindow=window.open(\"/cgi-bin/func.cgi?sFormAuthStr=\"+top.authStr+\"&fid=8\",\"schedulelist\",\"toolbars=no,width=810px,height=800px,top=150px,left=\"+(screen.width/2-232)+\"px,status=no,scrollbars=yes,resize=yes,menubar=no\");}else{alert(gettext('There\\'s no schedule profile set, you can select [Create New] to set a profile.'));return false;}}else if(val==101){ schElementIdx=idx;if(nullProfidx>0&&nullProfidx<=arySchCmmt.length){if(myWindow!=null){myWindow.close();}myWindow=window.open(\"/cgi-bin/v2x00.cgi?sFormAuthStr=\"+top.authStr+\"&fid=3&iSchWiz=1&b0=\"+nullProfidx,\"creatnew\",\"toolbars=no,width=810px,height=800px,top=150px,left=\"+(screen.width/2-232)+\"px,status=no,scrollbars=yes,resize=yes,menubar=no\");}else{alert(gettext('All schedule profiles have been set!'));return false;}}}function onRefreshSchedule(nSch,iSchIdx,iComment){var tmpidx=iSchIdx;var optlen=f[\"nSch\"+nSch].length;var strcomment=tmpidx+\"-\"+iComment;for(var i=1;i<=4;i++){f[\"nSch\"+i].options[optlen]=new Option(strcomment,tmpidx);}bg.setVle2Elmt(f[\"nSch\"+nSch],tmpidx,0);arySchCmmt[iSchIdx-1]=iComment;}function onClkBtnOk(){if(checkWebChange()){f.webchange.value='1';}bg.setVle2Elmt(f.fid,2);var tmpval=0;tmpval=f.nSch1.value;if(tmpval==100||tmpval==101)bg.setVle2Elmt(f.nSch1,aryTimeSch[0],0);tmpval=f.nSch2.value;if(tmpval==100||tmpval==101)bg.setVle2Elmt(f.nSch2,aryTimeSch[1],0);tmpval=f.nSch3.value;if(tmpval==100||tmpval==101)bg.setVle2Elmt(f.nSch3,aryTimeSch[2],0);tmpval=f.nSch4.value;if(tmpval==100||tmpval==101)bg.setVle2Elmt(f.nSch4,aryTimeSch[3],0);f.submit();}function onClkBtnCcl(){document.location=\"/cgi-bin/reboot.cgi?sFormAuthStr=\"+top.authStr+\"&fid=1\";}function initPage(){if(bg.SHOW_SYS_USER&&!bSloTel){bg.hideElmtByClass(document,\"span\",\"admin\");}}function onClkReboot(){if(f.sReboot.value==\"Default\"){if(!confirm(gettext(\"Are you sure to use factory default configuration? This will change the configuration to its default. Please create a backup first if necessary.\")))return false;}f.submit();}</script></body></html>"
