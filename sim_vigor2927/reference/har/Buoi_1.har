          "content": {
            "size": 6918,
            "mimeType": "text/html",
            "compression": 4564,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script><style>\n    .dashboard {\n\t    background-image: url('/images/dashboard.png');\n\t    background-repeat: no-repeat;\n    }\n    .dashboard.green {\n        width: 14px;\n        height: 14px;\n        background-position: -5px -5px;\n        display: inline-block;\n    }\n    .dashboard.gray {\n        width: 14px;\n        height: 14px;\n        background-position: -5px -24px;\n        display: inline-block;\n    }\n    </style></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 style=\"width: 700px;\"><tr><td><b parent=\"{{ 'LAN' | translate }}\" sub-title translate>Link Aggregation</b><hr><form action=/cgi-bin/v2x00.cgi method=POST name=frm1><table align=center cellpadding=2 cellspacing=0 style=\"width: 100%; height: auto; border: black solid 2px;\"><tr><th style=\"width: 10%;\">&nbsp;</th><th style=\"width: 2%;\">&nbsp;</th><th style=\"width: 10%;\">&nbsp;</th><th style=\"width: 2%;\">&nbsp;</th><th style=\"width: 41%; text-align: center; font-size: 15px; font-weight: bold;\" translate>Aggregation Ports</th><th style=\"width: 5%;\">&nbsp;</th><th style=\"width: 20%; text-align: center; font-size: 15px; font-weight: bold;\" translate>Link Status</th><th style=\"width: 5%;\">&nbsp;</th></tr><tr><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td><td><hr style=\"width: 100%;\"></td><td>&nbsp;</td><td><hr style=\"width: 100%;\"></td><td>&nbsp;</td></tr><tr><td style=\"width: 10%;\"><table><tr><td>&nbsp;</td></tr><tr ng-repeat=\"lag in lagDataList\"><td style=\"text-align: center; font-size: 15px;\"><b translate>LAG</b><b>{{lag.idx}}</b></td></tr></table></td><td style=\"width: 2%;\">&nbsp;</td><td style=\"width: 10%;\"><table style=\"width: 100%; text-align: center;\"><tr><td style=\"font-size: 15px;\"><b translate>Enable</b></td></tr><tr ng-repeat=\"lag in lagDataList\"><td><input name=\"{{'lagEnable_' + lag.idx}}\" ng-checked=lag.status.isEnable ng-click=updatePortsStatus(lag.idx) type=checkbox value=1></td></tr></table></td><td style=\"width: 2%;\">&nbsp;</td><td style=\"width: 41%;\"><table style=\"width: 100%; text-align: center;\"><tr><td ng-repeat=\"labelText in lagPortsLabels\" style=\"font-size: 15px; font-weight: bold;\">{{labelText}}</td></tr><tr ng-repeat=\"lag in lagDataList\"><td ng-repeat=\"port in lag.status.ports\"><input name=\"{{'lagPort_' + lag.idx + '_' + port.idx}}\" ng-checked=port.isChecked ng-disabled=!port.isActive ng-if=port.display type=checkbox></td></tr></table></td><td style=\"width: 5%;\">&nbsp;</td><td style=\"width: 20%;\"><table style=\"width: 100%; text-align: center;\"><tr>&nbsp;</tr><tr ng-repeat=\"lag in lagDataList\"><td><i class=\"dashboard gray\" id=\"{{'linkStat_' + lag.idx + '_1'}}\" style=cursor:default;></i></td><td><i class=\"dashboard gray\" id=\"{{'linkStat_' + lag.idx + '_2'}}\" style=cursor:default;></i></td></tr></table></td><td style=\"width: 5%;\">&nbsp;</td></tr></table><table style=\"text-align: left;\"><tr><td><b translate>Note</b>: <ol><li translate>Only Support Static (Balance-xor) mode.</li><li translate>Ports in LAG can not be mirror port.</li><li translate>LAG uses Hash Algorithm to decide the port, and the calculated port might be the same. When LAG doesn't work as expected, please change the device IP for a try.</li></ol></td></tr></table><table align=center><tr><td><input class=btnw onclick=onSubmit() type=button value=\"{{ 'OK' | translate }}\"></td></tr></table><input name=fid type=hidden><input name=opmode type=hidden><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></td></tr></table><textarea id=initSSI style=\"display: none;\">\n    var valueOfLAGs = [{enable:0, port1Idx:0, port2Idx:0}];\n</textarea><script> top.ACTION_STATUS=-1;top.iActionStatusFlag='1';top.iFwUpgradeState='0';</script><script>var f=frm1;var isSettingFeedback=parseInt('0')===1;var isFixPort=parseInt('1');var feedbackCode=parseInt('0');var objectScript=document.createElement(\"script\");objectScript.text=document.getElementById(\"initSSI\").value;document.head.appendChild(objectScript);angular.element(document).ready(function(){initPage();setInterval(getLinkStatusByAjax,500);});function initPage(){if(isSettingFeedback&&feedbackCode!=0){showFeedbackMessage(feedbackCode);}$scope.lagNum=parseInt('1');$scope.portNum=parseInt('5');$scope.lagPortsLabels=getLagPortsLabels();$scope.lagDataList=getLagDataList();$scope.updatePortsStatus=function(lagIdx){updatePortsStatus(lagIdx);};$scope.$apply();}function getLagPortsLabels(){var result=[];for(var i=2;i<=$scope.portNum;i++){result.push(gettext(\"P\")+i);}return result;}function getLagDataList(){var lagObjList=[];var lagTmp;for(var i=1;i<=$scope.lagNum;i++){lagTmp=valueOfLAGs[i-1];var lagObject={};lagObject.idx=i;lagObject.status={};lagObject.status.isEnable=lagTmp.enable==1;lagObject.status.ports=[];for(var j=2;j<=$scope.portNum;j++){lagObject.status.ports.push({idx:j,display:j==i*2||j==i*2+1,isActive:!lagObject.status.isEnable,isChecked:lagObject.status.isEnable});}lagObjList.push(lagObject);}return lagObjList;}function updatePortsStatus(lagIdx){var lagEnable=f[\"lagEnable_\"+lagIdx];var portsIdx=[parseInt(lagIdx)*2,parseInt(lagIdx)*2+1];var port1=f[\"lagPort_\"+lagIdx+\"_\"+portsIdx[0]];var port2=f[\"lagPort_\"+lagIdx+\"_\"+portsIdx[1]];if($scope.lagDataList.length==0||!lagEnable||!port1||!port2){return false;}var ports=$scope.lagDataList[parseInt(lagIdx)-1].status.ports;ports[parseInt(portsIdx[0]-2)].isChecked=ports[parseInt(portsIdx[1]-2)].isChecked=lagEnable.checked;ports[parseInt(portsIdx[0]-2)].isActive=ports[parseInt(portsIdx[1]-2)].isActive=!lagEnable.checked;return true;}function showFeedbackMessage(msgCode){switch(msgCode){case 1:alert(gettext(\"The ports setting in WAN >> Multi-PVC/VLAN >> Port-based Bridge should be same.\"));break;case 2:alert(gettext(\"The ports setting in LAN >> VLAN Configuration should be same.\"));break;case 3:alert(gettext(\"The ports setting in LAN >> LAN Port Mirror should be same.\"));break;case 4:alert(gettext(\"The ports setting in LAN >> Wired 802.1X should be same.\"));break;default:throw new Error(\"An Exception error occured.\");}}function onSubmit(){f.fid.value=2901;f.opmode.value=1;f.submit();}function getLinkStatusByAjax(){var url=\"/cgi-bin/V2X00.cgi?fid=2901&opmode=2&sFormAuthStr=JdvKVyYlhh7GhS9\";$http.get(url).then(function(response){try{var status=response.data;var link1,link2;for(var lagIdx=1;lagIdx<=$scope.lagDataList.length;lagIdx++){link1=document.getElementById(\"linkStat_\"+lagIdx+\"_1\");link2=document.getElementById(\"linkStat_\"+lagIdx+\"_2\");link1&&(link1.style.backgroundPosition=(status[lagIdx*2-1]==1)?\"-5px -5px\":\"-5px -24px\");link2&&(link2.style.backgroundPosition=(status[lagIdx*2]==1)?\"-5px -5px\":\"-5px -24px\");}}catch(error){throw new Error(error);}});}</script></body></html>"
          },
