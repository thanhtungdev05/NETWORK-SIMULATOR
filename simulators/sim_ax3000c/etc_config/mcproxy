
config mcproxy 'mcproxy_file'
	option respawn '1'
	option file '/etc/aei_mcproxy.conf'
	option disabled '0'

config mcproxy 'mcproxy'
	option disabled '1'
	option respawn '1'
	option protocol 'IGMPv2'

config instance
	option disabled '0'
	option name 'proxy1'
	list upstream 'eth0'
	list downstream 'br-lan'

config table
	option name 'allways'
	list entries '(*|*)'

config behaviour
	option instance 'proxy1'
	option section 'downstream'
	option interface 'br-lan'
	option direction 'in'
	option table 'allways'
	option disabled '0'

