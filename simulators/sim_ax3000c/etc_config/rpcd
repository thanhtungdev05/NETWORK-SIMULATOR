
config rpcd
	option socket '/var/run/ubus.sock'
	option timeout '30'

config login 'local'
	option username 'admin'
	list read '*'
	list write '*'

config login 'remote'
        option username 'assist'
        list read '*'
        list write '*'

config login 'wizard'
        option username 'wizard'
        list read '*'
        list write '*'
        option password 'wizard'
