config include 'ddos'
	option enabled '1'
	option path /etc/firewall.ddos
	option reload '1'
	option en_spi '1'
	option client_isolation '0'
	option en_ddos '1'
	option tcpsynflood_detect '1'
	option tcpsynflood_rate '25'
	option tcpsynflood_timeout '50'
	option udpflood_detect '0'
	option udpflood_rate '150'
	option udpflood_timeout '10'
	option icmpflood_detect '1'
	option icmpflood_rate '100'
	option icmpflood_timeout '5'
	option portscan_detect '0'
	option portscan_rate '150'
	option block_ip '0'
	option block_land '0'
	option block_smurf '0'
	option block_tracert '0'
	option block_synfrag '0'
	option block_fraggle '0'
	option block_tcpflag_scan '1'
	option block_teardrop '0'
	option block_pingdeath '0'
	option block_icmpfrag '0'
	option block_unknownproto '1'

