            "size": 13526,
            "mimeType": "text/html",
            "compression": 10004,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/dhtml.min.js?094907\"></script></head><textarea id=raccctlinit style=display:none>\nvar pptpwan = [1,1,1,1,1,1];\nvar ipsecwan = [2,2,2,2,2,2];\nvar l2tpwan = [4,4,4,4,4,4];\nvar openvpnwan = [16,16,16,16,16,16];\nvar wireguardwan =  [32,32,32,32,32,32];\n</textarea><body class=ng-cloak onload=initParameter()><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'VPN and Remote Access' | translate }}\" sub-title translate>Remote Access Control</b><hr><form name=frm1><table border=0 cellspacing=2 width=700><tr><td align=left class=offtab id=tab1 onClick=dhtml.cycleTab(this.id);parent.sVPNAccCtlTag=this.id; width=35%><b translate>Remote Access Control Setup</b></td><td align=left class=offtab id=tab2 onClick=dhtml.cycleTab(this.id);parent.sVPNAccCtlTag=this.id; width=35%><b translate>Bind to WAN</b></td></tr></table><div id=page1><table border=1 cellspacing=0 width=700><tr><td><table align=center border=0 cellpadding=2 cellspacing=0><tr><td><label><input name=chxPPTP type=checkbox>&nbsp;<translate>Enable PPTP VPN Service</translate></label><td></tr><tr class=sL2lIpsec style=display:none><td><label><input name=chxIPSec type=checkbox>&nbsp;<translate>Enable IPsec VPN Service</translate></label></td></tr><tr class=sL2lIpsec style=display:none><td><label><input name=chxL2TP type=checkbox>&nbsp;<translate>Enable L2TP VPN Service</translate></label></td></tr><script> if(parseInt('1')){document.write('<tr><td><label><input type=checkbox name=chxSSTP>&nbsp;'+gettext(\"Enable SSL VPN Service\")+'</label></td></tr>');}</script><tr class=isdn style=display:none><td><label><input DISABLED name=chxISDN type=checkbox>&nbsp; <script>var iUsb56kModem='0';if(iUsb56kModem==1)document.write(gettext(\"Enable USB Modem Dial-In\"));else document.write(gettext(\"Enable ISDN Dial-In\"));</script></label></td></tr><tr ng-if=bOpenVPN><td><label><input name=chxOpenVPN type=checkbox>&nbsp;<translate>Enable OpenVPN Service</translate></label></td></tr><tr ng-if=bOpenVPN><tr ng-if=bWireGuard><td><label><input name=chxWireGuardVPN type=checkbox>&nbsp;<translate>Enable WireGuard VPN Service</translate></label></td></tr><tr ng-if=bWireGuard></table></td></tr></table><b translate>Note</b>: <ol><li id=link_note translate>To allow VPN pass-through to a separate VPN server on the LAN, disable the services listed above that use the same protocol and ensure that NAT <a1>Open Ports</a1> or <a2>Port Redirection</a2> is well-configured.</li><li id=link_note translate>Disable unused VPN services, enable <a3>Brute Force Protection</a3>, and <a4>block unknown IP access</a4> to the used VPN services to reduce Cyberattacks.</li></ol><br><table width=100%><tr align=center><td><input class=btnw name=btnOK onClick=submitPara() type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnClr onClick=onbtnClr() type=button value=\"{{ 'Clear' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnCcl onClick=onbtnCcl() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table><br></td></tr></table></div><div id=page2 style=display:none><table align=center border=1 cellspacing=0 width=700><tr><td><table align=center border=0 cellpadding=2 cellspacing=0><tr><td align=right translate>PPTP VPN Service</td><td colspan=2><span id=\"vpnPPTPWan\"></span></td></tr><tr><td align=right translate>IPsec VPN Service</td><td colspan=2><span id=\"vpnIPsecWan\"></span></td></tr><tr><td align=right translate>L2TP VPN Service</td><td colspan=2><span id=\"vpnL2TPWan\"></span></td></tr><tr><td align=right translate>SSL VPN Service</td><td colspan=2><span id=\"vpnSSLWan\"></span></td></tr><tr><td align=right translate>OpenVPN Service</td><td colspan=2><span id=\"vpnOpenVPNWan\"></span></td></tr><tr ng-if=bWireGuard><td align=right translate>WireGuard Service</td><td colspan=2><span id=\"vpnWireguardWan\"></span></td></tr></table></td></tr></table><br><table width=100%><tr align=center><td><input class=btnw name=btnOK onClick=submitWanPara() type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnClr onClick=onbtnWanClr() type=button value=\"{{ 'Clear' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnCcl onClick=onbtnWanCcl() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table></div><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form><script src=\"/js/variable.js?35331\"></script><script>var raccctlinitScript=document.createElement(\"script\");raccctlinitScript.text=raccctlinit.value;document.head.appendChild(raccctlinitScript);top.ACTION_STATUS=-1;top.iActionStatusFlag='0';top.iFwUpgradeState='0';top.act_sta.damage_alert();var f=document.frm1,bg=parent;if(parseInt('1')){var iRAccCtlSSTP=(('505'>>0)&0x01)?0:1;}var iIntfWan1=parseInt(\"3\");var iBwanNumber=parseInt(\"6\");var iSSTPFlag=parseInt(\"505\");angular.element(document).ready(function(){$scope.bOpenVPN=parseInt('1');$scope.bWireGuard=parseInt('1');$scope.$apply();initpage();});function onbtnCcl(){document.location.href='/doc/RAccCtl.htm';}function onbtnClr(){if(confirm(gettext(\"Are you sure you want to clear?\"))){bg.setVle2Elmt(f.chxPPTP,0,0);bg.setVle2Elmt(f.chxIPSec,0,0);bg.setVle2Elmt(f.chxL2TP,0,0);if(parseInt('1')){bg.setVle2Elmt(f.chxSSTP,0,0);}bg.setVle2Elmt(f.chxISDN,0,0);if(parseInt('1')){bg.setVle2Elmt(f.chxOpenVPN,0,0);}if(parseInt('1')){bg.setVle2Elmt(f.chxWireGuardVPN,0,0);}submitPara();}}function initParameter(){bg.setVle2Elmt(f.chxPPTP,iRAccCtlPPTP,0);bg.setVle2Elmt(f.chxIPSec,iRAccCtlIPSec,0);bg.setVle2Elmt(f.chxL2TP,iRAccCtlL2TP,0);bg.setVle2Elmt(f.chxISDN,iRAccCtlISDN,0);if(parseInt('1')){bg.setVle2Elmt(f.chxSSTP,iRAccCtlSSTP,0);}if(parseInt('1')){bg.setVle2Elmt(f.chxOpenVPN,iRAccCtlOpenVPN,0);}if(parseInt('1')){bg.setVle2Elmt(f.chxWireGuardVPN,iRAccCtlWireGuard,0);}}function initpage(){var iBwanNumber='6';var strChecked;var bDualDSL=parseInt('0');var DualDslEnable=parseInt(\"0\");var iFixWanNum=parseInt(\"4\");var iUSBNum=parseInt(\"2\");var iSecUsbNum=parseInt(\"1\");var bNewWLWAN=parseInt('1');var bWless=parseInt('0');var bDualWless5G=parseInt('0');var idx_2nd_usb=iFixWanNum+iUSBNum-iSecUsbNum;var extra_vdsl_idx=iFixWanNum+iUSBNum;var bWan2IsDisable=parseInt('0');var sLTEmodulename='LTE';if(bg.sVPNAccCtlTag=='tab2'){dhtml.cycleTab('tab2');document.getElementById(\"page1\").style.display=\"none\";}else dhtml.cycleTab('tab1');if('DISABLED'!='DISABLED'||(iUsb56kModem==1)){bg.showElmtByClass(document,\"tr\",\"isdn\");}if(bg.SHOW_VPN_IPSEC){bg.showElmtByClass(document,\"tr\",\"sL2lIpsec\");}var notemsg=document.querySelectorAll(\"#link_note\");var strPPTP=strIPsec=strSSL=strOpenVPN=strL2TP=strWireguard=\"\";for(var wani=0;wani<iBwanNumber;wani++){if(top.notSupportWAN.indexOf(wani)!=-1)continue;if((bDualDSL&&extra_vdsl_idx==wani&&DualDslEnable!=\"1\")||(iUSBNum==2&&iSecUsbNum==0&&idx_2nd_usb==(wani+1)))continue;if(bNewWLWAN&&(wani==2||wani==3)&&!bWless&&!bDualWless5G)continue;else if(bNewWLWAN&&wani==3&&!bDualWless5G)continue;if(((wani==1||wani==3)&&parseInt('0'))||(wani==1&&bWan2IsDisable))continue; if(pptpwan[wani]==0)strChecked=\" checked\";else strChecked=\"\";strPPTP+=\"<label><input type=checkbox value=\"+wani+\" name=chkWanIp id=bindWANPPTP\"+wani+strChecked+\"> \";if(((wani==2&&!parseInt('1'))||(wani==4&&parseInt('1')))&&(parseInt('0')))strPPTP+=gettext(sLTEmodulename)+\"</label>\";else strPPTP+=gettext(\"WAN\")+(wani+1)+\"</label>&nbsp;&nbsp;\"; if(ipsecwan[wani]==0)strChecked=\" checked\";else strChecked=\"\";strIPsec+=\"<label><input type=checkbox value=\"+wani+\" name=chkWanIp id=bindWANIPsec\"+wani+strChecked+\"> \";if(((wani==2&&!parseInt('1'))||(wani==4&&parseInt('1')))&&(parseInt('0')))strIPsec+=gettext(sLTEmodulename)+\"</label>\";else strIPsec+=gettext(\"WAN\")+(wani+1)+\"</label>&nbsp;&nbsp;\"; if(l2tpwan[wani]==0)strChecked=\" checked\";else strChecked=\"\";strL2TP+=\"<label><input type=checkbox value=\"+wani+\" name=chkWanIp id=bindWANL2TP\"+wani+strChecked+\"> \";if(((wani==2&&!parseInt('1'))||(wani==4&&parseInt('1')))&&(parseInt('0')))strL2TP+=gettext(sLTEmodulename)+\"</label>\";else strL2TP+=gettext(\"WAN\")+(wani+1)+\"</label>&nbsp;&nbsp;\"; if(!(iSSTPFlag&(1<<(iIntfWan1+wani))))strChecked=\" checked\";else strChecked=\"\";strSSL+=\"<label><input type=checkbox value=\"+wani+\" name=chkWanIp id=bindWANSSL\"+wani+strChecked+\"> \";if(((wani==2&&!parseInt('1'))||(wani==4&&parseInt('1')))&&(parseInt('0')))strSSL+=gettext(sLTEmodulename)+\"</label>\";else strSSL+=gettext(\"WAN\")+(wani+1)+\"</label>&nbsp;&nbsp;\"; if(openvpnwan[wani]==0)strChecked=\" checked\";else strChecked=\"\";strOpenVPN+=\"<label><input type=checkbox value=\"+wani+\" name=chkWanIp id=bindWANOpenVPN\"+wani+strChecked+\"> \";if(((wani==2&&!parseInt('1'))||(wani==4&&parseInt('1')))&&(parseInt('0')))strOpenVPN+=gettext(sLTEmodulename)+\"</label>\";else strOpenVPN+=gettext(\"WAN\")+(wani+1)+\"</label>&nbsp;&nbsp;\"; if(parseInt('1')){if(wireguardwan[wani]==0)strChecked=\" checked\";else strChecked=\"\";strWireguard+=\"<label><input type=checkbox value=\"+wani+\" name=chkWanIp id=bindWireguardVPN\"+wani+strChecked+\"> \";if(((wani==2&&!parseInt('1'))||(wani==4&&parseInt('1')))&&(parseInt('0')))strWireguard+=gettext(sLTEmodulename)+\"</label>\";else strWireguard+=gettext(\"WAN\")+(wani+1)+\"</label>&nbsp;&nbsp;\";}document.getElementById(\"vpnPPTPWan\").innerHTML=strPPTP;document.getElementById(\"vpnIPsecWan\").innerHTML=strIPsec;document.getElementById(\"vpnL2TPWan\").innerHTML=strL2TP;document.getElementById(\"vpnSSLWan\").innerHTML=strSSL;document.getElementById(\"vpnOpenVPNWan\").innerHTML=strOpenVPN;if(parseInt('1')){document.getElementById(\"vpnWireguardWan\").innerHTML=strWireguard;}}angular.element(notemsg[0]).find(\"a1\").attr(\"href\",'/cgi-bin/v2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=2054&iPageIdx=1');angular.element(notemsg[0]).find(\"a2\").attr(\"href\",'/cgi-bin/ipnat.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=0&iPageIdx=1');angular.element(notemsg[1]).find(\"a3\").attr(\"href\",'/cgi-bin/v2x00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=2041');angular.element(notemsg[1]).find(\"a4\").attr(\"href\",\"#\").attr(\"onclick\",'window.open(\"https://www.draytek.com/support/knowledge-base/5982\")');for(i=0;i<notemsg.length;i++){angular.element(notemsg[i]).html(notemsg[i].innerHTML.replace(/a\\d/g,'a'));}}function submitPara(){ if((bg.getVleFromElmt(f.chxPPTP,0)==iRAccCtlPPTP)&&(bg.getVleFromElmt(f.chxIPSec,0)==iRAccCtlIPSec)&&(bg.getVleFromElmt(f.chxL2TP,0)==iRAccCtlL2TP)&&(bg.getVleFromElmt(f.chxISDN,0)==iRAccCtlISDN)){if(parseInt('1')&&bg.getVleFromElmt(f.chxSSTP,0)==iRAccCtlSSTP){if(parseInt('1')&&bg.getVleFromElmt(f.chxOpenVPN,0)==iRAccCtlOpenVPN){if(parseInt('1')&&bg.getVleFromElmt(f.chxWireGuardVPN,0)==iRAccCtlWireGuard){ document.location.href='/doc/RAccCtl.htm';return;}}}}var url;url=\"/cgi-bin/v2x00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=\"+bg.V2X00_FID_VPN_RACC_CTL;url+='&'+bg.HTML_VPN_RACC_PPTP+'='+bg.getVleFromElmt(f.chxPPTP,0);url+='&'+bg.HTML_VPN_RACC_IPSec+'='+bg.getVleFromElmt(f.chxIPSec,0);url+='&'+bg.HTML_VPN_RACC_L2TP+'='+bg.getVleFromElmt(f.chxL2TP,0);if(parseInt('1')){url+='&'+bg.HTML_VPN_RACC_SSTP+'='+bg.getVleFromElmt(f.chxSSTP,0);}url+='&'+bg.HTML_VPN_RACC_ISDN+'='+bg.getVleFromElmt(f.chxISDN,0);if(parseInt('1')){url+='&'+bg.HTML_VPN_RACC_OpenVPN+'='+bg.getVleFromElmt(f.chxOpenVPN,0);}if(parseInt('1')){url+='&'+bg.HTML_VPN_RACC_WIREGUARD+'='+bg.getVleFromElmt(f.chxWireGuardVPN,0);}url+=\"&webchange=1\";document.location.href=url;}function submitWanPara(){var pptpvpn_wan=ipSecvpn_wan=l2TPvpn_wan=sslvpn_wan=openvpn_wan=wireguard_wan=0;for(i=0;i<iBwanNumber;i++){var elem_pptp=bg.getElmtById(document,\"bindWANPPTP\"+i);if(elem_pptp==null)continue;var bindwan_pptp=bg.getVleFromElmt(elem_pptp,0);if