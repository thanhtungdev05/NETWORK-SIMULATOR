            "compression": 2883,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><script> if(opener!=null)self.close();</script><tr><td colspan=2><b parent=\"{{ 'CSM' | translate }}\" qslink=\"https://www.draytek.com/router-help-redirect?stk_title=CSM&nd_title=URL Content Filter Profile\" sub-title translate>URL Content Filter Profile</b><hr><form action=/cgi-bin/V2X00.cgi method=post name=frm1><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>URL Content Filter Profile Table</b>:</td><td align=right class=red>|&nbsp; <a class=DenyLink href=javascript:ruOK() translate>Set to Factory Default</a>&nbsp;|</td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 class=table-striped width=100%><thead><tr><th translate width=10%>Profile</th><th translate width=40%>Name</th><th translate width=10%>Profile</th><th translate width=40%>Name</th></tr></thead><tbody><tr align=center ng-init=\"idx = $index + 1\" ng-repeat=\"prof in [].constructor(col_offset) track by $index\"><td> <a href=# ng-click=gotoDetailSet(idx)>{{idx}}.</a></td><td>&nbsp;{{aryUrlCfProfName[idx-1]}}</td><td> <a href=# ng-click=gotoDetailSet(idx+col_offset)>{{idx+col_offset}}.</a></td><td>&nbsp;{{aryUrlCfProfName[idx-1+col_offset]}}</td></tr></tbody></table></td></tr></table><table align=center border=0 cellpadding=0 cellspacing=2 width=100%><tr><td colspan=2><b translate>Note</b>: <ol><li id=link_note translate>To make URL Content Filter profile effective, please go to <a>Firewall &gt;&gt; Filter Setup</a> page to create a firewall rule and select the desired profile.</li></ol></td></tr></table><br><table align=center border=0 cellpadding=0 cellspacing=0 width=100%><tr><td><b translate>Administration Message</b> (<translate translate-params-num=\"255\">Max {{num}} characters</translate>)</td><td align=right class=red> <a href=javascript:preview() translate>Preview</a>&nbsp;|&nbsp; <input class=btnw4 onclick=onClkDefMess() type=button value=\"{{ 'Default Message' | translate }}\"></td></tr><tr><td colspan=2><textarea name=sAdminMsg onkeydown=textCounter() onkeyup=textCounter() rows=5 style=width:100%><body><center><br><p>The requested Web page has been blocked by URL Content Filter.<p>Please contact your system administrator for further information.</center></body></textarea></td></tr></table><br><table align=center><tr><td><input class=btnw name=btnOk onclick=onClkBtnOk() type=button value=\"{{ 'OK' | translate }}\"></td></tr></table><input name=fid type=hidden value=2006><input name=sAct type=hidden><input name=iPageIdx type=hidden><input name=iProfileIdx type=hidden><input name=webchange type=hidden value=0><input name=sFormAuthStr type=hidden value=\"IIuPNWCC8qRLLzn\"></form></td></tr></table><textarea id=cf1init style=display:none>\n\tvar aryUrlCfProfName = [\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\"];\n</textarea><script>top.ACTION_STATUS=-1;top.iActionStatusFlag='1';top.iFwUpgradeState='0';top.act_sta.damage_alert();var cf1initScript=document.createElement(\"script\");cf1initScript.text=document.getElementById(\"cf1init\").value;document.head.appendChild(cf1initScript);var bg=parent;var f=document.frm1;angular.element(document).ready(function(){$scope.gotoDetailSet=function(idx){f.sAct.value=\"showitem\";f.iProfileIdx.value=idx;f.submit();};$scope.col_offset=aryUrlCfProfName.length/2;$scope.aryUrlCfProfName=aryUrlCfProfName;$scope.$apply();initWebChange();angular.element(document.querySelector(\"#link_note a\")).attr(\"href\",'/cgi-bin/ipf.cgi?sFormAuthStr=IIuPNWCC8qRLLzn');});function ruOK(){if(true==confirm(gettext('All URL Content Filter Profiles will be removed from Filter Rule.\\nDo you want to clear all profiles?'))){f.sAct.value=\"settodefault\";f.webchange.value='1';f.submit();}}function onClkBtnOk(){if(checkWebChange()){f.webchange.value='1';}f.sAct.value=\"saveadminmsg\";f.submit();}function textCounter(){if(f.sAdminMsg.value.length>255)f.sAdminMsg.value=f.sAdminMsg.value.substring(0,255);}function onClkDefMess(){sAdminMsg=\"<body><center><br><p>\"+gettext('The requested Web page has been blocked by URL Content Filter.')+\"</p><p>\"+gettext('Please contact your system administrator for further information.')+\"</p></center></body>\";bg.setVle2Elmt(f.sAdminMsg,sAdminMsg,0);}function preview(){window.open(\"/cgi-bin/V2X00.cgi?sFormAuthStr=IIuPNWCC8qRLLzn&fid=104&iAct=1\",\"userlogin\",\"toolbars=no,width=800px,height=600px,top=150px,left=\"+(screen.width/2-232)+\"px,status=no,scrollbars=yes,resize=yes,menubar=no\");}</script></body></html>"
