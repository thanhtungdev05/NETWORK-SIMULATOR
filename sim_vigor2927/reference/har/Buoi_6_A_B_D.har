ll be deleted when downgrading router firmware from version 4.4.0 to an older version.</li><li ng-show=\"'1' == 1\" translate>Local Certificate and Trusted CA Certificate share a storage space.</li><li ng-show=\"'1' == 1\" translate>CA field means the certificate issuer has been imported to router.</li></ol><table align=center><tr><td><input data-new-cert name=X509Gen onclick=x509request() type=button value=\" {{ 'GENERATE' | translate }} \">&nbsp; <input data-new-cert name=X509Import onclick=x509import() type=button value=\"  {{ 'IMPORT' | translate }}  \">&nbsp; <input name=X509Refresh onclick=X509refresh() type=button value=\" {{ 'REFRESH' | translate }} \"></td></tr></table><input name=sFormAuthStr type=hidden value=\"pU2VHFY4WAi1NkA\"></form></td></tr></table><script src=\"/js/variable.js?5959\"></script><script>top.ACTION_STATUS=-1;top.iActionStatusFlag='0';top.iFwUpgradeState='0'; var f=document.frm1;var bg=parent;var fid=\"\";var winX509view,winX509Gen,winX509Import;var cert_max=aryLocCA.length;var rootca_sub='';var iNewCert=parseInt('1');delete top.signState; var str=\"\";top.certTitle=\"Local\";angular.element(document).ready(function(){if(iNewCert===1)newCertManagement(iNewCert,memoryUsage); aryLocCA.forEach(function(LocCA,LocCAIdx){var signInput=\"\";if(rootca_uid!=0&&LocCA[2]==\"Requesting\")signInput='<input type=button value=\"'+gettext(\"Sign\")+'\" onclick=\"x509sign('+LocCAIdx+', \\''+LocCA[0]+'\\')\">';if(iNewCert===1){if(LocCA[0]!==\"---\"){var tmpCAarry=LocCA[0].split(\"/\");var name=tmpCAarry[2];str+='<tr>\\\n\t\t\t\t<td align=center>'+LocCA[0]+'</td>\\\n\t\t\t\t<td class=\"overflow-content\">'+LocCA[1]+'</td><td class=\"overflow-content\">'; if(LocCA[2]=='Not Valid Yet'){str+='<div class=status-not></div><font color=\"#aaaaaa\">'+gettext(LocCA[2])+'</font></td>';}else if(LocCA[2]=='Expired'){str+='<div class=status-expired></div><font color=\"#d8253a\">'+gettext(LocCA[2])+'</font></td>';}else if(LocCA[2]=='Expire within 30 days'){str+='<div cl