            "compression": 1702,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><script> if(location.hash==\"#close\")self.close();</script><tr><td><b parent=\"{{ 'Objects Setting' | translate }}\" sub-title translate>IP Group</b><hr><form action=/cgi-bin/ipgrp.cgi method=post name=frm1><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>IP Group Table</b>:</td><td align=right class=red>|&nbsp; <a class=DenyLink href=javascript:ruOK() translate>Set to Factory Default</a>&nbsp;|</td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 class=table-striped width=100%><thead><tr align=center><th translate width=10%>Index</th><th translate width=40%>Name</th><th translate width=10%>Index</th><th translate width=40%>Name</th></tr></thead><tbody><tr align=center ng-init=\"idx = $index + 1\" ng-repeat=\"grp in [].constructor(col_offset) track by $index\"><td> <a href=# ng-click=gotoDetailSet(idx)>{{idx}}.</a></td><td>&nbsp;{{aryIpGrpName[idx-1]}}</td><td> <a href=# ng-click=gotoDetailSet(idx+col_offset)>{{idx+col_offset}}.</a></td><td>&nbsp;{{aryIpGrpName[idx-1+col_offset]}}</td></tr></tbody></table></td></tr></table><br> <a href=\"/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=2075\" translate>Objects Backup/Restore</a><input name=sIpGrpAct type=hidden><input name=iIpGrpPnum type=hidden><input name=iIpGrpIdx type=hidden><input name=webchange type=hidden value=0><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></td></tr></table><textarea id=ipgrp1init style=display:none>\n    var aryIpGrpName = [\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\",\"\"];\n    var isUsed = \"0\" == 1;\n    const iActionStatusFlag = 4,\n        iFwUpgradeState = 0;\n</textarea><script>var ipgrp1initscript=document.createElement(\"script\");ipgrp1initscript.text=document.getElementById(\"ipgrp1init\").value;document.head.appendChild(ipgrp1initscript);top.ACTION_STATUS=-1;top.iActionStatusFlag=iActionStatusFlag;top.iFwUpgradeState=iFwUpgradeState;top.act_sta.damage_alert();var bg=parent;var f=document.frm1; angular.element(document).ready(function(){$scope.aryIpGrpName=aryIpGrpName;$scope.col_offset=aryIpGrpName.length/2;$scope.gotoDetailSet=function(idx){f.sIpGrpAct.value=\"showitem\";f.iIpGrpIdx.value=idx;f.submit();};$scope.$apply();});function ruOK(){if(isUsed){alert(gettext('Some profiles are used in Port Redirection/Open Ports, please remove the Port Redirection/Open Ports profile first!'));return false;}if(confirm(gettext('All IP Groups will be removed from Filter Rule.\\nDo you want to clear all profiles?'))){f.sIpGrpAct.value=\"settodefault\";f.webchange.value='1';f.submit();}}</script></body></html>"
