            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script><style>\n\t\t.text-indent {\n\t\t\ttext-indent: 20px;\n\t\t}\n\t</style></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700px><script> var sPresetModel='2927';</script><tr><td><b translate>Hardware Acceleration</b><hr><form action=/cgi-bin/ipnat.cgi method=post name=frm1><table align=center cellpadding=2 cellspacing=0 id=okretry width=700px><tbody><tr class=genmodel><td width=10%><b><translate>Mode</translate>:&nbsp;</b></td><td><select id=iHwSetFlag name=iHwSetFlag onchange=onChangeType()><option translate value=0>Disabled</option><option translate value=1>Auto</option><option ng-selected=\"isNATChecked && isEnableAcc\" ng-show=isSupPPASpecificHost translate value=2>Manual</option></select></td></tr></tbody><tbody ng-show=isSupGRX500><tr><td width=10%><b><translate>Acceleration</translate>:&nbsp;</b></td><td><select id=iHwAccSwitch name=iHwAccSwitch onchange=onChgMode()><option translate value=0>Disable</option><option translate value=1>Enable</option></select></td></tr><tr id=opmode ng-show=isSupBridgeMode><td width=20%><b><translate>Operation Mode</translate>:&nbsp;</b></td><td><select id=iOpMode name=iOpMode ng-disabled=!isEnableAcc onchange=onChgOpMode()><option translate value=0>Router</option><option translate value=1>Bridge</option></select></td></tr><tr><td colspan=2></td></tr><tr ng-show=isRouterMode><td colspan=2><input name=enNAT ng-disabled=!isEnableAcc ng-model=isNATChecked type=checkbox value=1>&nbsp;<translate>NAT</translate></td></tr><tr ng-show=isRouterMode><td><span style=\"margin-right: 35px\"></span><translate>Protocol</translate>:</td><td><span><input name=iNATTcp ng-disabled=\"!isEnableAcc || !isNATChecked\" ng-model=isNATTcpChec