            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/dhtml.min.js?094907\"></script><script> function reorder_subject(cert_str){var i,str1=\"\";var str=cert_str.split(\"/\");if(str.length==1){document.write(cert_str);}else{for(i=1;i<str.length;i++){if(i!=str.length-1)str1=str1+str[i]+\", \";else str1=str1+str[i];}document.write(str1);}}</script><script src=\"/js/webchange.js?094907\"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 1 ? ('Certificate Management' | translate) : ('System Maintenance' | translate) }}\" sub-title translate>Self-Signed Certificate</b><hr><table align=center border=0 cellpadding=0 cellspacing=0 width=100%><tr><td align=left><b translate>Self-Signed Certificate Information</b></td></tr></table><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 width=100%><tr class=row0><td><nobr>&nbsp;<translate>Certificate Name</translate> :</nobr></td><td width=100%>&nbsp;self-signed</td></tr><tr class=row1><td><nobr>&nbsp;<translate>Issuer</translate> :</nobr></td><td>&nbsp;<script>reorder_subject(\"C = TW, ST = HsinChu, L = HuKou, O = DrayTek Corp., OU = DrayTek Support, CN = Vigor Router\");</script></td></tr><tr class=row0><td><nobr>&nbsp;<translate>Subject</translate> :</nobr></td><td>&nbsp;<script>reorder_subject(\"C = TW, ST = HsinChu, L = HuKou, O = DrayTek Corp., OU = DrayTek Support, CN = Vigor Router\");</script></td></tr><tr class=row1><td><nobr>&nbsp;<translate>Subject Alternative Name</translate> :</nobr></td><td>&nbsp;DNS:www.draytek.com</td></tr><tr class=row0><td><nobr>&nbsp;<translate>Valid From</translate> :</nobr></td><td>&nbsp;Oct 22 09:51:28 2024 GMT+00:00</td></tr><tr class=row1><td><no