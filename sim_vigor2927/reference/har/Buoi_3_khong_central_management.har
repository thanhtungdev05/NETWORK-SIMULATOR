d><translate>please see \"Analysis\" below</translate></td></tr></table></td><td class=iperr0 style=display:none><table><tr><td><font color=red><translate>The packet was dropped</translate><br><translate>It did not come from one of router's legitimate subnets</translate></font></td></tr></table></td><td class=iperr1 style=display:none><table><tr><td><font color=red><translate>The packet was dropped</translate><br><translate>The subnet where it came from was not enabled</translate></font></td></tr></table></td><td class=iperr2 style=display:none><table><tr><td><font color=red><translate>The packet was dropped</translate><br><translate>Inter-LAN Routing was not enabled</translate></font></td></tr></table></td><td id=finalstr style=display:none></td></tr><script>var aryFinalstr=JSON.parse(\"[]\".replace(/'/g,'\"'));var WANidx='';var WANaccmode=JSON.parse(\"[2,2,0,0,0,0]\".replace(/'/g,'\"'));var str=\"\";if(top.idxperpage!=10&&top.idxperpage!=20&&top.idxperpage!=30&&top.idxperpage!=40&&top.idxperpage!=50){top.idxperpage=10;}var iIdxPerPage=top.idxperpage,sInterface;angular.element(document).ready(function(){var finalres;if(aryFinalstr.length!=0){if(aryFinalstr[0]==0)finalres=gettext('The packet was dropped because neither \"route\" or \"policy\" was matched');if(aryFinalstr[0]==1){finalres=gettext('The packet was sent via <a1><font>###STR1###</font></a> according to <a2><font>policy ###STR2###</font></a>\"');if('2927'!='2710'&&'2927'!='2120'&&'2927'!='2110'){if(WANidx.charAt(0)=='W')finalres=translateReplace1(finalres,'<a class=\"DenyToPage\"  href=\"javascript:WanLink3('+WANaccmode[parseInt(WANidx.charAt(3))-1]+','+WANidx.charAt(3)+')\">');else if(WANidx.charAt(0)=='L')finalres=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:LanLink()\">');else finalres=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:VPNLink()\">');}else{if(WANidx.charAt(0)=='W'){if('2927'!='2120')str+=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:WanLink1()\">');else str+=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:WanLink2()\">');}else if(WANidx.charAt(0)=='L')str+=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:LanLink()\">');else str+=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:VPNLink()\">');}}else if(aryFinalstr[0]==2){finalres=gettext('The packet was sent via <a1><font>###STR1###</font></a> according to <a2><font>policy ###STR2###</font></a>\"\\'s failover setting');if('2927'!='2710'&&'2927'!='2120'&&'2927'!='2110'){if(WANidx.charAt(0)=='W')finalres=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:WanLink3('+WANaccmode[parseInt(WANidx.charAt(3))-1]+','+WANidx.charAt(3)+')\">');else if(WANidx.charAt(0)=='L')finalres=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:LanLink()\">');else finalres=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:VPNLink()\">');}else{if(WANidx.charAt(0)=='W'){if('2927'!='2120')finalres=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:WanLink1()\">');else finalres=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:WanLink2()\">');}else if(WANidx.charAt(0)=='L')finalres=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:LanLink()\">');else finalres=translateReplace1(finalres,'<a class=\"DenyToPage\" href=\"javascript:VPNLink()\">');}}else if(aryFinalstr[0]==3){finalres=gettext('The packet was dropped because the send-to interface of the matched policy \"<a1><font>policy ###STR1###</font></a>\" was inactive and there was no failover setting');finalres=finalres.replace(\"<a1>\",'<a class=\"DenyToPage\" href=\"javascript:policyLink('+top.idxperpage+','+parseInt((aryFinalstr[1]-1)/iIdxPerPage+1)+','+aryFinalstr[1]+');\">').replace(\"<font>\",'<font color=#4F94CD>').replace(\"###STR1###\",aryFinalstr[1]);}else if(aryFinalstr[0]==4){finalres=gettext('The packet was dropped because the matched policy \"<a><font>policy ###STR###</font></a>\" failed to failover');finalres=finalres.replace(\"<a>\",'<a class=\"DenyToPage\" href=\"javascript:policyLink('+top.idxperpage+','+parseInt((aryFinalstr[1]-1)/iIdxPerPage+1)+','+aryFinalstr[1]+');\">').replace(\"<font>\",'<font color=#4F94CD>').replace(\"###STR###\",aryFinalstr[1]);}else if(aryFinalstr[0]==5){finalres=gettext('The packet was sent via <a1><font>###STR1###</font></a> according to the ###CHAR### route \"###STR2###/###STR3### ###STR4###\"');if(''==0)sInterface=gettext('Static');else if(WANidx.charAt(0)=='V')sInterface=gettext('VPN');else if(WANidx.charAt(0)=='L')sInterface=gettext('LAN');else sInterface=gettext(\"default\");if('2927'!='2710'&&'2927'!='2120'&&'2927'!='2110'){if(WANidx.charAt(0)=='W')finalres=translateReplace2(finalres,'<a class=\"DenyToPage\" href=\"javascript:WanLink3('+WANaccmode[parseInt(WANidx.charAt(3))-1]+','+WANidx.charAt(3)+')\">');else if(WANidx.charAt(0)=='L')finalres=translateReplace2(finalres,'<a class=\"DenyToPage\" href=\"javascript:LanLink()\">');else finalres=translateReplace2(finalres,'<a class=\"DenyToPage\" href=\"javascript:VPNLink()\">');}else{if(WANidx.charAt(0)=='W'){if('2927'!='2120')finalres=translateReplace2(finalres,'<a class=\"DenyToPage\" href=\"javascript:WanLink1()\">');else finalres=translateReplace2(finalres,'<a class=\"DenyToPage\" href=\"javascript:WanLink1()\">');}else if(WANidx.charAt(0)=='L')finalres=translateReplace2(finalres,'<a class=\"DenyToPage\" href=\"javascript:LanLink()\">');else finalres=translateReplace2(finalres,'<a class=\"DenyToPage\" href=\"javascript:VPNLink()\">');}}else if(aryFinalstr[0]==6){finalres=gettext('The packet was dropped because the interface of the matched route \"###STR1###/###STR2### ###STR3###\"');finalres=finalres.replace(\"###STR1###\",aryFinalstr[1]).replace(\"###STR2###\",aryFinalstr[2]).replace(\"###STR3###\",aryFinalstr[3]);}else finalres=gettext('The packet was dropped because neither \"route\" or \