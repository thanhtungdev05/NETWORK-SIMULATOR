$(\"#confirmCancel\",confirmLayerOBJ).css( \"display\",\"none\" );\n$(\"#confirmOK\",confirmLayerOBJ).val(\"Back\");\n$(\"#confirmOK\",confirmLayerOBJ).unbind(\"click\").focus();\n$(\"#confirmOK\",confirmLayerOBJ).bind(\"click\", templateObj, function(event){\nshowWaitTip(false);\n});\n}\nelse{\nvar Head = templateObj.parents(\".HeadDIV\");\nvar ServerAddr = $(\"address span\", Head).text();\ndataPost(\"Apply\", \"fillDataByApplyResult\", ServerAddr, templateObj, undefined, true);\n}\n});\n}\nfunction disableSSID(SSIDAlias)\n{\nvar WLANSSIDHeadID = \"WLANSSIDConf\";\nvar WLANSSIDHead = $(\"#\"+WLANSSIDHeadID);\nWLANSSIDHead.find(\"[id^='template_\"+WLANSSIDHeadID+\"_']\").each(function(){\nvar obj = $(this);\nif($(\"[id^='Alias:']\",obj).val() == SSIDAlias)\n{\nobj.find(\"*\").not(\".collapsibleInst, img\").attr(\"disabled\",true);\n$(\"[id^='Btn_apply_WLANSSIDConf:']\",obj).addClass(\"disableBtn\");\n$(\"[id^='Btn_cancel_WLANSSIDConf:']\",obj).addClass(\"disableBtn\");\nreturn false;\n}\n});\n}\nfunction g_SmartWifi_SSID(xml)\n{\n}\nfunction g_GREHide_SSID(HeadObj,xml)\n{\n\n}\nfunction getBSCtrl(xml)\n{\nvar BSDisableSSID = \"\";\nvar BSEnable = getParaValueInXML(xml, \"OBJ_MAP_MASTER_ID\", 0, \"EnBandSteer\");\nif(BSEnable == \"1\")\n{\nBSDisableSSID = \"DEV.WIFI.AP5,DEV.WIFI.AP9\";\n}\nreturn BSDisableSSID;\n}\nfunction getMLOCtrl(xml)\n{\nvar MLODisableSSID = \"\";\nvar MLOEnable = getParaValueInXML(xml, \"OBJ_WLANMLO_ID\", 0, \"MloEnable\");\nvar MLOSSID = getParaValueInXML(xml, \"OBJ_WLANMLO_ID\", 0, \"MLOSSID\");\nif(MLOEnable == \"1\")\n{\nif(MLOSSID == \"1\"){\nMLODisableSSID = \"DEV.WIFI.AP5,DEV.WIFI.AP9\"\n}else if(MLOSSID == \"2\"){\nMLODisableSSID = \"DEV.WIFI.AP6,DEV.WIFI.AP10\"\n}else if (MLOSSID == \"3\"){\nMLODisableSSID = \"DEV.WIFI.AP7,DEV.WIFI.AP11\"\n}else if (MLOSSID == \"4\"){\nMLODisableSSID = \"DEV.WIFI.AP8,DEV.WIFI.AP12\"\n}\n}\nreturn MLODisableSSID;\n}\nfunction g_CtrlSSIDConf(HeadObj,xml)\n{\nvar ctrlStr = \"\";\nvar ctrlStr2 = \"\";\nvar ctrFlag = \"\";\nif(ssidConf.disableSSID != undefined)\n{\nctrlStr = ssidConf.disableSSID;\n}\nelse\n{\nctrlStr = getBSCtrl(xml);\nctrlStr2 = getMLOCtrl(xml);\n}\nif(ctrlStr == \"\" && ctrlStr2 == \"\")\n{\nreturn;\n}\nif(ctrlStr.indexOf(\":\") != -1)\n{\nvar ruleList = ctrlStr.split(\":\");\nctrlStr = ruleList[0];\nctrFlag = ruleList[1];\n}\nvar DisableSSIDArr = ctrlStr.split(\",\");\nvar MLOArr = ctrlStr2.split(\",\");\nDisableSSIDArr = DisableSSIDArr.concat(MLOArr);\n$(\"[id^='template_WLANSSIDConf_']\", HeadObj).each(function(){\nif(ctrlStr == \"all\" || DisableSSIDArr.indexOf($(\"[id^='_InstID:']\", this).val())>-1)\n{\n$(this).find(\"*\").not(\".collapsibleInst,img\").attr(\"disabled\",true);\n$(\"[class^='Button']\", this).addClass(\"disableBtn\");\n$(\"[id^='Btn_cancel_'],[id^='Btn_apply_']\", this).unbind();\nif(ctrFlag == \"hideBtn\")\n{\n$(\"[id^='Btn_cancel_'],[id^='Btn_apply_']\", this).showIt(false);\n}\n}\n});\n}\nfunction g_GuestWIFIConf(HeadObj){\nvar GuestWIFI = \"\";\nif (GuestWIFI ==\"\"){\nreturn;\n}\nvar GuestWIFIArr = GuestWIFI.split(\",\");\nif(GuestWIFIArr.indexOf($(\"[id^='_InstID:']\", HeadObj).val())>-1){\n$(\"[id^='div_guestAccessTime']\", HeadObj).show();\n}\n}\nfunction g_WlanEncryptionTypeOptionCtrl(template)\n{\nvar EncryptionTypeOBJ = $(\"#EncryptionType\", template);\nif ((ssidEncryJson==\"\") || (typeof ssidEncryJson!='object')) {\nreturn;\n}\nvar value2Name = {\n\"No Security\" : \"No Security\",\n\"WPA2-PSK-AES\" : \"WPA2-PSK-AES\",\n\"WPA/WPA2-PSK-TKIP/AES\" : \"WPA/WPA2-PSK-TKIP/AES\",\n\"WPA-PSK-TKIP\" : \"WPA-PSK-TKIP\",\n\"WPA-PSK-AES\" : \"WPA-PSK-AES\",\n\"WPA-PSK-TKIP/AES\" : \"WPA-PSK-TKIP/AES\",\n\"WPA2-PSK-TKIP\" : \"WPA2-PSK-TKIP\",\n\"WPA2-PSK-TKIP/AES\" : \"WPA2-PSK-TKIP/AES\",\n\"WPA/WPA2-PSK-TKIP\" : \"WPA/WPA2-PSK-TKIP\",\n\"WEP-OpenSystem\" : \"WEP-OpenSystem\",\n\"WEP-ShareKey\" : \"WEP-SharedKey\",\n\"WPA-EAP-TKIP\" : \"WPA-EAP-TKIP\",\n\"WPA2-EAP-AES\" : \"WPA2-EAP-AES\",\n\"WPA/WPA2-EAP-TKIP/AES\" : \"WPA/WPA2-EAP-TKIP/AES\",\n\"WPA/WPA2-EAP-AES\" : \"WPA/WPA2-EAP-AES\",\n\"WPA2-PSK-AES/WPA3-SAE-AES\" : \"WPA2-PSK/WPA3-SAE-AES\",\n\"WPA2/WPA3-SAE\" : \"WPA2-PSK(TKIP/AES)/WPA3(SAE)\",\n\"WPA3-SAE\" : \"WPA3(SAE)\",\n\"WPA3-OWE\" : \"WPA3-OWE\",\n\"WPA/WPA2/WPA3-PSK/SAE\" : \"WPA/WPA2-PSK(TKIP/AES)/WPA3(SAE)\"\n}\nif(ssidEncryJson[0]==\"ADD\")\n{\nssidEncryJson.shift();\naddEncryptionTypeOption(ssidEncryJson,EncryptionTypeOBJ,value2Name);\n}\nelse\n{\nEncryptionTypeOBJ.empty();\naddEncryptionTypeOption(ssidEncryJson,EncryptionTypeOBJ,value2Name);\n}\n}\nfunction addEncryptionTypeOption(ssidEncryJson,EncryptionTypeOBJ,value2Name)\n{\nfor(var i=0; i<ssidEncryJson.length; i++){\nEncryStr = ssidEncryJson[i];\nvar EncryList = EncryStr.split(\":\");\nif(EncryList[1] == undefined) {\nEncryList[1] = \"\";\n}\nif(checkRight(EncryList[1]) == false){\ncontinue;\n}\nvar langStr = value2Name[EncryList[0]];\nif(langStr != undefined){\nvar optionStr = \"<option value ='\"+EncryList[0]+\"' title='\"+langStr+\"'>\"+langStr+\"</option>\";\nEncryptionTypeOBJ.append(optionStr);\n}\n}\n}\nfunction containsObj(object1,object2){\nfor (var index in object2 ) {\nif (object2[index] != object1[index]) {\nreturn false;\n}\n}\nreturn true;\n}\nfunction g_getEncryptionType(tempObj){\nvar BeaconType = $(\"[id^='BeaconType']\", tempObj).val();\nif(BeaconType == \"\"){\nBeaconType = $(\"[id^='BeaconType']\", tempObj).text();\n}\nvar WEPAuthMode = $(\"[id^='WEPAuthMode']\", tempObj).val();\nvar WPAAuthMode = $(\"[id^='WPAAuthMode']\", tempObj).val();\nvar WPA3AuthMode = $(\"[id^='WPA3AuthMode']\", tempObj).val();\nvar WPA3EncryptType = $(\"[id^='WPA3EncryptType']\", tempObj).val();\nvar _11iAuthMode = $(\"[id^='11iAuthMode']\", tempObj).val();\nvar WPAEncryptType = $(\"[id^='WPAEncryptType']\", tempObj).val();\nvar _11iEncryptType = $(\"[id^='11iEncryptType']\", tempObj).val();\nvar EncryptionObject = new Object();\nEncryptionObject.BeaconType = BeaconType;\nEncryptionObject.WEPAuthMode = WEPAuthMode;\nEncryptionObject.WPAAuthMode = WPAAuthMode;\nEncryptionObject.WPA3AuthMode = WPA3AuthMode;\nEncryptionObject.WPA3EncryptType = WPA3EncryptType;\nEncryptionObject[\"11iAuthMode\"] = _11iAuthMode;\nEncryptionObject.WPAEncryptType = WPAEncryptType;\nEncryptionObject[\"11iEncryptType\"] = _11iEncryptType;\nfor (var key in EncryptionParameter) {\nvar containFlag = containsObj(EncryptionObject,EncryptionParameter[key]);\nif (containFlag) {\nbreak;\n}\n}\nreturn key;\n}\nfunction g_fillEncryptType(tempObj){\nvar EncryptionTypeVal = g_getEncryptionType(tempObj);\n$(\"[id^='EncryptionType']\", tempObj).val(EncryptionTypeVal);\n}\nfunction g_showPass(srcObj, tObjId){\nvar TypeOBJ = (srcObj);\nvar ParentObj = TypeOBJ.closest(\".formTbl\");\nvar KeyPassphrasePassObj = $(\"[id^=\"+tObjId+\"][type='password']\",ParentObj);\nvar KeyPassphraseTextObj = $(\"[id^=\"+tObjId+\"][type='text']\",ParentObj);\nif(TypeOBJ.attr(\"src\") == \"../img/sleeping.png\")\n{\nTypeOBJ.attr(\"src\", \"../img/awaking.png\").attr(\"alt\",\"Hide Password\");\n$(\"[id^=\"+tObjId+\"][type='password']\",ParentObj).hide();\n$(\"[id^=\"+tObjId+\"][type='password']\",ParentObj).attr(\"class\",\"PostIgnore\");\n$(\"[id^=\"+tObjId+\"][type='text']\",ParentObj).attr(\"class\",\"w280\");\n$(\"[id^=\"+tObjId+\"][type='text']\",ParentObj).show();\nKeyPassphraseTextObj.val(KeyPassphrasePassObj.val());\n}\nelse\n{\nTypeOBJ.attr(\"src\", \"../img/sleeping.png\").attr(\"alt\",\"Show Password\");\n$(\"[id^=\"+tObjId+\"][type='password']\",ParentObj).attr(\"style\",\"width: 280px;font-family: text-security-disc;\");\n$(\"[id^=\"+tObjId+\"][type='password']\",ParentObj).attr(\"class\",\"valid\");\n$(\"[id^=\"+tObjId+\"][type='text']\",ParentObj).hide();\n$(\"[id^=\"+tObjId+\"][type='text']\",ParentObj).attr(\"class\",\"PostIgnore\");\nKeyPassphrasePassObj.val(KeyPassphraseTextObj.val());\n}\n}\nfunction g_EncryptionTypeAuxCtrlsDisp(tempObj)\n{\nvar EncryptionType = $(\"[id^='EncryptionType']\", tempObj).val();\n$(\".div_MasterAuthServerIP\", tempObj).hide();\n$(\".div_MasterAuthServerPort\", tempObj).hide();\n$(\".div_MasterAuthServerSecret\", tempObj).hide();\nif ( EncryptionType == \"No Security\"\n|| EncryptionType == \"WPA3-OWE\")\n{\n$(\"[id^='div_KeyPassphrase']\", tempObj).hide();\n$(\"[id^='div_WPAGroupRekey']\", tempObj).hide();\n$(\"[id^='div_ShowKeyPassphrase']\", tempObj).hide();\n$(\"[id^='_PSKCONIG']\", tempObj).val(\"N\");\n$(\"[id^='div_WEPKey0']\", tempObj).hide();\n$(\"[id^='div_WEPKeyIndex']\", tempObj).hide();\n$(\"[id^='div_ShowWEPKey']\", tempObj).hide();\n$(\"[id^='_WEPCONIG']\", tempObj).val(\"N\");\n}\nelse if ( EncryptionType == \"WPA-PSK-TKIP\"\n|| EncryptionType == \"WPA2-PSK-AES\"\n|| EncryptionType == \"WPA/WPA2-PSK-TKIP/AES\"\n|| EncryptionType == \"WPA-PSK-AES\"\n|| EncryptionType == \"WPA-PSK-TKIP/AES\"\n|| EncryptionType == \"WPA2-PSK-TKIP\"\n|| EncryptionType == \"WPA2-PSK-TKIP/AES\"\n|| EncryptionType == \"WPA/WPA2-PSK-TKIP\"\n|| EncryptionType == \"WPA/WPA2-PSK-AES\"\n|| EncryptionType == \"WPA3-SAE\"\n|| EncryptionType == \"WPA/WPA2/WPA3-PSK/SAE\"\n|| EncryptionType == \"WPA2/WPA3-SAE\"\n|| EncryptionType == \"WPA2-PSK-AES/WPA3-SAE-AES\")\n{\n$(\"[id^='div_KeyPassphrase']\", tempObj).show();\n$(\"[id^='div_WPAGroupRekey']\", tempObj).show();\n$(\"[id^='div_ShowKeyPassphrase']\", tempObj).show();\n$(\"[id^='_PSKCONIG']\", tempObj).val(\"Y\")\n$(\"[id^='div_WEPKey0']\", tempObj).hide();\n$(\"[id^='div_WEPKeyIndex']\", tempObj).hide();\n$(\"[id^='div_ShowWEPKey']\", tempObj).hide();\n$(\"[id^='_WEPCONIG']\", tempObj).val(\"N\");\n}\nelse if ( EncryptionType == \"WEP-OpenSystem\"\n|| EncryptionType == \"WEP-ShareKey\" )\n{\n$(\"[id^='div_KeyPassphrase']\", tempObj).hide();\n$(\"[id^='div_WPAGroupRekey']\", tempObj).hide();\n$(\"[id^='div_ShowKeyPassphrase']\", tempObj).hide();\n$(\"[id^='_PSKCONIG']\", tempObj).val(\"N\");\n$(\"[id^='div_WEPKey0']\", tempObj).show();\n$(\"[id^='div_WEPKeyIndex']\", tempObj).show();\n$(\"[id^='div_ShowWEPKey']\", tempObj).show();\n$(\"[id^='_WEPCONIG']\", tempObj).val(\"Y\");\n}\nelse if( EncryptionType == \"WPA2-EAP-AES\"\n|| EncryptionType == \"WPA/WPA2-EAP-TKIP/AES\"\n|| EncryptionType == \"WPA-EAP-TKIP\"\n|| EncryptionType == \"WPA/WPA2-EAP-AES\")\n{\n$(\"[id^='div_KeyPassphrase']\", tempObj).hide();\n$(\".div_MasterAuthServerIP\", tempObj).show();\n$(\".div_MasterAuthServerPort\", tempObj).show();\n$(\".div_MasterAuthServerSecret\", tempObj).show();\n$(\"[id^='_PSKCONIG']\", tempObj).val(\"N\")\n$(\"[id^='div_WEPKey0']\", tempObj).hide();\n$(\"[id^='div_WEPKeyIndex']\", tempObj).hide();\n$(\"[id^='div_ShowWEPKey']\", tempObj).hide();\n$(\"[id^='_WEPCONIG']\", tempObj).val(\"N\");\n}\nelse\n{\n}\n}\nfunction g_InitialEncryptionEvent(template)\n{\n$(\"#ShowWEPKey\",template).change(function(event){\nvar TypeOBJ = $(this);\nvar ParentObj = TypeOBJ.closest(\".formTbl\");\nvar WEPKey00PassObj = $(\"[id^='WEPKey00'][type='password']\",ParentObj);\nvar WEPKey00TextObj = $(\"[id^='WEPKey00'][type='text']\",ParentObj);\nvar WEPKey01PassObj = $(\"[id^='WEPKey01'][type='password']\",ParentObj);\nvar WEPKey01TextObj = $(\"[id^='WEPKey01'][type='text']\",ParentObj);\nvar WEPKey02PassObj = $(\"[id^='WEPKey02'][type='password']\",ParentObj);\nvar WEPKey02TextObj = $(\"[id^='WEPKey02'][type='text']\",ParentObj);\nvar WEPKey03PassObj = $(\"[id^='WEPKey03'][type='password']\",ParentObj);\nvar WEPKey03TextObj = $(\"[id^='WEPKey03'][type='text']\",ParentObj);\nif(TypeOBJ.is(':checked'))\n{\n$(\"[id^='WEPKey0'][type='password']\",ParentObj).attr(\"style\",\"display:none\");\n$(\"[id^='WEPKey0'][type='password']\",ParentObj).attr(\"class\",\"PostIgnore\");\n$(\"[id^='WEPKey0'][type='text']\",ParentObj).attr(\"style\",\"\");\n$(\"[id^='WEPKey0'][type='text']\",ParentObj).attr(\"class\",\"w280\");\nWEPKey00TextObj.val(WEPKey00PassObj.val());\nWEPKey01TextObj.val(WEPKey01PassObj.val());\nWEPKey02TextObj.val(WEPKey02PassObj.val());\nWEPKey03TextObj.val(WEPKey03PassObj.val());\n}\nelse\n{\n$(\"[id^='WEPKey0'][type='password']\",ParentObj).attr(\"style\",\"width: 280px\");\n$(\"[id^='WEPKey0'][type='password']\",ParentObj).attr(\"class\",\"inputNorm valid\");\n$(\"[id^='WEPKey0'][type='text']\",ParentObj).attr(\"style\",\"display:none\");\n$(\"[id^='WEPKey0'][type='text']\",ParentObj).attr(\"class\",\"PostIgnore\");\nWEPKey00PassObj.val(WEPKey00TextObj.val());\nWEPKey01PassObj.val(WEPKey01TextObj.val());\nWEPKey02PassObj.val(WEPKey02TextObj.val());\nWEPKey03PassObj.val(WEPKey03TextObj.val());\n}\n});\n$(\"#ShowKeyPassphrase\", template).bind(\"click\",function(){\ng_showPass($(this), \"KeyPassphrase\");\n});\n$(\"#ShowMasterAuthServerSecret\", template).bind(\"click\",function(){\ng_showPass($(this), \"MasterAuthServerSecret\");\n});\n}\n\n$(document).ready(function(){\nvar WLANStatusHeadID = \"WLANStatus\";\nvar WLANStatusHead = $(\"#\"+WLANStatusHeadID);\nvar WLANStatusServerAddr = $(\"address span\", WLANStatusHead).text();\nvar template = $(\"#template_\"+ WLANStatusHeadID);\ntemplate.bind(\"fillDataByClearResult\",function(event, xml, template){\n$(\"#WLANStatus_Btn_refresh\").click();\n});\n$(\"#WLANStatus_Btn_clear\", WLANStatusHead).bind(\"click\",{templateOBJ:template}, function(event){\nvar buttonOBJ = $(this);\nvar template = event.data.templateOBJ;\nvar action = \"WLAN_CLEAR\";\ndataPost(action, \"fillDataByClearResult\", WLANStatusServerAddr, template);\n});\nWLANStatusHead.succfunction = function(xml){\nWLANStatusHead.findBandOfSSID = function(template, xml)\n{\nvar CardInstID = $(\"[id^='WLANViewName:']\", template).val();\nvar OBJ = \"OBJ_WLANSETTING_ID\";\nvar WLANSettingXML = $(xml).find(OBJ);\nvar cardInsts = WLANSettingXML.find(\"Instance\");\nvar cardNum = cardInsts.length;\nvar band = \"\";\nfor ( var i=0; i<cardNum; i++ )\n{\nvar ToOperParaArray = {\n\"_InstID\" : {\nValueOrigin: \"\"\n},\n\"Band\" : {\nValueOrigin: \"\"\n}\n};\nxmlParaInInstOperate(xml, OBJ, i, ToOperParaArray);\nvar instid = ToOperParaArray[\"_InstID\"].ValueOrigin;\nif ( instid == CardInstID )\n{\nband = ToOperParaArray[\"Band\"].ValueOrigin;\nbreak;\n}\n}\nif ( band != \"\" )\n{\nband = \" (\"+band+\")\";\n}\nreturn band;\n}\nWLANStatusHead.fillDataByCustom = function(suffix,ContainerOBJ){\nvar ssidOBJ = ContainerOBJ.find(\"[id^='_InstID']\");\nvar Alias = $(\"[id^='Alias']\", ContainerOBJ).val();\nvar band = WLANStatusHead.findBandOfSSID(ContainerOBJ, xml);\nssidOBJ.text(Alias+band);\nssidOBJ.attr(\"title\", ssidOBJ.text());\nvar enabelOBJ = ContainerOBJ.find(\"[id^='Enable']\");\nvar enaValue = enabelOBJ.text();\nif (enaValue == 1)\n{\nenabelOBJ.text(\"On\");\nenabelOBJ.attr(\"title\", \"On\");\n}\nelse\n{\nenabelOBJ.text(\"Off\");\nenabelOBJ.attr(\"title\", \"Off\");\n}\nvar beaconTypeVal = g_getEncryptionType(ContainerOBJ);\n$(\"[id^='BeaconType']\", ContainerOBJ).text(beaconTypeVal);\n$(\"[id^='BeaconType']\", ContainerOBJ).attr(\"title\", beaconTypeVal);\nvar TotalPacketsReceived = $(\"[id^='TotalPacketsReceived']\", ContainerOBJ).val();\nvar TotalPacketsSent = $(\"[id^='TotalPacketsSent']\", ContainerOBJ).val();\nvar TotalPacketsCount = TotalPacketsReceived+\"/\"+TotalPacketsSent;\nvar tpcObj = $(\"[id^='TotalPacketsCount']\", ContainerOBJ);\ntpcObj.text(TotalPacketsCount);\ntpcObj.attr(\"title\", TotalPacketsCount);\nvar TotalBytesReceived = $(\"[id^='TotalBytesReceived']\", ContainerOBJ).val();\nvar TotalBytesSent = $(\"[id^='TotalBytesSent']\", ContainerOBJ).val();\nvar TotalBytesCount = TotalBytesReceived+\"/\"+TotalBytesSent;\nvar tbcObj = $(\"[id^='TotalBytesCount']\", ContainerOBJ);\ntbcObj.text(TotalBytesCount);\ntbcObj.attr(\"title\", TotalBytesCount);\n};\nWLANStatusHead.hasError(xml,\"externErrorHint\");\nvar SSIDOBJ = $(xml).find(\"OBJ_WLANAP_ID\");\nvar RuleNum = $(\"Instance\", SSIDOBJ).length;\nvar OBJID = [\"OBJ_WLANAP_ID\", \"OBJ_WLANCONFIGDRV_ID\"];\nWLANStatusHead.createPageDataByClone(RuleNum,OBJID,xml,WLANStatusHead.fillDataByCustom);\ncolorTblRow(\".colorTbl\", \"even\", WLANStatusHead);\nWLANStatusHead.fillDataOfCard = function(clone, xml) {\nvar location = $(\"[id^='\"+ name + \"']\", clone);\nvar CardInstID = $(\"[id^='_InstID_']\", clone).val();\nvar OBJ = \"OBJ_WLANCONFIGDRV_ID\";\nvar driverInsts = $(xml).find(\"OBJ_WLANCONFIGDRV_ID\").find(\"Instance\");\nvar driverInstNum = driverInsts.length;\nvar ChannelInUsed;\nvar RealRF;\nfor ( var i=0; i<driverInstNum; i++ )\n{\nvar ToOperParaArray = {\n\"WLANViewName\" : { ValueOrigin: \"\" },\n\"RealRF\" : { ValueOrigin: \"\" },\n\"ChannelInUsed\" : { ValueOrigin: \"\" },\n};\nxmlParaInInstOperate(xml, OBJ, i, ToOperParaArray);\nvar instid = ToOperParaArray[\"WLANViewName\"].ValueOrigin;\nif ( instid == CardInstID )\n{\nChannelInUsed = ToOperParaArray[\"ChannelInUsed\"].ValueOrigin;\nRealRF = ToOperParaArray[\"RealRF\"].ValueOrigin;\nbreak;\n}\n}\nif (ChannelInUsed == \"0\")\n{\nChannelInUsed = \"N/A\";\n}\nvar ciuObj = $(\"[id^='ChannelInUsed_']\", clone);\nciuObj.text(ChannelInUsed);\nciuObj.attr(\"title\", ChannelInUsed);\nif ( RealRF == \"1\" )\n{\nRealRF = \"On\";\n}\nelse\n{\nRealRF = \"Off\";\n}\nvar rfObj = $(\"[id^='RealRF_']\", clone);\nrfObj.text(RealRF);\nrfObj.attr(\"title\", RealRF);\n};\nif (WLANStatusHead.hasError(xml) == 0)\n{\n$(\"[id^='div_WLANRadioSta_']\", WLANStatusHead).each(function(){\n$(this).remove();\n})\n;\nvar ruleTemplate = $(\"#div_WLANRadioSta\",WLANStatusHead);\nvar OBJ = $(xml).find(\"OBJ_WLANSETTING_ID\");\nvar RuleNum = $(\"Instance\", OBJ).length;\nfor (var i=0; i<RuleNum; i++)\n{\nvar clone = ruleTemplate.cloneWithSuffix(i, \"_\");\nruleTemplate.before(clone);\nvar DataOBJID = [\"OBJ_WLANSETTING_ID\"];\nclone.fillDataByOBJID(xml, DataOBJID, clone, i, \"_\");\nvar Band = $(\"[id^='Band']\",clone).val();\nvar radioNewName = \"WLAN (\" + Band +\")\";\nvar titleRealRF = $(\"[id^='titleRealRF_\"+i+\"']\");\ntitleRealRF.text(radioNewName);\ntitleRealRF.attr(\"title\", radioNewName);\nvar radioNewName = \"Channel (\" + Band +\")\";\nvar titleChannelInUsed = $(\"[id^='titleChannelInUsed_\"+i+\"']\");\ntitleChannelInUsed.text(radioNewName);\ntitleChannelInUsed.attr(\"title\", radioNewName);\nif (i/2 != 0)\n{\nclone.addClass(\"colorRow\");\n}\nWLANStatusHead.fillDataOfCard(clone, xml);\nclone.showIt(true);\n}\n}\nvar data = {};\ndata.HEAD = WLANStatusHead\n$.callModifier(\"WLANStatus/SSIDInfoCustom\",data)\n};\nif ( $(\".collapBarWithDataTrans\",WLANStatusHead).length <= 0 )\n{\nWLANStatusHead.dataTransfer(WLANStatusServerAddr, \"GET\", WLANStatusHead.succfunction);\n}\nelse\n{\ninitial_collapBarWithDataTrans(WLANStatusHead);\n}\nRefreshClickHandle(WLANStatusHead);\n});\n})();\n</script>\n\n<div id=\"WLANStatus\" class=\"HeadDIV\">\n<address style=\"display:none\">\n<span class=\"form-action\">/?_type=menuData&_tag=wlan_wlanstatus_lua.lua</span>\n</address>\n<div class=\"externErrorHint\" style=\"display:none;\">\n<span class=\"caption1\"></span>\n</div>\n<h1 class=\"collapBarWithDataTrans\" id=\"WLANStatusBar\">WLAN Status</h1>\n<div id=\"WLANStatus_container\">\n<div class=\"errorHint\" style=\"display:none;\">\n<span class=\"caption1\"></span>\n</div>\n<div class=\"colorTbl\">\n<div class=\"colorTblRow emFont titleRow\">\n<span class=\"w200 emFont\" title=\"WLAN Basic Status\">WLAN Basic Status</span>\n</div>\n<div id=\"div_WLANRadioSta\" class=\"colorTblRow\" style=\"display:none;\">\n<span class=\"w130 emFont\" id=\"titleRealRF\" title=\"WLAN\">WLAN</span>\n<span class=\"w180\" id=\"RealRF\" title=\"\"></span>\n<span class=\"w200 emFont\" id=\"titleChannelInUsed\" title=\"Channel\">Channel</span>\n<input type=\"hidden\" id=\"Band\" class=\"PostIgnore\" value=\"\">\n<input type=\"hidden\" id=\"_InstID\" class=\"PostIgnore\" value=\"\">\n<span class=\"w150\" id=\"ChannelInUsed\" title=\"\"></span>\n</div>\n</div>\n<input type=\"hidden\" id=\"DataHasBeenGot\" value=\"0\">\n<div id=\"template_WLANStatus\" class=\"colorTbl\" style=\"display:none;\">\n<form class=\"colorTbl form_content\">\n<input type=\"hidden\" id=\"TotalPacketsReceived\" va