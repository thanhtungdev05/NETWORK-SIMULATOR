</textarea><form action=/cgi-bin/enet.cgi method=post name=frm1><table align=center border=0 cellpadding=0 cellspacing=0 width=800px><script> var sMLSubnet='1';</script><tr><td><b parent="{{ 'LAN' | translate }}" sub-title translate>General Setup</b><hr><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td class=offtab id=tab1 onClick=dhtml.cycleTab(this.id);parent.sLanGenStatusTag=this.id; width=40%><b><script>var iOPModem_mode='0';var str="";if(sMLSubnet==1)str+=gettext("LAN")+" 1 ";str+=gettext("Ethernet TCP / IP");if(iOPModem_mode!=1)str+=" "+gettext("and")+" "+gettext("DHCP");str+=" "+gettext("Setup");document.write(str);</script></b></td><td class=offtab id=tab2 onClick=dhtml.cycleTab(this.id);parent.sLanGenStatusTag=this.id; style=display:none width=40%><b><translate>LAN</translate> 1 <translate>IPv6 Setup</translate></b></td><td class=tabpadding width=20%>&nbsp;</td></tr></table><div id=page1 style=display:none><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td valign=top width=50%><table align=center border=0 cellpadding=1 cellspacing=0 width=100%><tr><td colspan=2><b><script>if(sMLSubnet!=1)document.write(gettext("LAN IP")+" ");</script><translate>Network Configuration</translate></b></td></tr><tr class=ip1Sub style=display:none><td colspan=2 translate>For NAT Usage</td></tr><tr class=ip2Sub style=display:none><td><input name=sRot1IPSub type=radio value=1><translate>For NAT Mode</translate></td><td><input name=sRot1IPSub type=radio value=0><translate>For IP Routing Mode</translate></td></tr><tr><td width=50%>&nbsp;&nbsp;&nbsp;<span class=sndSubnet style=display:none><translate>1st</translate>&nbsp;</span><translate>IP Address</translate></td><td width=50%><input maxlength=15 name=sLanIp type=text value="192.168.1.1"></td></tr><tr><td width=50%>&nbsp;&nbsp;&nbsp;<span class=sndSubnet style=display:none><translate>1st</translate>&nbsp;</span><translate>Subnet Mask</translate></td><td width=50%><select name=sLanMask></select></td></tr><tr id=lanipalisa style=display:none><td colspan=2>&nbsp;&nbsp;&nbsp;<input onclick=onClkLANAlias() type=button value="{{ 'LAN IP Alias' | translate }}"></td></tr><tr ng-if=bPSTNTrunk><td width=50%>&nbsp;&nbsp;&nbsp;<translate>Voip Module Address</translate></td><td width=50%><input maxlength=15 name=sVoMoAdd type=text value="(nil)"></td></tr><tr ng-if=bPSTNTrunk><td colspan=2>&nbsp;&nbsp;&nbsp;<font color=red translate>Notices: VoIP module must be at the same subnet with 1st IP address.</font></td></tr><tr class=sndSubnet style=display:none><td colspan=2><translate>For IP Routing Usage</translate><input  name=i2ndIP onclick=IPRtUg() type=radio value=1>&nbsp;<translate>Enable</translate><input  checked name=i2ndIP onclick=IPRtUg() type=radio value=0>&nbsp;<translate>Disable</translate></td></tr><tr class=sndSubnet style=display:none><td width=50%>&nbsp;&nbsp;&nbsp;<translate>2nd IP Address</translate></td><td width=50%><input maxlength=15 name=sLanIp2nd type=text value="192.168.0.1"></td></tr><tr class=sndSubnet style=display:none><td width=50%>&nbsp;&nbsp;&nbsp;<translate>2nd Subnet Mask</translate></td><td width=50%><input maxlength=15 name=sLanMask2nd type=text value="255.255.255.0"></td></tr><tr class=sndSubnet style=display:none><td align=right colspan=2><input name=btnAdv onclick=adv() type=button value="{{ '2nd Subnet DHCP Server' | translate }}"></td></tr><tr class=ip2Rot style=display:none><td colspan=2><translate>For 2 IP Routing Usage</translate><input name=sRot2IPSub type=radio value=1>&nbsp;<translate>Enable</translate><input name=sRot2IPSub type=radio value=0>&nbsp;<translate>Disable</translate></td></tr><tr class=ip2Rot style=display:none><td width=50%> &nbsp;&nbsp;<translate>IP Address</translate></td></tr><tr class=ip2Rot style=display:none><td width=50%> &nbsp;&nbsp;<translate>Subnet Mask</translate></td></tr><tr class=rip style=display:none><td colspan=2><hr></td></tr><tr class=rip style=display:none><td translate width=50%>RIP Protocol Control</td><td width=50%><select name=iRIPLAN size=1><option selected translate value=0>Disable</option><script>if(sMLSubnet||(iOPModem_mode==1))document.writeln('<option  value="2">{{ "Enable" | translate }}</option>');else document.writeln('<option  value="2">{{ "1st Subnet" | translate }}</option>\n<option  value="1">{{ "2nd Subnet" | translate }}</option>');</script></select></td></tr></table></td><td valign=top width=50%><table align=center border=0 cellpadding=1 cellspacing=0 class=opModem width=100%><tr><td colspan=2><b translate>DHCP Server Configuration</b></td></tr><tr><td colspan=2><input name=sDHCP onclick=fstDhcp(0) type=radio value=0><translate>Disable</translate><input name=sDHCP onclick=fstDhcp(1) type=radio value=1><translate>Enable Server</translate><span id="mlsubnet_dhcpRelay" style="display:none"><input name=sDHCP onclick=fstDhcp(4) type=radio value=4><translate>Enable Relay Agent</translate></span></td></tr><tr id=dhcpRelay style=display:none><td colspan=2><translate>Relay Agent</translate>:<input name=sDHCP onclick=fstDhcp(2) type=radio value=2><translate>1st Subnet</translate><span class=sndSubnet style=display:none><input name=sDHCP onclick=fstDhcp(3) type=radio value=3><translate>2nd Subnet</translate></span></td></tr><tr class=dhcp_relay style=display:none><td translate width=50%>1st DHCP Server IP Address</td><td><input maxlength=15 name=sRlyServIp size=18 type=text value=""></td></tr><tr class=dhcp_relay style=display:none><td translate width=50%>2nd DHCP Server IP Address</td><td><input maxlength=15 name=sRlyServIp2 size=18 type=text value=""></td></tr><tr class=dhcpserver style=display:none><td translate>Start IP Address</td><td><input maxlength=15 name=sDHCPStIP size=18 type=text value="192.168.1.10"></td></tr><tr class=dhcpserver style=display:none><td translate>IP Pool Counts</td><td><input maxlength=4 name=iDHCPNo size=4 type=text value="200"> (<translate>max</translate>. 1021) </td></tr><tr class=dhcpserver style=display:none><td translate>Gateway IP Address</td><td><input maxlength=15 name=sDHCPGwIP size=18 type=text value="192.168.1.1"></td></tr><script>var enetinitScript=document.createElement('script');enetinitScript.text=document.getElementById("enetinit").value;document.head.appendChild(enetinitScript);var str="";if(aryHA[0]==1){str+="<tr class=\"dhcpserver\" style=\"display:none\"><td colspan=2>&nbsp;&nbsp;("+gettext("Replaced by HA Virtual IP")+" "+aryHA[1];str+=")</td></tr>";}document.write(str);</script><tr class=dhcpserver style=display:none><td translate>Lease Time</td><td><input maxlength=15 name=sDHCPLsTime size=18 type=text value="86400"><translate>(s)</translate></td></tr><tr class=ml_dhcpserver style=display:none><td colspan=2><input name=chkrmclnts type=checkbox value=1>&nbsp;<translate>Clear DHCP lease for inactive clients periodically</translate></td></tr><tr class=dhcpopt style=display:none><td colspan=2><input name=btnDHCPOpt onClick=onclkDHCPOpt() type=button value="{{ 'Advanced' | translate }}"><translate>You can configure DHCP server options here.</translate></td></tr><tr class=chtmod style=display:none><td colspan=2><hr></td></tr><tr class=chtmod style=display:none><td colspan=2><b translate>DNS Server IP Address</b></td></tr><tr class=chtmod style=display:none><td translate>Primary IP Address</td><td><input maxlength=15 name=sDNSPri size=18 type=text value=""></td></tr><tr class=chtmod style=display:none><td translate>Secondary IP Address</td><td><input maxlength=15 name=sDNSSnd size=18 type=text value=""></td></tr><tr class=chtmod2 style=display:none><td colspan=2><input name=chkFrcDns type=checkbox>&nbsp;<translate>Force router to use address for DNS</translate></td></tr></table></td></tr></table><table align=center id=HAnote style=display:none width=100%><tr><td id=link_note valign=top><b translate>Note</b>:<ol><li translate>Change IP Address or Subnet Mask in Network Configuration will also change <a>HA</a> LAN1 Virtual IP to the same domain IP.</li></ol></td></tr></table></div><div id=page2 style=display:none><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><br><table align=center border=0 cellpadding=2 cellspacing=0 width=95%><tr><td><input name=enipv6 onclick=onclkEnIPv6(this.checked) type=checkbox value=1>&nbsp;<b translate>Enable IPv6</b></td></tr><tr><td><b translate>WAN Primary Interface</b>&nbsp;&nbsp;<select name=wanpriinf size=1><option translate value=0>None</option></select></td></tr></table><table align=center border=1 cellpadding=2 cellspacing=0 style=display:none width=95%><tr><td><table align=center border=0 cellpadding=1 cellspacing=0 width=95%><tr><td><b translate>Router Advertisement Server</b></td></tr><tr><td><input  name=iRadvdEnable type=radio value=0><translate>Enable</translate>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <input checked name=iRadvdEnable type=radio value=1><translate>Disable</translate></td></tr><tr><td>&nbsp;&nbsp;<translate>Advertisement Lifetime</translate><input maxlength=4 name=iAdvLftime size=5 type=text value="1800">&nbsp;<translate>Seconds</translate> (<translate>Range</translate> : 600 - 9000)</td></tr></table></td></tr></table><br><table align=center border=1 cellpadding=2 cellspacing=0 width=95%><tr><td><table align=center border=0 cellpadding=1 cellspacing=0 width=95%><tr><td colspan=2><b translate>Static IPv6 Address</b></td></tr><tr><td style="padding-left: 8px;" translate>IPv6 Address</td><td align=left><span style="padding: 5px;">/</span><translate>Prefix Length</translate></td></tr><tr><td><input maxlength=128 name=sStaticIPv6Addr style="margin-left: 8px; width: 390px;" type=text></td><td align=left width=42%><span style="padding: 5px;">/</span><input maxlength=3 name=sStaticIPv6Prefix size=3 type=text>&nbsp; <input name=sStaticIPv6Scope type=hidden><input name=btnAdd onclick=onClkBtnAdd() type=button value="{{ 'Add' | translate }}">&nbsp; <input class=btnw name=btnDel onclick=onClkBtnDel() type=button value="{{ 'Delete' | translate }}"></td></tr><tr><td colspan=2>&nbsp;</td></tr><tr><td colspan=2><b translate>Unique Local Address(ULA) configuration</b></td></tr><tr><td colspan=2>&nbsp;&nbsp;<select name=sltULAprefix onclick=onclkUla()><option translate value=0>Off</option><option translate value=2>Auto ULA Prefix</option><option translate value=1>Manually ULA Prefix</option></select>&nbsp;&nbsp;<input maxlength=128 name=sULAAddr size=43 type=text> / 64</td></tr><tr><td colspan=2>&nbsp;</td></tr><tr><td colspan=2>&nbsp;&nbsp;<b translate>Current IPv6 Address Table</b></td></tr><tr><td colspan=2>&nbsp;&nbsp;<select multiple name=sltIpv6Addr onclick=onClkIpv6Addr() size=7 style="width:500px;height:150px;font-family: monospace;"></select></td></tr></table><br></td></tr></table><br><table align=center border=1 cellpadding=2 cellspacing=0 width=95%><tr><td><table align=center border=0 cellpadding=1 cellspacing=0 width=95%><tr><td><b translate>DNS Server IPv6 Address</b></td><td><select name=iDNSipv6 onchange=sltDNSipv6(this.value)><option translate value=2>Deploy when WAN is up</option><option translate value=1>Enable</option><option translate value=0>Disable</option></select></td></tr><tr ng-show=showUseDNS><td style=padding-left:8px translate>Use DNS Server (WAN/Custom)</td><td><select name=iUseDNSS onchange=sltUseDNSS(this.value)><option translate value=0>Both</option><option translate value=1>WAN DNS Server only</option><option translate value=2>Customized DNS Server only</option></select></td></tr><tr ng-show=showDNSServ><td style=padding-left:8px translate>Primary DNS Server</td><td><input maxlength=128 name=sPriIpv6Dns size=43 type=text value="2001:4860:4860::8888"></td></tr><tr ng-show=showDNSServ><td style=padding-left:8px translate>Secondary DNS Server</td><td><input maxlength=128 name=sSecIpv6Dns size=43 type=text value="2001:4860:4860::8844"></td></tr></table></td></tr></table><br><table align=center border=0 cellpadding=1 cellspacing=0 width=95%><tr><td width=30%><b translate>Management</b></td><td><select name=sltManstat onclick=onChgMngtsta()><option translate value=0>SLAAC(stateless)</option><option translate value=1>DHCPv6(stateful)</option><option translate value=2>Off</option></select></td></tr><tr id=otheropt style=display:none><td>&nbsp;</td><td><input name=clkOthrOpt type=checkbox value=1><translate>Other Option(O-bit)</translate></td></tr></table><br><table align=center border=1 cellpadding=2 cellspacing=0 width=95%><tr><td><table align=center border=0 cellpadding=1 cellspacing=0 width=95%><tr><td colspan=2><b translate>DHCPv6 Server</b></td></tr><tr><td colspan=2><input  name=iDhcpv6Enable type=radio value=1><translate>Enable Server</translate>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <input checked name=iDhcpv6Enable type=radio value=0><translate>Disable Server</translate></td></tr><tr><td colspan=2><input  name=clkv6AddrRandAlloc type=checkbox value=1>&nbsp;&nbsp;<b translate>IPv6 Address Random Allocation</b></td></tr><tr><td colspan=2><input name=clkv6range onclick=onclkv6range() type=checkbox value=1>&nbsp;&nbsp;<b translate>Auto IPv6 range</b></td></tr><tr><td width=35%>&nbsp;&nbsp;<translate>Start IPv6 Address</translate></td><td><input maxlength=128 name=sStartIpv6Addr size=43 type=text value="::"></td></tr><tr><td>&nbsp;&nbsp;<translate>End IPv6 Address</translate></td><td><input maxlength=128 name=sEndIpv6Addr size=43 type=text value="::"></td></tr><tr class=multiIpv6><td>&nbsp;&nbsp;<translate>Advance setting</translate></td><td><input class=btnw name=btnEditV6 onclick=clkbtnEditV6() type=button value="{{ 'Edit' | translate }}"></td></tr></table></td></tr></table><br><hr width=95%><table align=center border=0 cellpadding=2 cellspacing=0 width=95%><tr><td width=44%><translate>Advance setting</translate></td><td><input class=btnw name=btnEdit onclick=clkbtnEdit() type=button value="{{ 'Edit' | translate }}"></td></tr></table></td></tr></table></div><br><table align=center><tr><td><input class=btnw name=btnOK onClick=onClkBtnOk() type=button value="{{ 'OK' | translate }}"><input name=sAct type=hidden value><input name=iProfileIdx type=hidden value=1><input name=iAct type=hidden value=0><input name=iLanidx type=hidden value=1><input name=iAdvenable type=hidden value=1><input name=sHoplimt type=hidden value="64"><input name=sminitval type=hidden value="200"><input name=smaxitval type=hidden value="600"><input name=sdeflftm type=hidden value="1800"><input name=idefpref type=hidden value="0"><input name=chkmtu type=hidden value="1"><input name=smtu type=hidden value="0"><input name=iwansel type=hidden value="62"><input name=old1ndsubip type=hidden value="192.168.0.1"><input name=old1ndsubmsk type=hidden value="255.255.255.0"><input name=webchange type=hidden value=0><input name=iRIPng type=hidden value="1"><input name=FullBridge type=hidden value=0></td></tr></table><br><input name=sFormAuthStr type=hidden value="TOO7UwhiVtwiiWv"></td></tr></table></form><script>top.ACTION_STATUS=-1;top.iActionStatusFlag='0';top.iFwUpgradeState='0';top.act_sta.damage_alert();var f=document.frm1;var bg=parent;var iDHCPType=parseInt('1');var iForceDnsMnu=(((parseInt('33569824')>>19)&0x01)==1)?1:0;var sRot1IPSub='(nil)'; var Ipv6LanInfo='##% Command missing, Valid commands are:##csm           ddns          dos           exit          internet      ip            ##ipf           log           ldap          tacacsplus    mngt          msubnet       ##object        port          portmaptime   ppa           hwaccswap     prn           ##qos           hwqos         quit          show          smb           srv           ##switch        sys           testmail      fs            upnp          usb           ##vigbrg        fullbrg       vlan          vpn           wan           hsportal      ##radius        local_8021x   wol           user          appqos        nand          ##apm           sfp           ethoam        ha            swm           fw_backupmode ##cert          service       dmn           ##';var ip6_msg='0';v