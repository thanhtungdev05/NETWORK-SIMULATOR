            "mimeType": "text/html",
            "compression": 3501,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><script src=\"/cgi-bin/certificatedata.cgi?sFormAuthStr=JdvKVyYlhh7GhS9\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><script> var iIntfWan1=parseInt(\"3\");var iBwanNumber=parseInt(\"6\");var iSSTPFlag=parseInt(\"505\");</script><tr><td><b parent=\"{{ 'VPN and Remote Access' | translate }}\" sub-title translate>SSL General Setup</b><hr><form method=post name=frm><table align=center border=1 cellspacing=0 width=700><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 width=95%><tr id=bindtowan><td><b translate>Bind to WAN</b></td><td id=WANcheck width=70%><script>var strChecked;var bDualDSL=parseInt('0');var DualDslEnable=parseInt(\"0\");var iFixWanNum=parseInt(\"4\");var iUSBNum=parseInt(\"2\");var iSecUsbNum=parseInt(\"1\");var bNewWLWAN=parseInt('1');var bWless=parseInt('0');var bDualWless5G=parseInt('0');var sLTEmodulename='LTE';var idx_2nd_usb=iFixWanNum+iUSBNum-iSecUsbNum;var extra_vdsl_idx=iFixWanNum+iUSBNum;var bWan2IsDisable=parseInt('0');var wanHTML=\"\";for(var i=0;i<iBwanNumber;i++){if(top.notSupportWAN.indexOf(i)!=-1)continue;if((bDualDSL&&extra_vdsl_idx==i&&DualDslEnable!=\"1\")||(iUSBNum==2&&iSecUsbNum==0&&idx_2nd_usb==(i+1)))continue;if(bNewWLWAN&&(i==2||i==3)&&!bWless&&!bDualWless5G)continue;else if(bNewWLWAN&&i==3&&!bDualWless5G)continue;if(((i==1||i==3)&&parseInt('0'))||(i==1&&bWan2IsDisable))continue;if(!(iSSTPFlag&(1<<(iIntfWan1+i))))strChecked=\" checked\";else strChecked=\"\";wanHTML+=\"<label><input class='bindWan' type='checkbox'\"+strChecked+\">\";if(((i==2&&!parseInt('1'))||(i==4&&parseInt('1')))&&(parseInt('0')))wanHTML+=gettext(sLTEmodulename);else wanHTML+=gettext(\"WAN\")+(i+1);wanHTML+=\"</label><br>\";}document.getElementById(\"WANcheck\").innerHTML=wanHTML;</script></td></tr><tr><td><b translate>Port</b></td><td width=70%><input name=sslvpn_port size=6 type=text value=\"443\"> (<translate>Default</translate>: 443)</td><td></tr><tr ng-if=bMULTI_CERT><td><b translate>Server Certificate</b></td><td ng-if=\"iXCer4LoSrv == 1\" translate>Default Certificate</td><td gid=g89237 ng-show=\"iXCer4LoSrv == 0\" width=70%><select name=servercert ng-disabled=\"iXCer4LoSrv == 1\" size=1><option translate value=0>self-signed</option><script>if(!parseInt('1')){if(\"(nil)\"!=\"Certificate\"){document.frm.servercert.options[0].selected=true;parent.setVle2Elmt(document.frm.servercert,'0',0);}else{document.write(\"<option value=1>\"+gettext(\"Local Certificate\")+\"</option>\");parent.setVle2Elmt(document.frm.servercert,'0',0);}}</script></select></td></tr></table></td></tr></table><br><table align=center border=0 cellpadding=0 cellspacing=2 ng-if=\"iXCer4LoSrv == 1\" width=100%><tr><td id=linknote><b translate>Note</b>: <ol><li id=link_note translate>Server Certificate follow the Default Certificate now.Default Certificate can be configured at <a>Certificate >> Local Services List</a>.</li></ol></td></tr></table><br><table align=center><tr><td><input class=btnw name=btnOK onclick=onbtnClk() type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnCcl onClick=onbtnCcl() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table><br><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></td></tr></table><script src=\"/js/variable.js?35339\"></script><script>top.ACTION_STATUS=-1;top.iActionStatusFlag='1';top.iFwUpgradeState='0';var f=document.frm,bg=parent; angular.element(document).ready(function(){$scope.iXCer4LoSrv=parseInt('1');$scope.bMULTI_CERT=parseInt('1');$scope.$apply();if($scope.iXCer4LoSrv==1){bg.showElmtById(document,\"linknote\");angular.element(document.querySelector(\"#link_note a\")).attr(\"href\",\"/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=1226\");}else{bg.hideElmtById(document,\"linknote\");}}); var local_cert=aryajaxlocca;function initParameter(){var idx,cnt;for(idx=cnt=0;idx<local_cert.length;idx++){if(local_cert[idx][1]==\"---\"){break;}else if(local_cert[idx][1]!=\"Requesting\"){f.servercert.options[cnt+1]=new Option(local_cert[idx][0],local_cert[idx][2],false,false);cnt++;}}bg.setVle2Elmt(f.servercert,'0',0);}if(parseInt('1')){initParameter();}initWebChange();function consistentWithBwan(wanElements,iBwanNumber){var arrWans=[];for(var i=0;i<wanElements.length;i++){arrWans.push(wanElements[i]);}if(wanElements.length==iBwanNumber){return arrWans;} if(bWan2IsDisable){arrWans.splice(1,0,undefined);} if(top.notSupportWAN.indexOf(2)!=-1){arrWans.splice(2,0,undefined);} if(top.notSupportWAN.indexOf(3)!=-1){arrWans.splice(3,0,undefined);}return arrWans;}function onbtnClk(){var webchange=0;if(checkWebChange()){webchange=1;}var sslvpn_port_1=bg.getVleFromElmt(f.sslvpn_port,0);var sslvpn_wan=0;var elem=consistentWithBwan(document.querySelectorAll(\".bindWan\"),iBwanNumber);for(var i=0;i<iBwanNumber;i++){if(elem[i]&&elem[i].checked){sslvpn_wan|=(1<<i);}}sslvpn_wan=(1<<iBwanNumber)-1-sslvpn_wan;if(sslvpn_port_1<=0||sslvpn_port_1>65535){alert(gettext(\"SSL VPN Port is wrong!\"));return;}if(sslvpn_port_1==80){alert(gettext(\"Port 80 is reserved for other services on the router.\"));return;}var new_url=\"/cgi-bin/v2x00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=4004\"+(parseInt('1')?(\"&servercert=\"+bg.getVleFromElmt(f.servercert,0)):\"\")+\"&sslvpn_port=\"+sslvpn_port_1+\"&sslvpn_wan=\"+sslvpn_wan+\"&webchange=\"+webchange;$http.get(new_url).then(function(response){urlrequest();});}function urlrequest(){document.location.href=\"/cgi-bin/v2x00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=4005\";}function onbtnCcl(){bg.setVle2Elmt(f.sslvpn_port,\"443\",0)}</script></body></html>"
