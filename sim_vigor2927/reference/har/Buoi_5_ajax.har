 '1438';\t\t//WAN MTU\nvar getwMTU2 = '1380';\n</textarea><table align=center border=0 cellpadding=0 cellspacing=0 width=800><tr><td><b parent=\"{{ 'Online Status' | translate }}\" sub-title translate>Physical Connection</b><hr><form name=frm1><input id=fid name=fid type=hidden><input id=iAct name=iAct type=hidden><input id=iProfileIdx name=iProfileIdx type=hidden><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td align=right><span ng-if=\"'0' == '1'\"><img align=middle alt=\"{{ 'Printer' | translate }}\" border=0 src=/images/prt2.gif>&nbsp;</span><span ng-if=\"'0' == '1' && '0' != '2'\"> <a class=DenyToPage href=javascript:btn3GUSBModem(1)><img align=middle alt=\"{{ '3G/4G Modem(PPP)' | translate }}\" border=0 src=/images/mdm1.GIF></a>&nbsp;</span><span ng-if=\"SIM1\"> <a class=DenyToPage href=\"javascript:btnUSBWimax(5)\"><img align=middle alt=\"{{ (bQLTE) ? gettext(sLTEmodulename) : ('3G/4G Modem(DHCP)' | translate) }}\" border=0 src=/images/wimax.GIF></a>&nbsp;</span><span ng-if=\"'0' == '1'\"><img align=middle alt=\"{{ 'USB Disk' | translate }}\" border=0 src=/images/usbdisk.GIF>&nbsp;</span><span ng-if=\"bUSBTemper && '0' != '0'\"><img align=middle alt=\"{{ 'USB Temper' | translate }}\" border=0 src=/images/Temperature.gif>&nbsp;</span><span ng-if=\"'0' == '1' && '0' != '2'\"> <a class=DenyToPage href=javascript:btn3GUSBModem(2)><img align=middle alt=\"{{ '3G/4G Modem(PPP)' | translate }}\" border=0 src=/images/mdm1.GIF></a>&nbsp;</span><span ng-if=\"SIM2\"> <a class=DenyToPage href=\"javascript:btnUSBWimax((5+1))\"><img align=middle alt=\"{{ '3G/4G Modem(DHCP)' | translate }}\" border=0 src=/images/wimax.GIF></a>&nbsp;</span><script> var bg=parent;var iWimaxName;var strWirless=(parseInt('0'))?gettext(\"Wireless 2.4G\"):gettext(\"Wireless\");var iWimaxMode;var bNewWLWAN=parseInt('1');var bWless=parseInt('0');var bDualWless5G=parseInt('0');var iWimaxMode2='4G/3G/2G';var iCDCEtherExist='0';var iCDCEther2Exist='0';var wan2phymode='';var ltedual='';var ltestus='##Status: LTE WAN3 access mode [None].##Access Tech: ---##Band: ---##ISP: ---##MCC: ---, MNC: ---, LAC: ---, Cell ID: ---##Max Channel TX Rate: --- bps##Max Channel RX Rate: --- bps##Keep Alive Ping 8.8.8.8: Enabled##Network Scan function: Not Ready##IMEI: ---##IMSI: ---##ICCID_SIM1: ---##ICCID_SIM2: ---##Hardware version: ---##Software version: ---##RSSI: --- dBm##Unread SMS: 0##SMSC address: ---##SMS service status : Not Ready##Number of SMS sent : 0##SIM1: Not Detected##Current using SIM: Unknown';var sWClnt5gScurty='';var sWClntScurty='';var online1initScript=document.createElement(\"script\");online1initScript.text=document.getElementById(\"online1init\").value;document.head.appendChild(online1initScript);if('WiMAX'=='WiMAX')iWimaxName='USB Modem';else iWimaxName='WiMAX';if('0'==0&&sLTEmodulename==\"LTE\")iWimaxMode=gettext('4G/3G');else if('0'==0&&sLTEmodulename==\"5G-NR\")iWimaxMode=gettext('5G/4G/3G');else if('0'==1)iWimaxMode=gettext('4G Only');else if('0'==2)iWimaxMode=gettext('3G Only');else if('0'==4)iWimaxMode=gettext('5G(SA) Only');else iWimaxMode=gettext('2G Only');angular.element(document).ready(function(){$scope.SIM1=(iWimaxOn==1&&iWimaxExist==1&&(iUsb1WebErrCode==2||!iUsb1WebErrCode));$scope.SIM2=(iWimax2On==1&&iWimax2Exist==1&&(iUsb2WebErrCode==2||!iUsb2WebErrCode));$scope.$apply();}); var ary_BandColor=[\"red\",\"red\",\"red\",\"red\",\"red\",\"red\"];var ary_WanEnable=[iBw0WanEnable,iBw1WanEnable,iBw2WanEnable,iBw3WanEnable,iBw4WanEnable,iBw5WanEnable];var ary_BandMode=[sBw0BBandMode,sBw1BBandMode,sBw2BBandMode,sBw3BBandMode,sBw4BBandMode,sBw5BBandMode];var ary_BwType=[aryPhyMode[0],aryPhyMode[1],iBw2Type,iBw3Type,iBw4Type,iBw5Type];var ary_WanFlag=[0,0,iBw2WanFlag,iBw3WanFlag,iBw4WanFlag,0];var ary_BWanFlag=[0,0,iBw2BWanFlag,iBw3BWanFlag,iBw4BWanFlag,iBw5BWanFlag]; var ary_UpTime=[\"00:00:00\",\"00:00:00\",\"00:00:00\",\"00:00:00\",\"00:00:00\",\"00:00:00\"];function txt_bridge(idx){var str=\"\";if(aryBridgeModev4.length>idx){if(ary_BandMode[idx]==\"DHCP Client\"||ary_BandMode[idx]==\"Static IP\"){if(aryBridgeModev4[idx]==1&&'1'==\"1\")str='&nbsp;<font color=green>('+gettext('Bridge')+')</font>';}}var sDualSim=\"\";if(ltedual&&firstUSBWAN==idx+1){var aa=ltestus.split(\"##\");for(i=0;i<aa.length;i++){var bb=aa[i].split(\": \");if(bb[0]==\"Current using SIM\"){sDualSim=bb[1];break;}}if(sDualSim.toLowerCase()!=\"unknown\")str+='&nbsp;('+gettext(\"Using\")+\" \"+sDualSim+\")\";}return str;}function mode2txt(cgimode){var str=cgimode;if(cgimode==\"PPTP\")str=gettext(\"PPTP\");else if(cgimode==\"PPPoE\")str=gettext(\"PPPoE\");else if(cgimode==\"PPPoA\")str=gettext(\"PPPoA\");else if(cgimode==\"DHCP Client\")str=gettext(\"DHCP Client\");else if(cgimode==\"Static IP\")str=gettext(\"Static IP\");return str;}function txt_bandmode(idx){var str=\"\";if(sPresetModel=='2850'&&idx==0&&'(nil)'==1){if(iBw0BBandType==1)str=gettext(\"PPPoE\");else if(iBw0BBandType==2)str=gettext(\"PPPoA\");}else str=mode2txt(ary_BandMode[idx]);return str;}function txt_signal(idx){var str=\"\";switch(idx){case 1:str=txt_HsdpaSig(idx);break;case 2:case 3:if(!(iWimaxOn==1&&((ary_WanFlag[idx]&WAN_USB_WIMAX_MODEM)==WAN_USB_WIMAX_MODEM))){if(ary_BwType[idx]==3)txt_HsdpaSig(idx);else if(ary_BwType[idx]==4||ary_BwType[idx]==5)wrtApp(ary_BWanFlag[idx]);}break;case 4:case 5:if(ary_BwType[idx]==3)txt_HsdpaSig(idx);else if(ary_BwType[idx]==4||ary_BwType[idx]==5)wrtApp(ary_BWanFlag[idx]);break;}return str;}function txt_type(idx){var str=aryStrBwType[ary_BwType[idx]];if(idx==0){str='<span class=dsl style=\"display:none\">SDSL</span>';str+='<span id=\"wan1Line\" class=adsl style=\"display:none\">ADSL'+strwan1dsl+'</span>';str+='<span class=ethernet id=ethernet style=\"display:none\">'+gettext('Ethernet')+'</span>';str+='<span class=fiber style=\"display:none\">'+gettext('Fiber')+'</span>';str+='<span class=wclnt style=\"display:none\">'+gettext('Wireless Client')+'</span>';}else if(idx==1){if(iWimaxOn==1&&((iBw1WanFlag&WAN_USB_WIMAX_MODEM)==WAN_USB_WIMAX_MODEM))str=iWimaxName;else if((iHSDPA&&(iBw1BWanFlag&BWAN_PPPOE_OVER_HSDPA))||bg.SHOW_SYS_3GMOD)str=gettext(\"3G USB Modem\");else{switch(aryPhyMode[1]){case\"1\":str=gettext(\"ADSL\");break;case\"2\":str=gettext(\"Fiber\");break;case\"3\":str=('0'=='1')?gettext(\"VDSL2\"):gettext(\"VDSL\");break;case\"4\":str=gettext(\"USB\");break;case\"5\":str=strWirless;break;case\"6\":str=gettext(\"Wireless 5G\");break;default:str=gettext(\"Ethernet\");}}}else if(bNewWLWAN&&(idx==2||idx==3)){if(aryPhyMode[idx]==5)str=strWirless;else if(aryPhyMode[idx]==6)str=gettext(\"Wireless 5G\");}return str;}function txt_enable(idx){var str='';if(idx<2)str+='<font color=\"'+ary_BandColor[idx]+'\">';str+=(ary_WanEnable[idx]=='1')?gettext(\"Yes\"):gettext(\"No\");if(idx<2)str+='</font>';return str;}function txt_title(idx){var str=\"<td width=20%>&nbsp;&nbsp;<b>\"+gettext(\"Enable\")+\"</b></td>\";str+=\"<td width=20%><b>\"+gettext(\"Line\")+\"</b></td>\";str+=\"<td><b>\"+gettext(\"Name\")+\"</b></td>\";str+=\"<td><b>\"+gettext(\"Mode\")+\"</b></td>\";str+=\"<td><b>\"+gettext(\"Up Time\")+\"</b></td>\";str+=\"<td><b>\";switch(idx){case 1:if((iHSDPA==1||parseInt('0'))&&(iBw1BWanFlag&BWAN_PPPOE_OVER_HSDPA)&&iHsdpaModemExist==1){str+=gettext('Signal');}break;case 2:case 3:if(!(iWimaxOn==1&&((ary_WanFlag[idx]&WAN_USB_WIMAX_MODEM)==WAN_USB_WIMAX_MODEM))){if(ary_BwType[idx]==3)str+=gettext(\"Signal\");else if(ary_BwType[idx]==4||ary_BwType[idx]==5)str+=gettext(\"Application\");}break;case 4:case 5:if(!parseInt('1')){if(ary_BwType[idx]==3)str+=gettext(\"Signal\");else if(ary_BwType[idx]==4||ary_BwType[idx]==5)str+=gettext(\"Application\");}else{if(!(iWimaxOn==1&&((ary_WanFlag[idx]&WAN_USB_WIMAX_MODEM)==WAN_USB_WIMAX_MODEM))){if(ary_BwType[idx]==3)str+=gettext(\"Signal\");else if(ary_BwType[idx]==4||ary_BwType[idx]==5)str+=gettext(\"Application\");}}break;}str+=\"</b></td>\";return str;}function wan_lines(idx){var str=\"<tr>\"+txt_title(idx)+\"</tr>\";str+=\"<tr class=\"+ary_BandColor[idx]+\">\";str+=\"<td>&emsp;\"+txt_enable(idx)+\"</td>\";str+=\"<td>\"+txt_type(idx)+\"</td>\";str+=\"<td>\"+ary_WanName[idx]+\"</td>\";str+=\"<td>\"+txt_bandmode(idx)+\"</td>\";str+=\"<td>\"+ary_UpTime[idx]+\"</td>\";str+=\"<td>\"+txt_signal(idx)+\"</td>\";str+=\"</tr><tr>\";str+=\"<td>&nbsp;&nbsp;<b>\"+gettext(\"IP\")+\"</b></td>\";str+=\"<td><b>\"+gettext(\"GW IP\")+\"</b></td>\";str+='<td><b class=packets style=\"display:none\">'+gettext(\"TX Packets\")+'</b><b class=bytes style=\"display:none\">'+gettext(\"TX Bytes\")+'</b></td>';str+=\"<td><b>\"+gettext(\"TX Rate\")+\"(\"+gettext(\"bps\")+\")</b></td>\";str+='<td><b class=packets style=\"display:none\">'+gettext(\"RX Packets\")+'</b><b class=bytes style=\"display:none\">'+gettext(\"RX Bytes\")+'</b></td>';str+=\"<td><b>\"+gettext(\"RX Rate\")+\"(\"+gettext(\"bps\")+\")</b></td>\";str+=\"</tr>\";return str;}function goWAN(idx){if(webcfg.isBT498&&(webcfg.privilege==1||webcfg.privilege==8)){return false;}switch(idx){case 0:document.location=abtnBw0ActTbl[iBw0BBandType*2+iBw0BBandAct][1];break;case 1:document.location=abtnBw1ActTbl[iBw1BBandType*2+iBw1BBandAct][1];break;case 2:document.location=aryBwActTbl[iBw2BBandType*2+iBw2BBandAct][1]+\"5\";break;case 3:document.location=aryBwActTbl[iBw3BBandType*2+iBw3BBandAct][1]+\"6\";break;case 4:document.location=aryBwActTbl[iBw4BBandType*2+iBw4BBandAct][1]+\"7\";break;case 5:document.location=aryBwActTbl[iBw5BBandType*2+iBw5BBandAct][1]+\"8\";break;}}</script></td><script>var str=\"\";str+=\"<td align=right><b>\"+gettext(\"System Uptime\")+\":&nbsp;\";if(iday>1){str+=iday+gettext(\"days\")+\"&nbsp;\"+ihour+\":\"+imin+\":\"+isec+\"</b></td>\";}else{str+=iday+gettext(\"day\")+\"&nbsp;\"+ihour+\":\"+imin+\":\"+isec+\"</b></td>\";}document.write(str);</script></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 id=ipv6 style=display:none width=100%><tr><td class=ontab id=tab1 onClick=onChgAccMod(1) width=40%><b translate>IPv4</b></td><td class=offtab id=tab2 onClick=onChgAccMod(2) width=40%><b translate>IPv6</b></td><td class=tabpadding width=20%>&nbsp;</td></tr></table><div style=\"border: 2px solid #000000\"><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td colspan=6><b translate>LAN Status</b></td></tr><tr><td width=25%>&nbsp;&nbsp;<b translate>IP Address</b></td><td width=20%><b translate>TX Packets</b></td><td width=20%><b translate>RX Packets</b></td><td width=15%><b translate>Router Primary DNS</b>:</td><td width=15%><b translate>Router Secondary DNS</b>:</td><td width=5%></td></tr><tr><td class=green>&nbsp;&nbsp;192.168.1.1</td><td class=green><script>document.write(bg.KseparatorAdd('2197'))</script></td><td class=green><script>document.write(bg.KseparatorAdd('2790'))</script></td><td class=green>&nbsp;8.8.8.8</td><td class=green>&nbsp;8.8.4.4</td><td width=5%></td></tr></table></div><div id=page1><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td colspan=4><b><span class=wan1 style=display:none><translate>WAN</translate>&nbsp;1&nbsp;<translate>Status</translate></span><span class=wlan1 style=display:none><translate>WLAN</translate>&nbsp;1&nbsp;<translate>Status</translate></span></b><script>document.write(txt_bridge(0));</script></td><script>var iBw0BBandType=0;var strwan1dsl=\"\";if('(nil)'=='1'){if(bondinfo.length!=0&&bondinfo[0]!=0){if(bondinfo[0]==2){strwan1dsl=\" - \"+gettext(\"Bonding\");}else{strwan1dsl=\" - \"+(bondinfo[1]=='1')?gettext(\"Line\")+\" 1\":gettext(\"Line\")+\" 2\";}}}if((iBw0WanFlag&WAN_PPTP_CLIENT)==WAN_PPTP_CLIENT){iBw0BBandType=0;}else if((iBw0WanFlag&WAN_L2TP_CLIENT)==WAN_L2TP_CLIENT){iBw0BBandType=4;}else if((iBw0WanFlag&WAN_PPPoE_CLIENT)==WAN_PPPoE_CLIENT){if((iUSB_DvrTpe==\"1\")||(sBw0PhyMode!=1)){iBw0BBandType=1;}else{iBw0BBandType=2;}}else if(((iBw0WanFlag&WAN_BROADBAND_GATEWAY)==WAN_BROADBAND_GATEWAY)&&((iBw0BWanFlag&BWAN_DHCP_CLIENT)==BWAN_DHCP_CLIENT)){iBw0BBandType=3;}else{iBw0BBandType=5;}if(iBw0BBandType<5){if(iBw0BBandType==3&&'---'=='---'){document.write('<td class=\"red BTHide\" align=right colspan=2>>>&nbsp;<a href=\\\"javascript:goWAN(0)\\\">'+abtnBw0ActTbl[iBw0BBandType*2][0]+'</a>&nbsp;</td>');}else{document.write('<td class=\"red BTHide\" align=right colspan=2>>>&nbsp;<a href=\\\"javascript:goWAN(0)\\\">'+abtnBw0ActTbl[iBw0BBandType*2+iBw0BBandAct][0]+'</a>&nbsp;</td>');}}</script></tr><script>document.write(wan_lines(0));</script><tr class=wan1ip><td>&nbsp;&nbsp;<font color=\"red\">---</font></td><td><font color=\"red\">---</font></td><td><font color=\"red\"><span id=lBw0TBytes><script>document.write(bg.KseparatorAdd('0'))</script></span></font></td><td><font color=\"red\"><script>document.write(bg.KseparatorAdd(bg.rateB2b('0')))</script></font></td><td><font color=\"red\"><span id=lBw0RBytes><script>document.write(bg.KseparatorAdd('0'))</script></span></font></td><td><font color=\"red\"><script>document.write(bg.KseparatorAdd(bg.rateB2b('0')))</script></font></td></tr><script>var f=document.frm1;var str=\"\";var maxLANidx='17'; var enDMZ='1';var enIProuted='1';var aryWanMskLen=aryWanMask.length;var bSame=0;var wan1ip=\"---\";var wan1mask=aryWanMask[0];function onClkDtPage(idx){parent.sLanGenStatusTag=\"tab1\";f.fid.value=2117;f.iAct.value=0;f.iProfileIdx.value=idx;f.action=\"/cgi-bin/v2x00.cgi\";f.submit();}function isSameSubnet(newip,newmsk,curip,curmsk){var lanip_arr=newip.split(\".\");var mask_arr=newmsk.split(\".\");var subf_arr=[lanip_arr[0]&mask_arr[0],lanip_arr[1]&mask_arr[1],lanip_arr[2]&mask_arr[2],lanip_arr[3]&mask_arr[3]];var subf_num=parseInt(subf_arr[0]*255*255*255+subf_arr[1]*255*255+subf_arr[2]*255+subf_arr[3]);var subt_arr=[subf_arr[0]|(255-mask_arr[0]),subf_arr[1]|(255-mask_arr[1]),subf_arr[2]|(255-mask_arr[2]),subf_arr[3]|(255-mask_arr[3])];var subt_num=parseInt(subt_arr[0]*255*255*255+subt_arr[1]*255*255+subt_arr[2]*255+subt_arr[3]);lanip_arr=curip.split(\".\");mask_arr=curmsk.split(\".\");subf_arr=[lanip_arr[0]&mask_arr[0],lanip_arr[1]&mask_arr[1],lanip_arr[2]&mask_arr[2],lanip_arr[3]&mask_arr[3]];var curf=parseInt(subf_arr[0]*255*255*255+subf_arr[1]*255*255+subf_arr[2]*255+subf_arr[3]);subt_arr=[subf_arr[0]|(255-mask_arr[0]),subf_arr[1]|(255-mask_arr[1]),subf_arr[2]|(255-mask_arr[2]),subf_arr[3]|(255-mask_arr[3])];var curt=parseInt(subt_arr[0]*255*255*255+subt_arr[1]*255*255+subt_arr[2]*255+subt_arr[3]); if(subf_num==curf&&subt_num==curt){ return true;}return false;}for(var k=0;k<maxLANidx;k++){if(k==maxLANidx-2&&!enDMZ)continue;if(k==maxLANidx-1&&!enIProuted)break;if(isSameSubnet(wan1ip,wan1mask,aryLanIp[k],aryLanMsk[k])){if(k>0&&aryLanAlsEn[k-1]==0){}else{bSame=1;break;}}}if(bSame){bg.hideElmtByClass(document,\"tr\",\"wan1ip\");str=\"<tr><td colspan=6><font color=red>\"+aryLanName[k]+\" \"+gettext(\"and WAN have the same IP subnet, click <a>here</a> to change ###LAN### IP subnet\").replace(\"<a>\",'<a href=\"javascript:onClkDtPage('+(k+1)+')\">').replace(\"###LAN###\",aryLanName[k])+\"</font></td></tr>\";document.write(str);}var aWAN_report_status=[[1,gettext(\"Username or password error.\")],[10,gettext(\"Starting PPP\")],[11,gettext(\"PPP Shutdown\")],[20,gettext(\"PPPoE : No response from server side.\")],[21,gettext(\"PPPoE : Starting PPPoE/PPPoA\")]];if(iBw0BBandAct==0){for(var i=0;i<aWAN_report_status.length;i++){if(iBw0BBandType==1||iBw0BBandType==2){ if((aWAN_report_status[i][0]==iBw0RptSta)&&(iBw0RptSta<10)){document.write('<tr><td colspan=6 class=red>'+gettext('Error')+' [ '+aWAN_report_status[i][1]+' ]</b></td></tr>');break;} else if((aWAN_report_status[i][0]==iBw0RptSta)&&(iBw0RptSta>=10)){document.write('<tr><td colspan=6 class=green>'+gettext('Message')+' [ '+aWAN_report_status[i][1]+' ]</b></td></tr>');break;}}}}var aWebSyslog=[[1,gettext('WAN IP conflicts with device %1.')],[2,gettext('LAN IP conflicts with device %1.')],[3,gettext('Try to overwrite the default gateway\\'s MAC from %1 to %2')]];for(var i=0;i<aWebSysl