            "compression": 19365,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><script src=\"/js/tool.min.js?094907\"></script><script src=\"/cgi-bin/usbweb.cgi?sFormAuthStr=pU2VHFY4WAi1NkA\"></script><link / href=/images/favicon.ico rel=\"shortcut icon\"><meta / charset=\"ISO-8859-1\"><script> if(opener!=null){if('0'==0&&'0'==1)document.location='/doc/chgUserPW.htm';else if(!opener.parent.SHOW_SYS_ADMIN&&!parseInt('0'))top.location.href='/weblogin.htm';}else{if('0'==0&&'0'==1)document.location='/doc/chgUserPW.htm';else if(!parent.SHOW_SYS_ADMIN&&!parseInt('0'))top.location.href='/weblogin.htm';}document.onkeydown=function(event){var target,code,tag;if(!event){event=window.event; target=event.srcElement;code=event.keyCode;if(code==13){tag=target.tagName;if(tag==\"TEXTAREA\"){return true;}else{return false;}}}else{target=event.target; code=event.keyCode;if(code==13){tag=target.tagName;if(tag==\"INPUT\"){return false;}else{return true;}}}};function getElmtById(doc,idVal){if(doc.getElementById!=null){return doc.getElementById(idVal);}if(doc.all!=null){return doc.all[idVal];}return null;}function hideElmtById(_doc,_el){var doc=_doc;var el=_el;getElmtById(doc,el).style.display=\"none\";}function showElmtById(_doc,_el){var doc=_doc;var el=_el;getElmtById(doc,el).style.display=\"\";}function showElmtByClass(_doc,_tag,_el){var doc=_doc;var tag=_tag;var el=_el;if(doc.getElementsByTagName){var nodes=doc.getElementsByTagName(tag);var max=nodes.length;for(var i=0;i<max;i++){var node=nodes.item(i);if(node.className==el){node.style.display=\"\";}}}}function hideElmtByClass(_doc,_tag,_el){var doc=_doc;var tag=_tag;var el=_el;if(doc.getElementsByTagName){var nodes=doc.getElementsByTagName(tag);var max=nodes.length;for(var i=0;i<max;i++){var node=nodes.item(i);if(node.className==el){node.style.display=\"none\";}}}}</script><style>\n\t.standline{\n\t\tfont-size: 11px;\n\t\tcolor : #4E4E4E;\n\t\tfont-family :  Verdana, Arial,helvetica,sans-serif;\n\t\tfont-weight : normal;\n\t\ttext-decoration : none;\n\t\tborder-left:1px #99989d solid;\n\t}\n\n\ttable.main_menu {\n\t\tbackground-color: #EBEBEB;\n\t\tborder-style : solid;\n\t\tborder-top : solid 1px #ffffff;\n\t\tborder-right : solid 0px;\n\t\tborder-bottom : solid 1px #ACACAC;\n\t\tborder-left : solid 0px;\n\t}\n\n\ttable.left_title{\n\t \tbackground-color:#EBEBEB;\n\t \tFILTER: progid:DXImageTransform.Microsoft.Gradient(gradientType=0,startColorStr=#5473AE,endColorStr=#7094BF);\n\n\t}\n\n\ttable.adminform1 {\n\t\t/*background-color: #FCF1DA;*/\n\t\tborder: solid 1px #2D5099;\n\t}\n\n\ttd.white_line {\n\t\tbackground-color: #FFFFFF;\n\t}\n\n\ttd.heading {\n\t\tbackground-color: #EBEBEB;\n\t\tFONT-WEIGHT: bold;\n\t    \tFONT-SIZE: 12px;\n\t    \tCOLOR: #4E4E4E;\n\t    \tFONT-FAMILY: Trebuchet MS, Verdana, Arial, Helvetica, sans-serif\n\t}\n\n\ttd.grey_line {\n\t\tbackground-color: #F7F7F7;\n\t\tfont-size : 11px;\n\t\tfont-family : Verdana, Arial, Helvetica, sans-serif;\n\t}\n\n\ttd.clickbright {\n\t\tbackground-color: #96B5DA;\n\t\tfont-size : 11px;\n\t\tfont-family : Verdana, Arial, Helvetica, sans-serif;\n\t\tcolor: #000000;\n\t\tborder-color: #99989d;\n\t\tborder-style: solid;\n\t\tborder-width: 0px 0px 0px;\n\t}\n\n\ttd.left_content {\n\t    FONT-SIZE: 11px;\n\t    COLOR: #4E4E4E;\n\t    FONT-FAMILY: Verdana, Arial, Helvetica, sans-serif\n\t}\n\n\timg.itemimg1{\n\t\twidth: 14px;\n\t\theight: 14px;\n\t}\n\n\timg.itemimg2 {\n\t\twidth: 16px;\n\t\theight: 16px;\n\t\tcursor: pointer;\n\t}\n\n\t.hand {\n\t\tcursor:pointer;\n\t}\n\n\t.input1 {\n\t\theight:20px;\n\t\tBACKGROUND-COLOR:#F5F5F5;\n\t\tBORDER: #9FAFBB 1px solid;\n\t\tFONT-FAMILY: Verdana, Arial, Helvetica, sans-serif;\n\t\tpadding-top: 2px;\n\t\tcolor:#393c3f;\n\t\tfont-size:11px;\n\t}\n\n\t.input3 {\n\t\theight:20px;\n\t\tBACKGROUND-COLOR:#F5F5F5;\n\t\tBORDER: #9FAFBB 1px solid;\n\t\tFONT-FAMILY: Verdana, Arial, Helvetica, sans-serif;\n\t\tpadding-top: 2px;\n\t\tcolor:#393c3f;\n\t\tfont-size:10px;\n\t}\n\n\t.the_button {\n\t\theight:20px;\n\t\twidth: 2cm;\n\t\tBACKGROUND-COLOR:#F5F5F5;\n\t\tFILTER: progid:DXImageTransform.Microsoft.Gradient(gradientType=0,startColorStr=#FFFFFF,endColorStr=#C6C3DB);\n\t\tBORDER: #C6C3DB 1px solid;\n\t\tFONT-FAMILY: Verdana, Arial, Helvetica, sans-serif;\n\t\tpadding-top: 0px;\n\t\tcolor:#393c3f;\n\t\tfont-size:11px;\n\t\tcursor: pointer;\n\t}\n\n\t.c2 {\n\t\tposition:fixed;\n\t\ttop:\"expression(eval(document.body.scrollTop)+100)\";\n\t\tleft:400px;\n\t\ttop:150px;\n       \t\twidth:250px;\n\t\tbackground-color:#E8E8E8;\n\t\tborder:1px #999999 solid;\n\t}\n\n\t.c3 {\n\t\tposition:fixed;\n\t\ttop:\"expression(eval(document.body.scrollTop)+100)\";\n\t\ttop:50px;\n\t\tleft:250px;\n\t\theight:75px;\n\t\tborder:0px #999999 solid;\n\t}\n\t.c4 {\n\t\tposition:fixed;\n\t\ttop:\"expression(eval(document.body.scrollTop)+100)\";\n\t\tleft:400px;\n\t\ttop: 150px;\n    width:300px;\n\t\tbackground-color:#E8E8E8;\n\t\tborder:1px #999999 solid;\n\t}\n</style><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'USB Application' | translate }}\" sub-title translate>File Explorer</b><hr><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td width=70%><translate>USB Disk Connection Status</translate>: <span id=disStatus></span></td><td align=right class=red>&nbsp;&nbsp;|&nbsp; <a href=\"javascript: onRefresh()\" translate>Refresh</a>&nbsp;|</td></tr></table><br class=usbfileInfo><table align=center border=0 cellpadding=2 cellspacing=0 class=usbfileInfo width=100%><tr><td><b translate>File Explorer</b></td></tr></table><form name=frm_toolbar onSubmit=\"return false\"><table border=0 cellpadding=0 cellspacing=0 class=main_menu height=30 id=usbfileInfo width=100%><input name=DIR type=hidden value><input name=FILE type=hidden value><input name=DFILE type=hidden value><input name=OP type=hidden value><tr><td width=10></td><td width=50><img onclick=go_url() onmouseover=this.className='hand'; src=/images/reload.gif></td><td width=50><img onclick=up() onmouseover=this.className='hand'; src=/images/up.gif></td><td width=50><img onclick=newfolder() onmouseover=this.className='hand'; src=/images/new_folder.gif></td><td class=standline width=500>&nbsp;<translate>Current Path</translate>:&nbsp;<script>document.write(sPath.replace(/\\s/g,\"\\u00a0\"));</script></td><td></td></tr><input name=sFormAuthStr type=hidden value=\"pU2VHFY4WAi1NkA\"></table></form><table align=center border=1 cellpadding=2 cellspacing=0 class=usbfileInfo width=100%><tr><td><table align=center border=0 cellpadding=0 cellspacing=0 width=100%><tr height=20><td valign=top><table cellpadding=0 cellspacing=0 class=main_menu height=20 width=100%><tr valign=middle><td width=10><td><td width=20><td><td align=center class=standline translate width=50%>Name</td><td align=right class=standline width=150><translate>Size</translate>&nbsp;</td><td align=center class=\"standline BTHide\" translate width=80>Delete</td><td align=center class=\"standline BTHide\" translate width=80>Rename</td><td class=\"standline BTHide\"></td></tr></table></td></tr></table><form action=\"/cgi-bin/usbwebget.cgi?sFormAuthStr=pU2VHFY4WAi1NkA\" method=POST name=frm_prog><table border=0 cellpadding=0 cellspacing=0 class=c4 id=dialoProgress name=dialoProgress style=\"display:none; position:absolute; left:421px; top:236px\"><tr><td><table align=center border=0 cellpadding=0 cellspacing=0 height=15 width=95%><tr><td align=right valign=bottom><img class=hand onclick=clkstop() src=/images/r_c.gif></td></tr></table></td></tr><tr><td align=center><table border=0 cellpadding=2 cellspacing=2 height=140 width=90%><tr><td align=center translate>Deleting the subfolders and files.</td></tr><tr><td align=center><img src=/images/wait.gif></td></tr><tr><td align=center><input class=btnw name=btnStop onclick=clkstop() type=button value=\"{{ 'Stop' | translate }}\"></td></tr></table></td></tr><tr><td height=15>&nbsp;</td></tr><input name=OP type=hidden value=6><input name=sFormAuthStr type=hidden value=\"pU2VHFY4WAi1NkA\"></table></form><form name=frm_result><table border=0 cellpadding=0 cellspacing=0 class=c4 id=dialoResult name=dialoResult style=\"display:none; position:absolute; left:421px; top:236px\"><tr><td><table align=center border=0 cellpadding=0 cellspacing=0 height=15 width=95%><tr><td align=right valign=bottom><img class=hand onclick=result_cl() src=/images/r_c.gif></td></tr></table></td></tr><tr><td align=center><table border=0 cellpadding=2 cellspacing=2 height=100 width=90%><tr><td align=center id=deletemsg translate>Can't delete folders that contain multilevel folders.</td></tr><tr><td align=center><input class=btnw name=btnRstOK onclick=result_cl() type=button value=\"{{ 'OK' | translate }}\"></td></tr></table></td></tr><tr><td height=15>&nbsp;</td></tr><input name=sFormAuthStr type=hidden value=\"pU2VHFY4WAi1NkA\"></table></form><form action=\"/cgi-bin/usbwebget.cgi?sFormAuthStr=pU2VHFY4WAi1NkA\" method=post name=frm_newfolder><table border=0 cellpadding=0 cellspacing=0 class=c2 id=dialogue1 name=dialogue1 style=\"display:none; position:absolute; left:421px; top:281px\"><input name=DIR type=hidden value><input name=FILE type=hidden value><input name=OP type=hidden value><tr><td><table align=center border=0 cellpadding=0 cellspacing=0 height=15 width=95%><tr><td align=right valign=bottom><img class=hand onclick=nf_cl() src=/images/r_c.gif></td></tr></table></td></tr><tr><td align=center><table border=0 cellpadding=2 cellspacing=5 height=50 width=90%><tr><td class=left_content><translate>Folder name</translate>:</td></tr><tr valign=bottom><td valign=middle><input class=input1 name=foldername onKeyDown=\"if(event.keyCode==13) create();\" size=20 type=text></td><td align=center valign=middle><input class=the_button name=create_ok onclick=create() type=button value=\"{{ 'Create' | translate }}\"></td></tr></table></td></tr><tr><td height=15>&nbsp;</td></tr><input name=sFormAuthStr type=hidden value=\"pU2VHFY4WAi1NkA\"></table></form><form action=\"/cgi-bin/usbwebget.cgi?sFormAuthStr=pU2VHFY4WAi1NkA\" method=post name=frm_rename><table border=0 cellpadding=0 cellspacing=0 class=c2 id=dialogue2 name=dialogue2 style=\"display:none; position:absolute; left:428px; top:304px\"><input name=idx type=hidden><input name=DIR type=hidden value><input name=FILE type=hidden value><input name=DFILE type=hidden value><input name=OP type=hidden value><tr><td><table align=center border=0 cellpadding=0 cellspacing=0 height=15 width=95%><tr><td align=right valign=bottom><img class=hand onclick=r_cl() src=/images/r_c.gif></td></tr></table></td></tr><tr><td align=center><table border=0 cellpadding=2 cellspacing=5 height=50 width=90%><tr valign=bottom><td valign=middle><input class=input1 name=rename_new onKeyDown=\"if(event.keyCode==13) r_ok();\" size=20 type=text></td><td align=center valign=middle><input class=the_button name=rename_ok onclick=r_ok() type=button value=\"{{ 'Rename' | translate }}\"></td></tr></table></td></tr><tr><td height=15>&nbsp;</td></tr><input name=sFormAuthStr type=hidden value=\"pU2VHFY4WAi1NkA\"></table></form><form action=\"/cgi-bin/usbwebget.cgi?sFormAuthStr=pU2VHFY4WAi1NkA\" charset=\"ISO-8859-1\" method=post name=frm_list><table border=0 cellpadding=0 cellspacing=0 id=contentwin valign=top width=100%><input name=DIR type=hidden value><input name=FILE type=hidden value><input name=OP type=hidden value><input name=sFormAuthStr type=hidden value=\"pU2VHFY4WAi1NkA\"><tr height=18 id=line0 ondblclick=up() onmouseover=tr_click(0) valign=top><td class=clickbright id=td00 width=10></td><td class=clickbright id=td01 valign=middle width=20><img height=13 src=/images/nfolder.gif width=15></td><td class=clickbright id=td02 width=50%><font class=hand> <a onclick=up()>. .</a></font></td><td class=clickbright id=td06 width=150></td><td align=center class=clickbright id=td03 width=80></td><td align=center class=clickbright id=td04 width=80></td><td class=clickbright id=td05></td></tr><script>var str=\"\"; function get_filesize(Byte_size){var size0=Byte_size/1024;if(size0<1)return 1;var size1=Math.floor(size0);var str_size1=size1.toString();var len=str_size1.length;if(len<=3)return str_size1;var ss=\"\",s0=\"\";for(var i=0;i<len;i++){if(i!=0&&i/3==Math.floor(i/3)){ss=\",\"+ss;}s0=str_size1.charAt(len-i-1);ss=s0+ss;}return(ss);}function cutfile(_name){var tmp;if(_name.length>45){tmp=_name.substring(0,45)+\"...\";return tmp;}else{return _name;}}if((!iDiskStatus||!iDiskWrite)||sPath=='/'){hideElmtById(document,\"line0\");}if(iDiskStatus==1&&iDiskWrite==1){for(var i=0;i<sArpTbl.length;i++){ if(sArpTbl[i][1]==0){str=\"<tr onmouseover='tr_click(\"+(i+1)+\")' height=18 ondblclick='go_to_folder(\"+i+\")'>\";str+=\"<td id=td\"+(i+1)+\"0 width=10 class=grey_line>&nbsp;</td>\";str+=\"<td id=td\"+(i+1)+\"1 width=20 class=grey_line><img src='/images/nfolder.gif'></td>\";str+=\"<td id=td\"+(i+1)+\"2 width=50% class=grey_line><font class=hand><a onclick='go_to_folder(\"+i+\")' title='\"+sArpTbl[i][0].replace(/\\s/g,\"\\u00a0\")+\"'>\"+cutfile(sArpTbl[i][0].replace(/\\s/g,\"\\u00a0\"))+\"</a></font></td>\";str+=\"<td id=td\"+(i+1)+\"6 width=150 class=grey_line>&nbsp;</td>\";str+=\"<td id=td\"+(i+1)+\"3 align=center width=80 class='white_line BTHide'><img src=\\\"/images/clear1.gif\\\" onclick=\\\"deletefolder(\"+i+\")\\\" class=itemimg1 onmouseover=\\\"this.className='itemimg2';\\\" onmouseout=\\\"this.className='itemimg1';\\\"></td>\";str+=\"<td id=td\"+(i+1)+\"4 align=center width=80 class='white_line BTHide'><img src=\\\"/images/rename.gif\\\" onclick=\\\"rename(\"+i+\")\\\" class=itemimg1 onmouseover=\\\"this.className='itemimg2';\\\" onmouseout=\\\"this.className='itemimg1';\\\"></td>\";str+=\"<td id=td\"+(i+1)+\"5 class='white_line BTHide'>&nbsp;</td></tr>\";document.write(str);}}for(var i=0;i<sArpTbl.length;i++){ if(sArpTbl[i][1]!=0){str=\"<tr onmouseover='tr_click(\"+(i+1)+\")' height=18 ondblclick='go_to_file(\"+i+\")'>\";str+=\"<td id=td\"+(i+1)+\"0 width=10 class=grey_line>&nbsp;</td>\";str+=\"<td id=td\"+(i+1)+\"1 width=20 class=grey_line><img src='/images/nunknown.gif'></td>\";str+=\"<td id=td\"+(i+1)+\"2 width=50% class=grey_line><font class=hand><a onclick='go_to_file(\"+i+\")' title='\"+sArpTbl[i][0].replace(/\\s/g,\"\\u00a0\")+\"'>\"+cutfile(sArpTbl[i][0].replace(/\\s/g,\"\\u00a0\"))+\"</a></font></td>\";str+=\"<td id=td\"+(i+1)+\"6 width=150 class=grey_line align=right>\"+get_filesize(sArpTbl[i][2])+\" KB</td>\";str+=\"<td id=td\"+(i+1)+\"3 align=center width=80 class='white_line BTHide'><img src=\\\"/images/clear1.gif\\\" onclick=\\\"deleteItem(\"+i+\")\\\" class=itemimg1 onmouseover=\\\"this.className='itemimg2';\\\" onmouseout=\\\"this.className='itemimg1';\\\"></td>\";str+=\"<td id=td\"+(i+1)+\"4 align=center width=80 class='white_line BTHide'><img src=\\\"/images/rename.gif\\\" onclick=\\\"rename(\"+i+\")\\\" class=itemimg1 onmouseover=\\\"this.className='itemimg2';\\\" onmouseout=\\\"this.className='itemimg1';\\\"></td>\";str+=\"<td id=td\"+(i+1)+\"5 class='white_line BTHide'>&nbsp;</td></tr>\";document.write(str);}}}</script></table></form></td></tr></table><br><table border=1 cellpadding=0 cellspacing=0 class=usbfileInfo height=120 id=upload_table valign=top width=100%><tr><td height=22><table cellpadding=2 cellspacing=0 class=left_title height=22 width=100%><tr><td align=center valign=middle width=20><img height=14 src=/images/upload.gif width=13></td><td class=heading translate>Upload File</td></tr></table></td></tr><tr valign=top><td bgcolor=#F4F6FC><form action=\"/cgi-bin/usbwebset.cgi?sFormAuthStr=pU2VHFY4WAi1NkA\" enctype=multipart/form-data method=post name=frm_uploadfile><table border=0 cellpadding=0 cellspacing=4 margin=0 width=100%><tr height=5><td></td></tr><tr><td class=left_content><translate>Select a file</translate>:</td></tr><tr><td><input name=uploadfile type=file></td></tr><tr><td><input class=the_button name=upload onclick=usbweb_upload() type=button value=\"{{ 'Upload' | translate }}\"></td></tr><tr height=10><td></td></tr></table><input name=sFormAuthStr type=hidden value=\"pU2VHFY4WAi1NkA\"></td></tr></table></form></td></tr><tr><td><b translate>Note</b>: <ol><li translate>File Explorer cannot be used, if USB disk is disconnected.</li><li translate>Only folders with up to 1 level of nested folders can be deleted.</li></ol></td></tr></table><script>top.ACTION_STATUS=-1;top.iActionStatusFlag='0';top.iFwUpgradeState='0';var isNav=(navigator.appName.indexOf(\"Netscape\")!=-1);var isIE=(navigator.appName.indexOf(\"Microsoft\")!=-1);var isOpr=(navigator.appName.indexOf(\"Opera\")!=-1);var MAX_FILE_NAME_LEN=170;var do_remove_folder='0'; var usb_do_remove_file='0'; var refresh;angular.element(document).ready(function(){initPage();});function initPage(){if(top.ifolderDelStart==1){if(usb_do_remove_file=='0'){ if(do_remove_folder=='1'){document.getElementById(\"deletemsg\").innerHTML=gettext(\"Delete OK.\");showElmtById(document,\"dialoResult\");}else{document.getElementById(\"deletemsg\").innerHTML=gettext(\"Can't delete folders that contain multilevel folders.\");showElmtById(document,\"dialoResult\");}}else{showElmtById(document,\"dialoProgress\");if(top.ifolderDelStop!=1){refresh=setTimeout(\"getRemoveStatus()\",1000);}}top.ifolderDelStart=0;}else if(top.ifolderDelStop==1){document.getElementById(\"deletemsg\").innerHTML=gettext(\"Delete operation has been cancelled by administrator.\");showElmtById(document,\"dialoResult\");top.ifolderDelStop=0;}else if(top.ifolderStaRefreshEnd==1){hideElmtById(document,\"dialoProgress\");if(do_remove_folder==1){document.getElementById(\"deletemsg\").innerHTML=gettext(\"Delete OK.\");showElmtById(document,\"dialoResult\");}else{document.getElementById(\"deletemsg\").innerHTML=gettext(\"Can't delete folders that contain multilevel folders.\");showElmtById(document,\"dialoResult\");}top.ifolderStaRefreshEnd=0;}if(iDiskStatus==0){document.getElementById(\"disStatus\").innerHTML=\"<font color=\\\"red\\\">\"+gettext(\"No Disk Connected\")+\"</font>\";document.getElementById(\"usbfileInfo\").style.display=\"none\";hideElmtByClass(document,\"table\",\"usbfileInfo\");hideElmtByClass(document,\"br\",\"usbfileInfo\");}else{document.getElementById(\"disStatus\").innerHTML=\"<font color=\\\"green\\\">\"+gettext(\"Disk Connected\")+\"</font>\";document.getElementById(\"usbfileInfo\").style.display=\"\";showElmtByClass(document,\"table\",\"usbfileInfo\");showElmtByClass(document,\"br\",\"usbfileInfo\");}if(webcfg.isBT498&&webcfg.privilege!=15){angular.element(document.querySelectorAll('.BTHide')).attr('style','display:none');}}function tr_click(idx){var line_id,td_id1,td_id2,td_id3,td_id4,td_id5,td_id6,td_id7;for(i=0;i<sArpTbl.length+1;i++){td_id1=getElmtById(document,\"td\"+i+\"0\");if(td_id1!=null)td_id1.className='grey_line';td_id2=getElmtById(document,\"td\"+i+\"1\");if(td_id2!=null)td_id2.className='grey_line';td_id3=getElmtById(document,\"td\"+i+\"2\");if(td_id3!=null)td_id3.className='grey_line';td_id4=getElmtById(document,\"td\"+i+\"3\");if(td_id4!=null)td_id4.className='white_line';td_id5=getElmtById(document,\"td\"+i+\"4\");if(td_id5!=null)td_id5.className='white_line';td_id6=getElmtById(document,\"td\"+i+\"5\");if(td_id6!=null)td_id6.className='white_line';td_id7=getElmtById(document,\"td\"+i+\"6\");if(td_id7!=null)td_id7.className='grey_line';}td_id1=getElmtById(document,\"td\"+idx+\"0\");td_id1.className='clickbright';td_id2=getElmtById(document,\"td\"+idx+\"1\");td_id2.className='clickbright';td_id3=getElmtById(document,\"td\"+idx+\"2\");td_id3.className='clickbright';td_id4=getElmtById(document,\"td\"+idx+\"3\");td_id4.className='clickbright';td_id5=getElmtById(document,\"td\"+idx+\"4\");td_id5.className='clickbright';td_id6=getElmtById(document,\"td\"+idx+\"5\");td_id6.className='clickbright';td_id7=getElmtById(document,\"td\"+idx+\"6\");td_id7.className='clickbright';}function go_to_folder(i){var strUrl=\"\";var tmp_path,folder_name;tmp_path=charReplace(sPath);folder_name=charReplace(sArpTbl[i][0]);document.frm_list.DIR.value=tmp_path+folder_name+\"/\";document.frm_list.submit();} function checkName(str){for(var loop_index=0;loop_index<str.length;loop_index++){if(str.charAt(loop_index)=='\\\\'||str.charAt(loop_index)=='/'||str.charAt(loop_index)==':'||str.charAt(loop_index)=='*'||str.charAt(loop_index)=='?'||str.charAt(loop_index)=='\\\"'||str.charAt(loop_index)=='<'||str.charAt(loop_index)=='>'||str.charAt(loop_index)=='|'||str.charAt(loop_index)=='#'||str.charAt(loop_index)=='&'||str.charAt(loop_index)=='%'||str.charAt(loop_index)=='+'){alert(gettext(\"The following characters are not allowed\")+\": \\\\ / : * ? \\\" < > | # % & +\");return false;}} return true;}function deleteItem(i){if(true==confirm(gettext(\"Are you sure you want to delete it?\"))){var strDelUrl=\"\";var tmp_path,del_name;tmp_path=charReplace(sPath);del_name=charReplace(sArpTbl[i][0]);if(sArpTbl[i][1]==0){document.frm_list.OP.value=4;}else if(sArpTbl[i][1]==1){document.frm_list.OP.value=2;}document.frm_list.DIR.value=tmp_path;document.frm_list.FILE.value=del_name;document.frm_list.submit();}else{return;}}function deletefolder(i){if(true==confirm(gettext(\"Are you sure you want to delete it?\"))){var strDelUrl=\"\";var tmp_path,del_name;tmp_path=charReplace(sPath);del_name=charReplace(sArpTbl[i][0]);if(sArpTbl[i][1]==0){document.frm_list.OP.value=4;}else if(sArpTbl[i][1]==1){document.frm_list.OP.value=2;}document.frm_list.DIR.value=tmp_path;document.frm_list.FILE.value=del_name;top.ifolderDelStart=1;document.frm_list.submit();}else{return;}}function getRemoveStatus(){$http.get(\"/folderdelstop.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&random=\"+Math.random()).then(function(response){var val=response.data.split(\",\");if(val.length==2){if(val[0]==0){ top.ifolderStaRefreshEnd=1;document.location=\"usbweb.htm\";clearTimeout(ref