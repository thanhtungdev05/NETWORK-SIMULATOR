            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css></head><body class=ng-cloak onload=initParameter()><table align=center border=0 cellpadding=0 cellspacing=0 width=700><script> var sPresetModel='2927';</script><tr><td><b parent=\"{{ 'Applications' | translate }}\" sub-title translate>UPnP</b><hr><form action=/cgi-bin/v2x00.cgi method=post name=frm1><table align=center border=1 cellspacing=0 width=700><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=700><tr><td><input name=chxUPNP onClick=onChxAct() type=checkbox value=1><translate>Enable UPnP Service</translate><td><td><select id=iface name=WANInterface size=1 style=display:none><option translate value=0>Default WAN</option><option value=1>{{ 'WAN' | translate }}1</option><option value=2>{{ 'WAN' | translate }}2</option></select></td></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 width=400><tr><td><input name=chxConnection type=checkbox value=1><translate>Enable Connection Control Service</translate></td></tr><tr><td><input name=chxStatus type=checkbox value=1><translate>Enable Connection Status Service</translate></td></tr></table></td></tr></table><br><textarea id=upnp_init style=display:none>\n    var sPresetModel = '2927';\n    if (sPresetModel == \"2962\" || sPresetModel == \"3910\"){\n        var port_type_array = [(nil)];\n    }\n</textarea><script>var upnp_initScript=document.createElement(\"script\");upnp_initScript.text=upnp_init.value;document.head.appendChild(upnp_initScript);var PORT_TYPE={LAN:0,WAN:1};</script><div><b translate>Note</b>: <ol><li translate>To allow NAT pass-through to a UPnP enabled client the connection control service must also be enabled.</li><li ng-show=\"sPresetModel == '130'\" translate>If you intend running UPnP service inside your LAN, you should check the appropriate service above.</li><li ng-show=\"sPresetModel == '2962' || sPresetModel == '3910'\" translate>CAUTION: due to vulnerabilities CVE-2020-12695, UPnP is not considered safe to use. Use it at your own risk.</li></ol></div><br><table align=center width=100%><tr align=center><td><input class=btnw name=btnOK onClick=submitPara() type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnClr onClick=onbtnClr() type=button value=\"{{ 'Clear' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnCcl onClick=onbtnCcl() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table><br><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"><input name=fid type=hidden value=48></form></td></tr></table><script src=\"/js/variable.js?35932\"></script><script>top.ACTION_STATUS=-1;top.iActionStatusFlag='1';top.iFwUpgradeState='0';top.act_sta.damage_alert();var f=document.frm1,bg=parent;var iBwanNumber=parseInt('6');var iFixWanNum=parseInt('4');var iUSBWAN=parseInt('1');var iUSBNum=parseInt('2');var iSecUsbNum=parseInt('1');var idx_2nd_usb=iFixWanNum+iUSBNum-iSecUsbNum;var sPresetModel='2927';var iWanInterface='0';var bNewWLWAN=parseInt('1');var bWless=parseInt('0');var bDualWless5G=parseInt('0');var sLTEmodulename='LTE';var ssi_upnp_enable=((Math.floor(parseInt('0')/4)&Math.floor(0x80000000/4))>0)?1:0;var ssi_upnp_connect=((Math.floor(parseInt('0')/4)&Math.floor(0x01000000/4))>0)?1:0;var ssi_upnp_status=((Math.floor(parseInt('0')/4)&Math.floor(0x02000000/4))>0)?1:0;angular.element(document).ready(function(){$scope.sPresetModel=sPresetModel;$scope.$apply();});function onbtnCcl(){ document.location='/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=2007';}function onbtnClr(){if(confirm(gettext(\"Are you sure you want to clear?\"))){if('(nil)'=='1'){bg.setVle2Elmt(f.chxUPNP,1,0);bg.setVle2Elmt(f.chxConnection,1,0);bg.setVle2Elmt(f.chxStatus,1,0);}else{bg.setVle2Elmt(f.chxUPNP,0,0);bg.setVle2Elmt(f.chxConnection,0,0);bg.setVle2Elmt(f.chxStatus,0,0);}bg.setVle2Elmt(f.WANInterface,0,0);submitPara();}}function onChxAct(){bg.cpntCtrl(f.chxUPNP,f,f.chxConnection,2);}function initParameter(){if(sPresetModel!='2760'&&sPresetModel!='130')bg.showElmtById(document,\"iface\");if(sPresetModel==\"2962\"||sPresetModel==\"3910\"){var idx=1;for(var i=0;i<=port_type_array.length;i++){if(port_type_array[i]==PORT_TYPE.WAN){f.WANInterface.options[idx++]=new Option(TR('WAN')+(i+1),i+1);}}}else{if(bg.SHOW_WAN_WAN2){for(var wani=2;wani<iBwanNumber;wani++){if(top.notSupportWAN.indexOf(wani)!=-1)continue;if(iUSBNum==2&&iSecUsbNum==0&&idx_2nd_usb==(wani+1))continue;if(bNewWLWAN&&(wani==2||wani==3)&&!bWless&&!bDualWless5G)continue;else if(bNewWLWAN&&wani==3&&!bDualWless5G)continue;var op=f.WANInterface.options.length;if(((wani==2&&!parseInt('1'))||(wani==4&&parseInt('1')))&&(parseInt('0')))f.WANInterface.options[op]=new Option(gettext(sLTEmodulename),wani+1);else f.WANInterface.options[op]=new Option(gettext('WAN')+(wani+1),wani+1);}}else if(sPresetModel=='2110'||sPresetModel=='2710'){f.WANInterface.options[2]=new Option(gettext('Backup WAN'),2);}else if(sPresetModel=='2133'||sPresetModel=='2132'||sPresetModel=='2135'){f.WANInterface.options[2]=new Option(gettext('WAN')+\"3\",3);}else{f.WANInterface.options[2]=null;}}bg.setVle2Elmt(f.chxUPNP,ssi_upnp_enable,0);bg.setVle2Elmt(f.chxConnection,ssi_upnp_connect,0);bg.setVle2Elmt(f.chxStatus,ssi_upnp_status,0);bg.cpntCtrl(f.chxUPNP,f,f.chxConnection,2);bg.setVle2Elmt(f.WANInterface,iWanInterface,0);}function submitPara(){ if((bg.getVleFromElmt(f.chxUPNP,0)==ssi_upnp_enable)&&(bg.getVleFromElmt(f.chxConnection,0)==ssi_upnp_connect)&&(bg.getVleFromElmt(f.chxStatus,0)==ssi_upnp_status)&&(bg.getVleFromElmt(f.WANInterface,0)==iWanInterface)){document.location.href='/doc/upnp.htm';return;}f.submit();}</script></body></html>"
