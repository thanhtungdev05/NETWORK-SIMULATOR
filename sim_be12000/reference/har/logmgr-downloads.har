g_path + encodeURIComponent(files[hierarchy]) + \"/\";\nurl = url + g_path;\nprepareCloseNewDiv();\nloadXMLDoc(url, g_browseIndex);\n}\nwindow.cdDir = cdDir;\nfunction getHref(id, strmethod, str, css)\n{\nreturn (\"<a\" + ' '+ \"href=\\\"javascript:void(0)\\\" class=\\\"hreftext \" + css + \"\\\" onmouseup=\\\"\"+ strmethod + \"\\\" id=\\\"\"\n+ id + \"\\\">\" + str+ \"</a>&nbsp;&nbsp;\");\n}\nfunction popNewDiv(divID)\n{\nvar newDiv = document.createElement(\"div\");\nnewDiv.id = divID;\nnewDiv.className = \"DMSPathDiv\";\n$(\".formTbl\").append(newDiv);\n}\nfunction showFile(divID)\n{\nvar newDiv = document.getElementById(divID);\ntempStr = g_file;\nif(g_file.length > 0)\n{\nvar file = \"file\";\nwhile(tempStr.length != 0)\n{\nvar fileStr = getPathOrFile();\nvar fileStrTrans = $('<span></span>').text( fileStr ).html();\nif(fileStr.length == 0)\n{\nreturn;\n}\nfiles.push(fileStr);\nhierarchy = files.length - 1;\nstrmethod = \"cdDir(\" + hierarchy + \")\";\nvar newFile = document.createElement(file + hierarchy);\nnewFile.innerHTML = getHref(file + hierarchy, strmethod, fileStrTrans,\"\");\nnewFile.innerHTML = \"<p>\" + newFile.innerHTML + \"</p>\";\nnewDiv.appendChild(newFile);\n}\n}\n}\nfunction showPath(divID)\n{\nvar path = \"path\";\nvar newDiv = document.getElementById(divID);\nvar num = 0;\nvar pathStr = rootPath;\nvar rootPathLen = 0;\nif(\"/\" == rootPath)\n{\nrootPathLen = 1;\n}\nelse\n{\nrootPathLen = rootPath.length + 1;\n}\ntempStr = g_path;\npaths.length = 0;\nvar newPath = document.createElement(path);\nnewPath.innerHTML = \"<label>\"+\"Media Source Path: \"+\"</label>\";\nnewDiv.appendChild(newPath);\npaths.push(pathStr);\nvar hierarchy = 0;\nvar strmethod = \"changeDir(\" + hierarchy + \")\";\nnewPath.innerHTML += getHref(path, strmethod, pathStr,\"\");\nnewDiv.appendChild(newPath);\ntempStr = tempStr.substring(rootPathLen, tempStr.length);\nwhile(tempStr.length != 0)\n{\npathStr = getPathOrFile();\nvar pathStrTrans = $('<span></span>').text( pathStr ).html();\nif(pathStr.length == 0)\n{\nbreak;\n}\npaths.push(pathStr);\nhierarchy = paths.length - 1;\nstrmethod = \"changeDir(\" + hierarchy + \")\";\nnewPath = document.createElement(path + hierarchy);\nnewPath.innerHTML = \"/\";\nnewPath.innerHTML += getHref(path + hierarchy, strmethod, pathStrTrans,\"\");\nnewDiv.appendChild(newPath);\n}\n}\nfunction showButton(divID)\n{\nvar newDiv = document.getElementById(divID);\nvar newSelect = document.createElement(\"button\");\nnewSelect.className = \"Button BrowseBtn\";\nnewSelect.innerHTML = \"Confirm\";\nnewSelect.onclick = function()\n{\nsetPath();\nprepareCloseNewDiv();\nreturn false;\n}\nnewDiv.appendChild(newSelect);\nvar newNbsp = document.createElement(\"e\");\nnewNbsp.innerHTML = \"&nbsp;&nbsp;\";\nnewDiv.appendChild(newNbsp);\nvar newQuit = document.createElement(\"button\");\nnewQuit.className = \"Button BrowseBtn\";\nnewQuit.innerHTML = \"Quit\";\nnewQuit.onclick = function()\n{\nprepareCloseNewDiv();\nreturn false;\n}\nvar newDiv = document.getElementById(divID);\nnewDiv.appendChild(newQuit);\nvar newBr = document.createElement(\"d\");\nnewBr.innerHTML = \"<br/>\";\ndocument.getElementById(divID).appendChild(newBr);\n}\nfunction IsDisableButton(Tag)\n{\n$(\"input[class^=Button]\",$(\".formTbl\")).each(function(){\nvar obj = $(this);\nif(true==Tag)\n{\nobj.addClass(\"disableBtn\");\n}\nelse\n{\nobj.disableButton(false);\n}\n});\n}\nfunction openNewDiv(divID, str)\n{\nprepareOpenNewDiv(str);\nif ($(\"#\"+divID).length)\n{\n$(\"#\"+divID).remove();\n}\nIsDisableButton(true);\npopNewDiv(divID);\nif(g_path != rootPath)\n{\nshowPath(divID);\n}\nvar newBr = document.createElement(\"d\");\nnewBr.innerHTML = \"<br/>\";\ndocument.getElementById(divID).appendChild(newBr);\nvar newHR=document.createElement(\"hr\");\nnewHR.className = \"hr0\";\ndocument.getElementById(divID).appendChild(newHR);\nshowFile(divID);\nshowButton(divID);\n}\njQuery.validator.addMethod(\n\"PathMatch\",\nfunction(value, element, params) {\nif(value.match(\"[|:*?\\\"<>]\") != null || value.indexOf(\"\\\\\") != -1)\n{\nreturn false;\n}\nreturn true;\n},\n\"please do not contain special characters, such as |:*?\\\"<>\\\\\\\\. \"\n);\nfunction initial_template_DMS(templateID)\n{\ntemplate = $(\"#\"+templateID);\nvar PathCheckRules = {\n\"utf8\": true,\n\"PathMatch\":true,\n\"utf8LengthRange\":[0,255]\n};\nvar instForm = template.find(\"form\");\nvar checkJSONTempObj = {\n\"rules\": {\n\"DmsName\": {\n\"ASCII\": true,\n\"required\": true,\n\"rangelength\":[1,128]\n},\n\"RescanTimeValue\": {\n\"integer\": true,\n\"required\": true,\n\"range\":[1,1440]\n},\n\"Path0\": PathCheckRules,\n\"Path1\": PathCheckRules,\n\"Path2\": PathCheckRules,\n\"Path3\": PathCheckRules\n},\n\"messages\": {\n}\n};\nvar data = {};\ndata.checkJSONTemp = checkJSONTempObj;\ndata.temp = template;\n$.callModifier(\"/DmsConf/checkData\",data);\ninstForm.validate(checkJSONTempObj);\ntemplate.bind(\"fillDataByApplyResult\", function(event,xml, template){\nActionByApplyResult(xml, template);\n});\ntemplate.bind(\"fillDataByCancelResult\", function(event,xml, template){\nvar templateID = template.attr(\"id\");\nvar isError = template.hasError(xml);\nif (isError == 0)\n{\nvar OBJID = [\"OBJ_DMS_ID\"];\nChanegeDataByCustom(xml);\ntemplate.fillDataByOBJID(xml ,OBJID, template,0);\n$(\"#RescanTime\").change();\n}\n});\ntemplate.bind(\"PostDataChangeByCustom\", function(event, NameValueJson){\nvar ElemsID = NameValueJson.ElemsMainID;\nif (ElemsID == \"ContentList\")\n{\nvar contentList = \"\";\nvar subpath = \"\";\nfor(var i = 0; i < 4; i++)\n{\nsubpath = $(\"#Path\"+i).val();\nif(\"\" != subpath)\n{\ncontentList = contentList + subpath + \"|\";\n}\n}\nNameValueJson.ElemsValue = contentList;\n}\nif(ElemsID == \"RescanTime\")\n{\nif(\"1\" == NameValueJson.ElemsValue)\n{\nNameValueJson.ElemsValue = $(\"#RescanTimeValue\").val();\n}\n}\n});\n$(\"#RescanTime\").change(function(){\nvar RescanTimeValue = $(\"#RescanTime\").val();\nif(\"1\"==RescanTimeValue)\n{\n$(\"#TR_RescanTimeValue\").slideDown();\n$(\"#TR_RescanTimeValue\").removeClass(\"PostIgnore\");\n}\nelse\n{\n$(\"#TR_RescanTimeValue\").hide();\n$(\"#TR_RescanTimeValue\").addClass(\"PostIgnore\");\n}\nvar TimeValue = $(\"#RescanTimeValue\").val();\nif(\"\" != TimeValue)\n{\ninstForm.validate().element($(\"#RescanTimeValue\"));\n}\n});\n$(\"[id^='Browse']\").click(function(){\nif ($(this).hasClass(\"disableBtn\"))\n{\nreturn;\n}\nvar DMSURL = \"\";\nvar index = \"\";\nvar ElemsID=$(this).attr(\"id\");\nindex = ElemsID.substring(ElemsID.length-1,ElemsID.length);\nDMSURL = \"/?_type=menuData&_tag=dms_querydir_lua.lua&querydir=\" + rootPath;\nif('/' != DMSURL.charAt(DMSURL.length - 1))\n{\nDMSURL = DMSURL + \"/\";\n}\nloadXMLDoc(DMSURL, index);\n});\n}\nfunction ChanegeDataByCustom(xml)\n{\nvar ToOperParaArr = {\n\"PathRoot\" : {ValueOrigin: \"\"},\n\"RescanTime\" : {\nValueOrigin: \"\",\nsetAction: function(ParaNameSel, ParaValSel, SelfVal){\nif( (\"-1\" != SelfVal) && (\"0\" != SelfVal) )\n{\n$(\"#RescanTimeValue\").val(SelfVal);\nParaValSel.text(\"1\");\n}\n}\n},\n\"ContentList\" : {ValueOrigin: \"\"}\n};\nxmlParaInInstOperate(xml, \"OBJ_DMS_ID\", 0, ToOperParaArr);\nrootPath = ToOperParaArr.PathRoot.ValueOrigin;\nif ( \"\" == rootPath )\n{\nrootPath = \"/\";\n}\ng_path = rootPath;\nvar contentList = ToOperParaArr.ContentList.ValueOrigin;\n$(\"input[id^='Path']\",$(\".form_content\")).each(function(){\nvar obj = $(this);\nobj.val(\"\");\n});\nif('|' == contentList.charAt(0))\n{\ncontentList = contentList.substring(1, contentList.length);\n}\nfor(var i = 0; (i < 4) && (contentList != \"\"); i++)\n{\nif(-1 == contentList.indexOf(\"|\"))\n{\n$(\"#Path\"+i).val(contentList);\nbreak;\n}\nelse\n{\nvar pathStr = contentList.substring(0, contentList.indexOf(\"|\"));\n$(\"#Path\"+i).val(pathStr);\ncontentList = contentList.substring(contentList.indexOf(\"|\") + 1,\ncontentList.length);\n}\n}\n};\n$(document).ready(function(){\nvar HeadID = \"DMS\";\nvar Head = $(\"#\"+HeadID);\nvar templateID = \"template_\"+ HeadID;\nvar ServerAddr = $(\"address span\", Head).text();\ninitial_template_DMS(templateID);\nHead.succfunction = function(xml){\nHead.hasError(xml,\"externErrorHint\");\nChanegeDataByCustom(xml);\nvar OBJID = [\"OBJ_DMS_ID\"];\nHead.fillDataByOBJID(xml, OBJID, $(\"#DMS_container\"), 0);\n$(\"#RescanTime\").change();\n};\nif ( $(\".collapBarWithDataTrans\",Head).length <= 0 )\n{\nHead.dataTransfer(ServerAddr,\n\"GET\",\nHead.succfunction);\n}\nelse\n{\ninitial_collapBarWithDataTrans(Head);\n}\n})\n})();\n</script>\n\n<div id=\"DMS\" class=\"HeadDIV\">\n<address style=\"display:none\">\n<span class=\"form-action\">/?_type=menuData&_tag=dms_dms_lua.lua</span>\n</address>\n<div class=\"externErrorHint\" style=\"display:none;\">\n<span class=\"caption1\"></span>\n</div>\n<div id=\"template_DMS\">\n<h1 class=\"collapBarWithDataTrans\" id=\"DMSBar\">DMS/DLNA</h1>\n<div id=\"DMS_container\">\n<input type=\"hidden\" id=\"DataHasBeenGot\" value=\"0\">\n<div class=\"formTblWrap\">\n<div class=\"errorHint\" style=\"display:none;\">\n<span class=\"caption1\"></span>\n</div>\n<div class=\"succHint\" style=\"display:none;\">\n<span class=\"caption1\">Your data have been stored!</span>\n</div>\n<div class=\"formTbl\">\n<form class=\"form_content\">\n<input type=\"hidden\" id=\"_InstID\" value=\"\">\n<input type=\"hidden\" id=\"ContentList\" value=\"\">\n<div class=\"row\">\n<label for=\"Enable\" class=\"cfgLabel w180\">DMS</label>\n<div class=\"right\" id=\"Enable\">\n<input type=\"radio\" id=\"Enable1\" name=\"Enable\" value=\"1\"/><label for=\"Enable1\">On</label>&nbsp;&nbsp;&nbsp;&nbsp;\n<input type=\"radio\" id=\"Enable0\" name=\"Enable\" value=\"0\"/><label for=\"Enable0\">Off</label>\n</div>\n</div>\n<div class=\"row\">\n<label for=\"DmsName\" class=\"cfgLabel w180\">DMS Name</label>\n<div class=\"right\">\n<input type=\"text\" id=\"DmsName\" name=\"DmsName\" value=\"\" class=\"inputNorm\">\n<span id=\"RangeDmsName\" style=\"display: none;\">Length: 1~128</span>\n</div>\n</div>\n<div class=\"row\">\n<label for=\"RescanTime\" class=\"cfgLabel w180\">Library Rescan Method</label>\n<div class=\"right\">\n<select id=\"RescanTime\" name=\"RescanTime\" class=\"selectNorm\">\n<option value=\"-1\" title=\"Disabled\">Disabled</option>\n<option value=\"0\" title=\"Auto\">Auto</option>\n<option value=\"1\" title=\"Customized\">Customized</option>\n</select>\n</div>\n</div>\n<div class=\"row\" id=\"TR_RescanTimeValue\">\n<label for=\"RescanTimeValue\" class=\"cfgLabel w180\">Rescan Cycle</label>\n<div class=\"right\">\n<input type=\"text\" class=\"PostIgnore inputNorm\" id=\"RescanTimeValue\" name=\"RescanTimeValue\" value=\"\">min\n<span style=\"display: none;\">Range: 1~1440</span>\n</div>\n</div>\n<div class=\"row\">\n<label for=\"Path0\" class=\"cfgLabel w180\">Media Source1</label>\n<div class=\"right\">\n<input type=\"text\" class=\"PostIgnore inputNorm\" id=\"Path0\" name=\"Path0\" value=\"\">&nbsp;&nbsp;\n<input type=\"button\" class=\"Button BrowseBtn PostIgnore\" id=\"Browse0\" name=\"Browse0\" value=\"Browse\"/>\n</div>\n</div>\n<div class=\"row\">\n<label for=\"Path1\" class=\"cfgLabel w180\">Media Source2</label>\n<div class=\"right PostIgnore\">\n<input type=\"text\" class=\"PostIgnore inputNorm\" id=\"Path1\" name=\"Path1\" value=\"\">&nbsp;&nbsp;\n<input type=\"button\" class=\"Button BrowseBtn PostIgnore\" id=\"Browse1\" name=\"Browse1\" value=\"Browse\"/>\n</div>\n</div>\n<div class=\"row\">\n<label for=\"Path2\" class=\"cfgLabel w180\">Media Source3</label>\n<div class=\"right PostIgnore\">\n<input type=\"text\" class=\"PostIgnore inputNorm\" id=\"Path2\" name=\"Path2\" value=\"\">&nbsp;&nbsp;\n<input type=\"button\" class=\"Button BrowseBtn PostIgnore\" id=\"Browse2\" name=\"Browse2\" value=\"Browse\"/>\n</div>\n</div>\n<div class=\"row\">\n<label for=\"Path3\" class=\"cfgLabel w180\">Media Source4</label>\n<div class=\"right PostIgnore\">\n<input type=\"text\" class=\"PostIgnore inputNorm\" id=\"Path3\" name=\"Path3\" value=\"\">&nbsp;&nbsp;\n<input type=\"button\" class=\"Button BrowseBtn PostIgnore\" id=\"Browse3\" name=\"Browse3\" value=\"Browse\"/>\n</div>\n</div>\n</form>\n<div class=\"buttongroup\">\n<input type=\"button\" class=\"Button Btn_cancel\" id=\"Btn_cancel\" name=\"Btn_cancel\" value=\"Cancel\" />\n<input type=\"button\" class=\"Button Btn_apply\" id=\"Btn_apply\" name=\"Btn_apply\" value=\"Apply\" />\n</div>\n</div>\n</div>\n</div>\n</div>\n</div>\n\n</div>\n</div>\n</div>\n</div>\n\n<script type=\"text/javascript\">\nfunction classMenuARIA() {\nvar class1Container = $(\"#mn_li\");\nvar class2Container = $(\"#class2Menu\");\nvar class2MenuItem = $(\"#class2MenuItem\");\nvar class2MenuListObj = $(\"#class2MenuItem ul li a\", class2Container);\nvar class3Container = $(\"#class3Menu\");\nvar class3MenuItem = $(\"#class3Menu ul\");\nvar class3MenuListObj = $(\"#class3MenuMainContent ul li p\", class3Container);\nvar selected3Menu = $(\".AEleMenu3Selected\", $(\"#class3MenuMainContent\"));\nvar selected2Menu = $(\".selectClass2Menu\", class2Container);\nvar selected1Menu = $(\".SelectMenuItem\", class1Container);\nvar initialTitle = '\\x46\\x38\\x37\\x32\\x38\\x44';\nsetARIAAttr(selected1Menu, \"aria-current\", \"page\");\nsetARIAAttr(selected2Menu, \"aria-current\", \"page\");\nsetARIAAttr(selected3Menu, \"aria-selected\", true);\nsetARIAAttr(class3MenuItem, \"role\", \"tablist\");\nsetARIAAttr(class3MenuListObj, \"role\", \"tab\");\nsetARIAAttr(class3MenuListObj, \"tabindex\", \"0\");\nvar current2MenuIrtem;\nif (class3MenuListObj.length > 0) {\ncurrent2MenuIrtem = $(\".selectClass2Menu\", class2Container);\n$(\".tabContent\").attr(\"role\", \"main\");\n$(\"#page_content\").removeAttr(\"role\");\nvar newTitle = [selected3Menu.text().trim(), selected2Menu.text().trim(), selected1Menu.text().trim()]\n.filter(Boolean).join(' - ') + \" - \" + initialTitle;\nupdatePageTitle(newTitle);\nselected3Menu.focus();\nclass3MenuListObj.on('k