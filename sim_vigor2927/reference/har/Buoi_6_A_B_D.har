            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'NAT' | translate }}\" sub-title translate>Port Redirection</b><hr><form action=/cgi-bin/ipnat.cgi method=post name=frm1><table align=center cellpadding=2 cellspacing=0 width=700px><tr><td><b><translate>Index No.</translate>&nbsp;1</b></td></tr></table><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><input name=sPSrvEnable type=checkbox value=1>&nbsp;<translate>Enable</translate></td></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 width=90%><tr><td translate width=30%>Mode</td><td><select name=sPSrvMode onchange=onChgMode()><option translate value=0>Single</option><option translate value=1>Range</option></select></td></tr><tr><td translate>Service Name</td><td><input maxlength=23 name=sPSrvSvcName ng-model=sPSrvSvcName></td></tr><tr><td translate>Protocol</td><td><select name=sPSrvProto><option translate value=6 ||>TCP</option><option translate value=17>UDP</option></select></td></tr><tr><td translate>WAN Interface</td><td><select name=sltWanIfIdx onChange=onChgWanIfIdx()><option ng-repeat=\"opt in wanIntfInfo\" value={{opt.idx}}>{{opt.txt}}</option></select></td></tr><tr class=wanip><td translate>WAN IP</td><td><select name=sPSrvWANIP><option translate value=-2>All</option><option translate value=-3>VPN</option></select></td></tr><tr><td translate>Public Port</td><td><input maxlength=5 name=sPSrvPubPort onblur=onblPubPort() size=5 type=text value=\"0\"><span class=range>-<input maxlength=5 name=sPSrvPubPortTo onblur=onblPubPortTo() size=5 type=text></spa