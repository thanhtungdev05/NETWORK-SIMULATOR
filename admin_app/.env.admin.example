# =============================================================
# Biến môi trường cho Django Admin Panel (FTC)
# Copy thành .env hoặc set trực tiếp trên Render > Environment
# =============================================================

# Bắt buộc: mật khẩu cho tài khoản admin đầu tiên
DJANGO_SUPERUSER_PASSWORD=MatKhauBiMat123!

# Tuỳ chọn: username và email admin (mặc định: admin / admin@ftc.local)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@ftc.local

# Secret key cho Django (đổi thành chuỗi ngẫu nhiên dài ≥50 ký tự)
DJANGO_SECRET_KEY=thay-bang-chuoi-ngau-nhien-dai-hon-50-ky-tu-day

# Chế độ debug (tắt trên production)
DJANGO_DEBUG=0

# Port Django Admin (không expose ra ngoài, chỉ proxy nội bộ)
DJANGO_PORT=8083

# DATABASE_URL đã được kế thừa từ PHP API — không cần đặt lại
# DATABASE_URL=postgresql://...
