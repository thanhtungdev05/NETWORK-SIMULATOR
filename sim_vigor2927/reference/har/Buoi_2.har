\"#e7b309\">'+gettext(caData[1])+'</font></td>';}else if(caData[1]=='OK'){trustCA+='<div class=status-ok></div><font color=\"#25b997\">'+gettext(caData[1])+'</font></td>';}else{trustCA+=caData[1]+'</td>';}trustCA+='<td width=30% align=center>\\\n\t\t\t\t\t<input type=button onclick=\"x509view('+caIdx+')\" value=\"'+gettext(\"View\")+'\">\\\n\t\t\t\t\t<input type=button onclick=\"x509remove('+caIdx+')\" value=\"'+gettext(\"Delete\")+'\">\\\n\t\t\t\t</td>\\\n\t\t\t</tr>';}}); document.querySelectorAll(\"#caCert tbody\")[0].innerHTML=rootCA+trustCA;});angular.element(document).ready(function(){initPage();});function initPage(){if(!parseInt('1')||parseInt('0')||'(nil)'==\"1\"){bg.hideElmtByClass(document,\"tr\",\"x509rootca\");bg.hideElmtById(document,\"notetable\");}angular.element(document.querySelector(\"#notetable a\")).attr(\"href\",'/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=6');} function submitParameter(){}function X509import(){if('(nil)'==\"1\"){winX509Import=window.open(\"/doc/XCaImport.htm\",\"XCaImport\",\"toolbars=no,scrollbars=no, width=600,height=250px,top=150px,left=\"+(screen.width/2-230)+\"px,status=no,menubar=no\");if(winX509Import){winX509Import.focus();}}else{x509import();}}function X509refresh(){var myUrl=\"/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=\"+1220;document.location.href=myUrl;}function x509view(idx){top.CAidx=idx;winX509view=window.open(\"/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=334&certidx=\"+idx,\"XTrustedcaV\",\"scrollbars,width=800,height=500px,top=150px,left=\"+(screen.width/2-400)+\"px\");if(winX509view){winX509view.focus();}}function x509remove(_idx){var myUrl=\"/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=\"+1221+\"&ca_uid=\"+aryajaxtrustca[_idx][2];document.location.href=myUrl;}function x509import(){var myUrl=\"/doc/XCaCfMn.HTM\";document.location.href=myUrl;}function x509RootCreate(_idx){var myUrl=\"/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=\"+1214+\"&ca_uid=\"+aryajaxrootca[_idx][3]