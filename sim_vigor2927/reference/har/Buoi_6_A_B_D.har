            "size": 6538,
            "mimeType": "text/html",
            "compression": 4651,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><script src=\"/cgi-bin/certificatedata.cgi?sFormAuthStr=pU2VHFY4WAi1NkA\"></script><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><title>{{ 'Import X509 Local Certificate' | translate }}</title></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><script> top.printLogo(document,15,gettext('Local Certificate'));</script><tr><td><hr size=1><br><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td align=left><b translate>Import X509 Local Certificate</b></td></tr></table><table align=center border=1 cellPadding=2 cellSpacing=0 width=100%><tr><td><form name=frm1 onsubmit=\"return waitResponse(1)\"><table align=center border=0 cellpadding=0 cellspacing=0 width=100%><tr><td><b translate>Upload Local Certificate</b></td></tr></table><table align=center border=0 cellPadding=2 cellSpacing=0 width=70%><tr><td colspan=2 translate>Select a local certificate file.</td></tr><tr><td align=right width=25%><translate>Certificate file</translate>: </td><td align=left width=75%><input accept=.crt,.cer class=file name=srcfile required size=30 type=file></td></tr><tr><td class=fontcolorblue colspan=2 translate>Click <font>Import</font> to upload the local certificate.</td></tr><tr><td align=left colspan=2 style=text-indent:0.5em><input name=attach type=submit value=\"{{ 'Import' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnCancel onclick=btnCcl() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr><input name=mode type=hidden value=1></table></form><hr size=1><form name=frm2 onsubmit=\"return waitResponse(2)\"><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>Upload PKCS12 Certificate</b></td></tr></table><table align=center border=0 cellPadding=2 cellSpacing=0 width=70%><tr><td colspan=2 translate>Select a PKCS12 file.</td></tr><tr><td align=right width=25%><translate>PKCS12 file</translate>: </td><td align=left width=75%><input accept=.p12 class=file name=p12file required size=30 type=file></td></tr><tr><td align=right width=25%><translate>Password</translate>: </td><td align=left width=75%><input / maxlength=64 name=dpwd required size=22 type=password></td></tr><tr><td class=fontcolorblue colspan=2 translate>Click <font>Import</font> to upload the PKCS12 file.</td></tr><tr><td align=left colspan=2 style=text-indent:0.5em><input name=attach type=submit value=\"{{ 'Import' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnCancel onclick=btnCcl() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr><input name=mode type=hidden value=2></table></form><hr size=1><form name=frm3 onsubmit=\"return waitResponse(3)\"><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>Upload Certificate and Private Key</b></td></tr></table><table align=center border=0 cellPadding=2 cellSpacing=0 width=70%><tr><td colspan=2 translate>Select a certificate file and a matchable Private Key.</td></tr><tr><td align=right width=25%><translate>Certificate file</translate>: </td><td align=left width=75%><input accept=.crt,.cer class=file name=crtfile required size=30 type=file></td></tr><tr><td align=right width=25%><translate>Key file</translate>: </td><td align=left width=75%><input accept=.key class=file name=keyfile onchange=displayKeyInput() required size=30 type=file></td></tr><tr><td align=right width=25%><translate>Password</translate>: </td><td align=left width=75%><input / maxlength=64 name=dpwd ng-disabled=!requirKEY required size=22 type=password></td></tr><tr><td class=fontcolorblue colspan=2 translate>Click <font>Import</font> to upload the local certificate and private key.</td></tr><tr><td align=left colspan=2 style=text-indent:0.5em><input name=attach type=submit value=\"{{ 'Import' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnCancel onclick=btnCcl() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr><input name=mode type=hidden value=3></table></form></td></tr></table></td></tr></table><script>var certname;var locf_name=aryajaxlocca;var certFileReg=new RegExp(/\\.(der|pem|cert|crt|cer)$/i);function checkFileFormat(filename,expression){if(filename.match(expression)){return true;}else{alert(gettext(\"The file format is wrong. Please check it again.\"));return false;}} function ChkCertName(type){var i,keyfile,formatCheck;if(type==2){certname=document.frm2.p12file.value;keyfile=1;formatCheck=checkFileFormat(certname,/\\.(p12|pfx|pkcs12)$/i);}else if(type==3){certname=document.frm3.crtfile.value;keyfile=document.frm3.keyfile.value;formatCheck=checkFileFormat(certname,certFileReg)&checkFileFormat(keyfile,/\\.(key|pem)$/i);}else{return checkFileFormat(document.frm1.srcfile.value,certFileReg);}var str=certname.split(\"\\\\\");var str1=str[str.length-1].split(\".\");for(i=0;i<locf_name.length;i++){if(str1[0]==locf_name[i][0]){alert(gettext(\"The certificate name has been used. Please change the imported file's name.\"));return false;}}return formatCheck;}function displayKeyInput(){if(event.target.files.length){var reader=new FileReader();reader.readAsText(event.target.files[0],\"UTF-8\");reader.onload=function(evt){var contentArray=evt.target.result.split(\"\\n\");var file_header=contentArray[0];if(contentArray[0]==\"-----BEGIN ENCRYPTED PRIVATE KEY-----\"||(contentArray[0]==\"-----BEGIN RSA PRIVATE KEY-----\"&&contentArray[1].match(/Proc-Type.*ENCRYPTED/))){$scope.requirKEY=true;}else{$scope.requirKEY=false;}$scope.$apply();}}else{$scope.requirKEY=false;$scope.$apply();}} function waitResponse(cert_type){var sendData=false;var f;sendData=ChkCertName(cert_type);if(cert_type==1){f=document.frm1;}else if(cert_type==2){f=document.frm2;}else if(cert_type==3){f=document.frm3;}if(sendData){$http.post(\"/x509LoCfIm.cgi?sFormAuthStr=pU2VHFY4WAi1NkA\",new FormData(f),{headers:{'Content-Type':undefined},transformRequest:angular.identity}).then(function(response){mainHandler(parseInt(response.data));return true;});}else{return false;}}function mainHandler(iResp){if(iResp==1){document.location='/doc/XLoCfOK.htm';}else{document.location='/doc/Xfail.htm#error_'+iResp;}}function btnCcl(){ var myUrl=\"/cgi-bin/v2x00.cgi?sFormAuthStr=pU2VHFY4WAi1NkA&fid=1210\";top.main.location.href=myUrl;}angular.element(document).ready(function(){$scope.requirKEY=false;$scope.$apply();angular.element(document.querySelectorAll(\".fontcolorblue font\")).attr(\"color\",\"blue\");});</script></body></html>"
          },
