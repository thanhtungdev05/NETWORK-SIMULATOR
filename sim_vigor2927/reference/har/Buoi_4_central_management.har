          "cookies": [],
          "content": {
            "size": 18790,
            "mimeType": "text/html",
            "compression": 13097,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><title>Firmware Upgrade</title><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css></head><body class=ng-cloak><table align=center border=0 cellPadding=0 cellSpacing=0 width=700px><tr><td colspan=2><b parent=\"{{ 'System Maintenance' | translate }}\" qslink=\"https://www.draytek.com/router-help-redirect?stk_title=System Maintenance&nd_title=Firmware Upgrade\" sub-title translate>Firmware Upgrade</b><hr><form action=\"/WebFwUpgrade.cgi?0&sFormAuthStr=JdvKVyYlhh7GhS9\" enctype=multipart/form-data id=web method=POST name=frm1 target=cfgMain><table align=center border=0 cellPadding=2 cellSpacing=0 ng-if=bFWCheck width=100%><tr><td><b translate>Firmware Version Status</b></td></tr></table><table align=center border=1 cellPadding=2 cellSpacing=0 ng-if=bFWCheck width=100%><tr><td><table align=center border=0 cellPadding=2 cellSpacing=0 width=90%><tr><td colspan=2><translate>Current Firmware Version</translate>: 4.4.5.7</td></tr><tr ng-if=!iBudgetThuis><td><translate>Latest Firmware Version</translate>: {{datarows[0].version}}</td><td style=text-align:right><input ng-click=\"DownloadFW(datarows[0].action, datarows[0].rid)\" ng-if=newFWnum==1 type=button value=\"{{ 'Download Directly' | translate }}\">&nbsp;<input name=attach onclick=CheckLatestFW() type=button value=\"{{ 'Latest Firmware Detail' | translate }}\"></td></tr></table></td></tr></table><table align=center border=0 cellPadding=2 cellSpacing=0 ng-if=!iBudgetThuis width=100%><tr><td class=sup_UK><b translate>Download Link</b>: <a href=https://www.draytek.co.uk/support/downloads target=_blank><font>https://www.draytek.co.uk/support/downloads</font></a></td><td class=sup_Other><b translate>Download Link</b>: <a href=https://www.draytek.com/support/latest-firmwares/ target=_blank><font>https://www.draytek.com/support/latest-firmwares/</font></a></td></tr></table><br><table align=center border=1 cellPadding=2 cellSpacing=0 width=100%><caption style=text-align:left><b translate>Web Firmware Upgrade</b></caption><tr><td><table align=center border=0 cellPadding=2 cellSpacing=0 width=90%><tr><td translate>Select a firmware file.</td></tr><tr><td style=align-items:center;display:flex;padding:0.5rem><input accept=.all,.rst id=fw_file name=data onchange=checkfw() size=60 type=file><div id=fw_size style=margin-left:10px></div></td></tr><tr><td><translate>Click Upgrade to upload the file.</translate> &nbsp;&nbsp;<input name=upfw onclick=waitResponse(0) type=button value=\"{{ 'Upgrade' | translate }}\"> &nbsp;&nbsp;<input name=btnpreview onclick=onPreview() type=button value=\"{{ 'Preview' | translate }}\"> &nbsp;&nbsp;<img id=uploading src=/images/uploading.gif style=\"display:none;vertical-align: middle;\"></td></tr></table></td></tr></table></form><form id=loading name=loading style=display:none><table align=center border=0 cellPadding=2 cellSpacing=0 width=100%><tr><td><b translate>Web Firmware Upgrade</b></td></tr></table><table align=center border=1 cellPadding=10 cellSpacing=0 width=100%><tr><td><table align=center border=0 cellPadding=2 cellSpacing=0 width=100%><tr><td align=center class=red translate>Firmware Upgrade is in progress... It must NOT be interrupted!</td></tr><tr><td align=center><img src=/images/wait.gif></td></tr></table></td></tr></table><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form><form id=fwheaderinfo name=fwheaderinfo style=display:none><table align=center border=0 cellPadding=2 cellSpacing=0 width=100%><tr><td><b translate>Web Firmware Upgrade</b></td></tr></table><table align=center border=1 cellPadding=10 cellSpacing=0 width=100%><tr><td><table align=center border=0 cellPadding=2 cellSpacing=0 width=100%><tr class=newver style=display:none><td align=right width=40%><translate>Model Name</translate>:</td><td width=5%></td><td id=smodelName></td></tr><tr class=newver style=display:none><td align=right><translate>Firmware version</translate>:</td><td width=5%></td><td id=sfwversion></td></tr><tr class=newver id=mdmver style=display:none><td align=right><translate>Modem version</translate>:</td><td width=5%></td><td translate>VDSL2/ADSL</td></tr><tr class=newver id=curmdmver style=display:none><td align=right valign=top><translate>Current version</translate>:</td><td width=5%></td><td id=scurmdmver></td></tr><tr class=newver id=newmdmver style=display:none><td align=right valign=top><translate>Upgrade version</translate>:</td><td width=5%></td><td id=snewmdmver></td></tr><tr id=mdmchgmsg style=display:none><td align=center colspan=3><b translate>Warning: Modem code will be changed.</b></td></tr><tr id=releasemsg style=display:none><td align=center colspan=3><b translate>Warning: This is not a release firmware.</b></td></tr><tr class=oldver style=display:none><td colspan=3><b translate>Warning: This firmware does not have firmware information. It might be an old version firmware.</b></td></tr><tr><td colspan=3></td></tr><tr><td align=center colspan=3><input class=btnw name=btnClose onClick=onClkClose() type=button value=\"{{ 'Close' | translate }}\"></td></tr></table></td></tr></table></form><form action=/cgi-bin/frmup.cgi id=tftp method=POST name=frm2 style=display:none><table align=center border=0 cellpadding=2 cellspacing=0 style=display:none width=100%><tr><td><b translate>TFTP Firmware Upgrade from LAN</b></td></tr></table><table align=center border=1 cellpadding=2 cellspacing=0 style=display:none width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=90%><tr ng-if=!bFWCheck><td><translate>Current Firmware Version</translate>:&nbsp;4.4.5.7</td></tr><tr><td><span ng-if=\"!bFWCheck\"><br></span><b translate>Firmware Upgrade Procedures</b>:<br><ol><li><translate>Click \"OK\" to start the TFTP server.</translate><li><translate>Open the Firmware Upgrade Utility or other 3-party TFTP client software.</translate><li><translate>Check that the firmware filename is correct.</translate><li><translate>Click \"Upgrade\" on the Firmware Upgrade Utility to start the upgrade.</translate><li><translate>After the upgrade is compelete, the TFTP server will automatically stop running.</translate></ol></td></tr><tr><script> var str='<td><b>'+gettext(\"Do you want to upgrade firmware ?\")+'</b>&nbsp;&nbsp;<input class=btnw type=\"submit\" name=\"submit\" value='+gettext(\"OK\")+'></td>';if('0'==1||'0'==1)str='<td align=center><input class=btnw type=\"submit\" name=\"submit\" value='+gettext(\"OK\")+'></td>';document.write(str);</script></tr></table></td></tr></table><tr><td colspan=2 id=fwup_note><b translate>Note</b>: <ol><li translate>Upgrade using the ALL file will retain existing router configuration, whereas using the RST file will reset the configuration to factory defaults.</li><li id=link_note ng-show=\"'(nil)' == '1'\" translate>The local password are encrypted by PBKDF2 hash algorithm, if you'd like to downgrade the firmware to the older version which may not support password encryption, you must do the following actions before uploading the firmware: 1) Disable <a>Password Encryption</a> 2) Update (type and save) the password again.</li><li ng-show=\"webcfg.model == '2962' || webcfg.model == '3910'\" translate>For firmware \"downgrading\", please consider using <a>\"restore backup firmware with config\"</a> to avoid potential config compatibility issue.</li><li ng-show=\"'(nil)' == '1'\" style=\"color: red\" translate>High Availablity is enabled, all HA routers SHOULD use the same firmware.</li></ol></td></tr></td></tr></table></form><textarea id=frmupmaininit style=display:none>\n\tconst iBudgetThuis = 0 == 1;\n\tvar bFWCheck = parseInt('1');\n</textarea><script>var frmupmaininitscript=document.createElement(\"script\");frmupmaininitscript.text=document.getElementById(\"frmupmaininit\").value;document.head.appendChild(frmupmaininitscript);top.ACTION_STATUS=-1;top.iActionStatusFlag='-2';top.iFwUpgradeState='0';top.act_sta.damage_alert();var bg=top;var f1=document.frm1;var f2=document.frm2;var sLatestVerNum;var sFwNameLeading;if((webcfg.model!='2132'&&webcfg.model!='2133')||(!parseInt('0')))sFwNameLeading='V2927';else sFwNameLeading='V2133_GlasOperator_';if(webcfg.model=='2765'&&iBudgetThuis)sFwNameLeading+='_STD_BudgetThuis_\\\\w+'; var aryFileType=[\"all\",\"rst\"]; var mdmval=JSON.parse(\"[0,0,'0','0','0','0']\".replace(/'/g,'\"'));var hasfwheader=1;var modemcodechg=1;var fbit=0;var ReleaseName=\"\",RCName=\"\",ModelName=\"\";var mdmv0=\"\",mdmv1=\"\",mdma0=\"\",mdma1=\"\";var model=\"Vigor2927\";var info_ver=new Array();var sLatestEnVer=[];angular.element(document).ready(function(){initPage();});function initPage(){$scope.iBudgetThuis=iBudgetThuis;$scope.bFWCheck=bFWCheck;$scope.$apply();if(bg.SHOW_SYS_FWUP_TFTP){bg.showElmtById(document,\"tftp\");}var time=new Date();if(model==\"Vigor2760\")model=\"Vigor2760-Delight\";var systemdate=time.getMonth()+'-'+time.getDate();var get_info='https://www.draytek.com.tw/ftp/fwver.php?m='+model+'&date='+systemdate;if(webcfg.cc==\"9\"){get_info='https://www.draytek.co.uk/ftp/fwver.php?m='+model+'&date='+systemdate;}if(webcfg.cc==\"9\"){bg.hideElmtByClass(document,\"td\",\"sup_Other\");}else{bg.hideElmtByClass(document,\"td\",\"sup_UK\");}if(webcfg.isBT498&&webcfg.privilege==8){angular.forEach(document.querySelectorAll(\"input, select\"),function(self){self.disabled=true;});}fetch(get_info).then(res=>{res.text().then(data=>{const script=document.createElement('script');script.text=data;document.head.appendChild(script);initParameter();});});if(webcfg.model==\"2962\"||webcfg.model==\"3910\"){angular.element(document.querySelector(\"#fwup_note a\")).attr(\"href\",'/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=3004');}angular.element(document.querySelectorAll(\"#link_note a\")).attr(\"href\",'/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=227');}function initParameter(){$scope.DownloadFW=DownloadFW;if(typeof LATE_VER==\"undefined\")return;var i;if(webcfg.cc==\"9\"){var aryAA=LATE_VER[2].split(\"#\");$scope.newFWnum=aryAA.length;$scope.datarows=[];for(i=0;i<aryAA.length;i++){info_ver[i]=aryAA[i];$scope.datarows.push({\"lang\":\"English\",\"version\":(i==0?LATE_VER[0]:''),\"filename\":info_ver[i],\"action\":i,\"rowid\":i});$scope.$apply();}}else{if(typeof LATE_VER!=\"undefined\"){sLatestEnVer=Object.keys(LATE_VER);sLatestVerNum=sLatestEnVer[0];sLatestEnVer=Object.keys(LATE_VER[sLatestVerNum]);}GetLatestInfo();}}function GetLatestInfo(){var i,j;var lang={\"EN\":gettext(\"English\"),\"CN\":gettext(\"Simplified Chinese\"),\"TW\":gettext(\"Traditional Chinese\"),\"DE\":gettext(\"Deutsch\"),\"PL\":gettext(\"Polish\"),\"FR\":gettext(\"French\")};for(i=0;i<sLatestEnVer.length;i++){lang=lang[sLatestEnVer[i]]||gettext(\"Undefinition Language\");$scope.newFWnum=LATE_VER[sLatestVerNum][sLatestEnVer[i]].length;$scope.datarows=[];for(j=0;j<LATE_VER[sLatestVerNum][sLatestEnVer[i]].length;j++){$scope.datarows.push({\"lang\":(i==0?lang:''),\"version\":(i==0?sLatestVerNum:''),\"filename\":LATE_VER[sLatestVerNum][sLatestEnVer[i]][j],\"action\":sLatestEnVer[i],\"rid\":\"\"+j});}}$scope.$apply();}function formatFileSize(bytes){if(bytes){const sufixes=['B','kB','MB','GB','TB'];const i=Math.floor(Math.log(bytes)/Math.log(1024));return(bytes/Math.pow(1024,i)).toFixed(2)+' '+sufixes[i];}return'';}function checkfw(){const fw_file=document.getElementById('fw_file'),fn=fw_file.files[0],fw_size=document.getElementById('fw_size');let chk=0;f1.upfw.disabled=true;fw_size.innerText=formatFileSize(fn.size);if(fn.size==0){fw_file.setCustomValidity(gettext(\"Incorrect firmware size!\"));chk=1;}else if(!fn.name.includes(webcfg.model)){fw_file.setCustomValidity(gettext(\"Firmware file name is invalid, please check!\"));chk=1;}else if(webcfg.cc!=9&&fn.name.toLowerCase().includes(\"bt\")){fw_file.setCustomValidity(gettext(\"Firmware incompatible with hardware version! Please download another firmware from your local or DrayTek.com website\"));chk=1;}if(chk){f1.reset();fw_file.reportValidity();fw_size.innerText='';}else{f1.upfw.disabled=false;}}function toInt(str){var num=0;for(var i=0;i<str.length;i++){num=parseInt(num<<8)+parseInt(str.charCodeAt(i).toString(10));}return num;}function toIntSum(str){var num=0;for(var i=0;i<str.length;i++){num+=parseInt(str.charCodeAt(i).toString(10));}return num;}function onClkClose(){bg.hideElmtById(document,\"fwheaderinfo\");bg.showElmtById(document,\"tftp\");bg.showElmtById(document,\"web\");}function fwheaderInfoShow(){mdmv0=mdmv0.toUpperCase().replace(/[^0-9A-F]+/,\"\").replace(/^0+/,\"\");mdma0=mdma0.toUpperCase().replace(/[^0-9A-F]+/,\"\").replace(/^0+/,\"\");mdmv1=mdmv1.toUpperCase().replace(/[^0-9A-F]+/,\"\").replace(/^0+/,\"\");mdma1=mdma1.toUpperCase().replace(/[^0-9A-F]+/,\"\").replace(/^0+/,\"\");if((mdmv0==mdmval[4])&&(mdma0==mdmval[2])&&(mdmv1==mdmval[5])&&(mdma1==mdmval[3])){modemcodechg=0;}if(hasfwheader==1){document.getElementById(\"smodelName\").innerHTML=ModelName;if(mdmval[1]==0){document.getElementById(\"scurmdmver\").innerHTML=\"<font color=green>\"+mdmval[4]+\"/\"+mdmval[2]+\"</font><br>\"+mdmval[5]+\"/\"+mdmval[3];}else{document.getElementById(\"scurmdmver\").innerHTML=mdmval[4]+\"/\"+mdmval[2]+\"<br><font color=green>\"+mdmval[5]+\"/\"+mdmval[3]+\"</font>\";}if(modemcodechg==1){document.getElementById(\"snewmdmver\").innerHTML=\"<font color=red>\"+mdmv0+\"/\"+mdma0+\"<br>\"+mdmv1+\"/\"+mdma1+\"</font>\";document.getElementById(\"mdmchgmsg\").style.display=\"\";}else{document.getElementById(\"snewmdmver\").innerHTML=mdmv0+\"/\"+mdma0+\"<br>\"+mdmv1+\"/\"+mdma1;document.getElementById(\"mdmchgmsg\").style.display=\"none\";}if(fbit==0){document.getElementById(\"sfwversion\").innerHTML=RCName;document.getElementById(\"releasemsg\").style.display=\"\";}else{document.getElementById(\"sfwversion\").innerHTML=ReleaseName;document.getElementById(\"releasemsg\").style.display=\"none\";}bg.showElmt