"Last Sunday in March\");sDaylightEnd=gettext(\"Last Sunday in October\");}else if(dstFlag==3){sDaylightStart=gettext(\"Last Sunday in October\");sDaylightEnd=gettext(\"Last Sunday in March\");}else if(dstFlag==4){sDaylightStart=gettext(\"Last Sunday in September\");sDaylightEnd=gettext(\"First Sunday in April\");}else if(dstFlag==5){sDaylightStart=gettext(\"First Sunday in October\");sDaylightEnd=gettext(\"First Sunday in April\");}else if(dstFlag==6){sDaylightStart=gettext(\"Second Sunday in March\");sDaylightEnd=gettext(\"First Sunday in November\");}else if(dstFlag==7){sDaylightStart=gettext(\"Third Sunday in October\");sDaylightEnd=gettext(\"Third Sunday in February\");}else if(dstFlag==8){sDaylightStart=gettext(\"Second Sunday in October\");sDaylightEnd=gettext(\"Second Sunday in March\");}else if(dstFlag==9){sDaylightStart=gettext(\"March 22\");sDaylightEnd=gettext(\"September 22\");}}var sLTEmodulename='LTE'; angular.element(document).ready(function(){initParameter();showTime();initWebChange();setInterval(\"showTime()\",1000);for(var d=0;d<document.forms.length;d++){addhandlers(document.forms[d]);for(var e=0;e<document.forms[d].elements.length;e++){addhandlers(document.forms[d].elements[e]);}}}); function showTime(){var aryW=new Array(gettext(\"Sun\"),gettext(\"Mon\"),gettext(\"Tue\"),gettext(\"Wed\"),gettext(\"Thu\"),gettext(\"Fri\"),gettext(\"Sat\"));var aryM=new Array(gettext(\"Jan\"),gettext(\"Feb\"),gettext(\"Mar\"),gettext(\"Apr\"),gettext(\"May\"),gettext(\"Jun\"),gettext(\"Jul\"),gettext(\"Aug\"),gettext(\"Sep\"),gettext(\"Oct\"),gettext(\"Nov\"),gettext(\"Dec\"));var date=new Date();date.setTime(date.getTime()+timeDiff);f[oSysTm].value=date.getFullYear()+\" \"+aryM[date.getMonth()]+\" \"+date.getDate()+\" \"+aryW[date.getDay()]+\" \"+date.getHours()+\" : \"+date.getMinutes()+\" : \"+date.getSeconds();} function initPage(nElmt){} var inputForm=new Array();function initParameter(){document.body.style.cursor=\"default\";if(bDrayIpv6Flag&&bDrayIpv6)bg.s