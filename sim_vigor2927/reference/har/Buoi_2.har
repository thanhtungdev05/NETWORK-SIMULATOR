            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'USB Application' | translate }}\" sub-title translate>USB General Settings</b><hr><form action=/cgi-bin/ftpset.cgi method=post name=frm1><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td colspan=2><b translate>General Settings</b></td></tr><tr><td colspan=2><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr class=ftp><td translate width=40%>Simultaneous FTP Connections</td><td><input maxlength=2 name=sFtpMaxUser ng-model=aryUSBGenInfo[0] size=3 type=text>(<translate>Maximum</translate> 6)</td></tr><tr><td translate>Default Charset</td><td><select convert-to-number name=sCharset ng-model=aryUSBGenInfo[1]><option translate value=0>English</option><option translate value=936>Chinese(Simple)</option><option translate value=950>Chinese(Traditional)</option><option translate value=850>German</option></select></td></tr></table></td></tr></table></td></tr><tr ng-if=bSMB><td colspan=2><b translate>SMB File Sharing Service (Network Neighborhood)</b></td></tr><tr ng-if=bSMB><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td colspan=2><input convert-to-number name=iSmbEnable ng-model=aryUSBGenInfo[2] onclick=smbchk() type=radio value=1><translate>Enable</translate>&nbsp; <input convert-to-number name=iSmbEnable ng-model=aryUSBGenInfo[2] onclick=smbchk() type=radio value=0><translate>Disable</translate></td></tr><tr><td colspan=2><b translate>Access Mode</b></td></tr><tr><td colspan=2><input convert-to-number name=iPassmode ng-model=aryUSBGenInfo[5] type=radio value=0><translate>LAN Only</translate>&nbsp; <input convert-to-number name=iPassmode ng-model=aryUSBGenInfo[5] type=radio value=1><translate>LAN And WAN</translate></td></tr><tr><td colspan=2><b translate>NetBios Name Service</b></td></tr><tr><td width=40%>&nbsp;&nbsp;<translate>Workgroup Name</translate></td><td><input maxlength=15 name=sWGName ng-model=aryUSBGenInfo[3] type=text></td></tr><tr><td>&nbsp;&nbsp;<translate>Host Name</translate></td><td><input maxlength=15 name=sHostName ng-model=aryUSBGenInfo[4] type=text></td></tr><tr><td colspan=2><b translate>Printer Server</b></td></tr><tr><td colspan=2><input convert-to-number name=iPSEnable ng-model=aryUSBGenInfo[6] type=radio value=0><translate>Enable</translate>&nbsp; <input convert-to-number name=iPSEnable ng-model=aryUSBGenInfo[6] type=radio value=1><translate>Disable</translate></td></tr></table></td></tr></table></td></tr></table></td></tr></table><div><b translate>Note</b>: <ol><li translate>If character set is set to \"English\", only English long file name is supported.</li><li ng-show=!bRuVPN translate>Multi-session FTP download will be banned by Router FTP server. If your FTP client has a multi-connection mechanism, such as FileZilla, you should limit client connections to 1 to improve performance.</li><li ng-show=bSMB><span translate>A workgroup name must be different from the host name. The workgroup name can have up to 15 characters and the host name can have up to 15 characters.Names cannot contain any of the following</span>: . ; : \" ' < > # ^ { } [ ] & * + = / ˙ \\ | ?.</li></ol></div><br><table align=center><tr><td><input class=btnw name=btnOk onclick=onClkBtnOk() type=button value=\"{{ 'OK' | translate }}\"></td></tr></table><input name=sProfileAct type=hidden><input name=sOpt type=hidden><input name=webchange type=hidden value=0><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></td></tr></table><textarea id=ftpgensetinit ng-hide=true>\nvar aryUSBGenInfo = [5,0,0,\"WORKGROUP\",\"VIGOR\",0,1];\nconst bSMB = parseInt('1'),\n\tbRuVPN = parseInt('0'),\n\tiActionStatusFlag = '1',\n\tiFwUpgradeState = '0';\n</textarea><script> var ftpgensetinitscript=document.createElement(\"script\");ftpgensetinitscript.text=document.getElementById(\"ftpgensetinit\").value;document.head.appendChild(ftpgensetinitscript);top.ACTION_STATUS=-1;top.iActionStatusFlag=iActionStatusFlag;top.iFwUpgradeState=iFwUpgradeState;top.act_sta.damage_alert();var bg=parent;var f=document.frm1;angular.element(document).ready(function(){initParameter();initWebChange();});function initParameter(){$scope.aryUSBGenInfo=aryUSBGenInfo;$scope.bSMB=bSMB;$scope.bRuVPN=parseInt('0');$scope.$apply();if(bRuVPN){ bg.hideElmtByClass(document,\"tr\",\"ftp\");bg.hideElmtByClass(document,\"span\",\"ftp\");bg.getElmtById(document,\"sThree\").innerHTML='2';}if(bSMB){smbchk();}}function onClkBtnOk(){if(bSMB){f.sWGName.value=f.sWGName.value.toUpperCase();f.sHostName.value=f.sHostName.value.toUpperCase();if(f.sWGName.value==f.sHostName.value){alert(gettext('A workgroup name must not be the same as the host name.'));return false;}}if(f.sFtpMaxUser.value<1||f.sFtpMaxUser.value>6||f.sFtpMaxUser.value==\"\"){alert(gettext('User Limit must between ###MIN###-###MAX###, Please re-enter!').replace(\"###MIN###\",1).replace(\"###MAX###\",6));return false;}else{if(checkWebChange()){f.webchange.value='1';} if(bSMB){bg.cpntCtrl(true,f,f.sWGName,2);var sOrgiWGName=aryUSBGenInfo[3];var sOrgiHostName=aryUSBGenInfo[4]; f.sOpt.value=1;}f.sProfileAct.value=\"saveitem\";f.submit();}}function smbchk(){if(bg.getVleFromElmt(f.iSmbEnable[0],0)==1){bg.cpntCtrl(true,f,f.iPassmode[0],4);}else{bg.cpntCtrl(false,f,f.iPassmode[0],4);}}</script></body></html>"
