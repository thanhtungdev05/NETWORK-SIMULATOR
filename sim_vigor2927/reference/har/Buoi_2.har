            "compression": 9337,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / content=IE=EmulateIE7 http-equiv=X-UA-Compatible><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/chart.min.js?094907\"></script><script src=\"/js/dateFnsBundle.min.js?094907\"></script><script> angular.extend({browser:{msie:/msie/.test(navigator.userAgent.toLowerCase())}});</script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=720><tr><td><b parent=\"{{ 'USB Application' | translate }}\" sub-title translate>Temperature Sensor</b><hr><table align=center border=0 cellpadding=2 cellspacing=0 width=720><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><th class=ontab id=tab1 onClick=onChgAccMod(1) translate width=25%>Temperature Chart</th><th class=offtab id=tab3 ng-if=showTab3 onClick=onChgAccMod(3) translate width=25%>Humidity Chart</th><th class=offtab id=tab2 onClick=onChgAccMod(2) translate>Temperature Sensor Settings</th><th class=tabpadding width=20%></th></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><form action=/cgi-bin/usbtemper.cgi method=post name=frm1><table align=center border=0 cellpadding=0 cellspacing=0 width=100%><tr><td align=right><translate>Refresh Min(s)</translate>:&nbsp; <select name=sltRefreshTime onChange=onChgTime(this.value) size=1><option value=60000>1</option><option value=180000>3</option><option value=300000>5</option></select></td><td align=right class=red>|&nbsp; <a href=\"javascript: onRefresh()\" translate>Refresh</a>&nbsp;|</td></tr></table><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><div style=width:700px;height:300px><canvas id=\"chartjs\"></canvas></div></td></tr></table><table align=center bord