            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css></head><body class=ng-cloak><form action=/cgi-bin/v2x00.cgi method=POST name=frm1><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td colspan=2><b parent=\"{{ 'System Maintenance' | translate }}\" sub-title translate>Webhook</b><hr></td></tr><table align=center cellpadding=2 cellspacing=0 width=700px><tr><td colspan=2><input name=iwbhken onclick=Enable_check() type=checkbox value=1>&nbsp;<translate>Enable</translate></td></tr><tr><td colspan=2><input name=wanRTxOP type=checkbox value=1>&nbsp;<translate>WAN Rx/Tx Rate and Packet Counts</translate></td></tr><tr><td colspan=2><input name=wanRTxtOP type=checkbox value=1>&nbsp;<translate>WAN Rx/Tx Total Traffic in Bytes</translate></td></tr><tr><td colspan=2><input name=wancsOP type=checkbox value=1>&nbsp;<translate>Current NAT Sessions</translate></td></tr><tr><td colspan=2><input name=wanARPtOP type=checkbox value=1>&nbsp;<translate>ARP Table Counts</translate></td></tr><tr><td colspan=2><input name=DHCPtOP type=checkbox value=1>&nbsp;<translate>DHCP Table Counts</translate></td></tr><tr><td colspan=2><input name=VPNcOP type=checkbox value=1>&nbsp;<translate>VPN Connection</translate></td></tr><tr><td width=25%><b translate>Monitoring Server URL</b></td><td width=75%><input maxlength=199 name=sMntSvURL size=40 type=url></td></tr><tr><td width=25%><b translate>Report Period</b><br><b>(1~1440&nbsp;<translate>minutes</translate>)</b></td><td width=75%><input max=1440 maxlength=4 min=1 name=sRpPd oninput=validateRange(this) onkeypress=validateDigit(event) size=5 type=number></td></tr></table><br><table align=center><tr><td><input class=btnw name=ok onclick=onClkBtnOk() type=button value=\"{{ 'OK' | translate }}\"></td><td><input class=btnw name=cancel onclick=onClkBtnCancel() 