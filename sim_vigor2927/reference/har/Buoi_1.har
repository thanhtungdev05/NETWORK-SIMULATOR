          "content": {
            "size": 43662,
            "mimeType": "text/html",
            "compression": 34560,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script><script src=/js/QoS.JS></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=850><tr><td><b ng-if=isBwTitle parent=\"{{ ('Bandwidth Management' | translate) }}\" sub-title translate>Quality of Service</b><b ng-if=!isBwTitle parent=\"{{ ('Applications' | translate) }}\" sub-title translate>Quality of Service</b><hr><form action=/cgi-bin/qos.cgi method=post name=frm1><div ng-if=scopeisHwAccelQosEnable style=\"margin-bottom: 15px;\"><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>Hardware QoS General Setup</b></td><td align=right class=red>|&nbsp; <a class=DenyLink href=javascript:ruOK() translate>Set to Factory Default</a>&nbsp;|</td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 width=100%><tr align=center><td translate>Index</td><td translate>Enable</td><td translate>Direction</td><td translate>Egress Bandwidth</td><td><translate>Class</translate> 1</td><td><translate>Class</translate> 2</td><td><translate>Class</translate> 3</td><td translate>Others</td><td translate>Status</td></tr><tr align=center ng-class-even=\"'row1' \" ng-class-odd=\"'row0' \" ng-repeat=\"info in hwAccQoSInfo.aryInfo\"><td ng-if=\"info.type === 'wan'\"><translate>WAN</translate>{{$index+1}}</td><td ng-if=\"info.type === 'lan'\"><translate>Port</translate>{{$index+1 - hwAccQoSInfo.wanNumber}}</td><td><input id=hwQoSChk_{{$index}} name=\"hwQoSEnb{{generate_HwAccQoS_suffix(info.type, $index)}}\" ng-click=enable_hwqos_handler() ng-disabled=!hwAccQoSInfo.hwAccEnable ng-model=info.enable type=checkbox value=1></td><td ng-if=\"info.type === 'wan'\" translate>Egress (Upload)</td><td ng-if=\"info.type === 'lan'\" translate>Egress (Download)</td><td><input max=999999 min=0 name=\"HwQoSBW{{generate_HwAccQoS_suffix(info.type, $index)}}\" ng-change=\"info.bandwidth = aryHwAccQoSDisplayObj[$index].bandwidth * (aryHwAccQoSDisplayObj[$index].unit == '0' ? 1 : 1000)\" ng-disabled=\"!hwAccQoSInfo.hwAccEnable || !info.enable\" ng-model=aryHwAccQoSDisplayObj[$index].bandwidth size=6 step=0.001 type=number><select name=\"HwQoSBWUnit{{generate_HwAccQoS_suffix(info.type, $index)}}\" ng-change=\"info.bandwidth = aryHwAccQoSDisplayObj[$index].bandwidth * (aryHwAccQoSDisplayObj[$index].unit == '0' ? 1 : 1000)\" ng-disabled=\"!hwAccQoSInfo.hwAccEnable || !info.enable\" ng-model=aryHwAccQoSDisplayObj[$index].unit style=height:22px;><option value=0>{{ 'Kbps' | translate }}</option><option value=1>{{ 'Mbps' | translate }}</option></select><input name=\"HwQoSBWKbps{{generate_HwAccQoS_suffix(info.type, $index)}}\" ng-disabled=\"!hwAccQoSInfo.hwAccEnable || !info.enable\" ng-hide=true ng-model=info.bandwidth type=number></td><td><input max=97 min=0 name=\"HwQoSBwRate0{{generate_HwAccQoS_suffix(info.type, $index)}}\" ng-blur=checkRate(0,$index) ng-change=\"info.bwRate[3] = 100-info.bwRate[0]-info.bwRate[1]-info.bwRate[2]\" ng-disabled=\"!hwAccQoSInfo.hwAccEnable || !info.enable\" ng-keyup=rateLimit($index) ng-model=info.bwRate[0] required size=2 type=number>% </td><td><input max=97 min=0 name=\"HwQoSBwRate1{{generate_HwAccQoS_suffix(info.type, $index)}}\" ng-blur=checkRate(1,$index) ng-change=\"info.bwRate[3] = 100-info.bwRate[0]-info.bwRate[1]-info.bwRate[2]\" ng-disabled=\"!hwAccQoSInfo.hwAccEnable || !info.enable\" ng-keyup=rateLimit($index) ng-model=info.bwRate[1] required size=2 type=number>% </td><td><input max=97 min=0 name=\"HwQoSBwRate2{{generate_HwAccQoS_suffix(info.type, $index)}}\" ng-blur=checkRate(2,$index) ng-change=\"info.bwRate[3] = 100-info.bwRate[0]-info.bwRate[1]-info.bwRate[2]\" ng-disabled=\"!hwAccQoSInfo.hwAccEnable || !info.enable\" ng-keyup=rateLimit($index) ng-model=info.bwRate[2] required size=2 type=number>% </td><td><input disabled max=100 min=0 name=\"HwQoSBwRate3{{generate_HwAccQoS_suffix(info.type, $index)}}\" ng-blur=checkRate(3,$index) ng-model=info.bwRate[3] ng-value=\"info.bwRate[3] = 100-info.bwRate[0]-info.bwRate[1]-info.bwRate[2]\" size=2 type=number>% </td><td> <a href=\"/cgi-bin/qos.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=8&iProfileIdx={{count_HwAccQoS_lanwan_index(info.type, $index)+1}}&hwqos={{info.type}}\" ng-click=status_link_click_handler(info.type) translate>Status</a></td></tr></table></td></tr></table><b translate>Note</b>: <ol><li ng-if=adminauth> <a href=\"/cgi-bin/ipnat.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=20&iAct=0\" translate>Please enable hardware acceleration so Hardware QoS will work.</a></li><li translate>Hardware QoS has higher priority than Software QoS.</li></ol></div><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>Software QoS General Setup</b></td><td align=right class=red ng-if=!scopeisHwAccelQosEnable>|&nbsp; <a class=DenyLink href=javascript:ruOK() translate>Set to Factory Default</a>&nbsp;|</td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 width=100%><tr align=center><td translate width=20>Index</td><td translate width=20>Enable</td><td translate width=80>Direction</td><td colspan=2 translate width=340>Ingress / Egress Bandwidth</td><td width=70><translate>Class</translate> 1</td><td width=70><translate>Class</translate> 2</td><td width=70><translate>Class</translate> 3</td><td translate width=70>Others</td><td translate width=50>Status</td><td></td></tr><script> var bg=parent;var MaxRule=MaxRule_cls1=MaxRule_cls2=MaxRule_cls3=MaxRule_cls5=0;var aryBgclr=[\"row0\",\"row1\"];var iUSBWAN=parseInt(\"1\");var WAN_NUM=parseInt(\"6\"); var iFixWanNum=parseInt(\"4\");var iUSBNum=parseInt(\"2\");var iSecUsbNum=parseInt(\"1\");var DualDslEnable=parseInt(\"0\");var bDualDSL=parseInt('0');var extra_vdsl_idx=iFixWanNum+iUSBNum;var idx_2nd_usb=iFixWanNum+iUSBNum-iSecUsbNum;var ENABLE_QOS=(1<<0);var ENABLE_QOS_IN=(1<<1);var ENABLE_QOS_OUT=(1<<2);var ENABLE_QOS_BOTH=(1<<3);var ENABLE_QOS_UDP_BWCTRL=(1<<4);var sPresetModel='2927';var bNewWLWAN=parseInt('1');var bWless=parseInt('0');var bDualWless5G=parseInt('0');var dslbonding=\"(nil)\";var sLTEmodulename='LTE';var aryQosFlag=['8','8','2','2','8','8'];var aryInSpeed=['100000','100000','0','0','100000','100000'];var aryOutSpeed=['100000','100000','0','0','100000','100000'];var aryDSLRate=['(nil)','(nil)'];var aryDSL1Rate=['(nil)','(nil)'];var aryDSLRate2=['(nil)','(nil)'];var aryClsRate0=['25','25','0','0','25','25'];var aryClsRate1=['25','25','0','0','25','25'];var aryClsRate2=['25','25','0','0','25','25'];var aryUdpBWLimit=['25','25','25','25','25','25'];var sBw0WanPhyMode=\"Ethernet\"; var aryPhyMode=[\"0\",\"0\",\"5\",\"6\",\"4\",\"4\"]; if(sBw0WanPhyMode==\"Ethernet\"||sBw0WanPhyMode==\"USB\"){aryPhyMode[0]=0;}else{aryPhyMode[0]=1;}var i,j,str=\"\";var iWan1IsXdsl='0';var sBw0BBandColor='red';for(i=0;i<WAN_NUM;i++){if(top.notSupportWAN.indexOf(i)!=-1)continue;if((bDualDSL&&extra_vdsl_idx==i&&DualDslEnable!=\"1\")||(iUSBNum==2&&iSecUsbNum==0&&idx_2nd_usb==(i+1)))continue;if(bNewWLWAN&&(i==2||i==3)&&!bWless&&!bDualWless5G)continue;else if(bNewWLWAN&&i==3&&!bDualWless5G)continue; str+=\"<tr align=center class='row\"+i%2+\"' id=wan\"+(i+1)+\" style=display:none>\";if((((i+1)==3&&!parseInt('1'))||((i+1)==5&&parseInt('1')))&&(parseInt('0')))str+=\"<td><a href='javascript: gotoQosGenSet(\"+(i+1)+\")'>\"+(!bg.SHOW_BDW_QOS_WAN2&&i==1?gettext(\"Backup WAN\"):gettext(sLTEmodulename))+\"</td>\";else str+=\"<td><a href='javascript: gotoQosGenSet(\"+(i+1)+\")'>\"+(!bg.SHOW_BDW_QOS_WAN2&&i==1?gettext(\"Backup WAN\"):gettext(\"WAN\")+(i+1))+\"</td>\"; str+=\"<td><input type=checkbox name=QoSEnb\"+i+\" value=1 onclick=chkQoS(\"+i+\")></td>\"; str+=\"<td><select name=QoSDrctSlt\"+i+\">\";str+=\"<option value=0>{{ 'Ingress' | translate }}</option>\";str+=\"<option value=1>{{ 'Egress' | translate }}</option>\";str+=\"<option value=2>{{ 'BOTH' | translate }}</option>\";str+=\"</select></td>\";if(i==0&&(aryPhyMode[i]==1||aryPhyMode[i]==3)){if(dslbonding==\"1\"){var urate=parseInt(aryDSLRate2[0])+parseInt(aryDSLRate[0]);var drate=parseInt(aryDSLRate2[1])+parseInt(aryDSLRate[1]);if(urate==0&&drate==0){ str+=\"<td>\"+\"--\"+gettext(\"Kbps\")+\"/</td><td>\"+\"--\"+gettext(\"Kbps\")+\"</td>\";}else{str+=\"<td>\"+bg.adv_format(urate/1000,2)+gettext(\"Kbps\")+\"/</td><td>\"+bg.adv_format(drate/1000,2)+gettext(\"Kbps\")+\"</td>\";}}else{if(aryDSLRate[0]==0&&aryDSLRate[1]==0){ str+=\"<td>\"+\"--\"+gettext(\"Kbps\")+\"/</td><td>\"+\"--\"+gettext(\"Kbps\")+\"</td>\";}else{str+=\"<td>\"+bg.adv_format(aryDSLRate[0]/1000,2)+gettext(\"Kbps\")+\"/</td><td>\"+bg.adv_format(aryDSLRate[1]/1000,2)+gettext(\"Kbps\")+\"</td>\";}}}else if(bDualDSL&&extra_vdsl_idx==i&&DualDslEnable==\"1\"){if(aryDSL1Rate[0]==0&&aryDSL1Rate[1]==0){ str+=\"<td>\"+\"--\"+gettext(\"Kbps\")+\"/</td><td>\"+\"--\"+gettext(\"Kbps\")+\"</td>\";}else{str+=\"<td>\"+bg.adv_format(aryDSL1Rate[0]/1000,2)+gettext(\"Kbps\")+\"/</td><td>\"+bg.adv_format(aryDSL1Rate[1]/1000,2)+gettext(\"Kbps\")+\"</td>\";}}else{str+=\"<td><input type=text size=6 name=WanInBW\"+i+\">\";str+=\"<select name=WanInBWUnit\"+i+\" style=height:22px;>\";str+=\"<option value=0>{{ 'Kbps' | translate }}</option>\";str+=\"<option value=1>{{ 'Mbps' | translate }}</option></select>\"+\"<b>/</b>\"+\"</td>\";str+=\"<td><input type=text size=6 name=WanOutBW\"+i+\">\";str+=\"<select name=WanOutBWUnit\"+i+\" style=height:22px;>\";str+=\"<option value=0>{{ 'Kbps' | translate }}</option>\";str+=\"<option value=1>{{ 'Mbps' | translate }}</option></select></td>\";} str+=\"<td><input type=text size=2 name=BwRate0\"+i+\" onblur=checkRate(0,\"+i+\") onkeypress=setTimeout('rateLimit(\"+i+\")',100)>\