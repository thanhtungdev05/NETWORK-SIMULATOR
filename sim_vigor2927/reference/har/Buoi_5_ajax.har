r></table><br><table align=center ng-hide=isSimApm width=100%><tr><td><b translate>Note</b>:</td></tr><tr><td><i align=middle alt=Online class=\"sharepart APMonline\"></i> : <translate>Online</translate>&nbsp;&nbsp;&nbsp;&nbsp; <i align=middle alt=Offline class=\"sharepart APMoffline\"></i> : <translate>Offline</translate>&nbsp;&nbsp;&nbsp;&nbsp; <i align=middle alt=Unknown class=\"sharepart unknown-1\"></i> : <translate>Hidden SSID</translate><br><br><translate translate-params-num=\"20\">Maximum support {{num}} APs.</translate><br><br><translate>When AP Devices connect via an intermediary switch, please ensure that <b>UDP:4944</b> port and the <b>HTTP</b> port of AP Devices are not blocked so that the AP status can be retrieved.</translate></td></tr></table><table align=center ng-show=isSimApm width=100%><tr><td colspan=2><b translate>Note</b>: <tr><td colspan=2><i align=middle alt=Online class=\"sharepart APMonline\"></i> : <translate>AP Online</translate>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <i align=middle alt=Offline class=\"sharepart APMoffline\"></i> : <translate>AP Offline</translate>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; <i align=middle alt=Unknown class=\"sharepart unknown-1\"></i> : <translate>AP Hidden SSID</translate></td></tr><tr ng-if=hasMesh><td colspan=2><img align=middle alt=Online border=0 src=/images/mesh_on.png> : <translate>Mesh Online</translate>&nbsp;&nbsp;&nbsp;&nbsp; <img align=middle alt=Offline border=0 src=/images/mesh_off.png> : <translate>Mesh Offline</translate>&nbsp;&nbsp;&nbsp;&nbsp; <img align=middle alt=Unknown border=0 src=/images/mesh_unknown.png> : <translate>Mesh Hidden SSID</translate></td></tr><tr><td colspan=2><translate translate-params-num=\"20\">Maximum support {{num}} APs.</translate><br><br></td></tr><tr><td><ol><li ng-if=hasMesh translate>Display the overall mesh network information instead of the each AP in the mesh network.</li><li id=link_note ng-if=hasMesh translate>The status of local mesh network is listed on <a>Mesh &gt;&gt; Mesh Status</a> page.</li><li translate>When AP Devices connect via an intermediary switch, please ensure that <b>UDP:4944</b> port and the <b>HTTP</b> port of AP Devices are not blocked so that the AP status can be retrieved.</li></ol></td></tr></td></tr></table><br><input name=fid type=hidden value=2130><input name=sAct type=hidden value=status><input name=act type=hidden value=1><input name=delidx type=hidden><input name=sFormAuthStr type=hidden value=\"pU2VHFY4WAi1NkA\"></form></td></tr></table><script>top.ACTION_STATUS=-1;top.iActionStatusFlag='0';top.iFwUpgradeState='0';top.act_sta.damage_alert();var bg=parent;var f=document.frm1;var apdevice_idx=1;var aryAuth=new Array();var aryAPDeviceName=new Array();var tmp_auth=\"\";var apply_idx=0;var stationlist_5g=\"2.4G\"; var bMesh=parseInt('0');var bSimApm=parseInt('1');var bWless=parseInt('0');var iWireless11ACExists='0';angular.element(document).ready(function(){initPage();});function initPage(){$scope.isSimApm=bSimApm;$scope.hasMesh=(bWless||iWireless11ACExists==1)&&bMesh;$scope.$apply();if(!bSimApm&&parseInt('1')){bg.showElmtByClass(document,\"td\",\"ap_enhance\");bg.showElmtById(document,\"ap_enhance\");}for(i=0;i<aryAPDevice.length;i++){aryAuth[i]=Base64.decode(aryAPDevice[i][15]);if(aryAPDevice[i][1]!=1)continue;ssid_title=\"\"; for(ssid=0;ssid<4;ssid++){if(aryAPDevice[i][3][ssid]!=\"\"){ssid_title+=\"[2.4GHz]\";break;}}for(ssid=0;ssid<4;ssid++){if(aryAPDevice[i][3][ssid]!=\"\"){if(ssid_title!=\"\")ssid_title+=\"\\n\"; if(isDrayOS5(aryApDevice5G[i][4]))ssid_title+=\"  \"+aryAPDevice[i][3][ssid];else ssid_title+=\"  \"+aryAPDevice[i][3][ssid]+\" (\"+aryAPDevice[i][4][ssid]+\")\";}}if(aryApDevice5G[i][4]!='AP810'&&aryApDevice5G[i][4]!='AP710'){for(ssid=0;ssid<4;ssid++){if(aryApDevice5G[i][0][ssid]!=\"\"){ssid_title+=\"\\n\\n[5GHz]\";break;}} for(ssid=0;ssid<4;ssid++){if(aryApDevice5G[i][0][ssid]!=\"\"){if(ssid_title!=\"\")ssid_title+=\"\\n\"; if(isDrayOS5(aryApDevice5G[i][4]))ssid