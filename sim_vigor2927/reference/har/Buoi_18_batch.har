) translate>Set to Factory Default</a>&nbsp;|&nbsp; <a class=DenyLink href=javascript:clrSlt() translate>Clear selected</a>&nbsp;|</td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 width=100%><tr align=center><th translate width=7%>Index</th><th translate width=7%>Enable</th><th translate width=16%>Service Name</th><th translate width=12%>WAN Interface</th><th translate width=10%>Protocol</th><th translate width=14%>Public Port</th><th translate width=19%>Source IP</th><th translate width=19%>Private IP</th><th translate width=10%>Select</th></tr><script> var ipnatpinitScript=document.createElement('script');ipnatpinitScript.text=document.getElementById(\"ipnatpinit\").value;document.head.appendChild(ipnatpinitScript);var alias_num=parseInt(\"32\");var maxidx=parseInt(\"40\");var sLTEmodulename='LTE';var str=\"\";var i;for(i=0;i<aryPtRedirect.length;i++){ if(aryPtRedirect[i][1]==\"0.0.0.0\")aryPtRedirect[i][1]=\"\";str+=\"<tr align=center class=row\"+i%2+\">\";str+=\"<td><a href='javascript:gotoDetailSet(\"+(i+1)+\")'>\"+(i+1)+\".</a></td>\";if(aryPtRedirect[i][3]==0){str+=\"<td><input type=checkbox value=1 name=enPtRedirec\"+i+\"></td>\";}else{str+=\"<td><input type=checkbox value=1 name=enPtRedirec\"+i+\" checked></td>\";}str+=\"<td>&nbsp;\"+aryPtRedirect[i][0]+\"</td>\";if(aryPtRedirect[i][5]==-2)str+=\"<td>&nbsp;\"+gettext(\"ALL\")+\"</td>\";else if(aryPtRedirect[i][5]==-3)str+=\"<td>&nbsp;\"+gettext(\"VPN\")+\"</td>\";else{wan_slt_idx=Math.ceil((parseInt(aryPtRedirect[i][5])+2)/alias_num);if(((wan_slt_idx==3&&!parseInt('1'))||(wan_slt_idx==5&&parseInt('1')))&&(parseInt('0')))str+=\"<td>&nbsp;\"+gettext(sLTEmodulename)+\"</td>\";else str+=\"<td>&nbsp;\"+gettext(\"WAN\")+wan_slt_idx+\"</td>\";}if(aryPtRedirect[i][6]==6){str+=\"<td>&nbsp;\"+gettext(\"TCP\")+\"</td>\";}else if(aryPtRedirect[i][6]==17){str+=\"<td>&nbsp;\"+gettext(\"UDP\")+\"</td>\";}else{str+=\"<td>&n