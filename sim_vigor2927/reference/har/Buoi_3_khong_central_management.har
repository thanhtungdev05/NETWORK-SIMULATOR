            "mimeType": "text/html",
            "compression": 3995,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/gettext.min.js?094907\"></script><script src=\"/js/webchange.js?094907\"></script></head><body class=ng-cloak><textarea id=lanwired802init style=\"display: none;\">\nvar iWired802Enable = 0;\nvar aryWiredPort = [0,0,0,0,0,0];\nvar iRadiusEnable = 0;\nvar iWan2En = 0;\nvar iAuthType = 0;\nvar app_8021x = 0;\nvar iMaxLanPt = 5;\n</textarea><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'LAN' | translate }}\" sub-title translate>Wired 802.1X</b><hr><form action=/cgi-bin/v2x00.cgi method=POST name=frm1><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td colspan=4><translate>LAN 802.1X</translate>:</td></tr><tr><td colspan=4><input name=iWiredEnable onclick=onClkEnable() type=checkbox value=1><translate>Enable</translate></td></tr><tr class=local8021x style=display:none><td colspan=4><translate>Authentication Type</translate>:&nbsp <select name=iAuthType size=1><option translate value=0>External RADIUS</option><option translate value=1>Local 802.1X</option></select></td></tr><tr><td colspan=4><translate>802.1X ports</translate>:</td></tr><tr><td width=10%><input name=iWiredPort0 type=checkbox value=1>P1</td><td width=10%><input name=iWiredPort1 type=checkbox value=1>P2</td><td width=10%><input name=iWiredPort2 type=checkbox value=1>P3</td><td id=lan4hide width=10%><input name=iWiredPort3 type=checkbox value=1>P4</td><td ng-show=\"5 > 4\" width=10%><input name=iWiredPort4 type=checkbox value=1>P5</td><td ng-show=\"5 == 6\" width=10%><input name=iWiredPort5 type=checkbox value=1>P6</td></tr></table></td></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td colspan=2><b translate>Note</b>: <ol><li translate>802.1X enabled LAN ports only support a single attached device using EAPOL authentication. To authenticate multiple devices through a LAN port you need an 802.1X-capable switch. Then configure 802.1X on the attached switch instead.</li><li id=link_plscfgfotauth ng-show=bLocal8021 translate>Please configure <a>External RADIUS</a> or <a>Local 802.1X</a> for authentication.</li><li ng-show=bLocal8021 translate>Authentication by External RADIUS supports PEAP, EAP-TLS and EAP-TTLS.</li></ol></td></tr></table><table align=center><tr><td><input class=btnw name=btnOk onclick=onClkBtnOk() type=button value=\"{{ 'OK' | translate }}\"></td></tr></table><input name=fid type=hidden><input name=webchange type=hidden value=0><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form><textarea id=lanwiredInit style=\"display: none;\">\n\tvar isSupLinkAgg = parseInt(1);\n\tvar linkAggPorts = [];\n\tvar portNum = parseInt(5);\n</textarea><script> top.ACTION_STATUS=-1;top.iActionStatusFlag='1';top.iFwUpgradeState='0';var appeinitScript=document.createElement('script');appeinitScript.text=document.getElementById(\"lanwired802init\").value;document.head.appendChild(appeinitScript);var bg=parent;var f=document.frm1;var PortNum=4;var aryWiredElmPort=[f.iWiredPort0,f.iWiredPort1,f.iWiredPort2,f.iWiredPort3];var script=document.createElement(\"script\");script.text=document.getElementById(\"lanwiredInit\").value;document.head.appendChild(script);angular.element(document).ready(function(){$scope.bLocal8021=parseInt('1');$scope.$apply();initParameter();initWebChange();});function initParameter(){if(parseInt('1')){bg.showElmtByClass(document,\"tr\",\"local8021x\");bg.showElmtByClass(document,\"div\",\"local8021x\");}else{bg.hideElmtByClass(document,\"tr\",\"local8021x\");bg.hideElmtByClass(document,\"div\",\"local8021x\");}bg.setVle2Elmt(f.iAuthType,iAuthType,0);if(iMaxLanPt==5){PortNum=5;aryWiredElmPort=[f.iWiredPort0,f.iWiredPort1,f.iWiredPort2,f.iWiredPort3,f.iWiredPort4];}else if(iMaxLanPt==6){PortNum=6;aryWiredElmPort=[f.iWiredPort0,f.iWiredPort1,f.iWiredPort2,f.iWiredPort3,f.iWiredPort4,f.iWiredPort5];}bg.setVle2Elmt(f.iWiredEnable,iWired802Enable,0);for(var i=0;i<aryWiredElmPort.length;i++){bg.setVle2Elmt(aryWiredElmPort[i],aryWiredPort[i],0);}if(iWan2En){bg.hideElmtById(document,\"lan4hide\");}onClkEnable();angular.element(document.querySelectorAll(\"#link_plscfgfotauth a\")).eq(0).attr(\"href\",'/cgi-bin/cgiapp.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=0');angular.element(document.querySelectorAll(\"#link_plscfgfotauth a\")).eq(1).attr(\"href\",'/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=2216&iAct=0');if(isSupLinkAgg===1){setLinkAggPortStat();for(var i=0;i<portNum;i++){f[\"iWiredPort\"+i].addEventListener(\"click\",setLinkAggPortStat);}}}if(isSupLinkAgg===1){function setLinkAggPortStat(){if(!f.iWiredEnable.checked){return false;}var ports=linkAggPorts;var controlPort,lockPort;for(var i=0;i<ports.length;i++){controlPort=parseInt(ports[i].lagPort)-1;lockPort=parseInt(ports[i].lagAggrPort)-1;if(controlPort>lockPort){ controlPort=controlPort^lockPort;lockPort=controlPort^lockPort;controlPort=controlPort^lockPort;}f[\"iWiredPort\"+lockPort]&&(f[\"iWiredPort\"+lockPort].disabled=true);if(f[\"iWiredPort\"+controlPort]&&f[\"iWiredPort\"+lockPort]){f[\"iWiredPort\"+lockPort].checked=f[\"iWiredPort\"+controlPort].checked;}}return true;}}function onClkBtnOk(){if(dataCheck()){if(checkWebChange()){f.webchange.value='1';}f.fid.value=2889;bg.cpntCtrl(true,f,f.iAuthType,1);for(var i=0;i<linkAggPorts.length;i++){f[\"iWiredPort\"+(parseInt(linkAggPorts[i].lagPort)-1)].disabled=false;f[\"iWiredPort\"+(parseInt(linkAggPorts[i].lagAggrPort)-1)].disabled=false;}f.submit();}}function dataCheck(){if(iRadiusEnable==0&&f.iAuthType.value==0){alert(gettext(\"Please set RADUIS first!!\"));return false;}if(app_8021x==0&&f.iAuthType.value==1){alert(gettext(\"Please set Local 802.1X first!\"));return false;}return true;}function onClkEnable(){bg.cpntCtrl(f.iWiredEnable,f,f.iAuthType,1);bg.cpntCtrl(f.iWiredEnable,f,f.iWiredPort0,PortNum);if(isSupLinkAgg===1){setLinkAggPortStat();}}</script></body></html>"
