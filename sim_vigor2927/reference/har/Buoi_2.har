            "compression": 26028,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><script src=\"/js/dhtml.min.js?094907\"></script><script></script><style>\n  SELECT.dial {font-family:Arial, Helvetica, Verdana; width:250px; font-size:15px; font-weight:bold}\n</style><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=900><tr><td><b parent=\"{{ 'VPN and Remote Access' | translate }}\" sub-title translate>Connection Management</b><hr><form name=frm1><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>Dial-out Tool</b></td><td align=right class=red><span style=\"display:none\"><translate>Refresh Seconds</translate> : <select name=sltRefresh onChange=onRefresh()><option value=5>5</option><option value=10>10</option><option value=30>30</option></select></span> |&nbsp; <a href=\"javascript: onRefresh()\" translate>Refresh</a>&nbsp;| </td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr align=left><td align=right><span class=\"vpntrunk\" style=\"display:none\"><translate>General Mode</translate>:</span></td><td><select class=dial name=sltDout onChange=onSltDout()><option>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</option><option></option></select><input onClick=Dial() type=button value=\"  {{'Dial' | translate }}  \"></td></tr><tr align=left class=vpntrunk style=display:none><td align=right><translate>Backup Mode</translate>:</td><td><select class=dial name=TrkDout><option>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</option><option></option></select><input onClick=Dial2() type=button value=\"  {{'Dial' | translate }}  \"></td></tr><tr align=left class=vpntrunk_balance style=display:none><td align=right><translate>Load Balance Mode</translate>:</td><td><select class=dial name=BlcDout><option>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</option><option></option></select><input onClick=Dial3() type=button value=\"  {{'Dial' | translate }}  \"> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</td></tr></table></td></tr></table><br><table align=center border=0 cellpadding=5 cellspacing=0 width=100%><tr><td colspan=2><b translate>VPN Connection Status</b></td></tr><tr style=display:none><td><translate>Current Page</translate>: 1</td><td align=right><translate>Page No.</translate><input name=pageIndex size=2 type=text><input onclick=gotopage() To type=button value=\"{{ 'Go' | translate }}\">&nbsp; <script> var vpnpage=parseInt('1');var MaxVpnpage=parseInt('8');var ctx=\"\";if(vpnpage==1){ctx+='<input type=button name=btnP1 value=\">>\" onclick=\"page('+(vpnpage+1)+')\">&nbsp;';}else{if(vpnpage==MaxVpnpage){ctx+='<input type=button name=btnP1 value=\"&lt;&lt;\" onclick=\"page('+(vpnpage-1)+')\">&nbsp;';}else{ctx+='<input type=button name=btnP1 value=\"&lt;&lt;\" onclick=\"page('+(vpnpage-1)+')\">&nbsp;';ctx+='<input type=button name=btnP1 value=\">>\" onclick=\"page('+(vpnpage+1)+')\">&nbsp;';}}document.write(ctx);</script></td></tr><tr style=\"height: 30px;\"><td class=offtab id=tab3 onClick=onChgVpnStatus(3)><b translate>All VPN Status</b></td><td class=offtab id=tab1 onClick=onChgVpnStatus(1)><b><translate>LAN-to-LAN</translate>&nbsp;<translate>VPN Status</translate></b></td><td class=offtab id=tab2 onClick=onChgVpnStatus(2)><b translate>Remote Dial-in User Status</b></td><td width=30%></td></tr></table><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr class=warning style=display:none><td co