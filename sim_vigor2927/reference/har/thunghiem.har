            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><title>Internet Wizard</title><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><script> if(opener!=null)self.close();</script><tr><td><b parent=\"{{ 'CSM' | translate }}\" sub-title translate>DNS Filter</b><hr><form action=/cgi-bin/V2X00.cgi? method=post name=frm1><table border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>DNS Filter Profile Table</b></td><td align=right class=red>| <a class=DenyLink href=javascript:ruOK() translate>Set to Factory Default</a>|</td></tr></table><table border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=0 cellspacing=2 class=table-striped width=100%><thead><tr><th translate width=10%>Profile</th><th translate width=40%>Name</th><th translate width=10%>Profile</th><th translate width=40%>Name</th></tr></thead><tbody><tr align=center ng-init=\"idx = $index + 1\" ng-repeat=\"prof in [].constructor(colOffset) track by $index\"><td> <a href=# ng-click=gotoDetailSet(idx)>{{idx}}.</a></td><td>&nbsp;{{aryDNSProfName[idx-1]}}</td><td> <a href=# ng-click=gotoDetailSet(idx+colOffset)>{{idx+colOffset}}.</a></td><td>&nbsp;{{aryDNSProfName[idx-1+colOffset]}}</td></tr></tbody></table></td></tr></table><table border=0 cellpadding=0 cellspacing=2 width=100%><tr><td colspan=2><b translate>Note</b>: <ol><li id=link_note translate>To make DNS Filter profile effective, please go to <a>Firewall &gt;&gt; Filter Setup</a> page to create a firewall rule and select the desired profile.</li></ol></td></tr></table><br><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>DNS Filter Local Setting</b></td></tr></table><table border=1 cellpadding=2 cellspacing=0 height=200 width=100%><tr><td valign=top><table align=center border=0 cellpadding=0 cellspacing=2 width=600><tr><td colspan=2><br></td></tr><tr><td><b translate>DNS Filter</b></td><td><input name=idnsFltrEn ng-change=\"bwlistEn = (!idnsFltrEn) ? false:bwlistEn\" ng-model=idnsFltrEn type=checkbox value=1><translate>Enable</translate></td></tr><tr ng-if=WCFShow><td> <a href=javascript:WcfLink(); translate>Web Content Filter</a></td><td><select convert-to-number name=isltSrv ng-model=isltSrv size=1><option translate value=0>None</option><option ng-if=prof.length ng-init=\"i = $index+1\" ng-repeat=\"prof in WCFProf track by $index\" value={{i}}>{{ 'WCF' | translate}}-{{i}} {{prof}}</option></select></td></tr><tr><td> <a href=javascript:UrlLink(); translate>URL Content Filter</a></td><td><select convert-to-number name=isltSrvU ng-model=isltSrvU size=1><option translate value=0>None</option><option ng-if=url.length ng-init=\"i = $index+1\" ng-repeat=\"url in WCFProfURL track by $index\" value={{i}}>{{ 'UFC' | translate}}-{{i}} {{url}}</option></select></td></tr><tr><td><b translate>Syslog</b></td><td><select convert-to-number name=isltSyslg ng-model=isltSyslg size=1><option translate value=0>None</option><option translate value=1>Pass Only</option><option translate value=2>Block Only</option><option translate value=3>Both</option></select></td></tr><tr><td colspan=2><br></td></tr><tr><td valign=top><b translate>Black/White List</b></td><td><table align=center border=0 cellpadding=0 cellspacing=2 width=100%><tr><td><input name=bwlistEn ng-disabled=!idnsFltrEn ng-model=bwlistEn type=checkbox value=1><translate>Enable</translate></td><td><select convert-to-number name=sltBWlist ng-disabled=!bwlistEn ng-model=sltBWlist><option translate value=1>Blacklist</option><option translate value=0>Whitelist</option></select></td></tr><tr><td><b translate>Address Type</b></td><td><select convert-to-number name=sAddrType ng-disabled=!bwlistEn ng-model=sltAddrType size=1><option 