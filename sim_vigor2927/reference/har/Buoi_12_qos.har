            "mimeType": "text/html",
            "compression": 34565,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script><script src=/js/QoS.JS></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=850><tr><td><b ng-if=isBwTitle parent=\"{{ ('Bandwidth Management' | translate) }}\" sub-title translate>Quality of Service</b><b ng-if=!isBwTitle parent=\"{{ ('Applications' | translate) }}\" sub-title translate>Quality of Service</b><hr><form action=/cgi-bin/qos.cgi method=post name=frm1><div ng-if=scopeisHwAccelQosEnable style=\"margin-bottom: 15px;\"><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>Hardware QoS General Setup</b></td><td align=right class=red>|&nbsp; <a class=DenyLink href=javascript:ruOK() translate>Set to Factory Default</a>&nbsp;|</td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 width=100%><tr align=center><td translate>Index</td><td translate>Enable</td><td translate>Direction</td><td translate>Egress Bandwidth</td><td><translate>Class</translate> 1</td><td><translate>Class</translate> 2</td><td><translate>Class</translate> 3</td><td translate>Others</td><td translate>Status</td></tr><tr align=center ng-class-even=\"'row1' \" ng-class-odd=\"'row0' \" ng-repeat=\"info in hwAccQoSInfo.aryInfo\"><td ng-if=\"info.type === 'wan'\"><translate>WAN</translate>{{$index+1}}</td><td ng-if=\"info.type === 'lan'\"><translate>Port</translate>{{$index+1 - hwAccQoSInfo.wanNumber}}</td><td><input id=hwQoSChk_{{$index}} name=\"hwQoSEnb{{generate_HwAccQoS_suffix(info.type, $index)}}\" ng-click=enable_hwqos_handler() ng-disabled=!hwAccQoSInfo.hwAccEnable ng-model=info.enable type=checkbox value=1></td><td ng-if=\"info.type === 'wan'\" translate>Egress (Upload)</td><td ng-if=\"info.type === 'lan'\" translate>Egress (Download)</td><td><input max=999999 min=0 name=\"HwQoSBW{{generate_HwAccQoS_suffix(info.type, $index)}}\" ng-change=\"info.bandwidth = aryHwAccQoSDisplayObj[$index].bandwidth * (aryHwAccQoSDisplayObj[$index].unit == '0' ? 1 : 1000)\" ng-disabled=\"!hwAccQoSInfo.hwAccEnable || !info.enable\" ng-model=aryHwAccQoSDisplayObj[$index].bandwidth size=6 step=0.001 type=number><select name=\"HwQoSBWUnit{{generate_HwAccQoS_suffix(info.type, $index)}}\" ng-change=\"info.bandwidth = aryHwAccQoSDisplayObj[$index].bandwidth * (aryHwAccQoSDisplayObj[$index].unit == '0' ? 1 : 1000)\" ng-disabled=\"!hwAccQoSInfo.hwAccEnable || !info.enable\" ng-model=aryHwAccQoSDisplayObj[$index].unit style=height:22px;><option value=0>{{ 'Kbps' | translate }}</option><option value=1>{{ 'Mbps' | translate }}</option></select><input name=\"HwQoSBWKbps{{generate_HwAccQoS_suffix(info.type, $index)}}\" ng-disabled=\"!hwAccQoSInfo.hwAccEnable || !info.enable\" ng-hide=true ng-model=info.bandwidth type=number></td><td><input max=97 min=0 name=\"HwQoSBwRate0{{generate_HwAccQoS_suffix(info.type, $index)}}\" ng-blur=checkRate(0,$index) ng-change=\"info.bwRate[3] = 100-info.bwRate[0]-info.bwRate[1]-info.bwRate[2]\" ng-disabled=\"!hwAccQoSInfo.hwAccEnable || !info.enable\" ng-keyup=rateLimit($index) ng-model=info.bwRate[0] required size=2 type=number>% </td><td><input max=97 min=0 name=\"HwQoSBwRate1{{generate_HwAccQoS_suffix(info.type, $index)}}\" ng-blur=checkRate(1,$index) ng-change=\"info.bwRate[3] = 100-info.bwRate[0]-info.bwRate[1]-info.bwRate[2]\" ng-disabled=\"!hwAccQoSInfo.hwAccEnable || !info.enable\" ng-keyup=rateLimit($index) ng-model=info.bwRate[1] required size=2 type=number>% </td><td><input max=97 min=0 name=\"HwQoSBwRate2{{generate_HwAccQoS_suffix(info.type, $index)}}\" ng-blur=checkRate(2,$index) ng-change=\"info.bwRate[3] = 100-info.bwRate[0]-info.bwRate[1]-info.bwRate[2]\" ng-disabled=\"!hwAccQoSInfo.hwAccEnable || !info.enable\" ng-keyup=rateLimit($index) ng-model=info.bwRate[2] required size=2 type=number>% </td><td><input disabled max=100 min=0 name=\"HwQoSBwRate3{{generate_HwAccQoS_suffix(info.type, $index)}}\" ng-blur=checkRate(3,$index) ng-model=info.bwRate[3] ng-value=\"info.bwRate[3] = 100-info.bwRate[0]-info.bwRate[1]-info.bwRate[2]\" size=2 type=number>% </td><td> <a href=\"/cgi-bin/qos.cgi?sFormAuthStr=TOO7UwhiVtwiiWv&fid=8&iProfileIdx={{count_HwAccQoS_lanwan_index(info.type, $index)+1}}&hwqos={{info.type}}\" ng-click=status_link_click_handler(info.type) translate>Status</a></td></tr></table></td></tr></table><b translate>Note</b>: <ol><li ng-if=adminauth> <a href=\"/cgi-bin/ipnat.cgi?sFormAuthStr=TOO7UwhiVtwiiWv&fid=20&iAct=0\" translate>Please enable hardware acceleration so Hardware QoS will work.</a></li><li translate>Hardware QoS has higher priority than Software QoS.</li></ol></div><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>Software QoS General Setup</b></td><td align=right class=red ng-if=!scopeisHwAccelQosEnable>|&nbsp; <a class=DenyLink href=javascript:ruOK() translate>Set to Factory Default</a>&nbsp;|</td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 width=100%><tr align=center><td translate width=20>Index</td><td translate width=20>Enable</td><td translate width=80>Direction</td><td colspan=2 translate width=340>Ingress / Egress Bandwidth</td><td width=70><translate>Class</translate> 1</td><td width=70><translate>Class</translate> 2</td><td width=70><translate>Class</translate> 3</td><td translate width=70>Others</td><td translate width=50>Status</td><td></td></tr><script> var bg=parent;var MaxRule=MaxRule_cls1=MaxRule_cls2=MaxRule_cls3=MaxRule_cls5=0;var aryBgclr=[\"row0\",\"row1\"];var iUSBWAN=parseInt(\"1\");var WAN_NUM=parseInt(\"6\"); var iFixWanNum=parseInt(\"4\");var iUSBNum=parseInt(\"2\");var 