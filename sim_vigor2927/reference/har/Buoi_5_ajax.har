_path,tmp_name;var strname=document.frm_newfolder.foldername.value;var chk_cnt;if(strname==\"\")return;if(iDiskStatus==0){alert(gettext(\"No USB disk connected! Please insert the disk.\"));return false;}if(iDiskWrite==0){alert(gettext(\"The write protect swtich of USB Disk is turned on, please check.\"));return false;}if(checkName(strname)==false){document.frm_newfolder.foldername.focus();document.frm_newfolder.foldername.select();return;}tmp_path=charReplace(sPath);tmp_name=charReplace(strname);chk_cnt=tmp_path.getBytes()+tmp_name.getBytes();if(chk_cnt>MAX_FILE_NAME_LEN){alert(gettext(\"The folder name is too long! Please re-enter.\"));return false;}document.frm_newfolder.OP.value=3;document.frm_newfolder.DIR.value=tmp_path;document.frm_newfolder.FILE.value=tmp_name;document.frm_newfolder.submit();}function nf_cl(){hideElmtById(document,\"dialogue1\");}function onRefresh(){document.location=\"/doc/usbweb.htm\";}function result_cl(){hideElmtById(document,\"dialoResult\");}function go_to_file(i){var strUrl=\"\";var tmp_path,file_name;tmp_path=charReplace(sPath);file_name=charReplace(sArpTbl[i][0]);if(window.opener&&opener.top.cvmRestore){opener.top.cvmRestore=false;window.opener.document.getElementById(\"path\").value=tmp_path+file_name;window.close();return;}if(sArpTbl[i][1]==1){document.frm_list.OP.value=5;document.frm_list.DIR.value=tmp_path;document.frm_list.FILE.value=file_name;}document.frm_list.submit();}function usbweb_upload(){var tmp,chk_cnt;if(iDiskStatus==0){alert(gettext(\"No USB disk connected! Please insert the disk.\"));return false;}if(iDiskWrite==0){alert(gettext(\"The write protect swtich of USB Disk is turned on, please check.\"));return false;}var f=document.frm_uploadfile;if(!f.uploadfile.value)return;if(f.uploadfile.value.length>0){alert(gettext(\"The file upload will start now. Please stay on this page and avoid clicking anything. The page will refresh once the upload is complete.\"));}tmp=f.uploadfile.value.split(\"\\\\\");tmp=tmp[tmp.length-