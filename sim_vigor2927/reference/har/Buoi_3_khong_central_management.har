            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css></head><style>\ntd.head {background-color:#636363; color:white; font-weight:bold;text-align: center;}\ntr.local {background-color:#f0f0f0;}\n.status {font-weight:bold;font-size:16px}\n</style><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=800><tr><td colspan=2 valign=top><b ng-show=HVjudge parent=\"{{ 'Diagnostics' | translate }}\" sub-title translate>High Availability Status</b><b ng-show=!HVjudge parent=\"{{ 'Diagnostics' | translate }}\" sub-title translate>VRRP Status</b><hr><form action=/cgi-bin/V2X00.cgi method=post name=frm1><div ng-show=!HVjudge><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td>&nbsp;</td><td align=right class=red>|&nbsp; <a href=# ng-click=onGetDetails() translate>Details</a>&nbsp; |&nbsp; <a class=DenyToPage href=\"javascript: gotoHA()\" translate>HA Setup</a>&nbsp; |&nbsp; <a class=DenyLink href=\"javascript: onGetnewState()\" translate>Renew</a>&nbsp; |&nbsp; <a href=\"javascript: onRefresh()\" translate>Refresh</a>&nbsp;|</td></tr></table><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td class=head translate>Status</td><td class=head translate>Router Name</td><td class=head translate>IP</td><td class=head translate>Role</td><td class=head translate>Stable</td><td class=head translate>WAN</td><td class=head ng-if=bHaConfigSYNC translate>Sync Status</td><td class=head translate>Cached Time</td></tr><tr class=local><td align=center><font class=status ng-click=onGetDetails(localRouter.ip) ng-style=\"{'color': localRouter.status[0]}\">{{ localRouter.status[1] }}</font></td><td>&nbsp; <a ng-click=onGetDetails(localRouter.ip) ng-href=# title={{localRouter.title}}>{{ localRouter.name }}</a></td><td>&nbsp; <a ng-click=onGetDetails(localRouter.ip) ng-href=# title={{localRouter.ipv6}}>{{ localRouter.ip }}</a></td><td>&nbsp;<font ng-style=\"{ 'color': localRouter.color[0] }\">{{ localRouter.role }}</font></td><td>&nbsp;<font ng-style=\"{ 'color': localRouter.color[1] }\">{{ localRouter.stable }}</font></td><td>&nbsp;<font ng-style=\"{ 'color': localRouter.color[2] }\">{{ localRouter.wanlink }}</font></td><td ng-if=bHaConfigSYNC>&nbsp;<font ng-style=\"{ 'color': localRouter.color[3] }\">{{ localRouter.syncstat }}</font>&nbsp; <input id=btnSync name=btnSync onclick=onClkSync() type=button value=\"{{ 'Sync' | translate}}\"></td><td>&nbsp;-</td></tr><tr ng-repeat=\"item in remoteRouter\"><td align=center><font class=status ng-click=onGetDetails(item.ip) ng-style=\"{'color': item.status[0]}\">{{ item.status[1] }}</font></td><td>&nbsp; <a ng-click=\"item.none ? '' : onGetDetails(item.ip)\" ng-href=\"{{item.none ? '' : '#'}}\" title={{item.title}}>{{ item.name }}</a></td><td>&nbsp; <a ng-click=\"item.none ? '' : onGetDetails(item.ip)\" ng-href=\"{{item.none ? '' : '#'}}\" title={{item.ipv6}}>{{ item.ip }}</a></td><td>&nbsp;<font ng-style=\"{ 'color': item.color[0] }\">{{ item.role }}</font></td><td>&nbsp;<font ng-style=\"{ 'color': item.color[1] }\">{{ item.stable }}</font></td><td>&nbsp;<font ng-style=\"{ 'color': item.color[2] }\">{{ item.wanlink }}</font></td><td ng-if=bHaConfigSYNC>&nbsp;<font ng-style=\"{ 'color': item.color[3] }\">{{ item.syncstat }}</font></td><td>&nbsp;<font ng-style=\"{ 'color': item.ctime[0] }\">{{ item.ctime[1] }}</font></td></tr></table><br><div><b translate>Note</b>: <ol><li translate>High Availability Status table displays {{max}} routers maximum. The local router will always show in the first row of this table.</li><li id=link_note translate>A Status of \"<font>!</font>\" indicates that an error has occurred, refer to the <a>Details</a> page for more information.</li></ol></div></div><div ng-show=HVjudge><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td>&nbsp;</td><td align=right class=red> |&nbsp; <a class=DenyToPage href=\"javascript: gotoHA()\" translate>VRRP Setup</a>&nbsp; |&nbsp; <a href=\"javascript: onRefresh()\" translate>Refresh</a>&nbsp;| </td></tr></table><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td class=head translate>Profile</td><td class=head translate>Status</td><td class=head translate>VRID</td><td class=head translate>MAC Address</td><td class=head translate>Virtual IP</td><td class=head translate>Management Interface</td></tr><tr class=local ng-repeat=\"item in VrrpData\"><td align=center>{{item.profile}}</td><td align=center>{{item.status | uppercase}}</a></td><td align=center>{{item.vrrd}}</td><td align=center>{{item.macAddress}}</td><td align=center ng-bind-html=item.vIP></td><td align=center>{{item.mgif}}</td></tr></table><br><div><b translate>Note</b>: <ol><li translate>High Availability Status table displays enabled profile.</li><li translate>Check vrrp profile when status is invalid.</li></ol></div></div><input name=fid type=hidden value=2127><input name=sProfileAct type=hidden value=2><input name=inewState type=hidden value=0><input name=iSync type=hidden value=0><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></td></tr></table><textarea id=hastateinit style=display:none>\n\t/*[['DrayTek222','192.168.1.222','Primary','0','0','0','44','00:1d:aa:b1:ce:18','443','Vigor2860 Series','beta_0414','1','0','1','10','draytek','0','6','1','0','0','0','0','15',[['LAN1', '192.168.1.5']]]];*/\n\tvar statemain = [\"DrayTek\",\"192.168.1.1\",\"Primary\",0,0,1,\"-\",\"14:49:bc:88:43:38\",443,\"Vigor2927\",\"4.4.5.7\",0,1,1,10,\"draytek\",0,16,1,0,0,0,0,15,[],[[\"LAN1\",\"FE80::200:5EFF:FE00:101\"],[\"LAN2\",\"FE80::200:5EFF:FE00:101\"],[\"LAN3\",\"FE80::200:5EFF:FE00:101\"],[\"LAN4\",\"FE80::200:5EFF:FE00:101\"],[\"LAN5\",\"FE80::200:5EFF:FE00:101\"],[\"LAN6\",\"FE80::200:5EFF:FE00:101\"],[\"LAN7\",\"FE80::200:5EFF:FE00:101\"],[\"LAN8\",\"FE80::2