1]);}else{ tmp=ipgoItemNameHandler([availIPv6GrpTable,availIPv6ObjTable],itemIdxAry,[2,3,0,1]);}}return tmp;}function clsrule_rdip(rflag,ips,ipe,ipm,itemIdxAry){tmp=gettext(\"Any\");if(rflag&QOS_RULE_DST_ANY)tmp=gettext(\"Any\");if(rflag&QOS_RULE_DST_SGL)tmp=ips;if(rflag&QOS_RULE_DST_RNG)tmp=ips+\" ~ \"+ipe;if(rflag&QOS_RULE_DST_MSK)tmp=ips+\"<br>(\"+gettext(\"mask\")+\":\"+ipm+\")\";if(rflag&QOS_RULE_DST_IPGO&&(itemIdxAry.length!=0)){var splitSign=\", \";var sctIdx;if((rflag&QOS_RULE_IPV6)==0){ tmp=ipgoItemNameHandler([availIPGrpTable,availIPObjTable],itemIdxAry,[6,7,4,5]);}else{ tmp=ipgoItemNameHandler([availIPv6GrpTable,availIPv6ObjTable],itemIdxAry,[6,7,4,5]);}}return tmp;}function clsrule_tr(clsidx,rflag,rsip_s,rsip_e,rsip_m,rdip_s,rdip_e,rdip_m,dscpopt,stype,ruleItemIdxAry){var str=\"<tr align=center class='\"+aryBgclr[MaxRule%2]+\" class\"+clsidx+\"'\"+\">\"; str+=\"<td><a href=# onclick=onEdtRule(\"+clsidx+\",\"+MaxRule+\")>\"+MaxRule+\"</a></td><td>&nbsp;\";str+=\"<input type=checkbox \"+((rflag&QOS_RULE_ENABLE)?\"checked\":\"\")+\" name='FW_status\"+(MaxRule-1)+\"' value='1'> \"; if(clsidx==5)str+=\"</td><td>\"+gettext(\"Priority Class\")+\"</td>\";else str+=\"</td><td>\"+gettext(\"Class\")+clsidx+\"</td>\";str+=\"<td >&nbsp;\"+clsrule_rsip(rflag,rsip_s,rsip_e,rsip_m,ruleItemIdxAry)+\"</td>\";str+=\"<td>&nbsp;\"+clsrule_rdip(rflag,rdip_s,rdip_e,rdip_m,ruleItemIdxAry);str+='</td><td class=\"dscp'+clsidx+'\">&nbsp;'+gettext(dscpopt)+\"</td>\";str+=\"<td>&nbsp;\"+((rflag&QOS_RULE_IPV6)?gettext(\"IPv6\")+\" \":\"\")+gettext(bg.htmlEntityDecode(SrvTypeName(stype-1,rflag,arySerType),document))+\"</td></tr>\";return str;}</script><tr align=center class=row0 id=tradd><td colspan=7><input class=btnw3 onclick=onClkBtnAdd() type=button value=\"{{ 'Add' | translate }}\"></td></tr></table></td></tr></table></td></tr></table><b translate>Note</b>: <ol><li ng-show=THE_PACKET translate>The packets that don't match any class rules above will be classified into 'Others'.</l