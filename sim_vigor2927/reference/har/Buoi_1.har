IpMac(){aryIpBindMac=bg.ShellSort(aryIpBindMac,0);onClkShowCmt();}function onClkBtnAdd(){var i,j,k,idx,flag;var ip1,mac1,hostid1,ip2,mac2;if(aryIpBindMac.length>=IP_MAC_NUM){alert(gettext(\"List Full! Already set ###IP### IP!\").replace(\"###IP###\",IP_MAC_NUM));return false;}idx=f.sltIpArp.selectedIndex;if(idx!=-1){for(i=1,j=0;i<f.sltIpArp.options.length;i++,j++){if((f.sltIpArp.options[i].selected==true)){ip1=aryIpArp[j][0];mac1=aryIpArp[j][1];hostid1=aryIpArp[j][2];if(aryIpBindMac.length>=IP_MAC_NUM){if(flag!=2)alert(gettext(\"List Full! Already set ###IP### IP!\").replace(\"###IP###\",IP_MAC_NUM));flag=2;}else{checkInput1(-1,ip1,mac1,hostid1);}f.sltIpArp.options[i].selected=false;}}}else{var ip1=f.sIpAddress.value;var mac1=f.txtMac.value.toUpperCase();var cmt=f.sComment.value;var hostID=\"\";if(!checkInput(ip1,mac1)){return false;}for(i=0;i<aryIpBindMac.length;i++){if(aryIpBindMac[i][0]==ip1){alert(gettext(\"Already have the same IP Address!\"));return false;}if(aryIpBindMac[i][1]==mac1){for(var k=0;k<aryLanAlsEn.length;k++){if(aryLanAlsEn[k]==1&&bg.isEqualLan(aryIpBindMac[i][0],aryLanAlsMsk[k],ip1)){alert(gettext(\"Already have the same MAC Address!\"));return false;}}}}if(cmt.indexOf(\"\\\"\")!=-1||cmt.indexOf(\"\\'\")!=-1){alert(gettext('Comment can not contain character \" or character \\' ,please re-enter!'));return false;}idx=aryIpBindMac.length;aryIpBindMac[idx]=([ip1,mac1,hostID,cmt]);addToIpMacList(idx);clrTempInput();}}function onClkBtnEdt(){var idx=f.sltIpMac.selectedIndex;var ip1=f.sIpAddress.value;var mac1=f.txtMac.value.toUpperCase();var cmt=f.sComment.value;if((idx==-1)||(idx==0)){return false;}if(!checkInput(ip1,mac1)){return false;}if(cmt.indexOf(\"\\\"\")!=-1||cmt.indexOf(\"\\'\")!=-1){alert(gettext('Comment can not contain character \" or character \\' ,please re-enter!'));return false;}idx=idx-1;if((aryIpBindMac[idx][0]==ip1)&&(aryIpBindMac[idx][1]==mac1)&&(aryIpBindMac[idx][3]==cmt)){return false;}for(i=0;i<aryIpBindMac.length;i++){if((i!=idx)&&(aryIpBindMac[i][0]==ip1)){alert(gettext(\"Already have the same IP Address!\"));return false;}if((i!=idx)&&(aryIpBindMac[i][1]==mac1)){for(var k=0;k<aryLanAlsEn.length;k++){if(aryLanAlsEn[k]==1&&bg.isEqualLan(aryIpBindMac[i][0],aryLanAlsMsk[k],ip1)){alert(gettext(\"Already have the same MAC Address!\"));return false;}}}}var HostID=aryIpBindMac[idx][2];aryIpBindMac[idx]=([ip1,mac1,HostID,cmt]);f.sltIpMac.selectedIndex=-1;addToIpMacList(idx);clrTempInput();}function isSubnetOrBroadcastIp(lan_ip,lan_mask,addr){var aryIp=lan_ip.split(\".\");var aryMask=lan_mask.split(\".\");var aryAddr=addr.split(\".\");var subnet_ip_same,broadcast_ip_same;if((aryIp.length!=4)||(aryMask.length!=4)||(aryAddr.length!=4))return false;subnet_ip_same=0;broadcast_ip_same=0;for(var i=0;i<4;i++){if(aryAddr[i]==(aryIp[i]&aryMask[i]))subnet_ip_same++;if(aryAddr[i]==((aryIp[i]&aryMask[i])|(~aryMask[i]&255)))broadcast_ip_same++;}if((subnet_ip_same==4)||(broadcast_ip_same==4))return true;return false;}function checkInput(ip1,mac1){if(!bg.isStrIp(ip1)){alert(errMSG[0]);return false;}for(var k=0;k<aryLanAlsEn.length;k++){if(aryLanAlsEn[k]==1&&bg.isEqualLan(aryLanAlsIp[k],aryLanAlsMsk[k],ip1))break;}if(k==aryLanAlsEn.length){alert(errMSG[1]);return false;}if(ip1==aryLanAlsIp[k]){alert(errMSG[2]);return false;}if(isSubnetOrBroadcastIp(aryLanAlsIp[k],aryLanAlsMsk[k],ip1)){alert(errMSG[3]);return false;}if(mac1==''){alert(errMSG[4]);return false;}if(!bg.isValidMac(mac1))return false;return true;}function checkInput1(idx,ip1,mac1,hostid1){var flag=1;for(i=0;i<aryIpBindMac.length;i++){ip2=aryIpBindMac[i][0];mac2=aryIpBindMac[i][1];if((ip1==ip2)&&(mac1==mac2)){flag=0;}if((ip1==ip2)&&(mac1!=mac2)){flag=0;f.sltIpMac.options[i+1].selected=true;if(confirm(gettext(\"Already have the same IP Address! Do you want to Update?\"))){aryIpBindMac[i][1]=mac1; addToIpMacList(i);}f.sltIpMac.selectedIndex=-1;}else if((ip1!=ip2)&&(mac1==mac2)){for(var k=0;k<aryLanAlsEn.length;k++){ if(aryLanAlsEn[k]==1&&bg.isEqualLan(ip1,aryLanAlsMsk[k],ip2)){flag=0;f.sltIpMac.options[i+1].selected=true;if(confirm(gettext(\"Already have the same MAC Address! Do you want to Update?\"))){aryIpBindMac[i][0]=ip1; addToIpMacList(i);}f.sltIpMac.selectedIndex=-1;break;}}}}if(flag==1){idx=aryIpBindMac.length;aryIpBindMac[idx]=([ip1,mac1,hostid1,\"\"]);addToIpMacList(idx);}return true;}function onClkBtnRmv(){var idx=f.sltIpMac.selectedIndex;if(idx!=-1){for(i=1,j=0;i<f.sltIpMac.options.length;i++,j++){if(f.sltIpMac.options[i].selected==true){aryIpBindMac=aryIpBindMac.slice(0,j).concat(aryIpBindMac.slice(j+1));j--;}}onClkShowCmt();}}function initSelect(){f.sltIpArp.options[0]=new Option(bg.strFormat(gettext(\"IP Address\"),17)+bg.strFormat(gettext(\"MAC Address\"),19)+bg.strFormat(gettext(\"HOST ID\"),16));}function showOnSltArp(){var idx,i;for(i=1;i<f.sltIpArp.options.length;){f.sltIpArp.options[i]=null;}if(aryIpArp==null)return;for(i=0;i<aryIpArp.length;i++){idx=i+1;f.sltIpArp.options[idx]=new Option(bg.strFormat(aryIpArp[i][0],17)+bg.strFormat(aryIpArp[i][1],19)+bg.strFormat(aryIpArp[i][2],16));}}function showOnSltIpMac(){var idx,i;for(i=0;i<f.sltIpMac.options.length;){f.sltIpMac.options[i]=null;} f.sltIpMac.options[0]=new Option(bg.strFormat(gettext(\"Index\"),7)+bg.strFormat(gettext(\"IP Address\"),17)+bg.strFormat(gettext(\"MAC Address\"),19)+bg.strFormat(gettext(\"HOST ID\"),19)+bg.strFormat(gettext(\"Comment\"),17)); if(aryIpBindMac==null)return;for(i=0;i<aryIpBindMac.length;i++){idx=i+1;f.sltIpMac.options[idx]=new Option(bg.strFormat(idx,7)+bg.strFormat(aryIpBindMac[i][0],17)+bg.strFormat(aryIpBindMac[i][1],19)+bg.strFormat(aryIpBindMac[i][2],19)+bg.strFormat(aryIpBindMac[i][3],17));}}function addToIpMacList(idx){var idx1=idx+1; f.sltIpMac.options[idx1]=new Option(bg.strFormat(idx1,7)+bg.strFormat(aryIpBindMac[idx][0],17)+bg.strFormat(aryIpBindMac[idx][1],19)+bg.strFormat(aryIpBindMac[idx][2],19)+bg.strFormat(aryIpBindMac[idx][3],17));}function clrTempInput(){f.sIpAddress.value=\"\";f.txtMac.value=\"\";f.sComment.value=\"\";f.sIpAddress.focus();} function onClkShowCmt(){var show=bg.getVleFromElmt(f.showCmt,0);showOnSltIpMac();}function onBackup(){var now=new Date();var yy,mm,dd,date,PbxType;yy=now.getFullYear().toString();mm=(now.getMonth()+1).toString();dd=now.getDate().toString();if(mm.length==1)mm=\"0\"+mm;if(dd.length==1)dd=\"0\"+dd;date=yy+mm+dd;myUrl=\"/ipbindmac_\"+date+\".cfg?sFormAuthStr=JdvKVyYlhh7GhS9\"; document.location=myUrl;}function chkEn(bEnable){TurnOn=bEnable;if(parseInt('0')){LearnEnd=(aryLearnInfo[0]==1&&sIpBndMacStrict==1);f.sMacLearnEnable.disabled=!bEnable;chkLearnEn(bEnable?f.sMacLearnEnable.checked:false);}bg.cpntCtrl(bEnable?true:false,f,f.sIpBndMacStrict,1);chkStrict(bEnable?f.sIpBndMacStrict.checked:false);if(!bEnable){f.txtStrict.disabled=true;f.btnEdtStBind.disabled=true;}LearnEnd=false;TurnOn=false;}function chkStrict(bStrict){if(parseInt('0')){if(bStrict&&f.sMacLearnEnable.checked==true&&!LearnEnd){f.sIpBndMacStrict.checked=false;alert(gettext(\"Strict mode and learning mode cannot be enabled at the same time.\"));return;}}bg.cpntCtrl(bStrict,f,f.txtStrict,2);if('1'=='0'){bg.setVle2Elmt(f.idxStrict,\"LAN1\",0);}if(parseInt('0')){if(!bStrict&&f.sMacLearnEnable.checked==true){f.txtStrict.disabled=false;f.btnEdtStBind.disabled=false;}else if(!TurnOn&&!bStrict&&f.sMacLearnEnable.checked==false){f.txtStrict.value=\"\";}}else{if(!TurnOn&&!bStrict){f.txtStrict.value=\"\";}}}function chkLearnEn(bLearnEn){if(bLearnEn&&f.sIpBndMacStrict.checked==true&&!LearnEnd){f.sMacLearnEnable.checked=false;alert(gettext(\"Strict mode and learning mode cannot be enabled at the same time.\"));return;}f.sLearnDay.disabled=!bLearnEn;f.sLearnHrs.disabled=!bLearnEn;f.sLearnMin.disabled=!bLearnEn;f.sNotReset[0].disabled=!bLearnEn;f.sNotReset[1].disabled=!bLearnEn;if(bLearnEn){f.txtStrict.disabled=!bLearnEn;f.btnEdtStBind.disabled=!bLearnEn;if($scope.ShowLearnStatus&&aryLearnInfo[2]==0){f.sNotReset[0].disabled=true;f.sNotReset[1].disabled=true;}}else if(f.sIp