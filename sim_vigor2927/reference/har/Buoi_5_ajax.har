OW_MENU_APP ? '#' : '' }}\" onclick='clktolink(\"dns\")' translate>DrayDDNS License</a></td><td class=\"p-0 ps-2\">{{ myvigorstatus[3] }}</td><td class=\"p-0 ps-2\">{{ myvigorstatus[4] }}</td><td class=\"p-0 ps-2\">{{ myvigorstatus[5] }}</td><td class=\"p-0 ps-2\"><a ng-href=\"{{ AdminOnly ? '#' : '' }}\" ng-click=\"AdminOnly ? OnbtnReg() : false\" translate>Activated</a></td></tr></tbody></table></td></tr><tr><td class=\"p-0 ps-2\"><a href=\"#dosarea\" ng-class=\"{'dashboard open': dosarea, 'dashboard close': !dosarea}\" ng-click=\"dosarea=!dosarea\"></a>&nbsp;<translate>DoS</translate></td><td class=\"p-0 ps-2\"><translate>Attack Detected</translate>:</td><td class=\"p-0 ps-2\" colspan=\"2\"><span ng-repeat=\"item in arySecdos track by $index\" ng-if=\"notSupportWAN.indexOf($index) == -1 && item > 0\"><translate ng-if=\"$index + 1 == iLTEIndexNum && bQLTE\">LTE</translate><translate ng-if=\"$index + 1 != iLTEIndexNum || !bQLTE\">WAN</translate>{{ $index + 1 }}{{ $last ? '' : ', ' }}</span></td></tr><tr ng-show=\"dosarea\"><td class=\"p-0\" colspan=\"4\"><table style=\"border-top:1px solid;border-left:1px solid;border-right:1px solid;border-bottom:1px solid\" class=\"table table-borderless table-striped\"><thead><tr><td class=\"p-0 ps-2\"><b translate>Interface</b></td><td class=\"p-0 ps-2\"><b translate>DoS Defense</b></td><td class=\"p-0 ps-2\"><b translate>Action</b></td></tr></thead><tbody><tr ng-repeat=\"item in arySecdos track by $index\" ng-if=\"notSupportWAN.indexOf($index) == -1 && (iBw1WanEnable || !iBw1WanEnable && 1 != $index)\"><td class=\"p-0 ps-2\"><span ng-if=\"$index + 1 == iLTEIndexNum && bQLTE\">{{sLTEmodulename}}</span><translate ng-if=\"$index + 1 != iLTEIndexNum || !bQLTE\">WAN</translate><span ng-if=\"$index + 1 != iLTEIndexNum || !bQLTE\">{{ $index + 1 }}</span></td><td class=\"p-0 ps-2\"><span ng-if=\"item > 0\" translate>Flood Defense</span><span ng-if=\"item == 0\" translate>Idle</span></td><td class=\"p-0 ps-2\">(<span ng-switch=\"item\"