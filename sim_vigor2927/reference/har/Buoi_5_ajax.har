            "compression": 26030,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><script src=\"/js/dhtml.min.js?094907\"></script><script></script><style>\n  SELECT.dial {font-family:Arial, Helvetica, Verdana; width:250px; font-size:15px; font-weight:bold}\n</style><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=900><tr><td><b parent=\"{{ 'VPN and Remote Access' | translate }}\" sub-title translate>Connection Management</b><hr><form name=frm1><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>Dial-out Tool</b></td><td align=right class=red><span style=\"display:none\"><translate>Refresh Seconds</translate> : <select name=sltRefresh onChange=onRefresh()><option value=5>5</option><option value=10>10</option><option value=30>30</option></select></span> |&nbsp; <a href=\"javascript: onRefresh()\" translate>Refresh</a>&nbsp;| </td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr align=left><td align=right><span class=\"vpntrunk\" style=\"display:none\"><translate>General Mode</translate>:</span></td><td><select class=dial name=sltDout onChange=onSltDout()><option>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</option><option></option></select><input onClick=Dial() type=button value=\"  {{'Dial' | translate }}  \"></td></tr><tr align=left class=vpntrunk style=display:none><td align=right><translate>Backup Mode</translate>:</td><td><select class=dial name=TrkDout><option>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</option><option></option></select><input onClick=Dial2() type=button value=\