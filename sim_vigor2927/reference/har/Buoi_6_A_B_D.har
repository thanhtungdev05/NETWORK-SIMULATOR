MPMngHostPreLen_V62);var Noti_IP_V60=bg.getVleFromElmt(f.SNMPNotiHostIP_V60);var Noti_IP_V61=bg.getVleFromElmt(f.SNMPNotiHostIP_V61);if(Enable_Agent==1){if((Mng_IP0!=\"\"&&!(bg.isStrIp(Mng_IP0)))||(Mng_IP1!=\"\"&&!(bg.isStrIp(Mng_IP1)))||(Mng_IP2!=\"\"&&!(bg.isStrIp(Mng_IP2)))){alert(gettext('Manager Host IP error, please re-enter.'));return false;}if((Noti_IP0!=\"\"&&!(bg.isStrIp(Noti_IP0)))||(Noti_IP1!=\"\"&&!(bg.isStrIp(Noti_IP1)))){alert(gettext('Notification Host IP error, please re-enter.'));return false;}if((Auth_proto==1||Auth_proto==2)&&Enable_V3==1&&Auth_pwd.length<8){alert(gettext('Auth Password must be more than ###NUM### characters, please re-enter.').replace(\"###NUM###\",8));return false;}if((Priv_proto==4||Priv_proto==6)&&Enable_V3==1&&Priv_pwd.length<8){alert(gettext('Privacy Password must be more than ###NUM### characters, please re-enter.').replace(\"###NUM###\",8));return false;}if(!(bg.isStrNum(TrapTimeOut))||TrapTimeOut<1||TrapTimeOut>999){alert(gettext('Trap Timeout should be between ###MIN###-###MAX###, please re-enter.').replace(\"###MIN###\",1).replace(\"###MAX###\",999));return false;}if((Mng_IP_V60!=\"\"&&!bg.isIPv6(Mng_IP_V60))||(Mng_IP_V61!=\"\"&&!bg.isIPv6(Mng_IP_V61))||(Mng_IP_V62!=\"\"&&!bg.isIPv6(Mng_IP_V62))){alert(gettext('Manager Host IPv6 Address error, please re-enter.'));return false;}if((Mng_IP_V60!=\"\"&&(isNaN(Mng_PreLen0)||Mng_PreLen0<1||Mng_PreLen0>128))||(Mng_IP_V61!=\"\"&&(isNaN(Mng_PreLen1)||Mng_PreLen1<1||Mng_PreLen1>128))||(Mng_IP_V62!=\"\"&&(isNaN(Mng_PreLen2)||Mng_PreLen2<1||Mng_PreLen2>128))){alert(gettext('Prefix length should be between ###MIN### and ###MAX###, please re-enter.').replace(\"###MIN###\",1).replace(\"###MAX###\",128));return false;}if((Noti_IP_V60!=\"\"&&!bg.isIPv6(Noti_IP_V60))||(Noti_IP_V61!=\"\"&&!bg.isIPv6(Noti_IP_V61))){alert(gettext('Notification Host IPv6 Address error, please re-enter.'));return false;}}if(checkWebChange()){f.webchange.value='1';}f.sAct.value=\"saveitem\";$scope.onSubmit=tr