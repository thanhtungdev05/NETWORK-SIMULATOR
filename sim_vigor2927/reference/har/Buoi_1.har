            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><script> var tp=top;var op=opener;while(tp.printLogo==null){tp=op.top;op=op.opener;}</script><tr><td><b parent=\"{{ 'User Management' | translate }}\" sub-title translate>General Setup</b><hr><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><br><form action=/cgi-bin/fwuser.cgi method=post name=frm><input name=fid type=hidden value=0><input name=iAct type=hidden><input name=sAdminMsg type=hidden><input name=sltDisplayIP type=hidden><input name=webchange type=hidden value=0><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"><table align=center border=0 cellpadding=2 cellspacing=0 width=90%><tr><td colspan=2><b translate>Mode Selection</b>:<hr></td></tr><tr><td valign=top><input name=sPolicyType onclick=onChgfrMode(0) type=radio value=0></td><td translate><b>Rule-Based</b> is a management method based on IP address. Administrator may set different firewall rules to different IP address.</td></tr><tr><td valign=top><input name=sPolicyType onclick=onChgfrMode(1) type=radio value=1></td><td translate><b>User-Based</b> is a management method based on user profiles. Administrator may set different firewall rules to different user profiles.</td></tr><tr class=modenotice><td></td><td><b translate>Notice for User-Based mode</b>:<br><table><tr valign=top><td>&bull; &nbsp;</td><td translate>In User-Based mode, <b>Active Rules</b> in Firewall will be applied to all LAN clients, packets that matches the Active Rules will be blocked or pass immediately, no user authentication is required.</td></tr><tr valign=top><td>&bull; &nbsp;</td><td translate>Only <b>Inactive Rules</b> in Firewall can be set for individual user profile. In User-Based mode, packets that do not match Active Rules will need authentication, and the Inactive Rule applied to the specific user profile will then take effect. </td></tr></table></td></tr><tr><td colspan=2><br><b translate>Authentication page</b>:<hr></td></tr><tr class=sUesrHttps style=display:none><td>&nbsp;</td><td><translate>Web Authentication</translate>:&nbsp; &nbsp;<input name=iWebAuth type=radio value=0>&nbsp;<translate>HTTPS</translate> &nbsp; &nbsp;<input name=iWebAuth type=radio value=1>&nbsp;<translate>HTTP</translate></td></tr><tr class=sUesrHttpOnly><td>&nbsp;</td><td><translate>Web Authentication</translate>:&nbsp; &nbsp; <translate>HTTP</translate></td></tr><tr><td>&nbsp;</td><td><table></form><div style=\"margin-top: -5px;position:relative;\"><tr><td colspan=2> <a href=javascript:PreWelcome() id=linkWelcome translate>Login Page Greeting</a></td></tr></div></table></td></tr><form action=/cgi-bin/fwuser.cgi method=post name=frm2><tr><td>&nbsp;</td><td><input name=sltDisplayIP type=checkbox value=1>&nbsp;<translate>Display IP address on the dialog box pops up after successful login.</translate></td></tr><tr><td colspan=2><br><b translate>Landing page</b>:<hr></td></tr><tr><td colspan=2><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td>(<translate translate-params-num=\"255\">Max {{num}} characters</translate>)</td><td align=right class=red> <a href=javascript:preview() translate>Preview</a>&nbsp;|&nbsp;<input class=btnw4 onclick=onClkDefMess() type=button value=\"{{ 'Default Message' | translate }}\"></td></tr><tr><td colspan=2><textarea name=sAdminMsg onkeydown=textCounter() onkeyup=textCounter() rows=5 style=width:100%><body stats=1><script> window.location='https://www.draytek.com'</script></body> \r\n\t\t\t\t\t\r\n\t\t\t\t\t\n\t\t\t\t\t</textarea></td></tr></table></td></tr><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form><table align=center width=100%><tr align=center><td><input class=btnw name=btnOk onclick=onClkBtnOk() type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnClr onclick=onClkBtnClr() type=button value=\"{{ 'Clear' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnCcl onclick=onClkBtnCcl() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table></td></tr></table><br><script></script></td></tr></table><script> tp.ACTION_STATUS=-1;tp.iActionStatusFlag='1';tp.iFwUpgradeState='0';tp.act_sta.damage_alert();var bg=tp;var f=document.frm;var f2=document.frm2;var user_mgt_flag='0';var user_mgt_flag2='0';var user_displayip=parseInt(\"0\");var aryFileType=[\"jpg\",\"png\"]; var trans_begin=parseInt('1');var trans='';initPage();initParameter();initWebChange();function initPage(){if(trans_begin&&trans!=\"\"){ f.sPolicyType.disabled=true;}if(!parseInt('0')){bg.showElmtByClass(document,\"tr\",\"sUesrHttps\");bg.hideElmtByClass(document,\"tr\",\"sUesrHttpOnly\");}}function initParameter(){var idx=f.sPolicyType;if((user_mgt_flag>>0)&0x01){idx[1].checked=1;onChgfrMode(1);}else{idx[0].checked=1;onChgfrMode(0);} idx=f.iWebAuth;if((user_mgt_flag2>>0)&0x01)idx[1].checked=1;else idx[0].checked=1;f2.sltDisplayIP.checked=user_displayip;} function textCounter(){if(f2.sAdminMsg.value.length>255)f2.sAdminMsg.value=f2.sAdminMsg.value.substring(0,255);}function onChgfrMode(bchk){if(bchk)bg.showElmtByClass(document,\"tr\",\"modenotice\");else bg.hideElmtByClass(document,\"tr\",\"modenotice\");if(trans_begin&&trans!=\"\"){ if(bchk){ var idx=f.sPolicyType;idx[1].checked=0;idx[0].checked=1;alert(gettext(\"Don't support user management in transparent mode\"));return;}}}function onClkBtnOk(){ if(checkWebChange()){f.webchange.value='1';}bg.setVle2Elmt(f.sAdminMsg,f2.sAdminMsg.value,0);bg.setVle2Elmt(f.sltDisplayIP,f2.sltDisplayIP.checked?1:0,0);f.iAct.value=1;f.submit();}function onClkBtnClr(){f.webchange.value='1';f.iAct.value=2;f.submit();}function onClkBtnCcl(){f.iAct.value=0;f.su