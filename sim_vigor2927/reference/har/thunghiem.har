            "size": 12203,
            "mimeType": "text/html",
            "compression": 8474,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script></head><body class=ng-cloak><textarea id=wcfinit style=display:none>\n\tvar sWcf_Srv_QryHost = \"auto-selected\";\n</textarea><table align=center border=0 cellpadding=0 cellspacing=0 width=700><script> if(opener!=null)self.close();</script><tr><td colspan=2><b parent=\"{{ 'CSM' | translate }}\" qslink=\"https://www.draytek.com/router-help-redirect?stk_title=CSM&nd_title=Web Content Filter Profile\" sub-title translate>Web Content Filter Profile</b><hr><form action=/cgi-bin/cgiwcf.cgi method=post name=frm1><div class=wcf style=display:none><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>Web-Filter License</b></td><td align=right> <a href=javascript:void(0) ng-click=OnbtnReg() translate>Activate</a></td></tr><tr><td colspan=2> [<translate>Status</translate>:  <a ng-click=\"sWCF_Status_key_exp ? OnbtnReg() : ''\" ng-href=\"{{ sWCF_Status_key_exp ? '#' : '' }}\"><font color={{license.color}}>{{ license.status | translate }}</font></a>] <!-- [<translate>Provider</translate>:'Not Activated']&nbsp;[<translate>Start Date</translate>:&nbsp;<translate>Expire Date</translate>:''] --> &nbsp; </td></tr></table><br></div><div class=comtchwcf style=display:none><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td bgcolor=#d0d0d0 width=30%><b translate>Setup Query Server</b> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</td><td><INPUT maxlength=63 name=sHostSrv size=30 style=width:280px type=text value>&nbsp;  <a href=\"https://auth.draytek.com/zone/wcfqueryserver.php?ser_prov=4\" translate>Find more</a></td></tr><tr><td bgcolor=#d0d0d0 width=30%><b translate>Setup Test Server</b> &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</td><td><INPUT maxlength=63 name=sQryHostSrv size=30 style=width:280px type=text value>&nbsp;  <a href=\"https://auth.draytek.com/zone/wcfqueryserver.php?ser_prov=4\" translate>Find more</a></td></tr><tr><td colspan=3><b><script>var wcfinitScript=document.createElement(\"script\");wcfinitScript.text=document.getElementById(\"wcfinit\").value;document.head.appendChild(wcfinitScript);var str=\"\"; var LicWcf_Srv_Host='';var LicWcf_Srv_QryHost='';var iSerProv_id=parseInt(\"4\");var iWCFSP_CPA=parseInt(\"0\"); var iWCFSP_FD=parseInt(\"-1\"); var iWCFSP_DT=parseInt(\"3\"); var iWCFSP_FF=parseInt(\"6\"); var iWCFSP_CT=parseInt(\"4\"); var iWCFSP_CT_ADV=parseInt(\"13\");var sAHVReg_Status_1='Not Activated'; var strLink;if(sAHVReg_Status_1!=\"Not Activated\"){switch(iSerProv_id){case iWCFSP_CT_ADV:case iWCFSP_CT:str+='<a href=\"#\" onclick=\"clkNote()\">';strLink=\"https://www.brightcloud.com/tools/url-ip-lookup.php\";break;case iWCFSP_DT: break;case iWCFSP_FF: break;case iWCFSP_CPA:str+='<a href=\"#\" onclick=\"clkNote()\" tip=query>';strLink=\"http://mtas2.surfcontrol.com/mtas/MTASV4.asp\";break;case iWCFSP_FD:str+='<a href=\"#\" onclick=\"clkNote()\" target=_self>';if(sWcf_Srv_QryHost==\"auto-selected\"||sWcf_Srv_QryHost==\"\")strLink=\"https://\"+LicWcf_Srv_QryHost;else strLink=\"https://\"+sWcf_Srv_QryHost;break;default:break;}if((iSerProv_id!=iWCFSP_FF)&&(iSerProv_id!=iWCFSP_DT)){document.write(str+gettext(\"Look up category by URL, or report inappropriate categorization.\")+\"</a>\");}}</script></b></td></tr></table></td></tr></table><br></div><div class=chinawcf style=display:none><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>Web-Filter Lib File</b></td><td>[<translate>Version</translate>:<font color=red></font>]</td><td>[<translate>Latest Update</translate>:<font color=red></font>]</td><td align=right><input class=btnw3 onClick=onClkDown() type=button value=\"{{ 'Update' | translate }}\"></td></tr></table></div><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>Web Content Filter Profile Table</b>:</td><td align=right class=red width=60%><font color=#000 translate>Cache</font> : <select name=sWcfCache><option translate value=0>None</option><option translate value=1>L1 Cache</option></select> &nbsp;|&nbsp; <a class=DenyLink href=javascript:ruOK() translate>Set to Factory Default</a>&nbsp;|</td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 class=table-striped width=100%><thead><tr><th translate width=10%>Profile</th><th translate width=40%>Name</th><th translate width=10%>Profile</th><th translate width=40%>Name</th></tr></thead><tbody><tr align=center ng-init=\"idx = $index + 1\" ng-repeat=\"prof in [].constructor(col_offset) track by $index\"><td> <a href=# ng-click=gotoDetailSet(idx)>{{idx}}.</a></td><td>&nbsp;{{aryWCFProfName[idx-1]}}</td><td> <a href=# ng-click=gotoDetailSet(idx+col_offset)>{{idx+col_offset}}.</a></td><td>&nbsp;{{aryWCFProfName[idx-1+col_offset]}}</td></tr></tbody></table></td></tr></table><table align=center border=0 cellpadding=0 cellspacing=2 width=100%><tr><td colspan=2><b translate>Note</b>: <ol><li id=link_note translate>To make Web Content Filter profile effective, please go to <a>Firewall &gt;&gt; Filter Setup</a> page to create a firewall rule and select the desired profile.</li></ol></td></tr></table><br><br><table align=center border=0 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center width=100%><tr><td><b><translate>Administration Message</translate>&nbsp;&nbsp;&nbsp;&nbsp;</b> (<translate translate-params-num=\"255\">Max {{num}} characters</translate>)</td><td align=right class=red> <a href=javascript:preview() translate>Preview</a>&nbsp;|&nbsp; <input class=btnw4 onclick=onClkDefMess() type=button value=\"{{ 'Default Message' | translate }}\"></td></tr></table></td></tr><tr><td><textarea name=sWebAdminMsg onkeydown=textCounter() onkeyup=textCounter() rows=5 style=width:100%><body><center><br><br><br><p>The requested Web page <br> from %SIP% <br>to %URL% <br>that is categorized with %CL% <br>has been blocked by %RNAME% Web Content Filter.<p>Please contact your system administrator for further information.</center></body></textarea></td></tr></table><br><table><tr><td><b translate>Legend</b>:</td><tr><tr><td><b>%SIP%&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;&nbsp;<translate>Source IP</translate>&nbsp;&nbsp;,&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;%DIP%&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;&nbsp;<translate>Destination IP</translate>&nbsp;&nbsp;,&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;%URL%&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;&nbsp;<translate>URL</translate></b></td><tr><tr><td><b>%CL%&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;&nbsp;<translate>Category</translate>&nbsp;&nbsp;&nbsp;,&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;%RNAME%&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;-&nbsp;&nbsp;<translate>Router Name</translate></b></td><tr></table><br><table align=center><tr><td><input class=btnw name=btnOk onclick=onClkBtnOk() type=button value=\"{{ 'OK' | translate }}\"></td></tr></table><input name=iOpt type=hidden><input name=iProfileIdx type=hidden><input name=webchange type=hidden value=0><input name=sFormAuthStr type=hidden value=\"IIuPNWCC8qRLLzn\"></form></td></tr></table><textarea id=wcf1init style=display:none>\n\tvar aryWCFProfName = [\"Default\",\"\",\"\",\"\",\"\",\"\",\"\",\"\"];\n\tvar lic_status = '';\n\tvar sWcf_Srv_Host = \"auto-selected\";\n\tvar sWcf_Srv_QryHost = \"auto-selected\";\n\tvar bWcfQP = parseInt('1');\n\tvar iWcfCache = '3';\n\tvar iSerProv_id = parseInt(\"4\");\n\tvar iWCFSP_CT = parseInt(\"4\");\n\tvar iWCFSP_China = parseInt(\"7\");\n\tvar wcf_import = '(nil)';\n\tvar iWCFSP_CT_ADV = parseInt(\"13\");\n\tvar sWCF_Status_key_exp = '0';\n</textarea><sc