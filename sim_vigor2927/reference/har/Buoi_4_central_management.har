            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/dhtml.min.js?094907\"></script><style type=text/css>\n\tbody{position:relative}\n\t#msgal{position:absolute;top:100px;left:30%;width:420px;height:230px;background:#eee;display:none;}\n\t#messagebody{margin:25px;}\n\t#close {margin:10px 180px}\n\t</style><textarea id=swmgprf1init style=\"display: none;\">\nvar notestatus = 0;\nvar sNamePwd = [['','','','','','','','','','','','','','','','','','','','','','','','','','','','','',''], ['','','','','','','','','','','','','','','','','','','','','','','','','','','','','','']];\nvar prftbl = \t[];\nvar newlist = [];\nvar msg = ['','',''];\n</textarea></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><tr><td colspan=2><b parent=\"{{ 'Switch' | translate }}\" qslink=https://www.draytek.com/support/knowledge-base/5279 sub-title translate>Profile</b><hr><form action=/cgi-bin/cgiswm.cgi method=post name=frm1><div id=msgal><div id=messagebody></div><div id=close> <a href=javascript:close() translate>Close</a></div></div><table align=center border=0 cellpadding=2 cellspacing=0 width=800><tr width=100%><td><b translate>Profile List</b></td></tr><tr><td><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr style=\"background-color: #7A7A7A;\" width=100%><td align=center width=7%><font color=#ffffff translate>Index</font></td><td align=center width=16%><font color=#ffffff translate>Name</font></td><td align=center width=16%><font color=#ffffff translate>Group</font></td><td align=center width=19%><font color=#ffffff translate>IP Address</font></td><td align=center width=19%><font color=#ffffff translate>MAC Address</font></td><td align=center width=10%><font color=#ffffff translate>Model</font></td><td align=center width=13%><font color=#ffffff translate>Password</font></td><td align=center width=10%><font color=#ffffff translate>Process Status</font></td><td align=center class=BTHide width=3%><font color=#ffffff translate>Delete Profile</font></td></tr><script> var appeinitScript=document.createElement('script');appeinitScript.text=document.getElementById(\"swmgprf1init\").value;document.head.appendChild(appeinitScript); var str='';for(i=0;i<prftbl.length;i++){if(prftbl[i][5]!=-1)str+='<tr class=row'+(i+1)%2+'><td align=center><a href=\"javascript:gotoDetailSet('+(i+1)+','+prftbl[i][5]+','+prftbl[i][6]+')\">'+(i+1)+'</a></td>';else str+='<tr class=row'+(i+1)%2+'><td align=center>'+(i+1)+'</td>';str+='<td align=center>'+prftbl[i][0]+'</td>';str+='<td style=\"word-break:break-all\" align=center>'+prftbl[i][1]+'</td>';if(prftbl[i][6]==1&&prftbl[i][5]!=-1&&prftbl[i][4]!='G1241'&&prftbl[i][4]!='P1100'){str+='<td align=center><a target=\"_blank\" href=\"http://'+prftbl[i][2]; if(prftbl[i][4]=='P2261'||prftbl[i][4]=='G2260')str+='/config/login?username='+sNamePwd[0][prftbl[i][7]]+'&password='+sNamePwd[1][prftbl[i][7]]+'\">';else str+='\">';str+='<font color=green>'+prftbl[i][2]+'</font></td>';}else if(prftbl[i][6]==1&&prftbl[i][5]!=-1&&(prftbl[i][4]=='G1241'||prftbl[i][4]=='P1100')){str+='<td align=center><a href=\"javascript:postG1241('+i+',0);\">';str+='<font color=green>'+prftbl[i][2]+'</font></td>';}else if(prftbl[i][6]==1&&prftbl[i][5]==-1){str+='<td align=center><a target=\"_blank\" href=\"http://'+prftbl[i][2];if(prftbl[i][4]=='G1260')str+='/pass?password='+sNamePwd[1][prftbl[i][7]]+'&submit=Login\">';else if(prftbl[i][4]=='G2080')str+='/fake_server.html?textuser='+sNamePwd[0][prftbl[i][7]]+'&textpass='+sNamePwd[1][prftbl[i][7]]+'&Submit=Login\">';else str+='\">';str+='<font color=green>'+prftbl[i][2]+'</font></td>';}else str+='<td align=center><font color=red>X '+prftbl[i][2]+'</font></td>';str+='<td align=center>'+prftbl[i][3]+'</td>';str+='<td align=center>'+prftbl[i][4]+'</td>'