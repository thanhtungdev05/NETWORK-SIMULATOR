          "content": {
            "size": 8129,
            "mimeType": "text/html",
            "compression": 5598,
            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=720><tr><td><b parent=\"{{ 'System Maintenance' | translate }}\" sub-title translate>User Password</b><hr><form action=/cgi-bin/chgbas2.cgi method=POST name=frm1><span class=\"EN_USER_MODE\"><input name=enUser1 onchange=enUserMode() type=checkbox value=1><translate>Enable User Mode for simple web configuration</translate></span><br><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td align=right class=red>|&nbsp; <a class=DenyLink href=javascript:ruOK() translate>Set to Factory Default</a>&nbsp;|</td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=550><tr class=oldPassword><td translate width=35%>Old Password</td><td width=65%><input maxlength={{pwlen}} name=sSysOldPass size=20 type=password></td></tr><tr><td translate width=35%>Password</td><td width=65%><input maxlength={{pwlen}} name=sSysPass onBlur=pwStrength(this.name,this.value) onKeyUp=pwStrength(this.name,this.value) placeholder=\"{{ 'Max: ###LEN### characters' | translate }}\" size=20 type=password></td></tr><tr><td translate>Confirm Password</td><td><input maxlength={{pwlen}} name=sSysNewPass placeholder=\"{{ 'Max: ###LEN### characters' | translate }}\" size=20 type=password></td></tr><tr><td width=250><translate>Password Strength</translate>:</td><td><table cellspacing=0 cellspadding=0 style=height:20px;line-height:20px;border:0;><tr align=center><td id=wk_sSysPass style=background:#ddd;color:#fff; translate width=63>Weak</td><td width=1></td><td id=md_sSysPass style=background:#ddd;color:#fff; translate width=63>Medium</td><td width=1></td><td id=st_sSysPass style=background:#ddd;color:#fff; translate width=63>Strong</td></tr></table></td></tr><tr><td colspan=2><translate>Strong password requirements</translate>: <br>1. <translate>Have at least one upper-case letter and one lower-case letter.</translate><br>2. <translate>Including non-alphanumeric characters is a plus.</translate></td></tr></table></td></tr></table><div class=user2 style=display:none><br><span class=\"EN_USER_MODE\"><input name=enUser2 onchange=enUserMode() type=checkbox value=1><translate>Enable User Mode 2 for simple web configuration</translate></span><br><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>User 2 Password</b></td></tr></table><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=550><tr class=oldPassword><td translate width=40%>Old Password</td><td width=60%><input maxlength={{pwlen}} name=sSysOldPass2 size=20 type=password></td></tr><tr><td translate>Password</td><td><input maxlength={{pwlen}} name=sSysPass2 placeholder=\"{{ 'Max: ###LEN### characters' | translate }}\" size=20 type=password></td></tr><tr><td translate>Confirm Password</td><td><input maxlength={{pwlen}} name=sSysNewPass2 placeholder=\"{{ 'Max: ###LEN### characters' | translate }}\" size=20 type=password></td></tr></table></td></tr></table></div><table border=0 cellpadding=2 cellspacing=0 width=100%><tr><td colspan=2><b translate>Note</b>: <ol><li ng-show=\"'2927'!='2710'\"><translate>Password can contain</translate> a-z A-Z 0-9 , ; : . &quot; < > * + = \\ | ? @ # ^ ! ( )</li><li ng-show=\"'2927'!='2710'\" translate>Password can't be all asterisks(*). For example, '*' or '***' is illegal, but '123*' or '*45' is OK.</li></ol></td></tr></table><br><table align=center><tr><td><input class=btnw name=ok onclick=onClkBtnOk() type=button value=\"{{ 'OK' | translate }}\"></td></tr></table><input name=iWebCfgLevel type=hidden value=\"0\"><input name=webchange type=hidden value=0><input name=userdefault type=hidden value=0><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></td></tr></table><script> top.ACTION_STATUS=-1;top.iActionStatusFlag='0';top.iFwUpgradeState='0';top.act_sta.damage_alert();var bg=top;var f=document.frm1;var pwlen_min=8;angular.element(document).ready(function(){initPage();initParameter();initWebChange();});function initPage(){if(1){bg.hideElmtByClass(document,\"tr\",\"oldPassword\");}if('2'==3){bg.showElmtByClass(document,\"div\",\"user2\");}if(parseInt('0')){bg.hideElmtByClass(document,\"span\",\"EN_USER_MODE\");}if(parseInt('0'))f.enUser1.disabled=true;}function initParameter(){bg.setVle2Elmt(f.enUser1,0,0);bg.setVle2Elmt(f.enUser2,0,0);if('0'==1){bg.setVle2Elmt(f.enUser1,1,0);}else{bg.setVle2Elmt(f.enUser1,0,0);}if('0'==1){bg.setVle2Elmt(f.enUser2,1,0);}else{bg.setVle2Elmt(f.enUser2,0,0);}enUserMode();if('1'=='1'){$scope.pwlen=83;}else{$scope.pwlen=23;}$scope.$apply();angular.forEach(document.querySelectorAll(\"input[placeholder]\"),function(self){self.placeholder=self.placeholder.replace(\"###LEN###\",self.maxLength);});}function enUserMode(){if(f.enUser1.checked){bg.cpntCtrl(true,f,f.sSysOldPass,3);}else{bg.cpntCtrl(false,f,f.sSysOldPass,3);}if(f.enUser2.checked){bg.cpntCtrl(true,f,f.sSysOldPass2,3);}else{bg.cpntCtrl(false,f,f.sSysOldPass2,3);}}function onClkBtnOk(){var re=/[^a-zA-Z0-9,;:.\"<>*\\+=\\\\\\|\\?@#\\^!\\(\\)]/;if(f.enUser1.checked){if(f.sSysPass.value==\"\"){alert(gettext(\"The new password can not be empty!\"));return false;}if(f.sSysPass.value.match(re)){alert(gettext(\"Illegal character in password, please check!\"));return false;}if(f.sSysPass.value.length>$scope.pwlen){alert(gettext(\"The length of the password cannot be longer than ###MAX### characters. Please enter it again.\").replace(\"###MAX###\",$scope.pwlen));return false;}if(f.sSysPass.value!=f.sSysNewPass.value){alert(gettext(\"Passwords do not match. Pleas