value=\"private\"></td></tr><tr><td colspan=2><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td width=35%>&nbsp;&nbsp;&nbsp;&nbsp;<translate>Manager Host IP</translate>(<translate>IPv4</translate>)</td><td align=center translate width=10%>Index</td><td align=center translate width=20%>IP</td><td align=center translate width=25%>Subnet Mask</td><td>&nbsp;</td></tr><script>var ihostNum=(aryHostNum[0]+aryHostNum[1])*2+aryHostNum[2]+aryHostNum[3];var str=\"\";for(var i=0;i<aryHostNum[0];i++){if(aryTrustHostIP[i][0]=='0.0.0.0'||aryTrustHostIP[i][0]=='255.255.255.255')aryTrustHostIP[i][0]=\"\";str+=\"<tr><td>&nbsp;&nbsp;&nbsp;&nbsp;</td>\";str+=\"<td align=center>\"+(i+1)+\"</td>\";str+=\"<td><input type=text ng-disabled='!snmpAgentEn || (!snmpAgentEnV2C && !snmpAgentEnV1 && !snmpAgentEnV3) && !onSubmit'  name=SNMPMngHostIP\"+i+\" value=\\\"\"+aryTrustHostIP[i][0]+\"\\\" size=17 maxlength=15></td>\";str+=\"<td><select ng-disabled='!snmpAgentEn || (!snmpAgentEnV2C && !snmpAgentEnV1 && !snmpAgentEnV3) && !onSubmit' name=SNMPMngHostMask\"+i+\"><option value=0></option><option value=32>255.255.255.255 / 32</option>\";str+=\"<option value=31>255.255.255.254 / 31</option><option value=30>255.255.255.252 / 30</option>\";str+=\"<option value=29>255.255.255.248 / 29</option><option value=28>255.255.255.240 / 28</option>\";str+=\"<option value=27>255.255.255.224 / 27</option><option value=26>255.255.255.192 / 26</option>\";str+=\"<option value=25>255.255.255.128 / 25</option><option value=24>255.255.255.0 / 24</option>\";str+=\"<option value=23>255.255.254.0 / 23</option><option value=22>255.255.252.0 / 22</option></select></td></tr>\";}document.write(str);</script></table></td></tr><tr ng-show=bDrayIpv6Enable><td colspan=2><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td width=35%>&nbsp;&nbsp;&nbsp;&nbsp;<translate>Manager Host IP</translate>(<translate>IPv6</translate>)</td><td align=center translate width=10%>Index</td><td align=center translate width=42%>IPv6 Address</td><td> / <translate>Prefix Length</translate></td></tr><script>if(!parseInt('0'))aryTrustHostIPv6=[['','0'],['','0'],['','0']];var str=\"\";for(var i=0;i<aryHostNum[1];i++){str+=\"<tr><td>&nbsp;&nbsp;&nbsp;&nbsp;</td>\";str+=\"<td align=center>\"+(i+1)+\"</td>\";str+=\"<td><input ng-disabled='!snmpAgentEn || (!snmpAgentEnV2C && !snmpAgentEnV1 && !snmpAgentEnV3) && !onSubmit' type=text  name=SNMPMngHostIP_V6\"+i+\" value=\\\"\"+aryTrustHostIPv6[i][0]+\"\\\" size=40 maxlength=128 ></td><td> /\";str+=\"<input ng-disabled='!snmpAgentEn || (!snmpAgentEnV2C && !snmpAgentEnV1 && !snmpAgentEnV3) && !onSubmit' type=text size=3 maxlength=3 name=SNMPMngHostPreLen_V6\"+i+\" value=\"+aryTrustHostIPv6[i][1]+\"></td></tr>\";}document.write(str);</script></table></td></tr><tr><td width=45%>&nbsp;&nbsp;&nbsp;&nbsp;<translate>Trap Community</translate></td><td><input maxlength=23 name=SNMPTrapCom ng-disabled=\"!snmpAgentEn || (!snmpAgentEnV2C && !snmpAgentEnV1 && !snmpAgentEnV3) && !onSubmit\" size=17 type=text value=\"public\"></td></tr><tr><td colspan=2><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td style=\"padding-left: 20px\" width=35%><translate>Notification Host IP</translate>(<translate>IPv4</translate>)</td><td align=center translate width=10%>Index</td><td align=center translate width=20%>IP</td><td>&nbsp;</td></tr><script>var str=\"\";for(var i=0;i<aryHostNum[2];i++){if(aryNotifyHostIP[i]=='0.0.0.0'||aryNotifyHostIP[i]=='255.255.255.255')aryNotifyHostIP[i]=\"\";str+=\"<tr><td>&nbsp;&nbsp;&nbsp;&nbsp;</td>\";str+=\"<td align=center>\"+(i+1)+\"</td>\";str+=\"<td><input ng-disabled='!snmpAgentEn || (!snmpAgentEnV2C && !snmpAgentEnV1 && !snmpAgentEnV3) && !onSubmit' type=text  name=SNMPNotiHostIP\"+i+\" value=\\\"\"+aryNotifyHostIP[i]+\"\\\" size=17 maxlength=15></td></tr>\";}document.write(str);</script></table></td></tr><tr ng-show=bDrayIpv6Enable><td colspan=2><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td style=\"padding-left: 20px\" width=35%><translate>Notification Host IP</translate>(<translate>IPv6</translate>)</td><td align=center translate width=10%>Index</td><td align=center translate width=42%>IPv6 Address</td><td>&nbsp;</td></tr><script>if(!parseInt('0'))aryNotifyHostIPv6=['',''];var str=\"\";for(var i=0;i<aryHostNum[3];i++){str+=\"<tr><td>&nbsp;&nbsp;&nbsp;&nbsp;</td>\";str+=\"<td align=center>\"+(i+1)+\"</td>\";str+=\"<td><input ng-disabled='!snmpAgentEn || (!snmpAgentEnV2C && !snmpAgentEnV1 && !snmpAgentEnV3) && !onSubmit' type=text  name=SNMPNotiHostIP_V6\"+i+\" value=\\\"\"+aryNotifyHostIPv6[i]+\"\\\" size=40 maxlength=128 ></td></tr>\";}document.write(str);</script></table></td></tr><tr><td width=45%>&nbsp;&nbsp;&nbsp;&nbsp;<translate>Trap Timeout</translate></td><td><label><input maxlength=6 name=SNMPTrapTimeOut ng-disabled=\"!snmpAgentEn || (!snmpAgentEnV2C && !snmpAgentEnV1 && !snmpAgentEnV3) && !onSubmit\" size=17 type=text value=\"10\">&nbsp;<translate>Seconds</translate></label></td></tr><tr><td colspan=2><label><input name=SNMPAgentEnV1 ng-disabled=!snmpAgentEn ng-model=snmpAgentEnV1 type=checkbox value=1><translate>Enable SNMPv1 Agent</translate></label></td></tr></table></td></tr></table></td></tr></table><div ng-show=showsysadmin><b translate>Note</b>: <ol><li id=link_note translate>SNMP service also shall be enabled for Internet access in <a>System Maintenance &gt;&gt; Management</a>.</li></ol></div><br><table align=center width=100%><tr align=center><td><input class=btnw name=snmp_btnOk onclick=submitParameter() type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <input class=btnw name=snmp_btnCcl onclick=cancel() type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table><input name=sAct type=hidden value=saveitem><input name=webchange type=hidden value=0><input name=sFormAuthStr type=hidden value=\"pU2VHFY4WAi1NkA\"></form><script src=\"/js/variable.js?5644\"></script><script>top.ACTION_STAT