            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'Certificate Management' | translate }}\" sub-title translate>Local Services List</b><hr><form action=/cgi-bin/v2x00.cgi method=post name=frm1><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td style=width:20% translate>Default Certificate</td><td><select name=defCert><option ng-selected=\"defcertSelected == 0\" translate value=0>self-signed</option><option ng-if=\"!$first && !$last\" ng-repeat=\"x in LoCfInfo\" ng-selected=\"{{x[1]}} == defcertSelected\" value={{x[1]}}>{{x[0]}}</option></select></td></tr></table><br><table align=center border=1 cellPadding=2 cellSpacing=0 width=100%><tr><td><table cellPadding=2 cellSpacing=2 class=table-striped style=text-align:center width=100%><thead><tr><th align=center style=width:30%><b translate>Certificate Name</b></th><th align=center><b translate>Local Services</b></th></tr></thead><tbody ng-init=outerIndex=$index ng-repeat=\"r in uid2Serv\" style=text-align:center><tr ng-repeat=\"x in r\"><td class=cerfield{{outerIndex}} ng-if=$first>{{LoCfInfo[outerIndex][0]}}</td><td ng-if=\"x == 4 || x == 5\"> <a href=\"/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=2410&sAct=showpage\">{{LoServ[x]}}</a></td><td ng-if=\"x == 7\"> <a href=\"/cgi-bin/cgiapp.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=0\" ng-click=setRadiusTag()>{{LoServ[x]}}</a></td><td ng-if=\"x == 8\"> <a href=\"/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=2216&iAct=0\">{{LoServ[x]}}</a></td><td ng-if=\"x == -1\">&nbsp;</td><td ng-if=\"x == 12\"> <a href=\"/cgi-bin/V2X00.cgi?fid=2037&sFormAuthStr=JdvKVyYlhh7GhS9\">{{LoServ[x]}}</td><td ng-if=\"x != 4 && x != 5 && x != 7 && x != 8 && x!=-1 && x!=12\">