            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><script src=\"/js/dhtml.min.js?094907\"></script><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><style>\n  .suboptions {\n    padding-left: 20px;\n  }\n</style></head><body class=ng-cloak><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'Firewall' | translate }}\" sub-title translate>Defense Setup</b><hr><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td class=offtab id=tab1 onClick=dhtml.cycleTab(this.id) width=30%><b translate>DoS Defense</b></td><td class=offtab id=tab2 ng-show=adminauth onClick=dhtml.cycleTab(this.id) width=30%><b translate>Spoofing Defense</b></td><td class=offtab id=tab3 ng-show=\"bEncKeyAlg && b_bfp\" onClick=dhtml.cycleTab(this.id) width=30%><b translate>Brute Force Protection</b></td><td class=tabpadding>&nbsp;</td></tr></table><br><div id=page1 style=display:none><form name=frm1><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>DoS defense</b></td></tr></table><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td colspan=3><input name=chxDos type=checkbox><translate>Enable DoS Defense</translate> &nbsp;&nbsp;<input class=btnw3 name=chxSltAll type=button value=\"{{ 'Select All' | translate }}\">&nbsp;<input class=BTnotGrayed name=btnWBlist type=button value=\"{{ 'White/Black List Option' | translate }}\"></td><td align=right width=30%><translate>Log</translate>: <select name=sltLog><option translate value=1>Enable</option><option translate value=0>Disable</option></select></td></tr><tr class=row0><td width=2%>&nbsp;</td><td width=49%><input name=chxSynFld type=checkbox><translate>Enable SYN flood defense</translate></td><td width=19%><translate>Threshold</translate></td><td width=30%><input maxlength=5 name=txtSynFld size=5 type=text> &nbsp;<translate>packets</translate> / <translate>sec</translate>&nbsp;</td></tr><tr class=row0><td width=2%>&nbsp;</td><td width=49%>&nbsp;</td><td translate width=19%>Timeout</td><td width=30%><input maxlength=5 name=txtSynTO size=5 type=text> &nbsp;<translate>sec</translate>&nbsp;</td></tr><tr class=row1><td width=2%>&nbsp;</td><td width=49%><input name=chxUdpFld type=checkbox><translate>Enable UDP flood defense</translate></td><td translate width=19%>Threshold </td><td width=30%><input maxlength=5 name=txtUdpFld size=5 type=text> &nbsp;<translate>packets</translate> / <translate>sec</translate>&nbsp;</td></tr><tr class=row1><td width=2%>&nbsp;</td><td width=49%>&nbsp;</td><td translate width=19%>Timeout</td><td width=30%><input maxlength=5 name=txtUdpTO size=5 type=text> &nbsp;<translate>sec</translate></td></tr><tr class=row0><td width=2%>&nbsp;</td><td width=49%><input name=chxIcmpFld type=checkbox><translate>Enable ICMP flood defense</translate></td><td translate width=19%>Threshold</td><td width=30%><input maxlength=5 name=txtIcmpFld size=5 type=text> &nbsp;<translate>packets</translate> / <translate>sec</translate>&nbsp;</td></tr><tr class=row0><td width=2%>&nbsp;</td><td width=49%>&nbsp;</td><td translate width=19%>Timeout</td><td width=30%><input maxlength=5 name=txtIcmpTO size=5 type=text> &nbsp;<translate>sec</translate></td></tr><tr class=row1><td width=2%>&nbsp;</td><td width=49%><input name=chxPS type=checkbox><translate>Enable Port Scan detection</translate></td><td translate width=19%>Threshold</td><td width=30%><input maxlength=5 name=txtPS size=5 type=text> &nbsp;<translate>packets</translate> / <translate>sec</translate>&nbsp;</td></tr><tr><td width=2%>&nbsp;</td><td width=49%><input name=chxBlkIp type=checkbox><translate>Block IP options</translate></td><td colspan=2><input name=chxBlkTcp type=checkbox value=checkbox><translate>Block TCP flag scan</translate></td></tr><tr><td width=2%>&nbsp;</td><td width=49%><input name=chxBlkLnd type=checkbox><translate>Block Land</translate></td><td colspan=2><input name=chxBlkTDrp type=checkbox><translate>Block Tear Drop</translate></td></tr><tr><td width=2%>&nbsp;</td><td width=49%><input name=chxBlkSmf type=checkbox><translate>Block Smurf</translate></td><td colspan=2><input name=chxBlkPing type=checkbox><translate>Block Ping of Death</translate></td></tr><tr><td width=2%>&nbsp;</td><td width=49%><input name=chxBlkTR type=checkbox><translate>Block trace route</translate></td><td colspan=2><input name=chxBlkIcmpFrag type=checkbox><translate>Block ICMP fragment</translate></td></tr><tr><td width=2%>&nbsp;</td><td width=49%><input name=chxBlkSynFrag type=checkbox><translate>Block SYN fragment</translate>&nbsp;</td><td colspan=2><input name=chxBlkUnProt type=checkbox><translate>Block Unassigned Numbers</translate></td></tr><tr><td width=2%>&nbsp;</td><td width=49%><input name=chxBlkFraggle type=checkbox><translate>Block Fraggle Attack</translate>&nbsp;</td><td colspan=2></td></tr></table><br><table align=center border=0><tr><td><textarea cols=70 disabled name=txtComment rows=3></textarea></td></tr></table></td></tr></table><br><table align=center border=0 width=100%><tr align=center><td><input class=btnw name=btnOk type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <input class=btnw3 name=btnClr type=button value=\"{{ 'Clear All' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnCcl type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table><table border=0 width=100%><tr><td colspan=2><b translate>Note</b>: <ol><li translate>Enabling the UDP Flood Defense option may affect UDP services, like NAT-T VPN, DNS, and VoIP service.</li><translate>When you have UDP servers running, please increase the UDP threshold according to the Internet speed, or add the server IP into the White List.</translate>&nbsp; <translate>The suggested threshold value are as follows</translate>:<br> 20M &nbsp;&nbsp;<translate>Bandwidth</translate>: 2,000 &nbsp;&nbsp;(<translate>packets</translate>/<translate>sec</translate>)<br> 60M &nbsp;&nbsp;<translate>Bandwidth</translate>: 5,000 &nbsp;&nbsp;(<translate>packets</translate>/<translate>sec</translate>)<br> 100M <translate>Bandwidth</translate>: 8,000 &nbsp;&nbsp;(<translate>packets</translate>/<translate>sec</translate>)<br> 300M <translate>Bandwidth</translate>: 25,000 (<translate>packets</translate>/<translate>sec</translate>) <li translate>Packets that have been accelerated by Hardware Acceleration will not be checked by the DoS Defense function.</li></ol></td></tr></table><br><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></div><div id=page2 style=display:none><form action=/cgi-bin/v2x00.cgi method=POST name=arpdefense><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>ARP Spoofing Defense</b></td><td align=right width=30%><translate>Log</translate>: <select name=sltLog><option translate value=1>Enable</option><option translate value=0>Disable</option></select></td></tr></table><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><input name=BlockArp1 type=checkbox value=1><translate>Block ARP replies with inconsistent source MAC addresses.</translate></td></tr><tr><td><input name=BlockArp2 type=checkbox value=1><translate>Block ARP replies with inconsistent destination MAC addresses.</translate></td></tr><tr><td><input name=DeclineVRRP type=checkbox value=1><translate>Decline VRRP MAC into ARP table.</translate></td></tr></table></td></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>IP Spoofing Defense</b></td></tr></table><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><input name=BlockIp1 type=checkbox value=1><translate>Block IP packet from WAN with inconsistent source IP addresses.</translate></td></tr><tr><td><input name=BlockIp2 type=checkbox value=1><translate>Block IP packet from LAN with inconsistent source IP addresses.</translate></td></tr></table></td></tr></table><table align=center border=0 width=100%><tr align=center><td><input class=btnw name=btnARPOk type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnARPCcl type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table><br><input name=fid type=hidden value=2033><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></div><div id=page3 style=display:none><form action=/cgi-bin/v2x00.cgi method=POST name=bfprotect><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>Brute Force Protection</b></td></tr></table><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td colspan=2><input name=iBrEn ng-model=brEnChecked type=checkbox value=1><translate>Enable brute force login protection</translate></td></tr><tr><td class=suboptions colspan=2><input name=iBrFtp ng-disabled=!brEnChecked type=checkbox value=1><translate>FTP Server</translate></td></tr><tr><td class=suboptions colspan=2><input name=iBrHttp ng-disabled=!brEnChecked type=checkbox value=1><translate>HTTP Server</translate></td></tr><tr><td class=suboptions colspan=2><input name=iBrHttps ng-disabled=!brEnChecked type=checkbox value=1><translate>HTTPS Server</translate></td></tr><tr><td class=suboptions colspan=2><input name=iBrTelnet ng-disabled=!brEnChecked type=checkbox value=1><translate>Telnet Server</translate></td></tr><tr><td class=suboptions colspan=2><input name=iBrTr069 ng-disabled=!brEnChecked type=checkbox value=1><translate>TR069 Server</translate></td></tr><tr><td class=suboptions colspan=2><input name=iBrSsh ng-disabled=!brEnChecked type=checkbox value=1><translate>SSH Server</translate></td></tr><tr><td class=suboptions colspan=2><input name=iBrVPN ng-disabled=!brEnChecked type=checkbox value=1><translate>VPN Server</translate></td></tr><tr><td class=suboptions translate>Maximum login failures</td><td><input maxlength=3 name=iLoginFailures size=5 value=0>&nbsp;<translate>times</translate></td></tr><tr><td class=suboptions translate>Penalty period</td><td><input maxlength=8 name=iPenaltyPeriod size=5 value=0>&nbsp;<translate>seconds</translate></td></tr><tr><td colspan=2> <a href=\"/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=193\" translate>Blocked IP List</a></td></tr></table></td></tr></table><table align=center border=0 width=100%><tr align=center><td><input class=btnw name=btnBFPOk type=button value=\"{{ 'OK' | translate }}\">&nbsp;&nbsp; <input class=btnw name=btnBFPCcl type=button value=\"{{ 'Cancel' | translate }}\"></td></tr></table><br><input name=fid type=hidden value=2076><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></div></td></tr></table><textarea id=dosinit style=display:none>\n  var arrBfpSrv = [1,1,1,1,1,1,1,1,5,300];\n  var b_bfp = 1;\n  var bEncKeyAlg = 1;\n</textarea><script src=\"/js/variable.js?34771\"></script><script> top.ACTION_STATUS=-1;top.iActionStatusFlag='1';top.iFwUpgradeState='0';top.act_sta.damage_alert();var dosinitScript=document.createElement(\"script\");dosinitScript.text=document.getElementById(\"dosinit\").value;document.head.appendChild(dosinitScript);var f=document.frm1;var f3=document.bfprotect;var bg=parent;var sysFlag2='269754496';var iHwAccSwitch='1';var Accept_Illegal_ARP=(1<<17);var Accept_Illegal_dst_ARP=(1<<18);var Block_Illegal_IP_from_WAN=(1<<19);var Block_Illegal_IP_from_LAN=(1<<20);var ENABLE_VRRP_ARP=(1<<17);var Dos_Defense_Log=(1<<23);var Spoofing_Defense_Log=(1<<24);var threshold_limit=20;var timeout_limit=5;var isclear=0;var dos;angular.element(document).ready(function(){dos=[[f.chxDos,bg.Enable_DoS_Defense,gettext(\"Enable DoS defense function to prevent the attacks from hacker or crackers.\")],[f.sltLog,Dos_Defense_Log,gettext(\"\")],[f.chxSynFld,bg.Enable_SYN_Flood,gettext(\"Defend SYN flood attack to make the server resource available for legitimate users.\")],[f.chxUdpFld,bg.Enable_UDP_Flood,gettext(\"Defend UDP flood attack to make the server resource available for legitimate users.\")],[f.chxIcmpFld,bg.Enable_ICMP_Flood,gettext(\"Defend ICMP flood attack to make the server resource available for legitimate users.\")],[f.chxPS,bg.Enable_PortScan,gettext(\"Detect PortScan attack to avoid the security hole exploring outside.\")],[f.chxBlkIp,bg.Block_IP_Option,gettext(\"Block IP packets with options to avoid the security hole exploring outside.(IPv4 only)\")],[f.chxBlkTcp,bg.Block_TCP_flag,gettext(\"Block TCP packets with irregular flags to avoid the security hole exploring outside.\")],[f.chxBlkLnd,bg.Block_Land,gettext(\"Defend Land attack to make the server alive.\")],[f.chxBlkTDrp,bg.Block_TearDrop,gettext(\"Defend Tear Drop attack to make the server alive.(IPv4 only)\")],[f.chxBlkSmf,bg.Block_Smurf,gettext(\"Defend Smurf attack to make the server alive.\")],[f.chxBlkPing,bg.Block_PingDeath,gettext(\"Block oversized and irregular packets sizes to prevent the system halt.\")],[f.chxBlkTR,bg.Block_TraceRT,gettext(\"Block trace route to avoid the security hole exploring outside.\")],[f.chxBlkIcmpFrag,bg.Block_ICMP_Frag,gettext(\"Block any ICMP frame with the More Fragments flag set.\")],[f.chxBlkSynFrag,bg.Block_SYN_Frag,gettext(\"Block any TCP SYN frame with the More Fragments flag set.\")],[f.chxBlkUnProt,bg.Block_Unassigned_NUM,gettext(\"Block any IP packets with unassigned or reserved protocol numbers.\")],[f.chxBlkFraggle,bg.Block_Fraggle,gettext(\"Block fraggle attack by blocking broadcast UDP packets.(IPv4 only)\")]];initPage();initParameter();});var aryInitValue=new Array();function initPage(){if(parent.sDefenseTag==\"tab3\"){dhtml.cycleTab(\"tab3\");parent.sDefenseTag=\"tab1\";}else{dhtml.cycleTab(\"tab1\");}}function initParameter(){$scope.adminauth=webcfg.adminauth;$scope.bEncKeyAlg=bEncKeyAlg;$scope.b_bfp=b_bfp;if(b_bfp){if(arrBfpSrv.length>0){var arrelmt=[f3.iBrEn,f3.iBrFtp,f3.iBrHttp,f3.iBrHttps,f3.iBrTelnet,f3.iBrTr069,f3.iBrSsh,f3.iBrVPN,f3.iLoginFailures,f3.iPenaltyPeriod];if(arrBfpSrv[0]==1){for(var i=0;i<arrBfpSrv.length;i++){bg.setVle2Elmt(arrelmt[i],arrBfpSrv[i],0);}}else{bg.setVle2Elmt(arrelmt[0],arrBfpSrv[0],0);for(var i=1;i<arrBfpSrv.length;i++){if(arrelmt[i].type==\"checkbox\"){arrelmt[i].checked=true;}else{arrelmt[i].value=arrBfpSrv[i];}}}$scope.brEnChecked=f3.iBrEn.checked;}}$scope.$apply();isclear=0;var aryVle=[];for(var i=0;i<dos.length;i++){aryVle[i]=[dos[i][0],((iDoS_Flag&dos[i][1])>0)?1:0,0];}aryInitValue=[iDoS_Flag,iDoS_SynTh,iDoS_SynTO,iDoS_UdpTh,iDoS_UdpTO,iDoS_IcmpTh,iDoS_IcmpTO,iDoS_PSTh];var tmp=[[f.txtSynFld,iDoS_SynTh,0],[f.txtSynTO,iDoS_SynTO,0],[f.txtUdpFld,iDoS_UdpTh,0],[f.txtUdpTO,iDoS_UdpTO,0],[f.txtIcmpFld,iDoS_IcmpTh,0],[f.txtIcmpTO,iDoS_IcmpTO,0],[f.txtPS,iDoS_PSTh,0]];aryVle=aryVle.concat(tmp);for(i=0;i<aryVle.length;i++){bg.setVle2Elmt(aryVle[i][0],aryVle[i][1],aryVle[i][2]);aryInitValue.push(aryVle[i][1]);}ctrlAllCpnt();if(iDoS_Flag&Spoofing_Defense_Log){bg.setVle2Elmt(document.arpdefense.sltLog,1,0);}else{bg.setVle2Elmt(document.arpdefense.sltLog,0,0);}if(iDoS_Flag&Accept_Illegal_ARP){document.arpdefense.BlockArp1.checked=false;}else{document.arpdefense.BlockArp1.checked=true;}if(iDoS_Flag&Accept_Illegal_dst_ARP){document.arpdefense.BlockArp2.checked=false;}else{document.arpdefense.BlockArp2.checked=true;}if(sysFlag2&ENABLE_VRRP_ARP){document.arpdefense.DeclineVRRP.checked=false;}else{document.arpdefense.DeclineVRRP.checked=true;}if(iDoS_Flag&Block_Illegal_IP_from_WAN){document.arpdefense.BlockIp1.checked=true;}else{document.arpdefense.BlockIp1.checked=false;}if(iDoS_Flag&Block_Illegal_IP_from_LAN){document.arpdefense.BlockIp2.checked=true;}else{document.arpdefense.BlockIp2.checked=false;}}function submitParameter(){var arySmtVle=new Array(); var arySmtNme=new Array(); var myUrl=\"/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=\"+bg.V2X00_FID_FIREWALL_DOS;var i=0,webchange=0;var iDosFlag;if(isclear!=1){iDosFlag='92798976';for(i=0;i<dos.length;i++){if(bg.getVleFromElmt(dos[i][0])==1)iDosFlag|=dos[i][1];else iDosFlag&=~dos[i][1];}}else{webchange=1;iDosFlag=iDoS_Flag;}arySmtVle=[iDosFlag,f.txtSynFld,f.txtSynTO,f.txtUdpFld,f.txtUdpTO,f.txtIcmpFld,f.txtIcmpTO,f.txtPS];if(arySmtVle[0]!=aryInitValue[0])webchange=1;for(i=1;i<arySmtVle.length;i++){arySmtVle[i]=bg.getVleFromElmt(arySmtVle[i]);if(arySmtVle[i]!=aryInitValue[i])webchange=1;var testStr=parseInt(arySmtVle[i])+''; if(testStr==\"NaN\"){alert(gettext('The parameter \"###NUM###\" is invalid ! It should be a number.').replace(\"###NUM###\",arySmtVle[i]));return false;}if((i%2)==0){if(parseInt(arySmtVle[i])<=timeout_limit){alert(gettext('The parameter \"###NUM###\" is invalid ! It should be larger than ###LEN###').replace(\"###NUM###\",arySmtVle[i]).replace(\"###LEN###\",timeout_limit));return false;}}else{if(parseInt(arySmtVle[i])<=threshold_limit){alert(gettext('The parameter \"###NUM###\" is invalid ! It should be larger than ###LEN###').replace(\"###NUM###\",arySmtVle[i]).replace(\"###LEN###\",threshold_limit));return false;}}}arySmtNme=[bg.HTML_DOS_FLAG,bg.HTML_DOS_SYN_FLD_TH,bg.HTML_DOS_SYN_TO,bg.HTML_DOS_UDP_FLD_TH,bg.HTML_DOS_UDP_TO,bg.HTML_DOS_ICMP_FLD_TH,bg.HTML_DOS_ICMP_TO,bg.HTML_DOS_PS_TH];if(arySmtVle.length!=arySmtNme.length){alert(\"submitParameter() => array length error!!\");return false;}for(i=0;i<arySmtVle.length;i++){myUrl+=\"&\"+bg.escapeUrl(arySmtNme[i])+\"=\"+bg.escapeUrl(arySmtVle[i]);}myUrl+=\"&webchange=\"+webchange;document.location.href=myUrl;}function clkbtnOk(){document.arpdefense.submit();}function clkbtnBFPOk(){if(b_bfp){var br_enable=bg.getVleFromElmt(f3.iBrEn,0);if(br_enable==\"1\"){if(!bg.isStrNum(f3.iLoginFailures.value)||f3.iLoginFailures.value<1||f3.iLoginFailures.value>255){alert(gettext('Maximum login failures must be between ###MIN### and ###MAX###!').replace(\"###MIN###\",1).replace(\"###MAX###\",255));f3.iLoginFailures.focus();return false;}if(!bg.isStrNum(f3.iPenaltyPeriod.value)||f3.iPenaltyPeriod.value<1||f3.iPenaltyPeriod.value>31536000){alert(gettext('Penalty period must be between ###MIN### and ###MAX###!').replace(\"###MIN###\",1).replace(\"###MAX###\",31536000));f3.iPenaltyPeriod.focus();return false;}}}f3.submit();}function ctrlAllCpnt(){bg.cpntCtrl(f.chxDos,f,f.chxSltAll,2); bg.cpntCtrl(f.chxDos,f,f.chxSynFld,22);if(bg.getVleFromElmt(f.chxDos)==1){bg.cpntCtrl(f.chxSltAll,f,f.chxSltAll,2); bg.cpntCtrl(f.chxSynFld,f,f.txtSynFld,2);bg.cpntCtrl(f.chxUdpFld,f,f.txtUdpFld,2);bg.cpntCtrl(f.chxIcmpFld,f,f.txtIcmpFld,2);bg.cpntCtrl(f.chxPS,f,f.txtPS,1);}}function onSltAll(){for(var i=1;i<dos.length;i++){bg.setVle2Elmt(dos[i][0],1,0);}}function getComment(obj){for(var i=0;i<dos.length;i++){if(dos[i][0]==obj){return dos[i][2];}}return-1;}function showComment(obj){var comm='';if((comm=getComment(obj))!=-1){f.txtComment.value=comm;}else{f.txtComment.value='';}}function clrAll(){var idosflag='92798976';iDoS_Flag=idosflag;for(i=0;i<dos.length;i++){iDoS_Flag&=~dos[i][1];}iDoS_SynTh=2000;iDoS_SynTO=10;iDoS_UdpTh=2000;iDoS_UdpTO=10;iDoS_IcmpTh=250;iDoS_IcmpTO=10;iDoS_PSTh=2000;initParameter();isclear=1;}function checkDoSEnable(){var DosSW=f.chxDos.checked;if(DosSW&&iHwAccSwitch==1){alert(gettext(\"Packets that have been accelerated by Hardware Acceleration will not be checked by the DoS Defense function.\"))}return true;}function handler(e){var elmt,type;if(bg.isNav){elmt=e.target;type=e.type;}if(bg.isIE||bg.isOpr){e=window.event;elmt=e.srcElement;type=e.type;}if(!elmt){return;}if(elmt.type==\"text\")e.cancelBubble=false;else e.cancelBubble=true;if(type==\"focus\"){if(elmt&&elmt.type==\"text\"){elmt.select();}else{return;}}switch(elmt.name){case'chxDos':case'chxSynFld':case'chxUdpFld':case'chxIcmpFld':case'chxPS':case'chxBlkIp':case'chxBlkTcp':case'chxBlkLnd':case'chxBlkTDrp':case'chxBlkSmf':case'chxBlkPing':case'chxBlkTR':case'chxBlkIcmpFrag':case'chxBlkSynFrag':case'chxBlkUnProt':case'chxBlkFraggle':showComment(elmt);ctrlAllCpnt();break;case'btnWBlist':document.location=\"/cgi-bin/cgiflood.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=0&flgV4=4&flgV6=4\";break;case'chxSltAll':onSltAll();ctrlAllCpnt();break;case\"btnCcl\":case\"btnARPCcl\":case\"btnBFPCcl\":document.location=\"/cgi-bin/V2X00.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=2005\";break;case\"btnClr\":if(confirm(gettext('Are you sure you want to clear?'))){clrAll();submitParameter();}break;case\"btnOk\":var txtVle=[[f.txtSynFld.value,gettext(\"SYN flood defense Threshold\")],[f.txtSynTO.value,gettext(\"SYN flood defense Timeout\")],[f.txtUdpFld.value,gettext(\"UDP flood defense Threshold\")],[f.txtUdpTO.value,gettext(\"UDP flood defense Timeout\")],[f.txtIcmpFld.value,gettext(\"ICMP flood defense Threshold\")],[f.txtIcmpTO.value,gettext(\"ICMP flood defense Timeout\")],[f.txtPS.value,gettext(\"Port Scan detection Threshold\")]];for(var i=0;i<txtVle.length;i++){if(txtVle[i][0]>65535){alert(txtVle[i][1]+\" \"+gettext(\"should be less than ###MAX###, please re-enter!\").replace(\"###MAX###\",65535));return false;}}if(!checkDoSEnable())break;submitParameter();break;case\"btnARPOk\":clkbtnOk();break;case\"btnBFPOk\":clkbtnBFPOk();break;}}function addhandlers(o){ switch(o.type){case\"checkbox\":case\"button\":o.onclick=handler;break;case\"select-one\":o.onchange=handler;break;}}addhandlers(window);addhandlers(document);for(var d=0;d<document.forms.length;d++){addhandlers(document.forms[d]);for(var e=0;e<document.forms[d].elements.length;e++){addhandlers(document.forms[d].elements[e]);}}</script></body></html>"
          },
          "redirectURL": "",
          "headersSize": 555,
          "bodySize": 5225,
          "_transferSize": 5780,
          "_error": null,
          "_fetchedViaServiceWorker": false
        },
        "serverIPAddress": "192.168.1.1",
        "startedDateTime": "2026-07-26T02:09:29.108Z",
        "time": 10.590000019874424,
        "timings": {
          "blocked": 0.9120000394880772,
          "dns": -1,
          "ssl": -1,
          "connect": -1,
          "send": 0.11099999999999999,
          "wait": 8.905000003658236,
          "receive": 0.6619999767281115,
          "_blocked_queueing": 0.5250000394880772,
          "_workerStart": -1,
