            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><script src=\"/cgi-bin/certificatedata.cgi?sFormAuthStr=pU2VHFY4WAi1NkA\"></script><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><style>\n.strict_length{\n\ttext-overflow: ellipsis;\n\twhite-space: nowrap;\n\toverflow: hidden;\n\tmax-width: 80px;\n}\n.status-ok,.status-ex30,.status-expired,.status-not {\n\tbackground: #25b997;\n\tdisplay: inline-block;\n\twidth: 11px;\n\theight: 11px;\n\tborder-radius: 11px;\n\tmargin-right: 8px;\n}\n.status-ex30 {\n\tbackground: #e7b309;\n}\n.status-expired {\n\tbackground: #d8253a;\n}\n.status-not {\n\tbackground: #aaaaaa;\n}\n.table-striped>tbody>tr>td {\n\twhite-space: nowrap;\n}\n</style></head><body class=ng-cloak style=\"font-family: verdana, Arial, Helvetica;font-size: 10pt; margin: 0px auto;\"><div style=\"width: 780px;margin: 3px auto;\"><b parent=\"{{ 'Certificate Management' | translate }}\" sub-title translate>Trusted CA Certificate</b><hr><form name=frm1><b translate>X509 Trusted CA Certificate Configuration</b><table cellPadding=2 cellSpacing=2 class=table-striped id=caCert><thead><tr><th align=center width=15%><nobr>&nbsp;<b translate>Name</b></nobr></th><th align=center width=40%><nobr>&nbsp;<b translate>Subject</b></nobr></th><th align=center width=15%><nobr>&nbsp;<b translate>Status</b></nobr></th><th align=center width=30%><nobr>&nbsp;<b translate>Modify</b></nobr></th></tr></thead><tbody></tbody><tbody data-new-cert=true><tr><td colspan=4><input name=X509Import onclick=X509import() type=button value=\"{{'IMPORT' | translate }}\"></td></tr></tbody></table><br><div data-new-cert=true><b translate>Storage for Certificate</b><div class=progress><span translate>Storage Usage</span>: <div class=progress-bar><div style=\"background-color: #4682B4;height: inherit;\"></div></div><span class=\"progress-text\">77%</span></div></div><br><b trans