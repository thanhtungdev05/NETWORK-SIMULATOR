rogress... It must NOT be interrupted!</td></tr><tr><td align=center><img src=/images/wait.gif></td></tr></table><input form=form5 name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form><form id=form6 name=cfgrestore style=display:none><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>Switch Configuration Restore</b></td></tr></table><table align=center border=0 cellPadding=2 cellSpacing=0 width=100%><tr><td align=center class=red translate>Configuration Restore is in progress... It must NOT be interrupted!</td></tr><tr><td align=center><img src=/images/wait.gif></td></tr></table><input form=form6 name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form><form id=form7 name=cfgbackup style=display:none><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><b translate>Switch Configuration Backup</b></td></tr></table><table align=center border=0 cellPadding=2 cellSpacing=0 width=100%><tr><td align=center class=red translate>Configuration Backup is in progress... It must NOT be interrupted!</td></tr><tr><td align=center><img src=/images/wait.gif></td></tr></table><input form=form7 name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"></form></td></tr></table><script> top.ACTION_STATUS=-1;top.iActionStatusFlag='1';top.iFwUpgradeState='0';top.act_sta.damage_alert();var appeinitScript=document.createElement('script');appeinitScript.text=document.getElementById(\"swmmaintinit\").value;document.head.appendChild(appeinitScript);var bg=parent;var f=document.frm1;var f2=document.frm2;var fup=document.frmup;var switchDevStatus='0'; var switchDevModelReboot=''; var switchDevModelReset=''; var sFwNameLeading=\"\";var aryTmpName=new Array();var timeonce=0;angular.element(document).ready(function(){init_Para();});function init_Para(){if(switchDevStatus==1){ alert(gettext('Backup fail!'));bg.showElmtByClass(document,\"table\",\"webshow\");}else if(switchDevStatus==2){ if(switchrebootOK.length!=0||switchrebootfail.length!=0){var msg1='';var msg2='';if(switchrebootOK.length!=0){ if(switchDevModelReboot==1){msg1=gettext('Note')+': '+gettext('The switch ###ID### will reboot, please kindly wait for around 60 seconds.\\nAnd try not to do anything else until the reboot finished.').replace(\"###ID###\",switchrebootOK[0]); bg.showElmtByClass(document,\"table\",\"reboottbl\");}else{msg1+=gettext('###ID### reboot OK!').replace(\"###ID###\",switchrebootOK[0]);bg.showElmtByClass(document,\"table\",\"webshow\");}} if(switchrebootfail.length!=0){ msg2+=gettext('###ID### reboot start fail!').replace(\"###ID###\",switchrebootfail[i]);}alert(msg1+\"\\n\"+msg2);if(switchrebootOK.length!=0&&switchDevModelReboot==1){setTimeout(\"onClkBtnCcl()\",60000);}else bg.showElmtByClass(document,\"table\",\"webshow\");}else bg.showElmtByClass(document,\"table\",\"webshow\");}else if(switchDevStatus==3){ if(switchresetOK.length!=0||switchresetfail.length!=0){var msg1='';var msg2='';if(switchresetOK.length!=0){ if(switchDevModelReset==1){msg1=gettext('Note')+': '+gettext('The switch ###ID### will factory reset, please kindly wait for around 60 seconds.\\nAnd try not to do anything else until the reboot finished.').replace(\"###ID###\",switchresetOK[0]); bg.showElmtByClass(document,\"table\",\"resettbl\");}else{msg1=gettext('###ID### factory reset OK!').replace(\"###ID###\",switchresetOK[0]);bg.showElmtByClass(document,\"table\",\"webshow\");}} if(switchresetfail.length!=0){ msg2+=gettext('###ID### factory reset start fail!').replace(\"###ID###\",switchresetfail[i]);}alert(msg1+\"\\n\"+msg2);if(switchresetOK.length!=0&&switchDevModelReset==1){setTimeout(\"onClkBtnCcl()\",60000);}else bg.showElmtByClass(document,\"table\",\"webshow\");}else bg.showElmtByClass(document,\"table\",\"webshow\");}else bg.showElmtByClass(document,\"table\",\"webshow\");bg.setVle2Elmt(f.sltActTyp,bg.isltActTyp,0);initSltDev();onChgSltActTyp();}function onChgSltActTyp(){var sltActTyp=bg.getVleFromElmt(f.sltActTyp,0);bg.isltActTyp=sltActTyp;if(sltActTyp==0){bg.cpntCtrl(false,fup,fup.data,1);bg.hideElmtByClass(document,\"tr\",\"cfg_restore\");bg.hideElmtByClass(document,\"tr\",\"fm_upgrade\");}else if(sltActTyp==1){bg.cpntCtrl(true,fup,fup.data,1);bg.showElmtByClass(document,\"tr\",\"cfg_restore\");bg.hideElmtByClass(document,\"tr\",\"fm_upgrade\");}else if(sltActTyp==2){bg.cpntCtrl(true,fup,fup.data,1);bg.hideElmtByClass(document,\"tr\",\"cfg_restore\");bg.showElmtByClass(document,\"tr\",\"fm_upgrade\");}else if(sltActTyp==3){bg.cpntCtrl(false,fup,fup.data,1);bg.hideElmtByClass(document,\"tr\",\"cfg_restore\");bg.hideElmtByClass(document,\"tr\",\"fm_upgrade\");}else if(sltActTyp==4){bg.cpntCtrl(false,fup,fup.data,1);bg.hideElmtByClass(document,\"tr\",\"cfg_restore\");bg.hideElmtByClass(document,\"tr\",\"fm_upgrade\");}}function initSltDev(){var i,op; for(i=0;i<switchDevName.length;i++){f2.Selected_Dev.options[i+1]=new Option(switchDevName[i][1],i,false,false);}}function selectdevice(){idx=f2.Selected_Dev.value;if(idx!=-1){document.getElementById(\"selectmac\").innerHTML=switchDevName[idx][3];document.getElementById(\"selectip\").innerHTML=switchDevName[idx][0];}else{document.getElementById(\"selectmac\").innerHTML='';document.getElementById(\"selectip\").innerHTML='';}}function loopBackup(idx){var myBUrl='/swmcfgbacktr.cgi?idx='+idx+\"&sFormAuthStr=JdvKVyYlhh7GhS9\"; $http.get(myBUrl).catch(function(response){timeonce++;if(timeonce<20){setTimeout(function(){loopBackup(idx)},2000);}else{alert(gettext(\"Timeout,backup fail!\"));document.location='/cgi-bin/cgiswm.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=17';}}).then(function(response){var str2=response.data;var ret=str2.match(\"BEGIN\"); var ret2=str2.match(\"<?xml\"); var ret3=str2.match(\"backup/startup-config\"); var ret1=str2.match(\"Error\"); if(ret1==null){if(ret!=null||ret2!=null||ret3!=null){ var now=new Date();var yy,mm,dd,date;yy=now.getFullYear().toString();mm=(now.getMonth()+1).toString();dd=now.getDate().toString();if(mm.length==1)mm=\"0\"+mm;if(dd.length==1)dd=\"0\"+dd;date=yy+mm+dd; var sel_idx=idx; document.location='/swmcfg_'+date+'.cfg?idx='+sel_idx+\"&sFormAuthStr=JdvKVyYlhh7GhS9\";cfgbackup.style.display=\"none\";bg.showElmtByClass(document,\"table\",\"webshow\");}else{var tmp=str2.split(\",\"); timeonce++;if(timeonce<20&&tmp[0]=='0'){setTimeout(function(){loopBackup(idx)},2000);}else{alert(gettext(\"Timeout,backup fail!\"));document.location='/cgi-bin/cgiswm.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=17';}}}else{alert(gettext(\"Backup fail!\"));document.location='/cgi-bin/cgiswm.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=17';}});}function onClkBackup(){ f2.Selected_Idx.value=f2.Selected_Dev.value;var sel_cfg_idx=switchDevName[f2.Selected_Idx.value][2];var myUrl='/swmcfgback.cgi?idx='+sel_cfg_idx+\"&sFormAuthStr=JdvKVyYlhh7GhS9\"; $http.get(myUrl).then(function(response){timeonce=0;var tmp=response.data.split(\",\");if(tmp[0]=='1'){cfgbackup.style.display=\"\";fwloading.style.display=\"none\";bg.hideElmtByClass(document,\"table\",\"webshow\");loopBackup(sel_cfg_idx);}else{alert(gettext(\"Backup fail!\"));document.location='/cgi-bin/cgiswm.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=17';}});}function CheckOpType(_idx){var tmp;var data=fup.data.value;if(data==\"\"){alert(gettext(\"File name is invalid, please check!\"));return false;}data=data.replace(/\\s+$/,\"\"); if((_idx==1)&&((data.search('running-config.cfg'))>-1||(data.search('config.xml')>-1))){if((data.search('running-config.cfg'))>-1){if(sFwNameLeading=='G2260'||sFwNameLeading=='P2261'){alert(gettext(\"File name is invalid, please check!\"));return false;}}else if((data.search('config.xml'))>-1){if(sFwNameLeading=='G1241'){alert(gettext(\"File name is invalid, please check!\"));return false;}}}else{if(_idx==1)tmp=\"\\\\w*\\\\.cfg$\";else if(_idx==2)tmp=sFwNameLeading+\"\\\\w*\\\\.all$\";reg=new RegExp(tmp,\"i\");result=data.search(reg);if(result<0){alert(gettext(\"File name is invalid, please check!\"));return false;}else if(_idx==1){reg=sFwNameLeading;result=data.search(reg);if(result<0){alert(gettext(\"File name is invalid, please check!\"));return false;}}}return true;}function onclkRestore(){var data=fup.data.value;if(data==\"\"){alert(gettext(\"File name is invalid, please check!\"));return false;}data=data.replace(/\\s+$/,\"\");var model=switchDevName[f2.Selected_Dev.value][4];if(model=='P1092'||model=='G1080'){alert(gettext(\"This Switch does not support Config Restore.\"));return false;}if(model=='P2280x'||model=='G2280x'||model=='P2282x'||model=='G2282x'){if((data.search('.swm.cfg'))==-1||data.search(model)==-1){alert(gettext(\"File name is invalid, please check!\"));return false;}}var args=0,devnum,url=\"\";if(!CheckOpType(1))return false;cfgrestore.style.display=\"\";fwloading.style.display=\"none\";bg.hideElmtByClass(document,\"table\",\"webshow\"); url=\"/upload_swm_cfg.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&num=1\"; var sel_cfg_idx=switchDevName[f2.Selected_Dev.value][2];url+=\"&v1=\"+sel_cfg_idx; fup.action=url;fup.submit();} function onclkRemoteReboot(){var args=0,devnum,url=\"\";if(confirm(gettext(\"Remote Reboot!\"))){ url=\"/cgi-bin/cgiswm.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=19&num=1\"; var sel_cfg_idx=switchDevName[f2.Selected_Dev.value][2];url+=\"&v1=\"+sel_cfg_idx; if(1){ fwloading.style.display=\"none\";bg.hideElmtByClass(document,\"table\",\"webshow\");bg.showElmtByClass(document,\"table\",\"reboottbl\");url+=\"&switchDevModelReboot=1\";}document.location=url;}}function onclkFactoryReset(){var args=0,devnum,url=\"\";if(confirm(gettext(\"Factory Reset!\"))){ url=\"/cgi-bin/cgiswm.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=20&num=1\"; var sel_cfg_idx=switchDevName[f2.Selected_Dev.value][2];url+=\"&v1=\"+sel_cfg_idx; if(switchDevName[f2.Selected_Dev.value][4]=='G1280'||switchDevName[f2.Selected_Dev.value][4]=='P2280'||switchDevName[f2.Selected_Dev.value][4]=='P1280'||switchDevName[f2.Selected_Dev.value][4]=='G2280'){fwloading.style.display=\"none\";bg.hideElmtByClass(document,\"table\",\"webshow\");bg.showElmtByClass(document,\"table\",\"resettbl\");url+=\"&switchDevModelReset=1\";}document.location=url;}}function move(srcBox,destBox,type){var sltActTyp=bg.getVleFromElmt(f.sltActTyp,0);var flag=0;var aryExistModel=new Array();var i=srcBox.selectedIndex,k=0;if((sltActTyp==0||sltActTyp==1)&&destBox.options.length>=2&&type==1){alert(gettext(\"The maximum number of selected device is ###MAX###.\").replace(\"###MAX###\",1));return;}if(type==1){for(var j=1;j<srcBox.options.length;j++){if(srcBox.options[j].selected)aryExistModel[k++]=switchDevName[srcBox.options[j].value][4];}for(var j=1;j<aryExistModel.length;j++){if(aryExistModel[j]!=aryExistModel[0])flag=1;}for(var j=1;j<destBox.options.length;j++){if(aryExistModel[0]!=switchDevName[destBox.options[j].value][4])flag=1;}}while(i>=1){if(srcBox.options[i].value!=\"\"){var no=new Option(srcBox.options[i].text,srcBox.options[i].value,false,false);destBox.options[destBox.options.length]=no;srcBox.options[i]=null;}i=srcBox.selectedIndex;}}function alertMsg(_type){if(_type==1) alert(gettext(\"Config Restore should be applied to devices of the same type.\"));else if(_type==2) alert(gettext(\"Firmware Upgrade should be applied to devices of the same type.\"));}function dblClick(srcBox,destBox,type){if(srcBox.selectedIndex!=0){var sltActTyp=bg.getVleFromElmt(f.sltActTyp,0);if((sltActTyp==0||sltActTyp==1)&&type==1&&(f2.Selected_Dev.options.length==2)){alert(gettext(\"The maximum number of selected device is ###MAX###.\").replace(\"###MAX###\",1));return false;}var no=new Option(srcBox.options[srcBox.selectedIndex].text,srcBox.options[srcBox.selectedIndex].value,false,false);destBox.options[destBox.options.length]=no;srcBox.options[srcBox.selectedIndex]=null;}}function onClkBtnOk(){var txttmp,flag=0,Selected_Dev;bg.sltActTyp=bg.getVleFromElmt(f.sltActTyp,0);if(f2.Selected_Dev.value==-1){alert(gettext(\"There is no device to apply to.\"));return false;} if(bg.sltActTyp==0){ onClkBackup();}else if(bg.sltActTyp==1){ onclkRestore();}else if(bg.sltActTyp==2){}else if(bg.sltActTyp==3){ onclkRemoteReboot();}else if(bg.sltActTyp==4){ onclkFactoryReset();}}function onClkBtnCcl(){document.location='/cgi-bin/cgiswm.cgi?sFormAuthStr=JdvKVyYlhh7GhS9&fid=17';}</script></body></html>"
