            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><script src=\"/cgi-bin/websyslog.cgi?sFormAuthStr=JdvKVyYlhh7GhS9\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script></head><body class=ng-cloak onload=overload()><table align=center border=0 cellpadding=0 cellspacing=0 width=700><tr><td><b parent=\"{{ 'Diagnostics' | translate }}\" sub-title translate>Syslog Explorer</b><hr><table align=center border=0 cellpadding=2 cellspacing=0 width=700><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td class=ontab id=tab1 onClick=onChgAccMod(1) width=35%><b translate>Web Syslog</b></td><td class=offtab id=tab2 onClick=onChgAccMod(2) width=35%><b translate>USB Syslog</b></td><td class=tabpadding></td></tr></table><div id=page1><form action method=post name=frm1><table align=center border=1 cellpadding=0 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td colspan=2><input  name=sWebSyslogEnable onclick=onWebSyslogSet() type=checkbox> &nbsp;<b translate>Enable Web Syslog</b></td><td align=right class=red><span id=expo></span> |&nbsp; <a href=\"javascript: onRefresh()\" translate>Refresh</a>&nbsp; |&nbsp; <a href=\"javascript: onClear()\" translate>Clear</a>&nbsp;|</td></tr><tr align=right><td colspan=3><translate>Syslog Type</translate>&nbsp;<select id=sWebLogType name=sWebLogType onChange=onWebSyslogSet()><option translate value=150>User</option><option translate value=134>Firewall</option><option translate value=158>Call</option><option translate value=166>WAN</option><option translate value=198>WLAN</option><option translate value=141>VPN</option><option translate value=999>All</option></select>&nbsp;&nbsp; <translate>Display Mode</translate>&nbsp;<select name=sMode onChange=onWebSyslo