            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/tool.min.js?094907\"></script><script src=\"/js/dhtml.min.js?094907\"></script><script src=\"/js/webchange.js?094907\"></script><style type=text/css>\n.edline\n{\n  background-color: transparent;\n  border-bottom: #a0a0a0 1px solid;\n  border-left: medium none;\n  border-right: medium none;\n  border-top: medium none;\n  text-align: center;\n}\n</style></head><textarea id=panelctrlinit style=display:none>\nconst aryInfo = [1,0,1,0,0,1,1,[[1,0],[1,0]],[[1,0,10],[1,0,10],[1,1,1000],[1,0,10],[1,0,10]]];\nconst iusbonoff\t= 1;\nconst dislanport = '1';\nconst iledonoff = 1;\nconst iledsleepmd = 1;\nconst iledmaxsleep = 10080;\n</textarea><body class=ng-cloak><form action=/cgi-bin/panelctl.cgi method=post name=frm1><table align=center border=0 cellpadding=0 cellspacing=0 width=700><script> var panelctrlinitscript=document.createElement(\"script\");panelctrlinitscript.text=document.getElementById(\"panelctrlinit\").value;document.head.appendChild(panelctrlinitscript);</script><tr><td><b parent=\"{{ 'System Maintenance' | translate }}\" sub-title translate>Panel Control</b><hr><table align=center border=0 cellpadding=2 cellspacing=0 width=700><tr><th class=offtab id=tab1 onClick=dhtml.cycleTab(this.id);parent.sPanelCtrlTag=this.id; translate width=15%>LED</th><th class=offtab id=tab2 ng-if=adminauth onClick=dhtml.cycleTab(this.id);parent.sPanelCtrlTag=this.id; translate width=15%>Button</th><th class=offtab id=tab3 ng-if=adminauth onClick=dhtml.cycleTab(this.id);parent.sPanelCtrlTag=this.id; translate width=15%>USB</th><th class=offtab id=tab4 ng-if=adminauth onClick=dhtml.cycleTab(this.id);parent.sPanelCtrlTag=this.id; translate width=15%>LAN Port</th><th align=right class=red>|&nbsp;&nbsp; <a href=\"javascript: onRefresh()\" translate>Refresh</a>&nbsp;&nbsp;|</th></tr></table><div id=page1 style=display:none><table align=center border=1 cellpadding=12 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=95%><tr><td width=10px><input name=iLEDEn onclick=clkLEDEnable() type=checkbox value=1></td><td translate>Enable LED</td></tr><tr class=sleepinfo><td>&nbsp;</td><td><table align=center border=0 cellpadding=2 cellspacing=0 width=95%><tr><td width=10px><input name=iSleepModeEn onclick=clkSleepMode() type=checkbox value=1></td><td translate>Enable Sleep Mode</td></tr><tr><td></td><td><translate id=\"link_turnoff\">Turn off LED after <input> minutes</translate>&nbsp;(<translate>Default</translate>: 1 <translate>minute</translate>)</td></tr><tr id=ledstatus1 style=display:none><td></td><td><b translate>Status</b>&nbsp;:<font color=#75A8F1 translate>Sleep</font>&nbsp;<input name=btnWakeupLED onclick=onWakeupLED() type=button value=\"{{ 'Wake up LED' | translate}}\"></td></tr><tr id=ledstatus2 style=display:none><td></td><td><b><translate>Status</translate> :&nbsp;</b><font color=#75A8F1 translate>Awake, sleep after</font><span id=sleepaftmin>&nbsp;<font color=red>5</font>&nbsp;</span><font color=#75A8F1><translate>minutes</translate>&nbsp;</font><input name=btnSleepNow onclick=onSleepNow() type=button value=\"{{ 'LED sleep immediately' | translate}}\"></td></tr></table></td></tr></table></td></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 class=sleepnote width=100%><tr><td><b translate>Note</b>: <ol><li ng-show=\"bDualWless5G || bWless\" translate>Enable the Sleep Mode will make the functions of \"Wireless Button\" and \"Factory Reset Button\" on the front panel as below</li><li ng-show=\"!bDualWless5G || !bWless\" translate>Enable the Sleep Mode will make the functions of \"Factory Reset Button\" on the front panel as below</li></ol></td></tr><tr><td><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr align=center><td translate width=25%>LED Status</td><td translate width=50%>LED On</td><td translate>LED Off</td></tr><script>if(parseInt('0')||parseInt('0')){document.write(\"<tr align=center><td>\"+gettext(\"Wireless Button\")+\"</td><td>\"+gettext(\"Wireless\")+\" \"+gettext(\"On\")+\"/\"+gettext(\"Off\")+\"/\"+gettext(\"WPS\")+\"</td><td rowspan=2>\"+gettext(\"Turn LED On\")+\"*</td></tr>\");}</script><tr align=center><td translate>Factory Reset Button</td><td><translate>Press 1 second: Turn LED off immediately*</translate><br><translate>Press till the ACT light flashing: Reset router</translate></td><script>if(!parseInt('0')&&!parseInt('0')){document.write('<td>'+gettext(\"Turn LED On\")+'*</td>');}</script></tr></table></td></tr><tr><td>*<translate>Still functional even the buttons are disabled.</translate></td></tr></table></div><div id=page2 style=display:none><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=60%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><br></td></tr><tr><td><table align=center border=1 cellpadding=2 cellspacing=0 width=80%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 width=100%><tr><th translate width=35%>Enable</th><th translate width=65%>Button</th></tr><tr class=row0 id=wirbtn style=display:none><td align=center><input name=iWireless onclick=onclkWireless() type=checkbox value=1></td><td align=center translate>Wireless</td></tr><tr class=row1 id=resetbtn><td align=center><input name=iDefault onclick=onclkDefault() type=checkbox value=1></td><td align=center translate>Factory Reset</td></tr></table></td></tr></table></td></tr><tr><td><br></td></tr></table></td></tr></table></td></tr></table><table align=center border=0 cellpadding=2 cellspacing=0 class=sleepnote width=100%><tr><td><b translate>Note</b>: <ol><li ng-show=\"bDualWless5G || bWless\" translate>Enable the Sleep Mode will make the functions of \"Wireless Button\" and \"Factory Reset Button\" on the front panel as below</li><li ng-show=\"!bDualWless5G || !bWless\" translate>Enable the Sleep Mode will make the functions of \"Factory Reset Button\" on the front panel as below</li></ol></td></tr><tr><td><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr align=center><td translate width=25%>LED Status</td><td translate width=50%>LED On</td><td translate>LED Off</td></tr><script>if(parseInt('0')||parseInt('0')){document.write(\"<tr align=center><td>\"+gettext(\"Wireless Button\")+\"</td><td>\"+gettext(\"Wireless\")+\" \"+gettext(\"On\")+\"/\"+gettext(\"Off\")+\"/\"+gettext(\"WPS\")+\"</td><td rowspan=2>\"+gettext(\"Turn LED On\")+\"*</td></tr>\");}</script><tr align=center><td translate>Factory Reset Button</td><td><translate>Press 1 second: Turn LED off immediately*</translate><br><translate>Press till the ACT light flashing: Reset router</translate></td><script>if(!parseInt('0')&&!parseInt('0')){document.write('<td>'+gettext(\"Turn LED On\")+'*</td>');}</script></tr></table></td></tr><tr><td>*<translate>Still functional even the buttons are disabled.</translate></td></tr></table></div><div id=page3 style=display:none><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 id=usbtbl width=80%><tr><td><table border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><br></td></tr><tr><td><table align=center border=1 cellpadding=2 cellspacing=0 width=80%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 width=100%><tr><th class=usbport translate width=16%>Port</th><th id=usbenable translate width=16%>Enable</th><th id=usbstatus translate>Status</th></tr><tr class=\"row{{ $index % 2 }}\" ng-repeat=\"i in aryInfo[7] track by $index\"><td align=center>{{ $index + 1 }}</td><td align=center><input name=\"iUSBEn{{ $index }}\" ng-click=onclkUSBEn($index) type=checkbox value=1></td><td align=center id=\"usbptsta{{ $index }}\"></td></tr></table></td></tr></table></td></tr><tr><td><br></td></tr></table></td></tr></table></td></tr></table></div><div id=page4 style=display:none><table align=center border=1 cellpadding=2 cellspacing=0 width=100%><tr><td><table align=center border=0 cellpadding=2 cellspacing=0 width=80%><tr><td><table border=0 cellpadding=2 cellspacing=0 width=100%><tr><td><br></td></tr><tr><td><table align=center border=1 cellpadding=2 cellspacing=0 width=80%><tr><td><table align=center border=0 cellpadding=2 cellspacing=2 width=100%><tr><th translate width=16%>Port</th><th translate width=16%>Enable</th><th translate width=34%>Status</th><th translate width=34%>Speed</th></tr><script>var str=\"\";var num=0;if(aryInfo[8].length>0){for(var i=0;i<aryInfo[8].length;i++){if(i!=3||'0'==0){num=i+1;str+='<tr class=row'+i%2+'><td align=center width=16%>'+num+'</td>';str+='<td width=16% align=center><input type=checkbox name=iLANPortEn'+i+' value=1 onclick=onclkLANPortEn('+i+')></td>';str+='<td width=34% align=center id=lanstatus'+i+'></td>';str+='<td width=34% align=center id=lanspeed'+i+'></td></tr>';}}}document.write(str);</script></table></td></tr></table></td></tr><tr><td><br></td></tr></table></td></tr></table></td></tr></table></div><input name=webchange type=hidden value=0><input name=iAct type=hidden value=1><input name=sFormAuthStr type=hidden value=\"JdvKVyYlhh7GhS9\"><br><table align=center border=0><tr><td><input class=btnw name=btnOk onclick=onClkBtnOK() type=button value=\"{{ 'OK' | translate }}\"></td></tr></table></td></tr></table></form><script>var bg=parent;var f=document.frm1;var refresh;angular.element(document).ready(function(){initPage();initParameter();initWebChange();});function initPage(){$scope.aryInfo=aryInfo;$scope.onclkUSBEn=onclkUSBEn;$scope.adminauth=webcfg.adminauth;$scope.bDualWless5G=parseInt('0');$scope.bWless=parseInt('0');$scope.$apply();if(parent.sPanelCtrlTag==\"tab4\"&&dislanport=='1'){dhtml.cycleTab(\"tab4\");}else if(parent.sPanelCtrlTag==\"tab3\"&&iusbonoff=='1'){dhtml.cycleTab(\"tab3\");}else if(parent.sPanelCtrlTag==\"tab2\"){dhtml.cycleTab(\"tab2\");}else{if(iledonoff=='1')dhtml.cycleTab(\"tab1\");else dhtml.cycleTab(\"tab2\");}if(iledonoff!='1'){document.getElementById(\"tab1\").style.display=\"none\";}if(iusbonoff!='1'){document.getElementById(\"tab3\").style.display=\"none\";}if(dislanport!='1'){document.getElementById(\"tab4\").style.display=\"none\";}if(parseInt('0')||parseInt('0')){document.getElementById(\"wirbtn\").style.display=\"\";}else{document.getElementById(\"resetbtn\").setAttribute(\"class\",\"row0\");} if(iledsleepmd!='1'){bg.hideElmtByClass(document,\"table\",\"sleepnote\");bg.hideElmtByClass(document,\"tr\",\"sleepinfo\");}angular.element(document.querySelector(\"#link_turnoff input\")).attr({type:\"number\",class:\"edline\",name:\"sTurnoffMin\",min:1,max:\"10080\",size:3});}function initParameter(){bg.setVle2Elmt(f.iLEDEn,aryInfo[0]);bg.setVle2Elmt(f.iSleepModeEn,aryInfo[1]);bg.setVle2Elmt(f.sTurnoffMin,aryInfo[2]);bg.setVle2Elmt(f.iDefault,aryInfo[5]);bg.setVle2Elmt(f.iWireless,aryInfo[6]);if(aryInfo[7].length>0){for(var i=0;i<aryInfo[7].length;i++){if(aryInfo[7][i][0]==1){f[\"iUSBEn\"+i].checked=true;if(aryInfo[7][i][1]==1)document.getElementById(\"usbptsta\"+i).innerHTML=gettext(\"Connected\");else document.getElementById(\"usbptsta\"+i).innerHTML=gettext(\"No Device\");}else{f[\"iUSBEn\"+i].checked=false;document.getElementById(\"usbptsta\"+i).innerHTML=\"---\";}}}if(aryInfo[8].length>0){for(var i=0;i<aryInfo[8].length;i++){if(i!=3||'0'==0){if(aryInfo[8][i][0]==1){f[\"iLANPortEn\"+i].checked=true;if(aryInfo[8][i][1]==1){document.getElementById(\"lanstatus\"+i).innerHTML=gettext(\"Link Up\");document.getElementById(\"lanspeed\"+i).innerHTML=aryInfo[8][i][2]+gettext(\"Mbps\");}else{document.getElementById(\"lanstatus\"+i).innerHTML=gettext(\"Link Down\");document.getElementById(\"lanspeed\"+i).innerHTML=\"---\";}}else{f[\"iLANPortEn\"+i].checked=false;document.getElementById(\"lanstatus\"+i).innerHTML=\"---\";document.getElementById(\"lanspeed\"+i).innerHTML=\"---\";}}}}clkLEDEnable();if(iledsleepmd=='1'){clkSleepMode();}if(iledsleepmd=='1'&&aryInfo[4]>0){refresh=setTimeout(\"RemainMinsRefresh()\",5000);}}function onWakeupLED(){f.iAct.value=2;f.submit();}function onSleepNow(){f.iAct.value=3;f.submit();}function onclkDefault(){if(f.iDefault.checked==false){if(!confirm(gettext(\"You are going to disable the \\\"Factory Reset button\\\".\\n\\\"Factory Reset button\\\" won't be functional. Continue?\"))){f.iDefault.checked=true;}}}function onclkWireless(){if(f.iWireless.checked==false){if(!confirm(gettext(\"You are going to disable the \\\"Wireless button\\\".\\n\\\"Wireless button\\\" won't be functional. Continue?\"))){f.iWireless.checked=true;}}}function onclkUSBEn(_idx){var idx=_idx+1;var elmtName,elmtIdx;elmtName=\"iUSBEn\"+_idx;elmtIdx=bg.getIdxbyName(f,elmtName);if(f[elmtIdx].checked==false){if(aryInfo[7].length==1){if(!confirm(gettext(\"You are going to disable the \\\"USB\\\".\\n\\\"USB port\\\" won't be functional. Continue?\"))){f[elmtIdx].checked=true;}}else{if(!confirm(gettext(\"You are going to disable the \\\"USB port ###ID###\\\".\\n\\\"USB port ###ID###\\\" won't be functional. Continue?\").replace(/###ID###/g,idx))){f[elmtIdx].checked=true;}}}}function onclkLANPortEn(_idx){var idx=_idx+1;var elmtName,elmtIdx;elmtName=\"iLANPortEn\"+_idx;elmtIdx=bg.getIdxbyName(f,elmtName);if(f[elmtIdx].checked==false){if(!confirm(gettext(\"You are going to disable the \\\"LAN port ###ID###\\\".\\n\\\"LAN port ###ID###\\\" will be turned off. Continue?\").replace(/###ID###/g,idx))){f[elmtIdx].checked=true;}}}function RemainMinsRefresh(){$http.get(\"/ledwakeup.cgi?3&sFormAuthStr=JdvKVyYlhh7GhS9&random=\"+Math.random()).then(function(str){var val=str.data.split(\",\");document.getElementById(\"sleepaftmin\").innerHTML=\"&nbsp;<font color=red>\"+val[1]+\"</font>&nbsp;\";ledstatusInit(parseInt(val[0]));if(parseInt(val[1])>0){refresh=setTimeout(\"RemainMinsRefresh()\",10000);}else{clearTimeout(refresh);}});}function ledstatusInit(_val){var val=_val;if(val==1){document.getElementById(\"ledstatus2\").style.display=\"none\";document.getElementById(\"ledstatus1\").style.display=\"\";}else if(val==2){document.getElementById(\"ledstatus1\").style.display=\"none\";document.getElementById(\"ledstatus2\").style.display=\"\";}}function lanPortCheck(){var lanchk=0;for(var i=0;i<aryInfo[8].length;i++){if(i!=3||'0'==0){if(f[\"iLANPortEn\"+i].checked==true){lanchk=1;break;}}}if(lanchk==0){if(parseInt('0')){alert(gettext('Error, at least 1 lan port must be enabled.'));return false;}else{if(!confirm(gettext('You are going to disable \"all lan port\", \"all lan port\" will be turned off. Continue ?')))return false;}}return true;}function onClkBtnOK(){if(dislanport=='1'&&!lanPortCheck()){return false;}iTmp=f.sTurnoffMin.value;if(iledsleepmd=='1'&&f.iLEDEn.checked){if(iTmp==\"\"||isNaN(iTmp)||iTmp<=0||iTmp>iledmaxsleep){alert(gettext(\"LED sleep time should be between ###MIN### and ###MAX###!\").replace(\"###MIN###\",1).replace(\"###MAX###\",iledmaxsleep));return false;}}if(checkWebChange()){f.webchange.value='1';}f.submit();}function clkLEDEnable(){var iTmp=bg.getVleFromElmt(f.iLEDEn,0);if(iledsleepmd=='1'&&iTmp==1){bg.cpntCtrl(true,f,f.iSleepModeEn,4);}else{bg.cpntCtrl(false,f,f.iSleepModeEn,4);}}function clkSleepMode(){var iTmp=bg.getVleFromElmt(f.iSleepModeEn,0);if(iTmp==1){if(aryInfo[3]==1){document.getElementById(\"ledstatus1\").style.display=\"\";}else if(aryInfo[3]==2){document.getElementById(\"sleepaftmin\").innerHTML=\"&nbsp;<font color=red>\"+aryInfo[4]+\"</font>&nbsp;\";document.getElementById(\"ledstatus2\").style.display=\"\";}}else{document.getElementById(\"ledstatus1\").style.display=\"none\";document.getElementById(\"ledstatus2\").style.display=\"none\";}}function onRefresh(){document.location=\"/cgi-bin/panelctl.cgi?sFormAuthStr=JdvKVyYlhh7GhS9\";}</script></body></html>"
          },
