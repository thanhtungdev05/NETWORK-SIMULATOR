&&(aryIpBindMac[i][0]==ip1)){alert(gettext(\"Already have the same IP Address!\"));return false;}if((i!=idx)&&(aryIpBindMac[i][1]==mac1)){for(var k=0;k<aryLanAlsEn.length;k++){if(aryLanAlsEn[k]==1&&bg.isEqualLan(aryIpBindMac[i][0],aryLanAlsMsk[k],ip1)){alert(gettext(\"Already have the same MAC Address!\"));return false;}}}}var HostID=aryIpBindMac[idx][2];aryIpBindMac[idx]=([ip1,mac1,HostID,cmt]);f.sltIpMac.selectedIndex=-1;addToIpMacList(idx);clrTempInput();}function isSubnetOrBroadcastIp(lan_ip,lan_mask,addr){var aryIp=lan_ip.split(\".\");var aryMask=lan_mask.split(\".\");var aryAddr=addr.split(\".\");var subnet_ip_same,broadcast_ip_same;if((aryIp.length!=4)||(aryMask.length!=4)||(aryAddr.length!=4))return false;subnet_ip_same=0;broadcast_ip_same=0;for(var i=0;i<4;i++){if(aryAddr[i]==(aryIp[i]&aryMask[i]))subnet_ip_same++;if(aryAddr[i]==((aryIp[i]&aryMask[i])|(~aryMask[i]&255)))broadcast_ip_same++;}if((subnet_ip_same==4)||(broadcast_ip_same==4))return true;return false;}function checkInput(ip1,mac1){if(!bg.isStrIp(ip1)){alert(errMSG[0]);return false;}for(var k=0;k<aryLanAlsEn.length;k++){if(aryLanAlsEn[k]==1&&bg.isEqualLan(aryLanAlsIp[k],aryLanAlsMsk[k],ip1))break;}if(k==aryLanAlsEn.length){alert(errMSG[1]);return false;}if(ip1==aryLanAlsIp[k]){alert(errMSG[2]);return false;}if(isSubnetOrBroadcastIp(aryLanAlsIp[k],aryLanAlsMsk[k],ip1)){alert(errMSG[3]);return false;}if(mac1==''){alert(errMSG[4]);return false;}if(!bg.isValidMac(mac1))return false;return true;}function checkInput1(idx,ip1,mac1,hostid1){var flag=1;for(i=0;i<aryIpBindMac.length;i++){ip2=aryIpBindMac[i][0];mac2=aryIpBindMac[i][1];if((ip1==ip2)&&(mac1==mac2)){flag=0;}if((ip1==ip2)&&(mac1!=mac2)){flag=0;f.sltIpMac.options[i+1].selected=true;if(confirm(gettext(\"Already have the same IP Address! Do you want to Update?\"))){aryIpBindMac[i][1]=mac1; addToIpMacList(i);}f.sltIpMac.selectedIndex=-1;}else if((ip1!=ip2)&&(mac1==mac2)){for(var k=0;k<aryLanAlsEn.length;k++){ if(aryLanAlsEn[k]==1&&bg.isEqualLan(ip1,