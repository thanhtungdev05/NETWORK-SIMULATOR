ontrol</b></td></tr><tr ng-hide=bgt2ndAdmin><td colspan=3><input  name=sRMC onClick=onCheckRMC() type=checkbox value=On><translate>Allow management from the Internet</translate></td></tr><tr ng-show=\"'1' == '1'\"><td colspan=2 style=padding-left:5px><b translate>Apply to Interface</b></td><tr><td style=padding-left:5px><div class=multiselect ng-show=\"'1' == '1'\" onblur=showCheckboxes(event) onclick=showCheckboxes(event) tabindex=0><div class=selectBox><select><option translate>Selected Interfaces</option></select><div class=overSelect></div></div><div id=checkboxes><label ng-repeat=\"accwan in accwans\"><input name={{accwan.name}} ng-checked=accwan.checked type=checkbox value=On>&nbsp;{{accwan.wan}} </label></div></div></td></tr></tr><tr ng-hide=\"bgt2ndAdmin || bRuVPN\"><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=sRMCFtp type=checkbox value=On><translate>FTP Server</translate></td></tr><tr ng-hide=bgt2ndAdmin><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=sRMCHttp type=checkbox value=On><translate>HTTP Server</translate>&nbsp;<input name=iRMCHsfrc onclick=cklRMCHttp() type=checkbox value=1><translate>Enforce HTTPS Access</translate></td></tr><tr class=https style=display:none><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input  checked name=sRMCHttps onclick=cklRMCHttps() type=checkbox value=On><translate>HTTPS Server</translate>&nbsp;<span ng-if=\"iBudgetThuis\">(<translate>Access List from the internet is required</translate>)</span></td></tr><tr ng-hide=bgt2ndAdmin><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=sRMCTelnet type=checkbox value=On><translate>Telnet Server</translate></td></tr><tr class=tr069 style=display:none><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=sRMCTr069 type=checkbox value=On><translate>TR069 Server</translate></td></tr><tr ng-hide=bgt2ndAdmin><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=sRMCSsh type=checkbox value=On><translate>SSH Server</translate></td></tr><tr class=Checksnmp style=display:none><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input  name=sRMCSnmp type=checkbox value=On><translate>SNMP Server</translate></td></tr><tr><td colspan=3><input  checked name=sWPing type=checkbox value=On><translate>Disable PING from the Internet</translate></td></tr><tr class=sExtDevDis style=display:none><td colspan=3><input  name=sExtDevDis type=checkbox value=On><translate>External Device Auto Discovery</translate></td></tr><tbody ng-show=\"'1' == '1'\"><tr><td><hr size=1></td></tr><tr><td><b translate>Loopback Interface</b></td></tr><tr><td><span ng-click=\"enablelpbkitfc = !enablelpbkitfc\" style=\"cursor: default\"><input name=eablpbkitfc ng-checked=enablelpbkitfc type=checkbox value=On><translate>Enable Loopback Interface</translate></span>&emsp; <select name=bkitfcslct ng-disabled=!enablelpbkitfc><option ng-repeat=\"suplan in suplans\" ng-selected=suplan.selected ng-value=suplan.value>{{suplan.text}}</option></select></td></tr><tr><td><b translate>Note</b>: <ol><li translate>Management from WAN only available using Loopback IP, the WAN IP will not respond.</li><li translate>Source IP used for TR069,NTP,RADIUS/TACACS+,SYSLOG,SNMP.</li></ol></td></tr></tbody></table><table border=0 cellpadding=2 cellspacing=0 class=mngtfrmlan style=display:none width=100%><tr><td colspan=3><hr size=1></td></tr><tr><td colspan=3><b translate>LAN Access Control</b></td></tr><tr><td colspan=3><input name=sMngtfrmLanEn onClick=onclkfrmlan() type=checkbox value=1><translate>Allow management from LAN</translate></td></tr><tr><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input name=iMngtlanftp type=checkbox value=1><translate>FTP Server</translate></td></tr><tr><td colspan=3>&nbsp;&nbsp;&nbsp;&nbsp;<input name=iMngtlanHttp type=checkbox value=1><translate>HTTP Server</translate>&nbsp;<input name=iMngtHsfrc onclick=cklMngtHttp() type=checkbox value=1><translate>Enforce HTTPS Access</translate></td></tr><tr><td class=https colspan=3 style=display:none>&nbsp;&nbsp;&nbsp;&nbsp;<input name=iMngtlanHttps onclick=cklMngt