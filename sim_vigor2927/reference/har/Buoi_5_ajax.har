            "text": "<!DOCTYPE html><html ng-app=myApp ng-controller=TranslateCtrl><head><script src=\"/js/gettext.min.js?094907\"></script><meta / charset=UTF-8><link href=\"/style.min.css?094907\" rel=stylesheet type=text/css><script src=\"/js/webchange.js?094907\"></script></head><style>\n#cloudvpnlist td {text-align:center;}\ntable.config {\n\tborder: 1px solid #000;\n\t/*border-collapse: collapse;*/\n}\n#vpninfo{width:560px;height:200px;position:absolute;left:250px;top:90px;margin:0;z-index:2;padding:20px;\nbackground-color:rgba(0,0,0,0.7);}\n#cfmtbl td, #cfmtbl a{color:#ffffff};\n</style><body class=ng-cloak><textarea id=cloudvpn1init style=display:none>\nconst aryServer = [\"\",0,\"\",\"\",\"1449bc884338\",0,0];\nconst aryVPNProf = [[\"???\",\"0.0.0.0\",\"255.255.255.0\",24,0,\"\"],[\"???\",\"0.0.0.0\",\"255.255.255.0\",24,0,\"\"],[\"???\",\"0.0.0.0\",\"255.255.255.0\",24,0,\"\"],[\"???\",\"0.0.0.0\",\"255.255.255.0\",24,0,\"\"],[\"???\",\"0.0.0.0\",\"255.255.255.0\",24,0,\"\"],[\"???\",\"0.0.0.0\",\"255.255.255.0\",24,0,\"\"],[\"???\",\"0.0.0.0\",\"255.255.255.0\",24,0,\"\"],[\"???\",\"0.0.0.0\",\"255.255.255.0\",24,0,\"\"],[\"???\",\"0.0.0.0\",\"255.255.255.0\",24,0,\"\"],[\"???\",\"0.0.0.0\",\"255.255.255.0\",24,0,\"\"],[\"???\",\"0.0.0.0\",\"255.255.255.0\",24,0,\"\"],[\"???\",\"0.0.0.0\",\"255.255.255.0\",24,0,\"\"],[\"???\",\"0.0.0.0\",\"255.255.255.0\",24,0,\"\"],[\"???\",\"0.0.0.0\",\"255.255.255.0\",24,0,\"\"],[\"???\",\"0.0.0.0\",\"255.255.255.0\",24,0,\"\"],[\"???\",\"0.0.0.0\",\"255.255.255.0\",24,0,\"\"],[\"???\",\"0.0.0.0\",\"255.255.255.0\",24,0,\"\"],[\"???\",\"0.0.0.0\",\"255.255.255.0\",24,0,\"\"],[\"???\",\"0.0.0.0\",\"255.255.255.0\",24,0,\"\"],[\"???\",\"0.0.0.0\",\"255.255.255.0\",24,0,\"\"],[\"???\",\"0.0.0.0\",\"255.255.255.0\",24,0,\"\"],[\"???\",\"0.0.0.0\",\"255.255.255.0\",24,0,\"\"],[\"???\",\"0.0.0.0\",\"255.255.255.0\",24,0,\"\"],[\"???\",\"0.0.0.0\",\"255.255.255.0\",24,0,\"\"],[\"???\",\"0.0.0.0\",\"255.255.255.0\",24,0,\"\"],